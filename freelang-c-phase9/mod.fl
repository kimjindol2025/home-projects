// FreeLang Phase 9: Module Integration
// Main entry point for Optimizer & JIT Compiler
// Language: FreeLang v2.4.0

// Re-export all public functions from optimizer module

// Hot-path functions
pub fn create_call_stats(name: string) -> any {
  return create_call_stats_pub(name)
}

pub fn record_call(stats: any, duration: i32) -> any {
  return record_call_pub(stats, duration)
}

pub fn detect_hot_paths(stats: any) -> any {
  return detect_hot_paths_pub(stats)
}

// Inline functions
pub fn should_inline(metrics: any) -> bool {
  return should_inline_pub(metrics)
}

pub fn calculate_inline_benefit(functions: any) -> i32 {
  return calculate_inline_benefit_pub(functions)
}

// Constant folding
pub fn fold_constants(a: i32, b: i32, op: string) -> i32 {
  return fold_constants_pub(a, b, op)
}

// Dead code elimination
pub fn eliminate_dead_code(blocks: any) -> i32 {
  return eliminate_dead_code_pub(blocks)
}

pub fn dead_code_ratio(blocks: any) -> i32 {
  return dead_code_ratio_pub(blocks)
}

// Register allocation
pub fn calculate_register_efficiency(allocations: any) -> i32 {
  return calculate_register_efficiency_pub(allocations)
}

// Loop optimization
pub fn estimate_loop_speedup(loops: any) -> i32 {
  return estimate_loop_speedup_pub(loops)
}

// Branch prediction
pub fn analyze_branch_predictability(branches: any) -> i32 {
  return analyze_branch_predictability_pub(branches)
}

// Cache optimization
pub fn calculate_cache_hit_rate(metrics: any) -> i32 {
  return calculate_cache_hit_rate_pub(metrics)
}

// Full optimization
pub fn run_full_optimization(code: any, functions: any, loops: any, blocks: any) -> any {
  return run_full_optimization_pub(code, functions, loops, blocks)
}

// Test functions
pub fn run_tests() -> i32 {
  return run_tests_pub()
}

// Verification functions
pub fn verify_r7() -> bool {
  return verify_r7_pub()
}

pub fn verify_r8() -> bool {
  return verify_r8_pub()
}

pub fn verify_r9() -> bool {
  return verify_r9_pub()
}

pub fn run_unforgiving() -> i32 {
  return run_unforgiving_pub()
}

pub fn benchmark() -> any {
  return benchmark_pub()
