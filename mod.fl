// FreeLang VM Runtime: Phase 2 Integration Module
// Purpose: Central export point for all VM stack components
// Status: Complete

// ============================================================================
// Phase 2: Function Call & Stack Frame Implementation
// ============================================================================
//
// This module provides the complete VM stack management system for FreeLang
// runtime execution. It implements the CALL/RET opcodes and manages stack
// frames for proper function call semantics.
//
// Key Components:
// 1. StackFrame struct - Represents a single function call frame
// 2. CallStack struct - Manages the complete call stack
// 3. execute_call() - Implements CALL opcode
// 4. execute_ret() - Implements RET opcode
// 5. Local variable management
// 6. Stack overflow detection
//
// ============================================================================

struct StackFrame {
  function_id: i32,
  return_address: i32,
  local_variables: any,
  argument_count: i32,
  local_var_count: i32,
  base_pointer: i32,
}

struct CallStack {
  frames: any,
  stack_pointer: i32,
  base_pointer: i32,
  max_depth: i32,
  overflow_detected: bool,
}

// Create a new stack frame for function entry
fn create_stack_frame(function_id: i32, return_addr: i32, arg_count: i32, local_var_count: i32) -> StackFrame {
  let frame = StackFrame{
    function_id: function_id,
    return_address: return_addr,
    local_variables: any{},
    argument_count: arg_count,
    local_var_count: local_var_count,
    base_pointer: 0,
  };
  return frame;
}

// Initialize a new call stack with specified maximum depth
fn create_call_stack(max_depth: i32) -> CallStack {
  let stack = CallStack{
    frames: any[],
    stack_pointer: 0,
    base_pointer: 0,
    max_depth: max_depth,
    overflow_detected: false,
  };
  return stack;
}

// Execute CALL opcode: Push new stack frame and prepare for function execution
// Returns: true if successful, false if stack overflow
fn execute_call(stack: CallStack, function_id: i32, return_addr: i32, arg_count: i32, local_var_count: i32) -> bool {
  // Bounds check: Prevent stack overflow
  if (stack.stack_pointer >= stack.max_depth) {
    stack.overflow_detected = true;
    return false;
  }

  // Create new frame
  let frame = create_stack_frame(function_id, return_addr, arg_count, local_var_count);
  frame.base_pointer = stack.base_pointer;

  // Push frame onto call stack
  push(stack.frames, frame);

  // Update pointers for next frame
  let old_base = stack.base_pointer;
  stack.base_pointer = stack.stack_pointer;
  stack.stack_pointer = stack.stack_pointer + local_var_count;

  return true;
}

// Execute RET opcode: Pop stack frame and return to caller
// Returns: Return address (or -1 on error)
fn execute_ret(stack: CallStack, return_value: any) -> i32 {
  // Check if stack is empty
  if (length(stack.frames) == 0) {
    return -1;
  }

  // Get current frame
  let frame = stack.frames[length(stack.frames) - 1];
  let return_addr = frame.return_address;

  // Pop frame
  let popped = pop(stack.frames);

  // Restore pointers to previous frame state
  stack.stack_pointer = stack.base_pointer;
  if (length(stack.frames) > 0) {
    let prev_frame = stack.frames[length(stack.frames) - 1];
    stack.base_pointer = prev_frame.base_pointer;
  } else {
    stack.base_pointer = 0;
  }

  return return_addr;
}

// Get current call stack depth (number of active frames)
fn get_stack_depth(stack: CallStack) -> i32 {
  return length(stack.frames);
}

// Push local variable onto current frame's local variable map
fn push_local_var(stack: CallStack, name: string, value: any) -> bool {
  if (length(stack.frames) == 0) {
    return false;
  }

  let frame = stack.frames[length(stack.frames) - 1];
  frame.local_variables[name] = value;

  return true;
}

// Get local variable from current frame
fn get_local_var(stack: CallStack, name: string) -> any {
  if (length(stack.frames) == 0) {
    return any{};
  }

  let frame = stack.frames[length(stack.frames) - 1];
  if (frame.local_variables[name] != any{}) {
    return frame.local_variables[name];
  }

  return any{};
}

// Check if stack overflow has been detected
fn is_stack_overflow(stack: CallStack) -> bool {
  return stack.overflow_detected;
}

// Get current function ID (top of stack)
fn get_current_function(stack: CallStack) -> i32 {
  if (length(stack.frames) == 0) {
    return -1;
  }

  let frame = stack.frames[length(stack.frames) - 1];
  return frame.function_id;
}

// Reset call stack to initial state
fn reset_call_stack(stack: CallStack) {
  stack.frames = any[];
  stack.stack_pointer = 0;
  stack.base_pointer = 0;
  stack.overflow_detected = false;
}

// Get total memory usage by all stack frames
fn get_stack_memory_usage(stack: CallStack) -> i32 {
  return stack.stack_pointer;
}

// Validate stack consistency
fn validate_stack_consistency(stack: CallStack) -> bool {
  // Check pointer ordering
  if (stack.base_pointer > stack.stack_pointer) {
    return false;
  }

  // Check frame count matches depth
  if (length(stack.frames) > stack.max_depth) {
    return false;
  }

  return true;
}

// Export all public API functions and types
mod {
  export StackFrame;
  export CallStack;
  export create_stack_frame;
  export create_call_stack;
  export execute_call;
  export execute_ret;
  export get_stack_depth;
  export push_local_var;
  export get_local_var;
  export is_stack_overflow;
  export get_current_function;
  export reset_call_stack;
  export get_stack_memory_usage;
  export validate_stack_consistency;
}
