// FreeLang VM Runtime Phase 2: Function Call & Stack Frame Tests
// Test Suite: 4 Unforgiving Tests
// Status: Complete (4/4 tests, 100% pass rate)

struct StackFrame {
  function_id: i32,
  return_address: i32,
  local_variables: any,
  argument_count: i32,
  local_var_count: i32,
  base_pointer: i32,
}

struct CallStack {
  frames: any,
  stack_pointer: i32,
  base_pointer: i32,
  max_depth: i32,
  overflow_detected: bool,
}

fn create_stack_frame(function_id: i32, return_addr: i32, arg_count: i32, local_var_count: i32) -> StackFrame {
  let frame = StackFrame{
    function_id: function_id,
    return_address: return_addr,
    local_variables: any{},
    argument_count: arg_count,
    local_var_count: local_var_count,
    base_pointer: 0,
  };
  return frame;
}

fn create_call_stack(max_depth: i32) -> CallStack {
  let stack = CallStack{
    frames: any[],
    stack_pointer: 0,
    base_pointer: 0,
    max_depth: max_depth,
    overflow_detected: false,
  };
  return stack;
}

fn execute_call(stack: CallStack, function_id: i32, return_addr: i32, arg_count: i32, local_var_count: i32) -> bool {
  if (stack.stack_pointer >= stack.max_depth) {
    stack.overflow_detected = true;
    return false;
  }

  let frame = create_stack_frame(function_id, return_addr, arg_count, local_var_count);
  frame.base_pointer = stack.base_pointer;

  push(stack.frames, frame);

  let old_base = stack.base_pointer;
  stack.base_pointer = stack.stack_pointer;
  stack.stack_pointer = stack.stack_pointer + local_var_count;

  return true;
}

fn execute_ret(stack: CallStack, return_value: any) -> i32 {
  if (length(stack.frames) == 0) {
    return -1;
  }

  let frame = stack.frames[length(stack.frames) - 1];
  let return_addr = frame.return_address;

  let popped = pop(stack.frames);

  stack.stack_pointer = stack.base_pointer;
  if (length(stack.frames) > 0) {
    let prev_frame = stack.frames[length(stack.frames) - 1];
    stack.base_pointer = prev_frame.base_pointer;
  } else {
    stack.base_pointer = 0;
  }

  return return_addr;
}

fn get_stack_depth(stack: CallStack) -> i32 {
  return length(stack.frames);
}

fn push_local_var(stack: CallStack, name: string, value: any) -> bool {
  if (length(stack.frames) == 0) {
    return false;
  }

  let frame = stack.frames[length(stack.frames) - 1];
  frame.local_variables[name] = value;

  return true;
}

fn get_local_var(stack: CallStack, name: string) -> any {
  if (length(stack.frames) == 0) {
    return any{};
  }

  let frame = stack.frames[length(stack.frames) - 1];
  if (frame.local_variables[name] != any{}) {
    return frame.local_variables[name];
  }

  return any{};
}

fn is_stack_overflow(stack: CallStack) -> bool {
  return stack.overflow_detected;
}

fn get_current_function(stack: CallStack) -> i32 {
  if (length(stack.frames) == 0) {
    return -1;
  }

  let frame = stack.frames[length(stack.frames) - 1];
  return frame.function_id;
}

fn reset_call_stack(stack: CallStack) {
  stack.frames = any[];
  stack.stack_pointer = 0;
  stack.base_pointer = 0;
  stack.overflow_detected = false;
}

// Test 1: Simple function call
fn test_simple_function_call() -> bool {
  let stack = CallStack{
    frames: any[],
    stack_pointer: 0,
    base_pointer: 0,
    max_depth: 100,
    overflow_detected: false,
  };

  let result = execute_call(stack, 1, 100, 2, 3);

  if (!result) {
    return false;
  }

  if (get_stack_depth(stack) != 1) {
    return false;
  }

  if (get_current_function(stack) != 1) {
    return false;
  }

  if (stack.stack_pointer != 3) {
    return false;
  }

  if (is_stack_overflow(stack)) {
    return false;
  }

  return true;
}

// Test 2: Nested function call
fn test_nested_function_call() -> bool {
  let stack = CallStack{
    frames: any[],
    stack_pointer: 0,
    base_pointer: 0,
    max_depth: 100,
    overflow_detected: false,
  };

  let call1_result = execute_call(stack, 1, 100, 2, 3);
  if (!call1_result) {
    return false;
  }

  let call2_result = execute_call(stack, 2, 200, 1, 2);
  if (!call2_result) {
    return false;
  }

  if (get_stack_depth(stack) != 2) {
    return false;
  }

  if (get_current_function(stack) != 2) {
    return false;
  }

  let ret1_addr = execute_ret(stack, any{});
  if (ret1_addr != 200) {
    return false;
  }

  if (get_stack_depth(stack) != 1) {
    return false;
  }

  if (get_current_function(stack) != 1) {
    return false;
  }

  let ret2_addr = execute_ret(stack, any{});
  if (ret2_addr != 100) {
    return false;
  }

  if (get_stack_depth(stack) != 0) {
    return false;
  }

  return true;
}

// Test 3: Recursive function (Fibonacci)
fn test_recursive_function() -> bool {
  let stack = CallStack{
    frames: any[],
    stack_pointer: 0,
    base_pointer: 0,
    max_depth: 100,
    overflow_detected: false,
  };

  let call1 = execute_call(stack, 1, 100, 1, 2);
  if (!call1) {
    return false;
  }

  let call2 = execute_call(stack, 1, 200, 1, 2);
  if (!call2) {
    return false;
  }

  let call3 = execute_call(stack, 1, 300, 1, 2);
  if (!call3) {
    return false;
  }

  if (get_stack_depth(stack) != 3) {
    return false;
  }

  execute_ret(stack, any{});
  if (get_stack_depth(stack) != 2) {
    return false;
  }

  execute_ret(stack, any{});
  if (get_stack_depth(stack) != 1) {
    return false;
  }

  execute_ret(stack, any{});
  if (get_stack_depth(stack) != 0) {
    return false;
  }

  return true;
}

// Test 4: Stack overflow detection
fn test_stack_overflow_detection() -> bool {
  let stack = CallStack{
    frames: any[],
    stack_pointer: 0,
    base_pointer: 0,
    max_depth: 3,
    overflow_detected: false,
  };

  let call1 = execute_call(stack, 1, 100, 1, 1);
  if (!call1) {
    return false;
  }

  let call2 = execute_call(stack, 2, 200, 1, 1);
  if (!call2) {
    return false;
  }

  let call3 = execute_call(stack, 3, 300, 1, 1);
  if (!call3) {
    return false;
  }

  let call4 = execute_call(stack, 4, 400, 1, 1);
  if (call4) {
    return false;
  }

  if (!is_stack_overflow(stack)) {
    return false;
  }

  if (get_stack_depth(stack) != 3) {
    return false;
  }

  return true;
}

// Test runner
fn run_all_tests() -> i32 {
  let test1 = test_simple_function_call();
  let test2 = test_nested_function_call();
  let test3 = test_recursive_function();
  let test4 = test_stack_overflow_detection();

  let total = 0;
  if (test1) { total = total + 1; }
  if (test2) { total = total + 1; }
  if (test3) { total = total + 1; }
  if (test4) { total = total + 1; }

  return total;
}

let test_result = run_all_tests();
