// Example 4: Error Handling
// Demonstrates error detection and recovery

// Include VM runtime
// include "src/vm-runtime.fl"

// Example: Proper error handling
fn example_error_handling() -> bool {
  let vm = create_vm();

  // Test 1: Division by zero
  vm_push(vm, 10);
  vm_push(vm, 0);

  if !vm_div(vm) {
    // Error detected correctly
    if vm.error == "Division by zero" {
      return true
    }
  }

  return false
}

// Example: Stack underflow protection
fn example_stack_protection() -> bool {
  let vm = create_vm();

  // Try to pop from empty stack
  let value = vm_pop(vm);

  if vm.error == "Stack underflow" {
    return true
  }

  return false
}

// Execute examples
let test1 = example_error_handling();
let test2 = example_stack_protection();

if test1 && test2 {
  true
}
else {
  false
}
