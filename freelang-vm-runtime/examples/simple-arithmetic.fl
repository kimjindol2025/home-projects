// Example 1: Simple Arithmetic
// Demonstrates basic stack-based arithmetic

// Include VM runtime
// include "src/vm-runtime.fl"

// Example usage of VM arithmetic
fn example_simple_arithmetic() -> i32 {
  let vm = create_vm();

  // Calculate: 10 + 5 = 15
  vm_push(vm, 10);
  vm_push(vm, 5);
  vm_add(vm);

  return vm_get_result(vm)
}

// Execute example
let result = example_simple_arithmetic();
// Result should be 15
result
