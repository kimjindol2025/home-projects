// Example 3: Stack Operations
// Demonstrates push/pop behavior

// Include VM runtime
// include "src/vm-runtime.fl"

// Example: LIFO stack behavior
fn example_stack_operations() -> i32 {
  let vm = create_vm();

  // Push values onto stack
  vm_push(vm, 100);
  vm_push(vm, 200);
  vm_push(vm, 300);

  // Pop in reverse order (LIFO)
  let v1 = vm_pop(vm);  // 300
  let v2 = vm_pop(vm);  // 200
  let v3 = vm_pop(vm);  // 100

  // Verify stack is empty
  if vm.stack_pointer != 0 {
    return -1
  }

  // Calculate sum
  return v1 + v2 + v3   // 300 + 200 + 100 = 600
}

// Execute example
let result = example_stack_operations();
// Result should be 600
result
