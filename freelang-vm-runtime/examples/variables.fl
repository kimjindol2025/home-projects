// Example 2: Variable Operations
// Demonstrates register and memory operations

// Include VM runtime
// include "src/vm-runtime.fl"

// Example: Using registers as variables
fn example_variables() -> i32 {
  let vm = create_vm();

  // Store value 42 in register R0
  vm_write_register(vm, 0, 42);

  // Store value 8 in register R1
  vm_write_register(vm, 1, 8);

  // Read from registers and add
  let r0 = vm_read_register(vm, 0);
  let r1 = vm_read_register(vm, 1);

  // Use memory for temporary storage
  vm_store(vm, 0, r0);      // mem[0] = 42
  vm_store(vm, 1, r1);      // mem[1] = 8

  // Load from memory and calculate
  let m0 = vm_load(vm, 0);
  let m1 = vm_load(vm, 1);

  return m0 + m1            // 42 + 8 = 50
}

// Execute example
let result = example_variables();
// Result should be 50
result
