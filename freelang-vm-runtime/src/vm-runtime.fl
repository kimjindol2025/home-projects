// FreeLang VM Runtime Phase 1: Core Runtime Engine
// Pure FreeLang implementation of a stack-based VM
// 200 lines of pure FreeLang code

// ============================================================================
// OPCODE DEFINITIONS
// ============================================================================

// Define opcode constants
fn opcode_load() -> i32 { return 0x01 }
fn opcode_store() -> i32 { return 0x02 }
fn opcode_add() -> i32 { return 0x03 }
fn opcode_sub() -> i32 { return 0x04 }
fn opcode_mul() -> i32 { return 0x05 }
fn opcode_div() -> i32 { return 0x06 }
fn opcode_push() -> i32 { return 0x07 }
fn opcode_pop() -> i32 { return 0x08 }
fn opcode_halt() -> i32 { return 0xFF }

// ============================================================================
// VM STATE STRUCTURE
// ============================================================================

struct VMState {
  registers: array,        // R0-R15 (16 general purpose registers)
  stack: array,            // Execution stack
  stack_pointer: i32,      // SP register
  base_pointer: i32,       // BP register
  instruction_pointer: i32, // PC register
  memory: array,           // Heap memory
  memory_pointer: i32,     // MP register (heap allocation)
  halted: bool,            // Execution state
  error: string            // Error message
}

// ============================================================================
// VM INITIALIZATION
// ============================================================================

// Initialize VM state with default values
fn init_vm() -> struct {
  let vm = VMState{
    registers: array[],
    stack: array[],
    stack_pointer: 0,
    base_pointer: 0,
    instruction_pointer: 0,
    memory: array[],
    memory_pointer: 0,
    halted: false,
    error: ""
  };

  // Initialize 16 registers to 0
  let i = 0;
  while i < 16 {
    push(vm.registers, 0);
    i = i + 1
  }

  // Initialize stack and memory arrays
  let j = 0;
  while j < 256 {
    push(vm.stack, 0);
    push(vm.memory, 0);
    j = j + 1
  }

  return vm
}

// ============================================================================
// STACK OPERATIONS
// ============================================================================

// Push value onto stack
fn vm_push(vm: struct, value: i32) -> bool {
  if vm.stack_pointer >= 256 {
    vm.error = "Stack overflow";
    return false
  }

  vm.stack[vm.stack_pointer] = value;
  vm.stack_pointer = vm.stack_pointer + 1;
  return true
}

// Pop value from stack
fn vm_pop(vm: struct) -> i32 {
  if vm.stack_pointer <= 0 {
    vm.error = "Stack underflow";
    return -1
  }

  vm.stack_pointer = vm.stack_pointer - 1;
  return vm.stack[vm.stack_pointer]
}

// Peek at top of stack without popping
fn vm_peek(vm: struct) -> i32 {
  if vm.stack_pointer <= 0 {
    return -1
  }
  return vm.stack[vm.stack_pointer - 1]
}

// ============================================================================
// REGISTER OPERATIONS
// ============================================================================

// Read register value
fn vm_read_register(vm: struct, reg: i32) -> i32 {
  if reg < 0 || reg >= 16 {
    vm.error = "Invalid register";
    return -1
  }
  return vm.registers[reg]
}

// Write to register
fn vm_write_register(vm: struct, reg: i32, value: i32) -> bool {
  if reg < 0 || reg >= 16 {
    vm.error = "Invalid register";
    return false
  }
  vm.registers[reg] = value;
  return true
}

// ============================================================================
// MEMORY OPERATIONS
// ============================================================================

// Load from memory address
fn vm_load(vm: struct, address: i32) -> i32 {
  if address < 0 || address >= 256 {
    vm.error = "Memory access out of bounds";
    return -1
  }
  return vm.memory[address]
}

// Store to memory address
fn vm_store(vm: struct, address: i32, value: i32) -> bool {
  if address < 0 || address >= 256 {
    vm.error = "Memory access out of bounds";
    return false
  }
  vm.memory[address] = value;
  return true
}

// ============================================================================
// ARITHMETIC OPERATIONS
// ============================================================================

// Add two stack values
fn vm_add(vm: struct) -> bool {
  let b = vm_pop(vm);
  let a = vm_pop(vm);

  if vm.error != "" {
    return false
  }

  let result = a + b;
  return vm_push(vm, result)
}

// Subtract two stack values
fn vm_sub(vm: struct) -> bool {
  let b = vm_pop(vm);
  let a = vm_pop(vm);

  if vm.error != "" {
    return false
  }

  let result = a - b;
  return vm_push(vm, result)
}

// Multiply two stack values
fn vm_mul(vm: struct) -> bool {
  let b = vm_pop(vm);
  let a = vm_pop(vm);

  if vm.error != "" {
    return false
  }

  let result = a * b;
  return vm_push(vm, result)
}

// Divide two stack values
fn vm_div(vm: struct) -> bool {
  let b = vm_pop(vm);
  let a = vm_pop(vm);

  if vm.error != "" {
    return false
  }

  if b == 0 {
    vm.error = "Division by zero";
    return false
  }

  let result = a / b;
  return vm_push(vm, result)
}

// ============================================================================
// INSTRUCTION EXECUTION
// ============================================================================

// Execute a single instruction
fn vm_execute_instruction(vm: struct, opcode: i32) -> bool {
  if opcode == opcode_push() {
    // PUSH: push next value (from instruction stream)
    // For now, push 0 as placeholder
    return vm_push(vm, 0)
  }
  else if opcode == opcode_pop() {
    // POP: discard top of stack
    let _ = vm_pop(vm);
    return vm.error == ""
  }
  else if opcode == opcode_add() {
    return vm_add(vm)
  }
  else if opcode == opcode_sub() {
    return vm_sub(vm)
  }
  else if opcode == opcode_mul() {
    return vm_mul(vm)
  }
  else if opcode == opcode_div() {
    return vm_div(vm)
  }
  else if opcode == opcode_load() {
    // LOAD: pop address, load from memory
    let address = vm_pop(vm);
    if vm.error != "" {
      return false
    }
    let value = vm_load(vm, address);
    if vm.error != "" {
      return false
    }
    return vm_push(vm, value)
  }
  else if opcode == opcode_store() {
    // STORE: pop value and address, store to memory
    let value = vm_pop(vm);
    let address = vm_pop(vm);
    if vm.error != "" {
      return false
    }
    return vm_store(vm, address, value)
  }
  else if opcode == opcode_halt() {
    vm.halted = true;
    return true
  }
  else {
    vm.error = "Unknown opcode";
    return false
  }
}

// ============================================================================
// VM EXECUTION
// ============================================================================

// Execute a program (array of opcodes)
fn vm_run(vm: struct, program: array) -> struct {
  while !vm.halted && vm.instruction_pointer < length(program) {
    let opcode = program[vm.instruction_pointer];

    if !vm_execute_instruction(vm, opcode) {
      vm.halted = true;
      break
    }

    vm.instruction_pointer = vm.instruction_pointer + 1
  }

  return vm
}

// Get execution result from VM state
fn vm_get_result(vm: struct) -> i32 {
  if vm.stack_pointer > 0 {
    return vm.stack[vm.stack_pointer - 1]
  }
  return 0
}

// ============================================================================
// PUBLIC API
// ============================================================================

fn create_vm() -> struct {
  return init_vm()
}

fn run_program(program: array) -> i32 {
  let vm = init_vm();
  vm = vm_run(vm, program);
  return vm_get_result(vm)
}

fn vm_state_valid(vm: struct) -> bool {
  return vm.error == "" && !vm.halted
}

fn vm_get_error(vm: struct) -> string {
  return vm.error
}

fn vm_get_sp(vm: struct) -> i32 {
  return vm.stack_pointer
}

fn vm_get_pc(vm: struct) -> i32 {
  return vm.instruction_pointer
}
