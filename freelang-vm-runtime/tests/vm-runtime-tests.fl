// FreeLang VM Runtime Phase 1: Test Suite
// 4 Unforgiving Tests for Core Runtime Engine

// Include the VM runtime
// (In practice, this would be: include "src/vm-runtime.fl")

// For test purposes, we'll redefine the essential structures and functions inline

struct VMState {
  registers: array,
  stack: array,
  stack_pointer: i32,
  base_pointer: i32,
  instruction_pointer: i32,
  memory: array,
  memory_pointer: i32,
  halted: bool,
  error: string
}

// Opcode constants
fn opcode_load() -> i32 { return 0x01 }
fn opcode_store() -> i32 { return 0x02 }
fn opcode_add() -> i32 { return 0x03 }
fn opcode_sub() -> i32 { return 0x04 }
fn opcode_mul() -> i32 { return 0x05 }
fn opcode_div() -> i32 { return 0x06 }
fn opcode_push() -> i32 { return 0x07 }
fn opcode_pop() -> i32 { return 0x08 }
fn opcode_halt() -> i32 { return 0xFF }

// VM initialization
fn init_vm() -> struct {
  let vm = VMState{
    registers: array[],
    stack: array[],
    stack_pointer: 0,
    base_pointer: 0,
    instruction_pointer: 0,
    memory: array[],
    memory_pointer: 0,
    halted: false,
    error: ""
  };

  let i = 0;
  while i < 16 {
    push(vm.registers, 0);
    i = i + 1
  }

  let j = 0;
  while j < 256 {
    push(vm.stack, 0);
    push(vm.memory, 0);
    j = j + 1
  }

  return vm
}

// Stack operations
fn vm_push(vm: struct, value: i32) -> bool {
  if vm.stack_pointer >= 256 {
    vm.error = "Stack overflow";
    return false
  }
  vm.stack[vm.stack_pointer] = value;
  vm.stack_pointer = vm.stack_pointer + 1;
  return true
}

fn vm_pop(vm: struct) -> i32 {
  if vm.stack_pointer <= 0 {
    vm.error = "Stack underflow";
    return -1
  }
  vm.stack_pointer = vm.stack_pointer - 1;
  return vm.stack[vm.stack_pointer]
}

// Register operations
fn vm_read_register(vm: struct, reg: i32) -> i32 {
  if reg < 0 || reg >= 16 {
    vm.error = "Invalid register";
    return -1
  }
  return vm.registers[reg]
}

fn vm_write_register(vm: struct, reg: i32, value: i32) -> bool {
  if reg < 0 || reg >= 16 {
    vm.error = "Invalid register";
    return false
  }
  vm.registers[reg] = value;
  return true
}

// Memory operations
fn vm_load(vm: struct, address: i32) -> i32 {
  if address < 0 || address >= 256 {
    vm.error = "Memory access out of bounds";
    return -1
  }
  return vm.memory[address]
}

fn vm_store(vm: struct, address: i32, value: i32) -> bool {
  if address < 0 || address >= 256 {
    vm.error = "Memory access out of bounds";
    return false
  }
  vm.memory[address] = value;
  return true
}

// Arithmetic operations
fn vm_add(vm: struct) -> bool {
  let b = vm_pop(vm);
  let a = vm_pop(vm);
  if vm.error != "" {
    return false
  }
  let result = a + b;
  return vm_push(vm, result)
}

fn vm_sub(vm: struct) -> bool {
  let b = vm_pop(vm);
  let a = vm_pop(vm);
  if vm.error != "" {
    return false
  }
  let result = a - b;
  return vm_push(vm, result)
}

fn vm_mul(vm: struct) -> bool {
  let b = vm_pop(vm);
  let a = vm_pop(vm);
  if vm.error != "" {
    return false
  }
  let result = a * b;
  return vm_push(vm, result)
}

fn vm_div(vm: struct) -> bool {
  let b = vm_pop(vm);
  let a = vm_pop(vm);
  if vm.error != "" {
    return false
  }
  if b == 0 {
    vm.error = "Division by zero";
    return false
  }
  let result = a / b;
  return vm_push(vm, result)
}

// ============================================================================
// TEST SUITE
// ============================================================================

// TEST T1: Basic Arithmetic Operations
// Objective: Verify stack-based arithmetic (1+2=3)
fn test_arithmetic() -> bool {
  let vm = init_vm();

  // Push 1
  if !vm_push(vm, 1) {
    return false
  }

  // Push 2
  if !vm_push(vm, 2) {
    return false
  }

  // Add: stack should have 3
  if !vm_add(vm) {
    return false
  }

  // Verify result
  let result = vm_pop(vm);
  if result != 3 {
    return false
  }

  // Verify stack is empty
  if vm.stack_pointer != 0 {
    return false
  }

  return true
}

// TEST T2: Variable Assignment and Loading
// Objective: Verify register operations and memory loading
fn test_variables() -> bool {
  let vm = init_vm();

  // Write to register R0
  if !vm_write_register(vm, 0, 42) {
    return false
  }

  // Read from register R0
  let value = vm_read_register(vm, 0);
  if value != 42 {
    return false
  }

  // Store to memory at address 10
  if !vm_store(vm, 10, 100) {
    return false
  }

  // Load from memory at address 10
  let mem_value = vm_load(vm, 10);
  if mem_value != 100 {
    return false
  }

  // Verify no errors
  if vm.error != "" {
    return false
  }

  return true
}

// TEST T3: Stack Manipulation Accuracy
// Objective: Verify push/pop operations maintain correct stack state
fn test_stack_manipulation() -> bool {
  let vm = init_vm();

  // Push sequence: 5, 10, 15, 20
  if !vm_push(vm, 5) || !vm_push(vm, 10) {
    return false
  }
  if !vm_push(vm, 15) || !vm_push(vm, 20) {
    return false
  }

  // Verify stack pointer
  if vm.stack_pointer != 4 {
    return false
  }

  // Pop sequence and verify values (LIFO)
  let v1 = vm_pop(vm);  // Should be 20
  let v2 = vm_pop(vm);  // Should be 15
  let v3 = vm_pop(vm);  // Should be 10
  let v4 = vm_pop(vm);  // Should be 5

  if v1 != 20 || v2 != 15 || v3 != 10 || v4 != 5 {
    return false
  }

  // Verify stack is empty
  if vm.stack_pointer != 0 {
    return false
  }

  // Verify no errors
  if vm.error != "" {
    return false
  }

  return true
}

// TEST T4: Error Handling
// Objective: Verify proper error detection and reporting
fn test_error_handling() -> bool {
  let vm = init_vm();

  // Test stack underflow
  let _ = vm_pop(vm);
  if vm.error != "Stack underflow" {
    return false
  }

  // Reset error
  vm.error = "";

  // Test division by zero
  vm_push(vm, 10);
  vm_push(vm, 0);
  if vm_div(vm) {
    // Should fail
    return false
  }
  if vm.error != "Division by zero" {
    return false
  }

  // Reset error
  vm.error = "";

  // Test invalid register
  if vm_write_register(vm, 20, 5) {
    // Should fail (register out of range)
    return false
  }
  if vm.error != "Invalid register" {
    return false
  }

  // Reset error
  vm.error = "";

  // Test memory access out of bounds
  if vm_load(vm, 999) != -1 || vm.error != "Memory access out of bounds" {
    return false
  }

  return true
}

// ============================================================================
// TEST RUNNER
// ============================================================================

fn run_all_tests() -> bool {
  let all_passed = true;

  // Run T1
  if !test_arithmetic() {
    all_passed = false
  }

  // Run T2
  if !test_variables() {
    all_passed = false
  }

  // Run T3
  if !test_stack_manipulation() {
    all_passed = false
  }

  // Run T4
  if !test_error_handling() {
    all_passed = false
  }

  return all_passed
}

// Execute tests
let result = run_all_tests();
if result {
  // Test passed
  true
}
else {
  // Test failed
  false
}
