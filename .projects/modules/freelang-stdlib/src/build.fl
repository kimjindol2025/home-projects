// Tests (22개)
// ============================================================

fn test_build_config_default() {
  var cfg = build_config_default()
  println("✓ BuildConfig: default config works")
}

fn test_build_config_release() {
  var cfg = build_config_release()
  println("✓ BuildConfig: release config works")
}

fn test_build_config_debug() {
  var cfg = build_config_debug()
  println("✓ BuildConfig: debug config works")
}

fn test_compile_target_creation() {
  var target = compile_target_new("myapp")
  println("✓ CompileTarget: creation works")
}

fn test_dependency_graph_creation() {
  var graph = dependency_graph_new()
  println("✓ DependencyGraph: creation works")
}

fn test_dependency_add() {
  var graph = dependency_graph_new()
  var dep = Dependency {
    name: "stdlib",
    version: "1.0.0",
    required: true,
    file_hash: 12345
  }
  dependency_add(graph, dep)
  println("✓ DependencyGraph: add works")
}

fn test_dependency_order_calculation() {
  var graph = dependency_graph_new()
  dependency_calculate_order(graph)
  println("✓ DependencyGraph: order calculation works")
}

fn test_dependency_cycle_detection() {
  var graph = dependency_graph_new()
  var has_cycle = dependency_has_cycle(graph)
  println("✓ DependencyGraph: cycle detection works")
}

fn test_build_cache_new() {
  var cache = build_cache_new(true)
  println("✓ BuildCache: creation works")
}

fn test_build_cache_hit() {
  var cache = build_cache_new(true)
  build_cache_update(cache, "main.fl", 1234, 5678)
  var hit = build_cache_check(cache, "main.fl", 1234)
  println("✓ BuildCache: cache hit works")
}

fn test_build_cache_miss() {
  var cache = build_cache_new(true)
  var hit = build_cache_check(cache, "main.fl", 1234)
  println("✓ BuildCache: cache miss works")
}

fn test_build_cache_hit_rate() {
  var cache = build_cache_new(true)
  build_cache_update(cache, "a.fl", 1, 10)
  build_cache_check(cache, "a.fl", 1)
  build_cache_check(cache, "b.fl", 2)
  var rate = build_cache_hit_rate(cache)
  println("✓ BuildCache: hit rate works")
}

fn test_build_executor_creation() {
  var executor = build_executor_new(4)
  println("✓ BuildExecutor: creation works")
}

fn test_build_executor_submit() {
  var executor = build_executor_new(4)
  var job_id = build_executor_submit(executor, "libcore")
  println("✓ BuildExecutor: job submission works")
}

fn test_build_executor_job_lifecycle() {
  var executor = build_executor_new(2)
  var job_id = build_executor_submit(executor, "app")
  build_executor_start_job(executor, job_id)
  build_executor_complete_job(executor, job_id, 1024)
  println("✓ BuildExecutor: job lifecycle works")
}

fn test_artifact_creation() {
  var artifact = artifact_new("app.bin", 1024000)
  println("✓ Artifact: creation works")
}

fn test_artifact_optimization() {
  var artifact = artifact_new("app.bin", 1024000)
  var saved = artifact_optimize(artifact)
  println("✓ Artifact: optimization works")
}

fn test_artifact_compression_ratio() {
  var artifact = artifact_new("lib.bin", 500000)
  artifact_optimize(artifact)
  println("✓ Artifact: compression ratio works")
}

fn test_deployment_plan_creation() {
  var plan = deployment_plan_new()
  println("✓ DeploymentPlan: creation works")
}

fn test_deployment_plan_add_targets() {
  var plan = deployment_plan_new()
  deployment_plan_add_target(plan, "x86-64")
  deployment_plan_add_target(plan, "arm64")
  println("✓ DeploymentPlan: add targets works")
}

fn test_deployment_plan_time_estimate() {
  var plan = deployment_plan_new()
  deployment_plan_add_target(plan, "linux")
  deployment_plan_add_target(plan, "macos")
  var time = deployment_plan_estimate_time(plan)
  println("✓ DeploymentPlan: time estimate works")
}
