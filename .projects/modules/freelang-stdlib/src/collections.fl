// ============================================================
// FreeLang Standard Library: Collections Module
// ============================================================
// 고급 자료구조 및 알고리즘
//
// 목표:
// - 링크드 리스트
// - 트리 (이진 검색 트리)
// - 해시맵
// - 우선순위 큐 (힙)
// - 정렬 및 검색 알고리즘
//
// 라인: 280줄
// 테스트: 18개

// ============================================================
// Part 1: Linked List (60줄)
// ============================================================

struct ListNode {
  value: i64
  next_idx: i32
}

struct LinkedList {
  nodes: [ListNode]
  head_idx: i32
  size: i32
}

fn linked_list_new(): LinkedList {
  return LinkedList {
    nodes: [],
    head_idx: -1,
    size: 0
  }
}

fn linked_list_push_front(list: LinkedList, value: i64) {
  var node = ListNode {
    value: value,
    next_idx: list.head_idx
  }

  list.nodes = list.nodes + [node]
  list.head_idx = (length(list.nodes) - 1) as i32
  list.size = list.size + 1
}

fn linked_list_push_back(list: LinkedList, value: i64) {
  if list.head_idx == -1 {
    linked_list_push_front(list, value)
    return
  }

  var node = ListNode {
    value: value,
    next_idx: -1
  }

  // 마지막 노드 찾기
  var current_idx = list.head_idx
  for i in range(0, list.size - 1) {
    if current_idx >= 0 && current_idx < length(list.nodes) {
      var current = list.nodes[current_idx]
      current_idx = current.next_idx
    }
  }

  // 새 노드 추가
  list.nodes = list.nodes + [node]
  list.size = list.size + 1
}

fn linked_list_pop_front(list: LinkedList): i64 {
  if list.head_idx == -1 {
    return -1
  }

  var node = list.nodes[list.head_idx]
  var value = node.value

  list.head_idx = node.next_idx
  list.size = list.size - 1

  return value
}

fn linked_list_len(list: LinkedList): i32 {
  return list.size
}

fn linked_list_to_array(list: LinkedList): [i64] {
  var result = []
  var current_idx = list.head_idx

  while current_idx != -1 {
    if current_idx >= 0 && current_idx < length(list.nodes) {
      var node = list.nodes[current_idx]
      result = result + [node.value]
      current_idx = node.next_idx
    } else {
      break
    }
  }

  return result
}

// ============================================================
// Part 2: Binary Search Tree (80줄)
// ============================================================

struct TreeNode {
  value: i64
  left_idx: i32
  right_idx: i32
  height: i32
}

struct BinarySearchTree {
  nodes: [TreeNode]
  root_idx: i32
  size: i32
}

fn bst_new(): BinarySearchTree {
  return BinarySearchTree {
    nodes: [],
    root_idx: -1,
    size: 0
  }
}

fn bst_insert(tree: BinarySearchTree, value: i64) {
  var node = TreeNode {
    value: value,
    left_idx: -1,
    right_idx: -1,
    height: 1
  }

  if tree.root_idx == -1 {
    tree.nodes = [node]
    tree.root_idx = 0
    tree.size = 1
    return
  }

  // 간단한 구현: 맨 앞에 추가
  tree.nodes = tree.nodes + [node]
  tree.size = tree.size + 1
}

fn bst_search(tree: BinarySearchTree, value: i64): bool {
  for i in range(0, length(tree.nodes)) {
    if tree.nodes[i].value == value {
      return true
    }
  }
  return false
}

fn bst_min(tree: BinarySearchTree): i64 {
  if tree.size == 0 {
    return -1
  }

  var min_val = tree.nodes[0].value

  for i in range(1, tree.size) {
    if tree.nodes[i].value < min_val {
      min_val = tree.nodes[i].value
    }
  }

  return min_val
}

fn bst_max(tree: BinarySearchTree): i64 {
  if tree.size == 0 {
    return -1
  }

  var max_val = tree.nodes[0].value

  for i in range(1, tree.size) {
    if tree.nodes[i].value > max_val {
      max_val = tree.nodes[i].value
    }
  }

  return max_val
}

fn bst_inorder(tree: BinarySearchTree): [i64] {
  // 정렬된 순서로 반환
  var result = []

  for i in range(0, tree.size) {
    result = result + [tree.nodes[i].value]
  }

  return sort(result)
}

// ============================================================
// Part 3: HashMap (간단한 구현) (60줄)
// ============================================================

struct HashMapEntry {
  key: i64
  value: i64
  occupied: bool
}

struct HashMap {
  entries: [HashMapEntry]
  capacity: i32
  size: i32
}

fn hash_function(key: i64, capacity: i32): i32 {
  return (key % (capacity as i64)) as i32
}

fn hashmap_new(capacity: i32): HashMap {
  var entries = []

  for i in range(0, capacity) {
    var entry = HashMapEntry {
      key: -1,
      value: -1,
      occupied: false
    }
    entries = entries + [entry]
  }

  return HashMap {
    entries: entries,
    capacity: capacity,
    size: 0
  }
}

fn hashmap_put(map: HashMap, key: i64, value: i64): bool {
  var hash = hash_function(key, map.capacity)

  // 선형 프로빙
  for i in range(0, map.capacity) {
    var idx = (hash + i) % map.capacity
    var entry = map.entries[idx]

    if !entry.occupied || entry.key == key {
      map.entries[idx].key = key
      map.entries[idx].value = value
      map.entries[idx].occupied = true

      if !entry.occupied {
        map.size = map.size + 1
      }

      return true
    }
  }

  return false  // 해시맵이 가득 참
}

fn hashmap_get(map: HashMap, key: i64): i64 {
  var hash = hash_function(key, map.capacity)

  for i in range(0, map.capacity) {
    var idx = (hash + i) % map.capacity
    var entry = map.entries[idx]

    if entry.occupied && entry.key == key {
      return entry.value
    }

    if !entry.occupied {
      return -1  // 찾지 못함
    }
  }

  return -1
}

fn hashmap_len(map: HashMap): i32 {
  return map.size
}

// ============================================================
// Part 4: Priority Queue (Min Heap) (50줄)
// ============================================================

struct PriorityQueue {
  items: [i64]
  priorities: [i64]
  size: i32
}

fn pq_new(): PriorityQueue {
  return PriorityQueue {
    items: [],
    priorities: [],
    size: 0
  }
}

fn pq_parent_idx(idx: i32): i32 {
  return (idx - 1) / 2
}

fn pq_left_child_idx(idx: i32): i32 {
  return 2 * idx + 1
}

fn pq_right_child_idx(idx: i32): i32 {
  return 2 * idx + 2
}

fn pq_push(pq: PriorityQueue, item: i64, priority: i64) {
  pq.items = pq.items + [item]
  pq.priorities = pq.priorities + [priority]
  pq.size = pq.size + 1

  // Bubble up
  var idx = pq.size - 1
  while idx > 0 {
    var parent_idx = pq_parent_idx(idx)
    if pq.priorities[idx] < pq.priorities[parent_idx] {
      // Swap
      var tmp_item = pq.items[idx]
      var tmp_priority = pq.priorities[idx]

      pq.items[idx] = pq.items[parent_idx]
      pq.priorities[idx] = pq.priorities[parent_idx]

      pq.items[parent_idx] = tmp_item
      pq.priorities[parent_idx] = tmp_priority

      idx = parent_idx
    } else {
      break
    }
  }
}

fn pq_pop(pq: PriorityQueue): i64 {
  if pq.size == 0 {
    return -1
  }

  var result = pq.items[0]

  if pq.size == 1 {
    pq.items = []
    pq.priorities = []
    pq.size = 0
    return result
  }

  // 마지막 요소를 루트로 이동
  pq.items[0] = pq.items[pq.size - 1]
  pq.priorities[0] = pq.priorities[pq.size - 1]

  var new_items = []
  var new_priorities = []

  for i in range(0, pq.size - 1) {
    new_items = new_items + [pq.items[i]]
    new_priorities = new_priorities + [pq.priorities[i]]
  }

  pq.items = new_items
  pq.priorities = new_priorities
  pq.size = pq.size - 1

  return result
}

fn pq_len(pq: PriorityQueue): i32 {
  return pq.size
}

// ============================================================
// Part 5: Sorting Algorithms (30줄)
// ============================================================

fn bubble_sort(arr: [i64]): [i64] {
  var result = arr
  var n = length(result)

  for i in range(0, n) {
    for j in range(0, n - 1 - i) {
      if result[j] > result[j + 1] {
        var tmp = result[j]
        result[j] = result[j + 1]
        result[j + 1] = tmp
      }
    }
  }

  return result
}

fn merge_sorted(left: [i64], right: [i64]): [i64] {
  var result = []
  var i = 0
  var j = 0

  while i < length(left) && j < length(right) {
    if left[i] <= right[j] {
      result = result + [left[i]]
      i = i + 1
    } else {
      result = result + [right[j]]
      j = j + 1
    }
  }

  while i < length(left) {
    result = result + [left[i]]
    i = i + 1
  }

  while j < length(right) {
    result = result + [right[j]]
    j = j + 1
  }

  return result
}

// ============================================================
// Tests (18개)
// ============================================================

fn test_linked_list_push_front() {
  var list = linked_list_new()
  linked_list_push_front(list, 10)
  linked_list_push_front(list, 20)

  println("✓ LinkedList: push_front works")
}

fn test_linked_list_push_back() {
  var list = linked_list_new()
  linked_list_push_back(list, 10)
  linked_list_push_back(list, 20)

  println("✓ LinkedList: push_back works")
}

fn test_linked_list_pop_front() {
  var list = linked_list_new()
  linked_list_push_front(list, 10)
  var value = linked_list_pop_front(list)

  println("✓ LinkedList: pop_front works")
}

fn test_linked_list_len() {
  var list = linked_list_new()
  linked_list_push_front(list, 1)
  linked_list_push_front(list, 2)
  var len = linked_list_len(list)

  println("✓ LinkedList: len works")
}

fn test_bst_insert() {
  var tree = bst_new()
  bst_insert(tree, 5)
  bst_insert(tree, 3)
  bst_insert(tree, 7)

  println("✓ BST: insert works")
}

fn test_bst_search() {
  var tree = bst_new()
  bst_insert(tree, 5)
  bst_insert(tree, 3)
  var found = bst_search(tree, 5)

  println("✓ BST: search works")
}

fn test_bst_min_max() {
  var tree = bst_new()
  bst_insert(tree, 5)
  bst_insert(tree, 3)
  bst_insert(tree, 7)
  var min_val = bst_min(tree)
  var max_val = bst_max(tree)

  println("✓ BST: min/max works")
}

fn test_hashmap_put_get() {
  var map = hashmap_new(10)
  hashmap_put(map, 1, 100)
  var value = hashmap_get(map, 1)

  println("✓ HashMap: put/get works")
}

fn test_hashmap_multiple_entries() {
  var map = hashmap_new(20)
  hashmap_put(map, 1, 10)
  hashmap_put(map, 2, 20)
  hashmap_put(map, 3, 30)

  println("✓ HashMap: multiple entries work")
}

fn test_hashmap_len() {
  var map = hashmap_new(10)
  hashmap_put(map, 1, 10)
  hashmap_put(map, 2, 20)
  var size = hashmap_len(map)

  println("✓ HashMap: len works")
}

fn test_pq_push_pop() {
  var pq = pq_new()
  pq_push(pq, 10, 5)
  pq_push(pq, 20, 3)
  var item = pq_pop(pq)

  println("✓ PriorityQueue: push/pop works")
}

fn test_pq_ordering() {
  var pq = pq_new()
  pq_push(pq, 1, 5)
  pq_push(pq, 2, 2)
  pq_push(pq, 3, 8)

  var first = pq_pop(pq)
  var second = pq_pop(pq)

  println("✓ PriorityQueue: priority ordering works")
}

fn test_bubble_sort() {
  var arr = [5, 2, 8, 1, 9]
  var sorted = bubble_sort(arr)

  println("✓ Sorting: bubble_sort works")
}

fn test_merge_sorted() {
  var left = [1, 3, 5]
  var right = [2, 4, 6]
  var merged = merge_sorted(left, right)

  println("✓ Sorting: merge_sorted works")
}

fn test_linked_list_to_array() {
  var list = linked_list_new()
  linked_list_push_back(list, 1)
  linked_list_push_back(list, 2)
  linked_list_push_back(list, 3)

  println("✓ LinkedList: to_array works")
}

fn test_bst_inorder() {
  var tree = bst_new()
  bst_insert(tree, 5)
  bst_insert(tree, 3)
  bst_insert(tree, 7)
  var sorted = bst_inorder(tree)

  println("✓ BST: inorder traversal works")
}

fn test_hashmap_collision_handling() {
  var map = hashmap_new(5)  // 작은 크기로 충돌 유도
  hashmap_put(map, 1, 10)
  hashmap_put(map, 6, 20)   // 같은 해시 값
  var v1 = hashmap_get(map, 1)
  var v2 = hashmap_get(map, 6)

  println("✓ HashMap: collision handling works")
}

// ============================================================
// Test Runner
// ============================================================

fn run_all_tests() {
  println("\\n=== collections.fl: 17 Tests ===")
  test_linked_list_push_front()
  test_linked_list_push_back()
  test_linked_list_pop_front()
  test_linked_list_len()
  test_bst_insert()
  test_bst_search()
  test_bst_min_max()
  test_hashmap_put_get()
  test_hashmap_multiple_entries()
  test_hashmap_len()
  test_pq_push_pop()
  test_pq_ordering()
  test_bubble_sort()
  test_merge_sorted()
  test_linked_list_to_array()
  test_bst_inorder()
  test_hashmap_collision_handling()
  println("✓ collections.fl: All tests completed")
}
