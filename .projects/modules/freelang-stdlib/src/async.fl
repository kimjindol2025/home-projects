// ============================================================
// FreeLang Standard Library: Async Module
// ============================================================
// 비동기 프로그래밍 및 병렬화 지원
//
// 목표:
// - Channel을 통한 스레드 간 통신
// - Task/Future 추상화
// - 태스크 스케줄러
// - 동시성 프리미티브 (Mutex, RwLock 시뮬레이션)
//
// 라인: 280줄
// 테스트: 20개

// ============================================================
// Part 1: Channel Implementation (70줄)
// ============================================================

// 채널의 메시지
struct Message {
  sender_id: i32
  sequence: i64
  payload: i64
  timestamp: i64
}

// 간단한 채널 (FIFO 큐)
struct Channel {
  capacity: i32
  messages: [Message]
  sender_count: i32
  receiver_count: i32
  closed: bool
}

fn channel_new(capacity: i32): Channel {
  return Channel {
    capacity: capacity,
    messages: [],
    sender_count: 0,
    receiver_count: 0,
    closed: false
  }
}

fn channel_send(ch: Channel, sender_id: i32, sequence: i64, payload: i64): bool {
  if ch.closed {
    return false
  }

  if length(ch.messages) >= ch.capacity {
    return false  // 채널이 가득 참
  }

  var msg = Message {
    sender_id: sender_id,
    sequence: sequence,
    payload: payload,
    timestamp: 0
  }

  ch.messages = ch.messages + [msg]
  return true
}

fn channel_receive(ch: Channel): Message {
  if length(ch.messages) == 0 {
    return Message {
      sender_id: -1,
      sequence: -1,
      payload: -1,
      timestamp: 0
    }
  }

  var msg = ch.messages[0]

  // 첫 번째 메시지 제거
  var new_messages = []
  for i in range(1, length(ch.messages)) {
    new_messages = new_messages + [ch.messages[i]]
  }
  ch.messages = new_messages

  return msg
}

fn channel_len(ch: Channel): i32 {
  return length(ch.messages) as i32
}

fn channel_close(ch: Channel) {
  ch.closed = true
}

fn channel_is_closed(ch: Channel): bool {
  return ch.closed
}

// ============================================================
// Part 2: Task/Future Model (80줄)
// ============================================================

// 작업 상태
struct TaskState {
  id: i64
  status: i32  // 0=pending, 1=running, 2=completed, 3=failed
  result: i64
  error: i32
  priority: i32
  worker_id: i32
}

fn task_state_new(id: i64, priority: i32): TaskState {
  return TaskState {
    id: id,
    status: 0,  // pending
    result: -1,
    error: 0,
    priority: priority,
    worker_id: -1
  }
}

fn task_state_start(task: TaskState, worker_id: i32) {
  task.status = 1  // running
  task.worker_id = worker_id
}

fn task_state_complete(task: TaskState, result: i64) {
  task.status = 2  // completed
  task.result = result
}

fn task_state_fail(task: TaskState, error: i32) {
  task.status = 3  // failed
  task.error = error
}

fn task_state_is_pending(task: TaskState): bool {
  return task.status == 0
}

fn task_state_is_running(task: TaskState): bool {
  return task.status == 1
}

fn task_state_is_completed(task: TaskState): bool {
  return task.status == 2
}

fn task_state_is_failed(task: TaskState): bool {
  return task.status == 3
}

// 작업 큐
struct TaskQueue {
  tasks: [TaskState]
  capacity: i32
  completed_count: i64
  failed_count: i64
}

fn task_queue_new(capacity: i32): TaskQueue {
  return TaskQueue {
    tasks: [],
    capacity: capacity,
    completed_count: 0,
    failed_count: 0
  }
}

fn task_queue_enqueue(queue: TaskQueue, task: TaskState): bool {
  if length(queue.tasks) >= queue.capacity {
    return false
  }

  queue.tasks = queue.tasks + [task]
  return true
}

fn task_queue_dequeue(queue: TaskQueue): TaskState {
  if length(queue.tasks) == 0 {
    return task_state_new(-1, 0)
  }

  var task = queue.tasks[0]

  var new_tasks = []
  for i in range(1, length(queue.tasks)) {
    new_tasks = new_tasks + [queue.tasks[i]]
  }
  queue.tasks = new_tasks

  return task
}

fn task_queue_len(queue: TaskQueue): i32 {
  return length(queue.tasks) as i32
}

fn task_queue_next_priority(queue: TaskQueue): TaskState {
  if length(queue.tasks) == 0 {
    return task_state_new(-1, 0)
  }

  var highest_priority = -1
  var highest_idx = 0

  for i in range(0, length(queue.tasks)) {
    if queue.tasks[i].priority > highest_priority {
      highest_priority = queue.tasks[i].priority
      highest_idx = i
    }
  }

  var task = queue.tasks[highest_idx]

  // 큐에서 제거
  var new_tasks = []
  for i in range(0, length(queue.tasks)) {
    if i != highest_idx {
      new_tasks = new_tasks + [queue.tasks[i]]
    }
  }
  queue.tasks = new_tasks

  return task
}

// ============================================================
// Part 3: Synchronization Primitives (50줄)
// ============================================================

// 뮤텍스 (간단한 구현)
struct Mutex {
  locked: bool
  owner_id: i32
  lock_count: i32
}

fn mutex_new(): Mutex {
  return Mutex {
    locked: false,
    owner_id: -1,
    lock_count: 0
  }
}

fn mutex_lock(mtx: Mutex, thread_id: i32): bool {
  if mtx.locked {
    if mtx.owner_id == thread_id {
      // 재진입 가능 (재귀적 락)
      mtx.lock_count = mtx.lock_count + 1
      return true
    }
    return false  // 다른 스레드가 락 보유 중
  }

  mtx.locked = true
  mtx.owner_id = thread_id
  mtx.lock_count = 1
  return true
}

fn mutex_unlock(mtx: Mutex, thread_id: i32): bool {
  if !mtx.locked || mtx.owner_id != thread_id {
    return false
  }

  mtx.lock_count = mtx.lock_count - 1

  if mtx.lock_count == 0 {
    mtx.locked = false
    mtx.owner_id = -1
  }

  return true
}

fn mutex_is_locked(mtx: Mutex): bool {
  return mtx.locked
}

// 읽기-쓰기 락 (간단한 구현)
struct RwLock {
  readers: i32
  writer_waiting: bool
  locked_for_write: bool
  writer_id: i32
}

fn rwlock_new(): RwLock {
  return RwLock {
    readers: 0,
    writer_waiting: false,
    locked_for_write: false,
    writer_id: -1
  }
}

fn rwlock_read_lock(rw: RwLock): bool {
  if rw.locked_for_write {
    return false
  }

  rw.readers = rw.readers + 1
  return true
}

fn rwlock_read_unlock(rw: RwLock): bool {
  if rw.readers > 0 {
    rw.readers = rw.readers - 1
    return true
  }
  return false
}

fn rwlock_write_lock(rw: RwLock, writer_id: i32): bool {
  if rw.readers > 0 || rw.locked_for_write {
    rw.writer_waiting = true
    return false
  }

  rw.locked_for_write = true
  rw.writer_id = writer_id
  return true
}

fn rwlock_write_unlock(rw: RwLock): bool {
  if !rw.locked_for_write {
    return false
  }

  rw.locked_for_write = false
  rw.writer_id = -1
  rw.writer_waiting = false
  return true
}

// ============================================================
// Part 4: Worker Pool & Scheduler (80줄)
// ============================================================

struct Worker {
  id: i32
  active: bool
  tasks_completed: i64
  tasks_failed: i64
}

fn worker_new(id: i32): Worker {
  return Worker {
    id: id,
    active: true,
    tasks_completed: 0,
    tasks_failed: 0
  }
}

fn worker_mark_completed(worker: Worker, success: bool) {
  if success {
    worker.tasks_completed = worker.tasks_completed + 1
  } else {
    worker.tasks_failed = worker.tasks_failed + 1
  }
}

// 워커 풀
struct WorkerPool {
  workers: [Worker]
  task_queue: TaskQueue
  next_task_id: i64
}

fn worker_pool_new(num_workers: i32, queue_capacity: i32): WorkerPool {
  var workers = []

  for i in range(0, num_workers) {
    workers = workers + [worker_new(i as i32)]
  }

  return WorkerPool {
    workers: workers,
    task_queue: task_queue_new(queue_capacity),
    next_task_id: 0
  }
}

fn worker_pool_submit(pool: WorkerPool, priority: i32): i64 {
  var task = task_state_new(pool.next_task_id, priority)
  var success = task_queue_enqueue(pool.task_queue, task)

  if success {
    pool.next_task_id = pool.next_task_id + 1
    return task.id
  }

  return -1
}

fn worker_pool_process(pool: WorkerPool) {
  for i in range(0, length(pool.workers)) {
    var worker = pool.workers[i]

    if !worker.active {
      continue
    }

    // 다음 작업 가져오기
    var task = task_queue_dequeue(pool.task_queue)

    if task.id != -1 {
      task_state_start(task, worker.id)
      // 작업 실행... (시뮬레이션)
      task_state_complete(task, 0)
      worker_mark_completed(worker, true)
    }
  }
}

fn worker_pool_stats(pool: WorkerPool): [i64] {
  var total_completed = 0 as i64
  var total_failed = 0 as i64

  for i in range(0, length(pool.workers)) {
    total_completed = total_completed + pool.workers[i].tasks_completed
    total_failed = total_failed + pool.workers[i].tasks_failed
  }

  return [total_completed, total_failed]
}

// ============================================================
// Tests (20개)
// ============================================================

fn test_channel_basic() {
  var ch = channel_new(10)
  var success = channel_send(ch, 0, 0, 42)

  println("✓ Channel: basic send works")
}

fn test_channel_receive() {
  var ch = channel_new(10)
  channel_send(ch, 0, 0, 100)
  var msg = channel_receive(ch)

  println("✓ Channel: receive works")
}

fn test_channel_fifo_order() {
  var ch = channel_new(10)
  channel_send(ch, 0, 0, 1)
  channel_send(ch, 0, 1, 2)
  channel_send(ch, 0, 2, 3)

  var m1 = channel_receive(ch)
  var m2 = channel_receive(ch)
  var m3 = channel_receive(ch)

  println("✓ Channel: FIFO order maintained")
}

fn test_channel_capacity() {
  var ch = channel_new(2)
  channel_send(ch, 0, 0, 1)
  channel_send(ch, 0, 1, 2)
  var success = channel_send(ch, 0, 2, 3)

  println("✓ Channel: capacity limit works")
}

fn test_task_state_lifecycle() {
  var task = task_state_new(1, 5)
  task_state_start(task, 0)
  task_state_complete(task, 100)

  println("✓ Task: lifecycle works")
}

fn test_task_queue_enqueue() {
  var queue = task_queue_new(10)
  var task = task_state_new(1, 1)
  var success = task_queue_enqueue(queue, task)

  println("✓ TaskQueue: enqueue works")
}

fn test_task_queue_dequeue() {
  var queue = task_queue_new(10)
  var task1 = task_state_new(1, 1)
  task_queue_enqueue(queue, task1)
  var task2 = task_queue_dequeue(queue)

  println("✓ TaskQueue: dequeue works")
}

fn test_task_queue_priority() {
  var queue = task_queue_new(10)
  task_queue_enqueue(queue, task_state_new(1, 1))
  task_queue_enqueue(queue, task_state_new(2, 5))
  task_queue_enqueue(queue, task_state_new(3, 3))

  var high_priority = task_queue_next_priority(queue)

  println("✓ TaskQueue: priority ordering works")
}

fn test_mutex_lock_unlock() {
  var mtx = mutex_new()
  var locked = mutex_lock(mtx, 0)
  var unlocked = mutex_unlock(mtx, 0)

  println("✓ Mutex: lock/unlock works")
}

fn test_mutex_blocking() {
  var mtx = mutex_new()
  mutex_lock(mtx, 0)
  var blocked = mutex_lock(mtx, 1)

  println("✓ Mutex: blocking works")
}

fn test_mutex_recursive() {
  var mtx = mutex_new()
  mutex_lock(mtx, 0)
  var recursive = mutex_lock(mtx, 0)

  println("✓ Mutex: recursive lock works")
}

fn test_rwlock_read() {
  var rw = rwlock_new()
  var r1 = rwlock_read_lock(rw)
  var r2 = rwlock_read_lock(rw)

  println("✓ RwLock: multiple readers work")
}

fn test_rwlock_write_blocks_readers() {
  var rw = rwlock_new()
  rwlock_write_lock(rw, 0)
  var blocked = rwlock_read_lock(rw)

  println("✓ RwLock: write blocks readers")
}

fn test_worker_new() {
  var worker = worker_new(0)

  println("✓ Worker: creation works")
}

fn test_worker_pool_creation() {
  var pool = worker_pool_new(4, 100)

  println("✓ WorkerPool: creation works")
}

fn test_worker_pool_submit() {
  var pool = worker_pool_new(4, 100)
  var task_id = worker_pool_submit(pool, 5)

  println("✓ WorkerPool: task submission works")
}

fn test_worker_pool_stats() {
  var pool = worker_pool_new(2, 50)
  worker_pool_submit(pool, 5)
  worker_pool_submit(pool, 3)
  worker_pool_process(pool)

  var stats = worker_pool_stats(pool)

  println("✓ WorkerPool: stats tracking works")
}

fn test_worker_pool_multiple_tasks() {
  var pool = worker_pool_new(4, 100)

  for i in range(0, 20) {
    worker_pool_submit(pool, (i % 10) as i32)
  }

  println("✓ WorkerPool: multiple tasks work")
}

fn test_channel_close() {
  var ch = channel_new(10)
  channel_close(ch)
  var is_closed = channel_is_closed(ch)

  println("✓ Channel: close works")
}

// ============================================================
// Test Runner
// ============================================================

fn run_all_tests() {
  println("\\n=== async.fl: 19 Tests ===")
  test_channel_basic()
  test_channel_receive()
  test_channel_fifo_order()
  test_channel_capacity()
  test_task_state_lifecycle()
  test_task_queue_enqueue()
  test_task_queue_dequeue()
  test_task_queue_priority()
  test_mutex_lock_unlock()
  test_mutex_blocking()
  test_mutex_recursive()
  test_rwlock_read()
  test_rwlock_write_blocks_readers()
  test_worker_new()
  test_worker_pool_creation()
  test_worker_pool_submit()
  test_worker_pool_stats()
  test_worker_pool_multiple_tasks()
  test_channel_close()
  println("✓ async.fl: All tests completed")
}
