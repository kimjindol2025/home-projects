// ============================================================================
// BNS API 핸들러 - 4개 엔드포인트 구현
// ============================================================================
// /api/status, /api/gogs, /api/feed, /api/db

module bns_handlers {
    use bns_models;
    use bns_http;
    use bns_broadcast;

    // === 라우터 ===
    func handle_request(req: bns_http.HttpRequest) -> bns_models.HttpResponse {
        // 경로별 라우팅
        if req.path == "/api/status" {
            return handle_status();
        } else if req.path == "/api/gogs" {
            return handle_gogs();
        } else if req.path == "/api/feed" {
            return handle_feed();
        } else if req.path == "/api/db" {
            return handle_db();
        } else if req.path == "/" {
            return handle_root();
        } else {
            return bns_models.http_response_error(404, "Endpoint not found");
        }
    }

    // === /api/status - 프로젝트 상태 ===
    func handle_status() -> bns_models.HttpResponse {
        // 프로젝트 데이터 구성
        let projects = make([bns_models.ProjectStatus], 2);

        // Zero-Copy-DB
        let zdb: bns_models.ProjectStatus;
        zdb.name = "Zero-Copy-DB";
        zdb.phase = 11;
        zdb.lines = 22439;
        zdb.files = 56;
        zdb.tests = 182;
        zdb.status = "✅ COMPLETE";
        projects[0] = zdb;

        // Self-Evolving Compiler
        let compiler: bns_models.ProjectStatus;
        compiler.name = "Self-Evolving Compiler";
        compiler.phase = 8;
        compiler.lines = 4435;
        compiler.files = 20;
        compiler.tests = 80;
        compiler.status = "✅ COMPLETE";
        projects[1] = compiler;

        // JSON 구성
        let json = "{";
        json = json + "\"last_update\": \"2026-03-29\",";
        json = json + "\"projects\": [";

        let i = 0;
        for i = 0; i < len(projects); i = i + 1 {
            if i > 0 {
                json = json + ",";
            }

            let p = projects[i];
            json = json + "{";
            json = json + "\"name\": \"" + p.name + "\",";
            json = json + "\"phase\": " + to_string(p.phase) + ",";
            json = json + "\"lines\": " + to_string(p.lines) + ",";
            json = json + "\"files\": " + to_string(p.files) + ",";
            json = json + "\"tests\": " + to_string(p.tests) + ",";
            json = json + "\"status\": \"" + p.status + "\"";
            json = json + "}";
        }

        json = json + "],";
        json = json + "\"total_lines\": 51998,";
        json = json + "\"total_tests\": 182";
        json = json + "}";

        return bns_models.http_response_ok(json, bns_models.CONTENT_JSON);
    }

    // === /api/gogs - 최근 커밋 ===
    func handle_gogs() -> bns_models.HttpResponse {
        // 최근 커밋 데이터
        let commits = make([bns_models.GogsCommit], 3);

        // Commit 1
        let c1: bns_models.GogsCommit;
        c1.hash = "2bc0873";
        c1.message = "perf: 필터링 및 정렬 성능 최적화";
        c1.repo = "zero-copy-db";
        c1.date = "2026-03-29";
        c1.files_changed = 2;
        c1.insertions = 89;
        c1.deletions = 45;
        commits[0] = c1;

        // Commit 2
        let c2: bns_models.GogsCommit;
        c2.hash = "2db6fb2";
        c2.message = "feat: Phase 11 통합 쿼리 파이프라인 완성";
        c2.repo = "zero-copy-db";
        c2.date = "2026-03-28";
        c2.files_changed = 4;
        c2.insertions = 1358;
        c2.deletions = 0;
        commits[1] = c2;

        // Commit 3
        let c3: bns_models.GogsCommit;
        c3.hash = "8e47b1f";
        c3.message = "Query Parser Phase 10: SQL-like 파싱 엔진";
        c3.repo = "zero-copy-db";
        c3.date = "2026-03-28";
        c3.files_changed = 1;
        c3.insertions = 557;
        c3.deletions = 0;
        commits[2] = c3;

        // JSON 구성
        let json = "{";
        json = json + "\"recent_commits\": [";

        let i = 0;
        for i = 0; i < len(commits); i = i + 1 {
            if i > 0 {
                json = json + ",";
            }

            let c = commits[i];
            json = json + "{";
            json = json + "\"hash\": \"" + c.hash + "\",";
            json = json + "\"message\": \"" + c.message + "\",";
            json = json + "\"repo\": \"" + c.repo + "\",";
            json = json + "\"date\": \"" + c.date + "\",";
            json = json + "\"files_changed\": " + to_string(c.files_changed) + ",";
            json = json + "\"insertions\": " + to_string(c.insertions) + ",";
            json = json + "\"deletions\": " + to_string(c.deletions);
            json = json + "}";
        }

        json = json + "],";
        json = json + "\"repo_count\": 6,";
        json = json + "\"total_commits\": 100";
        json = json + "}";

        return bns_models.http_response_ok(json, bns_models.CONTENT_JSON);
    }

    // === /api/feed - Server-Sent Events (실시간 스트림) ===
    func handle_feed() -> bns_models.HttpResponse {
        // 브로드캐스트에 구독자 등록
        let (sub_ch, sub_id) = bns_broadcast.broadcast_subscribe();

        if sub_id < 0 {
            // 구독자 수 초과
            return bns_models.http_response_error(503, "Too many subscribers");
        }

        // 채널에서 이벤트 수신 시도 (100 tick 폴링)
        let i = 0;
        for i = 0; i < 100; i = i + 1 {
            let (idx, ok) = sub_ch.chan_recv();

            if ok {
                let event_json = bns_broadcast.broadcast_get_event(idx);
                bns_broadcast.broadcast_unsubscribe(sub_id);
                return bns_models.http_response_sse(event_json);
            }
        }

        // 타임아웃: 최신 이벤트 또는 더미 데이터 반환
        bns_broadcast.broadcast_unsubscribe(sub_id);

        let latest = bns_broadcast.broadcast_get_latest();
        if len(latest) == 2 {  // "{}" 빈 이벤트
            // 아직 이벤트 없음 - 더미 반환
            latest = "{\"status\": \"waiting\", \"message\": \"No events yet\"}";
        }

        return bns_models.http_response_sse(latest);
    }

    // === /api/db - Zero-Copy-DB 상태 ===
    func handle_db() -> bns_models.HttpResponse {
        let json = "{";
        json = json + "\"name\": \"Zero-Copy-DB\",";
        json = json + "\"phase\": 11,";
        json = json + "\"modules\": 11,";
        json = json + "\"total_lines\": 22439,";
        json = json + "\"memory_usage_mb\": 8.5,";
        json = json + "\"active_transactions\": 3,";
        json = json + "\"cached_queries\": 12,";
        json = json + "\"performance\": {";
        json = json + "\"query_latency_ms\": 2.5,";
        json = json + "\"insert_throughput_per_sec\": 5000,";
        json = json + "\"index_hit_rate\": 0.94";
        json = json + "}";
        json = json + "}";

        return bns_models.http_response_ok(json, bns_models.CONTENT_JSON);
    }

    // === / - 루트 (홈페이지) ===
    func handle_root() -> bns_models.HttpResponse {
        let html = "<html><body>";
        html = html + "<h1>🚀 Bigwash Native Shell (BNS)</h1>";
        html = html + "<p>기록이 증명이다</p>";
        html = html + "<ul>";
        html = html + "<li><a href='/api/status'>/api/status</a> - 프로젝트 상태</li>";
        html = html + "<li><a href='/api/gogs'>/api/gogs</a> - Gogs 커밋</li>";
        html = html + "<li><a href='/api/feed'>/api/feed</a> - 실시간 피드 (SSE)</li>";
        html = html + "<li><a href='/api/db'>/api/db</a> - DB 상태</li>";
        html = html + "</ul>";
        html = html + "</body></html>";

        return bns_models.http_response_ok(html, "text/html");
    }

    // === 헬퍼: 정수를 문자열로 ===
    @inline
    func to_string(n: i32) -> string {
        if n == 0 {
            return "0";
        }

        let negative = false;
        if n < 0 {
            negative = true;
            n = 0 - n;
        }

        let result = "";
        let temp = n;

        for temp > 0 {
            let digit = temp % 10;
            let ch = char_from_code(48 + digit);  // '0' = 48
            result = ch + result;
            temp = temp / 10;
        }

        if negative {
            result = "-" + result;
        }

        return result;
    }
}
