console.log('\n⚠️  Deployment Problem Scenarios\n');

test('Database concurrency: Multiple operations', () => {
  const db = new BlogDatabase('/tmp/test-concurrency.json');

  // Simulate rapid operations
  const ids = [];
  for (let i = 0; i < 10; i++) {
    const post = db.create({
      title: `Concurrent ${i}`,
      author: 'Jane',
      content: 'X',
      category: 'News',
      tags: '',
      slug: `conc-${i}`
    });
    ids.push(post.id);
  }

  // Verify all created
  if (db.posts.size !== 10) throw new Error('Some posts lost during concurrent creation');

  // Verify each can be updated
  ids.forEach(id => {
    db.update(id, { viewCount: 5 });
  });

  ids.forEach(id => {
    const post = db.getById(id);
    if (post.viewCount !== 5) throw new Error('Update failed');
  });
});

test('Database file corruption recovery', () => {
  const dbPath = '/tmp/test-corruption.json';

  // Create valid DB
  const db1 = new BlogDatabase(dbPath);
  db1.create({ title: 'Original', author: 'Jane', content: 'X', category: 'News', tags: '', slug: 'orig' });

  // Corrupt file
  fs.writeFileSync(dbPath, 'INVALID JSON {{{');

  // Attempt recovery
  const db2 = new BlogDatabase(dbPath);
  if (db2.posts.size !== 0) {
    // Recovery worked - started fresh
  }

  fs.unlinkSync(dbPath);
});

test('Memory limits: Large post creation', () => {
  const db = new BlogDatabase('/tmp/test-memory.json');

  // Create large content
  const largeContent = 'X'.repeat(100000);
  const post = db.create({
    title: 'Large Post',
    author: 'Jane',
    content: largeContent,
    category: 'News',
    tags: '',
    slug: 'large'
  });

  if (!post.id) throw new Error('Large post creation failed');
