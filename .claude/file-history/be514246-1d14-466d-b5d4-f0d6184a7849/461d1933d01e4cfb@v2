console.log('\n📦 Database Layer Tests\n');

test('Database initialization', () => {
  const db = new BlogDatabase('/tmp/test-blog-1.json');
  if (db.posts.size !== 0) throw new Error('Database should start empty');
  if (db.nextId !== 1) throw new Error('nextId should start at 1');
});

test('Create blog post', () => {
  const db = new BlogDatabase('/tmp/test-blog-2.json');
  const post = db.create({
    title: 'First Post',
    author: 'John',
    content: 'Hello world',
    category: 'Tutorial',
    tags: 'nodejs,freelang',
    slug: 'first-post',
    featured: false,
    publishedAt: 0
  });

  if (!post.id) throw new Error('Post should have ID');
  if (post.title !== 'First Post') throw new Error('Title mismatch');
  if (!post.createdAt) throw new Error('createdAt missing');
  if (post.viewCount !== 0) throw new Error('viewCount should start at 0');
  if (post.likes !== 0) throw new Error('likes should start at 0');
});

test('Read blog post by ID', () => {
  const db = new BlogDatabase('/tmp/test-blog-3.json');
  const created = db.create({ title: 'Test', author: 'Jane', content: 'Content', category: 'News', tags: '', slug: 'test' });
  const retrieved = db.getById(created.id);

  if (!retrieved) throw new Error('Post not found');
  if (retrieved.id !== created.id) throw new Error('ID mismatch');
  if (retrieved.title !== 'Test') throw new Error('Title mismatch');
});

test('Update blog post', () => {
  const db = new BlogDatabase('/tmp/test-blog-4.json');
  const post = db.create({ title: 'Original', author: 'Jane', content: 'Old', category: 'News', tags: '', slug: 'orig' });
  const updated = db.update(post.id, { title: 'Updated', content: 'New' });

  if (updated.title !== 'Updated') throw new Error('Title not updated');
  if (updated.content !== 'New') throw new Error('Content not updated');
  if (!updated.updatedAt) throw new Error('updatedAt missing');
});

test('Delete blog post', () => {
  const db = new BlogDatabase('/tmp/test-blog-5.json');
  const post = db.create({ title: 'Temp', author: 'Jane', content: 'X', category: 'News', tags: '', slug: 'temp' });
  const existed = db.delete(post.id);
  const retrieved = db.getById(post.id);

  if (!existed) throw new Error('Delete should return true');
  if (retrieved) throw new Error('Post should be deleted');
});

test('List with pagination', () => {
  const db = new BlogDatabase('/tmp/test-blog-6.json');
  for (let i = 0; i < 15; i++) {
    db.create({ title: `Post ${i}`, author: 'Jane', content: 'X', category: 'News', tags: '', slug: `post-${i}` });
  }

  const page1 = db.list({ page: 1, limit: 10 });
  const page2 = db.list({ page: 2, limit: 10 });

  if (page1.data.length !== 10) throw new Error('Page 1 should have 10 items');
  if (page2.data.length !== 5) throw new Error('Page 2 should have 5 items');
  if (page1.pagination.pages !== 2) throw new Error('Should have 2 pages');
});

test('Filter by category', () => {
  const db = new BlogDatabase('/tmp/test-blog-7.json');
  db.create({ title: 'Tutorial', author: 'Jane', content: 'X', category: 'Tutorial', tags: '', slug: 'tut' });
  db.create({ title: 'News', author: 'Jane', content: 'X', category: 'News', tags: '', slug: 'news' });
  db.create({ title: 'Another Tutorial', author: 'Jane', content: 'X', category: 'Tutorial', tags: '', slug: 'tut2' });

  const tutorials = db.list({ category: 'Tutorial' });
  if (tutorials.data.length !== 2) throw new Error('Should have 2 tutorials');
  tutorials.data.forEach(p => {
    if (p.category !== 'Tutorial') throw new Error('Wrong category');
  });
});

test('Increment views', () => {
  const db = new BlogDatabase('/tmp/test-blog-8.json');
  const post = db.create({ title: 'Popular', author: 'Jane', content: 'X', category: 'News', tags: '', slug: 'pop' });

  db.incrementViews(post.id);
  db.incrementViews(post.id);

  const updated = db.getById(post.id);
  if (updated.viewCount !== 2) throw new Error(`Expected viewCount=2, got ${updated.viewCount}`);
});

test('Add likes', () => {
  const db = new BlogDatabase('/tmp/test-blog-9.json');
  const post = db.create({ title: 'Great Post', author: 'Jane', content: 'X', category: 'News', tags: '', slug: 'great' });

  db.addLike(post.id);
  db.addLike(post.id);
  db.addLike(post.id);

  const updated = db.getById(post.id);
  if (updated.likes !== 3) throw new Error(`Expected likes=3, got ${updated.likes}`);
});

test('Persistence: Save and load', () => {
  const dbPath = '/tmp/test-blog-persist.json';
  const db1 = new BlogDatabase(dbPath);
  db1.create({ title: 'Persistent', author: 'Jane', content: 'X', category: 'News', tags: '', slug: 'persist' });

  const db2 = new BlogDatabase(dbPath);
  if (db2.posts.size !== 1) throw new Error('Post not persisted');
  const post = Array.from(db2.posts.values())[0];
  if (post.title !== 'Persistent') throw new Error('Data not persisted correctly');

  fs.unlinkSync(dbPath);
});

