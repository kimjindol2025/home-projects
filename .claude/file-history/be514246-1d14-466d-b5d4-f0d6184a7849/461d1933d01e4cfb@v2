});

test('CORS headers present', () => {
  const db = new BlogDatabase('/tmp/test-cors.json');
  const api = new BlogAPI(db);

  let corsHeaders = {};
  const req = { url: '/api/blogs', method: 'OPTIONS' };
  const res = {
    setHeader: (key, value) => {
      corsHeaders[key] = value;
    },
    writeHead: () => {},
    end: () => {}
  };

  api.handle(req, res);

  if (!corsHeaders['Access-Control-Allow-Origin']) throw new Error('Missing CORS Allow-Origin');
  if (!corsHeaders['Access-Control-Allow-Methods']) throw new Error('Missing CORS Allow-Methods');
});

test('Input validation: SQL injection attempt', () => {
  const db = new BlogDatabase('/tmp/test-injection.json');
  const api = new BlogAPI(db);

  const maliciousData = {
    title: "'; DROP TABLE posts; --",
    author: 'Jane',
    content: 'X',
    category: 'News',
    tags: '',
    slug: 'injection'
  };

  const post = db.create(maliciousData);

  // Verify data stored as-is (no SQL execution)
  if (post.title !== "'; DROP TABLE posts; --") throw new Error('Data not stored correctly');
  if (db.posts.size !== 1) throw new Error('Table not compromised (good!)');
});

test('Rate limiting check: Too many requests', () => {
  const db = new BlogDatabase('/tmp/test-rate.json');
  const api = new BlogAPI(db);

  // Note: Current implementation doesn't have rate limiting
  // This test documents the missing feature
  let requestCount = 0;
  for (let i = 0; i < 100; i++) {
    const req = { url: '/api/blogs', method: 'GET' };
    const res = {
      setHeader: () => {},
      writeHead: () => {},
      end: () => { requestCount++; }
    };
    api.handle(req, res);
  }

  if (requestCount !== 100) throw new Error('All requests processed (no rate limiting)');
  // In production, should have: 429 Too Many Requests after threshold
});

