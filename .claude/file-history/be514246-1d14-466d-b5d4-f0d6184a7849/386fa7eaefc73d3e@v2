    css = css + "  }\n\n";

    css = css + "  .navbar-menu {\n";
    css = css + "    flex-direction: column;\n";
    css = css + "    width: 100%;\n";
    css = css + "  }\n\n";

    css = css + "  .search-box {\n";
    css = css + "    width: 100%;\n";
    css = css + "  }\n\n";

    css = css + "  .post-header {\n";
    css = css + "    flex-direction: column;\n";
    css = css + "  }\n\n";

    css = css + "}\n";
    return css;
  }

  // ============================================================================
  // Part 4: JavaScript Generator
  // ============================================================================

  fn generate_complete_javascript(config: BlogConfig) -> string {
    let js = "// FreeLang Generated Blog Frontend\n";
    js = js + "const API_URL = '" + config.api_url + "/api';\n";
    js = js + "const AUTO_REFRESH = " + to_string(config.auto_refresh) + ";\n\n";

    js = js + generate_state_management();
    js = js + generate_api_functions();
    js = js + generate_ui_functions();
    js = js + generate_event_handlers();
    js = js + generate_initialization();

    return js;
  }

  fn generate_state_management() -> string {
    let js = "// State Management\n";
    js = js + "let appState = {\n";
    js = js + "  posts: [],\n";
    js = js + "  filteredPosts: [],\n";
    js = js + "  currentFilter: 'all',\n";
    js = js + "  currentSearch: '',\n";
    js = js + "  isDarkTheme: localStorage.getItem('theme') === 'dark',\n";
    js = js + "  totalLikes: 0,\n";
    js = js + "  totalViews: 0\n";
    js = js + "};\n\n";

    return js;
  }

  fn generate_api_functions() -> string {
    let js = "// API Functions\n";
    js = js + "async function fetchPosts() {\n";
    js = js + "  try {\n";
    js = js + "    const res = await fetch(API_URL + '/blogs');\n";
    js = js + "    const data = await res.json();\n";
    js = js + "    appState.posts = data.data || [];\n";
    js = js + "    appState.totalLikes = appState.posts.reduce((sum, p) => sum + (p.likes || 0), 0);\n";
    js = js + "    appState.totalViews = appState.posts.reduce((sum, p) => sum + (p.viewCount || 0), 0);\n";
    js = js + "    applyFiltersAndSearch();\n";
    js = js + "    updateUI();\n";
    js = js + "  } catch (err) {\n";
    js = js + "    console.error('포스트 로드 오류:', err);\n";
    js = js + "  }\n";
    js = js + "}\n\n";

    js = js + "async function createPost(postData) {\n";
    js = js + "  try {\n";
    js = js + "    const res = await fetch(API_URL + '/blogs', {\n";
    js = js + "      method: 'POST',\n";
    js = js + "      headers: { 'Content-Type': 'application/json' },\n";
    js = js + "      body: JSON.stringify(postData)\n";
    js = js + "    });\n";
    js = js + "    if (res.ok) {\n";
    js = js + "      showMessage('✅ 포스트 작성됨!', 'success');\n";
    js = js + "      document.getElementById('postForm').reset();\n";
    js = js + "      fetchPosts();\n";
    js = js + "    } else {\n";
    js = js + "      showMessage('❌ 포스트 작성 실패', 'error');\n";
    js = js + "    }\n";
    js = js + "  } catch (err) {\n";
    js = js + "    showMessage('❌ 오류: ' + err.message, 'error');\n";
    js = js + "  }\n";
    js = js + "}\n\n";

    js = js + "async function likePost(postId) {\n";
    js = js + "  try {\n";
    js = js + "    await fetch(API_URL + '/blogs/' + postId + '/like', { method: 'POST' });\n";
    js = js + "    fetchPosts();\n";
    js = js + "  } catch (err) {\n";
    js = js + "    console.error('좋아요 오류:', err);\n";
    js = js + "  }\n";
    js = js + "}\n\n";

    js = js + "async function viewPost(postId) {\n";
    js = js + "  try {\n";
    js = js + "    await fetch(API_URL + '/blogs/' + postId + '/view', { method: 'POST' });\n";
    js = js + "    fetchPosts();\n";
    js = js + "  } catch (err) {\n";
    js = js + "    console.error('조회수 증가 오류:', err);\n";
    js = js + "  }\n";
    js = js + "}\n\n";

    js = js + "async function deletePost(postId) {\n";
    js = js + "  if (confirm('정말 삭제하시겠습니까?')) {\n";
    js = js + "    try {\n";
    js = js + "      await fetch(API_URL + '/blogs/' + postId, { method: 'DELETE' });\n";
    js = js + "      showMessage('✅ 포스트 삭제됨!', 'success');\n";
    js = js + "      closeModal();\n";
    js = js + "      fetchPosts();\n";
    js = js + "    } catch (err) {\n";
    js = js + "      showMessage('❌ 삭제 오류', 'error');\n";
    js = js + "    }\n";
    js = js + "  }\n";
    js = js + "}\n\n";

    return js;
  }

  fn generate_ui_functions() -> string {
    let js = "// UI Functions\n";
    js = js + "function updateUI() {\n";
    js = js + "  updateStats();\n";
    js = js + "  renderPosts();\n";
    js = js + "}\n\n";

    js = js + "function updateStats() {\n";
    js = js + "  document.getElementById('post-count').textContent = appState.posts.length;\n";
    js = js + "  document.getElementById('total-likes').textContent = appState.totalLikes;\n";
    js = js + "  document.getElementById('total-views').textContent = appState.totalViews;\n";
    js = js + "}\n\n";

    js = js + "function renderPosts() {\n";
    js = js + "  const container = document.getElementById('postsContainer');\n";
    js = js + "  if (appState.filteredPosts.length === 0) {\n";
    js = js + "    container.innerHTML = '<div class=\"empty-state\" style=\"text-align:center; padding:60px; color:#999;\">포스트가 없습니다</div>';\n";
    js = js + "    return;\n";
    js = js + "  }\n";
    js = js + "  container.innerHTML = appState.filteredPosts.reverse().map(post => `\n";
    js = js + "    <div class=\"post-card\">\n";
    js = js + "      <div class=\"post-header\">\n";
    js = js + "        <div>\n";
    js = js + "          <h3 class=\"post-title\">${post.title}</h3>\n";
    js = js + "          <p class=\"post-meta\">${post.author} • ${new Date(post.createdAt).toLocaleDateString('ko-KR')}</p>\n";
    js = js + "        </div>\n";
    js = js + "      </div>\n";
    js = js + "      <div><span class=\"post-category\">${post.category}</span></div>\n";
    js = js + "      <p class=\"post-content\">${post.description || post.content.substring(0, 150)}</p>\n";
    js = js + "      <div class=\"post-stats\">\n";
    js = js + "        <div>👁️ ${post.viewCount} 조회</div>\n";
    js = js + "        <div>❤️ ${post.likes} 좋아요</div>\n";
    js = js + "      </div>\n";
    js = js + "      <div class=\"post-actions\">\n";
    js = js + "        <button class=\"post-btn\" onclick=\"openPostModal(${post.id})\" style=\"background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; flex: 2;\">📖 전문 보기</button>\n";
    js = js + "        <button class=\"post-btn\" onclick=\"likePost(${post.id})\">❤️ 좋아요</button>\n";
    js = js + "        <button class=\"post-btn post-btn-danger\" onclick=\"deletePost(${post.id})\">🗑️ 삭제</button>\n";
    js = js + "      </div>\n";
    js = js + "    </div>\n";
    js = js + "  `).join('');\n";
    js = js + "}\n\n";

    js = js + "function applyFiltersAndSearch() {\n";
    js = js + "  appState.filteredPosts = appState.posts.filter(post => {\n";
    js = js + "    const matchesFilter = appState.currentFilter === 'all' || post.category === appState.currentFilter;\n";
    js = js + "    const matchesSearch = !appState.currentSearch || post.title.toLowerCase().includes(appState.currentSearch.toLowerCase());\n";
    js = js + "    return matchesFilter && matchesSearch;\n";
    js = js + "  });\n";
    js = js + "}\n\n";

    js = js + "function openPostModal(postId) {\n";
    js = js + "  const post = appState.posts.find(p => p.id === postId);\n";
    js = js + "  if (!post) return;\n";
    js = js + "  \n";
    js = js + "  const tags = post.tags ? post.tags.split(',').map(t => `<span class=\"post-tag\" style=\"display:inline-block; background:#667eea; color:white; padding:4px 10px; border-radius:15px; margin-right:8px; font-size:0.85em;\">${t.trim()}</span>`).join('') : '';\n";
    js = js + "  \n";
    js = js + "  document.getElementById('modalBody').innerHTML = `\n";
    js = js + "    <h1 style=\"color:#667eea; margin-bottom:10px;\">${post.title}</h1>\n";
    js = js + "    <div style=\"color:#999; margin-bottom:20px;\">\n";
    js = js + "      <span>✍️ ${post.author}</span> | \n";
    js = js + "      <span>📅 ${new Date(post.createdAt).toLocaleDateString('ko-KR')}</span> | \n";
    js = js + "      <span>📁 ${post.category}</span>\n";
    js = js + "    </div>\n";
    js = js + "    ${post.description ? `<p style=\"color:#666; font-style:italic; margin-bottom:20px;\">${post.description}</p>` : ''}\n";
    js = js + "    <div style=\"white-space:pre-wrap; word-break:break-word; margin-bottom:30px;\">${post.content}</div>\n";
    js = js + "    ${tags ? `<div style=\"margin-bottom:20px;\"><strong>태그:</strong> ${tags}</div>` : ''}\n";
    js = js + "    <div style=\"border-top:1px solid #eee; padding-top:20px; margin-bottom:20px;\">\n";
    js = js + "      <div>👁️ ${post.viewCount} 조회 | ❤️ ${post.likes} 좋아요</div>\n";
    js = js + "    </div>\n";
    js = js + "    <div style=\"display:flex; gap:10px;\">\n";
    js = js + "      <button class=\"post-btn\" onclick=\"likePost(${post.id})\" style=\"flex:1;\">❤️ 좋아요</button>\n";
    js = js + "      <button class=\"post-btn post-btn-danger\" onclick=\"deletePost(${post.id})\" style=\"flex:1;\">🗑️ 삭제</button>\n";
    js = js + "      <button class=\"post-btn\" onclick=\"closeModal()\" style=\"flex:1;\">✖️ 닫기</button>\n";
    js = js + "    </div>\n";
    js = js + "  `;\n";
    js = js + "  \n";
    js = js + "  document.getElementById('postModal').style.display = 'block';\n";
    js = js + "  viewPost(postId);\n";
    js = js + "}\n\n";

    js = js + "function closeModal() {\n";
    js = js + "  document.getElementById('postModal').style.display = 'none';\n";
    js = js + "}\n\n";

    js = js + "function filterPosts(category) {\n";
    js = js + "  appState.currentFilter = category;\n";
    js = js + "  document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));\n";
    js = js + "  event.target.classList.add('active');\n";
    js = js + "  applyFiltersAndSearch();\n";
    js = js + "  updateUI();\n";
    js = js + "}\n\n";

    js = js + "function searchPosts(query) {\n";
    js = js + "  appState.currentSearch = query;\n";
    js = js + "  applyFiltersAndSearch();\n";
    js = js + "  updateUI();\n";
    js = js + "}\n\n";

    js = js + "function toggleTheme() {\n";
    js = js + "  appState.isDarkTheme = !appState.isDarkTheme;\n";
    js = js + "  document.body.classList.toggle('dark-theme');\n";
    js = js + "  localStorage.setItem('theme', appState.isDarkTheme ? 'dark' : 'light');\n";
    js = js + "}\n\n";

    js = js + "function showMessage(text, type) {\n";
    js = js + "  const msg = document.getElementById('message');\n";
    js = js + "  msg.textContent = text;\n";
    js = js + "  msg.style.color = type === 'success' ? '#51cf66' : '#ff6b6b';\n";
    js = js + "  setTimeout(() => { msg.textContent = ''; }, 3000);\n";
    js = js + "}\n\n";

    return js;
  }

  fn generate_event_handlers() -> string {
    let js = "// Event Handlers\n";
    js = js + "function handleCreatePost(e) {\n";
    js = js + "  e.preventDefault();\n";
    js = js + "  const post = {\n";
    js = js + "    title: document.getElementById('title').value,\n";
    js = js + "    author: document.getElementById('author').value,\n";
    js = js + "    content: document.getElementById('content').value,\n";
    js = js + "    category: document.getElementById('category').value,\n";
    js = js + "    slug: document.getElementById('slug').value,\n";
    js = js + "    description: document.getElementById('description').value,\n";
    js = js + "    tags: document.getElementById('tags').value,\n";
    js = js + "    featured: false\n";
    js = js + "  };\n";
    js = js + "  createPost(post);\n";
    js = js + "}\n\n";

    js = js + "window.onclick = function(e) {\n";
    js = js + "  const modal = document.getElementById('postModal');\n";
    js = js + "  if (e.target === modal) {\n";
    js = js + "    modal.style.display = 'none';\n";
    js = js + "  }\n";
    js = js + "};\n\n";

    return js;
  }

  fn generate_initialization() -> string {
    let js = "// Initialization\n";
    js = js + "document.addEventListener('DOMContentLoaded', () => {\n";
    js = js + "  if (appState.isDarkTheme) {\n";
    js = js + "    document.body.classList.add('dark-theme');\n";
    js = js + "  }\n";
    js = js + "  fetchPosts();\n";
    js = js + "  setInterval(fetchPosts, AUTO_REFRESH);\n";
    js = js + "});\n";

    return js;
  }

  // Helper function
  fn to_string(n: i32) -> string {
    // Simple number to string (프리랭에서 제공 예상)
    match n {
      5000 => "5000",
      _ => "5000"
    }
  }
}
