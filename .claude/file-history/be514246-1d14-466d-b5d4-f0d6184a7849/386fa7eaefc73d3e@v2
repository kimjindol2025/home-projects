/**
 * FreeLang Frontend Generator
 * 프리랭으로 완전한 블로그 프론트엔드 생성
 *
 * 목표:
 * 1. HTML 완전 생성 (구조)
 * 2. CSS 완전 생성 (스타일)
 * 3. JavaScript 완전 생성 (동작)
 * 4. API 통합 (백엔드 연결)
 * 5. 상태 관리 (클라이언트 사이드)
 */

module FrontendGenerator {

  // ============================================================================
  // Part 1: Configuration & Types
  // ============================================================================

  struct BlogConfig {
    title: string,
    api_url: string,
    port: i32,
    theme: string,
    auto_refresh: i32,  // milliseconds
  }

  struct UIState {
    current_page: i32,
    posts_per_page: i32,
    theme: string,
    search_query: string,
    selected_category: string,
  }

  // ============================================================================
  // Part 2: HTML Generator
  // ============================================================================

  pub fn generate_complete_html(config: BlogConfig) -> string {
    let html = "<!DOCTYPE html>\n";
    html = html + "<html lang=\"ko\">\n";
    html = html + generate_head(config);
    html = html + generate_body(config);
    html = html + "</html>\n";
    return html;
  }

  fn generate_head(config: BlogConfig) -> string {
    let head = "<head>\n";
    head = head + "  <meta charset=\"UTF-8\">\n";
    head = head + "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n";
    head = head + "  <title>" + config.title + "</title>\n";
    head = head + "  <style>\n";
    head = head + generate_complete_css(config);
    head = head + "  </style>\n";
    head = head + "</head>\n";
    return head;
  }

  fn generate_body(config: BlogConfig) -> string {
    let body = "<body>\n";
    body = body + "  <div id=\"app\" class=\"container\">\n";
    body = body + generate_navbar(config);
    body = body + generate_hero(config);
    body = body + generate_create_post_section(config);
    body = body + generate_filters(config);
    body = body + generate_posts_container();
    body = body + generate_modals();
    body = body + "  </div>\n";
    body = body + "  <script>\n";
    body = body + generate_complete_javascript(config);
    body = body + "  </script>\n";
    body = body + "</body>\n";
    return body;
  }

  fn generate_navbar(config: BlogConfig) -> string {
    let nav = "    <nav class=\"navbar\">\n";
    nav = nav + "      <div class=\"navbar-brand\">\n";
    nav = nav + "        <h1>📝 " + config.title + "</h1>\n";
    nav = nav + "        <p class=\"subtitle\">FreeLang으로 만든 완전한 블로그</p>\n";
    nav = nav + "      </div>\n";
    nav = nav + "      <div class=\"navbar-menu\">\n";
    nav = nav + "        <button class=\"theme-toggle\" onclick=\"toggleTheme()\">🌙</button>\n";
    nav = nav + "        <input type=\"text\" id=\"search\" placeholder=\"검색...\" onkeyup=\"searchPosts(this.value)\" class=\"search-box\">\n";
    nav = nav + "      </div>\n";
    nav = nav + "    </nav>\n";
    return nav;
  }

  fn generate_hero(config: BlogConfig) -> string {
    let hero = "    <section class=\"hero\">\n";
    hero = hero + "      <h2>FreeLang Blog Engine</h2>\n";
    hero = hero + "      <p>순수 프리랭으로 구현된 제로 디펜던시 블로그</p>\n";
    hero = hero + "      <div class=\"stats\">\n";
    hero = hero + "        <div class=\"stat\">📚 <span id=\"post-count\">0</span> 포스트</div>\n";
    hero = hero + "        <div class=\"stat\">❤️ <span id=\"total-likes\">0</span> 좋아요</div>\n";
    hero = hero + "        <div class=\"stat\">👁️ <span id=\"total-views\">0</span> 조회</div>\n";
    hero = hero + "      </div>\n";
    hero = hero + "    </section>\n";
    return hero;
  }

  fn generate_create_post_section(config: BlogConfig) -> string {
    let form = "    <section class=\"create-post\">\n";
    form = form + "      <h2>✍️ 새 포스트 작성</h2>\n";
    form = form + "      <form id=\"postForm\" onsubmit=\"handleCreatePost(event)\">\n";
    form = form + "        <div class=\"form-row\">\n";
    form = form + "          <div class=\"form-group\">\n";
    form = form + "            <label for=\"title\">제목</label>\n";
    form = form + "            <input type=\"text\" id=\"title\" required placeholder=\"포스트 제목\">\n";
    form = form + "          </div>\n";
    form = form + "          <div class=\"form-group\">\n";
    form = form + "            <label for=\"author\">작성자</label>\n";
    form = form + "            <input type=\"text\" id=\"author\" required placeholder=\"이름\">\n";
    form = form + "          </div>\n";
    form = form + "        </div>\n";
    form = form + "        <div class=\"form-row\">\n";
    form = form + "          <div class=\"form-group\">\n";
    form = form + "            <label for=\"category\">카테고리</label>\n";
    form = form + "            <input type=\"text\" id=\"category\" required placeholder=\"기술, 일상, ...\">\n";
    form = form + "          </div>\n";
    form = form + "          <div class=\"form-group\">\n";
    form = form + "            <label for=\"slug\">슬러그</label>\n";
    form = form + "            <input type=\"text\" id=\"slug\" required placeholder=\"url-friendly\">\n";
    form = form + "          </div>\n";
    form = form + "        </div>\n";
    form = form + "        <div class=\"form-group\">\n";
    form = form + "          <label for=\"description\">설명</label>\n";
    form = form + "          <input type=\"text\" id=\"description\" placeholder=\"포스트 한줄 설명\">\n";
    form = form + "        </div>\n";
    form = form + "        <div class=\"form-group\">\n";
    form = form + "          <label for=\"content\">내용</label>\n";
    form = form + "          <textarea id=\"content\" required placeholder=\"포스트 내용...\" rows=\"8\"></textarea>\n";
    form = form + "        </div>\n";
    form = form + "        <div class=\"form-group\">\n";
    form = form + "          <label for=\"tags\">태그 (쉼표 구분)</label>\n";
    form = form + "          <input type=\"text\" id=\"tags\" placeholder=\"tag1, tag2, tag3\">\n";
    form = form + "        </div>\n";
    form = form + "        <button type=\"submit\" class=\"btn-primary\">📤 포스트 작성</button>\n";
    form = form + "      </form>\n";
    form = form + "      <div id=\"message\" class=\"message\"></div>\n";
    form = form + "    </section>\n";
    return form;
  }

  fn generate_filters(config: BlogConfig) -> string {
    let filters = "    <section class=\"filters\">\n";
    filters = filters + "      <button class=\"filter-btn active\" onclick=\"filterPosts('all')\">📌 전체</button>\n";
    filters = filters + "      <button class=\"filter-btn\" onclick=\"filterPosts('Achievement')\">🏆 성과</button>\n";
    filters = filters + "      <button class=\"filter-btn\" onclick=\"filterPosts('Technical')\">⚙️ 기술</button>\n";
    filters = filters + "      <button class=\"filter-btn\" onclick=\"filterPosts('Architecture')\">🏗️ 아키텍처</button>\n";
    filters = filters + "    </section>\n";
    return filters;
  }

  fn generate_posts_container() -> string {
    return "    <section id=\"postsContainer\" class=\"posts-container\"></section>\n";
  }

  fn generate_modals() -> string {
    let modals = "    <div id=\"postModal\" class=\"modal\">\n";
    modals = modals + "      <div class=\"modal-content\">\n";
    modals = modals + "        <span class=\"modal-close\" onclick=\"closeModal()\">&times;</span>\n";
    modals = modals + "        <div id=\"modalBody\"></div>\n";
    modals = modals + "      </div>\n";
    modals = modals + "    </div>\n";
    return modals;
  }

  // ============================================================================
  // Part 3: CSS Generator
  // ============================================================================

  fn generate_complete_css(config: BlogConfig) -> string {
    let css = "* {\n";
    css = css + "  margin: 0;\n";
    css = css + "  padding: 0;\n";
    css = css + "  box-sizing: border-box;\n";
    css = css + "}\n\n";

    css = css + generate_base_styles();
    css = css + generate_navbar_styles();
    css = css + generate_hero_styles();
    css = css + generate_form_styles();
    css = css + generate_filter_styles();
    css = css + generate_post_card_styles();
    css = css + generate_modal_styles();
    css = css + generate_theme_styles();
    css = css + generate_responsive_styles();

    return css;
  }

