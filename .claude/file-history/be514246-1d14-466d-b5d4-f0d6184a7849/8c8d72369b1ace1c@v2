/**
 * FreeLang Light Unified Compiler
 * .free 파일을 TypeScript + Database + API + HTTP로 동시 컴파일
 *
 * 역할: 모든 생성기를 통합하여 완전한 엔터프라이즈 스택 생성
 */

const { TypeScriptCompiler } = require('./typescript-compiler');
const { DatabaseSchemaGenerator } = require('./database-schema-generator');
const { RestApiGenerator } = require('./rest-api-generator');
const { HttpResponseGenerator } = require('./http-response-generator');

class UnifiedCompiler {
  constructor(options = {}) {
    this.tsCompiler = new TypeScriptCompiler();
    this.dbGenerator = new DatabaseSchemaGenerator();
    this.apiGenerator = new RestApiGenerator(options);
    this.httpGenerator = new HttpResponseGenerator(options);
    this.options = options;
  }

  /**
   * 통합 컴파일 - 모든 출력을 생성
   * @param {Object} ast - 파싱된 AST
   * @returns {Object} { typescript, sql, api, http }
   */
  compileAll(ast) {
    return {
      typescript: this.tsCompiler.compile(ast),
      sql: this.dbGenerator.compile(ast),
      api: this.apiGenerator.compile(ast),
      http: this.httpGenerator.compile(ast),
      manifest: this.generateManifest(ast)
    };
  }

  /**
   * 선택적 컴파일 - 특정 출력만 생성
   * @param {Object} ast - 파싱된 AST
   * @param {Array} targets - ['typescript', 'sql', 'api', 'http']
   * @returns {Object}
   */
  compileSelective(ast, targets = ['typescript', 'api', 'http']) {
    const result = {};

    if (targets.includes('typescript')) {
      result.typescript = this.tsCompiler.compile(ast);
    }
    if (targets.includes('sql')) {
      result.sql = this.dbGenerator.compile(ast);
    }
    if (targets.includes('api')) {
      result.api = this.apiGenerator.compile(ast);
    }
    if (targets.includes('http')) {
      result.http = this.httpGenerator.compile(ast);
    }

    return result;
  }

  /**
   * 매니페스트 생성 - 컴파일 정보 기록
   */
  generateManifest(ast) {
    return {
      component: ast.name,
      timestamp: new Date().toISOString(),
      version: '1.0.0',
      targets: {
        typescript: {
          status: 'generated',
          lines: this.tsCompiler.compile(ast).split('\n').length
        },
        sql: {
          status: 'generated',
          lines: this.dbGenerator.compile(ast).split('\n').length
        },
        api: {
          status: 'generated',
          endpoints: ['CREATE', 'READ', 'LIST', 'UPDATE', 'DELETE']
        },
        http: {
          status: 'generated',
          handlers: ['render', 'middleware']
        }
      },
      structure: {
        hasProps: ast.props && Object.keys(ast.props).length > 0,
        hasState: ast.state && Object.keys(ast.state).length > 0,
        hasScript: ast.script && ast.script.functions && ast.script.functions.length > 0,
        hasMarkup: ast.markup && ast.markup.content && ast.markup.content.length > 0,
        hasStyle: ast.style && ast.style.content && ast.style.content.length > 0
      }
    };
  }

  /**
   * 프로젝트 구조 생성
   */
  generateProjectStructure(componentName) {
    return `
# Project Structure for ${componentName}

\`\`\`
${componentName}/
├── schema.sql           # Database schema
├── types.ts             # TypeScript interfaces & classes
├── api.js               # REST API endpoints
├── handlers.js          # HTTP request handlers
├── styles.css           # Component styles
├── markup.html          # HTML template
├── tests/
│   ├── api.test.js
│   ├── database.test.js
│   └── http.test.js
└── dist/
    ├── bundle.js
    ├── bundle.css
    └── index.html
\`\`\`

## 생성된 파일 설명

### schema.sql
- 데이터베이스 테이블 정의
- Props 기반 메인 테이블
- State 기반 히스토리 테이블
- 성능 인덱스

### types.ts
- TypeScript Props 인터페이스
- 컴포넌트 클래스 정의
- 타입 안전성 보장

### api.js
- Express 라우터
- CRUD 엔드포인트
- 요청 검증 및 에러 처리

### handlers.js
- HTTP 요청 처리
- 마크업 렌더링
- 조건부 렌더링
`;
  }

  /**
   * 컴파일 보고서 생성
   */
  generateReport(ast) {
    const compiled = this.compileAll(ast);

    return {
      summary: {
        component: ast.name,
        compiledAt: new Date().toISOString(),
        success: true
      },
      statistics: {
        typescript: {
          lines: compiled.typescript.split('\n').length,
          size: compiled.typescript.length
        },
        sql: {
          lines: compiled.sql.split('\n').length,
          size: compiled.sql.length
        },
        api: {
          lines: compiled.api.split('\n').length,
          size: compiled.api.length,
          endpoints: 5
        },
        http: {
          lines: compiled.http.split('\n').length,
          size: compiled.http.length
        }
      },
      features: {
        hasDatabase: compiled.sql.length > 0,
        hasApi: compiled.api.includes('router.post'),
        hasHttpHandlers: compiled.http.includes('Handler'),
        hasTypeScript: compiled.typescript.includes('interface')
      },
      outputs: {
        typescript: 'Generated TypeScript with types',
        sql: 'Generated database schema with indices',
        api: 'Generated 5 REST API endpoints (CRUD)',
        http: 'Generated HTTP middleware with rendering'
      }
    };
  }
}

module.exports = { UnifiedCompiler };
