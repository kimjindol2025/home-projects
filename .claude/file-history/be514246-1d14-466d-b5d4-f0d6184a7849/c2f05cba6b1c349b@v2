/**
 * FreeLang Light REST API Generator
 * .free 컴포넌트를 Express REST API로 변환
 *
 * 역할: AST를 CRUD API endpoints로 변환
 */

class RestApiGenerator {
  constructor(options = {}) {
    this.indent = 0;
    this.baseUrl = options.baseUrl || '/api/v1';
  }

  /**
   * FreeLang 컴포넌트를 REST API 코드로 컴파일
   * @param {Object} ast - 파싱된 AST
   * @returns {string} Express API 코드
   */
  compile(ast) {
    let api = '';

    // 라우터 초기화
    api += this.generateRouterSetup(ast.name);
    api += '\n\n';

    // CRUD 엔드포인트
    api += this.generateCreateEndpoint(ast.name, ast.props);
    api += '\n\n';

    api += this.generateReadEndpoint(ast.name);
    api += '\n\n';

    api += this.generateListEndpoint(ast.name);
    api += '\n\n';

    api += this.generateUpdateEndpoint(ast.name, ast.props);
    api += '\n\n';

    api += this.generateDeleteEndpoint(ast.name);
    api += '\n\n';

    // Export
    api += this.generateExports(ast.name);

    return api;
  }

  /**
   * Express 라우터 초기화
   */
  generateRouterSetup(componentName) {
    const resource = this.camelToKebab(componentName);
    return `const express = require('express');
const router = express.Router();

// Middleware for error handling
const asyncHandler = (fn) => (req, res, next) => Promise.resolve(fn(req, res, next)).catch(next);`;
  }

  /**
   * CREATE 엔드포인트 생성
   * POST /api/v1/buttons
   */
  generateCreateEndpoint(componentName, props) {
    const resource = this.camelToKebab(componentName);
    let endpoint = `// Create ${componentName}
router.post('/${resource}', asyncHandler(async (req, res) => {
  const { ${Object.keys(props).join(', ')} } = req.body;

  // Validation
  const errors = [];\n`;

    for (const [key, prop] of Object.entries(props)) {
      if (!prop.optional) {
        endpoint += `  if (!${key}) errors.push('${key} is required');\n`;
      }
    }

    endpoint += `
  if (errors.length > 0) {
    return res.status(400).json({ errors });
  }

  // Insert into database
  const query = 'INSERT INTO ${this.camelToSnake(componentName)} (${Object.keys(props).map(k => this.camelToSnake(k)).join(', ')}) VALUES (${Object.keys(props).map(() => '?').join(', ')})';
  const values = [${Object.keys(props).join(', ')}];

  db.run(query, values, function(err) {
    if (err) {
      return res.status(500).json({ error: err.message });
    }
    res.status(201).json({
      id: this.lastID,
      ${Object.keys(props).map(k => `${k}`).join(',\n      ')}
    });
  });
}));`;

    return endpoint;
  }

  /**
   * READ 엔드포인트 생성
   * GET /api/v1/buttons/:id
   */
  generateReadEndpoint(componentName) {
    const resource = this.camelToKebab(componentName);
    const tableName = this.camelToSnake(componentName);

    return `// Get ${componentName} by ID
router.get('/${resource}/:id', asyncHandler(async (req, res) => {
  const { id } = req.params;

  const query = 'SELECT * FROM ${tableName} WHERE id = ?';
  db.get(query, [id], (err, row) => {
    if (err) {
      return res.status(500).json({ error: err.message });
    }
    if (!row) {
      return res.status(404).json({ error: '${componentName} not found' });
    }
    res.json(row);
  });
}));`;
  }

  /**
   * LIST 엔드포인트 생성
   * GET /api/v1/buttons?page=1&limit=10
   */
  generateListEndpoint(componentName) {
    const resource = this.camelToKebab(componentName);
    const tableName = this.camelToSnake(componentName);

    return `// List ${componentName}s with pagination
router.get('/${resource}', asyncHandler(async (req, res) => {
  const { page = 1, limit = 10, sort = 'id', order = 'ASC' } = req.query;
  const offset = (page - 1) * limit;

  const query = 'SELECT * FROM ${tableName} ORDER BY ?? ' + order + ' LIMIT ? OFFSET ?';
  db.all(query, [sort, limit, offset], (err, rows) => {
    if (err) {
      return res.status(500).json({ error: err.message });
    }

    // Get total count
    db.get('SELECT COUNT(*) as total FROM ${tableName}', (err, countRow) => {
      res.json({
        data: rows,
        pagination: {
          page,
          limit,
          total: countRow.total,
          pages: Math.ceil(countRow.total / limit)
        }
      });
    });
  });
}));`;
  }

  /**
   * UPDATE 엔드포인트 생성
   * PUT /api/v1/buttons/:id
   */
  generateUpdateEndpoint(componentName, props) {
    const resource = this.camelToKebab(componentName);
    const tableName = this.camelToSnake(componentName);
    const updateFields = Object.keys(props).map(k => `${this.camelToSnake(k)} = ?`).join(', ');
    const updateKeys = Object.keys(props);

    return `// Update ${componentName}
router.put('/${resource}/:id', asyncHandler(async (req, res) => {
  const { id } = req.params;
  const updates = req.body;

  const setClause = ${JSON.stringify(updateKeys)}.map(key => key + ' = ?').join(', ');
  const values = ${JSON.stringify(updateKeys)}.map(key => updates[key]);
  values.push(id);

  const query = 'UPDATE ${tableName} SET ' + setClause + ', updated_at = CURRENT_TIMESTAMP WHERE id = ?';

  db.run(query, values, function(err) {
    if (err) {
      return res.status(500).json({ error: err.message });
    }
    if (this.changes === 0) {
      return res.status(404).json({ error: '${componentName} not found' });
    }
    res.json({ message: '${componentName} updated', id });
  });
}));`;
  }

  /**
   * DELETE 엔드포인트 생성
   * DELETE /api/v1/buttons/:id
   */
  generateDeleteEndpoint(componentName) {
    const resource = this.camelToKebab(componentName);
    const tableName = this.camelToSnake(componentName);

    return `// Delete ${componentName}
router.delete('/${resource}/:id', asyncHandler(async (req, res) => {
  const { id } = req.params;

  const query = 'DELETE FROM ${tableName} WHERE id = ?';
  db.run(query, [id], function(err) {
    if (err) {
      return res.status(500).json({ error: err.message });
    }
    if (this.changes === 0) {
      return res.status(404).json({ error: '${componentName} not found' });
    }
    res.json({ message: '${componentName} deleted', id });
  });
}));`;
  }

  /**
   * Export 문 생성
   */
  generateExports(componentName) {
    return `module.exports = router;`;
  }

  /**
   * camelCase를 kebab-case로 변환
   */
  camelToKebab(str) {
    // 첫 글자를 소문자로 변환한 후 대문자를 대시+소문자로 변환
    return str.charAt(0).toLowerCase() + str.slice(1).replace(/[A-Z]/g, letter => `-${letter.toLowerCase()}`);
  }

  /**
   * camelCase를 snake_case로 변환
   */
  camelToSnake(str) {
    return str.replace(/[A-Z]/g, letter => `_${letter.toLowerCase()}`);
  }
}

module.exports = { RestApiGenerator };
