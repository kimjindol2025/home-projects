/**
 * FreeLang Light TypeScript Compiler
 * .free → .ts 변환
 *
 * 역할: AST를 TypeScript 인터페이스 + 클래스로 변환
 */

class TypeScriptCompiler {
  constructor() {
    this.indent = 0;
  }

  /**
   * FreeLang 컴포넌트를 TypeScript로 컴파일
   * @param {Object} ast - 파싱된 AST
   * @returns {string} TypeScript 코드
   */
  compile(ast) {
    let ts = '';

    // Props 인터페이스 생성
    if (ast.props && Object.keys(ast.props).length > 0) {
      ts += this.generatePropsInterface(ast.name, ast.props);
      ts += '\n\n';
    }

    // 상태 인터페이스 생성 (향후)
    if (ast.state && Object.keys(ast.state).length > 0) {
      ts += this.generateStateInterface(ast.name, ast.state);
      ts += '\n\n';
    }

    // 클래스 생성
    ts += this.generateComponentClass(ast);
    ts += '\n\n';

    // Export
    ts += this.generateExports(ast.name);

    return ts;
  }

  /**
   * Props 인터페이스 생성
   * @example
   * interface ButtonProps {
   *   label: string;
   *   disabled?: boolean;
   * }
   */
  generatePropsInterface(componentName, props) {
    let ts = `interface ${componentName}Props {\n`;

    for (const [key, type] of Object.entries(props)) {
      const tsType = this.mapFreeLangTypeToTS(type.type);
      const optional = type.optional ? '?' : '';
      ts += `  ${key}${optional}: ${tsType};\n`;
    }

    ts += '}';
    return ts;
  }

  /**
   * 상태 인터페이스 생성
   * @example
   * interface ButtonState {
   *   isActive: boolean;
   *   clickCount: number;
   * }
   */
  generateStateInterface(componentName, state) {
    let ts = `interface ${componentName}State {\n`;

    for (const [key, value] of Object.entries(state)) {
      const tsType = this.inferType(value);
      ts += `  ${key}: ${tsType};\n`;
    }

    ts += '}';
    return ts;
  }

  /**
   * 컴포넌트 클래스 생성
   * @example
   * class Button {
   *   props: ButtonProps;
   *   state: ButtonState;
   *
   *   constructor(props: ButtonProps) {
   *     this.props = props;
   *   }
   * }
   */
  generateComponentClass(ast) {
    let ts = `class ${ast.name} {\n`;

    // Props 선언
    if (ast.props && Object.keys(ast.props).length > 0) {
      ts += `  props: ${ast.name}Props;\n`;
    }

    // State 선언 (향후)
    if (ast.state && Object.keys(ast.state).length > 0) {
      ts += `  state: ${ast.name}State;\n`;
    }

    // 생성자
    ts += `\n  constructor(props: ${ast.name}Props) {\n`;
    ts += `    this.props = props;\n`;
    if (ast.state) {
      ts += `    this.state = this.initializeState();\n`;
    }
    ts += `  }\n`;

    // 메서드 생성
    if (ast.script && ast.script.functions) {
      ts += '\n';
      for (const fn of ast.script.functions) {
        ts += this.generateMethod(fn);
        ts += '\n';
      }
    }

    ts += '}';
    return ts;
  }

  /**
   * 메서드 생성
   */
  generateMethod(fn) {
    const returnType = fn.returnType ? this.mapFreeLangTypeToTS(fn.returnType) : 'void';
    const params = fn.params
      ? fn.params.map(p => `${p.name}: ${this.mapFreeLangTypeToTS(p.type)}`).join(', ')
      : '';

    return `  ${fn.name}(${params}): ${returnType} {\n    // TODO: 구현\n  }`;
  }

  /**
   * FreeLang 타입을 TypeScript로 매핑
   */
  mapFreeLangTypeToTS(type) {
    const typeMap = {
      'string': 'string',
      'number': 'number',
      'boolean': 'boolean',
      'array': 'any[]',
      'object': 'Record<string, any>',
      'i32': 'number',
      'i64': 'bigint',
      'f32': 'number',
      'f64': 'number',
    };

    return typeMap[type] || 'any';
  }

  /**
   * 값으로부터 타입 추론
   */
  inferType(value) {
    if (typeof value === 'string') return 'string';
    if (typeof value === 'number') return 'number';
    if (typeof value === 'boolean') return 'boolean';
    if (Array.isArray(value)) return 'any[]';
    if (typeof value === 'object') return 'Record<string, any>';
    return 'any';
  }

  /**
   * Export 문 생성
   */
  generateExports(componentName) {
    return `export { ${componentName}, ${componentName}Props };`;
  }
}

module.exports = { TypeScriptCompiler };
