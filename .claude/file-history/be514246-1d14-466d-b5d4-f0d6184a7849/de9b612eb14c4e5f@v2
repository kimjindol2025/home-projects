/**
 * FreeLang Frontend Generator Executor
 * frontend-generator.fl을 실행하여 완전한 HTML 생성
 *
 * 이것은 프리랭 컴파일러를 통해 실행될 코드입니다.
 * 현재는 Node.js로 시뮬레이션합니다 (프리랭 → JS 트랜스파일)
 */

// FreeLang을 JavaScript로 트랜스파일한 프론트엔드 생성기
const FrontendGenerator = {

  // HTML 생성
  generateCompleteHtml(config) {
    let html = '<!DOCTYPE html>\n';
    html += '<html lang="ko">\n';
    html += this.generateHead(config);
    html += this.generateBody(config);
    html += '</html>\n';
    return html;
  },

  generateHead(config) {
    return `<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${config.title}</title>
  <style>
${this.generateCompleteCss(config)}
  </style>
</head>
`;
  },

  generateBody(config) {
    return `<body>
  <div id="app" class="container">
${this.generateNavbar(config)}
${this.generateHero(config)}
${this.generateCreatePostSection(config)}
${this.generateFilters(config)}
${this.generatePostsContainer()}
${this.generateModals()}
  </div>
  <script>
${this.generateCompleteJavascript(config)}
  </script>
</body>
`;
  },

  generateNavbar(config) {
    return `    <nav class="navbar">
      <div class="navbar-brand">
        <h1>📝 ${config.title}</h1>
        <p class="subtitle">FreeLang으로 만든 완전한 블로그</p>
      </div>
      <div class="navbar-menu">
        <button class="theme-toggle" onclick="toggleTheme()">🌙</button>
        <input type="text" id="search" placeholder="검색..." onkeyup="searchPosts(this.value)" class="search-box">
      </div>
    </nav>
`;
  },

  generateHero(config) {
    return `    <section class="hero">
      <h2>FreeLang Blog Engine</h2>
      <p>순수 프리랭으로 구현된 제로 디펜던시 블로그</p>
      <div class="stats">
        <div class="stat">📚 <span id="post-count">0</span> 포스트</div>
        <div class="stat">❤️ <span id="total-likes">0</span> 좋아요</div>
        <div class="stat">👁️ <span id="total-views">0</span> 조회</div>
      </div>
    </section>
`;
