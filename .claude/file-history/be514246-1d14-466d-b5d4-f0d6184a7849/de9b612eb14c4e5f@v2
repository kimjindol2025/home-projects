  generateCompleteCss(config) {
    let css = '';
    css += this.generateBaseStyles();
    css += this.generateNavbarStyles();
    css += this.generateHeroStyles();
    css += this.generateFormStyles();
    css += this.generateFilterStyles();
    css += this.generatePostCardStyles();
    css += this.generateModalStyles();
    css += this.generateThemeStyles();
    css += this.generateResponsiveStyles();
    return css;
