`;
  },

  generateFilters(config) {
    return `    <section class="filters">
      <button class="filter-btn active" onclick="filterPosts('all')">📌 전체</button>
      <button class="filter-btn" onclick="filterPosts('Achievement')">🏆 성과</button>
