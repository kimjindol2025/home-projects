    </section>
`;
  },

  generatePostsContainer() {
    return '    <section id="postsContainer" class="posts-container"></section>\n';
  },

  generateModals() {
    return `    <div id="postModal" class="modal">
      <div class="modal-content">
        <span class="modal-close" onclick="closeModal()">&times;</span>
        <div id="modalBody"></div>
      </div>
    </div>
`;
  },

