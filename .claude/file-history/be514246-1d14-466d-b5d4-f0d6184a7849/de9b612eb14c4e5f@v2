  // JavaScript 생성
  generateCompleteJavascript(config) {
    return `const API_URL = '${config.api_url}/api';
const AUTO_REFRESH = ${config.auto_refresh};

// State Management
let appState = {
  posts: [],
  filteredPosts: [],
  currentFilter: 'all',
  currentSearch: '',
  isDarkTheme: localStorage.getItem('theme') === 'dark',
  totalLikes: 0,
  totalViews: 0
};

// API Functions
async function fetchPosts() {
  try {
    const res = await fetch(API_URL + '/blogs');
    const data = await res.json();
    appState.posts = data.data || [];
    appState.totalLikes = appState.posts.reduce((sum, p) => sum + (p.likes || 0), 0);
    appState.totalViews = appState.posts.reduce((sum, p) => sum + (p.viewCount || 0), 0);
    applyFiltersAndSearch();
    updateUI();
  } catch (err) {
    console.error('포스트 로드 오류:', err);
  }
}

async function createPost(postData) {
  try {
    const res = await fetch(API_URL + '/blogs', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(postData)
    });
    if (res.ok) {
      showMessage('✅ 포스트 작성됨!', 'success');
      document.getElementById('postForm').reset();
      fetchPosts();
    } else {
      showMessage('❌ 포스트 작성 실패', 'error');
    }
  } catch (err) {
    showMessage('❌ 오류: ' + err.message, 'error');
  }
}

async function likePost(postId) {
  try {
    await fetch(API_URL + '/blogs/' + postId + '/like', { method: 'POST' });
    fetchPosts();
  } catch (err) {
    console.error('좋아요 오류:', err);
  }
}

async function viewPost(postId) {
  try {
    await fetch(API_URL + '/blogs/' + postId + '/view', { method: 'POST' });
    fetchPosts();
  } catch (err) {
    console.error('조회수 증가 오류:', err);
  }
}

async function deletePost(postId) {
  if (confirm('정말 삭제하시겠습니까?')) {
    try {
      await fetch(API_URL + '/blogs/' + postId, { method: 'DELETE' });
      showMessage('✅ 포스트 삭제됨!', 'success');
      closeModal();
      fetchPosts();
    } catch (err) {
      showMessage('❌ 삭제 오류', 'error');
    }
  }
}

// UI Functions
function updateUI() {
  updateStats();
  renderPosts();
}

function updateStats() {
  document.getElementById('post-count').textContent = appState.posts.length;
  document.getElementById('total-likes').textContent = appState.totalLikes;
  document.getElementById('total-views').textContent = appState.totalViews;
}

function renderPosts() {
  const container = document.getElementById('postsContainer');
  if (appState.filteredPosts.length === 0) {
    container.innerHTML = '<div class="empty-state" style="text-align:center; padding:60px; color:#999;">포스트가 없습니다</div>';
    return;
  }
  container.innerHTML = appState.filteredPosts.reverse().map(post => \`
    <div class="post-card">
      <div class="post-header">
        <div>
          <h3 class="post-title">\${post.title}</h3>
          <p class="post-meta">\${post.author} • \${new Date(post.createdAt).toLocaleDateString('ko-KR')}</p>
        </div>
      </div>
      <div><span class="post-category">\${post.category}</span></div>
      <p class="post-content">\${post.description || post.content.substring(0, 150)}</p>
      <div class="post-stats">
        <div>👁️ \${post.viewCount} 조회</div>
        <div>❤️ \${post.likes} 좋아요</div>
      </div>
      <div class="post-actions">
        <button class="post-btn" onclick="openPostModal(\${post.id})" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; flex: 2;">📖 전문 보기</button>
        <button class="post-btn" onclick="likePost(\${post.id})">❤️ 좋아요</button>
        <button class="post-btn post-btn-danger" onclick="deletePost(\${post.id})">🗑️ 삭제</button>
      </div>
    </div>
  \`).join('');
}

function applyFiltersAndSearch() {
  appState.filteredPosts = appState.posts.filter(post => {
    const matchesFilter = appState.currentFilter === 'all' || post.category === appState.currentFilter;
    const matchesSearch = !appState.currentSearch || post.title.toLowerCase().includes(appState.currentSearch.toLowerCase());
    return matchesFilter && matchesSearch;
  });
}

function openPostModal(postId) {
  const post = appState.posts.find(p => p.id === postId);
  if (!post) return;

  const tags = post.tags ? post.tags.split(',').map(t => \`<span class="post-tag" style="display:inline-block; background:#667eea; color:white; padding:4px 10px; border-radius:15px; margin-right:8px; font-size:0.85em;">\${t.trim()}</span>\`).join('') : '';

  document.getElementById('modalBody').innerHTML = \`
    <h1 style="color:#667eea; margin-bottom:10px;">\${post.title}</h1>
    <div style="color:#999; margin-bottom:20px;">
      <span>✍️ \${post.author}</span> |
      <span>📅 \${new Date(post.createdAt).toLocaleDateString('ko-KR')}</span> |
      <span>📁 \${post.category}</span>
    </div>
    \${post.description ? \`<p style="color:#666; font-style:italic; margin-bottom:20px;">\${post.description}</p>\` : ''}
    <div style="white-space:pre-wrap; word-break:break-word; margin-bottom:30px;">\${post.content}</div>
    \${tags ? \`<div style="margin-bottom:20px;"><strong>태그:</strong> \${tags}</div>\` : ''}
    <div style="border-top:1px solid #eee; padding-top:20px; margin-bottom:20px;">
      <div>👁️ \${post.viewCount} 조회 | ❤️ \${post.likes} 좋아요</div>
    </div>
    <div style="display:flex; gap:10px;">
      <button class="post-btn" onclick="likePost(\${post.id})" style="flex:1;">❤️ 좋아요</button>
      <button class="post-btn post-btn-danger" onclick="deletePost(\${post.id})" style="flex:1;">🗑️ 삭제</button>
      <button class="post-btn" onclick="closeModal()" style="flex:1;">✖️ 닫기</button>
    </div>
  \`;

  document.getElementById('postModal').style.display = 'block';
  viewPost(postId);
}

function closeModal() {
  document.getElementById('postModal').style.display = 'none';
}

function filterPosts(category) {
  appState.currentFilter = category;
  document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
  event.target.classList.add('active');
  applyFiltersAndSearch();
  updateUI();
}

function searchPosts(query) {
  appState.currentSearch = query;
  applyFiltersAndSearch();
  updateUI();
}

function toggleTheme() {
  appState.isDarkTheme = !appState.isDarkTheme;
  document.body.classList.toggle('dark-theme');
  localStorage.setItem('theme', appState.isDarkTheme ? 'dark' : 'light');
}

function showMessage(text, type) {
  const msg = document.getElementById('message');
  msg.textContent = text;
  msg.style.color = type === 'success' ? '#51cf66' : '#ff6b6b';
  setTimeout(() => { msg.textContent = ''; }, 3000);
}

// Event Handlers
function handleCreatePost(e) {
  e.preventDefault();
  const post = {
    title: document.getElementById('title').value,
    author: document.getElementById('author').value,
    content: document.getElementById('content').value,
    category: document.getElementById('category').value,
    slug: document.getElementById('slug').value,
    description: document.getElementById('description').value,
    tags: document.getElementById('tags').value,
    featured: false
  };
  createPost(post);
}

window.onclick = function(e) {
  const modal = document.getElementById('postModal');
  if (e.target === modal) {
    modal.style.display = 'none';
  }
};

// Initialization
document.addEventListener('DOMContentLoaded', () => {
  if (appState.isDarkTheme) {
    document.body.classList.add('dark-theme');
  }
  fetchPosts();
  setInterval(fetchPosts, AUTO_REFRESH);
});
`;
  }
};

// 실행: 프리랭으로 생성된 HTML 저장
const config = {
  title: 'FreeLang Blog',
  api_url: 'http://localhost:5021',
  port: 5021,
  theme: 'light',
  auto_refresh: 5000
};

const html = FrontendGenerator.generateCompleteHtml(config);

// 파일로 저장
const fs = require('fs');
fs.writeFileSync('/tmp/freelang-light/examples/public/index-dynamic.html', html);

console.log('✅ 프리랭으로 생성된 HTML 저장됨');
console.log('📊 파일 크기: ' + html.length + ' bytes');
console.log('📍 경로: /tmp/freelang-light/examples/public/index-dynamic.html');
