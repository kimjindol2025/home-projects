/**
 * FreeLang Light HTTP Response Generator
 * .free 컴포넌트의 마크업을 HTTP 응답으로 변환
 *
 * 역할: AST 마크업을 Express response로 변환
 */

class HttpResponseGenerator {
  constructor(options = {}) {
    this.contentType = options.contentType || 'text/html';
    this.charset = options.charset || 'utf-8';
  }

  /**
   * FreeLang 컴포넌트를 HTTP 핸들러로 컴파일
   * @param {Object} ast - 파싱된 AST
   * @returns {string} Express middleware 코드
   */
  compile(ast) {
    let handler = '';

    // 마크업이 있으면 렌더 함수 생성
    if (ast.markup && ast.markup.content) {
      handler += this.generateRenderFunction(ast.name, ast.markup.content, ast.props);
      handler += '\n\n';
    }

    // Express 미들웨어 생성
    handler += this.generateExpressMiddleware(ast.name, ast.props);

    return handler;
  }

  /**
   * 렌더 함수 생성
   */
  generateRenderFunction(componentName, markup, props) {
    let fn = `/**
 * Render ${componentName} component with context
 */
function render${componentName}(context = {}) {
  const defaults = {`;

    for (const [key, prop] of Object.entries(props || {})) {
      fn += `\n    ${key}: null,`;
    }

    fn += `\n  };

  const data = { ...defaults, ...context };

  // Markup with variable substitution
  let html = \`${this.escapeTemplate(markup)}\`;

  // Replace variables
  Object.entries(data).forEach(([key, value]) => {
    const regex = new RegExp('{' + key + '}', 'g');
    html = html.replace(regex, value || '');
  });

  return html;
}`;

    return fn;
  }

  /**
   * Express 미들웨어 생성
   */
  generateExpressMiddleware(componentName, props) {
    const lowerName = componentName.toLowerCase();

    return `/**
 * Express middleware for ${componentName}
 */
function ${lowerName}Handler(req, res) {
  try {
    // Extract data from request
    const context = {
      ...req.query,
      ...req.body,
      ...req.params
    };

    // Render component
    const html = render${componentName}(context);

    // Set response headers
    res.setHeader('Content-Type', '${this.contentType}; charset=${this.charset}');
    res.setHeader('X-Component', '${componentName}');
    res.setHeader('X-Powered-By', 'FreeLang-Light');

    // Send response
    res.send(html);
  } catch (error) {
    res.status(500).json({
      error: error.message,
      component: '${componentName}'
    });
  }
}

module.exports = { render${componentName}, ${lowerName}Handler };`;
  }

  /**
   * 템플릿 문자열 이스케이프
   */
  escapeTemplate(markup) {
    return markup
      .replace(/\\/g, '\\\\')
      .replace(/\`/g, '\\`')
      .replace(/\$/g, '\\$');
  }

  /**
   * JSON 응답 생성기
   */
  generateJsonResponse(componentName, data) {
    return `
/**
 * JSON Response for ${componentName}
 */
function ${componentName.toLowerCase()}JsonHandler(req, res) {
  try {
    const response = {
      component: '${componentName}',
      data: ${JSON.stringify(data, null, 2)},
      timestamp: new Date().toISOString(),
      status: 'success'
    };

    res.setHeader('Content-Type', 'application/json');
    res.json(response);
  } catch (error) {
    res.status(500).json({
      component: '${componentName}',
      error: error.message,
      status: 'error'
    });
  }
}`;
  }

  /**
   * 조건부 렌더링 미들웨어
   */
  generateConditionalRenderer(componentName, conditions) {
    return `
/**
 * Conditional renderer for ${componentName}
 */
function ${componentName.toLowerCase()}ConditionalHandler(req, res) {
  const { mode } = req.query;

  const renderers = {`;

    for (const [condition, template] of Object.entries(conditions || {})) {
      renderers += `\n    ${condition}: () => \`${this.escapeTemplate(template)}\`,`;
    }

    renderers += `\n  };

  const html = renderers[mode]?.() || renderers.default?.() || '<div>No matching condition</div>';

  res.setHeader('Content-Type', '${this.contentType}; charset=${this.charset}');
  res.send(html);
}`;

    return renderers;
  }

  /**
   * 스타일시트 인젝션 생성
   */
  generateStyleInjection(componentName, styles) {
    return `
/**
 * Render ${componentName} with inline styles
 */
function render${componentName}WithStyles(context = {}) {
  const html = render${componentName}(context);

  const style = \`
    <style>
${this.indentCode(styles, 6)}
    </style>
  \`;

  return style + html;
}`;
  }

  /**
   * 코드 들여쓰기
   */
  indentCode(code, spaces) {
    const indent = ' '.repeat(spaces);
    return code.split('\n')
      .map(line => line ? indent + line : line)
      .join('\n');
  }
}

module.exports = { HttpResponseGenerator };
