@component Blog

@props {
  title: string
  description: string
  content: string
  author: string
  category: string
  tags: string
  slug: string
  featured: boolean
  publishedAt: number
}

@state {
  isEditing: false
  isDraft: true
  lastSavedAt: 0
  viewCount: 0
  likes: 0
  status: "draft"
}

@markup {
  <div class="blog-post">
    <header class="blog-header">
      <h1>{title}</h1>
      <p class="meta">
        By {author} | {category} | {publishedAt}
      </p>
      <p class="description">{description}</p>
      {featured && <span class="badge">Featured</span>}
    </header>

    <main class="blog-content">
      {content}
    </main>

    <footer class="blog-footer">
      <div class="tags">
        {tags}
      </div>
      <div class="stats">
        Views: {viewCount} | Likes: {likes}
      </div>
    </footer>
  </div>
}

@style {
  .blog-post {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  .blog-header {
    border-bottom: 2px solid #eee;
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .blog-header h1 {
    font-size: 2rem;
    margin: 0 0 1rem 0;
    color: #333;
  }

  .meta {
    color: #666;
    font-size: 0.9rem;
    margin: 0.5rem 0;
  }

  .badge {
    display: inline-block;
    background: #ff6b6b;
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
  }

  .blog-content {
    line-height: 1.8;
    color: #444;
    margin: 2rem 0;
  }

  .blog-footer {
    border-top: 1px solid #eee;
    padding-top: 2rem;
    margin-top: 3rem;
  }

  .tags {
    margin-bottom: 1rem;
  }

  .stats {
    color: #888;
    font-size: 0.9rem;
  }
}

@methods {
  publish() -> {
    status: "published",
    publishedAt: now(),
    isDraft: false
  }

  archive() -> {
    status: "archived",
    isDraft: true
  }

  incrementViews() -> {
    viewCount: viewCount + 1
  }

  addLike() -> {
    likes: likes + 1
  }
}
