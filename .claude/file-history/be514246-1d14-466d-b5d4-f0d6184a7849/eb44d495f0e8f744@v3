<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreeLang Blog</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        header {
            background: white;
            padding: 30px;
            border-radius: 10px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        h1 {
            color: #667eea;
            margin-bottom: 10px;
            font-size: 2.5em;
        }

        .subtitle {
            color: #666;
            font-size: 1.1em;
        }

        .create-post {
            background: white;
            padding: 30px;
            border-radius: 10px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-weight: 500;
        }

        input[type="text"],
        input[type="email"],
        textarea,
        select {
            width: 100%;
            padding: 12px;
            border: 2px solid #eee;
            border-radius: 5px;
            font-family: inherit;
            font-size: 1em;
            transition: border-color 0.3s;
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        textarea:focus,
        select:focus {
            outline: none;
            border-color: #667eea;
        }

        textarea {
            resize: vertical;
            min-height: 150px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        button {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 30px;
            border: none;
            border-radius: 5px;
            font-size: 1em;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }

        button:active {
            transform: translateY(0);
        }

        .posts-container {
            display: grid;
            gap: 20px;
        }

        .post-card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .post-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.15);
        }

        .post-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            margin-bottom: 15px;
        }

        .post-card h2 {
            color: #333;
            margin-bottom: 8px;
            font-size: 1.5em;
        }

        .post-meta {
            color: #999;
            font-size: 0.9em;
            margin-bottom: 15px;
        }

        .post-category {
            display: inline-block;
            background: #667eea;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            margin-right: 8px;
        }

        .post-content {
            color: #555;
            line-height: 1.6;
            margin-bottom: 15px;
            max-height: 150px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .post-stats {
            display: flex;
            gap: 20px;
            margin-bottom: 15px;
            font-size: 0.95em;
            color: #666;
        }

        .stat {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .post-actions {
            display: flex;
            gap: 10px;
        }

        .post-actions button {
            padding: 8px 15px;
            font-size: 0.9em;
            background: #f0f0f0;
            color: #333;
        }

        .post-actions button:hover {
            background: #e0e0e0;
        }

        .delete-btn {
            background: #ff6b6b !important;
            color: white !important;
        }

        .delete-btn:hover {
            background: #ff5252 !important;
        }

        .loading {
            text-align: center;
            padding: 40px;
            color: white;
            font-size: 1.2em;
        }

        .error {
            background: #ff6b6b;
            color: white;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .success {
            background: #51cf66;
            color: white;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .badge {
            display: inline-block;
            background: #ff922b;
            color: white;
            padding: 2px 8px;
            border-radius: 3px;
            font-size: 0.75em;
            margin-left: 10px;
        }

        @media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }

            h1 {
                font-size: 1.8em;
            }

            .post-header {
                flex-direction: column;
            }
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: white;
        }

        .empty-state h3 {
            font-size: 1.5em;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>📝 FreeLang Blog</h1>
            <p class="subtitle">Zero Dependencies, Pure Node.js Blog Engine</p>
        </header>

        <div id="message"></div>

        <div class="create-post">
            <h2 style="margin-bottom: 20px; color: #333;">✍️ New Post</h2>
            <form id="createForm">
                <div class="form-row">
                    <div class="form-group">
                        <label for="title">Title</label>
                        <input type="text" id="title" required placeholder="Post title">
                    </div>
                    <div class="form-group">
                        <label for="author">Author</label>
                        <input type="text" id="author" required placeholder="Your name">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="category">Category</label>
                        <input type="text" id="category" required placeholder="e.g. Tutorial, News">
                    </div>
                    <div class="form-group">
                        <label for="slug">Slug</label>
                        <input type="text" id="slug" required placeholder="url-friendly-slug">
                    </div>
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <input type="text" id="description" placeholder="Brief description">
                </div>

                <div class="form-group">
                    <label for="content">Content</label>
                    <textarea id="content" required placeholder="Post content..."></textarea>
                </div>

                <div class="form-group">
                    <label for="tags">Tags (comma-separated)</label>
                    <input type="text" id="tags" placeholder="tag1, tag2, tag3">
                </div>

                <button type="submit">📤 Create Post</button>
            </form>
        </div>

        <div class="posts-container" id="posts">
            <div class="loading">Loading posts...</div>
        </div>
    </div>

    <style id="modal-styles">
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.8);
        }

        .modal-content {
            background: white;
            margin: 5% auto;
            padding: 40px;
            border-radius: 10px;
            width: 90%;
            max-width: 900px;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }

        .modal-close {
            float: right;
            font-size: 2em;
            font-weight: bold;
            cursor: pointer;
            color: #999;
        }

        .modal-close:hover {
            color: #333;
        }

        .post-detail h1 {
            color: #667eea;
            font-size: 2em;
            margin-bottom: 10px;
        }

        .post-detail-meta {
            color: #999;
            margin-bottom: 20px;
            font-size: 0.95em;
        }

        .post-detail-meta span {
            margin-right: 20px;
        }

        .post-detail-content {
            color: #333;
            line-height: 1.8;
            font-size: 1.05em;
            margin-bottom: 30px;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .post-detail-tags {
            margin-bottom: 20px;
        }

        .tag {
            display: inline-block;
            background: #667eea;
            color: white;
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 0.85em;
            margin-right: 8px;
            margin-bottom: 8px;
        }

        .post-detail-stats {
            border-top: 1px solid #eee;
            padding-top: 20px;
            margin-top: 20px;
        }

        .post-detail-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
            border-top: 1px solid #eee;
            padding-top: 20px;
        }

        .post-detail-actions button {
            flex: 1;
            padding: 12px;
        }
    </style>

    <div id="postModal" class="modal">
        <div class="modal-content">
            <span class="modal-close" onclick="closePostModal()">&times;</span>
            <div id="postDetailContent" class="post-detail"></div>
        </div>
    </div>

    <script>
        const API_URL = 'http://localhost:5021/api';

        function showMessage(text, type = 'success') {
            const msg = document.getElementById('message');
            msg.className = type;
            msg.textContent = text;
            setTimeout(() => { msg.textContent = ''; }, 3000);
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function renderMarkdown(text) {
            // Simple markdown rendering
            return text
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/\`(.*?)\`/g, '<code>$1</code>')
                .replace(/\n\n/g, '</p><p>')
                .replace(/\n/g, '<br>')
                .split('\n').map(line => {
                    if (line.match(/^###\s/)) return `<h3>${line.replace(/^###\s/, '')}</h3>`;
                    if (line.match(/^##\s/)) return `<h2>${line.replace(/^##\s/, '')}</h2>`;
                    if (line.match(/^#\s/)) return `<h1>${line.replace(/^#\s/, '')}</h1>`;
                    return line;
                }).join('\n');
        }

        async function loadPosts() {
            try {
                const response = await fetch(`${API_URL}/blogs`);
                const data = await response.json();

                const postsDiv = document.getElementById('posts');

                if (!data.data || data.data.length === 0) {
                    postsDiv.innerHTML = `
                        <div class="empty-state">
                            <h3>포스트가 없습니다</h3>
                            <p>위에서 첫 포스트를 작성해보세요!</p>
                        </div>
                    `;
                    return;
                }

                postsDiv.innerHTML = data.data
                    .reverse()
                    .map(post => `
                        <div class="post-card">
                            <div class="post-header">
                                <div>
                                    <h2>${escapeHtml(post.title)}</h2>
                                    <div class="post-meta">
                                        ${escapeHtml(post.author)} • ${new Date(post.createdAt).toLocaleDateString('ko-KR')}
                                    </div>
                                </div>
                                ${post.featured ? '<span class="badge">⭐ Featured</span>' : ''}
                            </div>

                            <div>
                                <span class="post-category">${escapeHtml(post.category)}</span>
                            </div>

                            <p class="post-content">${escapeHtml(post.description || post.content.substring(0, 150))}...</p>

                            <div class="post-stats">
                                <div class="stat">👁️ ${post.viewCount} views</div>
                                <div class="stat">❤️ ${post.likes} likes</div>
                                <div class="stat">📝 ${escapeHtml(post.category)}</div>
                            </div>

                            <div class="post-actions">
                                <button onclick="openPostModal(${post.id})" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; flex: 2;">📖 전문 보기</button>
                                <button onclick="likePost(${post.id})">❤️ Like</button>
                                <button onclick="deletePost(${post.id})" class="delete-btn">🗑️ Delete</button>
                            </div>
                        </div>
                    `).join('');
            } catch (error) {
                console.error('Error loading posts:', error);
                document.getElementById('posts').innerHTML = `<div class="error">❌ 포스트 로드 오류</div>`;
            }
        }

        async function openPostModal(id) {
            try {
                // 조회수 증가
                await fetch(`${API_URL}/blogs/${id}/view`, { method: 'POST' });

                // 상세 정보 로드
                const response = await fetch(`${API_URL}/blogs/${id}`);
                const post = await response.json();

                const modal = document.getElementById('postModal');
                const content = document.getElementById('postDetailContent');

                const tagsHtml = post.tags ? post.tags.split(',').map(tag =>
                    `<span class="tag">${escapeHtml(tag.trim())}</span>`
                ).join('') : '';

                content.innerHTML = `
                    <h1>${escapeHtml(post.title)}</h1>
                    <div class="post-detail-meta">
                        <span>✍️ ${escapeHtml(post.author)}</span>
                        <span>📅 ${new Date(post.createdAt).toLocaleDateString('ko-KR')}</span>
                        <span>📁 ${escapeHtml(post.category)}</span>
                        <span>${post.featured ? '⭐ Featured' : ''}</span>
                    </div>
                    ${post.description ? `<p style="color: #666; font-style: italic; margin-bottom: 20px;">${escapeHtml(post.description)}</p>` : ''}
                    <div class="post-detail-content">${escapeHtml(post.content)}</div>
                    ${tagsHtml ? `<div class="post-detail-tags"><strong>태그:</strong> ${tagsHtml}</div>` : ''}
                    <div class="post-detail-stats">
                        <div class="stat">👁️ ${post.viewCount} 조회</div>
                        <div class="stat">❤️ ${post.likes} 좋아요</div>
                    </div>
                    <div class="post-detail-actions">
                        <button onclick="likePost(${post.id})">❤️ 좋아요 추가</button>
                        <button onclick="deletePost(${post.id})" class="delete-btn">🗑️ 삭제</button>
                        <button onclick="closePostModal()">✖️ 닫기</button>
                    </div>
                `;

                modal.style.display = 'block';
                loadPosts();
            } catch (error) {
                console.error('Error:', error);
                showMessage('❌ 포스트 로드 오류: ' + error.message, 'error');
            }
        }

        function closePostModal() {
            document.getElementById('postModal').style.display = 'none';
        }

        window.onclick = function(event) {
            const modal = document.getElementById('postModal');
            if (event.target == modal) {
                modal.style.display = 'none';
            }
        }

        async function createPost(e) {
            e.preventDefault();

            const post = {
                title: document.getElementById('title').value,
                author: document.getElementById('author').value,
                content: document.getElementById('content').value,
                category: document.getElementById('category').value,
                slug: document.getElementById('slug').value,
                description: document.getElementById('description').value,
                tags: document.getElementById('tags').value,
                featured: false
            };

            try {
                const response = await fetch(`${API_URL}/blogs`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(post)
                });

                if (response.ok) {
                    document.getElementById('createForm').reset();
                    showMessage('✅ 포스트 작성됨!', 'success');
                    loadPosts();
                } else {
                    showMessage('❌ 포스트 작성 오류', 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showMessage('❌ 오류: ' + error.message, 'error');
            }
        }

        async function likePost(id) {
            try {
                await fetch(`${API_URL}/blogs/${id}/like`, { method: 'POST' });
                loadPosts();
            } catch (error) {
                console.error('Error:', error);
            }
        }

        async function deletePost(id) {
            if (confirm('정말 삭제하시겠습니까?')) {
                try {
                    await fetch(`${API_URL}/blogs/${id}`, { method: 'DELETE' });
                    showMessage('✅ 포스트 삭제됨!', 'success');
                    closePostModal();
                    loadPosts();
                } catch (error) {
                    console.error('Error:', error);
                    showMessage('❌ 삭제 오류', 'error');
                }
            }
        }

        document.getElementById('createForm').addEventListener('submit', createPost);

        // Load posts on page load
        loadPosts();

        // Refresh posts every 5 seconds
        setInterval(loadPosts, 5000);
    </script>
</body>
</html>
