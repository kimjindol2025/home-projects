#!/bin/bash

# FreeLang Blog Server Startup Script
# Runs blog server on port 5021

set -e

cd "$(dirname "$0")"

echo "🚀 Starting FreeLang Blog Server..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# Check if Node.js is available
if ! command -v node &> /dev/null; then
    echo "❌ Node.js not found. Please install Node.js first."
    exit 1
fi

# Run server
NODE_ENV=production PORT=5021 node blog-server.js
