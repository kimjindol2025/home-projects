<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FreeLang Blog</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        header {
            background: white;
            padding: 30px;
            border-radius: 10px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        h1 {
            color: #667eea;
            margin-bottom: 10px;
            font-size: 2.5em;
        }

        .subtitle {
            color: #666;
            font-size: 1.1em;
        }

        .create-post {
            background: white;
            padding: 30px;
            border-radius: 10px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-weight: 500;
        }

        input[type="text"],
        input[type="email"],
        textarea,
        select {
            width: 100%;
            padding: 12px;
            border: 2px solid #eee;
            border-radius: 5px;
            font-family: inherit;
            font-size: 1em;
            transition: border-color 0.3s;
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        textarea:focus,
        select:focus {
            outline: none;
            border-color: #667eea;
        }

        textarea {
            resize: vertical;
            min-height: 150px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        button {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 30px;
            border: none;
            border-radius: 5px;
            font-size: 1em;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }

        button:active {
            transform: translateY(0);
        }

        .posts-container {
            display: grid;
            gap: 20px;
        }

        .post-card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .post-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.15);
        }

        .post-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            margin-bottom: 15px;
        }

        .post-card h2 {
            color: #333;
            margin-bottom: 8px;
            font-size: 1.5em;
        }

        .post-meta {
            color: #999;
            font-size: 0.9em;
            margin-bottom: 15px;
        }

        .post-category {
            display: inline-block;
            background: #667eea;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            margin-right: 8px;
        }

        .post-content {
            color: #555;
            line-height: 1.6;
            margin-bottom: 15px;
            max-height: 150px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .post-stats {
            display: flex;
            gap: 20px;
            margin-bottom: 15px;
            font-size: 0.95em;
            color: #666;
        }

        .stat {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .post-actions {
            display: flex;
            gap: 10px;
        }

        .post-actions button {
            padding: 8px 15px;
            font-size: 0.9em;
            background: #f0f0f0;
            color: #333;
        }

        .post-actions button:hover {
            background: #e0e0e0;
        }

        .delete-btn {
            background: #ff6b6b !important;
            color: white !important;
        }

        .delete-btn:hover {
            background: #ff5252 !important;
        }

        .loading {
            text-align: center;
            padding: 40px;
            color: white;
            font-size: 1.2em;
        }

        .error {
            background: #ff6b6b;
            color: white;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .success {
            background: #51cf66;
            color: white;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .badge {
            display: inline-block;
            background: #ff922b;
            color: white;
            padding: 2px 8px;
            border-radius: 3px;
            font-size: 0.75em;
            margin-left: 10px;
        }

        @media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }

            h1 {
                font-size: 1.8em;
            }

            .post-header {
                flex-direction: column;
            }
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: white;
        }

        .empty-state h3 {
            font-size: 1.5em;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>📝 FreeLang Blog</h1>
            <p class="subtitle">Zero Dependencies, Pure Node.js Blog Engine</p>
        </header>

        <div id="message"></div>

        <div class="create-post">
            <h2 style="margin-bottom: 20px; color: #333;">✍️ New Post</h2>
            <form id="createForm">
                <div class="form-row">
                    <div class="form-group">
                        <label for="title">Title</label>
                        <input type="text" id="title" required placeholder="Post title">
                    </div>
                    <div class="form-group">
                        <label for="author">Author</label>
                        <input type="text" id="author" required placeholder="Your name">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="category">Category</label>
                        <input type="text" id="category" required placeholder="e.g. Tutorial, News">
                    </div>
                    <div class="form-group">
                        <label for="slug">Slug</label>
                        <input type="text" id="slug" required placeholder="url-friendly-slug">
                    </div>
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <input type="text" id="description" placeholder="Brief description">
                </div>

                <div class="form-group">
                    <label for="content">Content</label>
                    <textarea id="content" required placeholder="Post content..."></textarea>
                </div>

                <div class="form-group">
                    <label for="tags">Tags (comma-separated)</label>
                    <input type="text" id="tags" placeholder="tag1, tag2, tag3">
                </div>

                <button type="submit">📤 Create Post</button>
            </form>
        </div>

        <div class="posts-container" id="posts">
            <div class="loading">Loading posts...</div>
        </div>
    </div>

    <script>
        const API_URL = 'http://localhost:5021/api';

        function showMessage(text, type = 'success') {
            const msg = document.getElementById('message');
            msg.className = type;
            msg.textContent = text;
            setTimeout(() => { msg.textContent = ''; }, 3000);
        }

        async function loadPosts() {
            try {
                const response = await fetch(`${API_URL}/blogs`);
                const data = await response.json();

                const postsDiv = document.getElementById('posts');

                if (!data.data || data.data.length === 0) {
                    postsDiv.innerHTML = `
                        <div class="empty-state">
                            <h3>No posts yet</h3>
                            <p>Create your first post above!</p>
                        </div>
                    `;
                    return;
                }

                postsDiv.innerHTML = data.data
                    .reverse()
                    .map(post => `
                        <div class="post-card">
                            <div class="post-header">
                                <div>
                                    <h2>${escapeHtml(post.title)}</h2>
                                    <div class="post-meta">
                                        by ${escapeHtml(post.author)} • ${new Date(post.createdAt).toLocaleDateString('ko-KR')}
                                    </div>
                                </div>
                                ${post.featured ? '<span class="badge">Featured</span>' : ''}
                            </div>

                            <div>
                                <span class="post-category">${escapeHtml(post.category)}</span>
                            </div>

                            <p class="post-content">${escapeHtml(post.description || post.content.substring(0, 200))}</p>

                            <div class="post-stats">
                                <div class="stat">👁️ ${post.viewCount} views</div>
                                <div class="stat">❤️ ${post.likes} likes</div>
                                <div class="stat">📌 ${post.status}</div>
                            </div>

                            <div class="post-actions">
                                <button onclick="viewPost(${post.id})">👁️ View</button>
                                <button onclick="likePost(${post.id})">❤️ Like</button>
                                <button onclick="deletePost(${post.id})" class="delete-btn">🗑️ Delete</button>
                            </div>
                        </div>
                    `).join('');
            } catch (error) {
                console.error('Error loading posts:', error);
                document.getElementById('posts').innerHTML = `<div class="error">Error loading posts</div>`;
            }
        }

        async function createPost(e) {
            e.preventDefault();

            const post = {
                title: document.getElementById('title').value,
                author: document.getElementById('author').value,
                content: document.getElementById('content').value,
                category: document.getElementById('category').value,
                slug: document.getElementById('slug').value,
                description: document.getElementById('description').value,
                tags: document.getElementById('tags').value,
                featured: false
            };

            try {
                const response = await fetch(`${API_URL}/blogs`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(post)
                });

                if (response.ok) {
                    document.getElementById('createForm').reset();
                    showMessage('✅ Post created!', 'success');
                    loadPosts();
                } else {
                    showMessage('❌ Error creating post', 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        async function viewPost(id) {
            try {
                await fetch(`${API_URL}/blogs/${id}/view`, { method: 'POST' });
                loadPosts();
            } catch (error) {
                console.error('Error:', error);
            }
        }

        async function likePost(id) {
            try {
                await fetch(`${API_URL}/blogs/${id}/like`, { method: 'POST' });
                loadPosts();
            } catch (error) {
                console.error('Error:', error);
            }
        }

        async function deletePost(id) {
            if (confirm('Delete this post?')) {
                try {
                    await fetch(`${API_URL}/blogs/${id}`, { method: 'DELETE' });
                    showMessage('✅ Post deleted!', 'success');
                    loadPosts();
                } catch (error) {
                    console.error('Error:', error);
                    showMessage('❌ Error deleting post', 'error');
                }
            }
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        document.getElementById('createForm').addEventListener('submit', createPost);

        // Load posts on page load
        loadPosts();

        // Refresh posts every 5 seconds
        setInterval(loadPosts, 5000);
    </script>
</body>
</html>
