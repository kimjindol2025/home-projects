/**
 * FreeLang Light Database Schema Generator
 * .free 컴포넌트를 SQL 스키마로 변환
 *
 * 역할: AST를 데이터베이스 테이블 정의로 변환
 */

class DatabaseSchemaGenerator {
  constructor() {
    this.indent = 0;
  }

  /**
   * FreeLang 컴포넌트를 SQL 스키마로 컴파일
   * @param {Object} ast - 파싱된 AST
   * @returns {string} SQL 스키마 코드
   */
  compile(ast) {
    let sql = '';

    // Props 기반 테이블 생성
    if (ast.props && Object.keys(ast.props).length > 0) {
      sql += this.generateTable(ast.name, ast.props);
      sql += '\n\n';
    }

    // State 기반 히스토리 테이블
    if (ast.state && Object.keys(ast.state).length > 0) {
      sql += this.generateHistoryTable(ast.name, ast.state);
      sql += '\n\n';
    }

    return sql;
  }

  /**
   * Props 기반 메인 테이블 생성
   * @example
   * CREATE TABLE Button (
   *   id SERIAL PRIMARY KEY,
   *   label VARCHAR(255) NOT NULL,
   *   disabled BOOLEAN DEFAULT false,
   *   created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
   * );
   */
  generateTable(componentName, props) {
    let sql = `CREATE TABLE ${this.camelToSnake(componentName)} (\n`;
    sql += `  id SERIAL PRIMARY KEY,\n`;

    for (const [key, prop] of Object.entries(props)) {
      const sqlType = this.mapFreeLangTypeToSQL(prop.type);
      const nullable = prop.optional ? 'DEFAULT NULL' : 'NOT NULL';
      sql += `  ${this.camelToSnake(key)} ${sqlType} ${nullable},\n`;
    }

    sql += `  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n`;
    sql += `  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP\n`;
    sql += `);`;

    return sql;
  }

  /**
   * State 기반 히스토리 테이블 생성
   * @example
   * CREATE TABLE ButtonState (
   *   id SERIAL PRIMARY KEY,
   *   button_id INTEGER REFERENCES button(id),
   *   is_active BOOLEAN,
   *   click_count INTEGER,
   *   recorded_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
   * );
   */
  generateHistoryTable(componentName, state) {
    const tableName = this.camelToSnake(componentName);
    const historyTableName = `${tableName}_history`;

    let sql = `CREATE TABLE ${historyTableName} (\n`;
    sql += `  id SERIAL PRIMARY KEY,\n`;
    sql += `  ${tableName}_id INTEGER REFERENCES ${tableName}(id) ON DELETE CASCADE,\n`;

    for (const [key, value] of Object.entries(state)) {
      const sqlType = this.inferSQLType(value);
      sql += `  ${this.camelToSnake(key)} ${sqlType},\n`;
    }

    sql += `  recorded_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n`;
    sql += `);`;

    return sql;
  }

  /**
   * FreeLang 타입을 SQL로 매핑
   */
  mapFreeLangTypeToSQL(type) {
    const typeMap = {
      'string': 'VARCHAR(255)',
      'number': 'DECIMAL(10,2)',
      'boolean': 'BOOLEAN',
      'array': 'JSON',
      'object': 'JSON',
      'i32': 'INTEGER',
      'i64': 'BIGINT',
      'f32': 'FLOAT',
      'f64': 'DOUBLE'
    };

    // 제네릭 타입 처리 (array<string> → JSON)
    if (type.includes('<')) {
      return 'JSON';
    }

    return typeMap[type] || 'TEXT';
  }

  /**
   * 값으로부터 SQL 타입 추론
   */
  inferSQLType(value) {
    if (typeof value === 'string') return 'VARCHAR(255)';
    if (typeof value === 'number') {
      return Number.isInteger(value) ? 'INTEGER' : 'DECIMAL(10,2)';
    }
    if (typeof value === 'boolean') return 'BOOLEAN';
    if (Array.isArray(value)) return 'JSON';
    if (typeof value === 'object') return 'JSON';
    return 'TEXT';
  }

  /**
   * camelCase를 snake_case로 변환
   */
  camelToSnake(str) {
    return str.replace(/[A-Z]/g, letter => `_${letter.toLowerCase()}`);
  }

  /**
   * Index 생성 (성능 최적화)
   */
  generateIndices(componentName) {
    const tableName = this.camelToSnake(componentName);
    let sql = `\n-- Indices for ${tableName}\n`;
    sql += `CREATE INDEX idx_${tableName}_created_at ON ${tableName}(created_at);\n`;
    sql += `CREATE INDEX idx_${tableName}_updated_at ON ${tableName}(updated_at);\n`;
    return sql;
  }
}

module.exports = { DatabaseSchemaGenerator };
