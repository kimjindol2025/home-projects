/**
 * FreeLang Light Phase 5 Tests
 * Database + API + HTTP 통합 테스트
 */

const { UnifiedCompiler } = require('./unified-compiler');
const { DatabaseSchemaGenerator } = require('./database-schema-generator');
const { RestApiGenerator } = require('./rest-api-generator');
const { HttpResponseGenerator } = require('./http-response-generator');

function test(name, fn) {
  try {
    fn();
    console.log(`✅ ${name}`);
  } catch (error) {
    console.error(`❌ ${name}: ${error.message}`);
  }
}

// Test AST
const buttonAst = {
  type: 'component',
  name: 'Button',
  props: {
    label: { type: 'string', optional: false },
    disabled: { type: 'boolean', optional: true },
    onClick: { type: 'string', optional: true }
  },
  state: {
    isActive: true,
    clickCount: 0
  },
  script: {
    functions: []
  },
  markup: {
    content: '<button {disabled} onclick="{onClick}">{label}</button>'
  },
  style: {
    content: 'button { padding: 10px; border-radius: 4px; }'
  }
};

console.log('\n📝 Database Schema Generator Tests\n');

test('데이터베이스 테이블 생성', () => {
  const generator = new DatabaseSchemaGenerator();
  const sql = generator.compile(buttonAst);

  if (!sql.includes('CREATE TABLE')) throw new Error('Missing CREATE TABLE');
  if (!sql.includes('button')) throw new Error('Missing table name');
  if (!sql.includes('label')) throw new Error('Missing label column');
  if (!sql.includes('VARCHAR')) throw new Error('Missing VARCHAR type');
  if (!sql.includes('PRIMARY KEY')) throw new Error('Missing PRIMARY KEY');
  if (!sql.includes('TIMESTAMP')) throw new Error('Missing TIMESTAMP');
});

test('히스토리 테이블 생성', () => {
  const generator = new DatabaseSchemaGenerator();
  const sql = generator.compile(buttonAst);

  if (!sql.includes('button_history')) throw new Error('Missing history table');
  if (!sql.includes('is_active')) throw new Error('Missing state columns');
  if (!sql.includes('click_count')) throw new Error('Missing click_count column');
});

test('Type 매핑: string -> VARCHAR', () => {
  const generator = new DatabaseSchemaGenerator();
  const type = generator.mapFreeLangTypeToSQL('string');

  if (type !== 'VARCHAR(255)') throw new Error(`Expected VARCHAR(255), got ${type}`);
});

test('Type 매핑: boolean -> BOOLEAN', () => {
  const generator = new DatabaseSchemaGenerator();
  const type = generator.mapFreeLangTypeToSQL('boolean');

  if (type !== 'BOOLEAN') throw new Error(`Expected BOOLEAN, got ${type}`);
});

test('Type 매핑: i64 -> BIGINT', () => {
  const generator = new DatabaseSchemaGenerator();
  const type = generator.mapFreeLangTypeToSQL('i64');

  if (type !== 'BIGINT') throw new Error(`Expected BIGINT, got ${type}`);
});

test('camelCase -> snake_case 변환', () => {
  const generator = new DatabaseSchemaGenerator();
  const result = generator.camelToSnake('isActive');

  if (result !== 'is_active') throw new Error(`Expected is_active, got ${result}`);
});

console.log('\n🔌 REST API Generator Tests\n');

test('REST API 라우터 생성', () => {
  const generator = new RestApiGenerator();
  const api = generator.compile(buttonAst);

  if (!api.includes('express.Router')) throw new Error('Missing router setup');
  if (!api.includes('router.post')) throw new Error('Missing POST endpoint');
  if (!api.includes('router.get')) throw new Error('Missing GET endpoint');
});

test('CREATE 엔드포인트 생성', () => {
  const generator = new RestApiGenerator();
  const api = generator.compile(buttonAst);

  if (!api.includes("router.post('/button'")) throw new Error('Missing POST /button');
  if (!api.includes('201')) throw new Error('Missing 201 status code');
  if (!api.includes('INSERT INTO')) throw new Error('Missing INSERT query');
});

test('READ 엔드포인트 생성', () => {
  const generator = new RestApiGenerator();
  const api = generator.compile(buttonAst);

  if (!api.includes("router.get('/button/:id'")) throw new Error('Missing GET /button/:id');
  if (!api.includes('404')) throw new Error('Missing 404 status code');
  if (!api.includes('SELECT * FROM')) throw new Error('Missing SELECT query');
});

test('LIST 엔드포인트 생성', () => {
  const generator = new RestApiGenerator();
  const api = generator.compile(buttonAst);

  if (!api.includes("router.get('/button'")) throw new Error('Missing GET /button');
  if (!api.includes('pagination')) throw new Error('Missing pagination');
  if (!api.includes('limit')) throw new Error('Missing limit parameter');
  if (!api.includes('page')) throw new Error('Missing page parameter');
});

test('UPDATE 엔드포인트 생성', () => {
  const generator = new RestApiGenerator();
  const api = generator.compile(buttonAst);

  if (!api.includes("router.put('/button/:id'")) throw new Error('Missing PUT /button/:id');
  if (!api.includes('UPDATE')) throw new Error('Missing UPDATE query');
  if (!api.includes('updated_at')) throw new Error('Missing updated_at');
});

test('DELETE 엔드포인트 생성', () => {
  const generator = new RestApiGenerator();
  const api = generator.compile(buttonAst);

  if (!api.includes("router.delete('/button/:id'")) throw new Error('Missing DELETE /button/:id');
  if (!api.includes('DELETE FROM')) throw new Error('Missing DELETE query');
});

test('camelCase -> kebab-case 변환', () => {
  const generator = new RestApiGenerator();
  const result = generator.camelToKebab('PushButton');

  if (result !== 'push-button') throw new Error(`Expected push-button, got ${result}`);
});

console.log('\n🌐 HTTP Response Generator Tests\n');

test('HTTP 렌더 함수 생성', () => {
  const generator = new HttpResponseGenerator();
  const http = generator.compile(buttonAst);

  if (!http.includes('function renderButton')) throw new Error('Missing render function');
  if (!http.includes('context')) throw new Error('Missing context parameter');
  if (!http.includes('{label}')) throw new Error('Missing variable substitution');
});

test('Express 미들웨어 생성', () => {
  const generator = new HttpResponseGenerator();
  const http = generator.compile(buttonAst);

  if (!http.includes('buttonHandler')) throw new Error('Missing handler function');
  if (!http.includes('res.send')) throw new Error('Missing res.send');
  if (!http.includes('Content-Type')) throw new Error('Missing Content-Type header');
});

test('Content-Type 설정', () => {
  const generator = new HttpResponseGenerator();
  const http = generator.compile(buttonAst);

  if (!http.includes('text/html')) throw new Error('Missing text/html content type');
  if (!http.includes('utf-8')) throw new Error('Missing charset');
});

test('에러 처리', () => {
  const generator = new HttpResponseGenerator();
  const http = generator.compile(buttonAst);

  if (!http.includes('catch')) throw new Error('Missing try-catch');
  if (!http.includes('500')) throw new Error('Missing 500 status code');
  if (!http.includes('error')) throw new Error('Missing error handling');
});

test('변수 이스케이프 처리', () => {
  const generator = new HttpResponseGenerator();
  const escaped = generator.escapeTemplate('`hello $world`');

  if (!escaped.includes('\\`')) throw new Error('Missing backtick escape');
  if (!escaped.includes('\\$')) throw new Error('Missing dollar escape');
});

console.log('\n🔗 Unified Compiler Tests\n');

test('통합 컴파일 - 모든 출력', () => {
  const compiler = new UnifiedCompiler();
  const result = compiler.compileAll(buttonAst);

  if (!result.typescript) throw new Error('Missing TypeScript output');
  if (!result.sql) throw new Error('Missing SQL output');
  if (!result.api) throw new Error('Missing API output');
  if (!result.http) throw new Error('Missing HTTP output');
  if (!result.manifest) throw new Error('Missing manifest');
});

test('선택적 컴파일', () => {
  const compiler = new UnifiedCompiler();
  const result = compiler.compileSelective(buttonAst, ['typescript', 'sql']);

  if (!result.typescript) throw new Error('Missing TypeScript');
  if (!result.sql) throw new Error('Missing SQL');
  if (result.api) throw new Error('Should not have API');
  if (result.http) throw new Error('Should not have HTTP');
});

test('매니페스트 생성', () => {
  const compiler = new UnifiedCompiler();
  const manifest = compiler.generateManifest(buttonAst);

  if (manifest.component !== 'Button') throw new Error('Wrong component name');
  if (!manifest.timestamp) throw new Error('Missing timestamp');
  if (!manifest.targets) throw new Error('Missing targets');
  if (!manifest.structure) throw new Error('Missing structure');
});

test('구조 분석', () => {
  const compiler = new UnifiedCompiler();
  const manifest = compiler.generateManifest(buttonAst);

  if (!manifest.structure.hasProps) throw new Error('Should have props');
  if (!manifest.structure.hasState) throw new Error('Should have state');
  if (!manifest.structure.hasMarkup) throw new Error('Should have markup');
  if (!manifest.structure.hasStyle) throw new Error('Should have style');
});

test('컴파일 보고서 생성', () => {
  const compiler = new UnifiedCompiler();
  const report = compiler.generateReport(buttonAst);

  if (!report.summary) throw new Error('Missing summary');
  if (!report.statistics) throw new Error('Missing statistics');
  if (!report.features) throw new Error('Missing features');
  if (!report.outputs) throw new Error('Missing outputs');
});

test('통계 수집', () => {
  const compiler = new UnifiedCompiler();
  const report = compiler.generateReport(buttonAst);

  if (!report.statistics.typescript.lines) throw new Error('Missing TS lines');
  if (!report.statistics.sql.lines) throw new Error('Missing SQL lines');
  if (!report.statistics.api.endpoints) throw new Error('Missing API endpoint count');
  if (report.statistics.api.endpoints !== 5) throw new Error('Wrong endpoint count');
});

console.log('\n✨ Phase 5 테스트 완료!\n');
