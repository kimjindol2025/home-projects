### Problem 7: Caching

**Issue**: Repeated reads hit database.

**Solution Required**:
```javascript
class CacheLayer {
  constructor(ttl = 60000) {
    this.cache = new Map();
    this.ttl = ttl;
  }

  get(key) {
    const entry = this.cache.get(key);
    if (!entry) return null;

    if (Date.now() - entry.time > this.ttl) {
      this.cache.delete(key);
      return null;
    }

    return entry.value;
  }

  set(key, value) {
    this.cache.set(key, { value, time: Date.now() });
  }

  invalidate(pattern) {
    for (const key of this.cache.keys()) {
      if (key.match(pattern)) {
        this.cache.delete(key);
      }
    }
  }
}

// Usage
const cache = new CacheLayer(5 * 60 * 1000); // 5 min TTL

getById(id) {
  const cacheKey = `post:${id}`;
  let post = cache.get(cacheKey);

  if (!post) {
    post = db.getById(id);
    cache.set(cacheKey, post);
  }

  return post;
}

// Invalidate when updated
update(id, updates) {
  const post = db.update(id, updates);
  cache.invalidate(`^post:`);
  return post;
}
```

