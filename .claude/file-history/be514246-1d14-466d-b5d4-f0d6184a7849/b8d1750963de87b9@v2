### Problem 5: Authentication & Authorization

**Issue**: Anyone can create, edit, delete posts.

**Solution Required**:
```javascript
// JWT Token validation middleware
function verifyToken(req, res, next) {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json({ error: 'Unauthorized' });

  jwt.verify(token, SECRET_KEY, (err, decoded) => {
    if (err) return res.status(403).json({ error: 'Forbidden' });
    req.user = decoded;
    next();
  });
}

// Apply to protected routes
router.post('/api/blogs', verifyToken, handleCreate);
router.put('/api/blogs/:id', verifyToken, handleUpdate);
router.delete('/api/blogs/:id', verifyToken, handleDelete);
```

