{
  "name": "miniscript",
  "version": "1.0.0",
  "description": "A simple programming language interpreter written in JavaScript",
  "main": "main.js",
  "bin": {
    "miniscript": "main.js"
  },
  "scripts": {
    "test": "node test.js",
    "repl": "node main.js",
    "examples:hello": "node main.js examples/hello.ms",
    "examples:fibonacci": "node main.js examples/fibonacci.ms",
    "examples:sum": "node main.js examples/sum.ms",
    "examples:all": "npm run examples:hello && npm run examples:fibonacci && npm run examples:sum"
  },
  "keywords": [
    "interpreter",
    "minilang",
    "programming-language",
    "javascript"
  ],
  "author": "Claude Haiku 4.5",
  "license": "MIT"
}
