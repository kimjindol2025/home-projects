<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MiniScript - 웹 인터프리터</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="container">
    <!-- 헤더 -->
    <header class="header">
      <h1>🚀 MiniScript</h1>
      <p>간단하고 강력한 미니 프로그래밍 언어</p>
    </header>

    <!-- 메인 컨텐츠 -->
    <main class="main">
      <!-- 왼쪽: 에디터 -->
      <div class="editor-section">
        <div class="section-header">
          <h2>📝 코드 에디터</h2>
          <div class="button-group">
            <button id="runBtn" class="btn btn-primary">▶ 실행</button>
            <button id="clearBtn" class="btn btn-secondary">🗑 초기화</button>
          </div>
        </div>
        <textarea id="codeEditor" class="code-editor" placeholder="여기에 MiniScript 코드를 입력하세요..."></textarea>
      </div>

      <!-- 오른쪽: 결과 및 예제 -->
      <div class="output-section">
        <!-- 결과 -->
        <div class="result-panel">
          <div class="section-header">
            <h2>📊 실행 결과</h2>
          </div>
          <div id="output" class="output"></div>
        </div>

        <!-- 예제 -->
        <div class="examples-panel">
          <div class="section-header">
            <h2>📚 예제</h2>
          </div>
          <div class="examples">
            <button class="example-btn" data-example="hello">👋 Hello World</button>
            <button class="example-btn" data-example="factorial">🔢 팩토리얼</button>
            <button class="example-btn" data-example="multiplication">📊 구구단</button>
            <button class="example-btn" data-example="array">📦 배열 연산</button>
          </div>
        </div>
      </div>
    </main>

    <!-- 기능 소개 -->
    <section class="features">
      <h2>✨ MiniScript의 특징</h2>
      <div class="features-grid">
        <div class="feature">
          <h3>📌 변수</h3>
          <code>let x = 10;<br>const PI = 3.14;</code>
        </div>
        <div class="feature">
          <h3>🔄 제어 흐름</h3>
          <code>if (x > 5) { ... }<br>for (let i = 0; i < 10; i = i + 1) { ... }</code>
        </div>
        <div class="feature">
          <h3>🔧 함수</h3>
          <code>fn add(a, b) {<br>  return a + b;<br>}</code>
        </div>
        <div class="feature">
          <h3>📦 배열</h3>
          <code>let arr = [1, 2, 3];<br>println(arr[0]);</code>
        </div>
      </div>
    </section>

    <!-- 문법 가이드 -->
    <section class="syntax-guide">
      <h2>📖 기본 문법</h2>
      <div class="guide-content">
        <div class="guide-item">
          <h4>출력 함수</h4>
          <code>print("Hello");<br>println("Hello with newline");</code>
        </div>
        <div class="guide-item">
          <h4>배열 함수</h4>
          <code>length(arr) - 배열 크기<br>push(arr, value) - 요소 추가<br>pop(arr) - 마지막 요소 제거</code>
        </div>
        <div class="guide-item">
          <h4>유틸리티</h4>
          <code>type(value) - 값의 타입<br>range(n) - 0~n-1 배열 생성</code>
        </div>
      </div>
    </section>

    <!-- 푸터 -->
    <footer class="footer">
      <p>🎓 MiniScript Web Interpreter v1.0 | Built with JavaScript</p>
    </footer>
  </div>

  <!-- 로딩 표시 -->
  <div id="loadingOverlay" class="loading-overlay" style="display: none;">
    <div class="spinner"></div>
  </div>

  <script src="script.js"></script>
</body>
</html>
