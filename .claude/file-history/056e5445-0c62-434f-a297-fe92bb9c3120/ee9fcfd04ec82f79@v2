#!/usr/bin/env node

/**
 * MiniScript 메인 프로그램
 * REPL 또는 파일 실행
 */

const fs = require('fs');
const readline = require('readline');
const { Tokenizer } = require('./tokenizer');
const { Parser } = require('./parser');
const { Interpreter } = require('./interpreter');

function runCode(source) {
  try {
    const tokenizer = new Tokenizer(source);
    const tokens = tokenizer.tokenize();

    const parser = new Parser(tokens);
    const ast = parser.parse();

    const interpreter = new Interpreter();
    interpreter.interpret(ast);
  } catch (error) {
    console.error(`Error: ${error.message}`);
  }
}

function runFile(filename) {
  try {
    const source = fs.readFileSync(filename, 'utf-8');
    runCode(source);
  } catch (error) {
    console.error(`Error reading file: ${error.message}`);
  }
}

function runREPL() {
  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
  });

  const interpreter = new Interpreter();

  console.log('MiniScript REPL');
  console.log('Type "exit" to quit, "help" for help');
  console.log('');

  const prompt = () => {
    rl.question('> ', (input) => {
      if (input === 'exit') {
        console.log('Goodbye!');
        rl.close();
        return;
      }

      if (input === 'help') {
        console.log(`
MiniScript - Simple Programming Language

Features:
- Variables: let x = 42; const y = 10;
- Functions: fn add(a, b) { return a + b; }
- Control flow: if, while, for
- Arrays: [1, 2, 3]
- Built-in: print, println, length, type, etc.

Examples:
  let x = 10;
  for (let i = 0; i < x; i = i + 1) { println(i); }
  fn fib(n) { if (n <= 1) { return n; } return fib(n-1) + fib(n-2); }
  println(fib(10));
`);
        prompt();
        return;
      }

      if (input.trim() === '') {
        prompt();
        return;
      }

      try {
        const tokenizer = new Tokenizer(input);
        const tokens = tokenizer.tokenize();

        const parser = new Parser(tokens);
        const ast = parser.parse();

        interpreter.interpret(ast);
      } catch (error) {
        console.error(`Error: ${error.message}`);
      }

      prompt();
    });
  };

  prompt();
}

// 메인
const args = process.argv.slice(2);

if (args.length === 0) {
  // REPL 모드
  runREPL();
} else if (args.length === 1) {
  // 파일 모드
  const filename = args[0];
  runFile(filename);
} else {
  console.error('Usage: miniscript [file]');
  process.exit(1);
}
