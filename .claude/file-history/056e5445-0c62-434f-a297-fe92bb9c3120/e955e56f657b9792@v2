/**
 * MiniScript Parser
 * 토큰을 AST로 변환
 */

const { TokenType } = require('./tokenizer');
const {
  Program,
  LetDeclaration,
  ConstDeclaration,
  FunctionDeclaration,
  IfStatement,
  WhileStatement,
  ForStatement,
  ReturnStatement,
  BlockStatement,
  ExpressionStatement,
  NumberLiteral,
  StringLiteral,
  BooleanLiteral,
  NullLiteral,
  Identifier,
  BinaryOp,
  UnaryOp,
  Assignment,
  FunctionCall,
  ArrayLiteral,
  IndexAccess,
  MemberAccess,
} = require('./ast');

class Parser {
  constructor(tokens) {
    this.tokens = tokens;
    this.position = 0;
  }

  currentToken() {
    if (this.position >= this.tokens.length) {
      return this.tokens[this.tokens.length - 1]; // EOF
    }
    return this.tokens[this.position];
  }

  peekToken(offset = 1) {
    const pos = this.position + offset;
    if (pos >= this.tokens.length) {
      return this.tokens[this.tokens.length - 1]; // EOF
    }
    return this.tokens[pos];
  }

  advance() {
    this.position++;
  }

  expect(type) {
    const token = this.currentToken();
    if (token.type !== type) {
      throw new Error(`Expected ${type}, got ${token.type} at ${token.line}:${token.column}`);
    }
    this.advance();
    return token;
  }

  match(...types) {
    return types.includes(this.currentToken().type);
  }

  parse() {
    const statements = [];

    while (this.currentToken().type !== TokenType.EOF) {
      statements.push(this.parseStatement());
    }

    return new Program(statements);
  }

  parseStatement() {
    const token = this.currentToken();

    // 변수 선언
    if (token.type === TokenType.LET) {
      return this.parseLetDeclaration();
    }

    if (token.type === TokenType.CONST) {
      return this.parseConstDeclaration();
    }

    // 함수 선언
    if (token.type === TokenType.FN) {
      return this.parseFunctionDeclaration();
    }

    // 제어 흐름
    if (token.type === TokenType.IF) {
      return this.parseIfStatement();
    }

    if (token.type === TokenType.WHILE) {
      return this.parseWhileStatement();
    }

    if (token.type === TokenType.FOR) {
      return this.parseForStatement();
    }

    if (token.type === TokenType.RETURN) {
      return this.parseReturnStatement();
    }

    // 블록
    if (token.type === TokenType.LBRACE) {
      return this.parseBlockStatement();
    }

    // 표현식 문장
    return this.parseExpressionStatement();
  }

  parseLetDeclaration() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    this.expect(TokenType.LET);
    const name = this.expect(TokenType.IDENTIFIER).value;

    let value = null;
    if (this.match(TokenType.ASSIGN)) {
      this.expect(TokenType.ASSIGN);
      value = this.parseExpression();
    }

    if (this.match(TokenType.SEMICOLON)) {
      this.expect(TokenType.SEMICOLON);
    }

    return new LetDeclaration(name, value, line, column);
  }

  parseConstDeclaration() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    this.expect(TokenType.CONST);
    const name = this.expect(TokenType.IDENTIFIER).value;
    this.expect(TokenType.ASSIGN);
    const value = this.parseExpression();

    if (this.match(TokenType.SEMICOLON)) {
      this.expect(TokenType.SEMICOLON);
    }

    return new ConstDeclaration(name, value, line, column);
  }

  parseFunctionDeclaration() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    this.expect(TokenType.FN);
    const name = this.expect(TokenType.IDENTIFIER).value;

    this.expect(TokenType.LPAREN);
    const params = [];
    while (!this.match(TokenType.RPAREN)) {
      params.push(this.expect(TokenType.IDENTIFIER).value);
      if (this.match(TokenType.COMMA)) {
        this.expect(TokenType.COMMA);
      }
    }
    this.expect(TokenType.RPAREN);

    this.expect(TokenType.LBRACE);
    const body = this.parseBlockBody();
    this.expect(TokenType.RBRACE);

    return new FunctionDeclaration(name, params, body, line, column);
  }

  parseIfStatement() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    this.expect(TokenType.IF);
    this.expect(TokenType.LPAREN);
    const condition = this.parseExpression();
    this.expect(TokenType.RPAREN);

    this.expect(TokenType.LBRACE);
    const thenBranch = this.parseBlockBody();
    this.expect(TokenType.RBRACE);

    let elseBranch = null;
    if (this.match(TokenType.ELSE)) {
      this.expect(TokenType.ELSE);
      this.expect(TokenType.LBRACE);
      elseBranch = this.parseBlockBody();
      this.expect(TokenType.RBRACE);
    }

    return new IfStatement(condition, thenBranch, elseBranch, line, column);
  }

  parseWhileStatement() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    this.expect(TokenType.WHILE);
    this.expect(TokenType.LPAREN);
    const condition = this.parseExpression();
    this.expect(TokenType.RPAREN);

    this.expect(TokenType.LBRACE);
    const body = this.parseBlockBody();
    this.expect(TokenType.RBRACE);

    return new WhileStatement(condition, body, line, column);
  }

  parseForStatement() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    this.expect(TokenType.FOR);
    this.expect(TokenType.LPAREN);

    // 초기화
    let init = null;
    if (!this.match(TokenType.SEMICOLON)) {
      if (this.match(TokenType.LET)) {
        this.expect(TokenType.LET);
        const name = this.expect(TokenType.IDENTIFIER).value;
        let value = null;
        if (this.match(TokenType.ASSIGN)) {
          this.expect(TokenType.ASSIGN);
          value = this.parseExpression();
        }
        init = new LetDeclaration(name, value, line, column);
      } else {
        init = this.parseExpression();
      }
    }
    this.expect(TokenType.SEMICOLON);

    // 조건
    let condition = null;
    if (!this.match(TokenType.SEMICOLON)) {
      condition = this.parseExpression();
    }
    this.expect(TokenType.SEMICOLON);

    // 업데이트
    let update = null;
    if (!this.match(TokenType.RPAREN)) {
      update = this.parseExpression();
    }
    this.expect(TokenType.RPAREN);

    this.expect(TokenType.LBRACE);
    const body = this.parseBlockBody();
    this.expect(TokenType.RBRACE);

    return new ForStatement(init, condition, update, body, line, column);
  }

  parseReturnStatement() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    this.expect(TokenType.RETURN);

    let value = null;
    if (!this.match(TokenType.SEMICOLON, TokenType.RBRACE, TokenType.EOF)) {
      value = this.parseExpression();
    }

    if (this.match(TokenType.SEMICOLON)) {
      this.expect(TokenType.SEMICOLON);
    }

    return new ReturnStatement(value, line, column);
  }

  parseBlockStatement() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    this.expect(TokenType.LBRACE);
    const statements = this.parseBlockBody();
    this.expect(TokenType.RBRACE);

    return new BlockStatement(statements, line, column);
  }

  parseBlockBody() {
    const statements = [];
    while (!this.match(TokenType.RBRACE, TokenType.EOF)) {
      statements.push(this.parseStatement());
    }
    return statements;
  }

  parseExpressionStatement() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    const expr = this.parseExpression();

    if (this.match(TokenType.SEMICOLON)) {
      this.expect(TokenType.SEMICOLON);
    }

    return new ExpressionStatement(expr, line, column);
  }

  parseExpression() {
    return this.parseAssignment();
  }

  parseAssignment() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    let expr = this.parseLogicalOr();

    if (this.match(TokenType.ASSIGN)) {
      this.expect(TokenType.ASSIGN);
      const value = this.parseAssignment();
      return new Assignment(expr, value, line, column);
    }

    return expr;
  }

  parseLogicalOr() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    let expr = this.parseLogicalAnd();

    while (this.match(TokenType.OR)) {
      const operator = this.currentToken().value;
      this.advance();
      const right = this.parseLogicalAnd();
      expr = new BinaryOp(expr, operator, right, line, column);
    }

    return expr;
  }

  parseLogicalAnd() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    let expr = this.parseEquality();

    while (this.match(TokenType.AND)) {
      const operator = this.currentToken().value;
      this.advance();
      const right = this.parseEquality();
      expr = new BinaryOp(expr, operator, right, line, column);
    }

    return expr;
  }

  parseEquality() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    let expr = this.parseComparison();

    while (this.match(TokenType.EQUAL, TokenType.NOT_EQUAL)) {
      const operator = this.currentToken().value;
      this.advance();
      const right = this.parseComparison();
      expr = new BinaryOp(expr, operator, right, line, column);
    }

    return expr;
  }

  parseComparison() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    let expr = this.parseAdditive();

    while (this.match(TokenType.LESS, TokenType.LESS_EQUAL, TokenType.GREATER, TokenType.GREATER_EQUAL)) {
      const operator = this.currentToken().value;
      this.advance();
      const right = this.parseAdditive();
      expr = new BinaryOp(expr, operator, right, line, column);
    }

    return expr;
  }

  parseAdditive() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    let expr = this.parseMultiplicative();

    while (this.match(TokenType.PLUS, TokenType.MINUS)) {
      const operator = this.currentToken().value;
      this.advance();
      const right = this.parseMultiplicative();
      expr = new BinaryOp(expr, operator, right, line, column);
    }

    return expr;
  }

  parseMultiplicative() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    let expr = this.parseUnary();

    while (this.match(TokenType.MULTIPLY, TokenType.DIVIDE, TokenType.MODULO)) {
      const operator = this.currentToken().value;
      this.advance();
      const right = this.parseUnary();
      expr = new BinaryOp(expr, operator, right, line, column);
    }

    return expr;
  }

  parseUnary() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;

    if (this.match(TokenType.NOT, TokenType.MINUS)) {
      const operator = this.currentToken().value;
      this.advance();
      const operand = this.parseUnary();
      return new UnaryOp(operator, operand, line, column);
    }

    return this.parsePostfix();
  }

  parsePostfix() {
    let expr = this.parsePrimary();

    while (true) {
      if (this.match(TokenType.LPAREN)) {
        // 함수 호출
        const line = this.currentToken().line;
        const column = this.currentToken().column;
        this.expect(TokenType.LPAREN);

        const args = [];
        while (!this.match(TokenType.RPAREN)) {
          args.push(this.parseExpression());
          if (this.match(TokenType.COMMA)) {
            this.expect(TokenType.COMMA);
          }
        }
        this.expect(TokenType.RPAREN);

        if (expr instanceof Identifier) {
          expr = new FunctionCall(expr.name, args, line, column);
        } else {
          throw new Error('Only identifiers can be called as functions');
        }
      } else if (this.match(TokenType.LBRACKET)) {
        // 배열 인덱싱
        const line = this.currentToken().line;
        const column = this.currentToken().column;
        this.expect(TokenType.LBRACKET);
        const index = this.parseExpression();
        this.expect(TokenType.RBRACKET);
        expr = new IndexAccess(expr, index, line, column);
      } else if (this.match(TokenType.DOT)) {
        // 멤버 접근
        const line = this.currentToken().line;
        const column = this.currentToken().column;
        this.expect(TokenType.DOT);
        const member = this.expect(TokenType.IDENTIFIER).value;
        expr = new MemberAccess(expr, member, line, column);
      } else {
        break;
      }
    }

    return expr;
  }

  parsePrimary() {
    const line = this.currentToken().line;
    const column = this.currentToken().column;
    const token = this.currentToken();

    // 숫자
    if (token.type === TokenType.NUMBER) {
      this.advance();
      return new NumberLiteral(token.value, line, column);
    }

    // 문자열
    if (token.type === TokenType.STRING) {
      this.advance();
      return new StringLiteral(token.value, line, column);
    }

    // 불린
    if (token.type === TokenType.TRUE) {
      this.advance();
      return new BooleanLiteral(true, line, column);
    }

    if (token.type === TokenType.FALSE) {
      this.advance();
      return new BooleanLiteral(false, line, column);
    }

    // null
    if (token.type === TokenType.NULL) {
      this.advance();
      return new NullLiteral(line, column);
    }

    // 식별자
    if (token.type === TokenType.IDENTIFIER) {
      this.advance();
      return new Identifier(token.value, line, column);
    }

    // 배열
    if (token.type === TokenType.LBRACKET) {
      this.expect(TokenType.LBRACKET);
      const elements = [];
      while (!this.match(TokenType.RBRACKET)) {
        elements.push(this.parseExpression());
        if (this.match(TokenType.COMMA)) {
          this.expect(TokenType.COMMA);
        }
      }
      this.expect(TokenType.RBRACKET);
      return new ArrayLiteral(elements, line, column);
    }

    // 괄호
    if (token.type === TokenType.LPAREN) {
      this.expect(TokenType.LPAREN);
      const expr = this.parseExpression();
      this.expect(TokenType.RPAREN);
      return expr;
    }

    throw new Error(`Unexpected token: ${token.type} at ${line}:${column}`);
  }
}

module.exports = { Parser };
