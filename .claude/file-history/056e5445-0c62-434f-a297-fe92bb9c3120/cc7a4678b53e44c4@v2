/**
 * MiniScript Tokenizer
 * 소스 코드를 토큰으로 변환
 */

class TokenType {
  // 리터럴
  static NUMBER = 'NUMBER';
  static STRING = 'STRING';
  static IDENTIFIER = 'IDENTIFIER';

  // 키워드
  static LET = 'LET';
  static CONST = 'CONST';
  static FN = 'FN';
  static IF = 'IF';
  static ELSE = 'ELSE';
  static FOR = 'FOR';
  static WHILE = 'WHILE';
  static RETURN = 'RETURN';
  static TRUE = 'TRUE';
  static FALSE = 'FALSE';
  static NULL = 'NULL';

  // 연산자
  static PLUS = 'PLUS';
  static MINUS = 'MINUS';
  static MULTIPLY = 'MULTIPLY';
  static DIVIDE = 'DIVIDE';
  static MODULO = 'MODULO';
  static ASSIGN = 'ASSIGN';
  static EQUAL = 'EQUAL';
  static NOT_EQUAL = 'NOT_EQUAL';
  static LESS = 'LESS';
  static LESS_EQUAL = 'LESS_EQUAL';
  static GREATER = 'GREATER';
  static GREATER_EQUAL = 'GREATER_EQUAL';
  static AND = 'AND';
  static OR = 'OR';
  static NOT = 'NOT';

  // 구분자
  static LPAREN = 'LPAREN';
  static RPAREN = 'RPAREN';
  static LBRACE = 'LBRACE';
  static RBRACE = 'RBRACE';
  static LBRACKET = 'LBRACKET';
  static RBRACKET = 'RBRACKET';
  static SEMICOLON = 'SEMICOLON';
  static COMMA = 'COMMA';
  static DOT = 'DOT';
  static COLON = 'COLON';

  // 특수
  static EOF = 'EOF';
}

class Token {
  constructor(type, value, line, column) {
    this.type = type;
    this.value = value;
    this.line = line;
    this.column = column;
  }

  toString() {
    return `Token(${this.type}, ${this.value}, ${this.line}:${this.column})`;
  }
}

class Tokenizer {
  constructor(source) {
    this.source = source;
    this.position = 0;
    this.line = 1;
    this.column = 1;
    this.tokens = [];
  }

  keywords = {
    'let': TokenType.LET,
    'const': TokenType.CONST,
    'fn': TokenType.FN,
    'if': TokenType.IF,
    'else': TokenType.ELSE,
    'for': TokenType.FOR,
    'while': TokenType.WHILE,
    'return': TokenType.RETURN,
    'true': TokenType.TRUE,
    'false': TokenType.FALSE,
    'null': TokenType.NULL,
  };

  currentChar() {
    if (this.position >= this.source.length) return null;
    return this.source[this.position];
  }

  peekChar(offset = 1) {
    const pos = this.position + offset;
    if (pos >= this.source.length) return null;
    return this.source[pos];
  }

  advance() {
    if (this.currentChar() === '\n') {
      this.line++;
      this.column = 1;
    } else {
      this.column++;
    }
    this.position++;
  }

  skipWhitespace() {
    while (this.currentChar() && /\s/.test(this.currentChar())) {
      this.advance();
    }
  }

  skipComment() {
    // 라인 주석
    if (this.currentChar() === '/' && this.peekChar() === '/') {
      while (this.currentChar() && this.currentChar() !== '\n') {
        this.advance();
      }
      this.advance(); // \n 건너뛰기
      return true;
    }

    // 블록 주석
    if (this.currentChar() === '/' && this.peekChar() === '*') {
      this.advance(); // /
      this.advance(); // *
      while (this.currentChar()) {
        if (this.currentChar() === '*' && this.peekChar() === '/') {
          this.advance(); // *
          this.advance(); // /
          return true;
        }
        this.advance();
      }
      return true;
    }

    return false;
  }

  readNumber() {
    const startPos = this.position;
    const startCol = this.column;

    while (this.currentChar() && /\d/.test(this.currentChar())) {
      this.advance();
    }

    // 부동소수점
    if (this.currentChar() === '.' && /\d/.test(this.peekChar())) {
      this.advance();
      while (this.currentChar() && /\d/.test(this.currentChar())) {
        this.advance();
      }
    }

    const value = this.source.substring(startPos, this.position);
    return new Token(TokenType.NUMBER, parseFloat(value), this.line, startCol);
  }

  readString(quote) {
    const startCol = this.column;
    this.advance(); // 따옴표 건너뛰기
    let value = '';

    while (this.currentChar() && this.currentChar() !== quote) {
      if (this.currentChar() === '\\') {
        this.advance();
        const escaped = this.currentChar();
        switch (escaped) {
          case 'n': value += '\n'; break;
          case 't': value += '\t'; break;
          case '\\': value += '\\'; break;
          case quote: value += quote; break;
          default: value += escaped;
        }
        this.advance();
      } else {
        value += this.currentChar();
        this.advance();
      }
    }

    if (this.currentChar() === quote) {
      this.advance();
    }

    return new Token(TokenType.STRING, value, this.line, startCol);
  }

  readIdentifier() {
    const startPos = this.position;
    const startCol = this.column;

    while (this.currentChar() && /[a-zA-Z0-9_]/.test(this.currentChar())) {
      this.advance();
    }

    const value = this.source.substring(startPos, this.position);
    const type = this.keywords[value] || TokenType.IDENTIFIER;

    return new Token(type, value, this.line, startCol);
  }

  tokenize() {
    while (this.position < this.source.length) {
      this.skipWhitespace();

      if (this.position >= this.source.length) break;

      // 주석
      if (this.skipComment()) {
        continue;
      }

      const char = this.currentChar();
      const col = this.column;

      // 숫자
      if (/\d/.test(char)) {
        this.tokens.push(this.readNumber());
        continue;
      }

      // 문자열
      if (char === '"' || char === "'") {
        this.tokens.push(this.readString(char));
        continue;
      }

      // 식별자 & 키워드
      if (/[a-zA-Z_]/.test(char)) {
        this.tokens.push(this.readIdentifier());
        continue;
      }

      // 연산자 & 구분자
      if (char === '+') {
        this.tokens.push(new Token(TokenType.PLUS, '+', this.line, col));
        this.advance();
      } else if (char === '-') {
        this.tokens.push(new Token(TokenType.MINUS, '-', this.line, col));
        this.advance();
      } else if (char === '*') {
        this.tokens.push(new Token(TokenType.MULTIPLY, '*', this.line, col));
        this.advance();
      } else if (char === '/') {
        this.tokens.push(new Token(TokenType.DIVIDE, '/', this.line, col));
        this.advance();
      } else if (char === '%') {
        this.tokens.push(new Token(TokenType.MODULO, '%', this.line, col));
        this.advance();
      } else if (char === '=') {
        if (this.peekChar() === '=') {
          this.tokens.push(new Token(TokenType.EQUAL, '==', this.line, col));
          this.advance();
          this.advance();
        } else {
          this.tokens.push(new Token(TokenType.ASSIGN, '=', this.line, col));
          this.advance();
        }
      } else if (char === '!') {
        if (this.peekChar() === '=') {
          this.tokens.push(new Token(TokenType.NOT_EQUAL, '!=', this.line, col));
          this.advance();
          this.advance();
        } else {
          this.tokens.push(new Token(TokenType.NOT, '!', this.line, col));
          this.advance();
        }
      } else if (char === '<') {
        if (this.peekChar() === '=') {
          this.tokens.push(new Token(TokenType.LESS_EQUAL, '<=', this.line, col));
          this.advance();
          this.advance();
        } else {
          this.tokens.push(new Token(TokenType.LESS, '<', this.line, col));
          this.advance();
        }
      } else if (char === '>') {
        if (this.peekChar() === '=') {
          this.tokens.push(new Token(TokenType.GREATER_EQUAL, '>=', this.line, col));
          this.advance();
          this.advance();
        } else {
          this.tokens.push(new Token(TokenType.GREATER, '>', this.line, col));
          this.advance();
        }
      } else if (char === '&' && this.peekChar() === '&') {
        this.tokens.push(new Token(TokenType.AND, '&&', this.line, col));
        this.advance();
        this.advance();
      } else if (char === '|' && this.peekChar() === '|') {
        this.tokens.push(new Token(TokenType.OR, '||', this.line, col));
        this.advance();
        this.advance();
      } else if (char === '(') {
        this.tokens.push(new Token(TokenType.LPAREN, '(', this.line, col));
        this.advance();
      } else if (char === ')') {
        this.tokens.push(new Token(TokenType.RPAREN, ')', this.line, col));
        this.advance();
      } else if (char === '{') {
        this.tokens.push(new Token(TokenType.LBRACE, '{', this.line, col));
        this.advance();
      } else if (char === '}') {
        this.tokens.push(new Token(TokenType.RBRACE, '}', this.line, col));
        this.advance();
      } else if (char === '[') {
        this.tokens.push(new Token(TokenType.LBRACKET, '[', this.line, col));
        this.advance();
      } else if (char === ']') {
        this.tokens.push(new Token(TokenType.RBRACKET, ']', this.line, col));
        this.advance();
      } else if (char === ';') {
        this.tokens.push(new Token(TokenType.SEMICOLON, ';', this.line, col));
        this.advance();
      } else if (char === ',') {
        this.tokens.push(new Token(TokenType.COMMA, ',', this.line, col));
        this.advance();
      } else if (char === '.') {
        this.tokens.push(new Token(TokenType.DOT, '.', this.line, col));
        this.advance();
      } else if (char === ':') {
        this.tokens.push(new Token(TokenType.COLON, ':', this.line, col));
        this.advance();
      } else {
        throw new Error(`Unknown character: ${char} at ${this.line}:${col}`);
      }
    }

    this.tokens.push(new Token(TokenType.EOF, null, this.line, this.column));
    return this.tokens;
  }
}

module.exports = { Tokenizer, Token, TokenType };
