"""
Lexer 테스트 스위트

Phase 2.1 Lexer 구현 검증
"""

include("../src/lexer.jl")

# ======================== 테스트 유틸리티 ========================

"""테스트 결과 출력"""
function test_case(name::String, condition::Bool)
    if condition
        println("✅ $name")
        return true
    else
        println("❌ $name")
        return false
    end
end

# ======================== 테스트 1: 정수 토큰화 ========================

function test_integer_tokenization()
    println("\n--- Test 1: Integer Tokenization ---")
    tokens = tokenize("42")
    test_case("Single integer", length(tokens) == 2 && tokens[1].type == INTEGER && tokens[1].value == "42")

    tokens = tokenize("123 456")
    test_case("Multiple integers",
        length(tokens) == 3 &&
        tokens[1].type == INTEGER && tokens[1].value == "123" &&
        tokens[2].type == INTEGER && tokens[2].value == "456"
    )

    tokens = tokenize("0 1 99")
    test_case("Various integers",
        tokens[1].value == "0" && tokens[2].value == "1" && tokens[3].value == "99"
    )
end

# ======================== 테스트 2: 실수 토큰화 ========================

function test_float_tokenization()
    println("\n--- Test 2: Float Tokenization ---")
    tokens = tokenize("3.14")
    test_case("Simple float", length(tokens) == 2 && tokens[1].type == FLOAT && tokens[1].value == "3.14")

    tokens = tokenize("1.0 2.5")
    test_case("Multiple floats",
        tokens[1].type == FLOAT && tokens[1].value == "1.0" &&
        tokens[2].type == FLOAT && tokens[2].value == "2.5"
    )

    tokens = tokenize("1.5e-3")
    test_case("Scientific notation", tokens[1].type == FLOAT && tokens[1].value == "1.5e-3")

    tokens = tokenize("2.0E+10")
    test_case("Scientific with E+", tokens[1].type == FLOAT && tokens[1].value == "2.0E+10")
end

# ======================== 테스트 3: 키워드 ========================

function test_keywords()
    println("\n--- Test 3: Keywords ---")
    tokens = tokenize("function")
    test_case("function keyword", tokens[1].type == KW_FUNCTION)

    tokens = tokenize("if else end")
    test_case("if/else/end keywords",
        tokens[1].type == KW_IF &&
        tokens[2].type == KW_ELSE &&
        tokens[3].type == KW_END
    )

    tokens = tokenize("for while return")
    test_case("loop keywords",
        tokens[1].type == KW_FOR &&
        tokens[2].type == KW_WHILE &&
        tokens[3].type == KW_RETURN
    )

    tokens = tokenize("true false nothing")
    test_case("boolean keywords",
        tokens[1].type == KW_TRUE &&
        tokens[2].type == KW_FALSE &&
        tokens[3].type == KW_NOTHING
    )
end

# ======================== 테스트 4: 식별자 ========================

function test_identifiers()
    println("\n--- Test 4: Identifiers ---")
    tokens = tokenize("x")
    test_case("Single character identifier", tokens[1].type == IDENTIFIER && tokens[1].value == "x")

    tokens = tokenize("my_var")
    test_case("Identifier with underscore", tokens[1].type == IDENTIFIER && tokens[1].value == "my_var")

    tokens = tokenize("func?")
    test_case("Identifier with question mark", tokens[1].type == IDENTIFIER && tokens[1].value == "func?")

    tokens = tokenize("func!")
    test_case("Identifier with exclamation", tokens[1].type == IDENTIFIER && tokens[1].value == "func!")
end

# ======================== 테스트 5: 문자열 ========================

function test_strings()
    println("\n--- Test 5: Strings ---")
    tokens = tokenize("\"hello\"")
    test_case("Simple string", tokens[1].type == STRING && tokens[1].value == "hello")

    tokens = tokenize("'world'")
    test_case("Single quote string", tokens[1].type == STRING && tokens[1].value == "world")

    tokens = tokenize("\"hello world\"")
    test_case("String with space", tokens[1].type == STRING && tokens[1].value == "hello world")

    # 이스케이프 시퀀스는 복잡하므로 생략
end

# ======================== 테스트 6: 심볼 ========================

function test_symbols()
    println("\n--- Test 6: Symbols ---")
    tokens = tokenize(":symbol")
    test_case("Simple symbol", tokens[1].type == SYMBOL && tokens[1].value == "symbol")

    tokens = tokenize(":my_sym")
    test_case("Symbol with underscore", tokens[1].type == SYMBOL && tokens[1].value == "my_sym")
end

# ======================== 테스트 7: 연산자 ========================

function test_operators()
    println("\n--- Test 7: Operators ---")
    tokens = tokenize("+ - * / %")
    test_case("Arithmetic operators",
        tokens[1].type == PLUS &&
        tokens[2].type == MINUS &&
        tokens[3].type == STAR &&
        tokens[4].type == SLASH &&
        tokens[5].type == PERCENT
    )

    tokens = tokenize("== != < <= > >=")
    test_case("Comparison operators",
        tokens[1].type == EQ_EQ &&
        tokens[2].type == NOT_EQ &&
        tokens[3].type == LT &&
        tokens[4].type == LE &&
        tokens[5].type == GT &&
        tokens[6].type == GE
    )

    tokens = tokenize("&& ||")
    test_case("Logical operators",
        tokens[1].type == AND_AND &&
        tokens[2].type == OR_OR
    )

    tokens = tokenize("& | ~ << >>")
    test_case("Bitwise operators",
        tokens[1].type == AND &&
        tokens[2].type == OR &&
        tokens[3].type == TILDE &&
        tokens[4].type == LSHIFT &&
        tokens[5].type == RSHIFT
    )
end

# ======================== 테스트 8: 할당 연산자 ========================

function test_assignment_operators()
    println("\n--- Test 8: Assignment Operators ---")
    tokens = tokenize("= += -= *= /=")
    test_case("Assignment operators",
        tokens[1].type == EQ &&
        tokens[2].type == PLUS_EQ &&
        tokens[3].type == MINUS_EQ &&
        tokens[4].type == STAR_EQ &&
        tokens[5].type == SLASH_EQ
    )
end

# ======================== 테스트 9: 구분자 ========================

function test_delimiters()
    println("\n--- Test 9: Delimiters ---")
    tokens = tokenize("( ) [ ] { }")
    test_case("Brackets",
        tokens[1].type == LPAREN &&
        tokens[2].type == RPAREN &&
        tokens[3].type == LBRACKET &&
        tokens[4].type == RBRACKET &&
        tokens[5].type == LBRACE &&
        tokens[6].type == RBRACE
    )

    tokens = tokenize(", ; : ::")
    test_case("Punctuation",
        tokens[1].type == COMMA &&
        tokens[2].type == SEMICOLON &&
        tokens[3].type == COLON &&
        tokens[4].type == DOUBLE_COLON
    )

    tokens = tokenize("-> =>")
    test_case("Arrow operators",
        tokens[1].type == ARROW &&
        tokens[2].type == DOUBLE_ARROW
    )
end

# ======================== 테스트 10: 복잡한 표현식 ========================

function test_complex_expression()
    println("\n--- Test 10: Complex Expression ---")

    code = """
    x = 10
    y = 3.14
    """
    tokens = tokenize(code)

    # x = 10 + NEWLINE + y = 3.14 + NEWLINE + EOF
    test_case("Assignment expression",
        tokens[1].type == IDENTIFIER && tokens[1].value == "x" &&
        tokens[2].type == EQ &&
        tokens[3].type == INTEGER && tokens[3].value == "10" &&
        tokens[4].type == NEWLINE
    )
end

# ======================== 테스트 11: 함수 선언 ========================

function test_function_declaration()
    println("\n--- Test 11: Function Declaration ---")

    code = "function add(x, y)\n    return x + y\nend"
    tokens = tokenize(code)

    test_case("Function keyword detected", tokens[1].type == KW_FUNCTION)
    test_case("Parameter parsing",
        any(t.type == IDENTIFIER && t.value == "x" for t in tokens) &&
        any(t.type == IDENTIFIER && t.value == "y" for t in tokens)
    )
    test_case("Return keyword detected", any(t.type == KW_RETURN for t in tokens))
    test_case("End keyword detected", any(t.type == KW_END for t in tokens))
end

# ======================== 테스트 12: 덧셈 ========================

function test_simple_addition()
    println("\n--- Test 12: Simple Addition ---")

    code = "3 + 4"
    tokens = tokenize(code)

    test_case("Addition expression tokens",
        length(tokens) >= 4 &&
        tokens[1].type == INTEGER && tokens[1].value == "3" &&
        tokens[2].type == PLUS &&
        tokens[3].type == INTEGER && tokens[3].value == "4"
    )
end

# ======================== 테스트 13: 위치 추적 ========================

function test_position_tracking()
    println("\n--- Test 13: Position Tracking ---")

    tokens = tokenize("x = 42")

    test_case("Line tracking",
        tokens[1].pos.line == 1 &&
        tokens[3].pos.line == 1
    )

    code = "x\ny"
    tokens = tokenize(code)
    test_case("Multi-line position",
        any(t.pos.line == 1 && t.value == "x" for t in tokens) &&
        any(t.pos.line == 2 && t.value == "y" for t in tokens)
    )
end

# ======================== 테스트 14: 주석 처리 ========================

function test_comments()
    println("\n--- Test 14: Comments ---")

    code = "x = 10  # this is a comment\ny = 20"
    tokens = tokenize(code)

    # 주석 뒤에 y가 다음 라인에 있는지 확인
    test_case("Comment skipped",
        any(t.type == IDENTIFIER && t.value == "y" for t in tokens) &&
        !any(t.value == "this" for t in tokens)
    )
end

# ======================== 메인 테스트 실행 ========================

function run_all_tests()
    println("=" * 50)
    println("JULIA COMPILER - LEXER TESTS")
    println("Phase 2.1: Tokenizer")
    println("=" * 50)

    test_integer_tokenization()
    test_float_tokenization()
    test_keywords()
    test_identifiers()
    test_strings()
    test_symbols()
    test_operators()
    test_assignment_operators()
    test_delimiters()
    test_complex_expression()
    test_function_declaration()
    test_simple_addition()
    test_position_tracking()
    test_comments()

    println("\n" * "=" * 50)
    println("ALL TESTS COMPLETED")
    println("=" * 50)
end

# 테스트 실행
if abspath(PROGRAM_FILE) == @__FILE__
    run_all_tests()
end
