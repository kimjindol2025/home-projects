// DOM 요소
const codeEditor = document.getElementById('codeEditor');
const output = document.getElementById('output');
const runBtn = document.getElementById('runBtn');
const clearBtn = document.getElementById('clearBtn');
const loadingOverlay = document.getElementById('loadingOverlay');
const exampleBtns = document.querySelectorAll('.example-btn');

// 예제 코드
const examples = {
  hello: `println("=== Hello World ===" );
println("");
println("Welcome to MiniScript!");
println("A simple but powerful language");
println("");
print("Your first output: ");
println("🎉 Success!");`,

  factorial: `fn factorial(n) {
  if (n <= 1) {
    return 1;
  }
  return n * factorial(n - 1);
}

println("=== Factorial Table ===");
for (let i = 1; i <= 10; i = i + 1) {
  let result = factorial(i);
  println(i + "! = " + result);
}`,

  multiplication: `println("=== Multiplication Table (9x9) ===");
println("");

for (let i = 1; i <= 9; i = i + 1) {
  for (let j = 1; j <= 9; j = j + 1) {
    let product = i * j;
    print(product + " ");
  }
  println("");
}`,

  array: `println("=== Array Operations ===");
println("");

let numbers = [1, 2, 3, 4, 5];
println("Original array: [1, 2, 3, 4, 5]");
println("Length: " + length(numbers));

println("");
println("Elements:");
for (let i = 0; i < length(numbers); i = i + 1) {
  println("  [" + i + "] = " + numbers[i]);
}

println("");
println("After push(6):");
push(numbers, 6);
println("New length: " + length(numbers));

println("");
let sum = 0;
for (let i = 0; i < length(numbers); i = i + 1) {
  sum = sum + numbers[i];
}
println("Sum: " + sum);
let average = sum / length(numbers);
println("Average: " + average);`
};

/**
 * API로 코드 실행
 */
async function executeCode() {
  const code = codeEditor.value.trim();

  if (!code) {
    showOutput('코드를 입력해주세요.', 'error');
    return;
  }

  // 로딩 표시
  loadingOverlay.style.display = 'flex';
  output.className = '';

  try {
    const response = await fetch('/api/run', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ code }),
    });

    const data = await response.json();

    if (data.success) {
      showOutput(data.output || '(출력 없음)', 'success');
    } else {
      showOutput('❌ 오류: ' + data.error, 'error');
    }
  } catch (error) {
    showOutput('❌ 서버 오류: ' + error.message, 'error');
  } finally {
    loadingOverlay.style.display = 'none';
  }
}

/**
 * 출력 표시
 */
function showOutput(text, type = '') {
  output.textContent = text;
  output.className = type ? `output ${type}` : 'output';
}

/**
 * 예제 로드
 */
function loadExample(exampleKey) {
  const code = examples[exampleKey];
  if (code) {
    codeEditor.value = code;
    codeEditor.focus();
  }
}

/**
 * 에디터 초기화
 */
function clearEditor() {
  codeEditor.value = '';
  codeEditor.focus();
  showOutput('(출력 영역)', '');
}

/**
 * 키보드 단축키
 */
function setupKeyboardShortcuts() {
  document.addEventListener('keydown', (e) => {
    // Ctrl+Enter (또는 Cmd+Enter on Mac): 실행
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      executeCode();
    }
  });
}

/**
 * 이벤트 리스너 설정
 */
function setupEventListeners() {
  runBtn.addEventListener('click', executeCode);
  clearBtn.addEventListener('click', clearEditor);

  exampleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const example = btn.dataset.example;
      loadExample(example);
    });
  });
}

/**
 * 초기화
 */
function init() {
  setupEventListeners();
  setupKeyboardShortcuts();

  // 기본 환영 메시지
  showOutput('👋 MiniScript 웹 인터프리터에 오신 것을 환영합니다!\n\n' +
    '✨ 팁:\n' +
    '• 왼쪽에 코드를 입력하세요\n' +
    '• ▶ 실행 버튼을 클릭하거나 Ctrl+Enter를 누르세요\n' +
    '• 아래 예제를 클릭하여 샘플 코드를 불러올 수 있습니다\n' +
    '• 🗑 초기화 버튼으로 에디터를 비울 수 있습니다');
}

// DOM이 로드되면 초기화
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}
