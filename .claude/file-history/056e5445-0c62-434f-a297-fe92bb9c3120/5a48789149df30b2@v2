// 배열 처리

println("=== Array Operations ===");

// 배열 생성 및 출력
let numbers = [1, 2, 3, 4, 5];
println("Original array: [1, 2, 3, 4, 5]");
println("Length: " + length(numbers));

// 배열 요소에 접근
println("");
println("Elements:");
for (let i = 0; i < length(numbers); i = i + 1) {
  println("  [" + i + "] = " + numbers[i]);
}

// 배열에 요소 추가
println("");
println("After push(6):");
push(numbers, 6);
println("Length: " + length(numbers));

// 합계 계산
println("");
let sum = 0;
for (let i = 0; i < length(numbers); i = i + 1) {
  sum = sum + numbers[i];
}
println("Sum of array: " + sum);

// 평균 계산
let average = sum / length(numbers);
println("Average: " + average);
