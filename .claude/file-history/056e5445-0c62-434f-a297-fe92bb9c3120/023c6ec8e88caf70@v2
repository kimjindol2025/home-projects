/**
 * MiniScript Interpreter
 * AST를 실행
 */

class ReturnValue extends Error {
  constructor(value) {
    super();
    this.value = value;
  }
}

class BreakException extends Error {}
class ContinueException extends Error {}

class Environment {
  constructor(parent = null) {
    this.parent = parent;
    this.variables = {};
  }

  define(name, value) {
    this.variables[name] = value;
  }

  get(name) {
    if (name in this.variables) {
      return this.variables[name];
    }
    if (this.parent) {
      return this.parent.get(name);
    }
    throw new Error(`Undefined variable: ${name}`);
  }

  set(name, value) {
    if (name in this.variables) {
      this.variables[name] = value;
      return;
    }
    if (this.parent) {
      this.parent.set(name, value);
      return;
    }
    throw new Error(`Undefined variable: ${name}`);
  }

  has(name) {
    if (name in this.variables) {
      return true;
    }
    if (this.parent) {
      return this.parent.has(name);
    }
    return false;
  }
}

class MiniScriptFunction {
  constructor(name, params, body, closure) {
    this.name = name;
    this.params = params;
    this.body = body;
    this.closure = closure;
  }
}

class Interpreter {
  constructor() {
    this.globalEnv = new Environment();
    this.currentEnv = this.globalEnv;
    this.setupBuiltins();
  }

  setupBuiltins() {
    // print 함수
    this.globalEnv.define('print', (...args) => {
      console.log(...args);
      return null;
    });

    // println 함수
    this.globalEnv.define('println', (...args) => {
      console.log(...args);
      return null;
    });

    // length 함수
    this.globalEnv.define('length', (value) => {
      if (typeof value === 'string') return value.length;
      if (Array.isArray(value)) return value.length;
      if (value === null) return 0;
      return 0;
    });

    // type 함수
    this.globalEnv.define('type', (value) => {
      if (value === null) return 'null';
      if (Array.isArray(value)) return 'array';
      if (value instanceof MiniScriptFunction) return 'function';
      return typeof value;
    });

    // parseInt 함수
    this.globalEnv.define('parseInt', (value) => {
      return parseInt(value);
    });

    // parseFloat 함수
    this.globalEnv.define('parseFloat', (value) => {
      return parseFloat(value);
    });

    // toString 함수
    this.globalEnv.define('toString', (value) => {
      if (value === null) return 'null';
      if (value === true) return 'true';
      if (value === false) return 'false';
      return String(value);
    });

    // push 함수
    this.globalEnv.define('push', (array, value) => {
      if (!Array.isArray(array)) {
        throw new Error('push: first argument must be an array');
      }
      array.push(value);
      return array;
    });

    // pop 함수
    this.globalEnv.define('pop', (array) => {
      if (!Array.isArray(array)) {
        throw new Error('pop: argument must be an array');
      }
      return array.pop();
    });

    // join 함수
    this.globalEnv.define('join', (array, separator = ',') => {
      if (!Array.isArray(array)) {
        throw new Error('join: first argument must be an array');
      }
      return array.join(separator);
    });

    // range 함수
    this.globalEnv.define('range', (start, end, step = 1) => {
      const result = [];
      if (step > 0) {
        for (let i = start; i < end; i += step) {
          result.push(i);
        }
      } else if (step < 0) {
        for (let i = start; i > end; i += step) {
          result.push(i);
        }
      }
      return result;
    });
  }

  interpret(ast) {
    try {
      this.execute(ast);
    } catch (error) {
      if (error instanceof ReturnValue) {
        return error.value;
      }
      throw error;
    }
  }

  execute(node) {
    if (!node) return null;

    switch (node.type) {
      case 'Program':
        return this.executeProgram(node);
      case 'LetDeclaration':
        return this.executeLetDeclaration(node);
      case 'ConstDeclaration':
        return this.executeConstDeclaration(node);
      case 'FunctionDeclaration':
        return this.executeFunctionDeclaration(node);
      case 'IfStatement':
        return this.executeIfStatement(node);
      case 'WhileStatement':
        return this.executeWhileStatement(node);
      case 'ForStatement':
        return this.executeForStatement(node);
      case 'ReturnStatement':
        return this.executeReturnStatement(node);
      case 'BlockStatement':
        return this.executeBlockStatement(node);
      case 'ExpressionStatement':
        return this.execute(node.expression);
      default:
        return this.evaluate(node);
    }
  }

  executeProgram(node) {
    let result = null;
    for (const statement of node.statements) {
      result = this.execute(statement);
    }
    return result;
  }

  executeLetDeclaration(node) {
    const value = node.value ? this.evaluate(node.value) : null;
    this.currentEnv.define(node.name, value);
    return null;
  }

  executeConstDeclaration(node) {
    const value = this.evaluate(node.value);
    this.currentEnv.define(node.name, value);
    return null;
  }

  executeFunctionDeclaration(node) {
    const func = new MiniScriptFunction(node.name, node.params, node.body, this.currentEnv);
    this.currentEnv.define(node.name, func);
    return null;
  }

  executeIfStatement(node) {
    const condition = this.evaluate(node.condition);
    if (this.isTruthy(condition)) {
      return this.executeBlock(node.thenBranch);
    } else if (node.elseBranch) {
      return this.executeBlock(node.elseBranch);
    }
    return null;
  }

  executeWhileStatement(node) {
    let result = null;
    while (this.isTruthy(this.evaluate(node.condition))) {
      try {
        result = this.executeBlock(node.body);
      } catch (error) {
        if (error instanceof BreakException) {
          break;
        } else if (error instanceof ContinueException) {
          continue;
        } else {
          throw error;
        }
      }
    }
    return result;
  }

  executeForStatement(node) {
    const loopEnv = new Environment(this.currentEnv);
    const prevEnv = this.currentEnv;
    this.currentEnv = loopEnv;

    try {
      if (node.init) {
        this.execute(node.init);
      }

      let result = null;
      while (!node.condition || this.isTruthy(this.evaluate(node.condition))) {
        try {
          result = this.executeBlock(node.body);
        } catch (error) {
          if (error instanceof BreakException) {
            break;
          } else if (error instanceof ContinueException) {
            // continue
          } else {
            throw error;
          }
        }

        if (node.update) {
          this.evaluate(node.update);
        }
      }

      return result;
    } finally {
      this.currentEnv = prevEnv;
    }
  }

  executeReturnStatement(node) {
    const value = node.value ? this.evaluate(node.value) : null;
    throw new ReturnValue(value);
  }

  executeBlockStatement(node) {
    return this.executeBlockInNewEnv(node.statements);
  }

  executeBlock(statements) {
    let result = null;
    for (const statement of statements) {
      result = this.execute(statement);
    }
    return result;
  }

  executeBlockInNewEnv(statements) {
    const blockEnv = new Environment(this.currentEnv);
    const prevEnv = this.currentEnv;
    this.currentEnv = blockEnv;

    try {
      return this.executeBlock(statements);
    } finally {
      this.currentEnv = prevEnv;
    }
  }

  evaluate(node) {
    if (!node) return null;

    switch (node.type) {
      case 'NumberLiteral':
        return node.value;
      case 'StringLiteral':
        return node.value;
      case 'BooleanLiteral':
        return node.value;
      case 'NullLiteral':
        return null;
      case 'Identifier':
        return this.currentEnv.get(node.name);
      case 'BinaryOp':
        return this.evaluateBinaryOp(node);
      case 'UnaryOp':
        return this.evaluateUnaryOp(node);
      case 'Assignment':
        return this.evaluateAssignment(node);
      case 'FunctionCall':
        return this.evaluateFunctionCall(node);
      case 'ArrayLiteral':
        return node.elements.map(elem => this.evaluate(elem));
      case 'IndexAccess':
        return this.evaluateIndexAccess(node);
      case 'MemberAccess':
        return this.evaluateMemberAccess(node);
      default:
        throw new Error(`Unknown expression type: ${node.type}`);
    }
  }

  evaluateBinaryOp(node) {
    const left = this.evaluate(node.left);
    const right = this.evaluate(node.right);

    switch (node.operator) {
      case '+':
        if (typeof left === 'string' || typeof right === 'string') {
          return String(left) + String(right);
        }
        return left + right;
      case '-': return left - right;
      case '*': return left * right;
      case '/': return left / right;
      case '%': return left % right;
      case '==': return left === right;
      case '!=': return left !== right;
      case '<': return left < right;
      case '<=': return left <= right;
      case '>': return left > right;
      case '>=': return left >= right;
      case '&&': return left && right;
      case '||': return left || right;
      default:
        throw new Error(`Unknown operator: ${node.operator}`);
    }
  }

  evaluateUnaryOp(node) {
    const operand = this.evaluate(node.operand);

    switch (node.operator) {
      case '!': return !this.isTruthy(operand);
      case '-': return -operand;
      default:
        throw new Error(`Unknown unary operator: ${node.operator}`);
    }
  }

  evaluateAssignment(node) {
    const value = this.evaluate(node.value);

    if (node.target.type === 'Identifier') {
      if (!this.currentEnv.has(node.target.name)) {
        throw new Error(`Undefined variable: ${node.target.name}`);
      }
      this.currentEnv.set(node.target.name, value);
    } else if (node.target.type === 'IndexAccess') {
      const array = this.evaluate(node.target.array);
      const index = this.evaluate(node.target.index);
      if (Array.isArray(array)) {
        array[index] = value;
      } else {
        throw new Error('Cannot index non-array');
      }
    } else {
      throw new Error('Invalid assignment target');
    }

    return value;
  }

  evaluateFunctionCall(node) {
    const func = this.currentEnv.get(node.name);
    const args = node.args.map(arg => this.evaluate(arg));

    if (typeof func === 'function') {
      // 내장 함수
      return func(...args);
    } else if (func instanceof MiniScriptFunction) {
      // 사용자 정의 함수
      return this.callUserFunction(func, args);
    } else {
      throw new Error(`${node.name} is not a function`);
    }
  }

  callUserFunction(func, args) {
    const funcEnv = new Environment(func.closure);

    // 파라미터 바인딩
    for (let i = 0; i < func.params.length; i++) {
      funcEnv.define(func.params[i], args[i] || null);
    }

    const prevEnv = this.currentEnv;
    this.currentEnv = funcEnv;

    try {
      this.executeBlock(func.body);
      return null; // 명시적 return이 없으면 null 반환
    } catch (error) {
      if (error instanceof ReturnValue) {
        return error.value;
      }
      throw error;
    } finally {
      this.currentEnv = prevEnv;
    }
  }

  evaluateIndexAccess(node) {
    const array = this.evaluate(node.array);
    const index = this.evaluate(node.index);

    if (Array.isArray(array)) {
      return array[index];
    } else if (typeof array === 'string') {
      return array[index];
    } else {
      throw new Error('Cannot index non-indexable value');
    }
  }

  evaluateMemberAccess(node) {
    const object = this.evaluate(node.object);

    if (object === null || object === undefined) {
      throw new Error('Cannot access member of null or undefined');
    }

    return object[node.member];
  }

  isTruthy(value) {
    if (value === null || value === false) return false;
    if (value === 0 || value === '') return false;
    if (value === undefined) return false;
    return true;
  }
}

module.exports = { Interpreter };
