/**
 * MiniScript 테스트
 */

const { Tokenizer } = require('./tokenizer');
const { Parser } = require('./parser');
const { Interpreter } = require('./interpreter');

function test(name, code, expectedOutput = null) {
  console.log(`Testing: ${name}`);
  try {
    const tokenizer = new Tokenizer(code);
    const tokens = tokenizer.tokenize();

    const parser = new Parser(tokens);
    const ast = parser.parse();

    const interpreter = new Interpreter();

    // 출력 캡처
    const originalLog = console.log;
    let output = '';
    console.log = (...args) => {
      output += args.join(' ') + '\n';
    };

    try {
      interpreter.interpret(ast);
      console.log = originalLog;

      if (expectedOutput && output.trim() !== expectedOutput.trim()) {
        console.log(`  ❌ FAIL: Expected "${expectedOutput}", got "${output}"`);
      } else {
        console.log(`  ✅ PASS`);
      }
    } finally {
      console.log = originalLog;
    }
  } catch (error) {
    console.log(`  ❌ ERROR: ${error.message}`);
  }
  console.log('');
}

// 테스트 실행
console.log('=== MiniScript Test Suite ===\n');

// 1. 기본 산술
test('Basic Arithmetic', `
let x = 5;
let y = 3;
println(x + y);
`, '8');

test('Multiplication', `
println(4 * 5);
`, '20');

test('Modulo', `
println(17 % 5);
`, '2');

// 2. 문자열
test('String Concatenation', `
let name = "MiniScript";
println("Hello, " + name);
`, 'Hello, MiniScript');

// 3. 조건문
test('If Statement', `
let x = 10;
if (x > 5) {
  println("x is greater than 5");
}
`, 'x is greater than 5');

test('If-Else Statement', `
let x = 3;
if (x > 5) {
  println("big");
} else {
  println("small");
}
`, 'small');

// 4. 루프
test('For Loop', `
for (let i = 0; i < 3; i = i + 1) {
  println(i);
}
`, '0\n1\n2');

test('While Loop', `
let i = 0;
while (i < 3) {
  println(i);
  i = i + 1;
}
`, '0\n1\n2');

// 5. 함수
test('Function Declaration', `
fn add(a, b) {
  return a + b;
}
println(add(3, 4));
`, '7');

test('Recursive Function', `
fn factorial(n) {
  if (n <= 1) {
    return 1;
  }
  return n * factorial(n - 1);
}
println(factorial(5));
`, '120');

// 6. 배열
test('Array Creation', `
let arr = [1, 2, 3];
println(arr[0]);
println(arr[1]);
println(arr[2]);
`, '1\n2\n3');

test('Array Length', `
let arr = [10, 20, 30];
println(length(arr));
`, '3');

// 7. 내장 함수
test('Built-in Functions', `
println(length("hello"));
println(type(42));
println(type("text"));
println(type(true));
`, '5\nnumber\nstring\nboolean');

// 8. 논리 연산
test('Logical AND', `
if (true && true) {
  println("yes");
}
`, 'yes');

test('Logical OR', `
if (false || true) {
  println("yes");
}
`, 'yes');

test('NOT Operator', `
if (!false) {
  println("yes");
}
`, 'yes');

// 9. 변수 할당
test('Variable Assignment', `
let x = 10;
x = 20;
println(x);
`, '20');

// 10. 복잡한 예제
test('Fibonacci', `
fn fib(n) {
  if (n <= 1) {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}
println(fib(6));
`, '8');

// 결과 요약
console.log('=== Test Complete ===');
