/**
 * MiniScript AST (Abstract Syntax Tree) Node 정의
 */

class ASTNode {
  constructor(type, line = 0, column = 0) {
    this.type = type;
    this.line = line;
    this.column = column;
  }
}

// 프로그램
class Program extends ASTNode {
  constructor(statements) {
    super('Program');
    this.statements = statements;
  }
}

// 문장
class Statement extends ASTNode {}

class LetDeclaration extends Statement {
  constructor(name, value, line, column) {
    super('LetDeclaration', line, column);
    this.name = name;
    this.value = value;
  }
}

class ConstDeclaration extends Statement {
  constructor(name, value, line, column) {
    super('ConstDeclaration', line, column);
    this.name = name;
    this.value = value;
  }
}

class FunctionDeclaration extends Statement {
  constructor(name, params, body, line, column) {
    super('FunctionDeclaration', line, column);
    this.name = name;
    this.params = params;
    this.body = body;
  }
}

class IfStatement extends Statement {
  constructor(condition, thenBranch, elseBranch, line, column) {
    super('IfStatement', line, column);
    this.condition = condition;
    this.thenBranch = thenBranch;
    this.elseBranch = elseBranch;
  }
}

class WhileStatement extends Statement {
  constructor(condition, body, line, column) {
    super('WhileStatement', line, column);
    this.condition = condition;
    this.body = body;
  }
}

class ForStatement extends Statement {
  constructor(init, condition, update, body, line, column) {
    super('ForStatement', line, column);
    this.init = init;
    this.condition = condition;
    this.update = update;
    this.body = body;
  }
}

class ReturnStatement extends Statement {
  constructor(value, line, column) {
    super('ReturnStatement', line, column);
    this.value = value;
  }
}

class BlockStatement extends Statement {
  constructor(statements, line, column) {
    super('BlockStatement', line, column);
    this.statements = statements;
  }
}

class ExpressionStatement extends Statement {
  constructor(expression, line, column) {
    super('ExpressionStatement', line, column);
    this.expression = expression;
  }
}

// 표현식
class Expression extends ASTNode {}

class NumberLiteral extends Expression {
  constructor(value, line, column) {
    super('NumberLiteral', line, column);
    this.value = value;
  }
}

class StringLiteral extends Expression {
  constructor(value, line, column) {
    super('StringLiteral', line, column);
    this.value = value;
  }
}

class BooleanLiteral extends Expression {
  constructor(value, line, column) {
    super('BooleanLiteral', line, column);
    this.value = value;
  }
}

class NullLiteral extends Expression {
  constructor(line, column) {
    super('NullLiteral', line, column);
  }
}

class Identifier extends Expression {
  constructor(name, line, column) {
    super('Identifier', line, column);
    this.name = name;
  }
}

class BinaryOp extends Expression {
  constructor(left, operator, right, line, column) {
    super('BinaryOp', line, column);
    this.left = left;
    this.operator = operator;
    this.right = right;
  }
}

class UnaryOp extends Expression {
  constructor(operator, operand, line, column) {
    super('UnaryOp', line, column);
    this.operator = operator;
    this.operand = operand;
  }
}

class Assignment extends Expression {
  constructor(target, value, line, column) {
    super('Assignment', line, column);
    this.target = target;
    this.value = value;
  }
}

class FunctionCall extends Expression {
  constructor(name, args, line, column) {
    super('FunctionCall', line, column);
    this.name = name;
    this.args = args;
  }
}

class ArrayLiteral extends Expression {
  constructor(elements, line, column) {
    super('ArrayLiteral', line, column);
    this.elements = elements;
  }
}

class IndexAccess extends Expression {
  constructor(array, index, line, column) {
    super('IndexAccess', line, column);
    this.array = array;
    this.index = index;
  }
}

class MemberAccess extends Expression {
  constructor(object, member, line, column) {
    super('MemberAccess', line, column);
    this.object = object;
    this.member = member;
  }
}

module.exports = {
  ASTNode,
  Program,
  Statement,
  LetDeclaration,
  ConstDeclaration,
  FunctionDeclaration,
  IfStatement,
  WhileStatement,
  ForStatement,
  ReturnStatement,
  BlockStatement,
  ExpressionStatement,
  Expression,
  NumberLiteral,
  StringLiteral,
  BooleanLiteral,
  NullLiteral,
  Identifier,
  BinaryOp,
  UnaryOp,
  Assignment,
  FunctionCall,
  ArrayLiteral,
  IndexAccess,
  MemberAccess,
};
