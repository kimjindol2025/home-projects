* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #333;
  line-height: 1.6;
  min-height: 100vh;
}

.container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 20px;
}

/* 헤더 */
.header {
  text-align: center;
  color: white;
  margin-bottom: 30px;
  animation: slideDown 0.6s ease-out;
}

.header h1 {
  font-size: 3em;
  margin-bottom: 10px;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
}

.header p {
  font-size: 1.2em;
  opacity: 0.95;
}

/* 메인 컨텐츠 */
.main {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 40px;
  animation: fadeIn 0.8s ease-out;
}

/* 에디터 섹션 */
.editor-section {
  background: white;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
  flex-wrap: wrap;
  gap: 10px;
}

.section-header h2 {
  font-size: 1.3em;
  color: #667eea;
}

.button-group {
  display: flex;
  gap: 10px;
}

.btn {
  padding: 10px 20px;
  border: none;
  border-radius: 6px;
  font-size: 0.95em;
  cursor: pointer;
  transition: all 0.3s ease;
  font-weight: 500;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
}

.btn-secondary {
  background: #f5f5f5;
  color: #333;
  border: 1px solid #ddd;
}

.btn-secondary:hover {
  background: #efefef;
}

.code-editor {
  flex: 1;
  padding: 15px;
  border: 2px solid #e0e0e0;
  border-radius: 8px;
  font-family: 'Monaco', 'Courier New', monospace;
  font-size: 0.95em;
  line-height: 1.6;
  resize: none;
  transition: border-color 0.3s ease;
}

.code-editor:focus {
  outline: none;
  border-color: #667eea;
}

/* 결과 섹션 */
.output-section {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.result-panel,
.examples-panel {
  background: white;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

.result-panel {
  flex: 1;
  min-height: 300px;
  display: flex;
  flex-direction: column;
}

.output {
  flex: 1;
  padding: 15px;
  background: #f8f9fa;
  border-radius: 8px;
  border: 1px solid #e0e0e0;
  font-family: 'Monaco', 'Courier New', monospace;
  font-size: 0.9em;
  line-height: 1.6;
  overflow-y: auto;
  max-height: 350px;
  white-space: pre-wrap;
  word-wrap: break-word;
  color: #2d3748;
}

.output.error {
  background: #fef5f5;
  border-color: #fc8181;
  color: #c53030;
}

.output.success {
  background: #f0fdf4;
  border-color: #86efac;
  color: #15803d;
}

/* 예제 버튼 */
.examples {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.example-btn {
  padding: 12px 16px;
  background: #f0f4ff;
  border: 2px solid #667eea;
  border-radius: 8px;
  color: #667eea;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
  text-align: center;
}

.example-btn:hover {
  background: #667eea;
  color: white;
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
}

/* 기능 소개 */
.features {
  background: white;
  border-radius: 12px;
  padding: 40px;
  margin-bottom: 30px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  animation: fadeIn 1s ease-out;
}

.features h2 {
  font-size: 2em;
  margin-bottom: 30px;
  color: #667eea;
  text-align: center;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 30px;
}

.feature {
  padding: 25px;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  border-radius: 10px;
  text-align: center;
  transition: transform 0.3s ease;
}

.feature:hover {
  transform: translateY(-5px);
}

.feature h3 {
  margin-bottom: 15px;
  color: #667eea;
  font-size: 1.2em;
}

.feature code {
  background: white;
  padding: 10px;
  border-radius: 6px;
  display: block;
  font-size: 0.85em;
  line-height: 1.5;
  text-align: left;
  border: 1px solid #e0e0e0;
}

/* 문법 가이드 */
.syntax-guide {
  background: white;
  border-radius: 12px;
  padding: 40px;
  margin-bottom: 30px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  animation: fadeIn 1.2s ease-out;
}

.syntax-guide h2 {
  font-size: 2em;
  margin-bottom: 30px;
  color: #667eea;
  text-align: center;
}

.guide-content {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 25px;
}

.guide-item {
  padding: 20px;
  background: #f8f9fa;
  border-left: 4px solid #667eea;
  border-radius: 8px;
}

.guide-item h4 {
  margin-bottom: 12px;
  color: #667eea;
  font-size: 1.1em;
}

.guide-item code {
  background: white;
  padding: 10px;
  border-radius: 4px;
  display: block;
  font-size: 0.85em;
  line-height: 1.6;
  overflow-x: auto;
  border: 1px solid #e0e0e0;
}

/* 푸터 */
.footer {
  text-align: center;
  color: white;
  padding: 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
}

/* 로딩 오버레이 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.spinner {
  width: 50px;
  height: 50px;
  border: 4px solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

/* 애니메이션 */
@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 반응형 디자인 */
@media (max-width: 1024px) {
  .main {
    grid-template-columns: 1fr;
  }

  .features-grid,
  .guide-content {
    grid-template-columns: 1fr;
  }

  .section-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .button-group {
    width: 100%;
  }

  .btn {
    flex: 1;
  }
}

@media (max-width: 768px) {
  .header h1 {
    font-size: 2em;
  }

  .features,
  .syntax-guide {
    padding: 20px;
  }

  .examples {
    grid-template-columns: 1fr;
  }

  .container {
    padding: 10px;
  }
}
