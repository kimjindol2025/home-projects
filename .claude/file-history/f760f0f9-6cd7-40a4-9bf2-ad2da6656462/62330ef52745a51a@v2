# Test Lexer Phase 1 Only
# Goal: Verify tokenization works on hello.fl

println("╔════════════════════════════════════════════════════════════════╗")
println("║  🧪 Phase 1 Lexer Test (hello.fl)                            ║")
println("╚════════════════════════════════════════════════════════════════╝")
println("")

# hello.fl 소스
let hello_source = `fn hello
input name: string
output string
intent "인사말 함수"
  return "Hello, " + name
`

println("📝 Source Code:")
println(hello_source)
println("")

# 렉서 테스트
println("═══ Tokenization ═══")
let tokens = tokenize(hello_source)
println("✅ Tokens generated: " + str(array_length(tokens)))
println("")

# 각 토큰 출력
println("═══ Token Details ═══")
let i = 0
let len = array_length(tokens)
while i < len {
  let token = tokens[i]
  let tok_type = token["type"]
  let tok_value = token["value"]
  println("  [" + str(i) + "] " + tok_type + " : " + tok_value)
  i = i + 1
}

println("")
println("✅ Lexer Test Complete!")
