/**
 * Phase 2 Parser Test - Tokenization + Parsing
 * Goal: Test parse() function on hello.fl source
 */

import { Compiler, Parser, Lexer } from './src/compiler/compiler';

// Test sources
const helloFlSource = `fn hello
input name: string
output string
intent "인사말 함수"
  return "Hello, " + name
`;

const arithmeticFlSource = `fn add
input a: number
input b: number
output number
  return a + b

fn multiply
input x: number
input y: number
output number
  return x * y
`;

function runPhase2Test() {
  console.log('╔════════════════════════════════════════════════════════════════╗');
  console.log('║  🧪 Phase 2 Parser Test (Lexer + Parser)                     ║');
  console.log('╚════════════════════════════════════════════════════════════════╝');
  console.log('');

  try {
    console.log('═══ Test 1: hello.fl ═══');
    console.log('');
    console.log('📝 Source:');
    console.log(helloFlSource);
    console.log('');

    // Test lexer
    console.log('Step 1: Tokenization');
    const lexer = new Lexer(helloFlSource);
    const tokens = lexer.tokenize();
    console.log(`✅ Generated ${tokens.length} tokens`);
    console.log('');

    // Test parser
    console.log('Step 2: Parsing');
    const parser = new Parser(tokens);
    const program = parser.parse() as any;

    console.log('✅ Parse successful!');
    console.log(`   Type: ${program.type}`);
    console.log(`   Body length: ${program.body?.length || 0}`);

    if (program.body && program.body.length > 0) {
      const firstStmt = program.body[0];
      console.log('');
      console.log('   First statement:');
      console.log(`     Type: ${firstStmt.type}`);
      if (firstStmt.type === 'FunctionDeclaration') {
        console.log(`     Name: ${firstStmt.id?.name || 'unknown'}`);
        console.log(`     Params: ${firstStmt.params?.length || 0}`);
        console.log(`     Body: ${firstStmt.body?.length || 0} statements`);

        if (firstStmt.body && firstStmt.body.length > 0) {
          const firstBodyStmt = firstStmt.body[0];
          console.log(`       First body stmt: ${firstBodyStmt.type}`);

          if (firstBodyStmt.type === 'ReturnStatement' && firstBodyStmt.argument) {
            console.log(`         Return type: ${firstBodyStmt.argument.type}`);
            if (firstBodyStmt.argument.type === 'BinaryExpression') {
              console.log(`           Left: ${firstBodyStmt.argument.left?.type}`);
              console.log(`           Op: ${firstBodyStmt.argument.op}`);
              console.log(`           Right: ${firstBodyStmt.argument.right?.type}`);
            }
          }
        }
      }
    }

    console.log('');
    console.log('═══ Test 2: arithmetic.fl ═══');
    console.log('');
    console.log('📝 Source:');
    console.log(arithmeticFlSource);
    console.log('');

    const lexer2 = new Lexer(arithmeticFlSource);
    const tokens2 = lexer2.tokenize();
    console.log(`✅ Generated ${tokens2.length} tokens`);
    const parser2 = new Parser(tokens2);
    const arithmeticProgram = parser2.parse() as any;
    console.log('✅ Parse successful!');
    console.log(`   Type: ${arithmeticProgram.type}`);
    console.log(`   Functions: ${arithmeticProgram.body?.length || 0}`);

    if (arithmeticProgram.body) {
      arithmeticProgram.body.forEach((stmt, idx) => {
        if (stmt.type === 'FunctionDeclaration') {
          console.log(`   [${idx}] ${stmt.id?.name || 'unknown'}`);
        }
      });
    }

    console.log('');
    console.log('✅ Phase 2 Test Complete!');
    console.log('');

    // Detailed output
    console.log('═══ AST Output (JSON) ═══');
    console.log(JSON.stringify(program, null, 2));

  } catch (error) {
    console.error('❌ Test failed:');
    console.error(error instanceof Error ? error.message : String(error));
    process.exit(1);
  }
}

// Run test
runPhase2Test();
