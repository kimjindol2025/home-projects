/**
 * Quick Parser Test - Direct Execution
 * No Jest overhead, just direct testing
 */

import { Lexer, Parser } from './src/compiler/compiler';
import fs from 'fs';
import path from 'path';

async function runTests() {
  console.log('╔════════════════════════════════════════════════════════════════╗');
  console.log('║  🔬 Quick Phase 2 Parser Validation Test                      ║');
  console.log('╚════════════════════════════════════════════════════════════════╝');
  console.log('');

  const goldenDir = path.join(__dirname, 'tests/parser-golden');
  const files = ['hello.fl', 'arithmetic.fl', 'conditions.fl'];

  let passCount = 0;
  let failCount = 0;

  for (const filename of files) {
    const filepath = path.join(goldenDir, filename);
    console.log(`\n═══ Test: ${filename} ═══`);

    try {
      const source = fs.readFileSync(filepath, 'utf-8');
      console.log(`📖 File size: ${source.length} chars`);

      // Step 1: Lexer
      console.log('\n📌 Step 1: Lexer');
      const lexer = new Lexer(source);
      const tokens = lexer.tokenize();
      console.log(`✅ Tokens: ${tokens.length}`);

      // Show token summary
      const tokenTypes = new Map<string, number>();
      tokens.forEach((t: any) => {
        const count = tokenTypes.get(t.type) || 0;
        tokenTypes.set(t.type, count + 1);
      });

      console.log('\n   Token breakdown:');
      let summary = '';
      Array.from(tokenTypes.entries())
        .sort((a, b) => b[1] - a[1])
        .slice(0, 10)
        .forEach(([type, count]) => {
          summary += `${type}(${count}) `;
        });
      console.log(`   ${summary}`);

      // Step 2: Parser
      console.log('\n📌 Step 2: Parser');
      const parser = new Parser(tokens);
      const ast = parser.parse() as any;
      console.log(`✅ AST Generated`);
      console.log(`   Root type: ${ast.type}`);
      console.log(`   Statements: ${ast.statements?.length || 0}`);

      if (ast.statements && ast.statements.length > 0) {
        console.log('\n   First statement:');
        const first = ast.statements[0];
        console.log(`     Type: ${first.type}`);
        if (first.name) console.log(`     Name: ${first.name}`);
        if (first.id) console.log(`     ID: ${first.id}`);
      }

      console.log(`\n✅ ${filename} PASS`);
      passCount++;

    } catch (err) {
      console.log(`\n❌ ${filename} FAIL`);
      console.log(`   Error: ${err instanceof Error ? err.message : String(err)}`);
      failCount++;
    }
  }

  // Summary
  console.log('\n\n═════════════════════════════════════════════════════════════');
  console.log('\n📊 Test Summary');
  console.log(`   Pass: ${passCount}/3`);
  console.log(`   Fail: ${failCount}/3`);
  console.log(`   Success rate: ${((passCount / 3) * 100).toFixed(0)}%`);

  if (passCount === 3) {
    console.log('\n🎉 All tests passed!');
  } else if (passCount > 0) {
    console.log(`\n⚠️  ${passCount} out of 3 files parsed successfully`);
  } else {
    console.log('\n❌ No files parsed successfully');
  }

  console.log('');
  process.exit(passCount === 3 ? 0 : 1);
}

runTests().catch(err => {
  console.error('Fatal error:', err);
  process.exit(1);
});
