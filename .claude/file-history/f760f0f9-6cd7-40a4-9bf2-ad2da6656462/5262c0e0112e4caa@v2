#!/usr/bin/env node

/**
 * AST 비교 도구
 *
 * 사용법:
 *   node tools/compare-asts.js <ts-ast.json> <fl-ast.json>
 *
 * 목적:
 *   - TypeScript parser의 AST와 FreeLang parser의 AST 비교
 *   - 차이점 상세히 출력
 *   - 단계별 부분 비교 지원
 */

const fs = require('fs');
const path = require('path');

// 컬러 출력
const colors = {
  reset: '\x1b[0m',
  red: '\x1b[31m',
  green: '\x1b[32m',
  yellow: '\x1b[33m',
  blue: '\x1b[34m',
  cyan: '\x1b[36m',
  dim: '\x1b[2m',
};

function colorize(text, color) {
  return `${colors[color] || ''}${text}${colors.reset}`;
}

/**
 * JSON 파일 로드
 */
function loadJSON(filePath) {
  try {
    const content = fs.readFileSync(filePath, 'utf-8');
    return JSON.parse(content);
  } catch (error) {
    console.error(colorize(`❌ 파일 로드 실패: ${filePath}`, 'red'));
    throw error;
  }
}

/**
 * AST 구조 비교 (깊이 우선)
 */
function compareASTs(ts, fl, path = 'root', depth = 0) {
  const diffs = [];
  const indent = '  '.repeat(depth);

  // 타입 확인
  const tsType = typeof ts;
  const flType = typeof fl;

  if (tsType !== flType) {
    diffs.push({
      path,
      type: 'TYPE_MISMATCH',
      message: `타입 불일치: TS=${tsType}, FL=${flType}`,
      severity: 'error',
    });
    return diffs;
  }

  // null/undefined 확인
  if (ts === null && fl === null) return diffs;
  if (ts === null || fl === null) {
    diffs.push({
      path,
      type: 'NULL_MISMATCH',
      message: `null 불일치: TS=${ts}, FL=${fl}`,
      severity: 'error',
    });
    return diffs;
  }

  // 원시 타입
  if (typeof ts !== 'object') {
    if (ts !== fl) {
      diffs.push({
        path,
        type: 'VALUE_MISMATCH',
        message: `값 불일치: TS="${ts}" vs FL="${fl}"`,
        severity: 'warning',
      });
    }
    return diffs;
  }

  // 배열 비교
  if (Array.isArray(ts) && Array.isArray(fl)) {
    if (ts.length !== fl.length) {
      diffs.push({
        path,
        type: 'ARRAY_LENGTH',
        message: `배열 길이 불일치: TS=${ts.length}, FL=${fl.length}`,
        severity: 'error',
      });
    }

    const minLen = Math.min(ts.length, fl.length);
    for (let i = 0; i < minLen; i++) {
      diffs.push(...compareASTs(ts[i], fl[i], `${path}[${i}]`, depth + 1));
    }
    return diffs;
  }

  // 객체 비교
  if (!Array.isArray(ts) && !Array.isArray(fl)) {
    const tsKeys = Object.keys(ts || {});
    const flKeys = Object.keys(fl || {});
    const allKeys = new Set([...tsKeys, ...flKeys]);

    for (const key of allKeys) {
      const newPath = `${path}.${key}`;

      if (!tsKeys.includes(key)) {
        diffs.push({
          path: newPath,
          type: 'MISSING_KEY_TS',
          message: `TS에 누락: ${key}`,
          severity: 'warning',
        });
      } else if (!flKeys.includes(key)) {
        diffs.push({
          path: newPath,
          type: 'MISSING_KEY_FL',
          message: `FL에 누락: ${key}`,
          severity: 'error',
        });
      } else {
        diffs.push(...compareASTs(ts[key], fl[key], newPath, depth + 1));
      }
    }
    return diffs;
  }

  diffs.push({
    path,
    type: 'STRUCTURE_MISMATCH',
    message: `구조 불일치: TS=${Array.isArray(ts) ? 'Array' : 'Object'}, FL=${Array.isArray(fl) ? 'Array' : 'Object'}`,
    severity: 'error',
  });
  return diffs;
}

/**
 * 비교 결과 출력
 */
function printResults(diffs, tsFile, flFile) {
  console.log('\n' + '='.repeat(70));
  console.log(colorize('🔍 AST 비교 결과', 'blue'));
  console.log('='.repeat(70));
  console.log(`TypeScript: ${tsFile}`);
  console.log(`FreeLang:   ${flFile}`);
  console.log('─'.repeat(70));

  if (diffs.length === 0) {
    console.log(colorize('✅ 완벽하게 일치합니다!', 'green'));
    return;
  }

  // 심각도별 분류
  const errors = diffs.filter(d => d.severity === 'error');
  const warnings = diffs.filter(d => d.severity === 'warning');

  // 에러 출력
  if (errors.length > 0) {
    console.log(colorize(`\n❌ 에러 (${errors.length}개):`, 'red'));
    for (const diff of errors.slice(0, 10)) {
      console.log(`   ${colorize(diff.path, 'dim')}: ${diff.message}`);
    }
    if (errors.length > 10) {
      console.log(`   ... 외 ${errors.length - 10}개`);
    }
  }

  // 경고 출력
  if (warnings.length > 0) {
    console.log(colorize(`\n⚠️  경고 (${warnings.length}개):`, 'yellow'));
    for (const diff of warnings.slice(0, 10)) {
      console.log(`   ${colorize(diff.path, 'dim')}: ${diff.message}`);
    }
    if (warnings.length > 10) {
      console.log(`   ... 외 ${warnings.length - 10}개`);
    }
  }

  // 통계
  console.log('─'.repeat(70));
  console.log(`📊 통계: 총 ${diffs.length}개 차이`);
  console.log(`   에러: ${errors.length}, 경고: ${warnings.length}`);

  // 상세 보고서 저장
  const reportFile = tsFile.replace('.json', '-report.json');
  fs.writeFileSync(reportFile, JSON.stringify(diffs, null, 2));
  console.log(`\n📄 상세 보고서: ${reportFile}`);
}

/**
 * 메인
 */
function main() {
  const args = process.argv.slice(2);

  if (args.length < 2) {
    console.log('사용법: node tools/compare-asts.js <ts-ast.json> <fl-ast.json>\n');
    console.log('예시:');
    console.log('  node tools/compare-asts.js /tmp/ast-ts.json /tmp/ast-fl.json\n');
    process.exit(1);
  }

  const [tsFile, flFile] = args;

  // 파일 존재 확인
  if (!fs.existsSync(tsFile) || !fs.existsSync(flFile)) {
    console.error(colorize('❌ 파일이 없습니다:', 'red'));
    if (!fs.existsSync(tsFile)) console.error(`   ${tsFile}`);
    if (!fs.existsSync(flFile)) console.error(`   ${flFile}`);
    process.exit(1);
  }

  // JSON 로드
  console.log(colorize('📂 파일 로드 중...', 'cyan'));
  const tsAST = loadJSON(tsFile);
  const flAST = loadJSON(flFile);

  // 비교 실행
  console.log(colorize('🔄 비교 중...', 'cyan'));
  const diffs = compareASTs(tsAST, flAST);

  // 결과 출력
  printResults(diffs, tsFile, flFile);

  // 종료 코드
  const hasErrors = diffs.some(d => d.severity === 'error');
  process.exit(hasErrors ? 1 : 0);
}

main();
