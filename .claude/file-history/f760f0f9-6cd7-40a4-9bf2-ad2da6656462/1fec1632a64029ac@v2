  return x + y
`

let conditions_src = `fn max
input a: number
input b: number
output number
intent "두 수 중 큰 것을 반환"
  if a > b
    return a
  else
    return b

fn classify
input value: number
output string
intent "수를 분류"
  if value < 0
    return "negative"
  else if value == 0
    return "zero"
  else
    return "positive"
`

let loops_src = `fn sum_array
input arr: array<number>
output number
intent "배열의 합 계산"
  let total = 0
  for x in arr
    total = total + x
  return total

fn count_down
input n: number
output number
intent "카운트다운"
  let count = 0
  let i = n
  while i > 0
    count = count + 1
    i = i - 1
  return count
`

let functions_src = `fn multiply
input x: number
input y: number
output number
intent "곱셈"
  return x * y

fn test_call
output number
intent "함수 호출 테스트"
