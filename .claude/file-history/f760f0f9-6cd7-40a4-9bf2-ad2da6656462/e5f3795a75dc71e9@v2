/**
 * Phase 1 Lexer Validation Tool
 * Analyzes TS lexer baseline and prepares parser.fl validation
 *
 * This tool:
 * 1. Reads baseline JSON files from TS lexer
 * 2. Generates detailed token analysis reports
 * 3. Creates validation checklist for parser.fl
 * 4. Documents expected vs actual token sequences
 */

import fs from 'fs';
import path from 'path';

interface TokenInfo {
  index: number;
  type: string;
  value: string;
  position: string;
}

interface BaselineData {
  total: number;
  tokens: TokenInfo[];
}

interface ValidationReport {
  filename: string;
  total: number;
  tokens: TokenInfo[];
  keyTokens: string[];
  analysis: string;
}

/**
 * Read baseline JSON file
 */
function readBaseline(filename: string): BaselineData {
  const basename = filename.replace('.fl', '');
  const jsonfile = basename + '.tokens-ts.json';
  const filepath = path.join(__dirname, 'tests', 'parser-golden', jsonfile);
  const content = fs.readFileSync(filepath, 'utf-8');
  return JSON.parse(content);
}

/**
 * Extract key token types for quick verification
 */
function extractKeyTokens(tokens: TokenInfo[]): string[] {
  const keyTypes: string[] = [];
  let typeCount: { [key: string]: number } = {};

  for (const token of tokens) {
    if (!typeCount[token.type]) {
      typeCount[token.type] = 0;
    }
    typeCount[token.type]++;
  }

  // Get top 10 token types by frequency
  const sorted = Object.entries(typeCount)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 10);

  return sorted.map(([type, count]) => `${type}(${count})`);
}

/**
 * Generate detailed analysis for a file
 */
function analyzeBaseline(filename: string): ValidationReport {
  const baseline = readBaseline(filename);
  const keyTokens = extractKeyTokens(baseline.tokens);

  // Generate analysis text
  let analysis = `File: ${filename}\n`;
  analysis += `Total tokens: ${baseline.total}\n`;
  analysis += `Token types: ${keyTokens.join(', ')}\n`;

  // First 5 tokens
  analysis += `\nFirst 5 tokens:\n`;
  for (let i = 0; i < Math.min(5, baseline.tokens.length); i++) {
    const t = baseline.tokens[i];
    const val = t.value ? `"${t.value}"` : '(empty)';
    analysis += `  ${i + 1}. ${t.type} = ${val}\n`;
  }

  // Last 5 tokens
  const lastStart = Math.max(0, baseline.tokens.length - 5);
  if (lastStart > 5) {
    analysis += `\nLast 5 tokens:\n`;
    for (let i = lastStart; i < baseline.tokens.length; i++) {
      const t = baseline.tokens[i];
      const val = t.value ? `"${t.value}"` : '(empty)';
      analysis += `  ${i + 1}. ${t.type} = ${val}\n`;
    }
  }

  return {
    filename,
    total: baseline.total,
    tokens: baseline.tokens,
    keyTokens,
    analysis
  };
}

