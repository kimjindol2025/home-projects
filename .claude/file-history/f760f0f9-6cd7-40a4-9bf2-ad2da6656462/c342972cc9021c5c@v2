/**
 * TS Parser Lexer Baseline Generator
 * Golden 테스트 파일들을 TS parser로 파싱 → 토큰 리스트 추출
 * parser.fl의 tokenize() 결과와 비교할 기준선 생성
 */

import { Lexer, TokenBuffer } from './src/lexer/lexer';
import { Token } from './src/lexer/token';
import fs from 'fs';
import path from 'path';

interface TokenInfo {
  type: string;
  value: string;
  line: number;
  column: number;
}

/**
 * TS Lexer로 파일 파싱
 */
function parseWithTSLexer(src: string): TokenInfo[] {
  try {
    const lexer = new Lexer(src);
    const buffer = new TokenBuffer(lexer);

    const tokens: TokenInfo[] = [];

    // TokenBuffer에서 토큰 추출
    while (true) {
      const token = buffer.current();

      tokens.push({
        type: token.type || 'UNKNOWN',
        value: token.value || '',
        line: token.line || 0,
        column: token.column || 0,
      });

      // EOF 만나면 종료
      if (token.type === 'EOF') break;

      // 다음 토큰으로
      buffer.advance();
    }

    return tokens;
  } catch (error) {
    console.error('Lexer error:', error);
    return [];
  }
}

/**
 * 토큰 목록을 보기 좋게 출력
 */
function printTokens(tokens: TokenInfo[], title: string): void {
  console.log(`\n${'═'.repeat(70)}`);
  console.log(`📊 ${title}`);
  console.log(`${'═'.repeat(70)}`);

  console.log(`\n총 토큰 수: ${tokens.length}`);

  console.log(`\n${'#'.padEnd(4)} ${'Type'.padEnd(15)} ${'Value'.padEnd(20)} Line:Col`);
  console.log('-'.repeat(70));

  for (let i = 0; i < tokens.length; i++) {
    const t = tokens[i];
    const value = (t.value || '').substring(0, 18);
    const valuePad = value.padEnd(20);
    console.log(`${(i + 1).toString().padEnd(4)} ${t.type.padEnd(15)} ${valuePad} ${t.line}:${t.column}`);
  }
}

/**
 * 토큰 정보를 JSON으로 저장
 */
function saveTokensJson(tokens: TokenInfo[], filename: string): void {
  const json = JSON.stringify({
    total: tokens.length,
    tokens: tokens.map((t, i) => ({
      index: i + 1,
      type: t.type,
      value: t.value,
      position: `${t.line}:${t.column}`,
    })),
  }, null, 2);

  fs.writeFileSync(filename, json, 'utf-8');
}

/**
 * 메인 실행
 */
function main(): void {
  console.log(`\n${'╔'.padEnd(72, '═')}╗`);
  console.log(`║ 🧪 Phase 1 Lexer Baseline Generation (TS Parser)`.padEnd(71) + '║');
  console.log(`║ Golden 테스트 파일들을 파싱해서 토큰 기준선 생성`.padEnd(71) + '║');
  console.log(`${'╚'.padEnd(72, '═')}╝`);

  const goldenDir = path.join(__dirname, 'tests', 'parser-golden');
  const testFiles = [
    'hello.fl',
    'arithmetic.fl',
    'conditions.fl',
    'loops.fl',
    'functions.fl',
  ];

  let totalTokens = 0;
  const results: { file: string; tokenCount: number }[] = [];

  for (const testFile of testFiles) {
    const srcPath = path.join(goldenDir, testFile);

    if (!fs.existsSync(srcPath)) {
      console.log(`\n⚠️  ${testFile}: 파일 없음`);
      continue;
    }

    const src = fs.readFileSync(srcPath, 'utf-8');
    const tokens = parseWithTSLexer(src);

    // 화면 출력
    printTokens(tokens, testFile);

    // JSON 저장
    const jsonPath = srcPath.replace('.fl', '.tokens-ts.json');
    saveTokensJson(tokens, jsonPath);
    console.log(`\n✅ 저장: ${jsonPath}`);

    // 통계
    results.push({ file: testFile, tokenCount: tokens.length });
    totalTokens += tokens.length;
  }

  // 최종 요약
  console.log(`\n${'═'.repeat(70)}`);
  console.log(`📈 Phase 1 Baseline Summary`);
  console.log(`${'═'.repeat(70)}`);

  console.log(`\n파일별 토큰 수:`);
  for (const result of results) {
    console.log(`  ${result.file.padEnd(20)} ${result.tokenCount.toString().padStart(3)} tokens`);
  }

  console.log(`\n전체:`);
  console.log(`  파일 수:   ${results.length}`);
  console.log(`  총 토큰:   ${totalTokens}`);
  console.log(`  평균:      ${(totalTokens / results.length).toFixed(1)} tokens/file`);

  console.log(`\n✅ 기준선 생성 완료!`);
  console.log(`\n다음 단계: parser.fl의 tokenize()가 위 결과와 일치하는지 확인\n`);
}

main();
