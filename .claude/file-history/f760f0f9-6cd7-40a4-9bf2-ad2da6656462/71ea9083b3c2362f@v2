import fs from 'fs';
import path from 'path';

interface TokenInfo {
  index: number;
  type: string;
  value: string;
  position: string;
}

interface BaselineData {
  total: number;
  tokens: TokenInfo[];
}

interface ComparisonResult {
  filename: string;
  expected: number;
  actual: number;
  match: boolean;
  details: string;
}

/**
 * Read baseline JSON
 */
function readBaseline(filename: string): BaselineData {
  const basename = filename.replace('.fl', '');
  const jsonfile = basename + '.tokens-ts.json';
  const filepath = path.join(__dirname, 'tests', 'parser-golden', jsonfile);
  const content = fs.readFileSync(filepath, 'utf-8');
  return JSON.parse(content);
}

