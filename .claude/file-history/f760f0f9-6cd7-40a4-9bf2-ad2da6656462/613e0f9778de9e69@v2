/**
 * AST 노드 개수 세기 (재귀)
 */
function countNodes(obj: any, count = 0): number {
  if (!obj || typeof obj !== 'object') return count;

  count++;

  if (Array.isArray(obj)) {
    for (const item of obj) {
      count = countNodes(item, count);
    }
  } else {
    for (const value of Object.values(obj)) {
      count = countNodes(value, count);
    }
  }

  return count;
}

