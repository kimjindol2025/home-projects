/**
 * Parser 이식 검증 도구
 *
 * TypeScript parser와 FreeLang parser의 출력을 비교
 * 1. TS parser로 소스 파싱 → JSON 저장
 * 2. FL parser로 동일 소스 파싱 → JSON 저장
 * 3. 두 AST 비교 (diff)
 */

import { Parser } from '../src/parser/parser';
import { Lexer, TokenBuffer } from '../src/lexer/lexer';
import fs from 'fs';
import path from 'path';

/**
 * Self-parse 검증: TS parser로 코드 파싱 후 JSON 저장
 */
export function validateTSParser(srcFile: string): string {
  const src = fs.readFileSync(srcFile, 'utf-8');

  try {
    // Step 1: Tokenize
    const lexer = new Lexer(src);
    const buffer = new TokenBuffer(lexer);

    // Step 2: Parse
    const parser = new Parser(buffer);
    const ast = parser.parseModule();

    // Step 3: Serialize to JSON
    const astJson = JSON.stringify(ast, null, 2);

    // Save for comparison
    const outputFile = srcFile.replace('.fl', '.ast-ts.json');
    fs.writeFileSync(outputFile, astJson);

    return outputFile;
  } catch (error) {
    console.error(`❌ TS Parser error for ${srcFile}:`, error);
    throw error;
  }
}

/**
 * 두 AST JSON 파일 비교
 */
export function compareASTs(tsAstFile: string, flAstFile: string): { match: boolean; diff?: string } {
  try {
    const tsJson = fs.readFileSync(tsAstFile, 'utf-8');
    const flJson = fs.readFileSync(flAstFile, 'utf-8');

    const tsAst = JSON.parse(tsJson);
    const flAst = JSON.parse(flJson);

    const match = JSON.stringify(tsAst) === JSON.stringify(flAst);

    if (!match) {
      const diff = generateDiff(tsAst, flAst);
      return { match: false, diff };
    }

    return { match: true };
  } catch (error) {
    console.error('❌ AST comparison error:', error);
    throw error;
  }
}

/**
 * AST 구조 비교 (간단한 diff 생성)
 */
function generateDiff(obj1: any, obj2: any, path: string = 'root'): string {
  const diffs: string[] = [];

  const keys1 = new Set(Object.keys(obj1 || {}));
  const keys2 = new Set(Object.keys(obj2 || {}));

  // 누락된 키 찾기
  for (const key of keys1) {
    if (!keys2.has(key)) {
      diffs.push(`- Missing in FL: ${path}.${key}`);
    }
  }

  // 새로운 키 찾기
  for (const key of keys2) {
    if (!keys1.has(key)) {
      diffs.push(`+ Extra in FL: ${path}.${key}`);
    }
  }

  // 공통 키에서 값 비교
  for (const key of keys1) {
    if (keys2.has(key)) {
      const v1 = obj1[key];
      const v2 = obj2[key];

      if (typeof v1 === 'object' && typeof v2 === 'object') {
        diffs.push(...generateDiff(v1, v2, `${path}.${key}`).split('\n').filter(d => d));
      } else if (v1 !== v2) {
        diffs.push(`≠ Diff at ${path}.${key}: TS="${v1}" vs FL="${v2}"`);
      }
    }
  }

  return diffs.join('\n');
}

