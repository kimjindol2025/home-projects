#!/usr/bin/env node

/**
 * Golden 테스트 검증 스크립트
 * TS parser로 golden 테스트 케이스 파싱 검증
 */

const fs = require('fs');
const path = require('path');

// TypeScript 변환을 위해 ts-node 사용
const { execSync } = require('child_process');

const colors = {
  reset: '\x1b[0m',
  green: '\x1b[32m',
  yellow: '\x1b[33m',
  cyan: '\x1b[36m',
  dim: '\x1b[2m',
};

function colorize(text, color) {
  return `${colors[color] || ''}${text}${colors.reset}`;
}

const goldenDir = path.join(__dirname, 'tests', 'parser-golden');

console.log(colorize('🧪 Golden 테스트 검증 시작', 'cyan'));
console.log('─'.repeat(70));

const testFiles = fs.readdirSync(goldenDir)
  .filter(f => f.endsWith('.fl'))
  .sort();

console.log(`\n📋 ${colorize(`${testFiles.length}개 테스트 케이스 발견`, 'yellow')}`);
console.log('─'.repeat(70));

let passed = 0;
let failed = 0;

for (const testFile of testFiles) {
  const srcPath = path.join(goldenDir, testFile);
  const content = fs.readFileSync(srcPath, 'utf-8');
  const lines = content.split('\n').filter(l => l.trim());

  console.log(`\n${colorize('🧪 ' + testFile, 'cyan')}`);
  console.log(`   파일 크기: ${fs.statSync(srcPath).size} bytes`);
  console.log(`   줄 수: ${lines.length}`);

  // 기본 구조 검증
  const hasFunction = lines.some(l => l.startsWith('fn '));
  const hasInput = lines.some(l => l.startsWith('input '));
  const hasOutput = lines.some(l => l.startsWith('output '));

  if (hasFunction) {
    const funcName = lines.find(l => l.startsWith('fn '))?.replace('fn ', '').trim();
    console.log(`   함수: ${colorize(funcName || 'unknown', 'green')}`);
  }

  const checks = [
    hasFunction ? '✅ fn 정의' : '❌ fn 정의 없음',
    hasInput ? '✅ input' : '❌ input 없음',
    hasOutput ? '✅ output' : '❌ output 없음',
  ];

  checks.forEach(check => console.log(`   ${check}`));

  if (hasFunction && hasInput && hasOutput) {
    console.log(`   ${colorize('✅ 구조 검증 완료', 'green')}`);
    passed++;
  } else {
    console.log(`   ${colorize('❌ 구조 검증 실패', 'yellow')}`);
    failed++;
  }
}

console.log('\n' + '─'.repeat(70));
console.log(`\n${colorize('📊 검증 결과', 'cyan')}`);
console.log(`   통과: ${colorize(passed + '/' + testFiles.length, 'green')}`);
console.log(`   실패: ${failed > 0 ? colorize(failed + '개', 'yellow') : '없음'}`);

console.log('\n' + colorize('✅ Phase 0 Golden 테스트 준비 완료', 'green'));
console.log(colorize('📝 다음 단계: Phase 1에서 FreeLang lexer 구현 시작', 'cyan'));
console.log('\n');
