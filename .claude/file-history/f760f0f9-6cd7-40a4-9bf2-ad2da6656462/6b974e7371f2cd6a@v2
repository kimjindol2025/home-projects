# Phase 2 Parser Test
# Goal: Test parseProgram, parseStatement on hello.fl

println("╔════════════════════════════════════════════════════════════════╗")
println("║  🧪 Phase 2: Parser Testing (hello.fl)                        ║")
println("╚════════════════════════════════════════════════════════════════╝")
println("")

# hello.fl 소스 (임베드)
let hello_source = `fn hello
input name: string
output string
intent "인사말 함수"
  return "Hello, " + name
`

println("📝 Source Code:")
println(hello_source)
println("")

# 렉서 & 파서 테스트 (통합)
println("═══ Step 1: Tokenization ═══")
let tokens = tokenize(hello_source)
println("Tokens generated: " + str(array_length(tokens)))
println("")

# 파서 테스트
println("═══ Step 2: Parsing ═══")
let ast = parse(hello_source)

println("✅ Parse complete!")
println("AST type: " + ast["type"])
println("Body statements: " + str(array_length(ast["body"])))
println("")

# AST 출력
println("═══ Step 3: AST Output ═══")
if array_length(ast["body"]) > 0 {
  let stmt = ast["body"][0]
  println("First statement type: " + stmt["type"])

  if stmt["type"] == "FunctionDeclaration" {
    println("Function name: " + stmt["id"]["name"])
    println("Parameters: " + str(array_length(stmt["params"])))
    println("Body statements: " + str(array_length(stmt["body"])))

    if array_length(stmt["body"]) > 0 {
      let first_body_stmt = stmt["body"][0]
      println("First body statement: " + first_body_stmt["type"])
    }
  }
}

println("")
println("✅ Phase 2 Test Complete!")
println("")
