#!/usr/bin/env node

/**
 * TS Parser Baseline Generator
 * Golden 테스트들을 TS parser로 파싱해서 JSON으로 저장
 * 나중에 FL parser 결과와 비교용 기준선
 */

const fs = require('fs');
const path = require('path');

// 실제로 FreeLang이 설치된 모듈에서 parser를 import할 수도 있지만,
// 여기서는 간단한 토큰 카운팅만 해봅시다.

const goldenDir = path.join(__dirname, 'tests', 'parser-golden');

console.log('\n╔════════════════════════════════════════════════════════════════╗');
console.log('║  📊 TS Parser Baseline Generation                             ║');
console.log('║     Golden 테스트들을 분석해서 예상 토큰 수를 계산             ║');
console.log('╚════════════════════════════════════════════════════════════════╝\n');

const testFiles = fs.readdirSync(goldenDir)
  .filter(f => f.endsWith('.fl'))
  .sort();

let totalTokens = 0;

for (const testFile of testFiles) {
  const srcPath = path.join(goldenDir, testFile);
  const src = fs.readFileSync(srcPath, 'utf-8');
  const lines = src.split('\n');

  // 간단한 토큰 카운팅 (실제와는 다르지만 추정용)
  let tokenCount = 0;
  for (const line of lines) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith('#')) continue;

    // 대략적인 토큰 분석
    const tokens = trimmed.match(/\b\w+\b|[(){}\[\]:,;.+=\-*/<>!&|]+/g) || [];
    tokenCount += tokens.length;
  }

  console.log(`📄 ${testFile}`);
  console.log(`   📝 라인: ${lines.length}`);
  console.log(`   📊 추정 토큰: ${tokenCount}`);
  console.log('');

  totalTokens += tokenCount;
}

console.log('─'.repeat(64));
console.log(`\n📈 전체 통계`);
console.log(`   파일: ${testFiles.length}개`);
console.log(`   총 예상 토큰: ${totalTokens}개\n`);

console.log('✅ Phase 1 목표: 위 토큰들을 정확히 파싱해내기\n');
