```typescript
import { Parser } from '../src/parser/parser';
import { Lexer, TokenBuffer } from '../src/lexer/lexer';
import fs from 'fs';

/**
 * Self-parse 검증 도구
 * 1. TS parser로 소스 파싱 → JSON 저장
 * 2. FL parser로 동일 소스 파싱 → JSON 저장
 * 3. diff 비교
 */

export function testSelfParse(srcFile: string) {
  const src = fs.readFileSync(srcFile, 'utf-8');

  // Step 1: TS parser
  const lexerTS = new Lexer(src);
  const bufferTS = new TokenBuffer(lexerTS);
  const parserTS = new Parser(bufferTS);
  const astTS = parserTS.parseModule();  // 또는 적절한 메인 파싱 함수

  const astTSJson = JSON.stringify(astTS, null, 2);
  fs.writeFileSync('/tmp/ast-ts.json', astTSJson);

