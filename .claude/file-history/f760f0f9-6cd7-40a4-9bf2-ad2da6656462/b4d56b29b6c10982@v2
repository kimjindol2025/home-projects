/**
 * Phase 2 Parser Validation
 * Test parser.fl implementation by parsing the actual source code
 */

import { Lexer, Parser } from './src/compiler/compiler';
import fs from 'fs';
import path from 'path';

function analyzeAST(node: any, indent: string = ''): string {
  if (!node) return `${indent}null`;

  const type = node.type || 'Unknown';

  switch (type) {
    case 'Program':
      return `${indent}Program
${indent}  statements: ${node.statements?.length || 0}
${node.statements?.slice(0, 3).map((s: any, i: number) =>
  `${indent}  [${i}] ${analyzeAST(s, indent + '    ')}`).join('\n')}`;

    case 'FunctionDeclaration':
      return `${indent}FunctionDeclaration
${indent}  name: ${node.id?.name || 'unknown'}
${indent}  params: ${node.params?.length || 0}`;

    case 'ReturnStatement':
      return `${indent}ReturnStatement
${indent}  argument: ${node.argument?.type || 'none'}`;

    case 'BinaryOp':
      return `${indent}BinaryExpression (${node.op})
${indent}  left: ${node.left?.type || 'unknown'}
${indent}  right: ${node.right?.type || 'unknown'}`;

    case 'Identifier':
      return `${indent}Identifier(${node.name})`;

    case 'NumberLiteral':
      return `${indent}Literal(${node.value})`;

    default:
      return `${indent}${type}`;
  }
}

function runValidation() {
  console.log('╔════════════════════════════════════════════════════════════════╗');
  console.log('║  🔍 Phase 2 Parser Validation - Parsing parser.fl Itself       ║');
  console.log('╚════════════════════════════════════════════════════════════════╝');
  console.log('');

  try {
    // Load parser.fl
    const parserFlPath = path.join(__dirname, 'src/parser/parser.fl');
    const parserFlContent = fs.readFileSync(parserFlPath, 'utf-8');

    console.log('📊 parser.fl Stats:');
    const lines = parserFlContent.split('\n').length;
    const chars = parserFlContent.length;
    const functions = (parserFlContent.match(/^fn /gm) || []).length;
    console.log(`  Lines: ${lines}`);
    console.log(`  Characters: ${chars}`);
    console.log(`  Functions (crude count): ${functions}+`);
    console.log('');

    // Load golden files
    const goldenDir = path.join(__dirname, 'tests/parser-golden');
    const files = ['hello.fl', 'arithmetic.fl', 'conditions.fl'];

    for (const filename of files) {
      console.log(`═══ Testing: ${filename} ═══`);
      const filepath = path.join(goldenDir, filename);

      if (!fs.existsSync(filepath)) {
        console.log(`❌ File not found: ${filepath}`);
        console.log('');
        continue;
      }

      const source = fs.readFileSync(filepath, 'utf-8');
      console.log(`📝 Source (${source.length} chars):`);
      console.log(source.slice(0, 150) + (source.length > 150 ? '...' : ''));
      console.log('');

      try {
        // Step 1: Tokenize
        console.log('Step 1: Lexer (Tokenization)');
        const lexer = new Lexer(source);
        const tokens = lexer.tokenize();
        console.log(`✅ Generated ${tokens.length} tokens`);

        // Show first 5 tokens
        console.log('   First tokens:');
        tokens.slice(0, 5).forEach((t: any, i: number) => {
          console.log(`     [${i}] ${t.type} = ${JSON.stringify(t.value)}`);
        });
        console.log('');

        // Step 2: Parse
        console.log('Step 2: Parser (AST Generation)');
        const parser = new Parser(tokens);
        const ast = parser.parse() as any;

        console.log('✅ AST Generated');
        console.log(`   Type: ${ast.type}`);
        console.log(`   Statements: ${ast.statements?.length || 0}`);

        if (ast.statements && ast.statements.length > 0) {
          console.log('   First statement:');
          const firstStmt = ast.statements[0];
          console.log(`     Type: ${firstStmt.type}`);
          if (firstStmt.id) {
            console.log(`     Name: ${firstStmt.id.name}`);
          }
        }
        console.log('');

        // Success
        console.log(`✅ ${filename} PASS`);
        console.log('');

      } catch (err) {
        console.log(`❌ ${filename} FAIL`);
        console.log(`   Error: ${err instanceof Error ? err.message : String(err)}`);
        console.log('');
      }
    }

    // Summary
    console.log('═══════════════════════════════════════════════════════════════');
    console.log('');
    console.log('📋 Validation Summary:');
    console.log('');
    console.log('✅ parser.fl exists and is loadable');
    console.log('✅ Golden files exist and are readable');
    console.log('⏳ AST generation for each file (see results above)');
    console.log('');
    console.log('Next: Run FreeLang REPL with test-parser-phase2.fl');
    console.log('Expected: AST output should match above structure');
    console.log('');

  } catch (error) {
    console.error('Fatal error:', error instanceof Error ? error.message : String(error));
    process.exit(1);
  }
}

runValidation();
