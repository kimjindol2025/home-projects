#!/usr/bin/env node

/**
 * KPM (Kim Package Manager) v2.0.0
 *
 * 903개 패키지를 관리하는 패키지 매니저
 * FreeLang + Kim 생태계
 */

const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

const REGISTRY_PATH = '/home/kimjin/kpm-registry/registry.json';
const GOGS_URL = 'https://gogs.dclub.kr/kim';

class KPM {
  constructor() {
    this.registry = this.loadRegistry();
  }

  loadRegistry() {
    try {
      if (fs.existsSync(REGISTRY_PATH)) {
        return JSON.parse(fs.readFileSync(REGISTRY_PATH, 'utf8'));
      }
    } catch (e) {
      console.error('❌ 레지스트리 로드 실패:', e.message);
    }
    return { packages: [], version: '2.0.0', lastUpdated: new Date().toISOString() };
  }

  saveRegistry() {
    try {
      fs.writeFileSync(REGISTRY_PATH, JSON.stringify(this.registry, null, 2));
      console.log('✅ 레지스트리 저장됨');
    } catch (e) {
      console.error('❌ 레지스트리 저장 실패:', e.message);
    }
  }

  // search <키워드>
  search(keyword) {
    const results = this.registry.packages.filter(pkg =>
      pkg.name.toLowerCase().includes(keyword.toLowerCase()) ||
      pkg.description?.toLowerCase().includes(keyword.toLowerCase())
    );

    console.log(`\n🔍 검색 결과: "${keyword}" (${results.length}개)\n`);
    results.slice(0, 10).forEach(pkg => {
      console.log(`  📦 ${pkg.name} v${pkg.version}`);
      console.log(`     ${pkg.description || 'N/A'}`);
      console.log(`     🔗 ${pkg.repository || 'N/A'}\n`);
    });

    if (results.length > 10) {
      console.log(`  ... 외 ${results.length - 10}개 더 있습니다`);
    }
  }

  // info <패키지>
  info(name) {
    const pkg = this.registry.packages.find(p => p.name === name);
    if (!pkg) {
      console.log(`❌ 패키지 "${name}" 찾을 수 없음`);
      return;
    }

    console.log(`\n📦 ${pkg.name} v${pkg.version}`);
    console.log(`   설명: ${pkg.description || 'N/A'}`);
    console.log(`   저장소: ${pkg.repository || 'N/A'}`);
    console.log(`   저자: ${pkg.author || 'N/A'}`);
    console.log(`   라이선스: ${pkg.license || 'MIT'}`);
    console.log(`   태그: ${(pkg.tags || []).join(', ') || 'N/A'}`);
    console.log(`   설치: kpm install ${pkg.name}\n`);
  }

  // install <패키지>
  install(name) {
    const pkg = this.registry.packages.find(p => p.name === name);
    if (!pkg) {
      console.log(`❌ 패키지 "${name}" 찾을 수 없음`);
      return;
    }

    const url = pkg.repository || `${GOGS_URL}/${pkg.name}.git`;
    const installPath = `/opt/kpm/${name}`;

    console.log(`\n📥 ${name}을(를) 설치하는 중...\n`);
    console.log(`   저장소: ${url}`);
    console.log(`   경로: ${installPath}\n`);

    try {
      // 실제 설치는 권한 필요
      console.log(`   ℹ️  실제 설치 명령어:`);
      console.log(`   git clone ${url} ${installPath}`);
    } catch (e) {
      console.error(`❌ 설치 실패: ${e.message}`);
    }
  }

  // list
  list() {
    console.log(`\n📦 설치된 패키지 (${this.registry.packages.length}개)\n`);
    this.registry.packages.forEach(pkg => {
      console.log(`  ✅ ${pkg.name} v${pkg.version}`);
    });
    console.log();
  }

  // tag <태그>
  tag(tagName) {
    const results = this.registry.packages.filter(pkg =>
      pkg.tags && pkg.tags.includes(tagName)
    );

    console.log(`\n🏷️  태그 "${tagName}" (${results.length}개)\n`);
    results.slice(0, 20).forEach(pkg => {
      console.log(`  📦 ${pkg.name} v${pkg.version}`);
    });
    console.log();
  }

  // stats
  stats() {
    const languages = this.registry.packages.filter(p =>
      p.tags?.includes('language')
    ).length;
    const ai = this.registry.packages.filter(p =>
      p.tags?.includes('ai')
    ).length;

    console.log(`\n📊 KPM 통계\n`);
    console.log(`   총 패키지: ${this.registry.packages.length}`);
    console.log(`   언어: ${languages}`);
    console.log(`   AI/ML: ${ai}`);
    console.log(`   마지막 업데이트: ${this.registry.lastUpdated}\n`);
  }

  run(args) {
    const [cmd, ...params] = args;

    switch (cmd) {
      case 'search':
        this.search(params[0] || '');
        break;
      case 'tag':
        this.tag(params[0] || '');
        break;
      case 'info':
        this.info(params[0] || '');
        break;
      case 'install':
        this.install(params[0] || '');
        break;
      case 'list':
        this.list();
        break;
      case 'stats':
        this.stats();
        break;
      case 'help':
      case '--help':
      case '-h':
        this.help();
        break;
      default:
        console.log(`❌ 알 수 없는 명령어: ${cmd}`);
        console.log(`kpm --help 로 도움말을 확인하세요`);
    }
  }

  help() {
    console.log(`
🚀 KPM (Kim Package Manager) v2.0.0

명령어:
  kpm search <키워드>  - 패키지 검색
  kpm tag <태그>       - 태그별 검색
  kpm info <패키지>    - 패키지 정보
  kpm install <패키지> - 설치
  kpm list             - 설치된 패키지
  kpm stats            - 통계
  kpm help             - 도움말

📍 레지스트리: ${REGISTRY_PATH}
🔗 GOGS: ${GOGS_URL}
    `);
  }
}

const kpm = new KPM();
kpm.run(process.argv.slice(2));
