#!/usr/bin/env node

/**
 * Convert custom test format to Jest format
 * Usage: node convert-tests-to-jest.js <test-file>
 */

const fs = require('fs');
const path = require('path');

function convertToJest(content, filename) {
  const lines = content.split('\n');
  const output = [];

  // Keep imports and helper functions at top
  let inHeader = true;
  let headerLines = [];
  let testLines = [];

  for (const line of lines) {
    if (inHeader) {
      if (line.match(/^import|^function|^const|^\/\//)) {
        headerLines.push(line);
      } else if (line.trim() === '') {
        headerLines.push(line);
      } else {
        inHeader = false;
        testLines.push(line);
      }
    } else {
      testLines.push(line);
    }
  }

  // Build output
  const result = [];
  result.push(...headerLines);
  result.push('');

  // Parse test blocks
  let currentGroup = '';
  let testCount = 0;
  let blockLines = [];
  let inBlock = false;

  for (let i = 0; i < testLines.length; i++) {
    const line = testLines[i];

    // Detect group headers: console.log("=== ... ===")
    if (line.includes('console.log("===')) {
      // Flush previous block
      if (blockLines.length > 0 && currentGroup) {
        result.push(`describe('${currentGroup}', () => {`);
        result.push(convertBlockToTest(blockLines));
        result.push('});');
        result.push('');
        blockLines = [];
      }

      // Extract group name
      const match = line.match(/console\.log\("===\s*([^=]+)\s*==="\)/);
      currentGroup = match ? match[1].trim() : `Test Group ${testCount++}`;
      continue;
    }

    // Detect test block start: { (after non-comment)
    if (line.trim() === '{' && !inBlock) {
      inBlock = true;
      blockLines.push(line);
      continue;
    }

    // Detect test block end: }
    if (line.trim() === '}' && inBlock) {
      blockLines.push(line);
      // Don't flush yet, might be nested blocks
      continue;
    }

    if (inBlock) {
      blockLines.push(line);
    }
  }

  // Flush final block
  if (blockLines.length > 0 && currentGroup) {
    result.push(`describe('${currentGroup}', () => {`);
    result.push(convertBlockToTest(blockLines));
    result.push('});');
  }

  return result.join('\n');
}

function convertBlockToTest(blockLines) {
  const lines = blockLines.slice(1, -1); // Remove { and }
  const output = [];

  // Convert console.assert to expect
  for (const line of lines) {
    let converted = line;

    // Match: console.assert(condition, message)
    if (line.includes('console.assert(')) {
      const match = line.match(/console\.assert\((.+?),\s*(['"`])(.+?)\2\)/);
      if (match) {
        const condition = match[1];
        const message = match[3];
        converted = `  expect(${condition}).toBeTruthy(); // ${message}`;
      }
    }

    // Match: console.log("  ✅ ...")
    if (line.includes('console.log("  ✅')) {
      const match = line.match(/console\.log\("  ✅\s*(.+?)"\)/);
      if (match) {
        converted = `  // ✅ ${match[1]}`;
      }
    }

    output.push(converted);
  }

  // Wrap in it() block
  const content = output.join('\n');
  return `  it('should handle test case', () => {\n${content}\n  });`;
}

// Main
if (require.main === module) {
  const filePath = process.argv[2];

  if (!filePath) {
    console.error('Usage: node convert-tests-to-jest.js <file>');
    process.exit(1);
  }

  const content = fs.readFileSync(filePath, 'utf8');
  const converted = convertToJest(content, path.basename(filePath));

  console.log(converted);
}

module.exports = { convertToJest };
