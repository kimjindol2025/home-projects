// FreeLang v4 — Lexer 테스트 (Jest Format)

import { Lexer, TokenType, Token, LexError } from "./lexer";

function lex(source: string): { tokens: Token[]; errors: LexError[] } {
  return new Lexer(source).tokenize();
}

function types(source: string): TokenType[] {
  return lex(source).tokens.map((t) => t.type);
}

function lexemes(source: string): string[] {
  return lex(source).tokens.map((t) => t.lexeme);
}

describe('Lexer Tests', () => {

  describe('1. Keywords (13개)', () => {
    it('should tokenize all 13 keywords', () => {
      const r = lex("var let const fn if else match for in return spawn true false");
      const kw = r.tokens.slice(0, -1); // EOF 제외

      expect(kw).toHaveLength(13);
      expect(kw[0].type).toBe(TokenType.VAR);
      expect(kw[1].type).toBe(TokenType.LET);
      expect(kw[2].type).toBe(TokenType.CONST);
      expect(kw[3].type).toBe(TokenType.FN);
      expect(kw[4].type).toBe(TokenType.IF);
      expect(kw[5].type).toBe(TokenType.ELSE);
      expect(kw[6].type).toBe(TokenType.MATCH);
      expect(kw[7].type).toBe(TokenType.FOR);
      expect(kw[8].type).toBe(TokenType.IN);
      expect(kw[9].type).toBe(TokenType.RETURN);
      expect(kw[10].type).toBe(TokenType.SPAWN);
      expect(kw[11].type).toBe(TokenType.TRUE);
      expect(kw[12].type).toBe(TokenType.FALSE);
    });
  });

  describe('2. Type Names (7개)', () => {
    it('should tokenize all 7 type names', () => {
      const r = lex("i32 i64 f64 bool string void channel");
      const t = r.tokens.slice(0, -1);

      expect(t).toHaveLength(7);
      expect(t[0].type).toBe(TokenType.TYPE_I32);
      expect(t[1].type).toBe(TokenType.TYPE_I64);
      expect(t[2].type).toBe(TokenType.TYPE_F64);
      expect(t[3].type).toBe(TokenType.TYPE_BOOL);
      expect(t[4].type).toBe(TokenType.TYPE_STRING);
      expect(t[5].type).toBe(TokenType.TYPE_VOID);
      expect(t[6].type).toBe(TokenType.TYPE_CHANNEL);
    });
  });

  describe('3. Option/Result are IDENT', () => {
    it('should treat Option/Result/Ok/Err/Some/None as identifiers', () => {
      const r = lex("Option Result Ok Err Some None");
      const t = r.tokens.slice(0, -1);

      t.forEach((tok) => {
        expect(tok.type).toBe(TokenType.IDENT);
      });
    });
  });

  describe('4. Identifiers', () => {
    it('should tokenize valid identifiers', () => {
      const r = lex("x my_func _tmp abc123 _");
      const t = r.tokens.slice(0, -1);

      expect(t).toHaveLength(5);
      t.forEach((tok) => {
        expect(tok.type).toBe(TokenType.IDENT);
      });

      expect(t[0].lexeme).toBe("x");
      expect(t[1].lexeme).toBe("my_func");
      expect(t[2].lexeme).toBe("_tmp");
      expect(t[3].lexeme).toBe("abc123");
      expect(t[4].lexeme).toBe("_");
    });
  });

  describe('5. Integer Literals', () => {
    it('should tokenize integer literals', () => {
      const r = lex("0 42 999 12345");
      const t = r.tokens.slice(0, -1);

      expect(t).toHaveLength(4);
      t.forEach((tok) => {
        expect(tok.type).toBe(TokenType.INT_LIT);
      });

      expect(t[0].lexeme).toBe("0");
      expect(t[1].lexeme).toBe("42");
      expect(t[2].lexeme).toBe("999");
      expect(t[3].lexeme).toBe("12345");
    });
  });

  describe('6. String Literals', () => {
    it('should tokenize string literals', () => {
      const r = lex('"hello" "world"');
      const t = r.tokens.slice(0, -1);

      expect(t).toHaveLength(2);
      t.forEach((tok) => {
        expect(tok.type).toBe(TokenType.STRING_LIT);
      });

      expect(t[0].lexeme).toBe("hello");
      expect(t[1].lexeme).toBe("world");
    });
  });

  describe('7. Operators and Punctuation', () => {
    it('should tokenize operators and punctuation', () => {
      const r = lex("+ - * / % == != < > <= >= && || ! =");
      const t = r.tokens.slice(0, -1);

      expect(t[0].type).toBe(TokenType.PLUS);
      expect(t[1].type).toBe(TokenType.MINUS);
      expect(t[2].type).toBe(TokenType.STAR);
      expect(t[3].type).toBe(TokenType.SLASH);
      expect(t[4].type).toBe(TokenType.PERCENT);
      expect(t[5].type).toBe(TokenType.EQEQ);
      expect(t[6].type).toBe(TokenType.NEQ);
      expect(t[7].type).toBe(TokenType.LT);
      expect(t[8].type).toBe(TokenType.GT);
      expect(t[9].type).toBe(TokenType.LTEQ);
      expect(t[10].type).toBe(TokenType.GTEQ);
      expect(t[11].type).toBe(TokenType.AND);
      expect(t[12].type).toBe(TokenType.OR);
      expect(t[13].type).toBe(TokenType.NOT);
      expect(t[14].type).toBe(TokenType.EQ);
    });
  });

  describe('8. Delimiters', () => {
    it('should tokenize delimiters correctly', () => {
      const r = lex("( ) { } [ ] , ; : .");
      const t = r.tokens.slice(0, -1);

      expect(t[0].type).toBe(TokenType.LPAREN);
      expect(t[1].type).toBe(TokenType.RPAREN);
      expect(t[2].type).toBe(TokenType.LBRACE);
      expect(t[3].type).toBe(TokenType.RBRACE);
      expect(t[4].type).toBe(TokenType.LBRACKET);
      expect(t[5].type).toBe(TokenType.RBRACKET);
      expect(t[6].type).toBe(TokenType.COMMA);
      expect(t[7].type).toBe(TokenType.SEMICOLON);
      expect(t[8].type).toBe(TokenType.COLON);
      expect(t[9].type).toBe(TokenType.DOT);
    });
  });

  describe('9. Complex Expression', () => {
    it('should tokenize a complex expression', () => {
      const r = lex("let x: i32 = 42 + y * 2;");
      const t = r.tokens;

      expect(t[0].type).toBe(TokenType.LET);
      expect(t[1].type).toBe(TokenType.IDENT);
      expect(t[2].type).toBe(TokenType.COLON);
      expect(t[3].type).toBe(TokenType.TYPE_I32);
      expect(t[4].type).toBe(TokenType.EQ);
      expect(t[5].type).toBe(TokenType.INT_LIT);
      expect(t[6].type).toBe(TokenType.PLUS);
    });
  });

  describe('10. Empty Input', () => {
    it('should handle empty input', () => {
      const r = lex("");
      expect(r.tokens).toHaveLength(1); // Only EOF
      expect(r.tokens[0].type).toBe(TokenType.EOF);
    });
  });

});
