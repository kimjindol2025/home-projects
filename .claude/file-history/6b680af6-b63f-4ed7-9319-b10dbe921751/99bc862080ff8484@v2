// FreeLang v4 — Parser 테스트 (Jest Format)

import { Lexer } from "./lexer";
import { Parser } from "./parser";
import { Stmt, Expr } from "./ast";

function parse(source: string): { stmts: Stmt[]; errors: string[] } {
  const { tokens, errors: lexErrors } = new Lexer(source).tokenize();
  if (lexErrors.length > 0) throw new Error(`Lex error: ${lexErrors[0].message}`);
  const { program, errors } = new Parser(tokens).parse();
  return { stmts: program.stmts, errors: errors.map((e) => e.message) };
}

function parseOk(source: string): Stmt[] {
  const { stmts, errors } = parse(source);
  if (errors.length > 0) throw new Error(`Parse errors: ${errors.join(", ")}`);
  return stmts;
}

function parseExpr(source: string): Expr {
  const stmts = parseOk(source);
  if (stmts.length !== 1 || stmts[0].kind !== "expr_stmt") {
    throw new Error("expected single expr_stmt");
  }
  return (stmts[0] as any).expr;
}

describe('Parser Tests', () => {

  describe('Variable Declarations', () => {
    it('should parse var declaration with type and init', () => {
      const [s] = parseOk("var x: i32 = 42");
      expect(s.kind).toBe("var_decl");
      expect((s as any).name).toBe("x");
      expect((s as any).mutable).toBe(true);
      expect((s as any).type?.kind).toBe("i32");
      expect((s as any).init.kind).toBe("int_lit");
    });

    it('should parse let declaration with type inference', () => {
      const [s] = parseOk('let name = "hello"');
      expect(s.kind).toBe("var_decl");
      expect((s as any).mutable).toBe(false);
      expect((s as any).type).toBeNull();
    });

    it('should parse const declaration', () => {
      const [s] = parseOk("const PI: f64 = 3.14159");
      expect(s.kind).toBe("var_decl");
      expect((s as any).mutable).toBe(false);
      expect((s as any).type?.kind).toBe("f64");
    });
  });

  describe('Function Declarations', () => {
    it('should parse function with return type', () => {
      const [s] = parseOk("fn add(a: i32, b: i32): i32 { return a + b }");
      expect(s.kind).toBe("fn_decl");
      expect((s as any).name).toBe("add");
      expect((s as any).params).toHaveLength(2);
      expect((s as any).returnType.kind).toBe("i32");
    });

    it('should parse function with no parameters', () => {
      const [s] = parseOk("fn getAnswer(): i32 { return 42 }");
      expect(s.kind).toBe("fn_decl");
      expect((s as any).params).toHaveLength(0);
    });

    it('should parse nested function calls', () => {
      const e = parseExpr("println(add(1, 2))") as any;
      expect(e.kind).toBe("call");
      expect(e.callee.name).toBe("println");
      expect(e.args[0].kind).toBe("call");
      expect(e.args[0].callee.name).toBe("add");
    });
  });

  describe('Struct Declarations', () => {
    it('should parse struct with fields', () => {
      const [s] = parseOk("struct Point { x: i32, y: i32 }");
      expect(s.kind).toBe("struct_decl");
      expect((s as any).name).toBe("Point");
      expect((s as any).fields).toHaveLength(2);
    });

    it('should parse named struct literal', () => {
      const e = parseExpr("Point { x: 10, y: 20 }") as any;
      expect(e.kind).toBe("struct_lit");
      expect(e.structName).toBe("Point");
      expect(e.fields).toHaveLength(2);
    });
  });

  describe('Expressions', () => {
    it('should parse integer literals', () => {
      const e = parseExpr("42") as any;
      expect(e.kind).toBe("int_lit");
      expect(e.value).toBe(42);
    });

    it('should parse string literals', () => {
      const e = parseExpr('"hello"') as any;
      expect(e.kind).toBe("string_lit");
      expect(e.value).toBe("hello");
    });

    it('should parse boolean literals', () => {
      const eTrue = parseExpr("true") as any;
      expect(eTrue.kind).toBe("bool_lit");
      expect(eTrue.value).toBe(true);

      const eFalse = parseExpr("false") as any;
      expect(eFalse.kind).toBe("bool_lit");
      expect(eFalse.value).toBe(false);
    });

    it('should parse array literals', () => {
      const e = parseExpr("[1, 2, 3]") as any;
      expect(e.kind).toBe("array_lit");
      expect(e.elements).toHaveLength(3);
    });

    it('should parse function calls', () => {
      const e = parseExpr("add(1, 2)") as any;
      expect(e.kind).toBe("call");
      expect(e.callee.name).toBe("add");
      expect(e.args).toHaveLength(2);
    });

    it('should parse method calls', () => {
      const e = parseExpr("foo.bar(1)") as any;
      expect(e.kind).toBe("call");
      expect(e.callee.kind).toBe("field_access");
      expect(e.callee.field).toBe("bar");
    });

    it('should parse array indexing', () => {
      const e = parseExpr("arr[0]") as any;
      expect(e.kind).toBe("index");
      expect(e.object.name).toBe("arr");
      expect(e.index.value).toBe(0);
    });

    it('should parse field access', () => {
      const e = parseExpr("point.x") as any;
      expect(e.kind).toBe("field_access");
      expect(e.field).toBe("x");
    });
  });

  describe('Control Flow', () => {
    it('should parse if statement', () => {
      const [s] = parseOk("if x > 0 { return x }");
      expect(s.kind).toBe("if_stmt");
      expect((s as any).condition.kind).toBe("binary");
    });

    it('should parse if-else statement', () => {
      const [s] = parseOk("if x > 0 { return x } else { return 0 }");
      expect(s.kind).toBe("if_stmt");
      expect((s as any).else_branch).not.toBeNull();
    });

    it('should parse while loop', () => {
      const [s] = parseOk("while i < 10 { i = i + 1 }");
      expect(s.kind).toBe("while_stmt");
      expect((s as any).condition.kind).toBe("binary");
    });

    it('should parse for-in loop', () => {
      const [s] = parseOk("for x in arr { println(x) }");
      expect(s.kind).toBe("for_stmt");
      expect((s as any).variable).toBe("x");
      expect((s as any).iterable).toBeDefined();
    });

    it('should parse return statement', () => {
      const [s] = parseOk("return 42");
      expect(s.kind).toBe("return_stmt");
      expect((s as any).value.kind).toBe("int_lit");
    });
  });

  describe('Binary Operations', () => {
    it('should parse arithmetic operations', () => {
      const e = parseExpr("a + b") as any;
      expect(e.kind).toBe("binary");
      expect(e.op).toBe("+");
      expect(e.left.name).toBe("a");
      expect(e.right.name).toBe("b");
    });

    it('should parse comparison operations', () => {
      const e = parseExpr("x > y") as any;
      expect(e.kind).toBe("binary");
      expect(e.op).toBe(">");
    });

    it('should parse logical operations', () => {
      const e = parseExpr("a && b") as any;
      expect(e.kind).toBe("binary");
      expect(e.op).toBe("&&");
    });

    it('should respect operator precedence', () => {
      const e = parseExpr("a + b * c") as any;
      // Should parse as: a + (b * c)
      expect(e.op).toBe("+");
      expect(e.right.op).toBe("*");
    });
  });

  describe('Error Recovery', () => {
    it('should report parse errors', () => {
      const { errors } = parse("var x: i32 = ;");
      expect(errors.length).toBeGreaterThan(0);
    });

    it('should continue parsing after error', () => {
      const { stmts } = parse("var x: i32 = ;\nlet y = 42");
      expect(stmts.length).toBeGreaterThan(0);
    });
  });

});
