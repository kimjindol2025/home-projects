// Helper Functions
// ============================================================================

fn find_min(data: array<f64>) -> f64 {
    if len(data) == 0 {
        return 0.0;
    }

    let mut min_val = get(data, 0) as f64;
    let mut i = 1;

    while i < len(data) {
        let val = get(data, i) as f64;
        if val < min_val {
            min_val = val;
        }
        i = i + 1;
    }

    min_val
}

fn find_max(data: array<f64>) -> f64 {
    if len(data) == 0 {
        return 1.0;
    }

    let mut max_val = get(data, 0) as f64;
    let mut i = 1;

    while i < len(data) {
        let val = get(data, i) as f64;
        if val > max_val {
            max_val = val;
        }
        i = i + 1;
    }

    max_val
}

fn find_max_2d(data: array<array<f64>>) -> f64 {
    let mut max_val = 0.0;
    let mut i = 0;

    while i < len(data) {
        let row = get(data, i) as array<f64>;
        let row_max = find_max(row);
        if row_max > max_val {
            max_val = row_max;
        }
        i = i + 1;
    }

    max_val
}

