pub struct ChartConfig {
    width: u32,
    height: u32,
    padding: u32,
    title: string,
    y_label: string,
    x_label: string,
}

// ============================================================================
// Line Chart (K3: < 500ms)
// ============================================================================

pub fn render_line_chart(
    data: array<f64>,
    timestamps: array<u64>,
    config: ChartConfig
) -> string {
    let mut svg = "<?xml version=\"1.0\"?>";
    svg = svg + "<svg width=\"" + to_string(config.width) + "\" height=\"" + to_string(config.height) + "\">";

    // Background
    svg = svg + "<rect width=\"" + to_string(config.width) + "\" height=\"" + to_string(config.height) + "\" fill=\"white\"/>";

    // Title
    if config.title != "" {
        svg = svg + "<text x=\"50\" y=\"30\" font-size=\"18\" font-weight=\"bold\">" + config.title + "</text>";
    }

    // Axis
    svg = svg + "<line x1=\"" + to_string(config.padding) + "\" y1=\"" + to_string(config.height - config.padding) + "\" x2=\"" + to_string(config.width - config.padding) + "\" y2=\"" + to_string(config.height - config.padding) + "\" stroke=\"black\" stroke-width=\"2\"/>";
    svg = svg + "<line x1=\"" + to_string(config.padding) + "\" y1=\"" + to_string(config.padding) + "\" x2=\"" + to_string(config.padding) + "\" y2=\"" + to_string(config.height - config.padding) + "\" stroke=\"black\" stroke-width=\"2\"/>";

    // Find min/max for scaling
    let min_val = find_min(data);
    let max_val = find_max(data);
    let val_range = max_val - min_val;

    // Draw points and line
    let plot_width = (config.width - (config.padding * 2)) as f64;
    let plot_height = (config.height - (config.padding * 2)) as f64;

    let mut i = 0;
    let mut prev_x = 0u32;
    let mut prev_y = 0u32;

    while i < len(data) {
        let val = get(data, i) as f64;
        let x = config.padding + ((i as f64 / (len(data) as f64)) * plot_width) as u32;
        let y_normalized = (val - min_val) / val_range;
        let y = config.height - config.padding - (y_normalized * plot_height) as u32;

        // Draw line segment
        if i > 0 {
            svg = svg + "<line x1=\"" + to_string(prev_x) + "\" y1=\"" + to_string(prev_y) + "\" x2=\"" + to_string(x) + "\" y2=\"" + to_string(y) + "\" stroke=\"#2196F3\" stroke-width=\"2\"/>";
        }

        // Draw point
        svg = svg + "<circle cx=\"" + to_string(x) + "\" cy=\"" + to_string(y) + "\" r=\"3\" fill=\"#2196F3\"/>";

        prev_x = x;
        prev_y = y;
        i = i + 1;
    }

    // Y-axis labels
    svg = svg + "<text x=\"10\" y=\"" + to_string(config.padding + 5) + "\" font-size=\"12\">" + to_string(max_val as i32) + "</text>";
    svg = svg + "<text x=\"10\" y=\"" + to_string(config.height - config.padding + 15) + "\" font-size=\"12\">" + to_string(min_val as i32) + "</text>";

    svg = svg + "</svg>";
    svg
}

// ============================================================================
// Bar Chart
// ============================================================================

pub fn render_bar_chart(
    data: array<f64>,
    labels: array<string>
) -> string {
    let mut svg = "<svg width=\"800\" height=\"400\">";

    // Background
    svg = svg + "<rect width=\"800\" height=\"400\" fill=\"white\"/>";

    // Bars
    let max_val = find_max(data);
    let bar_width = 70u32;
    let chart_height = 300u32;

    let mut i = 0;
    while i < len(data) {
        let val = get(data, i) as f64;
        let height = ((val / max_val) * (chart_height as f64)) as u32;
        let x = 50 + (i as u32 * (bar_width + 10));
        let y = 50 + chart_height - height;

        // Bar
        svg = svg + "<rect x=\"" + to_string(x) + "\" y=\"" + to_string(y) + "\" width=\"" + to_string(bar_width) + "\" height=\"" + to_string(height) + "\" fill=\"#4CAF50\"/>";

        // Label
        svg = svg + "<text x=\"" + to_string(x + 10) + "\" y=\"" + to_string(y + chart_height + 25) + "\" font-size=\"12\">" + (get(labels, i) as string) + "</text>";

        // Value
        svg = svg + "<text x=\"" + to_string(x + 10) + "\" y=\"" + to_string(y - 5) + "\" font-size=\"12\">" + to_string(val as i32) + "</text>";

        i = i + 1;
    }

    svg = svg + "</svg>";
    svg
}

// ============================================================================
// Gauge Chart
// ============================================================================

pub fn render_gauge(
    value: f64,
    min: f64,
    max: f64,
    label: string
) -> string {
    let mut svg = "<svg width=\"300\" height=\"200\" viewBox=\"0 0 300 200\">";

    // Background circle
    svg = svg + "<circle cx=\"150\" cy=\"150\" r=\"120\" fill=\"#f0f0f0\" stroke=\"#999\" stroke-width=\"2\"/>";

    // Gauge arc (simplified: 180 degree arc)
    let range = max - min;
    let normalized = (value - min) / range;
    let angle = 180.0 * normalized;  // 0-180 degrees

    // Color based on value
    let color = if normalized < 0.33 {
        "#f44336"  // Red
    } else if normalized < 0.66 {
        "#ff9800"  // Orange
    } else {
        "#4CAF50"  // Green
    };

    svg = svg + "<path d=\"M 30 150 A 120 120 0 0 1 270 150\" fill=\"none\" stroke=\"#ddd\" stroke-width=\"20\"/>";

    // Value arc
    let end_x = 150.0 + 120.0 * (angle * 0.0174533).cos();
    let end_y = 150.0 + 120.0 * (angle * 0.0174533).sin();

    svg = svg + "<path d=\"M 30 150 A 120 120 0 0 1 " + to_string(end_x as i32) + " " + to_string(end_y as i32) + "\" fill=\"none\" stroke=\"" + color + "\" stroke-width=\"20\"/>";

    // Value text
    svg = svg + "<text x=\"150\" y=\"150\" text-anchor=\"middle\" font-size=\"36\" font-weight=\"bold\">" + to_string(value as i32) + "</text>";

    // Label
    svg = svg + "<text x=\"150\" y=\"180\" text-anchor=\"middle\" font-size=\"14\">" + label + "</text>";

    svg = svg + "</svg>";
    svg
}

// ============================================================================
// Stat Panel
// ============================================================================

pub fn render_stat_panel(
    value: f64,
    title: string,
    unit: string,
    status: string
) -> string {
    let color = if status == "ok" {
        "#4CAF50"
    } else if status == "warning" {
        "#ff9800"
    } else {
        "#f44336"
    };

    let html = "<div style=\"border: 2px solid " + color + "; padding: 20px; border-radius: 8px; text-align: center;\">";
    html = html + "<h3 style=\"color: #666;\">" + title + "</h3>";
    html = html + "<p style=\"font-size: 36px; font-weight: bold; color: " + color + ";\">" + to_string(value as i32) + " " + unit + "</p>";
    html = html + "<p style=\"color: " + color + "; font-size: 12px;\">" + status + "</p>";
    html = html + "</div>";

    html
}

// ============================================================================
// Heatmap
// ============================================================================

pub fn render_heatmap(
    data: array<array<f64>>
) -> string {
    let mut svg = "<svg width=\"600\" height=\"400\">";

    // Find max value for color scaling
    let max_val = find_max_2d(data);

    let cell_width = 30u32;
    let cell_height = 30u32;

    let mut i = 0;
    while i < len(data) {
        let row = get(data, i) as array<f64>;
        let mut j = 0;

        while j < len(row) {
            let val = get(row, j) as f64;
            let intensity = (val / max_val) * 255.0;
            let color = "rgb(" + to_string(intensity as i32) + ",0," + to_string((255.0 - intensity) as i32) + ")";

            let x = 50 + (j as u32 * cell_width);
            let y = 50 + (i as u32 * cell_height);

            svg = svg + "<rect x=\"" + to_string(x) + "\" y=\"" + to_string(y) + "\" width=\"" + to_string(cell_width) + "\" height=\"" + to_string(cell_height) + "\" fill=\"" + color + "\" stroke=\"#ccc\"/>";

            j = j + 1;
        }

        i = i + 1;
    }

    svg = svg + "</svg>";
    svg
}

