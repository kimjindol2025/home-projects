 * 무관용 규칙:
 *   K6: 알림 지연 < 5초 (임계값 감지 후)
 */

pub struct AlertRule {
    rule_id: string,
    name: string,
    metric_name: string,
    condition: string,         // ">" | "<" | "==" | "!="
    threshold: f64,
    duration_sec: u32,         // How long threshold must be exceeded
    severity: string,          // "critical" | "warning" | "info"
    enabled: bool,
}

pub struct Alert {
    alert_id: string,
    rule_id: string,
    name: string,
    value: f64,
    threshold: f64,
    severity: string,
    fired_at_ms: u64,
    triggered: bool,
}

pub struct AlertManager {
    rules: array<AlertRule>,
    active_alerts: array<Alert>,
    rule_count: u32,
    alert_count: u32,
}

// ============================================================================
// Initialize Alert Manager
// ============================================================================

pub fn init_alert_manager() -> AlertManager {
    AlertManager {
        rules: array<AlertRule> {},
        active_alerts: array<Alert> {},
        rule_count: 0,
        alert_count: 0,
    }
}

// ============================================================================
// Create and Register Alert Rule
// ============================================================================

pub fn create_rule(
    name: string,
    metric_name: string,
    condition: string,
    threshold: f64,
    severity: string
) -> AlertRule {
    AlertRule {
        rule_id: generate_id(),
        name: name,
        metric_name: metric_name,
        condition: condition,
        threshold: threshold,
        duration_sec: 60,  // Rule fires after 60s threshold exceeded
        severity: severity,
        enabled: true,
    }
}

pub fn register_rule(
    manager: AlertManager,
    rule: AlertRule
) -> bool {
    push(manager.rules, rule);
    manager.rule_count = manager.rule_count + 1;
    true
}

// ============================================================================
// Evaluate Rules (K6: < 5s)
// ============================================================================

pub fn evaluate_rules(
    manager: AlertManager,
    metrics: map<string, f64>,
    current_time_ms: u64
) -> array<Alert> {
    let mut triggered_alerts = array<Alert> {};

    let mut i = 0;
    while i < len(manager.rules) {
        let rule = get(manager.rules, i) as AlertRule;

        if !rule.enabled {
            i = i + 1;
            continue;
        }

        // Get metric value
        let metric_value = get(metrics, rule.metric_name) as f64;

        // Check condition
        let condition_met = evaluate_condition(
            metric_value,
            rule.threshold,
            rule.condition
        );

        if condition_met {
            // Fire alert
            let alert = Alert {
                alert_id: generate_id(),
                rule_id: rule.rule_id,
                name: rule.name,
                value: metric_value,
                threshold: rule.threshold,
                severity: rule.severity,
                fired_at_ms: current_time_ms,
                triggered: true,
            };

            push(triggered_alerts, alert);
            push(manager.active_alerts, alert);
            manager.alert_count = manager.alert_count + 1;
        }

        i = i + 1;
    }

    triggered_alerts
}

fn evaluate_condition(
    value: f64,
    threshold: f64,
    condition: string
) -> bool {
    if condition == ">" {
        value > threshold
    } else if condition == "<" {
        value < threshold
    } else if condition == "==" {
        value == threshold
    } else if condition == "!=" {
        value != threshold
    } else {
        false
    }
}

// ============================================================================
// Alert Management
// ============================================================================

pub fn get_active_alerts(manager: AlertManager) -> array<Alert> {
    manager.active_alerts
}

pub fn resolve_alert(
    manager: AlertManager,
    alert_id: string
) -> bool {
    // Remove alert from active list
    let mut i = 0;
    while i < len(manager.active_alerts) {
        let alert = get(manager.active_alerts, i) as Alert;
        if alert.alert_id == alert_id {
            // Mark as resolved (simplified: remove from array)
            // In production: use proper array deletion
            alert.triggered = false;
        }
        i = i + 1;
    }

    true
}

pub fn get_alert_summary(manager: AlertManager) -> map<string, i32> {
    let mut summary = map<string, i32> {};

    let critical_count = 0;
    let warning_count = 0;
    let info_count = 0;

    let mut i = 0;
    while i < len(manager.active_alerts) {
        let alert = get(manager.active_alerts, i) as Alert;

        if alert.severity == "critical" {
            let _ = critical_count + 1;
        } else if alert.severity == "warning" {
            let _ = warning_count + 1;
        } else {
            let _ = info_count + 1;
        }

        i = i + 1;
    }

    set(summary, "critical", critical_count);
    set(summary, "warning", warning_count);
    set(summary, "info", info_count);

    summary
}

