// Read Segment
// ============================================================================

pub fn read_segment(
    manager: StorageManager,
    metric_name: string,
    segment_id: u32
) -> array<any> {
    // Build file path
    let file_path = build_segment_path(manager.config.base_dir, metric_name, segment_id);

    // Read from file
    let data = read_file(file_path);

    // Deserialize to DataPoint array
    deserialize_points(data)
}

pub fn read_range(
    manager: StorageManager,
    metric_name: string,
    from_ms: u64,
    to_ms: u64
) -> array<any> {
    let mut result = array<any> {};

    // Calculate segment IDs
    let from_segment = (from_ms / 1000) / (manager.config.segment_duration_sec as u64);
    let to_segment = (to_ms / 1000) / (manager.config.segment_duration_sec as u64);

    let mut segment_id = from_segment;
    while segment_id <= to_segment {
        let points = read_segment(manager, metric_name, segment_id as u32);
        let mut i = 0;
        while i < len(points) {
            let point = get(points, i);
            push(result, point);
            i = i + 1;
        }
        segment_id = segment_id + 1;
    }

    result
}

