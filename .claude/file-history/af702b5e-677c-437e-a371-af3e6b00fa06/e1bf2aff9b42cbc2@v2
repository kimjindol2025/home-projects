pub struct StorageConfig {
    base_dir: string,             // /data/kimgraf
    segment_duration_sec: u32,    // 3600 = 1 hour per segment
    compression: bool,            // gzip compression
    retention_days: u32,          // 30 days
}

pub struct StorageSegment {
    metric_name: string,
    segment_id: u32,              // timestamp / segment_duration
    points_count: u32,
    min_ts: u64,
    max_ts: u64,
    file_size_bytes: u32,
}

pub struct StorageManager {
    config: StorageConfig,
    segments: map<string, array<StorageSegment>>,
    current_segment: map<string, u32>,
}

// ============================================================================
// Initialize Storage
// ============================================================================

pub fn init_storage(
    base_dir: string,
    retention_days: u32
) -> StorageManager {
    StorageManager {
        config: StorageConfig {
            base_dir: base_dir,
            segment_duration_sec: 3600,  // 1 hour segments
            compression: true,
            retention_days: retention_days,
        },
        segments: map<string, array<StorageSegment>> {},
        current_segment: map<string, u32> {},
    }
}

// ============================================================================
// Write Segment
// ============================================================================

pub fn write_segment(
    manager: StorageManager,
    metric_name: string,
    points: array<any>,  // array of DataPoint
    timestamp_ms: u64
) -> bool {
    // Create segment ID based on time
    let segment_id = (timestamp_ms / 1000) / (manager.config.segment_duration_sec as u64);

    // Build file path: {base_dir}/{metric_name}/{segment_id}.tsdb
    let file_path = build_segment_path(
        manager.config.base_dir,
        metric_name,
        segment_id as u32
    );

    // Serialize points to binary format
    let serialized = serialize_points(points);

    // Write to file
    let written = write_file(file_path, serialized);

    if written {
        // Track segment metadata
        register_segment(manager, metric_name, segment_id as u32, len(points) as u32);
    }

    written
}

fn build_segment_path(
    base_dir: string,
    metric_name: string,
    segment_id: u32
) -> string {
    // /data/kimgraf/{metric_name}/{segment_id}.tsdb
    base_dir + "/" + metric_name + "/" + to_string(segment_id) + ".tsdb"
}

fn register_segment(
    manager: StorageManager,
    metric_name: string,
    segment_id: u32,
    points_count: u32
) -> void {
    let segment = StorageSegment {
        metric_name: metric_name,
        segment_id: segment_id,
        points_count: points_count,
        min_ts: (segment_id as u64) * 1000 * (manager.config.segment_duration_sec as u64),
        max_ts: ((segment_id + 1) as u64) * 1000 * (manager.config.segment_duration_sec as u64),
        file_size_bytes: points_count * 16,  // ~16 bytes per point
    };

    // Add to segment map
    if get(manager.segments, metric_name) == null {
        set(manager.segments, metric_name, array<StorageSegment> {});
    }

    let segments = get(manager.segments, metric_name) as array<StorageSegment>;
    push(segments, segment);
}

