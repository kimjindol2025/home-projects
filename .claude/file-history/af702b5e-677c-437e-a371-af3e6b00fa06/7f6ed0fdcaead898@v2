// Cluster Simulator: Real-time Multi-node Energy Management Validation (550줄)
// Phase 6: 3-5 노드 시뮬레이션 + 12가지 전력 패턴 + 합의 검증

use std::collections::VecDeque;

/// ============================================================================
/// Module 1: Node Simulator (Single Node Simulation)
/// ============================================================================

/// 독립 노드 시뮬레이션: 전력, 배터리, 온도, 워크로드
pub struct NodeSimulator {
    /// 노드 ID (0-4)
    node_id: usize,

    /// 현재 상태 (mW)
    current_power: f64,

    /// 배터리 레벨 (0.0-1.0)
    battery_level: f64,

    /// 온도 (°C)
    temperature: f64,

    /// 처리 중인 워크로드 (작업 수)
    workload_queue: usize,

    /// CPU 주파수 (MHz: 800-3600)
    frequency_mhz: u16,

    /// DVFS 상태 (0=Low, 1=Med, 2=High, 3=Turbo)
    dvfs_state: u8,

    /// Sleep 상태 (0=C0, 1=C2, 2=C4, 3=C6)
    sleep_state: u8,

    /// 배터리 소비 히스토리
    power_history: VecDeque<f64>,
    max_history: usize,

    /// 온도 히스토리
    temp_history: VecDeque<f64>,
}

impl NodeSimulator {
    /// 새 노드 생성
    pub fn new(node_id: usize) -> Self {
        NodeSimulator {
            node_id,
            current_power: 100.0,  // 100mW default
            battery_level: 1.0,     // 100% 만충
            temperature: 35.0,      // 35°C ambient
            workload_queue: 0,
            frequency_mhz: 1600,    // Mid frequency
            dvfs_state: 1,
            sleep_state: 0,
            power_history: VecDeque::new(),
            max_history: 100,
            temp_history: VecDeque::new(),
        }
    }

    /// 시뮬레이션 사이클 실행 (10ms)
    pub fn execute_cycle(&mut self, incoming_workload: usize) {
        // 1. 워크로드 추가
        self.workload_queue += incoming_workload;

        // 2. DVFS 결정 (간단한 규칙: 워크로드 기반)
        self.update_dvfs_state();

        // 3. 전력 계산
        self.calculate_power();

        // 4. 배터리 감소
        self.update_battery();

        // 5. 온도 계산
        self.update_temperature();

        // 6. 워크로드 처리 (주파수에 따라)
        self.process_workload();

        // 7. 히스토리 저장
        self.power_history.push_back(self.current_power);
        if self.power_history.len() > self.max_history {
            self.power_history.pop_front();
        }

        self.temp_history.push_back(self.temperature);
        if self.temp_history.len() > self.max_history {
            self.temp_history.pop_front();
        }
    }

    fn update_dvfs_state(&mut self) {
        if self.workload_queue > 50 {
            self.dvfs_state = 3;  // Turbo
            self.frequency_mhz = 3600;
        } else if self.workload_queue > 30 {
            self.dvfs_state = 2;  // High
            self.frequency_mhz = 2400;
        } else if self.workload_queue > 10 {
            self.dvfs_state = 1;  // Medium
            self.frequency_mhz = 1600;
        } else {
            self.dvfs_state = 0;  // Low
            self.frequency_mhz = 800;
        }
    }

    fn calculate_power(&mut self) {
        // Base power: 40mW + frequency scaling
        let freq_factor = (self.frequency_mhz as f64 / 1600.0) * 1.5;
        let workload_factor = 1.0 + (self.workload_queue as f64 / 100.0);

        self.current_power = 40.0 + (30.0 * freq_factor * workload_factor);

        // Temperature effect
        let temp_factor = 1.0 + ((self.temperature - 25.0) / 100.0);
        self.current_power *= temp_factor;

        // Thermal throttling
        if self.temperature > 80.0 {
            self.current_power *= 0.7;  // 30% reduction
        }
    }

    fn update_battery(&mut self) {
        // 배터리 소비: 1시간(3600초) 동안 1000mAh @ 3.7V = 11.1Wh
        // 10ms 사이클 = 30.8mWs
        let power_per_cycle = self.current_power * 0.01 / 3600.0;  // 10ms in hours
        let battery_drain = power_per_cycle / 11.1;

        self.battery_level = (self.battery_level - battery_drain).max(0.0);
    }

    fn update_temperature(&mut self) {
        // Temperature equation: dT/dt = (Power/10 - Cooling) / ThermalMass
        let power_heat = self.current_power / 100.0;  // mW to heat unit
        let cooling = (self.temperature - 25.0) * 0.2;  // Natural cooling
        let thermal_mass = 20.0;

        let delta_temp = (power_heat - cooling) / thermal_mass;
        self.temperature += delta_temp * 0.01;  // 10ms
    }

    fn process_workload(&mut self) {
        // 처리 용량: 주파수에 따라 (800MHz = 10 jobs/10ms, 3600MHz = 45 jobs/10ms)
        let processing_capacity = (self.frequency_mhz as usize / 100) + 5;
        let processed = self.workload_queue.min(processing_capacity);
        self.workload_queue -= processed;
    }

    /// 평균 전력 소비 (최근 100 사이클)
    pub fn avg_power(&self) -> f64 {
        if self.power_history.is_empty() {
            return 0.0;
        }
        self.power_history.iter().sum::<f64>() / self.power_history.len() as f64
    }

    /// 리더 선택 점수 (배터리 + 온도 고려)
    pub fn leader_score(&self) -> f64 {
        let battery_score = self.battery_level * 50.0;  // 0-50
        let temp_penalty = if self.temperature > 70.0 {
            ((self.temperature - 70.0) / 30.0) * 20.0
        } else {
            0.0
        };

        battery_score - temp_penalty
    }

    pub fn node_id(&self) -> usize { self.node_id }
    pub fn battery(&self) -> f64 { self.battery_level }
    pub fn temperature(&self) -> f64 { self.temperature }
    pub fn workload(&self) -> usize { self.workload_queue }
}

/// ============================================================================
/// Module 2: Cluster Coordinator (Multi-node Consensus)
/// ============================================================================

/// 클러스터 조율: 노드 간 통신 + 합의 + 메트릭 수집
pub struct ClusterCoordinator {
    /// 시뮬레이션 노드들 (최대 5개)
    nodes: Vec<NodeSimulator>,

    /// 리더 노드 ID
    leader_id: usize,

    /// 합의 라운드 번호
    consensus_round: usize,

    /// 지난 합의 완료 시간 (ms)
    last_consensus_time: f64,

    /// 합의 지연 히스토리
    consensus_times: VecDeque<f64>,

    /// 전체 에너지 소비 (J)
    total_energy: f64,

    /// 장애 노드 ID (None = 정상)
    failed_node: Option<usize>,
}

impl ClusterCoordinator {
    /// 새 클러스터 생성 (3-5 노드)
    pub fn new(num_nodes: usize) -> Self {
        let num_nodes = num_nodes.min(5).max(3);
        let nodes = (0..num_nodes)
            .map(|i| NodeSimulator::new(i))
            .collect();

        ClusterCoordinator {
            nodes,
            leader_id: 0,
            consensus_round: 0,
            last_consensus_time: 0.0,
            consensus_times: VecDeque::new(),
            total_energy: 0.0,
            failed_node: None,
        }
    }

    /// 클러스터 사이클 실행
    pub fn execute_cluster_cycle(&mut self, workload_per_node: Vec<usize>) {
        // 1. 모든 노드 실행
        for (i, node) in self.nodes.iter_mut().enumerate() {
            let load = workload_per_node.get(i).copied().unwrap_or(0);
            node.execute_cycle(load);
        }

        // 2. 합의 라운드
        self.run_consensus();

        // 3. 리더 재선출
        self.elect_leader();

        // 4. 에너지 누적
        for node in &self.nodes {
            self.total_energy += node.avg_power() * 0.01 / 3600.0 / 1000.0;  // Joules
        }

        self.consensus_round += 1;
    }

    fn run_consensus(&mut self) {
        // Raft-like 합의: 모든 노드 Replicate
        let start_time = self.consensus_round as f64 * 0.1;

        // 시뮬레이션: 배터리 고려 복제 (100ms 기본, 배터리 낮으면 200ms)
        let mut consensus_time = 100.0;
        for node in &self.nodes {
            if node.battery() < 0.2 {
                consensus_time += 50.0;  // Slow replica
            }
        }

        self.last_consensus_time = consensus_time;
        self.consensus_times.push_back(consensus_time);
        if self.consensus_times.len() > 50 {
            self.consensus_times.pop_front();
        }
    }

    fn elect_leader(&mut self) {
        // 가장 높은 점수의 노드가 리더
        let mut best_score = -1.0f64;
        let mut best_id = self.leader_id;

        for node in &self.nodes {
            if self.failed_node.is_some() && self.failed_node.unwrap() == node.node_id() {
                continue;  // Skip failed nodes
            }

            let score = node.leader_score();
            if score > best_score {
                best_score = score;
                best_id = node.node_id();
            }
        }

        self.leader_id = best_id;
    }

    /// 노드 장애 주입 (테스트용)
    pub fn inject_failure(&mut self, node_id: usize) {
        if node_id < self.nodes.len() {
            self.failed_node = Some(node_id);
        }
    }

    /// 장애 복구
    pub fn recover_node(&mut self, _node_id: usize) {
        self.failed_node = None;
    }

    /// 평균 합의 시간 (최근 50 라운드)
    pub fn avg_consensus_time(&self) -> f64 {
        if self.consensus_times.is_empty() {
            return 0.0;
        }
        self.consensus_times.iter().sum::<f64>() / self.consensus_times.len() as f64
    }

    /// 클러스터 평균 배터리
    pub fn avg_battery(&self) -> f64 {
        if self.nodes.is_empty() {
            return 0.0;
        }
        self.nodes.iter().map(|n| n.battery()).sum::<f64>() / self.nodes.len() as f64
    }

    /// 클러스터 총 전력 (mW)
    pub fn total_power(&self) -> f64 {
        self.nodes.iter().map(|n| n.avg_power()).sum()
    }

    pub fn num_nodes(&self) -> usize { self.nodes.len() }
    pub fn leader_id(&self) -> usize { self.leader_id }
    pub fn consensus_round(&self) -> usize { self.consensus_round }
}

/// ============================================================================
/// Module 3: Scenario Runner (Pattern Simulation)
/// ============================================================================

/// 12가지 전력 패턴 시뮬레이션
#[derive(Clone)]
pub enum PowerPattern {
    Idle,           // 유휴: 2-5 jobs/cycle
    Periodic,       // 주기적: 20-30 jobs/cycle
    Bursty,         // 버스트: 0, 0, 0, 100 반복
    Gradual,        // 점진적: 0→100 완만한 증가
    Wave,           // 파동: 50MHz 사인파
    Random,         // 무작위: 0-100 변동
    HighLoad,       // 고부하: 80-100 지속
    LowLoad,        // 저부하: 5-15 지속
    Night,          // 야간: 2-8 반복
    Morning,        // 아침: 20-40 증가
    Afternoon,      // 오후: 50-70 고부하
    Evening,        // 저녁: 30-50 감소
}

/// 시나리오 실행기
pub struct ScenarioRunner {
    /// 클러스터
    cluster: ClusterCoordinator,

    /// 현재 시뮬레이션 단계
    cycle: usize,

    /// 현재 패턴
    current_pattern: PowerPattern,

    /// 패턴별 성능 메트릭
    pattern_results: Vec<(String, f64, f64)>,  // (name, avg_power, avg_consensus)
}

impl ScenarioRunner {
    /// 새 시나리오 실행기
    pub fn new(num_nodes: usize) -> Self {
        ScenarioRunner {
            cluster: ClusterCoordinator::new(num_nodes),
            cycle: 0,
            current_pattern: PowerPattern::Idle,
            pattern_results: Vec::new(),
        }
    }

    /// 패턴별 시뮬레이션 실행 (각 패턴 100 사이클)
    pub fn run_all_patterns(&mut self) {
        let patterns = vec![
            PowerPattern::Idle,
            PowerPattern::Periodic,
            PowerPattern::Bursty,
            PowerPattern::Gradual,
            PowerPattern::Wave,
            PowerPattern::Random,
            PowerPattern::HighLoad,
            PowerPattern::LowLoad,
            PowerPattern::Night,
            PowerPattern::Morning,
            PowerPattern::Afternoon,
            PowerPattern::Evening,
        ];

        for pattern in patterns {
            self.run_pattern(pattern, 100);
        }
    }

    /// 특정 패턴 실행
    pub fn run_pattern(&mut self, pattern: PowerPattern, num_cycles: usize) {
        self.current_pattern = pattern.clone();
        let pattern_name = format!("{:?}", pattern);

        let mut total_power = 0.0;
        let mut total_consensus = 0.0;
        let mut count = 0;

        for cycle in 0..num_cycles {
            let workload = self.generate_workload(&pattern, cycle);
            let workload_per_node = vec![workload / self.cluster.num_nodes(); self.cluster.num_nodes()];

            self.cluster.execute_cluster_cycle(workload_per_node);

            total_power += self.cluster.total_power();
            total_consensus += self.cluster.avg_consensus_time();
            count += 1;
        }

        let avg_power = total_power / count as f64;
        let avg_consensus = total_consensus / count as f64;

        self.pattern_results.push((pattern_name, avg_power, avg_consensus));
    }

    fn generate_workload(&self, pattern: &PowerPattern, cycle: usize) -> usize {
        match pattern {
            PowerPattern::Idle => 3,
            PowerPattern::Periodic => 25 + (cycle % 5) as usize * 2,
            PowerPattern::Bursty => match cycle % 4 {
                0..=2 => 0,
                _ => 90,
            },
            PowerPattern::Gradual => (cycle * 100 / 100).min(100),
            PowerPattern::Wave => (50.0 + 40.0 * ((cycle as f64 * 0.1).sin())) as usize,
            PowerPattern::Random => (cycle * 73 % 101) as usize,  // Pseudo-random
            PowerPattern::HighLoad => 85 + (cycle % 15) as usize,
            PowerPattern::LowLoad => 10 + (cycle % 5) as usize,
            PowerPattern::Night => 5,
            PowerPattern::Morning => 20 + (cycle * 30 / 100).min(30),
            PowerPattern::Afternoon => 60 + (cycle % 10) as usize,
            PowerPattern::Evening => 50 - (cycle * 20 / 100).min(20),
        }
    }

    /// 최종 보고서
    pub fn generate_report(&self) -> String {
        let mut report = String::from("=== Phase 6 Cluster Simulation Report ===\n\n");
        report.push_str(&format!("Cluster: {} nodes\n", self.cluster.num_nodes()));
        report.push_str(&format!("Total Consensus Rounds: {}\n\n", self.cluster.consensus_round));

        report.push_str("Pattern Results:\n");
        report.push_str("Pattern\t\tAvg Power (mW)\tAvg Consensus (ms)\n");
        report.push_str("---\t\t---\t\t---\n");

        for (name, power, consensus) in &self.pattern_results {
            report.push_str(&format!("{}\t\t{:.1}\t\t{:.1}\n", name, power, consensus));
        }

        if !self.pattern_results.is_empty() {
            let avg_power: f64 = self.pattern_results.iter().map(|x| x.1).sum::<f64>() / self.pattern_results.len() as f64;
            let avg_consensus: f64 = self.pattern_results.iter().map(|x| x.2).sum::<f64>() / self.pattern_results.len() as f64;

            report.push_str(&format!("\nOverall Average Power: {:.1} mW\n", avg_power));
            report.push_str(&format!("Overall Average Consensus: {:.1} ms\n", avg_consensus));

            // Check unforgiving rule: Consensus < 150ms
            if avg_consensus < 150.0 {
                report.push_str("✅ Consensus < 150ms: PASS\n");
            } else {
                report.push_str("❌ Consensus < 150ms: FAIL\n");
            }
        }

        report
    }
}

/// ============================================================================
/// Tests
/// ============================================================================

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_node_simulator_creation() {
        let node = NodeSimulator::new(0);
        assert_eq!(node.node_id(), 0);
        assert_eq!(node.battery(), 1.0);
    }

    #[test]
    fn test_node_simulator_power_calculation() {
        let mut node = NodeSimulator::new(0);
        node.execute_cycle(20);
        assert!(node.avg_power() > 0.0);
    }

    #[test]
    fn test_node_simulator_battery_drain() {
        let mut node = NodeSimulator::new(0);
        let initial_battery = node.battery();

        for _ in 0..100 {
            node.execute_cycle(10);
        }

        assert!(node.battery() < initial_battery);
    }

    #[test]
    fn test_node_simulator_temperature() {
        let mut node = NodeSimulator::new(0);

        for _ in 0..50 {
            node.execute_cycle(80);  // High workload
        }

        assert!(node.temperature() > 35.0);
    }

    #[test]
    fn test_cluster_creation() {
        let cluster = ClusterCoordinator::new(4);
        assert_eq!(cluster.num_nodes(), 4);
    }

    #[test]
    fn test_cluster_execution() {
        let mut cluster = ClusterCoordinator::new(3);
        let workload = vec![20, 20, 20];

        cluster.execute_cluster_cycle(workload);
        assert!(cluster.total_power() > 0.0);
    }

    #[test]
    fn test_cluster_leader_election() {
        let mut cluster = ClusterCoordinator::new(3);
        let workload = vec![20, 20, 20];

        for _ in 0..10 {
            cluster.execute_cluster_cycle(workload.clone());
        }

        assert!(cluster.leader_id() < cluster.num_nodes());
    }

    #[test]
    fn test_cluster_consensus_timing() {
        let mut cluster = ClusterCoordinator::new(3);
        let workload = vec![20, 20, 20];

        for _ in 0..20 {
            cluster.execute_cluster_cycle(workload.clone());
        }

        let avg_consensus = cluster.avg_consensus_time();
        assert!(avg_consensus > 0.0 && avg_consensus < 200.0);
    }

    #[test]
    fn test_cluster_failure_recovery() {
        let mut cluster = ClusterCoordinator::new(3);
        let workload = vec![20, 20, 20];

        cluster.inject_failure(0);
        cluster.execute_cluster_cycle(workload.clone());
        assert_ne!(cluster.leader_id(), 0);

        cluster.recover_node(0);
        cluster.execute_cluster_cycle(workload);
    }

    #[test]
    fn test_scenario_runner_idle_pattern() {
        let mut runner = ScenarioRunner::new(3);
        runner.run_pattern(PowerPattern::Idle, 50);

        assert!(!runner.pattern_results.is_empty());
        let (_, power, _) = runner.pattern_results.last().unwrap();
        assert!(*power < 50.0);  // Idle should be low power
    }

    #[test]
    fn test_scenario_runner_high_load() {
        let mut runner = ScenarioRunner::new(3);
        runner.run_pattern(PowerPattern::HighLoad, 50);

        let (_, power, _) = runner.pattern_results.last().unwrap();
        assert!(*power > 100.0);  // High load should consume more
    }

    #[test]
    fn test_scenario_runner_all_patterns() {
        let mut runner = ScenarioRunner::new(3);
        runner.run_all_patterns();

        assert_eq!(runner.pattern_results.len(), 12);
    }

    #[test]
    fn test_scenario_runner_consensus_rule() {
        let mut runner = ScenarioRunner::new(3);
        runner.run_all_patterns();

        let report = runner.generate_report();
        assert!(report.contains("Overall Average Consensus"));
    }
}
