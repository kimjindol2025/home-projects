// ============================================================================
// Circuit Breaker Pattern
// ============================================================================

pub struct CircuitBreakerConfig {
    failure_threshold: u32,  // failures before open
    success_threshold: u32,  // successes before closed
    timeout_ms: u32,  // time in open state
    half_open_max_calls: u32,
}

pub struct CircuitBreakerState {
    state: string,  // "Closed" | "Open" | "HalfOpen"
    failure_count: u32,
    success_count: u32,
    last_failure_ms: u64,
    total_requests: u64,
    total_failures: u64,
}

pub struct CircuitBreaker {
    config: CircuitBreakerConfig,
    state: CircuitBreakerState,
}

fn init_circuit_breaker(config: CircuitBreakerConfig) -> CircuitBreaker {
    CircuitBreaker {
        config: config,
        state: CircuitBreakerState {
            state: "Closed",
            failure_count: 0,
            success_count: 0,
            last_failure_ms: 0,
            total_requests: 0,
            total_failures: 0,
        },
    }
}

fn call_with_circuit_breaker(
    breaker: CircuitBreaker,
    current_time_ms: u64
) -> bool {
    // Check state
    if breaker.state.state == "Open" {
        // Check if timeout has passed
        let time_since_failure = current_time_ms - breaker.state.last_failure_ms;
        if time_since_failure >= (breaker.config.timeout_ms as u64) {
            // Transition to HalfOpen
            breaker.state.state = "HalfOpen";
            breaker.state.success_count = 0;
        } else {
            // Still open, reject call
            return false;
        }
    }

    // Try to execute
    let success = execute_operation();
    breaker.state.total_requests = breaker.state.total_requests + 1;

    if !success {
        breaker.state.failure_count = breaker.state.failure_count + 1;
        breaker.state.total_failures = breaker.state.total_failures + 1;
        breaker.state.last_failure_ms = current_time_ms;

        // Open if threshold exceeded
        if breaker.state.failure_count >= breaker.config.failure_threshold {
            breaker.state.state = "Open";
        }

        false
    } else {
        // Success
        if breaker.state.state == "HalfOpen" {
            breaker.state.success_count = breaker.state.success_count + 1;

            // Close if threshold exceeded
            if breaker.state.success_count >= breaker.config.success_threshold {
                breaker.state.state = "Closed";
                breaker.state.failure_count = 0;
            }
        }

        true
    }
}

// ============================================================================
// Retry Policy with Exponential Backoff
// ============================================================================

pub struct RetryPolicy {
    max_retries: u32,
    initial_backoff_ms: u32,
    max_backoff_ms: u32,
    backoff_multiplier: f64,
}

fn execute_with_retry(
    operation: string,
    policy: RetryPolicy,
    current_time_ms: u64
) -> bool {
    let mut attempt = 0;
    let mut backoff_ms = policy.initial_backoff_ms;

    while attempt < policy.max_retries {
        // Try operation
        let success = execute_operation();

        if success {
            return true;
        }

        attempt = attempt + 1;

        // Calculate backoff
        backoff_ms = min_u32(
            (backoff_ms as f64 * policy.backoff_multiplier) as u32,
            policy.max_backoff_ms
        );

        // Wait (simplified)
        sleep_ms(backoff_ms);
    }

    false  // All retries exhausted
}

