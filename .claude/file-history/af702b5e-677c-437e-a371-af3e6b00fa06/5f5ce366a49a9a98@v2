// ============================================================================
// Rate Limiting
// ============================================================================

pub struct RateLimitConfig {
    requests_per_second: u32,
    burst_size: u32,
}

pub struct RateLimiter {
    config: RateLimitConfig,
    available_tokens: u32,
    last_refill_ms: u64,
}

fn init_rate_limiter(config: RateLimitConfig) -> RateLimiter {
    RateLimiter {
        config: config,
        available_tokens: config.burst_size,
        last_refill_ms: 0,
    }
}

fn try_acquire_token(
    limiter: RateLimiter,
    current_time_ms: u64
) -> bool {
    // Refill tokens
    let time_elapsed_ms = current_time_ms - limiter.last_refill_ms;
    let tokens_to_add = (time_elapsed_ms / 1000) * (limiter.config.requests_per_second as u64);

    limiter.available_tokens = min_u32(
        limiter.available_tokens + (tokens_to_add as u32),
        limiter.config.burst_size
    );

    limiter.last_refill_ms = current_time_ms;

    // Try to consume token
    if limiter.available_tokens > 0 {
        limiter.available_tokens = limiter.available_tokens - 1;
        true
    } else {
        false
    }
}

