fn record_request(
    metrics: ProductionMetrics,
    success: bool,
    latency_ms: u32
) -> void {
    metrics.total_requests = metrics.total_requests + 1;

    if !success {
        metrics.total_errors = metrics.total_errors + 1;
    }

    // Update latency percentiles (simplified)
    if latency_ms > metrics.p99_latency_ms {
        metrics.p99_latency_ms = latency_ms;
    }
}

