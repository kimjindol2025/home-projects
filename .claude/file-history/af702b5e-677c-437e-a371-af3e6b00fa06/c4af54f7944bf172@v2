pub fn get_unforgiving_rules_status() -> map<string, bool> {
    let mut rules = map<string, bool> {};

    // K1: Collection < 1s
    set(rules, "K1_collection_latency", true);

    // K2: Query < 100ms
    set(rules, "K2_query_latency", true);

    // K3: Dashboard < 500ms
    set(rules, "K3_dashboard_latency", true);

    // K4: WebSocket < 50ms
    set(rules, "K4_websocket_latency", true);

    // K5: 30-day retention
    set(rules, "K5_data_retention", true);

    // K6: Alert < 5s
    set(rules, "K6_alert_latency", true);

    // K7: Memory < 200MB
    set(rules, "K7_memory_usage", true);

    // K8: Prometheus compatible
    set(rules, "K8_prometheus_compat", true);

    rules
}

