fn test_yaml_generation() {
  let config = K8sConfig {
    namespace: "global-synapse".to_string(),
    deployment_name: "synapse-recovery".to_string(),
    replicas: 3,
    image: "global-synapse:v1.0".to_string(),
    port: 8080,
    cpu_request_m: 500,
    memory_request_mi: 512,
    cpu_limit_m: 1000,
    memory_limit_mi: 1024,
    grace_period_sec: 30,
  };

  let deployment = K8sDeployment::new(config);
  let yaml = deployment.generate_deployment_yaml();

  assert!(yaml.contains("global-synapse"));
  assert!(yaml.contains("synapse-recovery"));
  assert!(yaml.contains("replicas: 3"));

  println!("✅ A1 YAML 생성 검증 통과");
}

