// 레이턴시 측정 (W2: P99 < 200ms)
// 500줄

struct LatencyBucket {
  p50: f64,    // 50th percentile
  p90: f64,    // 90th percentile
  p99: f64,    // 99th percentile
  p99_9: f64,  // 99.9th percentile
  max: f64,    // 최대값
}

struct LatencyProfiler {
  latencies: Vec<f64>,
  total_requests: i64,
  slow_requests: i64,
  request_times: Vec<(i64, i64)>, // (start_us, end_us)
}

impl LatencyProfiler {
  fn new() -> Self {
    Self {
      latencies: Vec::new(),
      total_requests: 0,
      slow_requests: 0,
      request_times: Vec::new(),
    }
  }

  // ========================================================
  // Latency Tracking
  // ========================================================

  fn profile_latencies(&mut self, latencies: Vec<f64>) -> LatencyBucket {
    let mut sorted = latencies.clone();
    sorted.sort_by(|a, b| a.partial_cmp(b).unwrap());

    let len = sorted.len();
    let p50_idx = len / 2;
    let p90_idx = (len * 90 / 100).min(len - 1);
    let p99_idx = (len * 99 / 100).min(len - 1);
    let p99_9_idx = (len * 999 / 1000).min(len - 1);

    let p50 = sorted[p50_idx];
    let p90 = sorted[p90_idx];
    let p99 = sorted[p99_idx];
    let p99_9 = sorted[p99_9_idx];
    let max = sorted[len - 1];

    self.latencies = latencies;

    // W2 검증: P99 < 200ms
    assert!(p99 < 200.0, "W2: P99 {} > 200ms", p99);

    LatencyBucket { p50, p90, p99, p99_9, max }
  }

  fn track_end_to_end_latency(&mut self, start: i64, end: i64) -> f64 {
    let latency_us = (end - start) as f64;
    let latency_ms = latency_us / 1000.0;

    self.latencies.push(latency_ms);
    self.total_requests += 1;
    self.request_times.push((start, end));

    if latency_ms > 200.0 {
      self.slow_requests += 1;
    }

    latency_ms
  }

  // ========================================================
  // Analysis
  // ========================================================

  fn categorize_slow_requests(&self) -> (i64, i64, i64) {
    // (< 100ms, 100-200ms, > 200ms)
    let mut fast = 0;
    let mut medium = 0;
    let mut slow = 0;

    for latency in &self.latencies {
      if *latency < 100.0 {
        fast += 1;
      } else if *latency < 200.0 {
        medium += 1;
      } else {
        slow += 1;
      }
    }

    (fast, medium, slow)
  }

  fn identify_bottlenecks(&self) -> Vec<f64> {
    let mut bottlenecks = Vec::new();

    for latency in &self.latencies {
      if *latency > 150.0 {
        bottlenecks.push(*latency);
      }
    }

    bottlenecks
  }

  fn generate_latency_histogram(&self) -> Vec<(String, i32)> {
    let mut histogram = vec![
      ("<50ms".to_string(), 0),
      ("50-100ms".to_string(), 0),
      ("100-150ms".to_string(), 0),
      ("150-200ms".to_string(), 0),
      (">200ms".to_string(), 0),
    ];

    for latency in &self.latencies {
      match *latency {
        l if l < 50.0 => histogram[0].1 += 1,
        l if l < 100.0 => histogram[1].1 += 1,
        l if l < 150.0 => histogram[2].1 += 1,
        l if l < 200.0 => histogram[3].1 += 1,
        _ => histogram[4].1 += 1,
      }
    }

    histogram
  }

  // ========================================================
  // Statistics
  // ========================================================

  fn get_latency_stats(&self) -> (f64, f64, i64) {
    if self.latencies.is_empty() {
      return (0.0, 0.0, 0);
    }

    let sum: f64 = self.latencies.iter().sum();
    let avg = sum / self.latencies.len() as f64;

    let max = self.latencies.iter().cloned().fold(f64::NEG_INFINITY, f64::max);

    (avg, max, self.slow_requests)
  }

  fn get_percentiles(&self) -> LatencyBucket {
    if self.latencies.is_empty() {
      return LatencyBucket {
        p50: 0.0,
        p90: 0.0,
        p99: 0.0,
        p99_9: 0.0,
        max: 0.0,
      };
    }

    let mut sorted = self.latencies.clone();
    sorted.sort_by(|a, b| a.partial_cmp(b).unwrap());

    let len = sorted.len();
    let p50 = sorted[len / 2];
    let p90 = sorted[len * 90 / 100];
    let p99 = sorted[len * 99 / 100];
    let p99_9 = sorted[(len * 999 / 1000).min(len - 1)];
    let max = sorted[len - 1];

    LatencyBucket { p50, p90, p99, p99_9, max }
  }
}

// ============================================================
// Test Functions
// ============================================================

fn test_p50_measurement() {
  let mut profiler = LatencyProfiler::new();
  let latencies = vec![45.0, 55.0, 65.0, 75.0, 85.0];
  let bucket = profiler.profile_latencies(latencies);
  assert!(bucket.p50 > 0.0);
  println!("✅ D1 P50 측정 테스트 통과");
}

fn test_p99_measurement() {
  let mut profiler = LatencyProfiler::new();
  let mut latencies = vec![];
  for i in 0..100 {
    latencies.push((i as f64) * 2.0);
  }
  let bucket = profiler.profile_latencies(latencies);

  // W2: P99 < 200ms
  assert!(bucket.p99 < 200.0);
  println!("✅ D3 P99 측정 테스트 통과");
}

fn test_end_to_end_latency() {
  let mut profiler = LatencyProfiler::new();
  let latency = profiler.track_end_to_end_latency(1000, 1045);
  assert!(latency > 0.0);
  println!("✅ D6 E2E 레이턴시 테스트 통과");
}

fn test_slow_request_detection() {
  let mut profiler = LatencyProfiler::new();
  for i in 0..100 {
    profiler.track_end_to_end_latency(i * 1000, i * 1000 + 50);
  }
  let (fast, medium, slow) = profiler.categorize_slow_requests();
  assert!(fast > 0);
  println!("✅ D10 느린 요청 감지 테스트 통과");
}

fn test_histogram() {
  let mut profiler = LatencyProfiler::new();
  let latencies = vec![25.0, 75.0, 125.0, 175.0, 225.0];
  profiler.profile_latencies(latencies);
  let histogram = profiler.generate_latency_histogram();
  assert!(histogram.len() == 5);
  println!("✅ D11 히스토그램 생성 테스트 통과");
}

fn main() {
  test_p50_measurement();
  test_p99_measurement();
  test_end_to_end_latency();
  test_slow_request_detection();
  test_histogram();

  println!("\n🌐 Latency Profiler Module Tests: 5/5 ✅");
}
