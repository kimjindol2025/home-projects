    let summary = "Phase 7 System Metrics:
Total Operations: " + to_string(system.metrics.total_operations) + "
Failed Operations: " + to_string(system.metrics.failed_operations) + "
Byzantine Detected: " + to_string(system.metrics.byzantine_detected) + "
Election Latency: " + to_string(system.metrics.leader_election_latency_ms) + "ms
Fault Detection: " + to_string(system.metrics.fault_detection_latency_ms) + "ms
Memory Usage: " + to_string(system.metrics.memory_usage_mb) + "MB
Circuit Breaker Trips: " + to_string(system.metrics.circuit_breaker_trips) + "
Health Status: " + health + "
Rules Passed: " + to_string(rules_passed) + "/8";

    summary
}

