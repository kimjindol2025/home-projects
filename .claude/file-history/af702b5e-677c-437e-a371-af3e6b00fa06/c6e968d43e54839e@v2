// ============================================================================
// R7: State Machine Safety
// ============================================================================

/**
 * State Machine Safety Property:
 *
 * 모든 노드가 같은 index에서 같은 command를 apply해야 함
 *
 * Raft 보장:
 * 1. Election safety: Leader는 모든 committed entries를 가짐
 * 2. Log matching: Same index, same term → 그전 entries 동일
 * 3. Leader completeness: Elected leader는 모든 committed entries 포함
 */
fn verify_r7_state_safety(node: AdvancedRaftNode) -> bool {
    // Check 1: No gaps in log
    for i in range(0, len(node.log)) {
        let entry = get(node.log, i);
        if entry.index != ((i as u64) + 1) {
            return false;  // Gap detected!
        }
    }

    // Check 2: Terms are non-decreasing
    let mut prev_term = 0;
    for i in range(0, len(node.log)) {
        let entry = get(node.log, i);
        if entry.term < prev_term {
            return false;  // Term decreased!
        }
        prev_term = entry.term;
    }

    // Check 3: Committed entries are applied
    if node.commit_index > node.last_applied {
        return false;  // Lag in applying committed entries
    }

    true
}

