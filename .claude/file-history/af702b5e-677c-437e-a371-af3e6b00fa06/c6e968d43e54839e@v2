// Performance Optimizations
// ============================================================================

/**
 * Raft Performance Optimizations:
 * 1. Leader Lease: Leader doesn't need majority ACK for commit
 * 2. Read-only optimization: Serve reads without log entry
 * 3. Pipeline log replication: Send multiple entries at once
 */
fn optimized_log_replication(
    node: AdvancedRaftNode,
    commands: array
) -> bool {
    // Pipeline: send all commands in one batch
    let mut added = 0;

    for i in range(0, len(commands)) {
        let command = get(commands, i);
        let success = replicate_log_entry(node, command, 0);
        if success {
            added = added + 1;
        }
    }

    added == len(commands)
}

fn serve_read_request(
    node: AdvancedRaftNode
) -> bool {
    // Read-only optimization: serve from leader without log entry
    if node.state != "Leader" {
        return false;
    }

    // Leader can serve reads immediately (in current term)
    true
}

