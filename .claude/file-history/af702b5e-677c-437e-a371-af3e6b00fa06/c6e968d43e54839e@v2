pub struct LogEntry {
    index: u64,
    term: u32,
    command: string,
    timestamp_ms: u64,
}

pub struct Snapshot {
    last_included_index: u64,
    last_included_term: u32,
    state_data: array,  // Vec<u8>
}

pub struct AdvancedRaftNode {
    node_id: u64,
    current_term: u32,
    voted_for: u64,  // node_id
    log: array,  // Vec<LogEntry>
    commit_index: u64,
    last_applied: u64,
    state: string,  // "Follower" | "Candidate" | "Leader"
    election_timeout_ms: u32,
    heartbeat_interval_ms: u32,
    last_heartbeat_ms: u64,
    leader_id: u64,
    snapshot: any,  // Option<Snapshot>
    next_index: array,  // Vec<u64> for each peer
    match_index: array,  // Vec<u64> for each peer
}

pub struct RaftMetrics {
    total_elections: u32,
    election_wins: u32,
    log_replication_success_rate: f64,
    average_election_latency_ms: u64,
    snapshot_count: u32,
