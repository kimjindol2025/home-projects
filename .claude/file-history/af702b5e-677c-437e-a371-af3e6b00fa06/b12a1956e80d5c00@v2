pub fn create_panel_options() -> PanelOptions {
    PanelOptions {
        show_title: true,
        show_legend: true,
        show_value: true,
        decimals: 2,
        unit: "",
        color_scheme: "blue",
        thresholds: array<f64> {},
    }
}

pub fn create_panel_data(
    series_name: string,
    values: array<f64>
) -> PanelData {
    let min_val = find_min(values);
    let max_val = find_max(values);
    let sum = find_sum(values);
    let avg = sum / (len(values) as f64);

    PanelData {
        series_name: series_name,
        values: values,
        timestamps: array<u64> {},
        min_value: min_val,
        max_value: max_val,
        avg_value: avg,
    }
}

