pub fn create_alert_badge(
    alert_count: u32,
    severity: string
) -> string {
    let color = if severity == "critical" {
        "#f44336"
    } else if severity == "warning" {
        "#ff9800"
    } else {
        "#4CAF50"
    };

    "<span class=\"alert-badge\" style=\"background: " + color + "; color: white; padding: 4px 8px; border-radius: 4px; font-size: 12px;\">" + to_string(alert_count) + " " + severity + "</span>"
}

