pub struct PanelOptions {
    show_title: bool,
    show_legend: bool,
    show_value: bool,
    decimals: u32,
    unit: string,
    color_scheme: string,  // "blue" | "green" | "red" | "custom"
    thresholds: array<f64>,
}

pub struct PanelData {
    series_name: string,
    values: array<f64>,
    timestamps: array<u64>,
    min_value: f64,
    max_value: f64,
    avg_value: f64,
}

pub struct PanelMetadata {
    last_updated_ms: u64,
    query_time_ms: u32,
    row_count: u32,
    status: string,  // "success" | "loading" | "error"
}

// ============================================================================
// Panel Rendering
// ============================================================================

pub fn render_panel_header(
    title: string,
    options: PanelOptions,
    metadata: PanelMetadata
) -> string {
    let mut html = "<div class=\"panel-header\">";

    if options.show_title {
        html = html + "<h3>" + title + "</h3>";
    }

    // Status indicator
    let status_color = if metadata.status == "success" {
        "green"
    } else if metadata.status == "loading" {
        "yellow"
    } else {
        "red"
    };

    html = html + "<div class=\"status-indicator\" style=\"background: " + status_color + "; width: 10px; height: 10px; border-radius: 50%; display: inline-block; margin-left: 10px;\"></div>";

    // Last updated
    html = html + "<span class=\"last-updated\" style=\"float: right; color: #999; font-size: 12px;\">Updated " + to_string(metadata.query_time_ms) + "ms ago</span>";

    html = html + "</div>";
    html
}

pub fn render_panel_legend(
    series_names: array<string>,
    values: array<f64>
) -> string {
    let mut html = "<div class=\"panel-legend\">";

    let mut i = 0;
    while i < len(series_names) {
        let name = get(series_names, i) as string;
        let value = get(values, i) as f64;

        html = html + "<div class=\"legend-item\" style=\"display: inline-block; margin-right: 20px;\">";
        html = html + "<span style=\"display: inline-block; width: 12px; height: 12px; background: #2196F3; margin-right: 5px; border-radius: 2px;\"></span>";
        html = html + "<span>" + name + ": " + to_string(value as i32) + "</span>";
        html = html + "</div>";

        i = i + 1;
    }

    html = html + "</div>";
    html
}

pub fn render_panel_footer(
    metadata: PanelMetadata,
    options: PanelOptions
) -> string {
    let mut html = "<div class=\"panel-footer\" style=\"border-top: 1px solid #eee; margin-top: 15px; padding-top: 10px; font-size: 12px; color: #999;\">";

    // Statistics
    html = html + "<span>Rows: " + to_string(metadata.row_count) + " | ";
    html = html + "Query: " + to_string(metadata.query_time_ms) + "ms</span>";

    html = html + "</div>";
    html
}

// ============================================================================
// Panel Value Display
// ============================================================================

pub fn render_stat_value(
    value: f64,
    options: PanelOptions
) -> string {
    let mut html = "<div class=\"stat-value\" style=\"font-size: 36px; font-weight: bold; text-align: center;\">";

    // Format value with decimals
    let formatted = format_number(value, options.decimals);
    html = html + formatted + " " + options.unit;

    html = html + "</div>";
    html
}

fn format_number(val: f64, decimals: u32) -> string {
    // Round to specified decimal places
    let multiplier = power(10.0, decimals as f64);
    let rounded = (val * multiplier).floor() / multiplier;
    to_string(rounded)
}

fn power(base: f64, exp: f64) -> f64 {
    // Simplified: power function
    let mut result = 1.0;
    let mut i = 0u32;

    while i < exp as u32 {
        result = result * base;
        i = i + 1;
    }

    result
}

// ============================================================================
// Threshold-based Coloring
// ============================================================================

pub fn get_threshold_color(
    value: f64,
    thresholds: array<f64>,
    color_scheme: string
) -> string {
    // Colors based on value crossing thresholds
    // E.g., [50, 80] = [green, yellow, red]

    if len(thresholds) == 0 {
        return "#2196F3";  // Default blue
    }

    let t1 = get(thresholds, 0) as f64;
    let t2 = if len(thresholds) > 1 { get(thresholds, 1) as f64 } else { t1 * 1.5 };

    if value <= t1 {
        "#4CAF50"  // Green
    } else if value <= t2 {
        "#ff9800"  // Orange
    } else {
        "#f44336"  // Red
    }
}

