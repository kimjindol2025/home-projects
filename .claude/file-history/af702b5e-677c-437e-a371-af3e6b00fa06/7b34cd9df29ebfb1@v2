pub fn test_a7_get_rate_per_second() -> bool {
    // A7: Rate function calculates increase per second
    // (300 - 100) / (3000 - 1000) seconds = 200 / 2 = 100 per second
    let start_val = 100.0;
    let end_val = 300.0;
    let start_ms = 1000;
    let end_ms = 3000;
    let rate = (end_val - start_val) / ((end_ms - start_ms) as f64 / 1000.0);

    rate == 100.0
}

