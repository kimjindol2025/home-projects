# 🐀 KimGraf v1.0 - FreeLang Native Monitoring
# Dockerfile for production deployment on 253 server

FROM ubuntu:22.04

LABEL maintainer="KimGraf Team"
LABEL description="KimGraf v1.0 - FreeLang Native Monitoring Dashboard"
LABEL version="1.0"

# Set working directory
WORKDIR /app

# Install base dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy FreeLang runtime (assuming available)
COPY --from=freelang-runtime:v2.2.0 /usr/local/bin/freelang /usr/local/bin/freelang

# Create application structure
RUN mkdir -p /app/src /app/tests /app/data /app/logs

# Copy KimGraf source code
COPY src/ /app/src/
COPY tests/ /app/tests/
COPY kimgraf_run.fl /app/

# Copy configuration
COPY kimgraf.config /app/

# Create non-root user
RUN useradd -m -u 1000 kimgraf && \
    chown -R kimgraf:kimgraf /app

# Switch to non-root user
USER kimgraf

# Expose ports
# 9000: HTTP Dashboard
# 9001: WebSocket Real-time Updates
# 9090: Prometheus /metrics (alternative)
EXPOSE 9000 9001 9090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:9000/health || exit 1

# Environment variables
ENV FREELANG_VERSION=2.2.0
ENV KIMGRAF_PORT=9000
ENV KIMGRAF_WEBSOCKET_PORT=9001
ENV KIMGRAF_DATA_PATH=/app/data
ENV KIMGRAF_LOG_PATH=/app/logs
ENV KIMGRAF_RETENTION_DAYS=30

# Run KimGraf server
CMD ["freelang", "kimgraf_run.fl"]
