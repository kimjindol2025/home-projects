// ============================================================================
// Query AST (Abstract Syntax Tree)
// ============================================================================

pub struct QueryAST {
    query_type: string,           // "gauge" | "rate" | "avg" | "percentile"
    metric_name: string,
    filters: map<string, string>,
    function: string,             // "rate" | "avg_over_time" | "increase"
    duration_sec: u32,
}

pub struct QueryResult {
    metric_name: string,
    values: array<f64>,
    timestamps: array<u64>,
    status: string,               // "success" | "error"
    query_time_ms: u32,
}

// ============================================================================
// Parse KimQL (Prometheus PromQL subset)
// ============================================================================

pub fn parse_query(query_string: string) -> QueryAST {
    // Simplified KimQL parser
    // Supports: metric{label="value"} | rate(metric[1m]) | avg_over_time(metric[5m])

    let ast = QueryAST {
        query_type: "gauge",
        metric_name: "",
        filters: map<string, string> {},
        function: "",
        duration_sec: 0,
    };

    // Extract metric name (first token)
    ast.metric_name = extract_metric_name(query_string);

    // Check for functions
    if contains(query_string, "rate(") {
        ast.function = "rate";
        ast.duration_sec = extract_duration(query_string);
    } else if contains(query_string, "avg_over_time(") {
        ast.function = "avg_over_time";
        ast.duration_sec = extract_duration(query_string);
    } else if contains(query_string, "increase(") {
        ast.function = "increase";
        ast.duration_sec = extract_duration(query_string);
    }

    // Extract label filters
    if contains(query_string, "{") {
        ast.filters = extract_labels(query_string);
    }

    ast
}

fn extract_metric_name(query_string: string) -> string {
    // Extract metric name before { or (
    let idx = find_first(query_string, "{");
    let idx2 = find_first(query_string, "(");

    let end = if idx > idx2 { idx2 } else { idx };
    if end > 0 {
        substring(query_string, 0, end)
    } else {
        query_string
    }
}

fn extract_duration(query_string: string) -> u32 {
    // Extract duration from [5m] or [1h]
    let start = find_first(query_string, "[");
    let end = find_first(query_string, "]");

    if start > 0 && end > start {
        let duration_str = substring(query_string, start + 1, end);
        parse_duration(duration_str)
    } else {
        0
    }
}

fn extract_labels(query_string: string) -> map<string, string> {
    let mut labels = map<string, string> {};

    // Parse {key="value", key2="value2"}
    let start = find_first(query_string, "{");
    let end = find_first(query_string, "}");

    if start > 0 && end > start {
        let label_str = substring(query_string, start + 1, end);
        // Simplified: split by comma, parse key="value"
        // In production: use proper CSV/quoted string parsing
    }

    labels
}

fn parse_duration(duration_str: string) -> u32 {
    // Parse "1m" -> 60, "5m" -> 300, "1h" -> 3600
    if contains(duration_str, "m") {
        let num = to_number(replace(duration_str, "m", ""));
        (num as u32) * 60
    } else if contains(duration_str, "h") {
        let num = to_number(replace(duration_str, "h", ""));
        (num as u32) * 3600
    } else {
        0
    }
}

