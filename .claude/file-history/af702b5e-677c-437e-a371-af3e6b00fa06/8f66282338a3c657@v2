// ============================================================================
// PromQL Functions (K8 compatibility)
// ============================================================================

pub fn rate(
    values: array<f64>,
    timestamps: array<u64>,
    duration_sec: u32
) -> f64 {
    // rate(metric[5m]) = (last_value - first_value) / time_duration_in_seconds
    if len(values) < 2 {
        return 0.0;
    }

    let first_val = get(values, 0) as f64;
    let last_val = get(values, (len(values) - 1) as u32) as f64;

    let first_ts = get(timestamps, 0) as u64;
    let last_ts = get(timestamps, (len(timestamps) - 1) as u32) as u64;

    let time_delta_ms = last_ts - first_ts;
    let time_delta_sec = time_delta_ms as f64 / 1000.0;

    (last_val - first_val) / time_delta_sec
}

pub fn avg_over_time(
    values: array<f64>
) -> f64 {
    // avg_over_time(metric[5m]) = sum(values) / count(values)
    if len(values) == 0 {
        return 0.0;
    }

    let mut sum = 0.0;
    let mut i = 0;

    while i < len(values) {
        let val = get(values, i) as f64;
        sum = sum + val;
        i = i + 1;
    }

    sum / (len(values) as f64)
}

pub fn increase(
    values: array<f64>,
    timestamps: array<u64>
) -> f64 {
    // increase(metric[5m]) = last_value - first_value
    if len(values) < 2 {
        return 0.0;
    }

    let first_val = get(values, 0) as f64;
    let last_val = get(values, (len(values) - 1) as u32) as f64;

    last_val - first_val
}

pub fn percentile(
    values: array<f64>,
    p: f64
) -> f64 {
    // percentile(metric, 99) = P99 value
    // Simplified: use index-based approach
    if len(values) == 0 {
        return 0.0;
    }

    let index = ((len(values) as f64) * (p / 100.0)) as u32;
    let safe_index = if index < len(values) as u32 { index } else { (len(values) - 1) as u32 };

    get(values, safe_index) as f64
}

// ============================================================================
// Aggregation Functions
// ============================================================================

pub fn sum(values: array<f64>) -> f64 {
    let mut total = 0.0;
    let mut i = 0;

    while i < len(values) {
        let val = get(values, i) as f64;
        total = total + val;
        i = i + 1;
    }

    total
}

pub fn avg(values: array<f64>) -> f64 {
    if len(values) == 0 {
        return 0.0;
    }
    sum(values) / (len(values) as f64)
}

pub fn min(values: array<f64>) -> f64 {
    if len(values) == 0 {
        return 0.0;
    }

    let mut minimum = get(values, 0) as f64;
    let mut i = 1;

    while i < len(values) {
        let val = get(values, i) as f64;
        if val < minimum {
            minimum = val;
        }
        i = i + 1;
    }

    minimum
}

pub fn max(values: array<f64>) -> f64 {
    if len(values) == 0 {
        return 0.0;
    }

    let mut maximum = get(values, 0) as f64;
    let mut i = 1;

    while i < len(values) {
        let val = get(values, i) as f64;
        if val > maximum {
            maximum = val;
        }
        i = i + 1;
    }

    maximum
}

