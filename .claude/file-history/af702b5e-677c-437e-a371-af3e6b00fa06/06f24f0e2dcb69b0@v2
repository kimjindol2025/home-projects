use std::collections::VecDeque;
use std::f64;

/// ============================================================================
/// Module 1: Ensemble Predictor (3-Model Voting)
/// ============================================================================

/// 여러 머신러닝 모델을 결합하여 더 정확한 예측 제공
pub struct EnsemblePredictor {
    /// Linear model: y = a*x + b
    linear_model: LinearModel,

    /// Polynomial model: y = a*x² + b*x + c
    polynomial_model: PolynomialModel,

    /// Neural network: simple 2-layer MLP
    neural_model: SimpleNeuralNetwork,

    /// Model weights based on accuracy (0.0-1.0)
    linear_weight: f64,
    poly_weight: f64,
    neural_weight: f64,

    /// History for adaptive weighting
    prediction_history: VecDeque<(f64, f64)>,  // (predicted, actual)
    max_history: usize,
}

#[derive(Clone)]
struct LinearModel {
    a: f64,  // coefficient
    b: f64,  // intercept
}

#[derive(Clone)]
struct PolynomialModel {
    a: f64,  // x² coefficient
    b: f64,  // x coefficient
    c: f64,  // constant
}

#[derive(Clone)]
struct SimpleNeuralNetwork {
    /// Input → Hidden weights (2 neurons)
    w1: [f64; 2],
    /// Hidden bias
    b1: f64,
    /// Hidden → Output weights
    w2: [f64; 2],
    /// Output bias
    b2: f64,
}

impl EnsemblePredictor {
    /// Create new ensemble predictor with random initialization
    pub fn new() -> Self {
        EnsemblePredictor {
            linear_model: LinearModel { a: 0.9, b: 10.0 },
            polynomial_model: PolynomialModel { a: 0.01, b: 0.8, c: 15.0 },
            neural_model: SimpleNeuralNetwork {
                w1: [0.5, 0.3],
                b1: 5.0,
                w2: [0.7, 0.6],
                b2: 2.0,
            },
            linear_weight: 0.333,
            poly_weight: 0.333,
            neural_weight: 0.334,
            prediction_history: VecDeque::new(),
            max_history: 100,
        }
    }

    /// Predict using ensemble voting
    pub fn predict(&mut self, input: f64) -> f64 {
        let linear_pred = self.linear_model.predict(input);
        let poly_pred = self.polynomial_model.predict(input);
        let neural_pred = self.neural_model.predict(input);

        // Weighted ensemble
        let ensemble = self.linear_weight * linear_pred
            + self.poly_weight * poly_pred
            + self.neural_weight * neural_pred;

        ensemble
    }

    /// Update model with actual observation
    pub fn update(&mut self, prediction: f64, actual: f64) {
        // Store in history
        self.prediction_history.push_back((prediction, actual));
        if self.prediction_history.len() > self.max_history {
            self.prediction_history.pop_front();
        }

        // Recalculate weights based on prediction errors
        self.adaptive_weight_update();
    }

    /// Recalculate model weights based on recent accuracy
    fn adaptive_weight_update(&mut self) {
        if self.prediction_history.len() < 10 {
            return;  // Need at least 10 samples
        }

        let mut linear_error = 0.0;
        let mut poly_error = 0.0;
        let mut neural_error = 0.0;

        for (pred, actual) in self.prediction_history.iter() {
            let linear_pred = self.linear_model.predict(*pred);
            let poly_pred = self.polynomial_model.predict(*pred);
            let neural_pred = self.neural_model.predict(*pred);

            linear_error += (linear_pred - actual).abs();
            poly_error += (poly_pred - actual).abs();
            neural_error += (neural_pred - actual).abs();
        }

        // Normalize errors
        let n = self.prediction_history.len() as f64;
        linear_error /= n;
        poly_error /= n;
        neural_error /= n;

        // Convert errors to weights (lower error = higher weight)
        let linear_score = 1.0 / (1.0 + linear_error);
        let poly_score = 1.0 / (1.0 + poly_error);
        let neural_score = 1.0 / (1.0 + neural_error);

        let total = linear_score + poly_score + neural_score;
        self.linear_weight = linear_score / total;
        self.poly_weight = poly_score / total;
        self.neural_weight = neural_score / total;
    }

    /// Get accuracy based on recent history
    pub fn accuracy(&self) -> f64 {
        if self.prediction_history.is_empty() {
            return 0.0;
        }

        let mut correct = 0;
        let total = self.prediction_history.len().min(50);  // Last 50 predictions

        for (pred, actual) in self.prediction_history.iter().rev().take(total) {
            let error = (pred - actual).abs();
            if error < actual.abs() * 0.05 {  // 5% error tolerance
                correct += 1;
            }
        }

        correct as f64 / total as f64
    }
}

impl LinearModel {
    fn predict(&self, x: f64) -> f64 {
        self.a * x + self.b
    }
}

impl PolynomialModel {
    fn predict(&self, x: f64) -> f64 {
        self.a * x * x + self.b * x + self.c
    }
}

impl SimpleNeuralNetwork {
    fn predict(&self, x: f64) -> f64 {
        // Input layer → Hidden layer (ReLU)
        let h1 = (self.w1[0] * x + self.b1).max(0.0);
        let h2 = (self.w1[1] * x + self.b1).max(0.0);

        // Hidden layer → Output layer (Linear)
        self.w2[0] * h1 + self.w2[1] * h2 + self.b2
    }
}

/// ============================================================================
/// Module 2: Reinforcement Learning (Q-Learning)
/// ============================================================================

/// Q-Learning for dynamic power management decisions
pub struct ReinforcementLearner {
    /// Q-table: state -> action -> Q-value
    q_table: Vec<Vec<f64>>,

    /// State space size (power levels 0-100%)
    num_states: usize,

    /// Action space (DVFS levels: Low, Medium, High, Turbo)
    num_actions: usize,

    /// Learning parameters
    alpha: f64,      // Learning rate
    gamma: f64,      // Discount factor
    epsilon: f64,    // Exploration rate

    /// Training statistics
    total_reward: f64,
    episodes: usize,
}

impl ReinforcementLearner {
    /// Create new RL agent
    pub fn new(num_states: usize, num_actions: usize) -> Self {
        let mut q_table = vec![vec![0.0; num_actions]; num_states];

        // Initialize Q-values
        for state in 0..num_states {
            for action in 0..num_actions {
                q_table[state][action] = 50.0;  // Neutral initialization
            }
        }

        ReinforcementLearner {
            q_table,
            num_states,
            num_actions,
            alpha: 0.1,      // 10% learning rate
            gamma: 0.95,     // 95% discount factor
            epsilon: 0.1,    // 10% exploration
            total_reward: 0.0,
            episodes: 0,
        }
    }

    /// Select action using epsilon-greedy strategy
    pub fn select_action(&self, state: usize) -> usize {
        if state >= self.num_states {
            return self.num_actions / 2;  // Default to medium
        }

        // Greedy: pick best action
        self.q_table[state]
            .iter()
            .enumerate()
            .max_by(|a, b| a.1.partial_cmp(b.1).unwrap())
            .unwrap()
            .0
    }

    /// Update Q-value based on experience
    pub fn update_q_value(&mut self, state: usize, action: usize, reward: f64, next_state: usize) {
        if state >= self.num_states || action >= self.num_actions || next_state >= self.num_states {
            return;
        }

        // Find max Q-value for next state
        let max_next_q = self.q_table[next_state]
            .iter()
            .fold(f64::NEG_INFINITY, |a, &b| a.max(b));

        // Q-learning update: Q(s,a) = Q(s,a) + α[r + γ*max(Q(s',a')) - Q(s,a)]
        let old_value = self.q_table[state][action];
        let new_value = old_value + self.alpha * (reward + self.gamma * max_next_q - old_value);
        self.q_table[state][action] = new_value;

        self.total_reward += reward;
    }

    /// Complete one episode
    pub fn finish_episode(&mut self) {
        self.episodes += 1;
        // Decay exploration rate
        self.epsilon *= 0.99;
    }

    /// Get convergence metric (0.0-1.0)
    pub fn convergence(&self) -> f64 {
        if self.episodes == 0 {
            return 0.0;
        }

        // Check Q-value stability
        let mut variance = 0.0;
        for row in &self.q_table {
            for &q_val in row {
                variance += (q_val - 50.0).powi(2);
            }
        }
        variance /= (self.num_states * self.num_actions) as f64;

        // Higher variance = less convergence
        (1.0 / (1.0 + variance.sqrt())).min(1.0)
    }
}

/// ============================================================================
/// Module 3: Online Learner (Incremental Learning)
/// ============================================================================

/// Online learning for streaming data
pub struct OnlineLearner {
    /// Running mean and variance
    mean: f64,
    variance: f64,
    count: u64,

    /// Concept drift detection
    drift_threshold: f64,
    recent_errors: VecDeque<f64>,
    drift_detected: bool,
}

impl OnlineLearner {
    pub fn new() -> Self {
        OnlineLearner {
            mean: 0.0,
            variance: 0.0,
            count: 0,
            drift_threshold: 0.2,
            recent_errors: VecDeque::new(),
            drift_detected: false,
        }
    }

    /// Update with new data point (Welford's algorithm)
    pub fn update(&mut self, x: f64) {
        self.count += 1;
        let delta = x - self.mean;
        self.mean += delta / self.count as f64;
        let delta2 = x - self.mean;
        self.variance += delta * delta2;
    }

    /// Detect concept drift
    pub fn detect_drift(&mut self, prediction: f64, actual: f64) {
        let error = (prediction - actual).abs();
        self.recent_errors.push_back(error);

        if self.recent_errors.len() > 20 {
            self.recent_errors.pop_front();
        }

        // Calculate error trend
        if self.recent_errors.len() >= 20 {
            let first_half: f64 = self.recent_errors
                .iter()
                .take(10)
                .sum::<f64>() / 10.0;
            let second_half: f64 = self.recent_errors
                .iter()
                .skip(10)
                .sum::<f64>() / 10.0;

            let drift_ratio = second_half / (first_half + 1e-6);
            self.drift_detected = drift_ratio > self.drift_threshold;
        }
    }

    pub fn get_variance(&self) -> f64 {
        if self.count > 1 {
            self.variance / (self.count - 1) as f64
        } else {
            0.0
        }
    }

    pub fn is_drifting(&self) -> bool {
        self.drift_detected
    }
}

/// ============================================================================
/// Tests
/// ============================================================================

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_ensemble_predictor_basic() {
        let mut ensemble = EnsemblePredictor::new();
        let pred = ensemble.predict(50.0);
        assert!(pred > 0.0, "Prediction should be positive");
    }

    #[test]
    fn test_ensemble_adaptive_weights() {
        let mut ensemble = EnsemblePredictor::new();

        // Train on 20 samples
        for i in 0..20 {
            let input = (i * 5) as f64;
            let pred = ensemble.predict(input);
            let actual = input * 0.9 + 10.0;
            ensemble.update(pred, actual);
        }

        let accuracy = ensemble.accuracy();
        assert!(accuracy > 0.5, "Accuracy should improve after training");
    }

    #[test]
    fn test_rl_q_learning() {
        let mut rl = ReinforcementLearner::new(100, 4);

        // Simulate learning
        for _ in 0..100 {
            let state = 50;
            let action = rl.select_action(state);
            let reward = 100.0 - (action as f64 - 2.0).abs() * 50.0;
            rl.update_q_value(state, action, reward, 51);
            rl.finish_episode();
        }

        let convergence = rl.convergence();
        assert!(convergence > 0.3, "Should show some convergence");
    }

    #[test]
    fn test_online_learner_drift() {
        let mut learner = OnlineLearner::new();

        // Stable predictions
        for i in 0..20 {
            learner.update(50.0 + (i as f64 * 0.1));
            learner.detect_drift(50.0, 50.0);
        }

        assert!(!learner.is_drifting(), "Should not detect drift in stable data");
    }
}
