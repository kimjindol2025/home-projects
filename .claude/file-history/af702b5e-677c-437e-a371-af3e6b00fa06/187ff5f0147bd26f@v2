pub fn run_phase6_benchmark() {
    let mut system = Phase6System::new();

    println!("🚀 Phase 6 Benchmark Started\n");

    // 7일 풀 시뮬레이션
    for day in 0..7 {
        let day_type = if day < 5 { DayType::Weekday } else { DayType::Weekend };
        for hour in 0..24 {
            for _ in 0..4 {
                system.execute_cycle(hour as u8, day_type);
            }
        }

        println!("Day {}: {} cycles completed", day + 1, system.cycle);
    }

    println!("\n{}", system.generate_report());
}
