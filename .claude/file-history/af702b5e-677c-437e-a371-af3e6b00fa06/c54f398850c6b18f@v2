KIMGRAF_WEBSOCKET_PORT=9001          # WebSocket 포트
KIMGRAF_DATA_PATH=/app/data          # 메트릭 저장 경로
KIMGRAF_LOG_PATH=/app/logs           # 로그 경로
KIMGRAF_RETENTION_DAYS=30            # 데이터 보존 기간
FREELANG_VERSION=2.2.0               # FreeLang 버전
```

