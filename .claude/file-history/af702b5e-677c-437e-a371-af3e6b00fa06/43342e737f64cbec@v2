#[derive(Clone, Copy, Debug, PartialEq)]
enum JITStage {
  ProfileCollection,    // Hot function 식별
  CachePoison,         // 캐시 메모리 덮어쓰기
  CorruptedCodegen,    // 잘못된 assembler output
  MaliciousExecution,  // 의도하지 않은 명령 실행
}

struct JITCacheEntry {
  function_id: i32,
  original_hash: u64,
  cached_code: Vec<u8>,
  execution_count: i64,
  last_compiled_ms: i64,
  is_poisoned: bool,
  poisoned_at_ms: i64,
}

struct JITCompiler {
  cache: Vec<JITCacheEntry>,
  hot_threshold: i64,      // Hot path 판정 임계값
  integrity_checks: i32,
  poisoning_detected: i32,
  detection_time_ms: i64,
  code_memory_protected: bool,
  w_xor_x_violations: i32,
  rollback_count: i32,
}

impl JITCompiler {
  fn new() -> Self {
    Self {
      cache: Vec::new(),
      hot_threshold: 10000,
      integrity_checks: 0,
      poisoning_detected: 0,
      detection_time_ms: 0,
      code_memory_protected: true,
      w_xor_x_violations: 0,
      rollback_count: 0,
    }
  }

  // ========================================================
  // Stage 1: Profile Collection
  // ========================================================

  fn profile_hot_functions(&mut self, function_id: i32, execution_count: i64) -> bool {
    // Hot function 식별
    if execution_count > self.hot_threshold {
      self.cache.push(JITCacheEntry {
        function_id: function_id,
        original_hash: self.compute_hash_for_function(function_id),
        cached_code: Vec::new(),
        execution_count: execution_count,
        last_compiled_ms: self.get_time_ms(),
        is_poisoned: false,
        poisoned_at_ms: 0,
      });
      return true;
    }
    false
  }

  fn identify_hotspots(&self) -> Vec<i32> {
    // Hot spot 목록 반환
    let mut hotspots = Vec::new();
    for entry in &self.cache {
      if entry.execution_count > self.hot_threshold {
        hotspots.push(entry.function_id);
      }
    }
    hotspots
  }

  // ========================================================
  // Stage 2: Cache Poisoning Attack
  // ========================================================

  fn poison_jit_cache(&mut self, function_id: i32) -> bool {
    // 공격자: JIT 캐시 메모리 직접 손상
    for entry in &mut self.cache {
      if entry.function_id == function_id {
        // 원본 코드를 악의적 코드로 대체
        entry.cached_code = self.generate_malicious_code();
        entry.is_poisoned = true;
        entry.poisoned_at_ms = self.get_time_ms();
        return true;
      }
    }
    false
  }

  fn generate_malicious_code(&self) -> Vec<u8> {
    // 의도하지 않은 기계어 생성 (예: 비밀번호 전송, kernel 접근 등)
    vec![0x90, 0x90, 0x90]  // NOP 시뮬레이션
  }

  // ========================================================
  // Stage 3: Corrupted Code Generation
  // ========================================================

  fn compile_function(&mut self, function_id: i32) -> Vec<u8> {
    // JIT 컴파일 수행
    for entry in &self.cache {
      if entry.function_id == function_id {
        // Poisoned인 경우 악의적 코드 반환
        if entry.is_poisoned {
          return entry.cached_code.clone();
        }
        // 정상인 경우 올바른 코드 반환
        return self.generate_legitimate_code(function_id);
      }
    }
    self.generate_legitimate_code(function_id)
  }

  fn generate_legitimate_code(&self, function_id: i32) -> Vec<u8> {
    // 정상 기계어 생성
    vec![0x55, 0x48, 0x89, 0xe5]  // push rbp; mov rbp, rsp
  }

  // ========================================================
  // Defense: Integrity Checking (J1-J4)
  // ========================================================

  // J1: Poisoning 감지 시간 < 100ms
  fn check_jit_integrity(&mut self) -> bool {
    let start_time = self.get_time_ms();

    for entry in &mut self.cache {
      if entry.is_poisoned {
        self.integrity_checks += 1;
        let elapsed = (self.get_time_ms() - start_time) as i64;

        // J1 검증: < 100ms에 감지
        assert!(elapsed < 100, "J1: Detection time {} > 100ms", elapsed);

        self.poisoning_detected += 1;
        self.detection_time_ms = elapsed;
        return true;
      }

      // 캐시 항목의 hash 검증
      let current_hash = self.compute_code_hash(&entry.cached_code);
      if current_hash != entry.original_hash && !entry.is_poisoned {
        // 예상치 못한 변경 감지
        entry.is_poisoned = true;
        self.poisoning_detected += 1;
        return true;
      }
    }

    false
  }

  fn compute_code_hash(&self, code: &Vec<u8>) -> u64 {
    // 간단한 hash 함수 (실제: cryptographic)
    let mut hash: u64 = 0;
    for byte in code {
      hash = hash.wrapping_mul(31).wrapping_add(*byte as u64);
    }
    hash
  }

  // J2: Integrity check 정확도 = 100%
  fn verify_code_integrity(&mut self, code: &Vec<u8>) -> bool {
    // 100% 정확도 검증
    !code.is_empty() && self.is_legitimate_pattern(code)
  }

  fn is_legitimate_pattern(&self, code: &Vec<u8>) -> bool {
    // 정상 패턴 확인 (예: 함수 프롤로그)
    if code.len() > 0 && code[0] == 0x55 {  // push rbp
      return true;
    }
    false
  }

  // J3: Code memory W^X 위반 = 0건
  fn enforce_w_xor_x(&mut self, code_ptr: *mut u8) -> bool {
    // Write XOR Execute: 코드 메모리는 Execute만 가능, Write 불가
    if self.code_memory_protected {
      // W^X 강제
      return true;
    }
    // W^X 위반
    self.w_xor_x_violations += 1;
    false
  }

  fn verify_w_xor_x_compliance(&self) -> bool {
    // J3: 0건
    self.w_xor_x_violations == 0
  }

  // J4: Rollback latency < 50ms
  fn rollback_to_interpreter(&mut self, function_id: i32) -> bool {
    let start_time = self.get_time_ms();

    // Poisoned entry 제거 및 인터프리터로 전환
    for entry in &mut self.cache {
      if entry.function_id == function_id && entry.is_poisoned {
        entry.is_poisoned = false;
        entry.cached_code.clear();
        self.rollback_count += 1;

        let elapsed = (self.get_time_ms() - start_time) as i64;
        // J4 검증: < 50ms
        assert!(elapsed < 50, "J4: Rollback latency {} > 50ms", elapsed);

        return true;
      }
    }
    false
  }

  // ========================================================
  // Defense: Hotspot Guarding
  // ========================================================

  fn guard_hotspot(&self, function_id: i32, original_hash: u64) -> bool {
    // Hot function의 원본과 비교 검증
    for entry in &self.cache {
      if entry.function_id == function_id {
        return entry.original_hash == original_hash;
      }
    }
    true
  }

  // ========================================================
  // Performance Measurement (J5)
  // ========================================================

  // J5: 정상 성능 오버헤드 < 2%
  fn measure_overhead(&self, baseline_ns: i64, with_defense_ns: i64) -> f64 {
    let overhead_percent = ((with_defense_ns - baseline_ns) as f64 / baseline_ns as f64) * 100.0;

    // J5 검증: < 2%
    assert!(overhead_percent < 2.0, "J5: Overhead {}% > 2%", overhead_percent);

    overhead_percent
  }

  // ========================================================
  // Utility Functions
  // ========================================================

  fn compute_hash_for_function(&self, function_id: i32) -> u64 {
    // 함수의 원본 hash 계산
    ((function_id as u64) * 31) ^ 0xdeadbeefcafebabe
  }

  fn get_time_ms(&self) -> i64 {
    // 시뮬레이션용 시간
    0
  }

  // ========================================================
  // Statistics
  // ========================================================

  fn get_jit_stats(&self) -> (i32, i32, i64, i32) {
    // (integrity_checks, poisoning_detected, detection_time_ms, rollback_count)
    (self.integrity_checks, self.poisoning_detected, self.detection_time_ms, self.rollback_count)
  }
}

// ============================================================
// Test Functions
// ============================================================

fn test_profile_collection() {
  let mut compiler = JITCompiler::new();

  // Hot function 식별
  compiler.profile_hot_functions(1, 15000);
  compiler.profile_hot_functions(2, 5000);   // 임계값 미달

  let hotspots = compiler.identify_hotspots();
  assert!(hotspots.len() == 1);  // 1개만 hot
  println!("✅ J1 Hot function profiling 테스트 통과");
}

fn test_cache_poisoning() {
  let mut compiler = JITCompiler::new();

  // Hot function 추가
  compiler.profile_hot_functions(1, 15000);

  // Poison 공격
  let poisoned = compiler.poison_jit_cache(1);
  assert!(poisoned);

  println!("✅ J2 Cache poisoning 테스트 통과");
}

fn test_integrity_checking() {
  let mut compiler = JITCompiler::new();

  // Hot function 추가
  compiler.profile_hot_functions(1, 15000);

  // Poison
  compiler.poison_jit_cache(1);

  // Integrity check로 감지
  let detected = compiler.check_jit_integrity();
  assert!(detected);

  // J1: 감지 시간 < 100ms
  assert!(compiler.detection_time_ms < 100);

  println!("✅ J3 Integrity checking 테스트 통과");
}

fn test_w_xor_x_protection() {
  let mut compiler = JITCompiler::new();

  // Code memory W^X 강제
  let protected = compiler.enforce_w_xor_x(0 as *mut u8);
  assert!(protected);

  // J3: 위반 = 0건
  assert!(compiler.verify_w_xor_x_compliance());

  println!("✅ J4 W^X protection 테스트 통과");
}

fn test_rollback() {
  let mut compiler = JITCompiler::new();

  // Hot function 추가
  compiler.profile_hot_functions(1, 15000);

  // Poison
  compiler.poison_jit_cache(1);

  // Rollback
  let rolled_back = compiler.rollback_to_interpreter(1);
  assert!(rolled_back);

  // J4: Rollback latency < 50ms
  assert!(compiler.rollback_count > 0);

  println!("✅ J5 Rollback 테스트 통과");
}

fn test_overhead_measurement() {
  let compiler = JITCompiler::new();

  // Baseline: 1000ns
  // With defense: 1015ns (1.5% overhead)
  let overhead = compiler.measure_overhead(1000, 1015);

  // J5: < 2%
  assert!(overhead < 2.0);

  println!("✅ J6 Overhead measurement 테스트 통과");
}

fn test_hotspot_guarding() {
  let compiler = JITCompiler::new();

  // 임시 hot function 추가 (수동)
  let original_hash = compiler.compute_hash_for_function(1);

  // Guard 검증
  let guarded = compiler.guard_hotspot(1, original_hash);
  assert!(guarded);

  println!("✅ J7 Hotspot guarding 테스트 통과");
}

fn test_complete_attack_flow() {
  let mut compiler = JITCompiler::new();

  // 1. Profile
  compiler.profile_hot_functions(1, 15000);
  assert!(compiler.identify_hotspots().len() == 1);

  // 2. Poison
  compiler.poison_jit_cache(1);

  // 3. Detect
  let detected = compiler.check_jit_integrity();
  assert!(detected);

  // 4. Rollback
  compiler.rollback_to_interpreter(1);

  // Stats
  let (checks, detected_count, detection_time, rollbacks) = compiler.get_jit_stats();
  assert!(checks > 0);
  assert!(detected_count > 0);
  assert!(rollbacks > 0);

  println!("✅ J8 Complete JIT poisoning flow 테스트 통과");
}

fn main() {
  test_profile_collection();
  test_cache_poisoning();
  test_integrity_checking();
  test_w_xor_x_protection();
  test_rollback();
  test_overhead_measurement();
  test_hotspot_guarding();
  test_complete_attack_flow();

  println!("\n🐭 JIT Poisoning Attack Tests: 8/8 ✅");
}
