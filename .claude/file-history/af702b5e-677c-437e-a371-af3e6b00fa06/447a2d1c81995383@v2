// ============ Group E: Fairness Metrics (5/5) ============

use fairness_metrics::{
    FairnessMetrics, ResourceAllocation, BatteryFairness
}

// Test E1: Battery usage fairness calculation
fn test_battery_fairness_calculation() {
    let mut fairness = BatteryFairness::new(5)

    for i in 0..5 {
        fairness.set_battery_level(i, 100 - (i * 5) as u32)
    }

    let fairness_score = fairness.calculate_fairness()
    assert(fairness_score >= 0, "fairness score should be non-negative")
}

// Test E2: Load distribution fairness
fn test_load_distribution_fairness() {
    let mut metrics = FairnessMetrics::new(5)

    metrics.set_node_load(0, 50)
    metrics.set_node_load(1, 50)
    metrics.set_node_load(2, 50)
    metrics.set_node_load(3, 50)
    metrics.set_node_load(4, 50)

    let fairness = metrics.calculate_load_fairness()
    assert(fairness == 100, "equal load distribution should have 100% fairness")
}

// Test E3: Resource allocation equality
fn test_resource_allocation_equality() {
    let mut alloc = ResourceAllocation::new(5)

    for i in 0..5 {
        alloc.allocate_memory(i, 100)  // 100MB each
    }

    assert(alloc.is_equal_allocation(), "equal allocation should be detected")
}

// Test E4: Energy fairness index
fn test_energy_fairness_index() {
    let mut metrics = FairnessMetrics::new(3)

    metrics.set_energy_used(0, 500)
