// ============================================================================
// Trust Score Calculation
// ============================================================================

/**
 * Trust score는 노드의 신뢰도를 0.0-1.0 범위로 계산
 *
 * 요소:
 * 1. Vote consistency (40%)
 * 2. Response time (30%)
 * 3. Proposal acceptance rate (20%)
 * 4. No failures (10%)
 */
fn calculate_trust_score(node: ByzantineNode) -> f64 {
    let consistency = analyze_vote_consistency(node);
    let response_time = measure_response_time(node);

    // Normalize response time to 0-1 (1 second = 0 trust)
    let response_score = if response_time > 1000 {
        0.0
    } else {
        1.0 - ((response_time as f64) / 1000.0)
    };

    // Failure penalty
    let failure_penalty = (node.failures_detected as f64) * 0.1;
    let failure_score = max_f64(0.0, 1.0 - failure_penalty);

    // Weighted average
    let score =
        (consistency * 0.4) +
        (response_score * 0.3) +
        (failure_score * 0.3);

    score
}

