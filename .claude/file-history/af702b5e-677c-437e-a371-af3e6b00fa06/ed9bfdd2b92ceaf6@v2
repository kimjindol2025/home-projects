// ============================================================================
// Initialization
// ============================================================================

fn init_byzantine_fault_detector(node_count: u32) -> ByzantineFaultDetector {
    let detector = ByzantineFaultDetector {
        total_nodes: node_count,
        nodes: array(),  // Empty array, will be populated
        fault_threshold: node_count / 3,  // f = floor(n/3)
        detection_latency_ms: 0,
        recovery_in_progress: false,
        consensus_state: "normal",
    };

    // Initialize nodes
    for i in range(0, node_count) {
        let node = ByzantineNode {
            node_id: i as u64,
            is_byzantine: false,
            trust_score: 1.0,
            vote_history: array(),
            failures_detected: 0,
            last_heartbeat_ms: 0,
        };
        push(detector.nodes, node);
    }

    detector
}

// ============================================================================
// R1: Byzantine Fault Tolerance (f < n/3)
// ============================================================================

/**
 * 무관용 규칙 R1: Byzantine fault tolerance = f < n/3
 *
 * PBFT (Practical Byzantine Fault Tolerance) 구현:
 * - 노드 수의 1/3 미만이 악의적이어도 합의 보장
 * - 수학적 증명: 2f + 1 개 이상의 정상 노드로 결정 가능
 */
fn validate_byzantine_tolerance(
    detector: ByzantineFaultDetector
) -> bool {
    let detected_faulty = count_byzantine_nodes(detector);
    let threshold = detector.fault_threshold;

    // R1: Byzantine nodes < threshold (f < n/3)
    detected_faulty < threshold
}

fn count_byzantine_nodes(detector: ByzantineFaultDetector) -> u32 {
    let mut count = 0;

    for i in range(0, len(detector.nodes)) {
        let node = get(detector.nodes, i);
        if node.is_byzantine {
            count = count + 1;
        }
    }

    count
}

// ============================================================================
// Byzantine Node Detection (R4: < 100ms)
// ============================================================================

/**
 * R4: Fault detection < 100ms
 *
 * 악의적 노드 감지 알고리즘:
 * 1. Vote history 분석
 * 2. Response time 이상 감지
 * 3. Trust score 계산
 * 4. Isolation threshold 적용
 */
fn detect_byzantine_node(
    detector: ByzantineFaultDetector,
    node_id: u64,
    current_time_ms: u64
) -> bool {
    let node = get(detector.nodes, node_id as u32);

    // Check 1: No heartbeat for 500ms
    let heartbeat_gap_ms = current_time_ms - node.last_heartbeat_ms;
    if heartbeat_gap_ms > 500 {
        return true;
    }

    // Check 2: Vote inconsistency (byzantine behavior indicator)
    let vote_consistency = analyze_vote_consistency(node);
    if vote_consistency < 0.7 {
        return true;
    }

    // Check 3: Response time outlier
    let response_time = measure_response_time(node);
    if response_time > 1000 {  // > 1 second is suspicious
        return true;
    }

    // Check 4: Repeated failures
    if node.failures_detected > 5 {
        return true;
    }

    false
}

fn analyze_vote_consistency(node: ByzantineNode) -> f64 {
    let total_votes = len(node.vote_history);

    if total_votes == 0 {
        return 1.0;  // No votes = not suspicious
    }

    let mut consistent_votes = 0;

    // Simplified: count votes matching last 3 rounds
    for i in range(max(0, total_votes - 3), total_votes) {
        let vote = get(node.vote_history, i);
        // Vote consistency check (simplified)
        if len(vote.proposal) > 0 {
            consistent_votes = consistent_votes + 1;
        }
    }

    (consistent_votes as f64) / (min(3, total_votes) as f64)
}

fn measure_response_time(node: ByzantineNode) -> u64 {
    if len(node.vote_history) == 0 {
        return 100;  // Assume 100ms for no history
    }

    let last_vote = get(node.vote_history, len(node.vote_history) - 1);
    last_vote.timestamp_ms
}

