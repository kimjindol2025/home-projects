// ============================================================================
// PBFT Consensus Protocol
// ============================================================================

/**
 * Practical Byzantine Fault Tolerance (PBFT) 3단계:
 * 1. Pre-prepare: Leader가 proposal 전송
 * 2. Prepare: 2f+1 개 노드가 prepare vote 전송
 * 3. Commit: 2f+1 개 노드가 commit vote 전송 → Consensus
 *
 * R3: Log replication 100% reliability
 */
fn run_pbft_consensus(
    detector: ByzantineFaultDetector,
    proposal: string
) -> ConsensusResult {
    let start_time_ms = current_time_ms();
    let required_votes = (2 * detector.fault_threshold) + 1;
    let mut received_votes = 0;
    let mut byzantine_count = 0;

    // Pre-prepare phase: Leader broadcasts proposal
    // (Simplified: assume all non-Byzantine nodes receive)

    // Prepare phase: Non-Byzantine nodes vote
    for i in range(0, len(detector.nodes)) {
        let node = get(detector.nodes, i);

        if !node.is_byzantine {
            received_votes = received_votes + 1;
        } else {
            byzantine_count = byzantine_count + 1;
        }
    }

    // Commit phase: Check if 2f+1 received
    let consensus_reached = received_votes >= required_votes;
    let consensus_latency_ms = current_time_ms() - start_time_ms;

    ConsensusResult {
        is_valid: consensus_reached,
        required_votes: required_votes,
        received_votes: received_votes,
        byzantine_nodes_detected: byzantine_count,
        consensus_latency_ms: consensus_latency_ms,
    }
}

