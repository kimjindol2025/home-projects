fn handle_health_check(server: KimGrafServer) -> HttpResponse {
    let status = if server.error_count < 10 { "healthy" } else { "degraded" };

    let json = "{";
    json = json + "\"status\":\"" + status + "\",";
    json = json + "\"uptime_sec\":0,";
    json = json + "\"requests_total\":" + to_string(server.request_count) + ",";
    json = json + "\"errors_total\":" + to_string(server.error_count) + ",";
    json = json + "\"last_query_time_ms\":" + to_string(server.last_query_time_ms) + ",";
    json = json + "\"active_connections\":" + to_string(len(server.active_connections)) + ",";
    json = json + "\"timestamp_ms\":" + to_string(current_time_ms());
    json = json + "}";

    HttpResponse {
        status_code: 200,
        content_type: "application/json",
        headers: map<string, string> {},
        body: json,
    }
}

