// ============================================================================
// Server Statistics
// ============================================================================

pub fn get_server_stats(server: KimGrafServer) -> map<string, any> {
    let mut stats = map<string, any> {};

    set(stats, "request_count", server.request_count);
    set(stats, "error_count", server.error_count);
    set(stats, "last_query_time_ms", server.last_query_time_ms);
    set(stats, "active_connections", len(server.active_connections));
    set(stats, "uptime_ms", current_time_ms());

    stats
}

pub fn get_connection_stats(server: KimGrafServer, client_id: string) -> map<string, any> {
    let mut stats = map<string, any> {};

    let mut i = 0;
    while i < len(server.active_connections) {
        let conn = get(server.active_connections, i) as ActiveConnection;
        if conn.client_id == client_id {
            set(stats, "client_id", client_id);
            set(stats, "connected_at_ms", conn.connected_at_ms);
            set(stats, "last_message_ms", conn.last_message_ms);
            set(stats, "subscribed_metrics_count", len(conn.subscribed_metrics));
            return stats;
        }
        i = i + 1;
    }

    set(stats, "error", "Connection not found");
    stats
}

