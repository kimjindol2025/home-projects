// ============================================================================
// WebSocket Connection Management (K4: < 50ms)
// ============================================================================

pub fn add_websocket_connection(
    server: KimGrafServer,
    client_id: string
) -> bool {
    let connection = ActiveConnection {
        client_id: client_id,
        connected_at_ms: current_time_ms(),
        subscribed_metrics: array<string> {},
        last_message_ms: current_time_ms(),
    };

    push(server.active_connections, connection);
    len(server.active_connections) < (server.config.max_connections as i32)
}

pub fn handle_websocket_message(
    server: KimGrafServer,
    message: WebSocketMessage
) -> WebSocketMessage {
    // K4: < 50ms response time
    let start_time = current_time_ms();

    let response = if message.msg_type == "subscribe" {
        WebSocketMessage {
            id: message.id,
            timestamp_ms: current_time_ms(),
            msg_type: "subscribed",
            metric_name: message.metric_name,
            payload: "{\"status\":\"subscribed\",\"metric\":\"" + message.metric_name + "\"}",
            error: "",
        }
    } else if message.msg_type == "unsubscribe" {
        WebSocketMessage {
            id: message.id,
            timestamp_ms: current_time_ms(),
            msg_type: "unsubscribed",
            metric_name: message.metric_name,
            payload: "{\"status\":\"unsubscribed\"}",
            error: "",
        }
    } else if message.msg_type == "query" {
        WebSocketMessage {
            id: message.id,
            timestamp_ms: current_time_ms(),
            msg_type: "data",
            metric_name: message.metric_name,
            payload: "{\"values\":[100,105,102,108,110]}",
            error: "",
        }
    } else {
        WebSocketMessage {
            id: message.id,
            timestamp_ms: current_time_ms(),
            msg_type: "error",
            metric_name: "",
            payload: "",
            error: "Unknown message type",
        }
    };

    response
}

