/**
 * 🐀 KimGraf Server: HTTP + WebSocket
 *
 * 대시보드 HTTP 서버 + 실시간 WebSocket
 * 무관용 규칙:
 *   K3: 대시보드 로딩 < 500ms
 *   K4: WebSocket 지연 < 50ms
 *   K2: /api/query 응답 < 100ms
 *   K8: Prometheus /metrics 호환 100%
 */

pub struct ServerConfig {
    http_port: u32,
    websocket_port: u32,
    bind_address: string,
    max_connections: u32,
    request_timeout_ms: u32,
}

pub struct HttpRequest {
    method: string,           // "GET" | "POST" | "PUT" | "DELETE"
    path: string,
    query_params: map<string, string>,
    headers: map<string, string>,
    body: string,
}

pub struct HttpResponse {
    status_code: u32,
    content_type: string,
    headers: map<string, string>,
    body: string,
}

pub struct WebSocketMessage {
    id: string,
    timestamp_ms: u64,
    msg_type: string,         // "subscribe" | "unsubscribe" | "query" | "update"
    metric_name: string,
    payload: string,
    error: string,
}

pub struct ActiveConnection {
    client_id: string,
    connected_at_ms: u64,
    subscribed_metrics: array<string>,
    last_message_ms: u64,
}

pub struct KimGrafServer {
    config: ServerConfig,
    active_connections: array<ActiveConnection>,
    request_count: u64,
    error_count: u64,
    last_query_time_ms: u32,
}

// ============================================================================
// Server Initialization
// ============================================================================

pub fn init_server(port: u32) -> KimGrafServer {
    KimGrafServer {
        config: ServerConfig {
            http_port: port,
            websocket_port: port + 1,
            bind_address: "0.0.0.0",
            max_connections: 1000,
            request_timeout_ms: 5000,
        },
        active_connections: array<ActiveConnection> {},
        request_count: 0,
        error_count: 0,
        last_query_time_ms: 0,
    }
}

// ============================================================================
// HTTP Request Handling (K2, K3, K8)
// ============================================================================

pub fn handle_http_request(
    server: KimGrafServer,
    request: HttpRequest
) -> HttpResponse {
    let start_time_ms = current_time_ms();

    server.request_count = server.request_count + 1;

    let response = if request.method == "GET" {
        if request.path == "/metrics" {
            // Prometheus-compatible /metrics endpoint (K8)
            handle_prometheus_metrics(server)
        } else if request.path == "/dashboard" {
            // Dashboard HTML (K3: < 500ms)
            handle_dashboard(server)
        } else if string_starts_with(request.path, "/api/query") {
            // Query API (K2: < 100ms)
            handle_api_query(server, request)
        } else if request.path == "/api/metrics" {
            // List all metrics
            handle_api_metrics(server)
        } else if request.path == "/health" {
            // Health check
            handle_health_check(server)
        } else {
            HttpResponse {
                status_code: 404,
                content_type: "text/plain",
                headers: map<string, string> {},
                body: "Not Found",
            }
        }
    } else if request.method == "POST" {
        if string_starts_with(request.path, "/api/alert") {
            handle_alert_webhook(server, request)
        } else {
            HttpResponse {
                status_code: 405,
                content_type: "text/plain",
                headers: map<string, string> {},
                body: "Method Not Allowed",
            }
        }
    } else {
        HttpResponse {
            status_code: 405,
            content_type: "text/plain",
            headers: map<string, string> {},
            body: "Method Not Allowed",
        }
    };

    let elapsed_ms = (current_time_ms() - start_time_ms) as u32;
    server.last_query_time_ms = elapsed_ms;

    // Log if exceeded K2 (100ms) or K3 (500ms)
    if elapsed_ms > 500 {
        server.error_count = server.error_count + 1;
    }

    response
}

