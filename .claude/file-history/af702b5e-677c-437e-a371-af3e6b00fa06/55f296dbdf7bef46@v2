pub struct NotificationConfig {
    webhook_url: string,
    email_recipients: array<string>,
    slack_webhook: string,
    enable_email: bool,
    enable_slack: bool,
    enable_webhook: bool,
}

pub struct Notification {
    alert_id: string,
    alert_name: string,
    severity: string,
    message: string,
    timestamp_ms: u64,
    sent: bool,
}

// ============================================================================
// Send Notifications
// ============================================================================

pub fn send_notification(
    alert: any,  // Alert struct
    config: NotificationConfig
) -> bool {
    let notification = Notification {
        alert_id: get(alert, "alert_id") as string,
        alert_name: get(alert, "name") as string,
        severity: get(alert, "severity") as string,
        message: build_alert_message(alert),
        timestamp_ms: current_time_ms(),
        sent: false,
    };

    let mut success = true;

    // Send via webhook
    if config.enable_webhook {
        let webhook_success = send_webhook(notification, config.webhook_url);
        success = success && webhook_success;
    }

    // Send via email
    if config.enable_email {
        let email_success = send_email(notification, config.email_recipients);
        success = success && email_success;
    }

    // Send via Slack
    if config.enable_slack {
        let slack_success = send_slack(notification, config.slack_webhook);
        success = success && slack_success;
    }

    if success {
        notification.sent = true;
    }

    success
}

fn build_alert_message(alert: any) -> string {
    let msg = "🚨 " + (get(alert, "name") as string) + "\n";
    msg = msg + "Severity: " + (get(alert, "severity") as string) + "\n";
    msg = msg + "Value: " + to_string(get(alert, "value")) + "\n";
    msg = msg + "Threshold: " + to_string(get(alert, "threshold"));
    msg
}

// ============================================================================
// Webhook Notification
// ============================================================================

fn send_webhook(notification: Notification, webhook_url: string) -> bool {
    // HTTP POST to webhook URL with JSON payload
    let payload = build_webhook_payload(notification);
    let response = http_post(webhook_url, payload);
    response != null
}

fn build_webhook_payload(notification: Notification) -> string {
    let json = "{";
    json = json + "\"alert_id\":\"" + notification.alert_id + "\",";
    json = json + "\"alert_name\":\"" + notification.alert_name + "\",";
    json = json + "\"severity\":\"" + notification.severity + "\",";
    json = json + "\"message\":\"" + notification.message + "\",";
    json = json + "\"timestamp_ms\":" + to_string(notification.timestamp_ms);
    json = json + "}";
    json
}

// ============================================================================
// Email Notification
// ============================================================================

fn send_email(notification: Notification, recipients: array<string>) -> bool {
    // Send email to recipients
    // In production: use SMTP or email service API

    let subject = "[" + notification.severity + "] " + notification.alert_name;
    let body = notification.message;

    let mut i = 0;
    while i < len(recipients) {
        let recipient = get(recipients, i) as string;
        let _ = send_email_to(recipient, subject, body);
        i = i + 1;
    }

    true
}

