// ============================================================================
// Slack Notification
// ============================================================================

fn send_slack(notification: Notification, slack_webhook: string) -> bool {
    // HTTP POST to Slack webhook with formatted message
    let payload = build_slack_payload(notification);
    let response = http_post(slack_webhook, payload);
    response != null
}

fn build_slack_payload(notification: Notification) -> string {
    let color = if notification.severity == "critical" {
        "danger"
    } else if notification.severity == "warning" {
        "warning"
    } else {
        "good"
    };

    let json = "{";
    json = json + "\"attachments\":[{";
    json = json + "\"color\":\"" + color + "\",";
    json = json + "\"title\":\"" + notification.alert_name + "\",";
    json = json + "\"text\":\"" + notification.message + "\",";
    json = json + "\"ts\":" + to_string(notification.timestamp_ms / 1000);
    json = json + "}]";
    json = json + "}";
    json
}

// ============================================================================
// Notification History
// ============================================================================

pub struct NotificationHistory {
    notifications: array<Notification>,
    total_sent: u32,
    total_failed: u32,
}

pub fn log_notification(
    history: NotificationHistory,
    notification: Notification
) -> bool {
    push(history.notifications, notification);

    if notification.sent {
        history.total_sent = history.total_sent + 1;
    } else {
        history.total_failed = history.total_failed + 1;
    }

    true
}

pub fn get_notification_history(
    history: NotificationHistory,
    limit: u32
) -> array<Notification> {
    let mut result = array<Notification> {};
    let start = if len(history.notifications) > limit as i32 {
        (len(history.notifications) - (limit as i32)) as u32
    } else {
        0
    };

    let mut i = start;
    while i < len(history.notifications) as u32 {
        let notif = get(history.notifications, i as i32) as Notification;
        push(result, notif);
        i = i + 1;
    }

    result
}

