// ============================================================================
// Data Point & Time Series Structures
// ============================================================================

pub struct DataPoint {
    timestamp_ms: u64,
    value: f64,
}

pub struct TimeSeriesConfig {
    retention_hours: u32,        // 30 days = 720 hours
    max_points: u32,             // Ring buffer max
    flush_interval_sec: u32,     // Disk flush interval
}

pub struct TimeSeries {
    metric_name: string,
    labels: map<string, string>,
    data_points: array<DataPoint>,
    config: TimeSeriesConfig,
    point_count: u32,
    min_value: f64,
    max_value: f64,
    sum_value: f64,
    last_flush_ms: u64,
}

pub struct TimeSeriesDB {
    series: map<string, TimeSeries>,
    total_metrics: u32,
    last_collection_time_ms: u64,
}

// ============================================================================
// Initialize TSDB
// ============================================================================

pub fn init_tsdb() -> TimeSeriesDB {
    TimeSeriesDB {
        series: map<string, TimeSeries> {},
        total_metrics: 0,
        last_collection_time_ms: 0,
    }
}

pub fn init_time_series(
    metric_name: string,
    retention_hours: u32
) -> TimeSeries {
    TimeSeries {
        metric_name: metric_name,
        labels: map<string, string> {},
        data_points: array<DataPoint> {},
        config: TimeSeriesConfig {
            retention_hours: retention_hours,
            max_points: 86400,  // 30 days @ 1Hz = 2.592M points, capped at 86.4k
            flush_interval_sec: 60,
        },
        point_count: 0,
        min_value: 999999.0,
        max_value: -999999.0,
        sum_value: 0.0,
        last_flush_ms: 0,
    }
}

// ============================================================================
// Insert Data Points (K1: < 1s)
// ============================================================================

pub fn insert(
    ts: TimeSeries,
    value: f64,
    timestamp_ms: u64
) -> bool {
    // Check if we need to apply retention (rotate buffer)
    if ts.point_count >= ts.config.max_points {
        // Ring buffer rotation: remove oldest point
        if len(ts.data_points) > 0 {
            let _ = ts.data_points[0];  // Remove first element
        }
    }

    // Create data point
    let dp = DataPoint {
        timestamp_ms: timestamp_ms,
        value: value,
    };

    // Append to array
    push(ts.data_points, dp);
    ts.point_count = ts.point_count + 1;

    // Update stats
    if value < ts.min_value {
        ts.min_value = value;
    }
    if value > ts.max_value {
        ts.max_value = value;
    }
    ts.sum_value = ts.sum_value + value;

    true
}

pub fn insert_batch(
    ts: TimeSeries,
    values: array<f64>,
    base_timestamp_ms: u64
) -> bool {
    // K1 optimization: batch insert (< 1s for 1000 points)
    let mut i = 0;
    while i < len(values) {
        let val = get(values, i);
        let ts_ms = base_timestamp_ms + (i as u64 * 1000);  // 1s intervals
        let _ = insert(ts, val as f64, ts_ms);
        i = i + 1;
    }

    true
}

// ============================================================================
// Query Data (K2: < 100ms)
// ============================================================================

pub fn query_range(
    ts: TimeSeries,
    from_ms: u64,
    to_ms: u64
) -> array<DataPoint> {
    let mut result = array<DataPoint> {};
    let mut i = 0;

    while i < len(ts.data_points) {
        let dp = get(ts.data_points, i) as DataPoint;
        if dp.timestamp_ms >= from_ms && dp.timestamp_ms <= to_ms {
            push(result, dp);
        }
        i = i + 1;
    }

    result
}

pub fn query_latest(ts: TimeSeries, count: u32) -> array<DataPoint> {
    let mut result = array<DataPoint> {};
    let total = len(ts.data_points);
    let start = if total > count as i32 { total - (count as i32) } else { 0 };

    let mut i = start as u32;
    while i < total as u32 {
        let dp = get(ts.data_points, i) as DataPoint;
        push(result, dp);
        i = i + 1;
    }

    result
}

// ============================================================================
// Downsampling (K2: aggregation for faster queries)
// ============================================================================

pub fn downsample(
    points: array<DataPoint>,
    step_ms: u64
) -> array<DataPoint> {
    // Reduce data points by aggregating into buckets
    let mut result = array<DataPoint> {};

    if len(points) == 0 {
        return result;
    }

    let mut current_bucket_sum = 0.0;
    let mut current_bucket_count = 0;
    let mut current_bucket_time = 0u64;

    let mut i = 0;
    while i < len(points) {
        let dp = get(points, i) as DataPoint;
        let bucket = (dp.timestamp_ms / step_ms) * step_ms;

        if bucket != current_bucket_time && current_bucket_count > 0 {
            // Flush previous bucket
            let avg = current_bucket_sum / (current_bucket_count as f64);
            push(result, DataPoint {
                timestamp_ms: current_bucket_time,
                value: avg,
            });
        }

        current_bucket_time = bucket;
        current_bucket_sum = current_bucket_sum + dp.value;
        current_bucket_count = current_bucket_count + 1;

        i = i + 1;
    }

    // Flush last bucket
    if current_bucket_count > 0 {
        let avg = current_bucket_sum / (current_bucket_count as f64);
        push(result, DataPoint {
            timestamp_ms: current_bucket_time,
            value: avg,
        });
    }

    result
}

// ============================================================================
// Statistics (for dashboards)
// ============================================================================

pub fn get_stats(ts: TimeSeries) -> map<string, f64> {
    let mut stats = map<string, f64> {};

    if ts.point_count == 0 {
        return stats;
    }

    let avg = ts.sum_value / (ts.point_count as f64);

    set(stats, "min", ts.min_value);
    set(stats, "max", ts.max_value);
    set(stats, "avg", avg);
    set(stats, "sum", ts.sum_value);
    set(stats, "count", ts.point_count as f64);

    stats
}

pub fn get_rate(
    ts: TimeSeries,
    duration_sec: u32
) -> f64 {
    // Calculate rate of change per second (K8 Prometheus compatibility)
    if ts.point_count < 2 {
        return 0.0;
    }

    let first_point = get(ts.data_points, 0) as DataPoint;
    let last_point = get(ts.data_points, (ts.point_count - 1) as u32) as DataPoint;

    let time_delta_ms = last_point.timestamp_ms - first_point.timestamp_ms;
    let value_delta = last_point.value - first_point.value;

    if time_delta_ms == 0 {
        return 0.0;
    }

    let time_delta_sec = time_delta_ms as f64 / 1000.0;
    value_delta / time_delta_sec
}

pub fn get_percentile(
    ts: TimeSeries,
    p: f64
) -> f64 {
    // Calculate percentile (P99, P95, P50)
    if ts.point_count == 0 {
        return 0.0;
    }

    let index = ((ts.point_count as f64) * (p / 100.0)) as u32;
    let sorted_index = if index < ts.point_count { index } else { ts.point_count - 1 };

    let dp = get(ts.data_points, sorted_index) as DataPoint;
    dp.value
}

