// Database Operations
// ============================================================================

pub fn register_metric(
    db: TimeSeriesDB,
    metric_name: string,
    retention_hours: u32
) -> bool {
    let ts = init_time_series(metric_name, retention_hours);
    set(db.series, metric_name, ts);
    db.total_metrics = db.total_metrics + 1;
    true
}

pub fn get_metric(
    db: TimeSeriesDB,
    metric_name: string
) -> TimeSeries {
    get(db.series, metric_name) as TimeSeries
}

pub fn collect_all_metrics(
    db: TimeSeriesDB,
    current_time_ms: u64
) -> bool {
    // Update last collection time
    db.last_collection_time_ms = current_time_ms;
    true
}

