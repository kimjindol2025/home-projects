pub struct PrometheusMetric {
    name: string,
    labels: map<string, string>,
    value: f64,
    timestamp_ms: u64,
    metric_type: string,  // "gauge" | "counter" | "histogram" | "summary"
}

pub struct ScraperConfig {
    endpoint: string,
    interval_sec: u32,
    timeout_sec: u32,
    path: string,  // default: "/metrics"
}

// ============================================================================
// Initialize Scraper
// ============================================================================

pub fn init_scraper(endpoint: string, interval_sec: u32) -> ScraperConfig {
    ScraperConfig {
        endpoint: endpoint,
        interval_sec: interval_sec,
        timeout_sec: 5,
        path: "/metrics",
    }
}

// ============================================================================
// Scrape Prometheus Metrics (K1 < 1s)
// ============================================================================

pub fn scrape_prometheus(
    config: ScraperConfig
) -> array<PrometheusMetric> {
    let mut metrics = array<PrometheusMetric> {};

    // Build URL: http://endpoint:9090/metrics
    let url = config.endpoint + ":" + "9090" + config.path;

    // HTTP GET request to Prometheus endpoint
    let response = http_get(url, config.timeout_sec);

    if response.status_code == 200 {
        // Parse Prometheus text format
        let parsed = parse_prometheus_format(response.body);
        metrics = parsed;
    }

    metrics
}

// ============================================================================
// Parse Prometheus Text Format (K8 compatibility)
// ============================================================================

fn parse_prometheus_format(text: string) -> array<PrometheusMetric> {
    let mut metrics = array<PrometheusMetric> {};

    // Prometheus text format:
    // # HELP metric_name Description
    // # TYPE metric_name gauge|counter|histogram|summary
    // metric_name{label1="value1",label2="value2"} 42.5 1234567890123

    let lines = split_lines(text);
    let mut i = 0;

    while i < len(lines) {
        let line = get(lines, i) as string;

        // Skip comments and empty lines
        if starts_with(line, "#") || line == "" {
            i = i + 1;
            continue;
        }

        // Parse metric line
        let metric = parse_metric_line(line);
        if metric.name != "" {
            push(metrics, metric);
        }

        i = i + 1;
    }

    metrics
}

fn parse_metric_line(line: string) -> PrometheusMetric {
    // Format: metric_name{labels} value timestamp

    let metric = PrometheusMetric {
        name: "",
        labels: map<string, string> {},
        value: 0.0,
        timestamp_ms: current_time_ms(),
        metric_type: "gauge",
    };

    // Find metric name and labels
    let brace_start = find_index(line, "{");
    let brace_end = find_index(line, "}");

    if brace_start >= 0 && brace_end > brace_start {
        // Extract metric name
        metric.name = substring(line, 0, brace_start);

        // Extract labels
        let labels_str = substring(line, brace_start + 1, brace_end);
        metric.labels = parse_labels(labels_str);

        // Extract value (after closing brace)
        let rest = substring(line, brace_end + 1, len(line) as i32);
        let parts = split_whitespace(rest);

        if len(parts) > 0 {
            let val_str = get(parts, 0) as string;
            metric.value = parse_float(val_str);
        }

        if len(parts) > 1 {
            let ts_str = get(parts, 1) as string;
            metric.timestamp_ms = parse_long(ts_str);
        }
    } else {
        // Simple metric without labels: metric_name value timestamp
        let parts = split_whitespace(line);
        if len(parts) > 0 {
            metric.name = get(parts, 0) as string;
        }
        if len(parts) > 1 {
            metric.value = parse_float(get(parts, 1) as string);
        }
        if len(parts) > 2 {
            metric.timestamp_ms = parse_long(get(parts, 2) as string);
        }
    }

    metric
}

fn parse_labels(labels_str: string) -> map<string, string> {
    let mut labels = map<string, string> {};

    // Format: key1="value1",key2="value2"
    let pairs = split_by_char(labels_str, ",");

    let mut i = 0;
    while i < len(pairs) {
        let pair = get(pairs, i) as string;
        let eq_idx = find_index(pair, "=");

        if eq_idx > 0 {
            let key = substring(pair, 0, eq_idx);
            let val_str = substring(pair, eq_idx + 1, len(pair) as i32);
            // Remove quotes
            let val = val_str;  // Remove leading/trailing quotes
            set(labels, trim(key), trim(val));
        }

        i = i + 1;
    }

    labels
}

