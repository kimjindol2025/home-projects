    true
}

// ============================================================================
// Filter Metrics
// ============================================================================

pub fn filter_metrics(
    metrics: array<PrometheusMetric>,
    prefix: string
) -> array<PrometheusMetric> {
    let mut result = array<PrometheusMetric> {};

    let mut i = 0;
    while i < len(metrics) {
        let metric = get(metrics, i) as PrometheusMetric;
        if starts_with(metric.name, prefix) {
            push(result, metric);
        }
        i = i + 1;
    }

    result
}

// ============================================================================
// Convert to Time Series
// ============================================================================

pub fn convert_to_timeseries(
    metrics: array<PrometheusMetric>
) -> map<string, f64> {
    let mut ts_data = map<string, f64> {};

    let mut i = 0;
    while i < len(metrics) {
        let metric = get(metrics, i) as PrometheusMetric;
        set(ts_data, metric.name, metric.value);
        i = i + 1;
    }

    ts_data
}

