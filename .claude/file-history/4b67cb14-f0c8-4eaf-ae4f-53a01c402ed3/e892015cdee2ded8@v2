// 접근성 개선: 키보드 네비게이션
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        const navMenu = document.getElementById('navMenu');
        if (navMenu && navMenu.classList.contains('active')) {
            navMenu.classList.remove('active');
        }
    }

    // Alt + S: 검색창 포커스 (향후 추가 기능)
    if (event.altKey && event.key === 's') {
        event.preventDefault();
        // 검색 기능 구현
    }
});

// 성능 모니터링
window.addEventListener('load', function() {
    if (window.performance && window.performance.timing) {
        const perfData = window.performance.timing;
        const pageLoadTime = perfData.loadEventEnd - perfData.navigationStart;
        console.log('페이지 로드 시간: ' + pageLoadTime + 'ms');
    }
});

// 동적 다크/라이트 모드 (선택적)
function toggleTheme() {
    const root = document.documentElement;
    const currentTheme = root.style.colorScheme;

    if (currentTheme === 'dark' || !currentTheme) {
        root.style.colorScheme = 'light';
        localStorage.setItem('theme', 'light');
    } else {
        root.style.colorScheme = 'dark';
        localStorage.setItem('theme', 'dark');
    }
}

// 로컬 스토리지에서 테마 복원
window.addEventListener('DOMContentLoaded', function() {
    const savedTheme = localStorage.getItem('theme') || 'dark';
    document.documentElement.style.colorScheme = savedTheme;
});

// 사용자 인터랙션 추적 (분석용)
const eventTracker = {
    events: [],

    track: function(eventName, eventData) {
        this.events.push({
            name: eventName,
            data: eventData,
            timestamp: new Date().toISOString()
        });
    },

    getEvents: function() {
        return this.events;
    }
};

// 버튼 클릭 추적
document.addEventListener('click', function(event) {
    if (event.target.classList.contains('btn')) {
        eventTracker.track('button_click', {
            button: event.target.textContent,
            className: event.target.className
        });
    }
});

// 링크 클릭 추적
document.addEventListener('click', function(event) {
    if (event.target.tagName === 'A' && event.target.href) {
        eventTracker.track('link_click', {
            href: event.target.href,
            text: event.target.textContent
        });
    }
});

// 스크롤 깊이 추적
let maxScroll = 0;
window.addEventListener('scroll', function() {
    const scrollPercentage = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    if (scrollPercentage > maxScroll) {
        maxScroll = scrollPercentage;
    }
});

// 페이지 언로드 시 데이터 저장
window.addEventListener('beforeunload', function() {
    eventTracker.track('page_exit', {
        maxScroll: maxScroll,
        totalEvents: eventTracker.events.length
    });

    // 로컬 스토리지에 이벤트 저장 (선택적)
    try {
        localStorage.setItem('lastVisit', JSON.stringify({
            timestamp: new Date().toISOString(),
            scrollDepth: maxScroll,
            eventCount: eventTracker.events.length
        }));
    } catch (e) {
        console.log('로컬 스토리지 저장 실패:', e);
    }
});

