<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="FreeLang 기술 블로그 - 컴파일러 개발, 언어 설계, 최신 소식">
    <meta name="keywords" content="FreeLang, 블로그, 컴파일러, 프로그래밍 언어, 기술 글">
    <meta property="og:title" content="FreeLang 기술 블로그">
    <meta property="og:description" content="FreeLang 공식 기술 블로그 - 개발 일지, 기술 글, 공지사항">
    <meta property="og:type" content="website">
    <title>FreeLang 블로그</title>
    <link rel="stylesheet" href="style.css">
    <style>
        .blog-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 2rem;
        }

        .blog-header {
            text-align: center;
            margin-bottom: 3rem;
            animation: fadeInUp 0.8s ease;
        }

        .blog-header h1 {
            font-size: 2.5rem;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .blog-header p {
            font-size: 1.1rem;
            color: #999;
        }

        .blog-filter {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .filter-btn {
            padding: 0.5rem 1rem;
            border: 2px solid var(--primary);
            background: transparent;
            color: var(--primary);
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .filter-btn:hover,
        .filter-btn.active {
            background: var(--primary);
            color: var(--dark-bg);
        }

        .blog-posts {
            display: grid;
            gap: 2rem;
        }

        .blog-post {
            background: var(--light-bg);
            border-left: 4px solid var(--primary);
            padding: 1.5rem;
            border-radius: 8px;
            transition: all 0.3s ease;
            animation: fadeInUp 0.6s ease;
        }

        .blog-post:hover {
            transform: translateX(10px);
            box-shadow: 0 4px 20px rgba(0, 212, 255, 0.2);
        }

        .post-meta {
            display: flex;
            gap: 1rem;
            font-size: 0.85rem;
            color: #888;
            margin-bottom: 0.5rem;
            flex-wrap: wrap;
        }

        .post-date {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .post-author {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .post-category {
            display: inline-block;
            background: var(--primary);
            color: var(--dark-bg);
            padding: 0.2rem 0.6rem;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: bold;
            text-transform: uppercase;
        }

        .blog-post h2 {
            color: var(--primary);
            font-size: 1.5rem;
            margin: 0.5rem 0;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .blog-post h2:hover {
            color: #00a6cc;
        }

        .post-excerpt {
            color: #ccc;
            line-height: 1.6;
            margin: 0.5rem 0;
        }

        .post-tags {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            margin-top: 0.5rem;
        }

        .tag {
            background: transparent;
            border: 1px solid var(--primary);
            color: var(--primary);
            padding: 0.2rem 0.6rem;
            border-radius: 4px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .tag:hover {
            background: var(--primary);
            color: var(--dark-bg);
        }

        .search-box {
            margin-bottom: 2rem;
            position: relative;
        }

        .search-box input {
            width: 100%;
            padding: 0.8rem 1rem;
            background: var(--light-bg);
            border: 2px solid var(--primary);
            border-radius: 8px;
            color: #fff;
            font-size: 1rem;
            outline: none;
            transition: all 0.3s ease;
        }

        .search-box input:focus {
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
        }

        .search-box input::placeholder {
            color: #666;
        }

        .no-results {
            text-align: center;
            color: #888;
            padding: 3rem 1rem;
            font-size: 1.1rem;
        }

        .pagination {
            display: flex;
            justify-content: center;
            gap: 0.5rem;
            margin-top: 2rem;
        }

        .pagination button {
            padding: 0.5rem 1rem;
            background: var(--light-bg);
            border: 2px solid var(--primary);
            color: var(--primary);
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .pagination button:hover,
        .pagination button.active {
            background: var(--primary);
            color: var(--dark-bg);
        }

        @media (max-width: 768px) {
            .blog-container {
                padding: 1rem;
            }

            .blog-header h1 {
                font-size: 1.8rem;
            }

            .blog-filter {
                gap: 0.5rem;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <a href="index.html">FreeLang</a>
            </div>
            <button class="hamburger" aria-label="Menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <ul class="nav-links">
                <li><a href="index.html">홈</a></li>
                <li><a href="blog.html" class="active">블로그</a></li>
                <li><a href="contributors.html">기여자</a></li>
                <li><a href="community.html">커뮤니티</a></li>
            </ul>
        </div>
    </nav>

    <!-- Blog Header -->
    <div class="blog-container">
        <div class="blog-header">
            <h1>FreeLang 기술 블로그</h1>
            <p>컴파일러 개발, 언어 설계, 최신 소식을 만나보세요</p>
        </div>

        <!-- Search -->
        <div class="search-box">
            <input type="text" id="searchInput" placeholder="블로그 검색... (제목, 태그, 내용)">
        </div>

        <!-- Filter -->
        <div class="blog-filter">
            <button class="filter-btn active" data-category="all">전체</button>
            <button class="filter-btn" data-category="개발일지">개발일지</button>
            <button class="filter-btn" data-category="기술">기술</button>
            <button class="filter-btn" data-category="공지">공지</button>
            <button class="filter-btn" data-category="튜토리얼">튜토리얼</button>
        </div>

        <!-- Blog Posts -->
        <div class="blog-posts" id="blogPosts"></div>

        <!-- No Results -->
        <div class="no-results" id="noResults" style="display: none;">
            검색 결과가 없습니다. 다른 키워드를 시도해보세요.
        </div>

        <!-- Pagination -->
        <div class="pagination" id="pagination"></div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>FreeLang</h3>
                    <p>현대적인 프로그래밍 언어</p>
                </div>
                <div class="footer-section">
                    <h4>링크</h4>
                    <ul>
                        <li><a href="index.html">홈</a></li>
                        <li><a href="blog.html">블로그</a></li>
                        <li><a href="community.html">커뮤니티</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>커뮤니티</h4>
                    <ul>
                        <li><a href="https://github.com/freelang">GitHub</a></li>
                        <li><a href="#">Discord</a></li>
                        <li><a href="#">이슈 추적</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 FreeLang. MIT License. Made with ❤️ for the community.</p>
            </div>
        </div>
    </footer>

    <script>
        // Sample blog posts data
        const blogPosts = [
            {
                id: 1,
                title: "Phase 9 Linker 구현 완료 - 심볼 해석과 재배치 처리",
                category: "개발일지",
                date: "2026-03-12",
                author: "FreeLang Team",
                excerpt: "컴파일러의 마지막 단계인 Linker를 완성했습니다. 심볼 테이블 병합, 충돌 감지, 재배치 계산, 그리고 ELF 실행파일 생성까지의 전체 파이프라인을 구현했습니다.",
                tags: ["linker", "컴파일러", "심볼해석", "재배치"],
                content: "..."
            },
            {
                id: 2,
                title: "FreeLang 공식 홈페이지 출시 - 영점 의존성 웹사이트",
                category: "공지",
                date: "2026-03-12",
                author: "Marketing Team",
                excerpt: "FreeLang의 새로운 공식 홈페이지가 출시되었습니다. NPM 패키지 없이 순수 HTML, CSS, JavaScript로 만들어진 고성능 반응형 웹사이트입니다.",
                tags: ["웹사이트", "홍보", "기술"],
                content: "..."
            },
            {
                id: 3,
                title: "x86-64 다중 백엔드 지원 - ARM64, RISC-V, LLVM IR",
                category: "기술",
                date: "2026-03-10",
                author: "Backend Team",
                excerpt: "FreeLang 컴파일러가 이제 3가지 아키텍처를 지원합니다. 각 백엔드의 특징과 ABI 구현 방식을 설명합니다.",
                tags: ["백엔드", "아키텍처", "성능"],
                content: "..."
            },
            {
                id: 4,
                title: "Pattern Matching 구현 - 함수형 프로그래밍 기능 추가",
                category: "기술",
                date: "2026-03-08",
                author: "Language Design Team",
                excerpt: "FreeLang의 패턴 매칭 기능을 자세히 설명합니다. 튜플 분해, 구조체 필드 추출, 와일드카드 등의 사용 방법을 알아봅시다.",
                tags: ["패턴매칭", "함수형", "언어기능"],
                content: "..."
            },
            {
                id: 5,
                title: "FreeLang 시작하기 - 설치부터 첫 프로그램까지",
                category: "튜토리얼",
                date: "2026-03-05",
                author: "Documentation Team",
                excerpt: "FreeLang을 처음 사용하시나요? 설치 방법, 기본 문법, 그리고 첫 프로그램을 작성하는 방법을 단계별로 설명합니다.",
                tags: ["튜토리얼", "입문", "시작하기"],
                content: "..."
            },
            {
                id: 6,
                title: "Comptime 기능으로 컴파일 타임 계산하기",
                category: "기술",
                date: "2026-03-01",
                author: "Language Research Team",
                excerpt: "FreeLang의 강력한 컴파일 타임 계산 기능을 활용하여 성능을 최적화하는 방법을 배워봅시다.",
                tags: ["comptime", "최적화", "성능"],
                content: "..."
            }
        ];

        let currentPage = 1;
        const postsPerPage = 5;
        let filteredPosts = [...blogPosts];

        // Render blog posts
        function renderPosts() {
            const startIdx = (currentPage - 1) * postsPerPage;
            const endIdx = startIdx + postsPerPage;
            const postsToShow = filteredPosts.slice(startIdx, endIdx);

            const postsContainer = document.getElementById('blogPosts');
            const noResults = document.getElementById('noResults');

            if (postsToShow.length === 0) {
                postsContainer.innerHTML = '';
                noResults.style.display = 'block';
                renderPagination();
                return;
            }

            noResults.style.display = 'none';
            postsContainer.innerHTML = postsToShow.map(post => `
                <div class="blog-post">
                    <div class="post-meta">
                        <span class="post-category">${post.category}</span>
                        <span class="post-date">📅 ${post.date}</span>
                        <span class="post-author">✍️ ${post.author}</span>
                    </div>
                    <h2>${post.title}</h2>
                    <p class="post-excerpt">${post.excerpt}</p>
                    <div class="post-tags">
                        ${post.tags.map(tag => `<span class="tag">#${tag}</span>`).join('')}
                    </div>
                </div>
            `).join('');

            renderPagination();
        }

        // Render pagination
        function renderPagination() {
            const totalPages = Math.ceil(filteredPosts.length / postsPerPage);
            const paginationContainer = document.getElementById('pagination');

            if (totalPages <= 1) {
                paginationContainer.innerHTML = '';
                return;
            }

            let html = '';
            for (let i = 1; i <= totalPages; i++) {
                html += `<button class="${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
            }
            paginationContainer.innerHTML = html;
        }

        // Go to page
        function goToPage(page) {
            currentPage = page;
            renderPosts();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Filter by category
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                const category = this.dataset.category;
                if (category === 'all') {
                    filteredPosts = [...blogPosts];
                } else {
                    filteredPosts = blogPosts.filter(post => post.category === category);
                }
                currentPage = 1;
                renderPosts();
            });
        });

        // Search
        document.getElementById('searchInput').addEventListener('input', function(e) {
            const query = e.target.value.toLowerCase();
            filteredPosts = blogPosts.filter(post =>
                post.title.toLowerCase().includes(query) ||
                post.excerpt.toLowerCase().includes(query) ||
                post.tags.some(tag => tag.toLowerCase().includes(query))
            );
            currentPage = 1;
            renderPosts();
        });

        // Mobile menu
        document.querySelector('.hamburger').addEventListener('click', function() {
            document.querySelector('.nav-links').classList.toggle('active');
            this.classList.toggle('active');
        });

        // Initial render
        renderPosts();
    </script>
</body>
</html>
