<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="FreeLang 커뮤니티 - GitHub, Discord, 포럼에서 만나세요">
    <meta name="keywords" content="FreeLang, 커뮤니티, GitHub, Discord, 포럼, 사용자">
    <meta property="og:title" content="FreeLang 커뮤니티">
    <meta property="og:description" content="FreeLang 커뮤니티에 참여하고 다른 사용자들과 연결하세요.">
    <meta property="og:type" content="website">
    <title>FreeLang 커뮤니티</title>
    <link rel="stylesheet" href="style.css">
    <style>
        .community-container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 2rem;
        }

        .community-header {
            text-align: center;
            margin-bottom: 3rem;
            animation: fadeInUp 0.8s ease;
        }

        .community-header h1 {
            font-size: 2.5rem;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .community-header p {
            font-size: 1.1rem;
            color: #999;
        }

        .channels-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-bottom: 4rem;
        }

        .channel-card {
            background: var(--light-bg);
            border-radius: 12px;
            padding: 2rem;
            text-align: center;
            transition: all 0.3s ease;
            animation: fadeInUp 0.6s ease;
            border: 2px solid transparent;
        }

        .channel-card:hover {
            border-color: var(--primary);
            transform: translateY(-10px);
            box-shadow: 0 8px 30px rgba(0, 212, 255, 0.2);
        }

        .channel-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .channel-name {
            font-size: 1.3rem;
            color: var(--primary);
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        .channel-description {
            color: #bbb;
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }

        .channel-stats {
            display: flex;
            justify-content: space-around;
            padding: 1rem 0;
            margin: 1rem 0;
            border-top: 1px solid #333;
            border-bottom: 1px solid #333;
        }

        .stat-item {
            text-align: center;
        }

        .stat-number {
            color: var(--primary);
            font-weight: bold;
            font-size: 1.2rem;
        }

        .stat-text {
            color: #888;
            font-size: 0.75rem;
            margin-top: 0.2rem;
        }

        .channel-link {
            display: inline-block;
            background: var(--primary);
            color: var(--dark-bg);
            padding: 0.8rem 2rem;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .channel-link:hover {
            background: #00a6cc;
            transform: scale(1.05);
        }

        .guidelines-section {
            background: var(--light-bg);
            border: 2px solid var(--primary);
            padding: 2rem;
            border-radius: 12px;
            margin: 2rem 0;
        }

        .guidelines-section h2 {
            color: var(--primary);
            margin-bottom: 1rem;
            font-size: 1.5rem;
        }

        .guideline-list {
            list-style: none;
            padding: 0;
        }

        .guideline-item {
            color: #bbb;
            margin: 0.8rem 0;
            padding-left: 2rem;
            position: relative;
            line-height: 1.6;
        }

        .guideline-item::before {
            content: "✓";
            color: var(--primary);
            font-weight: bold;
            position: absolute;
            left: 0;
        }

        .faq-section {
            margin: 3rem 0;
        }

        .faq-section h2 {
            color: var(--primary);
            margin-bottom: 1.5rem;
            font-size: 1.5rem;
        }

        .faq-item {
            background: var(--light-bg);
            border-radius: 8px;
            margin-bottom: 1rem;
            overflow: hidden;
        }

        .faq-question {
            padding: 1.2rem;
            background: var(--light-bg);
            color: var(--primary);
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-left: 4px solid var(--primary);
        }

        .faq-question:hover {
            background: #252d3d;
        }

        .faq-question.active {
            background: #252d3d;
        }

        .faq-toggle {
            font-size: 1.5rem;
            transition: transform 0.3s ease;
        }

        .faq-question.active .faq-toggle {
            transform: rotate(180deg);
        }

        .faq-answer {
            padding: 1.2rem;
            color: #bbb;
            display: none;
            border-top: 1px solid #333;
            line-height: 1.6;
        }

        .faq-answer.active {
            display: block;
        }

        .events-section {
            margin: 3rem 0;
        }

        .events-section h2 {
            color: var(--primary);
            margin-bottom: 1.5rem;
            font-size: 1.5rem;
        }

        .event-card {
            background: var(--light-bg);
            border-left: 4px solid var(--primary);
            padding: 1.5rem;
            border-radius: 8px;
            margin-bottom: 1rem;
            display: flex;
            gap: 1.5rem;
            align-items: flex-start;
        }

        .event-date {
            background: var(--primary);
            color: var(--dark-bg);
            padding: 1rem;
            border-radius: 8px;
            min-width: 80px;
            text-align: center;
            font-weight: bold;
        }

        .event-content h3 {
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .event-content p {
            color: #bbb;
            margin: 0.3rem 0;
        }

        .event-link {
            color: var(--primary);
            text-decoration: none;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .event-link:hover {
            color: #00a6cc;
        }

        @media (max-width: 768px) {
            .community-container {
                padding: 1rem;
            }

            .community-header h1 {
                font-size: 1.8rem;
            }

            .channels-grid {
                grid-template-columns: 1fr;
            }

            .event-card {
                flex-direction: column;
            }

            .event-date {
                min-width: unset;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <a href="index.html">FreeLang</a>
            </div>
            <button class="hamburger" aria-label="Menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <ul class="nav-links">
                <li><a href="index.html">홈</a></li>
                <li><a href="blog.html">블로그</a></li>
                <li><a href="contributors.html">기여자</a></li>
                <li><a href="community.html" class="active">커뮤니티</a></li>
            </ul>
        </div>
    </nav>

    <!-- Community Header -->
    <div class="community-container">
        <div class="community-header">
            <h1>FreeLang 커뮤니티</h1>
            <p>우리와 함께 연결하고 참여하세요</p>
        </div>

        <!-- Community Channels -->
        <div class="channels-grid" id="channelsGrid"></div>

        <!-- Community Guidelines -->
        <div class="guidelines-section">
            <h2>🤝 커뮤니티 가이드라인</h2>
            <ul class="guideline-list">
                <li><strong>존중:</strong> 모든 사람을 존중하고 건설적인 태도로 참여해주세요.</li>
                <li><strong>공개성:</strong> 질문하고, 배우고, 다른 사람을 도와주세요.</li>
                <li><strong>포용성:</strong> 초보자와 전문가 모두를 환영합니다.</li>
                <li><strong>정직성:</strong> 실수를 인정하고 함께 개선해나갑시다.</li>
                <li><strong>자유:</strong> 자유로운 생각과 다양한 의견을 존중합니다.</li>
                <li><strong>창의성:</strong> 새로운 아이디어와 기여를 환영합니다.</li>
            </ul>
        </div>

        <!-- FAQ -->
        <div class="faq-section">
            <h2>❓ 자주 묻는 질문</h2>
            <div id="faqContainer"></div>
        </div>

        <!-- Events -->
        <div class="events-section">
            <h2>📅 예정된 이벤트</h2>
            <div id="eventsContainer"></div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>FreeLang</h3>
                    <p>현대적인 프로그래밍 언어</p>
                </div>
                <div class="footer-section">
                    <h4>링크</h4>
                    <ul>
                        <li><a href="index.html">홈</a></li>
                        <li><a href="blog.html">블로그</a></li>
                        <li><a href="community.html">커뮤니티</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>커뮤니티</h4>
                    <ul>
                        <li><a href="https://github.com/freelang">GitHub</a></li>
                        <li><a href="#">Discord</a></li>
                        <li><a href="#">이슈 추적</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 FreeLang. MIT License. Made with ❤️ for the community.</p>
            </div>
        </div>
    </footer>

    <script>
        // Community channels data
        const channels = [
            {
                icon: "🐙",
                name: "GitHub",
                description: "소스 코드, 이슈 추적, PR 제출",
                stats: [
                    { number: "1.2K", label: "커밋" },
                    { number: "150+", label: "스타" },
                    { number: "50+", label: "포크" }
                ],
                link: "https://github.com/freelang"
            },
            {
                icon: "💬",
                name: "Discord",
                description: "실시간 채팅, 토론, 라이브 스트리밍",
                stats: [
                    { number: "500+", label: "멤버" },
                    { number: "10+", label: "채널" },
                    { number: "24/7", label: "온라인" }
                ],
                link: "#"
            },
            {
                icon: "💡",
                name: "Discussions",
                description: "기능 제안, 아이디어 공유, 설계 논의",
                stats: [
                    { number: "200+", label: "토론" },
                    { number: "1K+", label: "댓글" },
                    { number: "100+", label: "투표" }
                ],
                link: "#"
            },
            {
                icon: "📝",
                name: "Wiki & Docs",
                description: "문서, 튜토리얼, 가이드",
                stats: [
                    { number: "50+", label: "페이지" },
                    { number: "10K+", label: "단어" },
                    { number: "30+", label: "예제" }
                ],
                link: "#"
            },
            {
                icon: "🗣️",
                name: "포럼",
                description: "커뮤니티 포럼, 질문 & 답변",
                stats: [
                    { number: "300+", label: "스레드" },
                    { number: "1.5K+", label: "게시물" },
                    { number: "활발", label: "상태" }
                ],
                link: "#"
            },
            {
                icon: "🔔",
                name: "뉴스레터",
                description: "주간 소식, 업데이트, 공지사항",
                stats: [
                    { number: "2K+", label: "구독자" },
                    { number: "주 1회", label: "배송" },
                    { number: "10K", label: "독자" }
                ],
                link: "#"
            }
        ];

        // FAQ data
        const faqs = [
            {
                question: "FreeLang은 어떤 프로그래밍 언어인가요?",
                answer: "FreeLang은 현대적인 프로그래밍 언어로, 성능, 안전성, 생산성을 모두 갖추고 있습니다. Rust의 안전성, Go의 간단함, Python의 유연성을 조합했습니다."
            },
            {
                question: "FreeLang은 언제 출시되나요?",
                answer: "FreeLang은 현재 개발 중이며, 2026년 중반에 베타 출시를 목표로 하고 있습니다. GitHub에서 최신 진행 상황을 확인할 수 있습니다."
            },
            {
                question: "기여하고 싶은데 어떻게 시작하나요?",
                answer: "GitHub 저장소에서 이슈를 확인하고, 'good first issue' 태그가 있는 것부터 시작하세요. Pull Request를 보내기 전에 CONTRIBUTING.md를 읽어주세요."
            },
            {
                question: "FreeLang을 설치할 수 있나요?",
                answer: "현재 개발 중인 단계이지만, GitHub에서 소스 코드를 받아 빌드할 수 있습니다. 자세한 방법은 README.md를 참고해주세요."
            }
        ];

        // Events data
        const events = [
            {
                date: "2026\n04\n15",
                title: "FreeLang 커뮤니티 미트업",
                description: "첫 번째 공식 커뮤니티 미트업 - 온라인 & 오프라인 개최",
                link: "#"
            },
            {
                date: "2026\n05\n01",
                title: "FreeLang 해커톤",
                description: "48시간 온라인 해커톤 - 상금 및 인정서 제공",
                link: "#"
            },
            {
                date: "2026\n06\n10",
                title: "베타 출시 발표회",
                description: "FreeLang 베타 버전 공식 출시 및 라이브 데모",
                link: "#"
            }
        ];

        // Render channels
        function renderChannels() {
            const container = document.getElementById('channelsGrid');
            container.innerHTML = channels.map(channel => `
                <div class="channel-card">
                    <div class="channel-icon">${channel.icon}</div>
                    <div class="channel-name">${channel.name}</div>
                    <div class="channel-description">${channel.description}</div>
                    <div class="channel-stats">
                        ${channel.stats.map(stat => `
                            <div class="stat-item">
                                <div class="stat-number">${stat.number}</div>
                                <div class="stat-text">${stat.label}</div>
                            </div>
                        `).join('')}
                    </div>
                    <a href="${channel.link}" class="channel-link">참여하기</a>
                </div>
            `).join('');
        }

        // Render FAQ
        function renderFAQ() {
            const container = document.getElementById('faqContainer');
            container.innerHTML = faqs.map((faq, index) => `
                <div class="faq-item">
                    <div class="faq-question" onclick="toggleFAQ(this)">
                        <span>${faq.question}</span>
                        <span class="faq-toggle">▼</span>
                    </div>
                    <div class="faq-answer">
                        <p>${faq.answer}</p>
                    </div>
                </div>
            `).join('');
        }

        // Render Events
        function renderEvents() {
            const container = document.getElementById('eventsContainer');
            container.innerHTML = events.map(event => `
                <div class="event-card">
                    <div class="event-date">${event.date}</div>
                    <div class="event-content">
                        <h3>${event.title}</h3>
                        <p>${event.description}</p>
                        <a href="${event.link}" class="event-link">자세히 보기 →</a>
                    </div>
                </div>
            `).join('');
        }

        // Toggle FAQ
        function toggleFAQ(element) {
            const answer = element.nextElementSibling;
            element.classList.toggle('active');
            answer.classList.toggle('active');
        }

        // Initial render
        renderChannels();
        renderFAQ();
        renderEvents();

        // Mobile menu
        document.querySelector('.hamburger').addEventListener('click', function() {
            document.querySelector('.nav-links').classList.toggle('active');
            this.classList.toggle('active');
        });
    </script>
</body>
</html>
