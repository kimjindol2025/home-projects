    <!-- Code Example Section -->
    <section class="code-example">
        <div class="container">
            <h2>코드 예시</h2>
            <div class="code-showcase">
                <div class="code-panel">
                    <div class="code-header">factorial.fl</div>
                    <pre><code>// FreeLang으로 팩토리얼 함수 구현
fn factorial(n) -> i64 {
  if (n <= 1) {
    return 1
  }
  return n * factorial(n - 1)
}

fn main() {
  let result = factorial(5)
  println("5! = " + str(result))  // 5! = 120
}</code></pre>
                </div>

                <div class="code-panel">
                    <div class="code-header">컴파일 및 실행</div>
                    <pre><code>$ freelang factorial.fl -o factorial
$ ./factorial
5! = 120

# 생성된 바이너리는 독립적으로 실행 가능
# 외부 런타임이나 라이브러리 불필요!</code></pre>
