<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="FreeLang 기여자 - 핵심 팀과 커뮤니티 기여자들">
    <meta name="keywords" content="FreeLang, 기여자, 팀, 개발자, 커뮤니티">
    <meta property="og:title" content="FreeLang 기여자">
    <meta property="og:description" content="FreeLang을 만들고 있는 핵심 팀과 커뮤니티 기여자들을 소개합니다.">
    <meta property="og:type" content="website">
    <title>FreeLang 기여자</title>
    <link rel="stylesheet" href="style.css">
    <style>
        .contributors-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        .contributors-header {
            text-align: center;
            margin-bottom: 3rem;
            animation: fadeInUp 0.8s ease;
        }

        .contributors-header h1 {
            font-size: 2.5rem;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .contributors-header p {
            font-size: 1.1rem;
            color: #999;
        }

        .team-section {
            margin-bottom: 4rem;
        }

        .section-title {
            font-size: 1.8rem;
            color: var(--primary);
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid var(--primary);
            animation: slideInRight 0.8s ease;
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .contributor-card {
            background: var(--light-bg);
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
            animation: fadeInUp 0.6s ease;
            border: 2px solid transparent;
        }

        .contributor-card:hover {
            border-color: var(--primary);
            transform: translateY(-10px);
            box-shadow: 0 8px 30px rgba(0, 212, 255, 0.2);
        }

        .avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), #003366);
            margin: 0 auto 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: bold;
            color: var(--dark-bg);
        }

        .contributor-name {
            font-size: 1.2rem;
            color: var(--primary);
            margin: 0.5rem 0;
            font-weight: bold;
        }

        .contributor-role {
            color: #888;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .contributor-bio {
            color: #bbb;
            font-size: 0.85rem;
            line-height: 1.5;
            margin-bottom: 1rem;
        }

        .contributor-stats {
            display: flex;
            justify-content: space-around;
            margin: 1rem 0;
            padding: 0.5rem 0;
            border-top: 1px solid #333;
            border-bottom: 1px solid #333;
        }

        .stat {
            text-align: center;
        }

        .stat-number {
            color: var(--primary);
            font-weight: bold;
            font-size: 1.2rem;
        }

        .stat-label {
            color: #888;
            font-size: 0.75rem;
            margin-top: 0.2rem;
            text-transform: uppercase;
        }

        .contributor-links {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
            margin-top: 1rem;
        }

        .social-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: transparent;
            border: 2px solid var(--primary);
            color: var(--primary);
            text-decoration: none;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .social-link:hover {
            background: var(--primary);
            color: var(--dark-bg);
        }

        .stats-summary {
            background: var(--light-bg);
            border: 2px solid var(--primary);
            padding: 2rem;
            border-radius: 12px;
            margin: 3rem 0;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            text-align: center;
        }

        .summary-stat {
            padding: 1rem;
        }

        .summary-stat-number {
            font-size: 2rem;
            color: var(--primary);
            font-weight: bold;
        }

        .summary-stat-label {
            color: #999;
            margin-top: 0.5rem;
            font-size: 0.9rem;
        }

        .cta-section {
            background: linear-gradient(135deg, var(--primary) + "20", var(--secondary) + "20");
            border: 2px solid var(--primary);
            padding: 2rem;
            border-radius: 12px;
            text-align: center;
            margin: 3rem 0;
        }

        .cta-section h2 {
            color: var(--primary);
            margin-bottom: 1rem;
        }

        .cta-section p {
            color: #ccc;
            margin-bottom: 1rem;
        }

        .cta-button {
            display: inline-block;
            background: var(--primary);
            color: var(--dark-bg);
            padding: 0.8rem 2rem;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            font-size: 1rem;
        }

        .cta-button:hover {
            background: #00a6cc;
            transform: scale(1.05);
        }

        @media (max-width: 768px) {
            .contributors-container {
                padding: 1rem;
            }

            .contributors-header h1 {
                font-size: 1.8rem;
            }

            .team-grid {
                grid-template-columns: 1fr;
            }

            .stats-summary {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <a href="index.html">FreeLang</a>
            </div>
            <button class="hamburger" aria-label="Menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <ul class="nav-links">
                <li><a href="index.html">홈</a></li>
                <li><a href="blog.html">블로그</a></li>
                <li><a href="contributors.html" class="active">기여자</a></li>
                <li><a href="community.html">커뮤니티</a></li>
            </ul>
        </div>
    </nav>

    <!-- Contributors Header -->
    <div class="contributors-container">
        <div class="contributors-header">
            <h1>FreeLang 기여자</h1>
            <p>FreeLang을 만들고 있는 핵심 팀과 커뮤니티 기여자들</p>
        </div>

        <!-- Stats Summary -->
        <div class="stats-summary">
            <div class="summary-stat">
                <div class="summary-stat-number">15+</div>
                <div class="summary-stat-label">활동 중인 기여자</div>
            </div>
            <div class="summary-stat">
                <div class="summary-stat-number">1.2K</div>
                <div class="summary-stat-label">GitHub 커밋</div>
            </div>
            <div class="summary-stat">
                <div class="summary-stat-number">5K</div>
                <div class="summary-stat-label">줄의 코드</div>
            </div>
            <div class="summary-stat">
                <div class="summary-stat-number">100+</div>
                <div class="summary-stat-label">테스트 케이스</div>
            </div>
        </div>

        <!-- Core Team -->
        <div class="team-section">
            <h2 class="section-title">핵심 팀</h2>
            <div class="team-grid" id="coreTeam"></div>
        </div>

        <!-- Contributors -->
        <div class="team-section">
            <h2 class="section-title">커뮤니티 기여자</h2>
            <div class="team-grid" id="contributors"></div>
        </div>

        <!-- CTA Section -->
        <div class="cta-section">
            <h2>당신도 기여자가 될 수 있습니다!</h2>
            <p>FreeLang 프로젝트에 참여하고 싶으신가요?</p>
            <a href="https://github.com/freelang" class="cta-button">GitHub에서 참여하기</a>
            <p style="margin-top: 1rem; font-size: 0.9rem; color: #888;">
                이슈 작성, PR 제출, 문서 개선 등 다양한 방식으로 기여할 수 있습니다.
            </p>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>FreeLang</h3>
                    <p>현대적인 프로그래밍 언어</p>
                </div>
                <div class="footer-section">
                    <h4>링크</h4>
                    <ul>
                        <li><a href="index.html">홈</a></li>
                        <li><a href="blog.html">블로그</a></li>
                        <li><a href="contributors.html">기여자</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>커뮤니티</h4>
                    <ul>
                        <li><a href="https://github.com/freelang">GitHub</a></li>
                        <li><a href="#">Discord</a></li>
                        <li><a href="#">이슈 추적</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 FreeLang. MIT License. Made with ❤️ for the community.</p>
            </div>
        </div>
    </footer>

    <script>
        // Contributors data
        const coreTeamData = [
            {
                name: "Kim",
                role: "Lead Developer",
                bio: "컴파일러 설계 & 코드 제너레이션",
                avatar: "🚀",
                commits: 287,
                prs: 42,
                issues: 18,
                links: {
                    github: "https://github.com/kim",
                    linkedin: "#"
                }
            },
            {
                name: "Alex",
                role: "Backend Engineer",
                bio: "x86-64, ARM64 백엔드 구현",
                avatar: "⚙️",
                commits: 156,
                prs: 28,
                issues: 12,
                links: {
                    github: "https://github.com/alex",
                    twitter: "#"
                }
            },
            {
                name: "Sarah",
                role: "Language Designer",
                bio: "언어 기능 설계 & 문법 정의",
                avatar: "🎨",
                commits: 143,
                prs: 31,
                issues: 22,
                links: {
                    github: "https://github.com/sarah",
                    linkedin: "#"
                }
            }
        ];

        const contributorsData = [
            {
                name: "Jordan",
                role: "Documentation",
                bio: "문서화 및 튜토리얼 작성",
                avatar: "📚",
                commits: 87,
                prs: 15,
                issues: 8
            },
            {
                name: "Casey",
                role: "Testing",
                bio: "테스트 케이스 작성 & QA",
                avatar: "🧪",
                commits: 124,
                prs: 22,
                issues: 14
            },
            {
                name: "Morgan",
                role: "Web Developer",
                bio: "웹사이트 및 온라인 도구 개발",
                avatar: "🌐",
                commits: 67,
                prs: 12,
                issues: 6
            },
            {
                name: "Taylor",
                role: "Optimizer",
                bio: "성능 최적화 및 벤치마킹",
                avatar: "⚡",
                commits: 92,
                prs: 18,
                issues: 11
            },
            {
                name: "Alex R.",
                role: "Infrastructure",
                bio: "CI/CD 파이프라인 구축",
                avatar: "🔧",
                commits: 45,
                prs: 9,
                issues: 5
            },
            {
                name: "Jamie",
                role: "Community",
                bio: "커뮤니티 관리 및 피드백",
                avatar: "👥",
                commits: 34,
                prs: 7,
                issues: 12
            }
        ];

        // Render team members
        function renderTeam(data, containerId) {
            const container = document.getElementById(containerId);
            container.innerHTML = data.map(member => `
                <div class="contributor-card">
                    <div class="avatar">${member.avatar}</div>
                    <div class="contributor-name">${member.name}</div>
                    <div class="contributor-role">${member.role}</div>
                    <div class="contributor-bio">${member.bio}</div>
                    <div class="contributor-stats">
                        <div class="stat">
                            <div class="stat-number">${member.commits}</div>
                            <div class="stat-label">Commits</div>
                        </div>
                        <div class="stat">
                            <div class="stat-number">${member.prs}</div>
                            <div class="stat-label">PRs</div>
                        </div>
                        <div class="stat">
                            <div class="stat-number">${member.issues}</div>
                            <div class="stat-label">Issues</div>
                        </div>
                    </div>
                    ${member.links ? `
                        <div class="contributor-links">
                            ${member.links.github ? `<a href="${member.links.github}" class="social-link" title="GitHub">🔗</a>` : ''}
                            ${member.links.twitter ? `<a href="${member.links.twitter}" class="social-link" title="Twitter">𝕏</a>` : ''}
                            ${member.links.linkedin ? `<a href="${member.links.linkedin}" class="social-link" title="LinkedIn">in</a>` : ''}
                        </div>
                    ` : ''}
                </div>
            `).join('');
        }

        // Render teams
        renderTeam(coreTeamData, 'coreTeam');
        renderTeam(contributorsData, 'contributors');

        // Mobile menu
        document.querySelector('.hamburger').addEventListener('click', function() {
            document.querySelector('.nav-links').classList.toggle('active');
            this.classList.toggle('active');
        });
    </script>
</body>
</html>
