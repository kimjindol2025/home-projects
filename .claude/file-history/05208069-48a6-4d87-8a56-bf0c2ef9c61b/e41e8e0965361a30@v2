/* C Self-Hosting Compiler - Main Driver */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "lexer.h"
#include "parser.h"
#include "ir.h"
#include "sema.h"
#include "codegen.h"

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "Usage: %s <input.c> [output.s]\n", argv[0]);
        return 1;
    }

    const char *input_file = argv[1];
    const char *output_file = (argc >= 3) ? argv[2] : "output.s";

    /* Phase 1: Read source file */
    FILE *fin = fopen(input_file, "r");
    if (!fin) {
        fprintf(stderr, "Error: Cannot open input file '%s'\n", input_file);
        return 1;
    }

    fseek(fin, 0, SEEK_END);
    long fsize = ftell(fin);
    fseek(fin, 0, SEEK_SET);

    char *source = (char *)malloc(fsize + 1);
    if (!source) {
        fprintf(stderr, "Error: Memory allocation failed\n");
        fclose(fin);
        return 1;
    }

    size_t read_size = fread(source, 1, fsize, fin);
    source[read_size] = '\0';
    fclose(fin);

    /* Phase 2: Lexer */
    Lexer *lexer = lexer_new(source, read_size);
    if (!lexer) {
        fprintf(stderr, "Error: Lexer initialization failed\n");
        free(source);
        return 1;
    }

    if (lexer_tokenize(lexer) != 0) {
        fprintf(stderr, "Error: Tokenization failed\n");
        lexer_free(lexer);
        free(source);
        return 1;
    }

    /* Phase 3: Parser */
    Parser *parser = parser_new(lexer);
    if (!parser) {
        fprintf(stderr, "Error: Parser initialization failed\n");
        lexer_free(lexer);
        free(source);
        return 1;
    }

    Node *program = parse_program(parser);
    if (!program) {
        fprintf(stderr, "Error: Parse failed\n");
        parser_free(parser);
        lexer_free(lexer);
        free(source);
        return 1;
    }

    /* Phase 4: IR Generation (AST -> CIR) */
    CirModule *ir = cir_module_new();
    if (!ir) {
        fprintf(stderr, "Error: IR module creation failed\n");
        node_free(program);
        parser_free(parser);
        lexer_free(lexer);
        free(source);
        return 1;
    }

    AstGen astgen = {0};
    astgen.module = ir;
    // Initialize variable tracking with initial capacity
    astgen.var_cap = 16;
    astgen.var_names = (char **)malloc(sizeof(char *) * 16);
    astgen.var_ids = (uint32_t *)malloc(sizeof(uint32_t) * 16);
    if (!astgen.var_names || !astgen.var_ids) {
        fprintf(stderr, "Error: AstGen initialization failed\n");
        cir_module_free(ir);
        node_free(program);
        parser_free(parser);
        lexer_free(lexer);
        free(source);
        return 1;
    }
    astgen_program(&astgen, program);
    free(astgen.var_names);
    free(astgen.var_ids);

    /* Phase 5: Semantic Analysis (skipped for now) */
    Sema *sema = sema_new();
    if (!sema) {
        fprintf(stderr, "Error: Sema initialization failed\n");
        cir_module_free(ir);
        node_free(program);
        parser_free(parser);
        lexer_free(lexer);
        free(source);
        return 1;
    }

    /* Phase 6: Code Generation (CIR -> x86-64 Assembly) */
    FILE *fout = fopen(output_file, "w");
    if (!fout) {
        fprintf(stderr, "Error: Cannot open output file '%s'\n", output_file);
        sema_free(sema);
        cir_module_free(ir);
        node_free(program);
        parser_free(parser);
        lexer_free(lexer);
        free(source);
        return 1;
    }

    Codegen *codegen = codegen_new(ir, fout);
    if (!codegen) {
        fprintf(stderr, "Error: Codegen initialization failed\n");
        fclose(fout);
        sema_free(sema);
        cir_module_free(ir);
        node_free(program);
        parser_free(parser);
        lexer_free(lexer);
        free(source);
        return 1;
    }

    codegen_emit(codegen);

    codegen_free(codegen);
    fclose(fout);

    /* Cleanup */
    sema_free(sema);
    cir_module_free(ir);
    node_free(program);
    parser_free(parser);
    lexer_free(lexer);
    free(source);

    fprintf(stderr, "Compilation successful: %s -> %s\n", input_file, output_file);
    return 0;
}
