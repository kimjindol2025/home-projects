/* Helper: compile C code to assembly */
int compile_c_to_asm(const char *code, const char *out_file) {
    Lexer *lex = lexer_new(code, strlen(code));
    if (!lex) return -1;

    if (lexer_tokenize(lex) != 0) {
        lexer_free(lex);
        return -1;
    }

    Parser *p = parser_new(lex);
    if (!p) {
        lexer_free(lex);
        return -1;
    }

    Node *program = parse_program(p);
    parser_free(p);
    lexer_free(lex);

    if (!program) return -1;

    /* Semantic analysis */
    Sema *sema = sema_new();
    if (!sema) {
        node_free_recursive(program);
        return -1;
    }

    sema_check(sema, program);
    int sema_errors = sema->error_count;
    sema_free(sema);

    if (sema_errors > 0) {
        node_free_recursive(program);
        return -1;  /* Sema failed */
    }

    /* CIR generation */
    CirModule *module = cir_module_new();
    if (!module) {
        node_free_recursive(program);
        return -1;
    }

    AstGen *gen = astgen_new(module);
    if (!gen) {
        cir_module_free(module);
        node_free_recursive(program);
        return -1;
    }

    astgen_program(gen, program);
    astgen_free(gen);
    node_free_recursive(program);

    /* Code generation */
    FILE *out = fopen(out_file, "w");
    if (!out) {
        cir_module_free(module);
        return -1;
    }

    Codegen *cg = codegen_new(module, out);
    if (!cg) {
        fclose(out);
        cir_module_free(module);
        return -1;
    }

    codegen_emit(cg);
    codegen_free(cg);
    fclose(out);
    cir_module_free(module);

    return 0;
}

/* Helper: check if assembly file contains a pattern */
int asm_contains(const char *asm_file, const char *pattern) {
    FILE *f = fopen(asm_file, "r");
    if (!f) return 0;

    char line[512];
    int found = 0;
    while (fgets(line, sizeof(line), f)) {
        if (strstr(line, pattern)) {
            found = 1;
            break;
        }
    }

    fclose(f);
    return found;
}

