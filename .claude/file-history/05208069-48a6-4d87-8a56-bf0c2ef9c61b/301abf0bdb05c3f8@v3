#include "ast.h"
#include <stdlib.h>
#include <stdio.h>
#include <string.h>

/* 노드 종류 문자열 */
static const char *node_kind_to_string(NodeKind kind) {
    switch (kind) {
        case ND_PROGRAM: return "PROGRAM";
        case ND_FUNC_DEF: return "FUNC_DEF";
        case ND_VAR_DECL: return "VAR_DECL";
        case ND_BLOCK: return "BLOCK";
        case ND_IF: return "IF";
        case ND_WHILE: return "WHILE";
        case ND_FOR: return "FOR";
        case ND_RETURN: return "RETURN";
        case ND_BREAK: return "BREAK";
        case ND_CONTINUE: return "CONTINUE";
        case ND_ASSIGN: return "ASSIGN";
        case ND_BINARY: return "BINARY";
        case ND_UNARY: return "UNARY";
        case ND_CALL: return "CALL";
        case ND_INDEX: return "INDEX";
        case ND_MEMBER: return "MEMBER";
        case ND_INT_LIT: return "INT_LIT";
        case ND_FLOAT_LIT: return "FLOAT_LIT";
        case ND_CHAR_LIT: return "CHAR_LIT";
        case ND_STR_LIT: return "STR_LIT";
        case ND_IDENT: return "IDENT";
        case ND_TYPE_BASE: return "TYPE_BASE";
        case ND_TYPE_PTR: return "TYPE_PTR";
        default: return "UNKNOWN";
    }
}

/* 연산자 종류 문자열 */
static const char *op_to_string(TokenKind op) {
    switch (op) {
        case TK_PLUS: return "+";
        case TK_MINUS: return "-";
        case TK_STAR: return "*";
        case TK_SLASH: return "/";
        case TK_PERCENT: return "%";
        case TK_EQ: return "==";
        case TK_NEQ: return "!=";
        case TK_LT: return "<";
        case TK_LE: return "<=";
        case TK_GT: return ">";
        case TK_GE: return ">=";
        case TK_ASSIGN: return "=";
        case TK_PLUS_ASSIGN: return "+=";
        case TK_MINUS_ASSIGN: return "-=";
        case TK_AND: return "&&";
        case TK_OR: return "||";
        case TK_AMPERSAND: return "&";
        case TK_PIPE: return "|";
        default: return "?";
    }
}

/* 노드 생성 */
Node *node_new(NodeKind kind, SourceLoc loc) {
    Node *n = (Node *)malloc(sizeof(Node));
    if (!n) return NULL;

    n->kind = kind;
    n->loc = loc;

    n->left = n->right = NULL;
    n->cond = n->then_body = n->else_body = NULL;
    n->init = n->step = n->body = NULL;
    n->type_node = NULL;

    n->children = NULL;
    n->child_count = 0;
    n->child_cap = 0;

    n->int_val = 0;
    n->float_val = 0.0;
    n->char_val = 0;
    n->str_val = NULL;
    n->name = NULL;

    n->op = TK_UNKNOWN;
    n->is_prefix = 0;
    n->array_size = -1;
    n->member_idx = -1;

    return n;
}

/* 노드 해제 (비재귀) */
void node_free(Node *node) {
    if (!node) return;
    if (node->str_val) free(node->str_val);
    if (node->name) free(node->name);
    if (node->children) free(node->children);
    free(node);
}

/* 노드 재귀 해제 */
void node_free_recursive(Node *node) {
    if (!node) return;

    node_free_recursive(node->left);
    node_free_recursive(node->right);
    node_free_recursive(node->cond);
    node_free_recursive(node->then_body);
    node_free_recursive(node->else_body);
    node_free_recursive(node->init);
    node_free_recursive(node->step);
    node_free_recursive(node->body);
    node_free_recursive(node->type_node);

    for (int i = 0; i < node->child_count; i++) {
        node_free_recursive(node->children[i]);
    }

    node_free(node);
}

/* 자식 노드 추가 */
void node_add_child(Node *parent, Node *child) {
    if (!parent || !child) return;

    if (parent->child_count >= parent->child_cap) {
        parent->child_cap = parent->child_cap == 0 ? 8 : parent->child_cap * 2;
        Node **new_children = (Node **)realloc(parent->children, sizeof(Node *) * parent->child_cap);
        if (!new_children) return;
        parent->children = new_children;
    }

    parent->children[parent->child_count++] = child;
}

/* AST 디버그 출력 */
void ast_dump(Node *node, int indent) {
    if (!node) return;

    for (int i = 0; i < indent; i++) printf("  ");

    printf("[%s]", node_kind_to_string(node->kind));

    if (node->kind == ND_INT_LIT) {
        printf(" = %lld\n", node->int_val);
    } else if (node->kind == ND_FLOAT_LIT) {
        printf(" = %f\n", node->float_val);
    } else if (node->kind == ND_IDENT) {
        printf(" name=\"%s\"\n", node->name);
    } else if (node->kind == ND_STR_LIT) {
        printf(" value=\"%s\"\n", node->str_val);
    } else if (node->kind == ND_BINARY || node->kind == ND_UNARY) {
        printf(" op=%s\n", op_to_string(node->op));
    } else {
        printf("\n");
    }

    if (node->left) {
        for (int i = 0; i < indent + 1; i++) printf("  ");
        printf("├─ left:\n");
        ast_dump(node->left, indent + 2);
    }

    if (node->right) {
        for (int i = 0; i < indent + 1; i++) printf("  ");
        printf("├─ right:\n");
        ast_dump(node->right, indent + 2);
    }

    if (node->body) {
        for (int i = 0; i < indent + 1; i++) printf("  ");
        printf("├─ body:\n");
        ast_dump(node->body, indent + 2);
    }

    for (int i = 0; i < node->child_count; i++) {
        for (int j = 0; j < indent + 1; j++) printf("  ");
        printf("├─ child[%d]:\n", i);
        ast_dump(node->children[i], indent + 2);
    }
}
