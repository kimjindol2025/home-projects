#ifndef IR_H
#define IR_H

#include <stdint.h>
#include <stddef.h>
#include "ast.h"

/* CIR Reference (index into instruction array) */
typedef uint32_t CirRef;
#define CIR_REF_NULL 0

/* CIR Opcodes (30개) */
typedef enum {
    /* Literal loads */
    CIR_LOAD_INT,
    CIR_LOAD_FLOAT,
    CIR_LOAD_STR,
    CIR_LOAD_VAR,

    /* Memory operations */
    CIR_STORE_VAR,
    CIR_ADDR_OF,
    CIR_DEREF,
    CIR_INDEX,
    CIR_MEMBER,

    /* Arithmetic/Logic */
    CIR_BINARY,
    CIR_UNARY,
    CIR_CAST,

    /* Control flow */
    CIR_LABEL,
    CIR_JMP,
    CIR_JMP_IF,
    CIR_RETURN,

    /* Functions */
    CIR_FUNC_BEGIN,
    CIR_FUNC_END,
    CIR_CALL,
    CIR_ARG,

    /* Special */
    CIR_SIZEOF,
    CIR_PHI,
    CIR_NOP,
} CirOpcode;

/* Individual instruction */
typedef struct {
    CirOpcode op;
    union {
        struct { long long imm; }                              load_int;
        struct { double imm; }                                 load_float;
        struct { uint32_t str_idx; }                           load_str;
        struct { uint32_t name_idx; }                          load_var;
        struct { uint32_t name_idx; CirRef value; }            store_var;
        struct { CirRef operand; }                             addr_of;
        struct { CirRef operand; }                             deref;
        struct { CirRef array; CirRef idx; }                   index;
        struct { CirRef object; int field_idx; }               member;
        struct { int op; CirRef lhs; CirRef rhs; }             binary;
        struct { int op; CirRef operand; }                     unary;
        struct { uint32_t label_id; }                          label;
        struct { uint32_t target; }                            jmp;
        struct { CirRef cond; uint32_t t_label; uint32_t f_label; } jmp_if;
        struct { CirRef value; }                               ret;
        struct { uint32_t name_idx; int param_count; }         func_begin;
        struct { CirRef callee; CirRef *args; int arg_count; } call;
        struct { int arg_idx; }                                arg;
    } u;
} CirInst;

/* Module (entire program IR) */
typedef struct {
    CirInst  *insts;
    uint32_t  inst_count;
    uint32_t  inst_cap;

    char    **strings;
    uint32_t  str_count;
    uint32_t  str_cap;

    uint32_t  next_label;
} CirModule;

/* AstGen (AST → CIR converter state) */
typedef struct {
    CirModule *module;

    /* Local variable name → str_idx mapping */
    char     **var_names;
    uint32_t  *var_ids;
    int        var_count;
    int        var_cap;

    /* break/continue labels */
    uint32_t   break_label;
    uint32_t   continue_label;
} AstGen;

/* Module operations */
CirModule *cir_module_new(void);
void       cir_module_free(CirModule *m);
void       cir_module_dump(CirModule *m);

/* String table */
uint32_t   cir_intern_str(CirModule *m, const char *name);

/* Instruction emission */
CirRef     cir_emit(CirModule *m, CirInst inst);
uint32_t   cir_new_label(CirModule *m);

/* AstGen operations */
AstGen    *astgen_new(CirModule *m);
void       astgen_free(AstGen *g);

/* Main entry points */
void       astgen_program(AstGen *g, Node *program);
void       astgen_func(AstGen *g, Node *func_def);
void       astgen_stmt(AstGen *g, Node *stmt);
CirRef     astgen_expr(AstGen *g, Node *expr);

#endif /* IR_H */
