#ifndef TEST_FRAMEWORK_H
#define TEST_FRAMEWORK_H

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* 테스트 통계 */
static int g_test_count = 0;
static int g_test_passed = 0;
static int g_test_failed = 0;

/* 단일 값 비교 */
#define ASSERT_EQ(actual, expected) \
    do { \
        if ((actual) != (expected)) { \
            fprintf(stderr, "[FAIL] %s:%d: " \
                    "ASSERT_EQ(%lld, %lld) failed\n", \
                    __FILE__, __LINE__, (long long)(actual), (long long)(expected)); \
            g_test_failed++; \
            exit(1); \
        } \
    } while(0)

/* 포인터 비교 */
#define ASSERT_PTR_EQ(actual, expected) \
    do { \
        if ((actual) != (expected)) { \
            fprintf(stderr, "[FAIL] %s:%d: " \
                    "ASSERT_PTR_EQ(%p, %p) failed\n", \
                    __FILE__, __LINE__, (actual), (expected)); \
            g_test_failed++; \
            exit(1); \
        } \
    } while(0)

/* 문자열 비교 */
#define ASSERT_STR_EQ(actual, expected) \
    do { \
        if (strcmp((actual), (expected)) != 0) { \
            fprintf(stderr, "[FAIL] %s:%d: " \
                    "ASSERT_STR_EQ(\"%s\", \"%s\") failed\n", \
                    __FILE__, __LINE__, (actual), (expected)); \
            g_test_failed++; \
            exit(1); \
        } \
    } while(0)

/* 조건 검사 */
#define ASSERT(condition) \
    do { \
        if (!(condition)) { \
            fprintf(stderr, "[FAIL] %s:%d: " \
                    "ASSERT(%s) failed\n", \
                    __FILE__, __LINE__, #condition); \
            g_test_failed++; \
            exit(1); \
        } \
    } while(0)

/* 불일치 검사 */
#define ASSERT_NEQ(actual, expected) \
    do { \
        if ((actual) == (expected)) { \
            fprintf(stderr, "[FAIL] %s:%d: " \
                    "ASSERT_NEQ(%lld, %lld) failed\n", \
                    __FILE__, __LINE__, (long long)(actual), (long long)(expected)); \
            g_test_failed++; \
            exit(1); \
        } \
    } while(0)

/* 테스트 정의 */
#define TEST(name) static void test_##name(void)

/* 테스트 실행 */
#define RUN_TEST(name) \
    do { \
        g_test_count++; \
        printf("  [%3d] %-50s ... ", g_test_count, #name); \
        fflush(stdout); \
        test_##name(); \
        printf("OK\n"); \
        g_test_passed++; \
    } while(0)

/* 테스트 스위트 시작/종료 */
#define TEST_SUITE_START(name) \
    int main(void) { \
        printf("\n=== Test Suite: %s ===\n\n", name);

#define TEST_SUITE_END() \
        printf("\n=== Results ===\n"); \
        printf("Total:  %3d\n", g_test_count); \
        printf("Passed: %3d ✓\n", g_test_passed); \
        printf("Failed: %3d ✗\n", g_test_failed); \
        printf("\n"); \
        return g_test_failed > 0 ? 1 : 0; \
    }

#endif /* TEST_FRAMEWORK_H */
