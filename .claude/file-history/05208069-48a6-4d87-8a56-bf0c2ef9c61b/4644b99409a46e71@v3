#ifndef AST_H
#define AST_H

#include "lexer.h"
#include <stdint.h>

/* AST 노드 종류 */
typedef enum {
    /* 최상위 */
    ND_PROGRAM,
    ND_TRANSLATION_UNIT,

    /* 선언 */
    ND_FUNC_DEF,        /* 함수 정의 */
    ND_FUNC_DECL,       /* 함수 선언 */
    ND_VAR_DECL,        /* 변수 선언 */
    ND_PARAM,           /* 함수 파라미터 */
    ND_STRUCT_DEF,      /* struct 정의 */
    ND_UNION_DEF,       /* union 정의 */
    ND_ENUM_DEF,        /* enum 정의 */
    ND_TYPEDEF,         /* typedef */

    /* 문장 */
    ND_BLOCK,           /* { ... } */
    ND_IF,              /* if/if-else */
    ND_WHILE,           /* while */
    ND_DO_WHILE,        /* do-while */
    ND_FOR,             /* for */
    ND_SWITCH,          /* switch */
    ND_CASE,            /* case N: */
    ND_DEFAULT,         /* default: */
    ND_RETURN,          /* return */
    ND_BREAK,           /* break */
    ND_CONTINUE,        /* continue */
    ND_GOTO,            /* goto */
    ND_LABEL,           /* label: */
    ND_EXPR_STMT,       /* 식 문장 */
    ND_NULL_STMT,       /* ; */

    /* 식 */
    ND_ASSIGN,          /* a = b, a += b, etc */
    ND_TERNARY,         /* a ? b : c */
    ND_BINARY,          /* +, -, *, /, %, &, |, ^, <<, >>, ==, !=, <, <=, >, >= */
    ND_UNARY,           /* -, !, ~, &, *, ++, -- */
    ND_CAST,            /* (type)expr */
    ND_CALL,            /* f(args) */
    ND_INDEX,           /* a[i] */
    ND_MEMBER,          /* s.field */
    ND_ARROW,           /* p->field */
    ND_SIZEOF_EXPR,     /* sizeof(expr) */
    ND_SIZEOF_TYPE,     /* sizeof(type) */
    ND_COMMA,           /* a, b */

    /* 리터럴 */
    ND_INT_LIT,
    ND_FLOAT_LIT,
    ND_CHAR_LIT,
    ND_STR_LIT,
    ND_IDENT,

    /* 타입 노드 */
    ND_TYPE_BASE,       /* int, char, void, etc */
    ND_TYPE_PTR,        /* T* */
    ND_TYPE_ARRAY,      /* T[N] */
    ND_TYPE_FUNC,       /* T(params) */
    ND_TYPE_STRUCT,     /* struct name */
    ND_TYPE_UNION,      /* union name */
    ND_TYPE_ENUM,       /* enum name */
} NodeKind;

/* AST 노드 */
typedef struct Node Node;

struct Node {
    NodeKind    kind;
    SourceLoc   loc;

    /* 자식 노드 */
    Node       *left;
    Node       *right;
    Node       *cond;      /* if/while 조건 */
    Node       *then_body; /* if then 본체 */
    Node       *else_body; /* if else 본체 */
    Node       *init;      /* for 초기화 */
    Node       *step;      /* for 스텝 */
    Node       *body;      /* 함수/루프 본체 */
    Node       *type_node; /* 타입 정보 */

    /* 리스트 (함수 파라미터, 블록 내 문장, 함수 호출 인수) */
    Node      **children;
    int         child_count;
    int         child_cap;

    /* 값 */
    long long   int_val;
    double      float_val;
    char        char_val;
    char       *str_val;   /* 힙 할당 */
    char       *name;      /* 식별자, 함수명 */

    /* 연산자 정보 */
    TokenKind   op;        /* 이항/단항/할당 연산자 */
    int         is_prefix; /* ++/-- 전위 여부 */

    /* 배열 크기 */
    int         array_size;

    /* 구조체 멤버 인덱스 */
    int         member_idx;
};

/* AST 트리 */
typedef struct {
    Node       *root;
    // 다른 필드들은 Phase 2.2에서 필요할 때 추가
} Ast;

/* AST 함수 */
Node *node_new(NodeKind kind, SourceLoc loc);
void node_free(Node *node);
void node_add_child(Node *parent, Node *child);
void node_free_recursive(Node *node);

/* 디버그 */
void ast_dump(Node *node, int indent);

#endif /* AST_H */
