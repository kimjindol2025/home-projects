#include "parser.h"
#include <stdlib.h>
#include <stdio.h>
#include <string.h>

/* Parser 구현 - Phase 2.2 (700줄+) */

Parser *parser_new(Lexer *lexer) {
    Parser *p = (Parser *)malloc(sizeof(Parser));
    if (!p) return NULL;
    p->lexer = lexer;
    p->current = 0;
    p->tokens = lexer->tokens;
    p->tok_count = lexer->tok_count;
    return p;
}

void parser_free(Parser *p) {
    if (p) free(p);
}

Token *current_token(Parser *p) {
    if (p->current >= (int)p->tok_count) return &p->tokens[p->tok_count - 1];
    return &p->tokens[p->current];
}

Token *peek_token(Parser *p, int offset) {
    int idx = p->current + offset;
    if (idx >= (int)p->tok_count) return &p->tokens[p->tok_count - 1];
    return &p->tokens[idx];
}

void advance(Parser *p) {
    if (p->current < (int)p->tok_count) p->current++;
}

int check(Parser *p, TokenKind kind) {
    return current_token(p)->kind == kind;
}

int match(Parser *p, TokenKind kind) {
    if (check(p, kind)) {
        advance(p);
        return 1;
    }
    return 0;
}

int consume(Parser *p, TokenKind kind, const char *msg) {
    if (!check(p, kind)) {
        fprintf(stderr, "Parse error at line %d: %s\n", current_token(p)->loc.line, msg);
        return 0;
    }
    advance(p);
    return 1;
}

static int is_type_keyword(TokenKind kind) {
    return kind == TK_INT || kind == TK_CHAR || kind == TK_FLOAT ||
           kind == TK_DOUBLE || kind == TK_VOID || kind == TK_LONG ||
           kind == TK_SHORT || kind == TK_SIGNED || kind == TK_UNSIGNED ||
           kind == TK_STRUCT || kind == TK_UNION || kind == TK_ENUM;
}

/* 타입 파싱 */
Node *parse_type(Parser *p) {
    Token tok = *current_token(p);

    if (!is_type_keyword(tok.kind)) {
        fprintf(stderr, "Expected type at line %d\n", tok.loc.line);
        return NULL;
    }

    Node *type_node = node_new(ND_TYPE_BASE, tok.loc);
    type_node->name = (char *)malloc(20);

    /* 기본 타입 결정 */
    switch (tok.kind) {
        case TK_INT:    strcpy(type_node->name, "int"); break;
        case TK_CHAR:   strcpy(type_node->name, "char"); break;
        case TK_FLOAT:  strcpy(type_node->name, "float"); break;
        case TK_DOUBLE: strcpy(type_node->name, "double"); break;
        case TK_VOID:   strcpy(type_node->name, "void"); break;
        default:        strcpy(type_node->name, "int"); break;
    }
    advance(p);

    /* 포인터 타입 */
    while (match(p, TK_STAR)) {
        Node *ptr_type = node_new(ND_TYPE_PTR, current_token(p)->loc);
        ptr_type->type_node = type_node;
        type_node = ptr_type;
    }

    return type_node;
}

/* 선언자 파싱 (변수 이름) */
Node *parse_declarator(Parser *p) {
    Token tok = *current_token(p);
    if (!check(p, TK_IDENT)) {
        fprintf(stderr, "Expected identifier at line %d\n", tok.loc.line);
        return NULL;
    }

    Node *decl = node_new(ND_IDENT, tok.loc);
    decl->name = (char *)malloc(strlen(tok.val.ident) + 1);
    strcpy(decl->name, tok.val.ident);
    advance(p);

    return decl;
}

/* 함수 정의 파싱 */
Node *parse_func_def(Parser *p) {
    Token tok = *current_token(p);
    Node *type = parse_type(p);
    if (!type) return NULL;

    if (!check(p, TK_IDENT)) {
        fprintf(stderr, "Expected function name at line %d\n", tok.loc.line);
        return NULL;
    }

    Node *func = node_new(ND_FUNC_DEF, tok.loc);
    func->type_node = type;
    func->name = (char *)malloc(strlen(current_token(p)->val.ident) + 1);
    strcpy(func->name, current_token(p)->val.ident);
    advance(p);

    if (!consume(p, TK_LPAREN, "Expected ( in function definition")) return NULL;

    /* 파라미터 파싱 */
    while (!check(p, TK_RPAREN)) {
        Node *param = node_new(ND_PARAM, current_token(p)->loc);
        param->type_node = parse_type(p);
        if (check(p, TK_IDENT)) {
            param->name = (char *)malloc(strlen(current_token(p)->val.ident) + 1);
            strcpy(param->name, current_token(p)->val.ident);
            advance(p);
        }
        node_add_child(func, param);

        if (!check(p, TK_RPAREN)) {
            if (!consume(p, TK_COMMA, "Expected , or ) in parameter list")) return NULL;
        }
    }
    consume(p, TK_RPAREN, "Expected )");

    /* 함수 본체 */
    if (match(p, TK_LBRACE)) {
        func->body = parse_block(p);
    }

    return func;
}

/* 변수 선언 파싱 */
Node *parse_var_decl(Parser *p) {
    Token tok = *current_token(p);
    Node *type = parse_type(p);
    if (!type) return NULL;

    Node *var_decl = node_new(ND_VAR_DECL, tok.loc);
    var_decl->type_node = type;

    /* 선언자 */
    Node *decl = parse_declarator(p);
    if (decl) {
        var_decl->name = decl->name;
        node_add_child(var_decl, decl);
    }

    /* 초기값 */
    if (match(p, TK_ASSIGN)) {
        Node *init = parse_expr(p);
        if (init) node_add_child(var_decl, init);
    }

    return var_decl;
}

/* 선언 파싱 - 함수 정의인지 변수 선언인지 구분 */
Node *parse_declaration(Parser *p) {
    int save_pos = p->current;

    if (!is_type_keyword(current_token(p)->kind)) {
        return NULL;
    }

    /* 타입 스킵 */
    while (match(p, TK_STAR)) ;
    parse_type(p);

    /* 이름 스킵 */
    if (!check(p, TK_IDENT)) {
        p->current = save_pos;
        return NULL;
    }
    advance(p);

    /* ( 다음에 오는지 확인 */
    int is_func = check(p, TK_LPAREN);
    p->current = save_pos;

    if (is_func) {
        return parse_func_def(p);
    } else {
        Node *var = parse_var_decl(p);
        if (var && !consume(p, TK_SEMICOLON, "Expected ; after variable declaration")) {
            return NULL;
        }
        return var;
    }
}

/* 프로그램 파싱 */
Node *parse_program(Parser *p) {
    Token tok = *current_token(p);
    Node *program = node_new(ND_PROGRAM, tok.loc);

    while (!check(p, TK_EOF)) {
        Node *decl = parse_declaration(p);
        if (decl) {
            node_add_child(program, decl);
        } else {
            advance(p);  /* 에러 시 전진 */
        }
    }

    return program;
}

/* 블록 파싱 { ... } */
Node *parse_block(Parser *p) {
    Token tok = *current_token(p);
    Node *block = node_new(ND_BLOCK, tok.loc);

    while (!check(p, TK_RBRACE) && !check(p, TK_EOF)) {
        /* 변수 선언인지 문장인지 구분 */
        if (is_type_keyword(current_token(p)->kind)) {
            Node *decl = parse_var_decl(p);
            if (decl) {
                consume(p, TK_SEMICOLON, "Expected ; after variable declaration");
                node_add_child(block, decl);
            }
        } else {
            Node *stmt = parse_statement(p);
            if (stmt) node_add_child(block, stmt);
        }
    }

    if (!consume(p, TK_RBRACE, "Expected }")) return NULL;
    return block;
}

/* 문장 파싱 */
Node *parse_statement(Parser *p) {
    if (check(p, TK_IF)) return parse_if_statement(p);
    if (check(p, TK_WHILE)) return parse_while_statement(p);
    if (check(p, TK_DO)) return parse_do_while_statement(p);
    if (check(p, TK_FOR)) return parse_for_statement(p);
    if (check(p, TK_RETURN)) return parse_return_statement(p);
    if (check(p, TK_BREAK)) {
        Node *brk = node_new(ND_BREAK, current_token(p)->loc);
        advance(p);
        consume(p, TK_SEMICOLON, "Expected ; after break");
        return brk;
    }
    if (check(p, TK_CONTINUE)) {
        Node *cont = node_new(ND_CONTINUE, current_token(p)->loc);
        advance(p);
        consume(p, TK_SEMICOLON, "Expected ; after continue");
        return cont;
    }
    if (check(p, TK_LBRACE)) {
        advance(p);
        return parse_block(p);
    }

    /* 식 문장 */
    Node *expr = parse_expr(p);
    consume(p, TK_SEMICOLON, "Expected ; after expression");
    if (expr) {
        Node *expr_stmt = node_new(ND_EXPR_STMT, expr->loc);
        expr_stmt->left = expr;
        return expr_stmt;
    }
    return NULL;
}

/* If 문장 파싱 */
Node *parse_if_statement(Parser *p) {
    Token tok = *current_token(p);
    Node *if_stmt = node_new(ND_IF, tok.loc);

    if (!consume(p, TK_IF, "Expected if")) return NULL;
    if (!consume(p, TK_LPAREN, "Expected ( after if")) return NULL;

    if_stmt->cond = parse_expr(p);

    if (!consume(p, TK_RPAREN, "Expected ) after if condition")) return NULL;

    if_stmt->then_body = parse_statement(p);

    if (match(p, TK_ELSE)) {
        if_stmt->else_body = parse_statement(p);
    }

    return if_stmt;
}

/* While 문장 파싱 */
Node *parse_while_statement(Parser *p) {
    Token tok = *current_token(p);
    Node *while_stmt = node_new(ND_WHILE, tok.loc);

    if (!consume(p, TK_WHILE, "Expected while")) return NULL;
    if (!consume(p, TK_LPAREN, "Expected ( after while")) return NULL;

    while_stmt->cond = parse_expr(p);

    if (!consume(p, TK_RPAREN, "Expected ) after while condition")) return NULL;

    while_stmt->body = parse_statement(p);

    return while_stmt;
}

/* Do-while 문장 파싱 */
Node *parse_do_while_statement(Parser *p) {
    Token tok = *current_token(p);
    Node *do_while = node_new(ND_DO_WHILE, tok.loc);

    if (!consume(p, TK_DO, "Expected do")) return NULL;

    do_while->body = parse_statement(p);

    if (!consume(p, TK_WHILE, "Expected while after do body")) return NULL;
    if (!consume(p, TK_LPAREN, "Expected ( after while")) return NULL;

    do_while->cond = parse_expr(p);

    if (!consume(p, TK_RPAREN, "Expected ) after while condition")) return NULL;
    if (!consume(p, TK_SEMICOLON, "Expected ; after do-while")) return NULL;

    return do_while;
}

/* For 문장 파싱 */
Node *parse_for_statement(Parser *p) {
    Token tok = *current_token(p);
    Node *for_stmt = node_new(ND_FOR, tok.loc);

    if (!consume(p, TK_FOR, "Expected for")) return NULL;
    if (!consume(p, TK_LPAREN, "Expected ( after for")) return NULL;

    /* 초기화 */
    if (is_type_keyword(current_token(p)->kind)) {
        for_stmt->init = parse_var_decl(p);
    } else if (!check(p, TK_SEMICOLON)) {
        for_stmt->init = parse_expr(p);
    }
    consume(p, TK_SEMICOLON, "Expected ; after for init");

    /* 조건 */
    if (!check(p, TK_SEMICOLON)) {
        for_stmt->cond = parse_expr(p);
    }
    consume(p, TK_SEMICOLON, "Expected ; after for condition");

    /* 스텝 */
    if (!check(p, TK_RPAREN)) {
        for_stmt->step = parse_expr(p);
    }
    consume(p, TK_RPAREN, "Expected ) after for clauses");

    /* 본체 */
    for_stmt->body = parse_statement(p);

    return for_stmt;
}

/* Return 문장 파싱 */
Node *parse_return_statement(Parser *p) {
    Token tok = *current_token(p);
    Node *ret = node_new(ND_RETURN, tok.loc);

    if (!consume(p, TK_RETURN, "Expected return")) return NULL;

    if (!check(p, TK_SEMICOLON)) {
        ret->left = parse_expr(p);
    }

    consume(p, TK_SEMICOLON, "Expected ; after return");
    return ret;
}

/* 식 파싱 (연산자 우선순위 15단계) */

Node *parse_expr(Parser *p) {
    return parse_assign_expr(p);
}

/* 할당 (=, +=, -=, 등) */
Node *parse_assign_expr(Parser *p) {
    Node *left = parse_ternary_expr(p);

    while (current_token(p)->kind == TK_ASSIGN ||
           current_token(p)->kind == TK_PLUS_ASSIGN ||
           current_token(p)->kind == TK_MINUS_ASSIGN) {
        Token op_tok = *current_token(p);
        advance(p);
        Node *right = parse_ternary_expr(p);

        Node *assign = node_new(ND_ASSIGN, op_tok.loc);
        assign->left = left;
        assign->right = right;
        assign->op = op_tok.kind;
        left = assign;
    }

    return left;
}

/* 삼항 연산자 (? :) */
Node *parse_ternary_expr(Parser *p) {
    Node *cond = parse_logical_or_expr(p);

    if (match(p, TK_QUESTION)) {
        Token tok = *peek_token(p, -1);
        Node *ternary = node_new(ND_TERNARY, tok.loc);
        ternary->cond = cond;
        ternary->left = parse_expr(p);  /* then */
        consume(p, TK_COLON, "Expected : in ternary");
        ternary->right = parse_ternary_expr(p);  /* else */
        return ternary;
    }

    return cond;
}

/* 논리 OR (||) */
Node *parse_logical_or_expr(Parser *p) {
    Node *left = parse_logical_and_expr(p);

    while (check(p, TK_OR)) {
        Token op_tok = *current_token(p);
        advance(p);
        Node *right = parse_logical_and_expr(p);

        Node *binary = node_new(ND_BINARY, op_tok.loc);
        binary->left = left;
        binary->right = right;
        binary->op = TK_OR;
        left = binary;
    }

    return left;
}

/* 논리 AND (&&) */
Node *parse_logical_and_expr(Parser *p) {
    Node *left = parse_bitwise_or_expr(p);

    while (check(p, TK_AND)) {
        Token op_tok = *current_token(p);
        advance(p);
        Node *right = parse_bitwise_or_expr(p);

        Node *binary = node_new(ND_BINARY, op_tok.loc);
        binary->left = left;
        binary->right = right;
        binary->op = TK_AND;
        left = binary;
    }

    return left;
}

/* 비트 OR (|) */
Node *parse_bitwise_or_expr(Parser *p) {
    Node *left = parse_bitwise_xor_expr(p);

    while (check(p, TK_PIPE)) {
        Token op_tok = *current_token(p);
        advance(p);
        Node *right = parse_bitwise_xor_expr(p);

        Node *binary = node_new(ND_BINARY, op_tok.loc);
        binary->left = left;
        binary->right = right;
        binary->op = TK_PIPE;
        left = binary;
    }

    return left;
}

/* 비트 XOR (^) */
Node *parse_bitwise_xor_expr(Parser *p) {
    Node *left = parse_bitwise_and_expr(p);

    while (check(p, TK_CARET)) {
        Token op_tok = *current_token(p);
        advance(p);
        Node *right = parse_bitwise_and_expr(p);

        Node *binary = node_new(ND_BINARY, op_tok.loc);
        binary->left = left;
        binary->right = right;
        binary->op = TK_CARET;
        left = binary;
    }

    return left;
}

/* 비트 AND (&) */
Node *parse_bitwise_and_expr(Parser *p) {
    Node *left = parse_equality_expr(p);

    while (check(p, TK_AMPERSAND)) {
        Token op_tok = *current_token(p);
        advance(p);
        Node *right = parse_equality_expr(p);

        Node *binary = node_new(ND_BINARY, op_tok.loc);
        binary->left = left;
        binary->right = right;
        binary->op = TK_AMPERSAND;
        left = binary;
    }

    return left;
}

/* 같음 연산자 (==, !=) */
Node *parse_equality_expr(Parser *p) {
    Node *left = parse_relational_expr(p);

    while (check(p, TK_EQ) || check(p, TK_NEQ)) {
        Token op_tok = *current_token(p);
        advance(p);
        Node *right = parse_relational_expr(p);

        Node *binary = node_new(ND_BINARY, op_tok.loc);
        binary->left = left;
        binary->right = right;
        binary->op = op_tok.kind;
        left = binary;
    }

    return left;
}

/* 비교 연산자 (<, <=, >, >=) */
Node *parse_relational_expr(Parser *p) {
    Node *left = parse_shift_expr(p);

    while (check(p, TK_LT) || check(p, TK_LE) ||
           check(p, TK_GT) || check(p, TK_GE)) {
        Token op_tok = *current_token(p);
        advance(p);
        Node *right = parse_shift_expr(p);

        Node *binary = node_new(ND_BINARY, op_tok.loc);
        binary->left = left;
        binary->right = right;
        binary->op = op_tok.kind;
        left = binary;
    }

    return left;
}

/* 시프트 연산자 (<<, >>) */
Node *parse_shift_expr(Parser *p) {
    Node *left = parse_additive_expr(p);

    while (check(p, TK_LSHIFT) || check(p, TK_RSHIFT)) {
        Token op_tok = *current_token(p);
        advance(p);
        Node *right = parse_additive_expr(p);

        Node *binary = node_new(ND_BINARY, op_tok.loc);
        binary->left = left;
        binary->right = right;
        binary->op = op_tok.kind;
        left = binary;
    }

    return left;
}

/* 덧셈/뺄셈 (+, -) */
Node *parse_additive_expr(Parser *p) {
    Node *left = parse_multiplicative_expr(p);

    while (check(p, TK_PLUS) || check(p, TK_MINUS)) {
        Token op_tok = *current_token(p);
        advance(p);
        Node *right = parse_multiplicative_expr(p);

        Node *binary = node_new(ND_BINARY, op_tok.loc);
        binary->left = left;
        binary->right = right;
        binary->op = op_tok.kind;
        left = binary;
    }

    return left;
}

/* 곱셈/나눗셈/나머지 (*, /, %) */
Node *parse_multiplicative_expr(Parser *p) {
    Node *left = parse_unary_expr(p);

    while (check(p, TK_STAR) || check(p, TK_SLASH) || check(p, TK_PERCENT)) {
        Token op_tok = *current_token(p);
        advance(p);
        Node *right = parse_unary_expr(p);

        Node *binary = node_new(ND_BINARY, op_tok.loc);
        binary->left = left;
        binary->right = right;
        binary->op = op_tok.kind;
        left = binary;
    }

    return left;
}

/* 단항 연산자 (-, !, ~, &, *, ++, --) */
Node *parse_unary_expr(Parser *p) {
    Token tok = *current_token(p);

    if (check(p, TK_MINUS) || check(p, TK_PLUS) || check(p, TK_BANG) ||
        check(p, TK_TILDE) || check(p, TK_AMPERSAND) || check(p, TK_STAR)) {
        TokenKind op = tok.kind;
        advance(p);
        Node *expr = parse_unary_expr(p);

        Node *unary = node_new(ND_UNARY, tok.loc);
        unary->left = expr;
        unary->op = op;
        unary->is_prefix = 1;
        return unary;
    }

    if (check(p, TK_INC) || check(p, TK_DEC)) {
        TokenKind op = tok.kind;
        advance(p);
        Node *expr = parse_unary_expr(p);

        Node *unary = node_new(ND_UNARY, tok.loc);
        unary->left = expr;
        unary->op = op;
        unary->is_prefix = 1;
        return unary;
    }

    if (check(p, TK_SIZEOF)) {
        advance(p);
        Node *sizeof_node = node_new(ND_SIZEOF_EXPR, tok.loc);
        sizeof_node->left = parse_unary_expr(p);
        return sizeof_node;
    }

    return parse_postfix_expr(p);
}

/* 후위 연산자 (++, --, [], ., ->, ()) */
Node *parse_postfix_expr(Parser *p) {
    Node *left = parse_primary_expr(p);

    while (1) {
        if (check(p, TK_INC) || check(p, TK_DEC)) {
            Token op_tok = *current_token(p);
            TokenKind op = op_tok.kind;
            advance(p);

            Node *unary = node_new(ND_UNARY, op_tok.loc);
            unary->left = left;
            unary->op = op;
            unary->is_prefix = 0;  /* 후위 */
            left = unary;
        }
        else if (match(p, TK_LBRACKET)) {
            Token idx_tok = *peek_token(p, -1);
            Node *index = node_new(ND_INDEX, idx_tok.loc);
            index->left = left;
            index->right = parse_expr(p);
            consume(p, TK_RBRACKET, "Expected ]");
            left = index;
        }
        else if (match(p, TK_LPAREN)) {
            Token call_tok = *peek_token(p, -1);
            Node *call = node_new(ND_CALL, call_tok.loc);
            call->left = left;

            /* 인수 파싱 */
            while (!check(p, TK_RPAREN)) {
                Node *arg = parse_assign_expr(p);
                if (arg) node_add_child(call, arg);

                if (!check(p, TK_RPAREN)) {
                    if (!consume(p, TK_COMMA, "Expected , or ) in function call")) {
                        break;
                    }
                }
            }
            consume(p, TK_RPAREN, "Expected )");
            left = call;
        }
        else if (match(p, TK_DOT)) {
            Token mem_tok = *current_token(p);
            if (!check(p, TK_IDENT)) {
                fprintf(stderr, "Expected identifier after .\n");
                return left;
            }
            Node *member = node_new(ND_MEMBER, mem_tok.loc);
            member->left = left;
            member->name = (char *)malloc(strlen(mem_tok.val.ident) + 1);
            strcpy(member->name, mem_tok.val.ident);
            advance(p);
            left = member;
        }
        else if (match(p, TK_ARROW)) {
            Token mem_tok = *current_token(p);
            if (!check(p, TK_IDENT)) {
                fprintf(stderr, "Expected identifier after ->\n");
                return left;
            }
            Node *arrow = node_new(ND_ARROW, mem_tok.loc);
            arrow->left = left;
            arrow->name = (char *)malloc(strlen(mem_tok.val.ident) + 1);
            strcpy(arrow->name, mem_tok.val.ident);
            advance(p);
            left = arrow;
        }
        else {
            break;
        }
    }

    return left;
}

/* 기본 식 (literals, identifiers, parenthesized expressions) */
Node *parse_primary_expr(Parser *p) {
    Token tok = *current_token(p);

    if (check(p, TK_INT_LIT)) {
        Node *lit = node_new(ND_INT_LIT, tok.loc);
        lit->int_val = tok.val.int_val;
        advance(p);
        return lit;
    }

    if (check(p, TK_FLOAT_LIT)) {
        Node *lit = node_new(ND_FLOAT_LIT, tok.loc);
        lit->float_val = tok.val.float_val;
        advance(p);
        return lit;
    }

    if (check(p, TK_CHAR_LIT)) {
        Node *lit = node_new(ND_CHAR_LIT, tok.loc);
        lit->char_val = tok.val.char_val;
        advance(p);
        return lit;
    }

    if (check(p, TK_STR_LIT)) {
        Node *lit = node_new(ND_STR_LIT, tok.loc);
        lit->str_val = (char *)malloc(strlen(tok.val.str_val) + 1);
        strcpy(lit->str_val, tok.val.str_val);
        advance(p);
        return lit;
    }

    if (check(p, TK_IDENT)) {
        Node *ident = node_new(ND_IDENT, tok.loc);
        ident->name = (char *)malloc(strlen(tok.val.ident) + 1);
        strcpy(ident->name, tok.val.ident);
        advance(p);
        return ident;
    }

    if (match(p, TK_LPAREN)) {
        Node *expr = parse_expr(p);
        consume(p, TK_RPAREN, "Expected )");
        return expr;
    }

    fprintf(stderr, "Unexpected token at line %d\n", tok.loc.line);
    return NULL;
}
