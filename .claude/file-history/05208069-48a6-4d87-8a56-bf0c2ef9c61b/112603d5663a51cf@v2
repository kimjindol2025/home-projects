#include "lexer.h"
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <stdio.h>
#include <math.h>

/* 키워드 테이블 */
static struct {
    const char *name;
    TokenKind kind;
} keywords[] = {
    {"auto", TK_AUTO}, {"break", TK_BREAK}, {"case", TK_CASE},
    {"char", TK_CHAR}, {"const", TK_CONST}, {"continue", TK_CONTINUE},
    {"default", TK_DEFAULT}, {"do", TK_DO}, {"double", TK_DOUBLE},
    {"else", TK_ELSE}, {"enum", TK_ENUM}, {"extern", TK_EXTERN},
    {"float", TK_FLOAT}, {"for", TK_FOR}, {"goto", TK_GOTO},
    {"if", TK_IF}, {"inline", TK_INLINE}, {"int", TK_INT},
    {"long", TK_LONG}, {"register", TK_REGISTER}, {"restrict", TK_RESTRICT},
    {"return", TK_RETURN}, {"short", TK_SHORT}, {"signed", TK_SIGNED},
    {"sizeof", TK_SIZEOF}, {"static", TK_STATIC}, {"struct", TK_STRUCT},
    {"switch", TK_SWITCH}, {"typedef", TK_TYPEDEF}, {"union", TK_UNION},
    {"unsigned", TK_UNSIGNED}, {"void", TK_VOID}, {"volatile", TK_VOLATILE},
    {"while", TK_WHILE},
    {NULL, TK_UNKNOWN},
};

/* 키워드 조회 */
static TokenKind lookup_keyword(const char *name, size_t len) {
    for (int i = 0; keywords[i].name; i++) {
        if (strlen(keywords[i].name) == len &&
            strncmp(keywords[i].name, name, len) == 0) {
            return keywords[i].kind;
        }
    }
    return TK_UNKNOWN;  /* 키워드 아님 (식별자) */
}

/* Lexer 생성 */
Lexer *lexer_new(const char *src, size_t len) {
    Lexer *l = (Lexer *)malloc(sizeof(Lexer));
    if (!l) return NULL;

    l->src = src;
    l->src_len = len;
    l->pos = 0;
    l->line = 1;
    l->col = 0;

    l->tok_cap = 1024;
    l->tokens = (Token *)malloc(sizeof(Token) * l->tok_cap);
    if (!l->tokens) {
        free(l);
        return NULL;
    }
    l->tok_count = 0;

    return l;
}

/* Lexer 해제 */
void lexer_free(Lexer *l) {
    if (!l) return;
    for (size_t i = 0; i < l->tok_count; i++) {
        if (l->tokens[i].kind == TK_IDENT && l->tokens[i].val.ident) {
            free(l->tokens[i].val.ident);
        } else if (l->tokens[i].kind == TK_STR_LIT && l->tokens[i].val.str_val) {
            free(l->tokens[i].val.str_val);
        }
    }
    free(l->tokens);
    free(l);
}

/* Token 추가 */
static void add_token(Lexer *l, Token tok) {
    if (l->tok_count >= l->tok_cap) {
        l->tok_cap *= 2;
        Token *new_tokens = (Token *)realloc(l->tokens, sizeof(Token) * l->tok_cap);
        if (!new_tokens) return;
        l->tokens = new_tokens;
    }
    l->tokens[l->tok_count++] = tok;
}

/* 현재 문자 */
static char current(Lexer *l) {
    return l->pos < l->src_len ? l->src[l->pos] : '\0';
}

/* 다음 문자 */
static char peek(Lexer *l, int offset) {
    return l->pos + offset < l->src_len ? l->src[l->pos + offset] : '\0';
}

/* 한 문자 진행 */
static char advance(Lexer *l) {
    if (l->pos >= l->src_len) return '\0';
    char c = l->src[l->pos++];
    if (c == '\n') {
        l->line++;
        l->col = 0;
    } else {
        l->col++;
    }
    return c;
}

/* 공백 스킵 */
static void skip_whitespace(Lexer *l) {
    while (isspace(current(l))) {
        advance(l);
    }
}

/* 한줄 주석 스킵 */
static void skip_line_comment(Lexer *l) {
    /* // 이미 진행됨 */
    while (current(l) != '\n' && current(l) != '\0') {
        advance(l);
    }
}

/* 블록 주석 스킵 */
static void skip_block_comment(Lexer *l) {
    /* 이미 진행됨: /를 만남 */
    while (current(l) != '\0') {
        if (current(l) == '*' && peek(l, 1) == '/') {
            advance(l);  /* * */
            advance(l);  /* / */
            break;
        }
        advance(l);
    }
}

/* 정수 리터럴 스캔 */
static Token scan_number(Lexer *l) {
    Token tok;
    tok.kind = TK_INT_LIT;
    tok.loc.start = l->pos;
    tok.loc.line = l->line;
    tok.loc.col = l->col;

    long long num = 0;
    int base = 10;

    /* 진법 결정 */
    if (current(l) == '0') {
        if (peek(l, 1) == 'x' || peek(l, 1) == 'X') {
            base = 16;
            advance(l);  /* 0 */
            advance(l);  /* x */
        } else if (peek(l, 1) == 'b' || peek(l, 1) == 'B') {
            base = 2;
            advance(l);  /* 0 */
            advance(l);  /* b */
        } else if (isdigit(peek(l, 1))) {
            base = 8;
            advance(l);  /* 0 */
        }
    }

    /* 정수 부분 */
    while (isdigit(current(l)) || (base == 16 && isxdigit(current(l))) ||
           (base == 2 && (current(l) == '0' || current(l) == '1'))) {
        char c = current(l);
        int digit = isdigit(c) ? c - '0' : (tolower(c) - 'a' + 10);
        num = num * base + digit;
        advance(l);
    }

    /* 소수점 체크 */
    if (current(l) == '.' && base == 10 && isdigit(peek(l, 1))) {
        tok.kind = TK_FLOAT_LIT;
        double fnum = num;
        double frac = 0.0;
        double divisor = 10.0;

        advance(l);  /* . */
        while (isdigit(current(l))) {
            frac += (current(l) - '0') / divisor;
            divisor *= 10.0;
            advance(l);
        }
        tok.val.float_val = fnum + frac;
    } else if (base == 10) {
        tok.val.int_val = num;
    } else {
        tok.val.int_val = num;
    }

    /* 지수 부분 (e.g., 1e10, 1.5e-3) */
    if ((current(l) == 'e' || current(l) == 'E') &&
        (isdigit(peek(l, 1)) || peek(l, 1) == '+' || peek(l, 1) == '-')) {
        tok.kind = TK_FLOAT_LIT;
        if (tok.kind == TK_INT_LIT) {
            tok.val.float_val = (double)tok.val.int_val;
        }
        advance(l);  /* e */
        int sign = 1;
        if (current(l) == '+' || current(l) == '-') {
            if (current(l) == '-') sign = -1;
            advance(l);
        }
        int exp = 0;
        while (isdigit(current(l))) {
            exp = exp * 10 + (current(l) - '0');
            advance(l);
        }
        /* 간단한 구현 (정확한 지수 계산은 생략) */
        tok.val.float_val *= pow(10.0, sign * exp);
    }

    /* 접미사 스킵 (u, f, l 등) */
    while (current(l) == 'u' || current(l) == 'U' ||
           current(l) == 'f' || current(l) == 'F' ||
           current(l) == 'l' || current(l) == 'L') {
        advance(l);
    }

    tok.loc.end = l->pos;
    return tok;
}

/* 문자 리터럴 스캔 */
static Token scan_char_literal(Lexer *l) {
    Token tok;
    tok.kind = TK_CHAR_LIT;
    tok.loc.start = l->pos;
    tok.loc.line = l->line;
    tok.loc.col = l->col;

    advance(l);  /* ' */

    char c = 0;
    if (current(l) == '\\') {
        advance(l);
        switch (current(l)) {
            case 'n': c = '\n'; break;
            case 't': c = '\t'; break;
            case 'r': c = '\r'; break;
            case '\\': c = '\\'; break;
            case '\'': c = '\''; break;
            case '"': c = '"'; break;
            case '0': c = '\0'; break;
            case 'x': {
                advance(l);
                int hex = 0;
                for (int i = 0; i < 2 && isxdigit(current(l)); i++) {
                    hex = hex * 16 + (isdigit(current(l)) ? current(l) - '0' : tolower(current(l)) - 'a' + 10);
                    advance(l);
                }
                c = (char)hex;
                tok.loc.end = l->pos;
                if (current(l) == '\'') advance(l);
                tok.val.char_val = c;
                return tok;
            }
            default: c = current(l);
        }
        advance(l);
    } else {
        c = current(l);
        advance(l);
    }

    if (current(l) == '\'') {
        advance(l);
    }

    tok.val.char_val = c;
    tok.loc.end = l->pos;
    return tok;
}

/* 문자열 리터럴 스캔 */
static Token scan_string_literal(Lexer *l) {
    Token tok;
    tok.kind = TK_STR_LIT;
    tok.loc.start = l->pos;
    tok.loc.line = l->line;
    tok.loc.col = l->col;

    advance(l);  /* " */

    size_t str_start = l->pos;
    size_t str_len = 0;

    while (current(l) != '"' && current(l) != '\0') {
        if (current(l) == '\\') {
            advance(l);
            if (current(l) != '\0') advance(l);
        } else {
            advance(l);
        }
        str_len++;
    }

    /* 문자열 복사 (이스케이프 처리 간소화) */
    char *str = (char *)malloc(str_len + 1);
    if (str) {
        strncpy(str, l->src + str_start, str_len);
        str[str_len] = '\0';
    }
    tok.val.str_val = str;

    if (current(l) == '"') {
        advance(l);
    }

    tok.loc.end = l->pos;
    return tok;
}

/* 식별자 스캔 */
static Token scan_identifier(Lexer *l) {
    Token tok;
    tok.loc.start = l->pos;
    tok.loc.line = l->line;
    tok.loc.col = l->col;

    size_t start = l->pos;
    while (isalnum(current(l)) || current(l) == '_') {
        advance(l);
    }
    size_t len = l->pos - start;

    char *ident = (char *)malloc(len + 1);
    if (ident) {
        strncpy(ident, l->src + start, len);
        ident[len] = '\0';
    }

    /* 키워드 확인 */
    TokenKind kw = lookup_keyword(ident, len);
    if (kw != TK_UNKNOWN) {
        tok.kind = kw;
        free(ident);
    } else {
        tok.kind = TK_IDENT;
        tok.val.ident = ident;
    }

    tok.loc.end = l->pos;
    return tok;
}

/* 토크나이징 메인 함수 */
int lexer_tokenize(Lexer *l) {
    while (l->pos < l->src_len) {
        skip_whitespace(l);
        if (l->pos >= l->src_len) break;

        char c = current(l);
        Token tok;
        tok.loc.line = l->line;
        tok.loc.col = l->col;
        tok.loc.start = l->pos;

        /* 숫자 */
        if (isdigit(c)) {
            tok = scan_number(l);
            add_token(l, tok);
            continue;
        }

        /* 문자/문자열 */
        if (c == '\'') {
            tok = scan_char_literal(l);
            add_token(l, tok);
            continue;
        }
        if (c == '"') {
            tok = scan_string_literal(l);
            add_token(l, tok);
            continue;
        }

        /* 식별자/키워드 */
        if (isalpha(c) || c == '_') {
            tok = scan_identifier(l);
            add_token(l, tok);
            continue;
        }

        /* 주석 */
        if (c == '/' && peek(l, 1) == '/') {
            advance(l);
            advance(l);
            skip_line_comment(l);
            continue;
        }
        if (c == '/' && peek(l, 1) == '*') {
            advance(l);
            advance(l);
            skip_block_comment(l);
            continue;
        }

        /* 연산자 & 구분자 */
        tok.loc.end = l->pos + 1;

        switch (c) {
            case '+':
                if (peek(l, 1) == '+') { tok.kind = TK_INC; advance(l); advance(l); }
                else if (peek(l, 1) == '=') { tok.kind = TK_PLUS_ASSIGN; advance(l); advance(l); }
                else { tok.kind = TK_PLUS; advance(l); }
                break;

            case '-':
                if (peek(l, 1) == '-') { tok.kind = TK_DEC; advance(l); advance(l); }
                else if (peek(l, 1) == '=') { tok.kind = TK_MINUS_ASSIGN; advance(l); advance(l); }
                else if (peek(l, 1) == '>') { tok.kind = TK_ARROW; advance(l); advance(l); }
                else { tok.kind = TK_MINUS; advance(l); }
                break;

            case '*':
                if (peek(l, 1) == '=') { tok.kind = TK_STAR_ASSIGN; advance(l); advance(l); }
                else { tok.kind = TK_STAR; advance(l); }
                break;

            case '/':
                if (peek(l, 1) == '=') { tok.kind = TK_SLASH_ASSIGN; advance(l); advance(l); }
                else { tok.kind = TK_SLASH; advance(l); }
                break;

            case '%':
                if (peek(l, 1) == '=') { tok.kind = TK_PERCENT_ASSIGN; advance(l); advance(l); }
                else { tok.kind = TK_PERCENT; advance(l); }
                break;

            case '&':
                if (peek(l, 1) == '&') { tok.kind = TK_AND; advance(l); advance(l); }
                else if (peek(l, 1) == '=') { tok.kind = TK_AMP_ASSIGN; advance(l); advance(l); }
                else { tok.kind = TK_AMPERSAND; advance(l); }
                break;

            case '|':
                if (peek(l, 1) == '|') { tok.kind = TK_OR; advance(l); advance(l); }
                else if (peek(l, 1) == '=') { tok.kind = TK_PIPE_ASSIGN; advance(l); advance(l); }
                else { tok.kind = TK_PIPE; advance(l); }
                break;

            case '^':
                if (peek(l, 1) == '=') { tok.kind = TK_CARET_ASSIGN; advance(l); advance(l); }
                else { tok.kind = TK_CARET; advance(l); }
                break;

            case '~': tok.kind = TK_TILDE; advance(l); break;
            case '!':
                if (peek(l, 1) == '=') { tok.kind = TK_NEQ; advance(l); advance(l); }
                else { tok.kind = TK_BANG; advance(l); }
                break;

            case '=':
                if (peek(l, 1) == '=') { tok.kind = TK_EQ; advance(l); advance(l); }
                else { tok.kind = TK_ASSIGN; advance(l); }
                break;

            case '<':
                if (peek(l, 1) == '<') {
                    if (peek(l, 2) == '=') { tok.kind = TK_LSHIFT_ASSIGN; advance(l); advance(l); advance(l); }
                    else { tok.kind = TK_LSHIFT; advance(l); advance(l); }
                } else if (peek(l, 1) == '=') { tok.kind = TK_LE; advance(l); advance(l); }
                else { tok.kind = TK_LT; advance(l); }
                break;

            case '>':
                if (peek(l, 1) == '>') {
                    if (peek(l, 2) == '=') { tok.kind = TK_RSHIFT_ASSIGN; advance(l); advance(l); advance(l); }
                    else { tok.kind = TK_RSHIFT; advance(l); advance(l); }
                } else if (peek(l, 1) == '=') { tok.kind = TK_GE; advance(l); advance(l); }
                else { tok.kind = TK_GT; advance(l); }
                break;

            case '.':
                if (peek(l, 1) == '.' && peek(l, 2) == '.') { tok.kind = TK_ELLIPSIS; advance(l); advance(l); advance(l); }
                else { tok.kind = TK_DOT; advance(l); }
                break;

            case '?': tok.kind = TK_QUESTION; advance(l); break;
            case ':': tok.kind = TK_COLON; advance(l); break;
            case ';': tok.kind = TK_SEMICOLON; advance(l); break;
            case ',': tok.kind = TK_COMMA; advance(l); break;
            case '(': tok.kind = TK_LPAREN; advance(l); break;
            case ')': tok.kind = TK_RPAREN; advance(l); break;
            case '{': tok.kind = TK_LBRACE; advance(l); break;
            case '}': tok.kind = TK_RBRACE; advance(l); break;
            case '[': tok.kind = TK_LBRACKET; advance(l); break;
            case ']': tok.kind = TK_RBRACKET; advance(l); break;
            case '#':
                if (peek(l, 1) == '#') { tok.kind = TK_HASH_HASH; advance(l); advance(l); }
                else { tok.kind = TK_HASH; advance(l); }
                break;

            default:
                tok.kind = TK_UNKNOWN;
                advance(l);
                break;
        }

        add_token(l, tok);
    }

    /* EOF 토큰 추가 */
    Token eof_tok;
    eof_tok.kind = TK_EOF;
    eof_tok.loc.line = l->line;
    eof_tok.loc.col = l->col;
    eof_tok.loc.start = l->pos;
    eof_tok.loc.end = l->pos;
    add_token(l, eof_tok);

    return 0;
}

/* 토큰 종류 문자열화 */
const char *token_kind_to_string(TokenKind kind) {
    switch (kind) {
        case TK_AUTO: return "auto";
        case TK_BREAK: return "break";
        case TK_CASE: return "case";
        case TK_CHAR: return "char";
        case TK_CONST: return "const";
        case TK_INT: return "int";
        case TK_FLOAT: return "float";
        case TK_DOUBLE: return "double";
        case TK_VOID: return "void";
        case TK_IF: return "if";
        case TK_ELSE: return "else";
        case TK_WHILE: return "while";
        case TK_FOR: return "for";
        case TK_RETURN: return "return";
        case TK_SIZEOF: return "sizeof";

        case TK_INT_LIT: return "INT_LIT";
        case TK_FLOAT_LIT: return "FLOAT_LIT";
        case TK_CHAR_LIT: return "CHAR_LIT";
        case TK_STR_LIT: return "STR_LIT";
        case TK_IDENT: return "IDENT";

        case TK_PLUS: return "+";
        case TK_MINUS: return "-";
        case TK_STAR: return "*";
        case TK_SLASH: return "/";
        case TK_PERCENT: return "%";
        case TK_EQ: return "==";
        case TK_NEQ: return "!=";
        case TK_LT: return "<";
        case TK_LE: return "<=";
        case TK_GT: return ">";
        case TK_GE: return ">=";
        case TK_ASSIGN: return "=";
        case TK_LPAREN: return "(";
        case TK_RPAREN: return ")";
        case TK_LBRACE: return "{";
        case TK_RBRACE: return "}";
        case TK_SEMICOLON: return ";";
        case TK_COMMA: return ",";
        case TK_EOF: return "EOF";
        default: return "UNKNOWN";
    }
}

/* 디버그 출력 */
void lexer_dump(const Lexer *l) {
    printf("=== Tokens ===\n");
    for (size_t i = 0; i < l->tok_count; i++) {
        Token tok = l->tokens[i];
        printf("[%zu] %s (line %d, col %d) ", i, token_kind_to_string(tok.kind), tok.loc.line, tok.loc.col);

        if (tok.kind == TK_INT_LIT) {
            printf("value=%lld\n", tok.val.int_val);
        } else if (tok.kind == TK_FLOAT_LIT) {
            printf("value=%f\n", tok.val.float_val);
        } else if (tok.kind == TK_IDENT) {
            printf("name=%s\n", tok.val.ident);
        } else if (tok.kind == TK_STR_LIT) {
            printf("value=\"%s\"\n", tok.val.str_val);
        } else {
            printf("\n");
        }
    }
}
