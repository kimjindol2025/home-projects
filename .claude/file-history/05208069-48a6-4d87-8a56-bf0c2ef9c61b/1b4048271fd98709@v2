#include "ir.h"
#include <stdlib.h>
#include <stdio.h>
#include <string.h>

/* Module creation */
CirModule *cir_module_new(void) {
    CirModule *m = (CirModule *)malloc(sizeof(CirModule));
    if (!m) return NULL;

    m->insts = (CirInst *)malloc(sizeof(CirInst) * 1024);
    if (!m->insts) {
        free(m);
        return NULL;
    }
    m->inst_count = 0;
    m->inst_cap = 1024;

    m->strings = (char **)malloc(sizeof(char *) * 256);
    if (!m->strings) {
        free(m->insts);
        free(m);
        return NULL;
    }
    m->str_count = 0;
    m->str_cap = 256;

    m->next_label = 0;
    return m;
}

/* Module deallocation */
void cir_module_free(CirModule *m) {
    if (!m) return;
    if (m->insts) {
        for (uint32_t i = 0; i < m->inst_count; i++) {
            if (m->insts[i].op == CIR_CALL && m->insts[i].u.call.args) {
                free(m->insts[i].u.call.args);
            }
        }
        free(m->insts);
    }
    for (uint32_t i = 0; i < m->str_count; i++) {
        if (m->strings[i]) free(m->strings[i]);
    }
    if (m->strings) free(m->strings);
    free(m);
}

/* String table intern */
uint32_t cir_intern_str(CirModule *m, const char *name) {
    if (!m || !name) return 0;
    for (uint32_t i = 0; i < m->str_count; i++) {
        if (m->strings[i] && strcmp(m->strings[i], name) == 0) {
            return i;
        }
    }
    if (m->str_count >= m->str_cap) {
        m->str_cap *= 2;
        char **new_strings = (char **)realloc(m->strings, sizeof(char *) * m->str_cap);
        if (!new_strings) return 0;
        m->strings = new_strings;
    }
    m->strings[m->str_count] = (char *)malloc(strlen(name) + 1);
    if (!m->strings[m->str_count]) return 0;
    strcpy(m->strings[m->str_count], name);
    return m->str_count++;
}

/* Emit instruction */
CirRef cir_emit(CirModule *m, CirInst inst) {
    if (!m) return CIR_REF_NULL;
    if (m->inst_count >= m->inst_cap) {
        m->inst_cap *= 2;
        CirInst *new_insts = (CirInst *)realloc(m->insts, sizeof(CirInst) * m->inst_cap);
        if (!new_insts) return CIR_REF_NULL;
        m->insts = new_insts;
    }
    m->insts[m->inst_count] = inst;
    return m->inst_count++;
}

/* Allocate new label */
uint32_t cir_new_label(CirModule *m) {
    if (!m) return 0;
    return m->next_label++;
}

/* AstGen creation */
AstGen *astgen_new(CirModule *m) {
    AstGen *g = (AstGen *)malloc(sizeof(AstGen));
    if (!g) return NULL;
    g->module = m;
    g->var_names = (char **)malloc(sizeof(char *) * 256);
    if (!g->var_names) {
        free(g);
        return NULL;
    }
    g->var_ids = (uint32_t *)malloc(sizeof(uint32_t) * 256);
    if (!g->var_ids) {
        free(g->var_names);
        free(g);
        return NULL;
    }
    g->var_count = 0;
    g->var_cap = 256;
    g->break_label = 0;
    g->continue_label = 0;
    return g;
}

/* AstGen cleanup */
void astgen_free(AstGen *g) {
    if (!g) return;
    if (g->var_names) free(g->var_names);
    if (g->var_ids) free(g->var_ids);
    free(g);
}

/* Helper: lookup variable */
static uint32_t astgen_lookup_var(AstGen *g, const char *name) {
    for (int i = 0; i < g->var_count; i++) {
        if (strcmp(g->var_names[i], name) == 0) {
            return g->var_ids[i];
        }
    }
    return cir_intern_str(g->module, name);
}

/* Expression generation */
CirRef astgen_expr(AstGen *g, Node *expr) {
    if (!expr) return CIR_REF_NULL;

    switch (expr->kind) {
        case ND_INT_LIT: {
            CirInst inst = {.op = CIR_LOAD_INT, .u.load_int.imm = expr->int_val};
            return cir_emit(g->module, inst);
        }
        case ND_FLOAT_LIT: {
            CirInst inst = {.op = CIR_LOAD_FLOAT, .u.load_float.imm = expr->float_val};
            return cir_emit(g->module, inst);
        }
        case ND_CHAR_LIT: {
            CirInst inst = {.op = CIR_LOAD_INT, .u.load_int.imm = expr->char_val};
            return cir_emit(g->module, inst);
        }
        case ND_STR_LIT: {
            uint32_t str_idx = cir_intern_str(g->module, expr->str_val);
            CirInst inst = {.op = CIR_LOAD_STR, .u.load_str.str_idx = str_idx};
            return cir_emit(g->module, inst);
        }
        case ND_IDENT: {
            uint32_t name_idx = astgen_lookup_var(g, expr->name);
            CirInst inst = {.op = CIR_LOAD_VAR, .u.load_var.name_idx = name_idx};
            return cir_emit(g->module, inst);
        }
        case ND_BINARY: {
            CirRef lhs = astgen_expr(g, expr->left);
            CirRef rhs = astgen_expr(g, expr->right);
            int op_val = 0;
            switch (expr->op) {
                case TK_PLUS: op_val = 0; break;
                case TK_MINUS: op_val = 1; break;
                case TK_STAR: op_val = 2; break;
                case TK_SLASH: op_val = 3; break;
                case TK_PERCENT: op_val = 4; break;
                case TK_LE: op_val = 6; break;
                case TK_GT: op_val = 7; break;
                case TK_GE: op_val = 8; break;
                case TK_EQ: op_val = 12; break;
                case TK_NEQ: op_val = 13; break;
                case TK_LT: op_val = 14; break;
                case TK_AMPERSAND: op_val = 9; break;
                case TK_PIPE: op_val = 10; break;
                case TK_CARET: op_val = 11; break;
                case TK_LSHIFT: op_val = 15; break;
                case TK_RSHIFT: op_val = 16; break;
                case TK_AND: op_val = 18; break;
                case TK_OR: op_val = 19; break;
                default: op_val = 0;
            }
            CirInst inst = {.op = CIR_BINARY, .u.binary = {.op = op_val, .lhs = lhs, .rhs = rhs}};
            return cir_emit(g->module, inst);
        }
        case ND_ASSIGN: {
            CirRef rhs = astgen_expr(g, expr->right);
            if (expr->left->kind == ND_IDENT) {
                uint32_t name_idx = astgen_lookup_var(g, expr->left->name);
                CirInst inst = {.op = CIR_STORE_VAR, .u.store_var = {.name_idx = name_idx, .value = rhs}};
                return cir_emit(g->module, inst);
            }
            return rhs;
        }
        case ND_CALL: {
            CirRef callee = astgen_expr(g, expr->left);
            int arg_count = expr->child_count;
            CirRef *args = NULL;
            if (arg_count > 0) {
                args = (CirRef *)malloc(sizeof(CirRef) * arg_count);
                for (int i = 0; i < arg_count; i++) {
                    args[i] = astgen_expr(g, expr->children[i]);
                }
            }
            CirInst inst = {.op = CIR_CALL, .u.call = {.callee = callee, .args = args, .arg_count = arg_count}};
            return cir_emit(g->module, inst);
        }
        case ND_UNARY: {
            CirRef operand = astgen_expr(g, expr->left);
            int op_val = 0;
            switch (expr->op) {
                case TK_MINUS: op_val = 0; break; /* NEG */
                case TK_BANG: op_val = 1; break;  /* NOT */
                case TK_TILDE: op_val = 2; break; /* BITNOT */
                default: op_val = 0;
            }
            CirInst inst = {.op = CIR_UNARY, .u.unary = {.op = op_val, .operand = operand}};
            return cir_emit(g->module, inst);
        }
        case ND_INDEX: {
            CirRef array = astgen_expr(g, expr->left);
            CirRef idx = astgen_expr(g, expr->right);
            CirInst inst = {.op = CIR_INDEX, .u.index = {.array = array, .idx = idx}};
            return cir_emit(g->module, inst);
        }
        case ND_MEMBER: {
            CirRef object = astgen_expr(g, expr->left);
            CirInst inst = {.op = CIR_MEMBER, .u.member = {.object = object, .field_idx = expr->member_idx}};
            return cir_emit(g->module, inst);
        }
        case ND_ARROW: {
            CirRef ptr = astgen_expr(g, expr->left);
            CirRef deref_inst = cir_emit(g->module, (CirInst){.op = CIR_DEREF, .u.deref.operand = ptr});
            CirInst member_inst = {.op = CIR_MEMBER, .u.member = {.object = deref_inst, .field_idx = expr->member_idx}};
            return cir_emit(g->module, member_inst);
        }
        default:
            return CIR_REF_NULL;
    }
}

/* Statement generation */
void astgen_stmt(AstGen *g, Node *stmt) {
    if (!stmt) return;

    switch (stmt->kind) {
        case ND_EXPR_STMT:
            astgen_expr(g, stmt->left);
            break;
        case ND_RETURN: {
            CirRef value = CIR_REF_NULL;
            if (stmt->left) value = astgen_expr(g, stmt->left);
            CirInst ret = {.op = CIR_RETURN, .u.ret.value = value};
            cir_emit(g->module, ret);
            break;
        }
        case ND_BLOCK:
            for (int i = 0; i < stmt->child_count; i++) {
                astgen_stmt(g, stmt->children[i]);
            }
            break;
        case ND_VAR_DECL: {
            uint32_t name_idx = cir_intern_str(g->module, stmt->name);
            if (g->var_count >= g->var_cap) {
                g->var_cap *= 2;
                char **new_names = (char **)realloc(g->var_names, sizeof(char *) * g->var_cap);
                uint32_t *new_ids = (uint32_t *)realloc(g->var_ids, sizeof(uint32_t) * g->var_cap);
                if (new_names) g->var_names = new_names;
                if (new_ids) g->var_ids = new_ids;
            }
            g->var_names[g->var_count] = stmt->name;
            g->var_ids[g->var_count] = name_idx;
            g->var_count++;
            if (stmt->left) {
                CirRef value = astgen_expr(g, stmt->left);
                CirInst inst = {.op = CIR_STORE_VAR, .u.store_var = {.name_idx = name_idx, .value = value}};
                cir_emit(g->module, inst);
            }
            break;
        }
        case ND_IF: {
            CirRef cond_ref = astgen_expr(g, stmt->cond);
            uint32_t t_label = cir_new_label(g->module);
            uint32_t f_label = cir_new_label(g->module);
            uint32_t end_label = cir_new_label(g->module);
            CirInst jmp_if = {.op = CIR_JMP_IF, .u.jmp_if = {.cond = cond_ref, .t_label = t_label, .f_label = f_label}};
            cir_emit(g->module, jmp_if);
            CirInst label_t = {.op = CIR_LABEL, .u.label.label_id = t_label};
            cir_emit(g->module, label_t);
            if (stmt->then_body) astgen_stmt(g, stmt->then_body);
            CirInst jmp_end = {.op = CIR_JMP, .u.jmp.target = end_label};
            cir_emit(g->module, jmp_end);
            CirInst label_f = {.op = CIR_LABEL, .u.label.label_id = f_label};
            cir_emit(g->module, label_f);
            if (stmt->else_body) {
                astgen_stmt(g, stmt->else_body);
                jmp_end = (CirInst){.op = CIR_JMP, .u.jmp.target = end_label};
                cir_emit(g->module, jmp_end);
            }
            CirInst label_end = {.op = CIR_LABEL, .u.label.label_id = end_label};
            cir_emit(g->module, label_end);
            break;
        }
        case ND_WHILE: {
            uint32_t cond_label = cir_new_label(g->module);
            uint32_t body_label = cir_new_label(g->module);
            uint32_t end_label = cir_new_label(g->module);
            uint32_t old_break = g->break_label;
            uint32_t old_continue = g->continue_label;
            g->break_label = end_label;
            g->continue_label = cond_label;
            CirInst label_cond = {.op = CIR_LABEL, .u.label.label_id = cond_label};
            cir_emit(g->module, label_cond);
            CirRef cond_ref = astgen_expr(g, stmt->cond);
            CirInst jmp_if = {.op = CIR_JMP_IF, .u.jmp_if = {.cond = cond_ref, .t_label = body_label, .f_label = end_label}};
            cir_emit(g->module, jmp_if);
            CirInst label_body = {.op = CIR_LABEL, .u.label.label_id = body_label};
            cir_emit(g->module, label_body);
            if (stmt->body) astgen_stmt(g, stmt->body);
            CirInst jmp_cond = {.op = CIR_JMP, .u.jmp.target = cond_label};
            cir_emit(g->module, jmp_cond);
            CirInst label_end = {.op = CIR_LABEL, .u.label.label_id = end_label};
            cir_emit(g->module, label_end);
            g->break_label = old_break;
            g->continue_label = old_continue;
            break;
        }
        case ND_FOR: {
            if (stmt->init) astgen_stmt(g, stmt->init);
            uint32_t cond_label = cir_new_label(g->module);
            uint32_t body_label = cir_new_label(g->module);
            uint32_t end_label = cir_new_label(g->module);
            uint32_t old_break = g->break_label;
            uint32_t old_continue = g->continue_label;
            g->break_label = end_label;
            g->continue_label = cond_label;
            CirInst label_cond = {.op = CIR_LABEL, .u.label.label_id = cond_label};
            cir_emit(g->module, label_cond);
            if (stmt->cond) {
                CirRef cond_ref = astgen_expr(g, stmt->cond);
                CirInst jmp_if = {.op = CIR_JMP_IF, .u.jmp_if = {.cond = cond_ref, .t_label = body_label, .f_label = end_label}};
                cir_emit(g->module, jmp_if);
            } else {
                CirInst jmp = {.op = CIR_JMP, .u.jmp.target = body_label};
                cir_emit(g->module, jmp);
            }
            CirInst label_body = {.op = CIR_LABEL, .u.label.label_id = body_label};
            cir_emit(g->module, label_body);
            if (stmt->body) astgen_stmt(g, stmt->body);
            if (stmt->step) astgen_expr(g, stmt->step);
            CirInst jmp_cond = {.op = CIR_JMP, .u.jmp.target = cond_label};
            cir_emit(g->module, jmp_cond);
            CirInst label_end = {.op = CIR_LABEL, .u.label.label_id = end_label};
            cir_emit(g->module, label_end);
            g->break_label = old_break;
            g->continue_label = old_continue;
            break;
        }
        case ND_BREAK: {
            CirInst jmp = {.op = CIR_JMP, .u.jmp.target = g->break_label};
            cir_emit(g->module, jmp);
            break;
        }
        case ND_CONTINUE: {
            CirInst jmp = {.op = CIR_JMP, .u.jmp.target = g->continue_label};
            cir_emit(g->module, jmp);
            break;
        }
        default:
            break;
    }
}

/* Function generation */
void astgen_func(AstGen *g, Node *func_def) {
    if (!func_def || func_def->kind != ND_FUNC_DEF) return;
    uint32_t name_idx = cir_intern_str(g->module, func_def->name);
    int param_count = func_def->child_count;
    CirInst func_begin = {.op = CIR_FUNC_BEGIN, .u.func_begin = {.name_idx = name_idx, .param_count = param_count}};
    cir_emit(g->module, func_begin);
    if (func_def->body) astgen_stmt(g, func_def->body);
    CirInst func_end = {.op = CIR_FUNC_END};
    cir_emit(g->module, func_end);
}

/* Program generation */
void astgen_program(AstGen *g, Node *program) {
    if (!program || program->kind != ND_PROGRAM) return;
    for (int i = 0; i < program->child_count; i++) {
        Node *decl = program->children[i];
        if (decl->kind == ND_FUNC_DEF) {
            astgen_func(g, decl);
        }
    }
}

/* Debug output */
static const char *cir_opcode_to_string(CirOpcode op) {
    switch (op) {
        case CIR_LOAD_INT: return "LOAD_INT";
        case CIR_LOAD_FLOAT: return "LOAD_FLOAT";
        case CIR_LOAD_STR: return "LOAD_STR";
        case CIR_LOAD_VAR: return "LOAD_VAR";
        case CIR_STORE_VAR: return "STORE_VAR";
        case CIR_ADDR_OF: return "ADDR_OF";
        case CIR_DEREF: return "DEREF";
        case CIR_INDEX: return "INDEX";
        case CIR_MEMBER: return "MEMBER";
        case CIR_BINARY: return "BINARY";
        case CIR_UNARY: return "UNARY";
        case CIR_LABEL: return "LABEL";
        case CIR_JMP: return "JMP";
        case CIR_JMP_IF: return "JMP_IF";
        case CIR_RETURN: return "RETURN";
        case CIR_FUNC_BEGIN: return "FUNC_BEGIN";
        case CIR_FUNC_END: return "FUNC_END";
        case CIR_CALL: return "CALL";
        case CIR_ARG: return "ARG";
        case CIR_NOP: return "NOP";
        default: return "UNKNOWN";
    }
}

void cir_module_dump(CirModule *m) {
    if (!m) return;
    printf("=== CIR Module ===\n");
    printf("Instructions: %u, Strings: %u\n", m->inst_count, m->str_count);
    printf("\nInstructions:\n");
    for (uint32_t i = 0; i < m->inst_count; i++) {
        printf("  [%u] %s\n", i, cir_opcode_to_string(m->insts[i].op));
    }
}
