## CIR → 어셈블리 변환 규칙

### 함수 프롤로그/에필로그

```asm
# FUNC_BEGIN (name_idx: "add")
    .globl add
    .type add, @function
add:
    pushq   %rbp
    movq    %rsp, %rbp
    subq    $N, %rsp          # N = 16바이트 정렬된 스택 크기

# FUNC_END
    movq    %rbp, %rsp
    popq    %rbp
    ret
```

### 리터럴 로드

```asm
# CIR_LOAD_INT imm → 슬롯[ref]
    movq    $42, -8(%rbp)

# CIR_LOAD_VAR name_idx → 슬롯[ref]
    movq    -16(%rbp), %rax    # 변수 오프셋에서 로드
    movq    %rax, -24(%rbp)    # ref 슬롯에 저장

# CIR_LOAD_STR str_idx → 슬롯[ref] (포인터)
    leaq    .LC0(%rip), %rax   # .rodata 레이블 주소
    movq    %rax, -8(%rbp)
```

### 변수 저장

```asm
# CIR_STORE_VAR name_idx, value_ref
    movq    슬롯[value_ref](%rbp), %rax
    movq    %rax, 변수_오프셋(%rbp)
```

### 이항 연산

```asm
# CIR_BINARY(ADD, lhs, rhs)
    movq    슬롯[lhs](%rbp), %rax
    movq    슬롯[rhs](%rbp), %rbx
    addq    %rbx, %rax
    movq    %rax, 슬롯[result](%rbp)

# CIR_BINARY(MUL)
    imulq   %rbx, %rax

# CIR_BINARY(DIV)
    cqo
    idivq   %rbx              # 몫 → rax

# CIR_BINARY(EQ)
    cmpq    %rbx, %rax
    sete    %al
    movzbq  %al, %rax         # zero-extend 1/0

# CIR_BINARY(LT)
    cmpq    %rbx, %rax
    setl    %al
    movzbq  %al, %rax
```

### 단항 연산

```asm
# CIR_UNARY(NEG)
    movq    슬롯[operand](%rbp), %rax
    negq    %rax

# CIR_UNARY(NOT)
    cmpq    $0, %rax
    sete    %al
    movzbq  %al, %rax

# CIR_UNARY(BITNOT)
    notq    %rax
```

### 제어흐름

```asm
# CIR_LABEL(id)
.L{id}:

# CIR_JMP(target)
    jmp     .L{target}

# CIR_JMP_IF(cond_ref, t_label, f_label)
    movq    슬롯[cond](%rbp), %rax
    cmpq    $0, %rax
    jne     .L{t_label}
    jmp     .L{f_label}
```

### 함수 호출

```asm
# CIR_CALL(callee_ref, args...)
# 인수 → rdi, rsi, rdx, rcx, r8, r9 순으로 전달
    movq    슬롯[arg0](%rbp), %rdi
    movq    슬롯[arg1](%rbp), %rsi
    ...
    call    *슬롯[callee](%rbp)    # 또는 call 함수명
    movq    %rax, 슬롯[result](%rbp)

# CIR_RETURN(value_ref)
    movq    슬롯[value](%rbp), %rax
    movq    %rbp, %rsp
    popq    %rbp
    ret
```

### 문자열 데이터 섹션

```asm
# .rodata에 문자열 리터럴 출력
    .section .rodata
.LC0:
    .string "hello"
.LC1:
    .string "world"
```

