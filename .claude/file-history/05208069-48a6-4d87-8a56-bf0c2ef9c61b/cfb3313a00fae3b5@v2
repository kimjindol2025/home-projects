#ifndef LEXER_H
#define LEXER_H

#include <stdint.h>
#include <stddef.h>

/* Token 종류 */
typedef enum {
    /* 키워드 (32개) */
    TK_AUTO, TK_BREAK, TK_CASE, TK_CHAR, TK_CONST,
    TK_CONTINUE, TK_DEFAULT, TK_DO, TK_DOUBLE, TK_ELSE,
    TK_ENUM, TK_EXTERN, TK_FLOAT, TK_FOR, TK_GOTO,
    TK_IF, TK_INLINE, TK_INT, TK_LONG, TK_REGISTER,
    TK_RESTRICT, TK_RETURN, TK_SHORT, TK_SIGNED, TK_SIZEOF,
    TK_STATIC, TK_STRUCT, TK_SWITCH, TK_TYPEDEF, TK_UNION,
    TK_UNSIGNED, TK_VOID, TK_VOLATILE, TK_WHILE,

    /* 리터럴 */
    TK_INT_LIT,     /* 42, 0xFF, 0777 */
    TK_FLOAT_LIT,   /* 3.14f, 2.0 */
    TK_CHAR_LIT,    /* 'a' */
    TK_STR_LIT,     /* "hello" */

    /* 식별자 */
    TK_IDENT,

    /* 연산자 & 구분자 */
    TK_PLUS,        /* + */
    TK_MINUS,       /* - */
    TK_STAR,        /* * */
    TK_SLASH,       /* / */
    TK_PERCENT,     /* % */

    TK_AMPERSAND,   /* & */
    TK_PIPE,        /* | */
    TK_CARET,       /* ^ */
    TK_TILDE,       /* ~ */
    TK_BANG,        /* ! */

    TK_EQ,          /* == */
    TK_NEQ,         /* != */
    TK_LT,          /* < */
    TK_LE,          /* <= */
    TK_GT,          /* > */
    TK_GE,          /* >= */

    TK_ASSIGN,      /* = */
    TK_PLUS_ASSIGN, /* += */
    TK_MINUS_ASSIGN, /* -= */
    TK_STAR_ASSIGN, /* *= */
    TK_SLASH_ASSIGN, /* /= */
    TK_PERCENT_ASSIGN, /* %= */
    TK_AMP_ASSIGN,  /* &= */
    TK_PIPE_ASSIGN, /* |= */
    TK_CARET_ASSIGN, /* ^= */

    TK_LSHIFT,      /* << */
    TK_RSHIFT,      /* >> */
    TK_LSHIFT_ASSIGN, /* <<= */
    TK_RSHIFT_ASSIGN, /* >>= */

    TK_AND,         /* && */
    TK_OR,          /* || */
    TK_INC,         /* ++ */
    TK_DEC,         /* -- */

    TK_ARROW,       /* -> */
    TK_DOT,         /* . */

    TK_QUESTION,    /* ? */
    TK_COLON,       /* : */
    TK_SEMICOLON,   /* ; */
    TK_COMMA,       /* , */
    TK_ELLIPSIS,    /* ... */

    TK_LPAREN,      /* ( */
    TK_RPAREN,      /* ) */
    TK_LBRACE,      /* { */
    TK_RBRACE,      /* } */
    TK_LBRACKET,    /* [ */
    TK_RBRACKET,    /* ] */

    TK_HASH,        /* # (전처리기) */
    TK_HASH_HASH,   /* ## */

    /* 특수 */
    TK_EOF,
    TK_UNKNOWN,
} TokenKind;

/* 소스 위치 */
typedef struct {
    int line;       /* 1-based */
    int col;        /* 0-based */
    size_t start;   /* 소스의 바이트 위치 */
    size_t end;
} SourceLoc;

/* Token 구조체 */
typedef struct {
    TokenKind kind;
    SourceLoc loc;

    /* 값 (토큰 종류에 따라 사용) */
    union {
        long long   int_val;
        double      float_val;
        char        char_val;
        char       *str_val;      /* 힙 할당 */
        char       *ident;        /* 힙 할당 */
    } val;
} Token;

/* Lexer 상태 */
typedef struct {
    const char *src;
    size_t      src_len;
    size_t      pos;        /* 현재 위치 */
    int         line;       /* 현재 줄 */
    int         col;        /* 현재 열 */

    Token      *tokens;     /* 동적 배열 */
    size_t      tok_count;
    size_t      tok_cap;
} Lexer;

/* Lexer 함수 */
Lexer *lexer_new(const char *src, size_t len);
void   lexer_free(Lexer *l);
int    lexer_tokenize(Lexer *l);           /* 0=OK, -1=Error */
void   lexer_dump(const Lexer *l);         /* 디버그 출력 */

/* 헬퍼 함수 */
const char *token_kind_to_string(TokenKind kind);

#endif /* LEXER_H */
