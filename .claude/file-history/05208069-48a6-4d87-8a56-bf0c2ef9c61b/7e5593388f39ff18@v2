/* 헬퍼 함수 */
static Node *parse_string(const char *code) {
    Lexer *lexer = lexer_new(code, strlen(code));
    if (!lexer) return NULL;

    lexer_tokenize(lexer);

    Parser *parser = parser_new(lexer);
    if (!parser) {
        lexer_free(lexer);
        return NULL;
    }

    Node *ast = parse_program(parser);
    parser_free(parser);
    lexer_free(lexer);
    return ast;
}

static int node_is_kind(Node *node, NodeKind kind) {
    return node != NULL && node->kind == kind;
}

static int node_is_int_lit(Node *node, long long val) {
    return node != NULL && node->kind == ND_INT_LIT && node->int_val == val;
}

