/* Test: string intern */
TEST(test_ir_intern_str) {
    CirModule *m = cir_module_new();
    ASSERT(m != NULL);
    uint32_t idx1 = cir_intern_str(m, "test");
    uint32_t idx2 = cir_intern_str(m, "test");
    ASSERT(idx1 == idx2);  /* Same string returns same index */
    uint32_t idx3 = cir_intern_str(m, "other");
    ASSERT(idx3 != idx1);  /* Different string, different index */
    cir_module_free(m);
}

/* Test: label generation */
TEST(test_ir_label_gen) {
    CirModule *m = cir_module_new();
    ASSERT(m != NULL);
    uint32_t l1 = cir_new_label(m);
    uint32_t l2 = cir_new_label(m);
    ASSERT(l1 != l2);  /* Labels should be unique */
    cir_module_free(m);
}

/* Test: emit instruction */
TEST(test_ir_emit) {
    CirModule *m = cir_module_new();
    ASSERT(m != NULL);
    CirInst inst = {.op = CIR_LOAD_INT, .u.load_int.imm = 42};
    CirRef ref = cir_emit(m, inst);
    ASSERT(ref == 0);  /* First instruction gets index 0 */
    ASSERT(m->inst_count == 1);
    cir_module_free(m);
}

/* Test: AstGen lifecycle */
TEST(test_ir_astgen_lifecycle) {
