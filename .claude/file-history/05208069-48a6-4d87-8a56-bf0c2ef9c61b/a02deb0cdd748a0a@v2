/* Helper: parse code string to AST, then generate CIR */
static CirModule *ir_from_string(const char *code) {
    Lexer *lexer = lexer_new(code, strlen(code));
    if (!lexer) return NULL;
    lexer_tokenize(lexer);

    Parser *parser = parser_new(lexer);
    if (!parser) {
        lexer_free(lexer);
        return NULL;
    }

    Node *ast = parse_program(parser);
    parser_free(parser);
    lexer_free(lexer);

    if (!ast) return NULL;

    CirModule *module = cir_module_new();
    if (!module) {
        node_free_recursive(ast);
        return NULL;
    }

    AstGen *gen = astgen_new(module);
    if (!gen) {
        cir_module_free(module);
        node_free_recursive(ast);
        return NULL;
    }

    astgen_program(gen, ast);
    astgen_free(gen);
    node_free_recursive(ast);

    return module;
}

/* Test: load int literal */
TEST(test_ir_load_int) {
    CirModule *m = ir_from_string("void f() { 42; }");
    ASSERT(m != NULL);
    ASSERT(m->inst_count > 0);
    ASSERT(m->insts[0].op == CIR_FUNC_BEGIN);
    cir_module_free(m);
}

