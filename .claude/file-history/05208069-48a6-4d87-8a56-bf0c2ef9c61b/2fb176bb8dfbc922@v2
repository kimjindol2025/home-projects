#ifndef CODEGEN_H
#define CODEGEN_H

#include <stdio.h>
#include "ir.h"

/* Codegen (Code Generation) state */
typedef struct {
    FILE       *out;           /* 어셈블리 출력 파일 */
    CirModule  *module;        /* 입력 CIR 모듈 */

    /* CirRef → rbp 오프셋 맵 */
    int        *ref_offsets;   /* CirRef → 스택 오프셋 (음수, -8부터) */
    int         ref_count;     /* 할당된 ref 슬롯 수 */

    /* 변수명 → 스택 오프셋 맵 */
    uint32_t   *var_name_idx;  /* 변수 name_idx 배열 */
    int        *var_offsets;   /* 각 변수의 rbp 오프셋 */
    int         var_count;
    int         var_cap;

    /* 함수 범위 */
    uint32_t    func_start;    /* CIR_FUNC_BEGIN 인덱스 */
    uint32_t    func_end;      /* CIR_FUNC_END 인덱스 */
    int         stack_size;    /* 현재 함수 스택 크기 (16바이트 정렬) */
} Codegen;

/* 초기화/해제 */
Codegen  *codegen_new(CirModule *m, FILE *out);
void      codegen_free(Codegen *cg);

/* 생성 진입점 */
void      codegen_emit(Codegen *cg);    /* 전체 프로그램 어셈블리 생성 */

#endif /* CODEGEN_H */
