}

/* Test: symbol table */
TEST(test_sema_symtable_define_lookup) {
    SymTable *t = symtable_new();
    ASSERT(t != NULL);
    SemaType *int_type = sema_type_basic(SEMA_TYPE_INT);
    Symbol *sym = symtable_define(t, "x", SYM_VAR, int_type);
    ASSERT(sym != NULL);
    Symbol *found = symtable_lookup(t, "x");
    ASSERT(found != NULL);
    ASSERT(strcmp(found->name, "x") == 0);
    symtable_free(t);
}

TEST(test_sema_symtable_not_found) {
    SymTable *t = symtable_new();
    ASSERT(t != NULL);
    Symbol *found = symtable_lookup(t, "undefined");
    ASSERT(found == NULL);
    symtable_free(t);
}

TEST(test_sema_symtable_duplicate) {
    SymTable *t = symtable_new();
    ASSERT(t != NULL);
    SemaType *int_type = sema_type_basic(SEMA_TYPE_INT);
    Symbol *sym1 = symtable_define(t, "x", SYM_VAR, int_type);
    ASSERT(sym1 != NULL);
    Symbol *sym2 = symtable_define(t, "x", SYM_VAR, int_type);
    ASSERT(sym2 == NULL);  /* 중복 → NULL */
    symtable_free(t);
}

TEST(test_sema_symtable_scope) {
    SymTable *t = symtable_new();
    ASSERT(t != NULL);
    SemaType *int_type = sema_type_basic(SEMA_TYPE_INT);
    Symbol *sym1 = symtable_define(t, "x", SYM_VAR, int_type);
    ASSERT(sym1 != NULL);
    symtable_enter_scope(t);
    Symbol *found_in_inner = symtable_lookup(t, "x");
    ASSERT(found_in_inner != NULL);  /* 상위 스코프에서 찾음 */
    symtable_exit_scope(t);
    symtable_free(t);
}

