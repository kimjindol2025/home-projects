/* Helper: create program from C code string */
Node *program_from_string(const char *code) {
    Lexer *lex = lexer_new(code, strlen(code));
    if (!lex) return NULL;
    if (lexer_tokenize(lex) != 0) { lexer_free(lex); return NULL; }
    Parser *p = parser_new(lex);
    if (!p) { lexer_free(lex); return NULL; }
    Node *program = parse_program(p);
    parser_free(p);
    lexer_free(lex);
    return program;
}

/* Test: basic type creation */
TEST(test_sema_type_basic_int) {
    SemaType *t = sema_type_basic(SEMA_TYPE_INT);
    ASSERT(t != NULL);
    ASSERT(t->kind == SEMA_TYPE_INT);
    sema_type_free(t);
}

