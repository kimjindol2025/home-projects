TEST(test_sema_types_compatible_int_char) {
    SemaType *t1 = sema_type_basic(SEMA_TYPE_INT);
    SemaType *t2 = sema_type_basic(SEMA_TYPE_CHAR);
    ASSERT(sema_types_compatible(t1, t2) == 1);
    sema_type_free(t1);
