#include <stdlib.h>
#include <string.h>
#include <stdio.h>
#include "codegen.h"
#include "ir.h"

/* Helper: opcode to string */
static const char *cir_opcode_to_string(CirOpcode op) {
    switch (op) {
        case CIR_LOAD_INT: return "CIR_LOAD_INT";
        case CIR_LOAD_FLOAT: return "CIR_LOAD_FLOAT";
        case CIR_LOAD_STR: return "CIR_LOAD_STR";
        case CIR_LOAD_VAR: return "CIR_LOAD_VAR";
        case CIR_STORE_VAR: return "CIR_STORE_VAR";
        case CIR_ADDR_OF: return "CIR_ADDR_OF";
        case CIR_DEREF: return "CIR_DEREF";
        case CIR_INDEX: return "CIR_INDEX";
        case CIR_MEMBER: return "CIR_MEMBER";
        case CIR_BINARY: return "CIR_BINARY";
        case CIR_UNARY: return "CIR_UNARY";
        case CIR_CAST: return "CIR_CAST";
        case CIR_LABEL: return "CIR_LABEL";
        case CIR_JMP: return "CIR_JMP";
        case CIR_JMP_IF: return "CIR_JMP_IF";
        case CIR_RETURN: return "CIR_RETURN";
        case CIR_FUNC_BEGIN: return "CIR_FUNC_BEGIN";
        case CIR_FUNC_END: return "CIR_FUNC_END";
        case CIR_CALL: return "CIR_CALL";
        case CIR_ARG: return "CIR_ARG";
        case CIR_SIZEOF: return "CIR_SIZEOF";
        case CIR_PHI: return "CIR_PHI";
        case CIR_NOP: return "CIR_NOP";
        default: return "UNKNOWN";
    }
}

/* Initialization */
Codegen *codegen_new(CirModule *m, FILE *out) {
    if (!m || !out) return NULL;
    Codegen *cg = (Codegen *)malloc(sizeof(Codegen));
    if (!cg) return NULL;
    cg->out = out;
    cg->module = m;
    cg->ref_offsets = (int *)malloc(sizeof(int) * m->inst_count);
    if (!cg->ref_offsets) { free(cg); return NULL; }
    cg->ref_count = 0;
    cg->var_name_idx = (uint32_t *)malloc(sizeof(uint32_t) * 256);
    cg->var_offsets = (int *)malloc(sizeof(int) * 256);
    if (!cg->var_name_idx || !cg->var_offsets) {
        free(cg->ref_offsets);
        free(cg->var_name_idx);
        free(cg->var_offsets);
        free(cg);
        return NULL;
    }
    cg->var_count = 0;
    cg->var_cap = 256;
    cg->func_start = 0;
    cg->func_end = 0;
    cg->stack_size = 0;
    return cg;
}

void codegen_free(Codegen *cg) {
    if (!cg) return;
    free(cg->ref_offsets);
    free(cg->var_name_idx);
    free(cg->var_offsets);
    free(cg);
}

/* Offset allocation */
static int alloc_ref_offset(Codegen *cg) {
    if (cg->ref_count >= cg->module->inst_count) return 0;
    int offset = -(8 + cg->ref_count * 8);
    cg->ref_offsets[cg->ref_count] = offset;
    return cg->ref_count++;
}

static int get_var_offset(Codegen *cg, uint32_t name_idx) {
    for (int i = 0; i < cg->var_count; i++) {
        if (cg->var_name_idx[i] == name_idx) {
            return cg->var_offsets[i];
        }
    }
    /* 새로운 변수 */
    if (cg->var_count >= cg->var_cap) return 0;
    cg->var_name_idx[cg->var_count] = name_idx;
    int offset = -(8 + cg->ref_count * 8 + cg->var_count * 8);
    cg->var_offsets[cg->var_count] = offset;
    cg->var_count++;
    if (offset < cg->stack_size) cg->stack_size = offset;
    return offset;
}

/* Assembly emission helpers */
static void emit_func_prologue(Codegen *cg, const char *func_name) {
    fprintf(cg->out, "    .globl %s\n", func_name);
    fprintf(cg->out, "    .type %s, @function\n", func_name);
    fprintf(cg->out, "%s:\n", func_name);
    fprintf(cg->out, "    pushq   %%rbp\n");
    fprintf(cg->out, "    movq    %%rsp, %%rbp\n");
}

static void emit_func_epilogue(Codegen *cg) {
    fprintf(cg->out, "    movq    %%rbp, %%rsp\n");
    fprintf(cg->out, "    popq    %%rbp\n");
    fprintf(cg->out, "    ret\n");
}

/* Main codegen: instruction processing */
static void codegen_inst(Codegen *cg, uint32_t ref) {
    if (ref >= cg->module->inst_count) return;
    CirInst *inst = &cg->module->insts[ref];

    switch (inst->op) {
        case CIR_LOAD_INT: {
            int slot = alloc_ref_offset(cg);
            fprintf(cg->out, "    movq    $%lld, %d(%%rbp)\n",
                    inst->u.load_int.imm, cg->ref_offsets[slot]);
            break;
        }
        case CIR_LOAD_FLOAT: {
            int slot = alloc_ref_offset(cg);
            fprintf(cg->out, "    movsd   .LC_FLOAT_%u(%%rip), %%xmm0\n", ref);
            fprintf(cg->out, "    movsd   %%xmm0, %d(%%rbp)\n", cg->ref_offsets[slot]);
            break;
        }
        case CIR_LOAD_STR: {
            int slot = alloc_ref_offset(cg);
            fprintf(cg->out, "    leaq    .LC%u(%%rip), %%rax\n",
                    inst->u.load_str.str_idx);
            fprintf(cg->out, "    movq    %%rax, %d(%%rbp)\n", cg->ref_offsets[slot]);
            break;
        }
        case CIR_LOAD_VAR: {
            int slot = alloc_ref_offset(cg);
            int var_offset = get_var_offset(cg, inst->u.load_var.name_idx);
            fprintf(cg->out, "    movq    %d(%%rbp), %%rax\n", var_offset);
            fprintf(cg->out, "    movq    %%rax, %d(%%rbp)\n", cg->ref_offsets[slot]);
            break;
        }
        case CIR_STORE_VAR: {
            int var_offset = get_var_offset(cg, inst->u.store_var.name_idx);
            CirRef val_ref = inst->u.store_var.value;
            if (val_ref < cg->ref_count) {
                fprintf(cg->out, "    movq    %d(%%rbp), %%rax\n", cg->ref_offsets[val_ref]);
                fprintf(cg->out, "    movq    %%rax, %d(%%rbp)\n", var_offset);
            }
            break;
        }
        case CIR_BINARY: {
            int slot = alloc_ref_offset(cg);
            CirRef lhs = inst->u.binary.lhs;
            CirRef rhs = inst->u.binary.rhs;
            int op = inst->u.binary.op;

            if (lhs >= cg->ref_count || rhs >= cg->ref_count) break;

            fprintf(cg->out, "    movq    %d(%%rbp), %%rax\n", cg->ref_offsets[lhs]);
            fprintf(cg->out, "    movq    %d(%%rbp), %%rbx\n", cg->ref_offsets[rhs]);

            switch (op) {
                case 0:  /* ADD */ fprintf(cg->out, "    addq    %%rbx, %%rax\n"); break;
                case 1:  /* SUB */ fprintf(cg->out, "    subq    %%rbx, %%rax\n"); break;
                case 2:  /* MUL */ fprintf(cg->out, "    imulq   %%rbx, %%rax\n"); break;
                case 3:  /* DIV */
                    fprintf(cg->out, "    cqo\n");
                    fprintf(cg->out, "    idivq   %%rbx\n");
                    break;
                case 4:  /* MOD */
                    fprintf(cg->out, "    cqo\n");
                    fprintf(cg->out, "    idivq   %%rbx\n");
                    fprintf(cg->out, "    movq    %%rdx, %%rax\n");
                    break;
                case 6:  /* LE */
                    fprintf(cg->out, "    cmpq    %%rbx, %%rax\n");
                    fprintf(cg->out, "    setle   %%al\n");
                    fprintf(cg->out, "    movzbq  %%al, %%rax\n");
                    break;
                case 7:  /* GT */
                    fprintf(cg->out, "    cmpq    %%rbx, %%rax\n");
                    fprintf(cg->out, "    setg    %%al\n");
                    fprintf(cg->out, "    movzbq  %%al, %%rax\n");
                    break;
                case 8:  /* GE */
                    fprintf(cg->out, "    cmpq    %%rbx, %%rax\n");
                    fprintf(cg->out, "    setge   %%al\n");
                    fprintf(cg->out, "    movzbq  %%al, %%rax\n");
                    break;
                case 12: /* EQ */
                    fprintf(cg->out, "    cmpq    %%rbx, %%rax\n");
                    fprintf(cg->out, "    sete    %%al\n");
                    fprintf(cg->out, "    movzbq  %%al, %%rax\n");
                    break;
                case 13: /* NEQ */
                    fprintf(cg->out, "    cmpq    %%rbx, %%rax\n");
                    fprintf(cg->out, "    setne   %%al\n");
                    fprintf(cg->out, "    movzbq  %%al, %%rax\n");
                    break;
                case 14: /* LT */
                    fprintf(cg->out, "    cmpq    %%rbx, %%rax\n");
                    fprintf(cg->out, "    setl    %%al\n");
                    fprintf(cg->out, "    movzbq  %%al, %%rax\n");
                    break;
                case 9:  /* AND */ fprintf(cg->out, "    andq    %%rbx, %%rax\n"); break;
                case 10: /* OR  */ fprintf(cg->out, "    orq     %%rbx, %%rax\n"); break;
                case 11: /* XOR */ fprintf(cg->out, "    xorq    %%rbx, %%rax\n"); break;
                case 15: /* LSHIFT */ fprintf(cg->out, "    shlq    %%cl, %%rax\n"); break;
                case 16: /* RSHIFT */ fprintf(cg->out, "    sarq    %%cl, %%rax\n"); break;
                case 18: /* LOGIC_AND */
                    fprintf(cg->out, "    cmpq    $0, %%rax\n");
                    fprintf(cg->out, "    setne   %%al\n");
                    fprintf(cg->out, "    cmpq    $0, %%rbx\n");
                    fprintf(cg->out, "    setne   %%bl\n");
                    fprintf(cg->out, "    andb    %%bl, %%al\n");
                    fprintf(cg->out, "    movzbq  %%al, %%rax\n");
                    break;
                case 19: /* LOGIC_OR */
                    fprintf(cg->out, "    cmpq    $0, %%rax\n");
                    fprintf(cg->out, "    setne   %%al\n");
                    fprintf(cg->out, "    cmpq    $0, %%rbx\n");
                    fprintf(cg->out, "    setne   %%bl\n");
                    fprintf(cg->out, "    orb     %%bl, %%al\n");
                    fprintf(cg->out, "    movzbq  %%al, %%rax\n");
                    break;
            }
            fprintf(cg->out, "    movq    %%rax, %d(%%rbp)\n", cg->ref_offsets[slot]);
            break;
        }
        case CIR_UNARY: {
            int slot = alloc_ref_offset(cg);
            CirRef operand = inst->u.unary.operand;
            if (operand >= cg->ref_count) break;

            fprintf(cg->out, "    movq    %d(%%rbp), %%rax\n", cg->ref_offsets[operand]);

            switch (inst->u.unary.op) {
                case 0: /* NEG */ fprintf(cg->out, "    negq    %%rax\n"); break;
                case 1: /* NOT */
                    fprintf(cg->out, "    cmpq    $0, %%rax\n");
                    fprintf(cg->out, "    sete    %%al\n");
                    fprintf(cg->out, "    movzbq  %%al, %%rax\n");
                    break;
                case 2: /* BITNOT */ fprintf(cg->out, "    notq    %%rax\n"); break;
            }
            fprintf(cg->out, "    movq    %%rax, %d(%%rbp)\n", cg->ref_offsets[slot]);
            break;
        }
        case CIR_LABEL:
            fprintf(cg->out, ".L%u:\n", inst->u.label.label_id);
            break;
        case CIR_JMP:
            fprintf(cg->out, "    jmp     .L%u\n", inst->u.jmp.target);
            break;
        case CIR_JMP_IF: {
            CirRef cond = inst->u.jmp_if.cond;
            if (cond < cg->ref_count) {
                fprintf(cg->out, "    movq    %d(%%rbp), %%rax\n", cg->ref_offsets[cond]);
                fprintf(cg->out, "    cmpq    $0, %%rax\n");
                fprintf(cg->out, "    jne     .L%u\n", inst->u.jmp_if.t_label);
                fprintf(cg->out, "    jmp     .L%u\n", inst->u.jmp_if.f_label);
            }
            break;
        }
        case CIR_RETURN: {
            CirRef val = inst->u.ret.value;
            if (val != CIR_REF_NULL && val < cg->ref_count) {
                fprintf(cg->out, "    movq    %d(%%rbp), %%rax\n", cg->ref_offsets[val]);
            }
            emit_func_epilogue(cg);
            break;
        }
        case CIR_FUNC_BEGIN: {
            const char *func_name = cg->module->strings[inst->u.func_begin.name_idx];
            emit_func_prologue(cg, func_name);
            break;
        }
        case CIR_FUNC_END:
            emit_func_epilogue(cg);
            break;
        case CIR_CALL: {
            int slot = alloc_ref_offset(cg);
            int arg_count = inst->u.call.arg_count;
            const char *arg_regs[] = {"%rdi", "%rsi", "%rdx", "%rcx", "%r8", "%r9"};

            for (int i = 0; i < arg_count && i < 6; i++) {
                CirRef arg_ref = inst->u.call.args[i];
                if (arg_ref < cg->ref_count) {
                    fprintf(cg->out, "    movq    %d(%%rbp), %s\n",
                            cg->ref_offsets[arg_ref], arg_regs[i]);
                }
            }
            fprintf(cg->out, "    call    *%d(%%rbp)\n", cg->ref_offsets[inst->u.call.callee]);
            fprintf(cg->out, "    movq    %%rax, %d(%%rbp)\n", cg->ref_offsets[slot]);
            break;
        }
        default:
            break;
    }
}

/* Main emit function */
void codegen_emit(Codegen *cg) {
    if (!cg || !cg->module) return;

    /* .rodata section for strings */
    fprintf(cg->out, "    .section .rodata\n");
    for (uint32_t i = 0; i < cg->module->str_count; i++) {
        if (cg->module->strings[i]) {
            fprintf(cg->out, ".LC%u:\n", i);
            fprintf(cg->out, "    .string \"%s\"\n", cg->module->strings[i]);
        }
    }

    /* .text section */
    fprintf(cg->out, "    .section .text\n");

    /* Process all instructions */
    for (uint32_t i = 0; i < cg->module->inst_count; i++) {
        codegen_inst(cg, i);
    }
}
