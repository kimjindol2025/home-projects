#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "../test_framework.h"
#include "../../src/lexer.h"

/* 토큰 확인 헬퍼 */
#define EXPECT_TOKEN(lex, idx, kind) \
    do { \
        if ((idx) >= (lex)->tok_count) { \
            fprintf(stderr, "FAIL: Token index %d out of bounds\n", idx); \
            exit(1); \
        } \
        if ((lex)->tokens[(idx)].kind != (kind)) { \
            fprintf(stderr, "FAIL: Token %d expected %d, got %d\n", \
                    idx, kind, (lex)->tokens[(idx)].kind); \
            exit(1); \
        } \
    } while(0)

/* Test 1: 키워드 인식 */
TEST(keywords) {
    const char *src = "int x; void func() {}";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_INT);
    EXPECT_TOKEN(lex, 2, TK_SEMICOLON);
    EXPECT_TOKEN(lex, 3, TK_VOID);

    lexer_free(lex);
}

/* Test 2: 정수 리터럴 (10진법) */
TEST(int_decimal) {
    const char *src = "42 100 0";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_INT_LIT);
    ASSERT_EQ(lex->tokens[0].val.int_val, 42);

    EXPECT_TOKEN(lex, 1, TK_INT_LIT);
    ASSERT_EQ(lex->tokens[1].val.int_val, 100);

    EXPECT_TOKEN(lex, 2, TK_INT_LIT);
    ASSERT_EQ(lex->tokens[2].val.int_val, 0);

    lexer_free(lex);
}

/* Test 3: 정수 리터럴 (16진법) */
TEST(int_hex) {
    const char *src = "0xFF 0xAB 0x10";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_INT_LIT);
    ASSERT_EQ(lex->tokens[0].val.int_val, 0xFF);

    EXPECT_TOKEN(lex, 1, TK_INT_LIT);
    ASSERT_EQ(lex->tokens[1].val.int_val, 0xAB);

    lexer_free(lex);
}

/* Test 4: 정수 리터럴 (8진법) */
TEST(int_octal) {
    const char *src = "010 0777 077";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_INT_LIT);
    ASSERT_EQ(lex->tokens[0].val.int_val, 8);  /* 010 = 8 */

    EXPECT_TOKEN(lex, 1, TK_INT_LIT);
    ASSERT_EQ(lex->tokens[1].val.int_val, 0o777);  /* 0777 = 511 */

    lexer_free(lex);
}

/* Test 5: 식별자 */
TEST(identifier) {
    const char *src = "x y_test _var abc123";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_IDENT);
    ASSERT_STR_EQ(lex->tokens[0].val.ident, "x");

    EXPECT_TOKEN(lex, 1, TK_IDENT);
    ASSERT_STR_EQ(lex->tokens[1].val.ident, "y_test");

    EXPECT_TOKEN(lex, 2, TK_IDENT);
    ASSERT_STR_EQ(lex->tokens[2].val.ident, "_var");

    lexer_free(lex);
}

/* Test 6: 산술 연산자 */
TEST(arithmetic_ops) {
    const char *src = "+ - * / %";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_PLUS);
    EXPECT_TOKEN(lex, 1, TK_MINUS);
    EXPECT_TOKEN(lex, 2, TK_STAR);
    EXPECT_TOKEN(lex, 3, TK_SLASH);
    EXPECT_TOKEN(lex, 4, TK_PERCENT);

    lexer_free(lex);
}

/* Test 7: 비교 연산자 */
TEST(comparison_ops) {
    const char *src = "== != < <= > >=";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_EQ);
    EXPECT_TOKEN(lex, 1, TK_NEQ);
    EXPECT_TOKEN(lex, 2, TK_LT);
    EXPECT_TOKEN(lex, 3, TK_LE);
    EXPECT_TOKEN(lex, 4, TK_GT);
    EXPECT_TOKEN(lex, 5, TK_GE);

    lexer_free(lex);
}

/* Test 8: 논리 연산자 */
TEST(logical_ops) {
    const char *src = "&& || !";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_AND);
    EXPECT_TOKEN(lex, 1, TK_OR);
    EXPECT_TOKEN(lex, 2, TK_BANG);

    lexer_free(lex);
}

/* Test 9: 할당 연산자 */
TEST(assignment_ops) {
    const char *src = "= += -= *= /= %=";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_ASSIGN);
    EXPECT_TOKEN(lex, 1, TK_PLUS_ASSIGN);
    EXPECT_TOKEN(lex, 2, TK_MINUS_ASSIGN);
    EXPECT_TOKEN(lex, 3, TK_STAR_ASSIGN);
    EXPECT_TOKEN(lex, 4, TK_SLASH_ASSIGN);
    EXPECT_TOKEN(lex, 5, TK_PERCENT_ASSIGN);

    lexer_free(lex);
}

/* Test 10: 증감 연산자 */
TEST(inc_dec_ops) {
    const char *src = "++ -- x++ y--";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_INC);
    EXPECT_TOKEN(lex, 1, TK_DEC);

    lexer_free(lex);
}

/* Test 11: 비트 연산자 */
TEST(bitwise_ops) {
    const char *src = "& | ^ ~ << >>";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_AMPERSAND);
    EXPECT_TOKEN(lex, 1, TK_PIPE);
    EXPECT_TOKEN(lex, 2, TK_CARET);
    EXPECT_TOKEN(lex, 3, TK_TILDE);
    EXPECT_TOKEN(lex, 4, TK_LSHIFT);
    EXPECT_TOKEN(lex, 5, TK_RSHIFT);

    lexer_free(lex);
}

/* Test 12: 구분자 */
TEST(delimiters) {
    const char *src = "( ) { } [ ] ; , . ->";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_LPAREN);
    EXPECT_TOKEN(lex, 1, TK_RPAREN);
    EXPECT_TOKEN(lex, 2, TK_LBRACE);
    EXPECT_TOKEN(lex, 3, TK_RBRACE);
    EXPECT_TOKEN(lex, 4, TK_LBRACKET);
    EXPECT_TOKEN(lex, 5, TK_RBRACKET);
    EXPECT_TOKEN(lex, 6, TK_SEMICOLON);
    EXPECT_TOKEN(lex, 7, TK_COMMA);
    EXPECT_TOKEN(lex, 8, TK_DOT);
    EXPECT_TOKEN(lex, 9, TK_ARROW);

    lexer_free(lex);
}

/* Test 13: 문자 리터럴 */
TEST(char_literal) {
    const char *src = "'a' 'z' '0' ' '";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_CHAR_LIT);
    ASSERT_EQ(lex->tokens[0].val.char_val, 'a');

    EXPECT_TOKEN(lex, 1, TK_CHAR_LIT);
    ASSERT_EQ(lex->tokens[1].val.char_val, 'z');

    lexer_free(lex);
}

/* Test 14: 이스케이프 문자 */
TEST(escape_chars) {
    const char *src = "'\\n' '\\t' '\\\\' '\\''";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_CHAR_LIT);
    ASSERT_EQ(lex->tokens[0].val.char_val, '\n');

    EXPECT_TOKEN(lex, 1, TK_CHAR_LIT);
    ASSERT_EQ(lex->tokens[1].val.char_val, '\t');

    lexer_free(lex);
}

/* Test 15: 문자열 리터럴 */
TEST(string_literal) {
    const char *src = "\"hello\" \"world\"";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_STR_LIT);
    /* 문자열 값 비교 */

    EXPECT_TOKEN(lex, 1, TK_STR_LIT);

    lexer_free(lex);
}

/* Test 16: 한줄 주석 */
TEST(line_comment) {
    const char *src = "int x; // comment\nint y;";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_INT);
    EXPECT_TOKEN(lex, 1, TK_IDENT);
    EXPECT_TOKEN(lex, 2, TK_SEMICOLON);
    EXPECT_TOKEN(lex, 3, TK_INT);

    lexer_free(lex);
}

/* Test 17: 블록 주석 */
TEST(block_comment) {
    const char *src = "int /* comment */ x;";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_INT);
    EXPECT_TOKEN(lex, 1, TK_IDENT);
    EXPECT_TOKEN(lex, 2, TK_SEMICOLON);

    lexer_free(lex);
}

/* Test 18: 타입 한정자 */
TEST(type_qualifiers) {
    const char *src = "const volatile unsigned signed";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_CONST);
    EXPECT_TOKEN(lex, 1, TK_VOLATILE);
    EXPECT_TOKEN(lex, 2, TK_UNSIGNED);
    EXPECT_TOKEN(lex, 3, TK_SIGNED);

    lexer_free(lex);
}

/* Test 19: 복잡한 표현식 */
TEST(complex_expr) {
    const char *src = "x = (a + b) * c;";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_IDENT);
    EXPECT_TOKEN(lex, 1, TK_ASSIGN);
    EXPECT_TOKEN(lex, 2, TK_LPAREN);
    EXPECT_TOKEN(lex, 3, TK_IDENT);
    EXPECT_TOKEN(lex, 4, TK_PLUS);
    EXPECT_TOKEN(lex, 5, TK_IDENT);
    EXPECT_TOKEN(lex, 6, TK_RPAREN);
    EXPECT_TOKEN(lex, 7, TK_STAR);
    EXPECT_TOKEN(lex, 8, TK_IDENT);
    EXPECT_TOKEN(lex, 9, TK_SEMICOLON);

    lexer_free(lex);
}

/* Test 20: EOF 토큰 */
TEST(eof_token) {
    const char *src = "int x";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    /* 마지막 토큰은 EOF여야 함 */
    EXPECT_TOKEN(lex, lex->tok_count - 1, TK_EOF);

    lexer_free(lex);
}

/* Test 21: 삼항 연산자 */
TEST(ternary_op) {
    const char *src = "a ? b : c";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_IDENT);
    EXPECT_TOKEN(lex, 1, TK_QUESTION);
    EXPECT_TOKEN(lex, 2, TK_IDENT);
    EXPECT_TOKEN(lex, 3, TK_COLON);
    EXPECT_TOKEN(lex, 4, TK_IDENT);

    lexer_free(lex);
}

/* Test 22: 타입 캐스트 */
TEST(type_cast) {
    const char *src = "(int)x (float)3.14";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_LPAREN);
    EXPECT_TOKEN(lex, 1, TK_INT);
    EXPECT_TOKEN(lex, 2, TK_RPAREN);
    EXPECT_TOKEN(lex, 3, TK_IDENT);

    lexer_free(lex);
}

/* Test 23: 구조체 정의 */
TEST(struct_def) {
    const char *src = "struct Point { int x; };";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_STRUCT);
    EXPECT_TOKEN(lex, 1, TK_IDENT);
    EXPECT_TOKEN(lex, 2, TK_LBRACE);
    EXPECT_TOKEN(lex, 3, TK_INT);
    EXPECT_TOKEN(lex, 4, TK_IDENT);
    EXPECT_TOKEN(lex, 5, TK_SEMICOLON);
    EXPECT_TOKEN(lex, 6, TK_RBRACE);
    EXPECT_TOKEN(lex, 7, TK_SEMICOLON);

    lexer_free(lex);
}

/* Test 24: if-else */
TEST(if_else) {
    const char *src = "if (x > 0) { y = 1; } else { y = 0; }";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_IF);
    EXPECT_TOKEN(lex, 1, TK_LPAREN);
    EXPECT_TOKEN(lex, 4, TK_GT);
    EXPECT_TOKEN(lex, 10, TK_ELSE);

    lexer_free(lex);
}

/* Test 25: for 루프 */
TEST(for_loop) {
    const char *src = "for (int i = 0; i < 10; i++) {}";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_FOR);
    EXPECT_TOKEN(lex, 1, TK_LPAREN);
    EXPECT_TOKEN(lex, 2, TK_INT);

    lexer_free(lex);
}

/* Test 26: 엘립시스 (...) */
TEST(ellipsis) {
    const char *src = "void printf(char *fmt, ...)";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 5, TK_COMMA);
    EXPECT_TOKEN(lex, 6, TK_ELLIPSIS);

    lexer_free(lex);
}

/* Test 27: 단순 함수 */
TEST(simple_function) {
    const char *src = "int add(int a, int b) { return a + b; }";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_INT);
    EXPECT_TOKEN(lex, 1, TK_IDENT);
    EXPECT_TOKEN(lex, 2, TK_LPAREN);

    lexer_free(lex);
}

/* Test 28: 주석 무시 */
TEST(ignore_comments) {
    const char *src = "/* start */int x;/* end */";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_INT);
    EXPECT_TOKEN(lex, 1, TK_IDENT);
    EXPECT_TOKEN(lex, 2, TK_SEMICOLON);

    lexer_free(lex);
}

/* Test 29: 숫자 다양성 */
TEST(various_numbers) {
    const char *src = "123 0x123 0123";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_INT_LIT);
    EXPECT_TOKEN(lex, 1, TK_INT_LIT);
    EXPECT_TOKEN(lex, 2, TK_INT_LIT);

    lexer_free(lex);
}

/* Test 30: 공백 무시 */
TEST(ignore_whitespace) {
    const char *src = "int   x   =   5   ;";
    Lexer *lex = lexer_new(src, strlen(src));
    lexer_tokenize(lex);

    EXPECT_TOKEN(lex, 0, TK_INT);
    EXPECT_TOKEN(lex, 1, TK_IDENT);
    EXPECT_TOKEN(lex, 2, TK_ASSIGN);
    EXPECT_TOKEN(lex, 3, TK_INT_LIT);
    EXPECT_TOKEN(lex, 4, TK_SEMICOLON);

    lexer_free(lex);
}

