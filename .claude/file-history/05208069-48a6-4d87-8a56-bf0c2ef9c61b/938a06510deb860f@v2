#include <stdlib.h>
#include <string.h>
#include <stdio.h>
#include "sema.h"
#include "lexer.h"

/* Type management */
SemaType *sema_type_basic(SemaTypeKind kind) {
    SemaType *t = (SemaType *)malloc(sizeof(SemaType));
    if (!t) return NULL;
    t->kind = kind;
    t->base = NULL;
    t->array_size = 0;
    t->is_const = 0;
    return t;
}

SemaType *sema_type_ptr(SemaType *base) {
    if (!base) return NULL;
    SemaType *t = (SemaType *)malloc(sizeof(SemaType));
    if (!t) return NULL;
    t->kind = SEMA_TYPE_PTR;
    t->base = base;
    t->array_size = 0;
    t->is_const = 0;
    return t;
}

SemaType *sema_type_array(SemaType *base, int size) {
    if (!base) return NULL;
    SemaType *t = (SemaType *)malloc(sizeof(SemaType));
    if (!t) return NULL;
    t->kind = SEMA_TYPE_ARRAY;
    t->base = base;
    t->array_size = size;
    t->is_const = 0;
    return t;
}

void sema_type_free(SemaType *t) {
    if (!t) return;
    if (t->base) sema_type_free(t->base);
    free(t);
}

int sema_types_compatible(SemaType *a, SemaType *b) {
    if (!a || !b) return 0;
    if (a->kind != b->kind) {
        /* 기본형은 상호 변환 가능 (int/char/float/double) */
        if ((a->kind == SEMA_TYPE_INT || a->kind == SEMA_TYPE_CHAR) &&
            (b->kind == SEMA_TYPE_INT || b->kind == SEMA_TYPE_CHAR)) return 1;
        if ((a->kind == SEMA_TYPE_FLOAT || a->kind == SEMA_TYPE_DOUBLE) &&
            (b->kind == SEMA_TYPE_FLOAT || b->kind == SEMA_TYPE_DOUBLE)) return 1;
        return 0;
    }
    /* 같은 종류 */
    if (a->kind == SEMA_TYPE_PTR) {
        return sema_types_compatible(a->base, b->base);
    }
    if (a->kind == SEMA_TYPE_ARRAY) {
        return a->array_size == b->array_size && sema_types_compatible(a->base, b->base);
    }
    return 1;
}

const char *sema_type_to_string(SemaType *t) {
    if (!t) return "unknown";
    switch (t->kind) {
        case SEMA_TYPE_VOID: return "void";
        case SEMA_TYPE_CHAR: return "char";
        case SEMA_TYPE_INT: return "int";
        case SEMA_TYPE_FLOAT: return "float";
        case SEMA_TYPE_DOUBLE: return "double";
        case SEMA_TYPE_LONG: return "long";
        case SEMA_TYPE_PTR: return "ptr";
        case SEMA_TYPE_ARRAY: return "array";
        case SEMA_TYPE_FUNC: return "func";
        case SEMA_TYPE_STRUCT: return "struct";
        case SEMA_TYPE_UNKNOWN: return "unknown";
    }
    return "unknown";
}

/* Symbol table operations */
SymTable *symtable_new(void) {
    SymTable *t = (SymTable *)malloc(sizeof(SymTable));
    if (!t) return NULL;
    Scope *global = (Scope *)malloc(sizeof(Scope));
    if (!global) { free(t); return NULL; }
    global->syms = (Symbol **)malloc(sizeof(Symbol *) * 256);
    if (!global->syms) { free(global); free(t); return NULL; }
    global->sym_count = 0;
    global->sym_cap = 256;
    global->parent = NULL;
    t->current = global;
    t->global = global;
    return t;
}

void symtable_free(SymTable *t) {
    if (!t) return;
    while (t->current->parent) {
        Scope *tmp = t->current;
        t->current = t->current->parent;
        for (int i = 0; i < tmp->sym_count; i++) {
            if (tmp->syms[i]) {
                free(tmp->syms[i]->name);
                sema_type_free(tmp->syms[i]->type);
                free(tmp->syms[i]);
            }
        }
        free(tmp->syms);
        free(tmp);
    }
    /* 전역 스코프 해제 */
    for (int i = 0; i < t->global->sym_count; i++) {
        if (t->global->syms[i]) {
            free(t->global->syms[i]->name);
            sema_type_free(t->global->syms[i]->type);
            free(t->global->syms[i]);
        }
    }
    free(t->global->syms);
    free(t->global);
    free(t);
}

void symtable_enter_scope(SymTable *t) {
    if (!t) return;
    Scope *new_scope = (Scope *)malloc(sizeof(Scope));
    if (!new_scope) return;
    new_scope->syms = (Symbol **)malloc(sizeof(Symbol *) * 256);
    if (!new_scope->syms) { free(new_scope); return; }
    new_scope->sym_count = 0;
    new_scope->sym_cap = 256;
    new_scope->parent = t->current;
    t->current = new_scope;
}

void symtable_exit_scope(SymTable *t) {
    if (!t || !t->current->parent) return;
    Scope *old = t->current;
    t->current = t->current->parent;
    for (int i = 0; i < old->sym_count; i++) {
        if (old->syms[i]) {
            free(old->syms[i]->name);
            sema_type_free(old->syms[i]->type);
            free(old->syms[i]);
        }
    }
    free(old->syms);
    free(old);
}

Symbol *symtable_define(SymTable *t, const char *name, SymKind kind, SemaType *type) {
    if (!t || !name) return NULL;
    /* 현재 스코프에 중복 확인 */
    for (int i = 0; i < t->current->sym_count; i++) {
        if (t->current->syms[i] && strcmp(t->current->syms[i]->name, name) == 0) {
            return NULL; /* 중복 */
        }
    }
    /* 확장 필요 */
    if (t->current->sym_count >= t->current->sym_cap) {
        t->current->sym_cap *= 2;
        Symbol **new_syms = (Symbol **)realloc(t->current->syms, sizeof(Symbol *) * t->current->sym_cap);
        if (!new_syms) return NULL;
        t->current->syms = new_syms;
    }
    Symbol *sym = (Symbol *)malloc(sizeof(Symbol));
    if (!sym) return NULL;
    sym->name = (char *)malloc(strlen(name) + 1);
    if (!sym->name) { free(sym); return NULL; }
    strcpy(sym->name, name);
    sym->kind = kind;
    sym->type = type;
    sym->param_count = 0;
    sym->next = NULL;
    t->current->syms[t->current->sym_count++] = sym;
    return sym;
}

Symbol *symtable_lookup(SymTable *t, const char *name) {
    if (!t || !name) return NULL;
    Scope *scope = t->current;
    while (scope) {
        for (int i = 0; i < scope->sym_count; i++) {
            if (scope->syms[i] && strcmp(scope->syms[i]->name, name) == 0) {
                return scope->syms[i];
            }
        }
        scope = scope->parent;
    }
    return NULL;
}

/* Sema operations */
Sema *sema_new(void) {
    Sema *s = (Sema *)malloc(sizeof(Sema));
    if (!s) return NULL;
    s->syms = symtable_new();
    if (!s->syms) { free(s); return NULL; }
    s->current_func_ret = NULL;
    s->loop_depth = 0;
    s->error_count = 0;
    return s;
}

void sema_free(Sema *s) {
    if (!s) return;
    if (s->syms) symtable_free(s->syms);
    if (s->current_func_ret) sema_type_free(s->current_func_ret);
    free(s);
}

/* Type inference from AST */
static SemaType *sema_infer_type(Sema *s, Node *type_node) {
    if (!type_node) return sema_type_basic(SEMA_TYPE_INT);
    if (type_node->kind == ND_TYPE_BASE) {
        switch (type_node->op) {
            case TK_VOID: return sema_type_basic(SEMA_TYPE_VOID);
            case TK_CHAR: return sema_type_basic(SEMA_TYPE_CHAR);
            case TK_INT: return sema_type_basic(SEMA_TYPE_INT);
            case TK_FLOAT: return sema_type_basic(SEMA_TYPE_FLOAT);
            case TK_DOUBLE: return sema_type_basic(SEMA_TYPE_DOUBLE);
            case TK_LONG: return sema_type_basic(SEMA_TYPE_LONG);
            default: return sema_type_basic(SEMA_TYPE_INT);
        }
    }
    if (type_node->kind == ND_TYPE_PTR && type_node->left) {
        SemaType *base = sema_infer_type(s, type_node->left);
        return sema_type_ptr(base);
    }
    return sema_type_basic(SEMA_TYPE_INT);
}

SemaType *sema_check_expr(Sema *s, Node *expr) {
    if (!expr) return NULL;
    switch (expr->kind) {
        case ND_INT_LIT: return sema_type_basic(SEMA_TYPE_INT);
        case ND_CHAR_LIT: return sema_type_basic(SEMA_TYPE_CHAR);
        case ND_FLOAT_LIT: return sema_type_basic(SEMA_TYPE_DOUBLE);
        case ND_STR_LIT: return sema_type_ptr(sema_type_basic(SEMA_TYPE_CHAR));
        case ND_IDENT: {
            Symbol *sym = symtable_lookup(s->syms, expr->name);
            if (!sym) {
                fprintf(stderr, "error: undefined variable '%s'\n", expr->name);
                s->error_count++;
                return sema_type_basic(SEMA_TYPE_UNKNOWN);
            }
            return sym->type;
        }
        case ND_BINARY: {
            SemaType *lhs = sema_check_expr(s, expr->left);
            SemaType *rhs = sema_check_expr(s, expr->right);
            if (!sema_types_compatible(lhs, rhs)) {
                s->error_count++;
            }
            sema_type_free(lhs);
            sema_type_free(rhs);
            return sema_type_basic(SEMA_TYPE_INT);
        }
        case ND_ASSIGN: {
            SemaType *lhs = sema_check_expr(s, expr->left);
            SemaType *rhs = sema_check_expr(s, expr->right);
            if (!sema_types_compatible(lhs, rhs)) {
                s->error_count++;
            }
            sema_type_free(rhs);
            return lhs;
        }
        case ND_CALL: {
            if (expr->left->kind == ND_IDENT) {
                Symbol *func = symtable_lookup(s->syms, expr->left->name);
                if (!func) {
                    fprintf(stderr, "error: undefined function '%s'\n", expr->left->name);
                    s->error_count++;
                    return sema_type_basic(SEMA_TYPE_UNKNOWN);
                }
                if (func->type) return func->type;
            }
            return sema_type_basic(SEMA_TYPE_INT);
        }
        case ND_UNARY: {
            SemaType *operand = sema_check_expr(s, expr->left);
            sema_type_free(operand);
            return sema_type_basic(SEMA_TYPE_INT);
        }
        default:
            return sema_type_basic(SEMA_TYPE_INT);
    }
}

int sema_check_stmt(Sema *s, Node *stmt) {
    if (!stmt) return 0;
    switch (stmt->kind) {
        case ND_EXPR_STMT:
            if (stmt->left) sema_check_expr(s, stmt->left);
            break;
        case ND_RETURN: {
            if (stmt->left) {
                SemaType *ret_type = sema_check_expr(s, stmt->left);
                if (s->current_func_ret && !sema_types_compatible(s->current_func_ret, ret_type)) {
                    s->error_count++;
                }
                sema_type_free(ret_type);
            }
            break;
        }
        case ND_BLOCK:
            for (int i = 0; i < stmt->child_count; i++) {
                if (stmt->children[i]) sema_check_stmt(s, stmt->children[i]);
            }
            break;
        case ND_VAR_DECL: {
            SemaType *t = sema_infer_type(s, stmt->type_node);
            if (!symtable_define(s->syms, stmt->name, SYM_VAR, t)) {
                fprintf(stderr, "error: duplicate variable '%s'\n", stmt->name);
                s->error_count++;
            }
            if (stmt->left) sema_check_expr(s, stmt->left);
            break;
        }
        case ND_IF: {
            sema_check_expr(s, stmt->cond);
            if (stmt->then_body) sema_check_stmt(s, stmt->then_body);
            if (stmt->else_body) sema_check_stmt(s, stmt->else_body);
            break;
        }
        case ND_WHILE: {
            sema_check_expr(s, stmt->cond);
            s->loop_depth++;
            if (stmt->body) sema_check_stmt(s, stmt->body);
            s->loop_depth--;
            break;
        }
        case ND_FOR: {
            if (stmt->init) sema_check_stmt(s, stmt->init);
            if (stmt->cond) sema_check_expr(s, stmt->cond);
            s->loop_depth++;
            if (stmt->body) sema_check_stmt(s, stmt->body);
            s->loop_depth--;
            if (stmt->step) sema_check_expr(s, stmt->step);
            break;
        }
        case ND_BREAK:
        case ND_CONTINUE: {
            if (s->loop_depth == 0) {
                fprintf(stderr, "error: %s outside loop\n", stmt->kind == ND_BREAK ? "break" : "continue");
                s->error_count++;
            }
            break;
        }
        default:
            break;
    }
    return s->error_count;
}

int sema_check_decl(Sema *s, Node *decl) {
    if (!decl) return 0;
    if (decl->kind == ND_FUNC_DEF) {
        /* 함수 선언 */
        SemaType *ret_type = sema_infer_type(s, decl->type_node);
        Symbol *func_sym = symtable_define(s->syms, decl->name, SYM_FUNC, ret_type);
        if (!func_sym) {
            fprintf(stderr, "error: duplicate function '%s'\n", decl->name);
            s->error_count++;
            return s->error_count;
        }
        func_sym->param_count = decl->child_count;
        /* 스코프 진입 */
        symtable_enter_scope(s->syms);
        /* 매개변수 등록 */
        for (int i = 0; i < decl->child_count; i++) {
            Node *param = decl->children[i];
            if (param && param->kind == ND_PARAM) {
                SemaType *param_type = sema_infer_type(s, param->type_node);
                symtable_define(s->syms, param->name, SYM_VAR, param_type);
            }
        }
        /* 함수 본체 분석 */
        SemaType *old_ret = s->current_func_ret;
        s->current_func_ret = ret_type;
        if (decl->body) sema_check_stmt(s, decl->body);
        s->current_func_ret = old_ret;
        /* 스코프 해제 */
        symtable_exit_scope(s->syms);
    }
    return s->error_count;
}

int sema_check(Sema *s, Node *program) {
    if (!s || !program) return 0;
    if (program->kind != ND_PROGRAM) return 0;
    for (int i = 0; i < program->child_count; i++) {
        if (program->children[i]) {
            sema_check_decl(s, program->children[i]);
        }
    }
    return s->error_count;
}
