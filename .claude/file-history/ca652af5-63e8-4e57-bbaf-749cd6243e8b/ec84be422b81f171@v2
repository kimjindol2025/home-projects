/// Standard Library Generator - Linux Syscall-Based Built-in Functions
///
/// Generates architecture-specific assembly code for standard library functions.
/// Supports: x86-64, RISC-V, ARM64
///
/// Functions:
/// - std_print(ptr, len): write syscall - output bytes to stdout
/// - std_exit(code): exit syscall - terminate program
/// - std_itoa(n, buf): convert integer to ASCII string
///
/// Linux Syscall Numbers:
/// | Function | x86-64 | ARM64 | RISC-V |
/// |----------|--------|-------|--------|
/// | write    | 1      | 64    | 64     |
/// | exit     | 60     | 93    | 93     |

const std = @import("std");
const Allocator = std.mem.Allocator;

pub const Backend = enum {
    x86_64,
    riscv64,
    arm64,
};

pub const StdlibGen = struct {
    allocator: Allocator,
    backend: Backend,
    output: std.ArrayList(u8),

    pub fn init(allocator: Allocator, backend: Backend) StdlibGen {
        return StdlibGen{
            .allocator = allocator,
            .backend = backend,
            .output = std.ArrayList(u8).init(allocator),
        };
    }

    pub fn deinit(self: *StdlibGen) void {
        self.output.deinit();
    }

    /// Emit a line of assembly
    fn emit(self: *StdlibGen, comptime fmt: []const u8, args: anytype) !void {
        try self.output.writer().print(fmt ++ "\n", args);
    }

    /// Generate all standard library functions
    pub fn generate(self: *StdlibGen) !void {
        try self.emitPrint();
        try self.emit("", .{});
        try self.emitExit();
        try self.emit("", .{});
        try self.emitItoa();
    }

    /// Generate std_print(ptr, len) - write syscall
    /// Signature: void std_print(void *ptr, int len)
    /// Arguments: ptr in rdi (x86), x0 (ARM64), a0 (RISC-V); len in rsi (x86), x1 (ARM64), a1 (RISC-V)
    pub fn emitPrint(self: *StdlibGen) !void {
        switch (self.backend) {
            .x86_64 => {
                try self.emit(".globl std_print", .{});
                try self.emit("std_print:", .{});
                try self.emit("    push rbp", .{});
                try self.emit("    mov rbp, rsp", .{});
                try self.emit("    mov rax, 1          ; sys_write", .{});
                try self.emit("    mov rdi, 1          ; fd = stdout", .{});
                try self.emit("    ; rsi = ptr (arg0), rdx = len (arg1)", .{});
                try self.emit("    syscall", .{});
                try self.emit("    pop rbp", .{});
                try self.emit("    ret", .{});
            },
            .arm64 => {
                try self.emit(".globl std_print", .{});
                try self.emit("std_print:", .{});
                try self.emit("    stp x29, x30, [sp, #-16]!", .{});
                try self.emit("    mov x29, sp", .{});
                try self.emit("    mov x8, #64         ; sys_write", .{});
                try self.emit("    mov x0, #1          ; fd = stdout", .{});
                try self.emit("    ; x1 = ptr (arg0), x2 = len (arg1)", .{});
                try self.emit("    svc #0              ; syscall", .{});
                try self.emit("    ldp x29, x30, [sp], #16", .{});
                try self.emit("    ret", .{});
            },
            .riscv64 => {
                try self.emit(".globl std_print", .{});
                try self.emit("std_print:", .{});
                try self.emit("    addi sp, sp, -32", .{});
                try self.emit("    sd ra, 24(sp)", .{});
                try self.emit("    sd s0, 16(sp)", .{});
                try self.emit("    li a7, 64           ; sys_write", .{});
                try self.emit("    li a0, 1            ; fd = stdout", .{});
                try self.emit("    ; a1 = ptr (arg0), a2 = len (arg1)", .{});
                try self.emit("    ecall", .{});
                try self.emit("    ld s0, 16(sp)", .{});
                try self.emit("    ld ra, 24(sp)", .{});
                try self.emit("    addi sp, sp, 32", .{});
                try self.emit("    ret", .{});
            },
        }
    }

    /// Generate std_exit(code) - exit syscall
    /// Signature: void std_exit(int code)
    /// Arguments: code in rdi (x86), x0 (ARM64), a0 (RISC-V)
    pub fn emitExit(self: *StdlibGen) !void {
        switch (self.backend) {
            .x86_64 => {
                try self.emit(".globl std_exit", .{});
                try self.emit("std_exit:", .{});
                try self.emit("    mov rax, 60         ; sys_exit", .{});
                try self.emit("    ; rdi = code (arg0)", .{});
                try self.emit("    syscall", .{});
                try self.emit("    ; unreachable", .{});
            },
            .arm64 => {
                try self.emit(".globl std_exit", .{});
                try self.emit("std_exit:", .{});
                try self.emit("    mov x8, #93         ; sys_exit", .{});
                try self.emit("    ; x0 = code (arg0)", .{});
                try self.emit("    svc #0              ; syscall", .{});
                try self.emit("    ; unreachable", .{});
            },
            .riscv64 => {
                try self.emit(".globl std_exit", .{});
                try self.emit("std_exit:", .{});
                try self.emit("    li a7, 93           ; sys_exit", .{});
                try self.emit("    ; a0 = code (arg0)", .{});
                try self.emit("    ecall", .{});
                try self.emit("    ; unreachable", .{});
            },
        }
    }

    /// Generate std_itoa(n, buf) - convert integer to ASCII string
    /// Simple implementation: handles 0-9 digits + negative sign
    /// This is a placeholder; full implementation would handle large numbers
    pub fn emitItoa(self: *StdlibGen) !void {
        switch (self.backend) {
            .x86_64 => {
                try self.emit(".globl std_itoa", .{});
                try self.emit("std_itoa:", .{});
                try self.emit("    push rbp", .{});
                try self.emit("    mov rbp, rsp", .{});
                try self.emit("    ; rdi = n (arg0), rsi = buf (arg1)", .{});
                try self.emit("    ; simple version: convert single digit", .{});
                try self.emit("    cmp rdi, 0", .{});
                try self.emit("    jge .L_positive", .{});
                try self.emit("    mov byte [rsi], 45  ; '-'", .{});
                try self.emit("    neg rdi", .{});
                try self.emit("    mov rsi, rsi + 1", .{});
                try self.emit(".L_positive:", .{});
                try self.emit("    add rdi, 48         ; '0'", .{});
                try self.emit("    mov byte [rsi], dil", .{});
                try self.emit("    mov byte [rsi + 1], 0", .{});
                try self.emit("    pop rbp", .{});
                try self.emit("    ret", .{});
            },
            .arm64 => {
                try self.emit(".globl std_itoa", .{});
                try self.emit("std_itoa:", .{});
                try self.emit("    stp x29, x30, [sp, #-16]!", .{});
                try self.emit("    mov x29, sp", .{});
                try self.emit("    ; x0 = n (arg0), x1 = buf (arg1)", .{});
                try self.emit("    cmp x0, 0", .{});
                try self.emit("    b.ge .L_arm_positive", .{});
                try self.emit("    mov w2, 45          ; '-'", .{});
                try self.emit("    strb w2, [x1]", .{});
                try self.emit("    neg x0, x0", .{});
                try self.emit("    add x1, x1, 1", .{});
                try self.emit(".L_arm_positive:", .{});
                try self.emit("    add w0, w0, 48      ; '0'", .{});
                try self.emit("    strb w0, [x1]", .{});
                try self.emit("    mov w2, 0", .{});
                try self.emit("    strb w2, [x1, 1]", .{});
                try self.emit("    ldp x29, x30, [sp], #16", .{});
                try self.emit("    ret", .{});
            },
            .riscv64 => {
                try self.emit(".globl std_itoa", .{});
                try self.emit("std_itoa:", .{});
                try self.emit("    addi sp, sp, -32", .{});
                try self.emit("    sd ra, 24(sp)", .{});
                try self.emit("    sd s0, 16(sp)", .{});
                try self.emit("    ; a0 = n (arg0), a1 = buf (arg1)", .{});
                try self.emit("    bge a0, zero, .L_riscv_positive", .{});
                try self.emit("    li a2, 45           ; '-'", .{});
                try self.emit("    sb a2, 0(a1)", .{});
                try self.emit("    neg a0, a0", .{});
                try self.emit("    addi a1, a1, 1", .{});
                try self.emit(".L_riscv_positive:", .{});
                try self.emit("    addi a0, a0, 48     ; '0'", .{});
                try self.emit("    sb a0, 0(a1)", .{});
                try self.emit("    sb zero, 1(a1)", .{});
                try self.emit("    ld s0, 16(sp)", .{});
                try self.emit("    ld ra, 24(sp)", .{});
                try self.emit("    addi sp, sp, 32", .{});
                try self.emit("    ret", .{});
            },
        }
    }

    /// Get backend architecture string
    pub fn getBackendString(self: StdlibGen) []const u8 {
        return switch (self.backend) {
            .x86_64 => "x86_64",
            .riscv64 => "riscv64",
            .arm64 => "arm64",
        };
    }
};
