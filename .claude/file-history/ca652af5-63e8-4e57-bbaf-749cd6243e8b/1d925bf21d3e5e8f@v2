    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = RiscvCodegen.init(allocator);
    defer codegen.deinit();

    try codegen.emitStore(.x5, 8, .x8);
    const output = codegen.output.items;

    // Should contain "sd t0, 8(s0)"
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "sd"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "t0"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "s0"));
}

