/// RISC-V Code Generator - Step 2 Tests
/// Function prologue/epilogue, calling convention, and stack management
///
/// Tests:
/// 1-3: Function prologue (setup stack frame)
/// 4-6: Function epilogue (cleanup and return)
/// 7-9: Stack operations (load/store)
/// 10-12: Function calling convention (arguments and return values)

const std = @import("std");
const RiscvCodegen = @import("../src/riscv_codegen.zig").RiscvCodegen;
const Register = @import("../src/riscv_codegen.zig").Register;

test "RISC-V: function prologue (32-byte frame)" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = RiscvCodegen.init(allocator);
    defer codegen.deinit();

    try codegen.emitFunctionPrologue(32);
    const output = codegen.output.items;

    // Should contain stack adjustment
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "addi"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "sp"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "-32"));
}

