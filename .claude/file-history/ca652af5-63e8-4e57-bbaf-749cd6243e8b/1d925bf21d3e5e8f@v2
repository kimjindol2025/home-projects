test "RISC-V: calling convention - move args to a0-a7" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = RiscvCodegen.init(allocator);
    defer codegen.deinit();

    // Simulate passing arguments
    try codegen.emitMv(.x10, .x5); // a0 <- t0
    try codegen.emitMv(.x11, .x6); // a1 <- t1
    const output = codegen.output.items;

    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "a0"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "a1"));
}

