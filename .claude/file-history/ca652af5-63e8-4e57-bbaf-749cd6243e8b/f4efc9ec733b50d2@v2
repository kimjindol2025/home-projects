/// x86-64 Code Generator - Step 2 Tests
/// Function prologue/epilogue, calling convention, and stack management
///
/// Tests:
/// 1-3: Function prologue (push rbp, mov rbp rsp, sub rsp)
/// 4-5: Function epilogue (add rsp, pop rbp, ret)
/// 6-7: Stack operations (mov QWORD, memory access)
/// 8-11: Calling convention (argument registers: rdi, rsi, rdx, rcx, r8, r9)
/// 12: Frame size tracking
/// 13-14: Function label and call

const std = @import("std");
const X86_64Codegen = @import("../src/x86_64_codegen.zig").X86_64Codegen;
const Register = @import("../src/x86_64_codegen.zig").Register;

test "x86-64: function prologue (push rbp + mov rbp rsp)" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = X86_64Codegen.init(allocator);
    defer codegen.deinit();

    try codegen.emitFunctionPrologue(32);
    const output = codegen.output.items;

    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "push"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "rbp"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "mov"));
}

