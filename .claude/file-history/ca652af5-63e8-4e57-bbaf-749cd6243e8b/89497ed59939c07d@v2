test "stdlib_gen: generate emits all functions" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var gen = StdlibGen.init(allocator, .x86_64);
    defer gen.deinit();

    try gen.generate();
    const output = gen.output.items;

    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "std_print"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "std_exit"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "std_itoa"));
}

test "stdlib_gen: getBackendString returns architecture name" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var gen = StdlibGen.init(allocator, .riscv64);
