test "stdlib_gen: emitPrint x86_64 contains syscall" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var gen = StdlibGen.init(allocator, .x86_64);
    defer gen.deinit();

    try gen.emitPrint();
    const output = gen.output.items;

    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "syscall"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "std_print"));
}

