/// x86-64 Code Generator - Step 1 Tests
/// Basic arithmetic and integer operations (Intel syntax, NASM)
///
/// Tests:
/// 1-2: Move immediate (mov instruction)
/// 3: Move register
/// 4-6: Arithmetic operations (add, sub, imul)
/// 7: Division (idiv with cqo)
/// 8: Negation
/// 9-15: Comparison and set operations
/// 16: Return
/// 17-20: Infrastructure and patterns

const std = @import("std");
const X86_64Codegen = @import("../src/x86_64_codegen.zig").X86_64Codegen;
const Register = @import("../src/x86_64_codegen.zig").Register;

test "x86-64: emit move immediate (mov rax, 42)" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = X86_64Codegen.init(allocator);
    defer codegen.deinit();

    try codegen.emitMovImm(.rax, 42);
    const output = codegen.output.items;

    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "mov"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "rax"));
}

