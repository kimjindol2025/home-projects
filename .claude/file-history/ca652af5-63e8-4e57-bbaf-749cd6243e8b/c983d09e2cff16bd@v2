test "x86-64: register allocation (allocReg returns different regs)" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = X86_64Codegen.init(allocator);
    defer codegen.deinit();

    const reg1 = codegen.allocReg();
    try std.testing.expect(reg1 != null);

    const reg2 = codegen.allocReg();
    try std.testing.expect(reg2 != null);

    // Registers should be different
    try std.testing.expect(@intFromEnum(reg1.?) != @intFromEnum(reg2.?));

    codegen.freeReg(reg1.?);
    codegen.freeReg(reg2.?);
}

test "x86-64: register name mapping (rax, rbx, r8...)" {
    try std.testing.expectEqualStrings(Register.rax.name(), "rax");
    try std.testing.expectEqualStrings(Register.rbx.name(), "rbx");
    try std.testing.expectEqualStrings(Register.rdi.name(), "rdi");
    try std.testing.expectEqualStrings(Register.r8.name(), "r8");
}

