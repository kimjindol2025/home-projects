/// LLVM IR Code Generator
///
/// Generates LLVM Intermediate Representation (textual form).
/// - Architecture-independent IR
/// - Virtual registers: %0, %1, %2, ... (SSA form)
/// - Explicit types: i64, i1, void
/// - Use cases: optimization, backend selection, JIT
///
/// Output format:
/// define i64 @function_name(i64 %arg0, i64 %arg1) {
/// entry:
///     %0 = add i64 %arg0, %arg1
///     ret i64 %0
/// }

const std = @import("std");
const Allocator = std.mem.Allocator;

pub const LLVMIRCodegen = struct {
    allocator: Allocator,
    output: std.ArrayList(u8),
    vreg_counter: u32,      // Virtual register counter (%0, %1, %2, ...)
    label_counter: u32,     // Label counter (%L0, %L1, %L2, ...)
    current_frame_size: i64,

    pub fn init(allocator: Allocator) LLVMIRCodegen {
        return LLVMIRCodegen{
            .allocator = allocator,
            .output = std.ArrayList(u8).init(allocator),
            .vreg_counter = 0,
            .label_counter = 0,
            .current_frame_size = 0,
        };
    }

    pub fn deinit(self: *LLVMIRCodegen) void {
        self.output.deinit();
    }

    /// Emit a line of LLVM IR
    fn emit(self: *LLVMIRCodegen, comptime fmt: []const u8, args: anytype) !void {
        try self.output.writer().print(fmt ++ "\n", args);
    }

    /// Allocate a new virtual register
    fn allocVReg(self: *LLVMIRCodegen) u32 {
        const vreg = self.vreg_counter;
        self.vreg_counter += 1;
        return vreg;
    }

    /// Format virtual register reference
    fn vregRef(vreg: u32, buf: []u8) []const u8 {
        return std.fmt.bufPrint(buf, "%{}", .{vreg}) catch unreachable;
    }

    /// Generate unique label name
    pub fn newLabel(self: *LLVMIRCodegen, allocator: Allocator) ![]u8 {
        const label = try std.fmt.allocPrint(allocator, "%L{}", .{self.label_counter});
        self.label_counter += 1;
        return label;
    }

    // ========================================================================
    // Constants and Basic Operations
    // ========================================================================

    /// emit constant (represented as: %N = add i64 0, C)
    pub fn emitConst(self: *LLVMIRCodegen, value: i64) !u32 {
        const vreg = self.allocVReg();
        try self.emit("    %{} = add i64 0, {}", .{ vreg, value });
        return vreg;
    }

    /// emit add: %dst = add i64 %lhs, %rhs
    pub fn emitAdd(self: *LLVMIRCodegen, lhs: u32, rhs: u32) !u32 {
        const vreg = self.allocVReg();
        try self.emit("    %{} = add i64 %{}, %{}", .{ vreg, lhs, rhs });
        return vreg;
    }

    /// emit sub: %dst = sub i64 %lhs, %rhs
    pub fn emitSub(self: *LLVMIRCodegen, lhs: u32, rhs: u32) !u32 {
        const vreg = self.allocVReg();
        try self.emit("    %{} = sub i64 %{}, %{}", .{ vreg, lhs, rhs });
        return vreg;
    }

    /// emit mul: %dst = mul i64 %lhs, %rhs
    pub fn emitMul(self: *LLVMIRCodegen, lhs: u32, rhs: u32) !u32 {
        const vreg = self.allocVReg();
        try self.emit("    %{} = mul i64 %{}, %{}", .{ vreg, lhs, rhs });
        return vreg;
    }

    /// emit signed divide: %dst = sdiv i64 %lhs, %rhs
    pub fn emitSdiv(self: *LLVMIRCodegen, lhs: u32, rhs: u32) !u32 {
        const vreg = self.allocVReg();
        try self.emit("    %{} = sdiv i64 %{}, %{}", .{ vreg, lhs, rhs });
        return vreg;
    }

    /// emit signed remainder: %dst = srem i64 %lhs, %rhs
    pub fn emitSrem(self: *LLVMIRCodegen, lhs: u32, rhs: u32) !u32 {
        const vreg = self.allocVReg();
        try self.emit("    %{} = srem i64 %{}, %{}", .{ vreg, lhs, rhs });
        return vreg;
    }

    /// emit negate: %dst = sub i64 0, %src
    pub fn emitNeg(self: *LLVMIRCodegen, src: u32) !u32 {
        const vreg = self.allocVReg();
        try self.emit("    %{} = sub i64 0, %{}", .{ vreg, src });
        return vreg;
    }

    // ========================================================================
    // Comparisons
    // ========================================================================

    /// emit integer compare: %dst = icmp <cond> i64 %lhs, %rhs
    /// cond: "eq", "ne", "slt", "sle", "sgt", "sge"
    pub fn emitICmp(self: *LLVMIRCodegen, lhs: u32, rhs: u32, cond: []const u8) !u32 {
        const vreg = self.allocVReg();
        try self.emit("    %{} = icmp {s} i64 %{}, %{}", .{ vreg, cond, lhs, rhs });
        return vreg;
    }

    /// emit zero-extend: %dst = zext i1 %src to i64
    pub fn emitZext(self: *LLVMIRCodegen, src: u32) !u32 {
        const vreg = self.allocVReg();
        try self.emit("    %{} = zext i1 %{} to i64", .{ vreg, src });
        return vreg;
    }

    // ========================================================================
    // Control Flow
    // ========================================================================

    /// emit return: ret i64 %value
    pub fn emitRet(self: *LLVMIRCodegen, value: u32) !void {
        try self.emit("    ret i64 %{}", .{value});
    }

    /// emit return void
    pub fn emitRetVoid(self: *LLVMIRCodegen) !void {
        try self.emit("    ret void", .{});
    }

    /// emit unconditional branch: br label %label
    pub fn emitBr(self: *LLVMIRCodegen, label: []const u8) !void {
        try self.emit("    br label {s}", .{label});
    }

    /// emit conditional branch: br i1 %cond, label %true_label, label %false_label
    pub fn emitCondBr(self: *LLVMIRCodegen, cond: u32, true_label: []const u8, false_label: []const u8) !void {
        try self.emit("    br i1 %{}, label {s}, label {s}", .{ cond, true_label, false_label });
    }

    /// emit label: label_name:
    pub fn emitLabel(self: *LLVMIRCodegen, label: []const u8) !void {
        try self.emit("{s}:", .{label});
    }

    // ========================================================================
    // Functions
    // ========================================================================

    /// emit function start: define i64 @name(i64 %arg0, i64 %arg1, ...) {
    pub fn emitFunctionBegin(self: *LLVMIRCodegen, name: []const u8, arg_count: u32) !void {
        var args_str = std.ArrayList(u8).init(self.allocator);
        defer args_str.deinit();

        for (0..arg_count) |i| {
            if (i > 0) try args_str.appendSlice(", ");
            try std.fmt.format(args_str.writer(), "i64 %arg{}", .{i});
        }

        try self.emit("define i64 @{s}({s}) {{", .{ name, args_str.items });
        try self.emit("entry:", .{});
    }

    /// emit function end: }
    pub fn emitFunctionEnd(self: *LLVMIRCodegen) !void {
        try self.emit("}}", .{});
        try self.emit("", .{}); // blank line between functions
    }

    /// emit function call: %dst = call i64 @name(i64 %arg0, i64 %arg1, ...)
    pub fn emitCall(self: *LLVMIRCodegen, name: []const u8, args: []const u32) !u32 {
        var args_str = std.ArrayList(u8).init(self.allocator);
        defer args_str.deinit();

        for (args, 0..) |arg, i| {
            if (i > 0) try args_str.appendSlice(", ");
            try std.fmt.format(args_str.writer(), "i64 %{}", .{arg});
        }

        const vreg = self.allocVReg();
        try self.emit("    %{} = call i64 @{s}({s})", .{ vreg, name, args_str.items });
        return vreg;
    }

    // ========================================================================
    // Stack and Memory (Alloca, Load, Store) - for future use
    // ========================================================================

    /// emit alloca: %dst = alloca i64
    pub fn emitAlloca(self: *LLVMIRCodegen) !u32 {
        const vreg = self.allocVReg();
        try self.emit("    %{} = alloca i64", .{vreg});
        return vreg;
    }

    /// emit load: %dst = load i64, i64* %ptr
    pub fn emitLoad(self: *LLVMIRCodegen, ptr: u32) !u32 {
        const vreg = self.allocVReg();
        try self.emit("    %{} = load i64, i64* %{}", .{ vreg, ptr });
        return vreg;
    }

    /// emit store: store i64 %value, i64* %ptr
    pub fn emitStore(self: *LLVMIRCodegen, value: u32, ptr: u32) !void {
        try self.emit("    store i64 %{}, i64* %{}", .{ value, ptr });
    }
};
