## 출력 어셈블리 예시 (Intel syntax, NASM)

```asm
section .text
global add
add:
    push    rbp
    mov     rbp, rsp
    sub     rsp, 32
    mov     QWORD [rbp-8], rdi    ; a = arg0
    mov     QWORD [rbp-16], rsi   ; b = arg1
    mov     rax, QWORD [rbp-8]
    mov     r10, QWORD [rbp-16]
    add     rax, r10              ; a + b
    add     rsp, 32
    pop     rbp
    ret
```

