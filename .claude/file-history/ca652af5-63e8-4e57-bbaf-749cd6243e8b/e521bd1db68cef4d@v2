/// RISC-V Code Generator - Step 1 Tests
/// Basic arithmetic and integer operations
///
/// Tests:
/// 1-5: Integer literals (li instruction)
/// 6-10: Arithmetic operations (add, sub, mul, div, mod)
/// 11-15: Comparison operations (eq, ne, lt, le, gt)

const std = @import("std");
const RiscvCodegen = @import("../src/riscv_codegen.zig").RiscvCodegen;
const Register = @import("../src/riscv_codegen.zig").Register;

test "RISC-V: emit load immediate (li x5, 42)" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = RiscvCodegen.init(allocator);
    defer codegen.deinit();

    try codegen.emitLi(.x5, 42);
    const output = codegen.output.items;

    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "addi"));
}

