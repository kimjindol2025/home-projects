test "RISC-V: register allocation (allocReg)" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = RiscvCodegen.init(allocator);
    defer codegen.deinit();

    const reg1 = codegen.allocReg();
    try std.testing.expect(reg1 != null);

    const reg2 = codegen.allocReg();
    try std.testing.expect(reg2 != null);

    // Registers should be different
    try std.testing.expect(@intFromEnum(reg1.?) != @intFromEnum(reg2.?));

    codegen.freeReg(reg1.?);
    codegen.freeReg(reg2.?);
}

test "RISC-V: register name mapping (x0 -> x0, x10 -> a0)" {
    try std.testing.expectEqualStrings(Register.x0.name(), "x0");
    try std.testing.expectEqualStrings(Register.x1.name(), "ra");
    try std.testing.expectEqualStrings(Register.x10.name(), "a0");
    try std.testing.expectEqualStrings(Register.x5.name(), "t0");
}

