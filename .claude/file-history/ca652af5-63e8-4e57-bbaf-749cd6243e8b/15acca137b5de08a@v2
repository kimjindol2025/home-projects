/// Compiler Driver Tests - Platform-Specific Assembler & Linker Integration
///
/// Tests:
/// 1-3: Target initialization (x86_64, riscv64, arm64)
/// 4-6: getAssembler per target
/// 7: getLinker (always "ld")
/// 8-10: getAssemblerFlags per target
/// 11-13: getElfFormat per target
/// 14-15: getLinkerFormat / getTargetString

const std = @import("std");
const CompilerDriver = @import("../src/compiler_driver.zig").CompilerDriver;
const Target = @import("../src/compiler_driver.zig").Target;

test "compiler_driver: init x86_64 target" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var driver = CompilerDriver.init(allocator, .x86_64);
    try std.testing.expect(driver.target == .x86_64);
}

