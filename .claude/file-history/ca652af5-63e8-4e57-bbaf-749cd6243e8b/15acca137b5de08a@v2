test "compiler_driver: getAssemblerFlags x86_64 contains elf64" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var driver = CompilerDriver.init(allocator, .x86_64);
    const flags = driver.getAssemblerFlags();

    var found = false;
    for (flags) |flag| {
        if (std.mem.eql(u8, flag, "elf64")) {
            found = true;
            break;
        }
    }
    try std.testing.expect(found);
}

