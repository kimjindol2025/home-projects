## 출력 어셈블리 예시 (ARM64 GNU AS)

```asm
.text
.global add
add:
    stp     x29, x30, [sp, #-32]!
    mov     x29, sp
    str     x0, [x29, #-8]    // a = arg0
    str     x1, [x29, #-16]   // b = arg1
    ldr     x8, [x29, #-8]
    ldr     x9, [x29, #-16]
    add     x0, x8, x9        // a + b
    ldp     x29, x30, [sp], #32
    ret
```

