```bash
# ARM64 단계별 테스트
zig build arm64_basic_test
zig build arm64_function_test
zig build arm64_control_test

# 기존 회귀 확인
zig build riscv_basic_test
zig build x86_64_basic_test

# 전체 134개 테스트
zig build test

# CLI 확인
./zig-out/bin/zig-compiler --emit-arm64 test.zig -o test.s

# GNU AS 컴파일 (선택, Apple Silicon / Linux AArch64)
as -arch arm64 test.s -o test.o && ld test.o -o test
```
