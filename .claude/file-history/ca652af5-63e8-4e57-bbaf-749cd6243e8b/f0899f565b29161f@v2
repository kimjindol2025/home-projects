/// Linker E2E Tests - Binary Execution Verification
///
/// Tests:
/// 1-5: Linker initialization and output capture
/// 6-10: Binary execution and stdout validation
/// 11-15: Exit code verification and error handling

const std = @import("std");
const Linker = @import("../src/linker.zig").Linker;

test "linker: init allocates output buffer" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var linker = Linker.init(allocator);
    defer linker.deinit();

    try std.testing.expect(linker.output.items.len == 0);
}

test "linker: deinit frees resources" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var linker = Linker.init(allocator);
    linker.deinit();

    // No crash = success
    try std.testing.expect(true);
}

test "linker: getOutput returns empty on init" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var linker = Linker.init(allocator);
    defer linker.deinit();

    const output = linker.getOutput();
    try std.testing.expect(output.len == 0);
}

