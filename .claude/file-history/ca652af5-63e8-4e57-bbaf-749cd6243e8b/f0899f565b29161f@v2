test "linker: handle binary not found gracefully" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var linker = Linker.init(allocator);
    defer linker.deinit();

    // This should fail but not crash
    _ = linker.runBinary("/nonexistent/binary") catch {
        try std.testing.expect(true);
        return;
    };
}

test "linker: ignore stderr properly" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var linker = Linker.init(allocator);
    defer linker.deinit();

    try linker.runBinary("/bin/echo");
    const output = linker.getOutput();

    // stdout only, stderr ignored
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "\n") or output.len == 0);
}

