test "arm64: register allocation (allocReg returns different regs)" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = Arm64Codegen.init(allocator);
    defer codegen.deinit();

    const reg1 = codegen.allocReg();
    const reg2 = codegen.allocReg();
    const reg3 = codegen.allocReg();

    try std.testing.expect(reg1 != null);
    try std.testing.expect(reg2 != null);
    try std.testing.expect(reg3 != null);
    try std.testing.expect(reg1.? != reg2.?);
    try std.testing.expect(reg2.? != reg3.?);
}

