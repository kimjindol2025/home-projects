/// ARM64 Code Generator - Step 1 Tests
/// Basic arithmetic instructions: movz, mov, add, sub, mul, sdiv, msub, neg, cmp, cset, ret
///
/// Tests:
/// 1-3: Immediate loading (movz, small/large values)
/// 4-6: Register operations (mov, add, sub)
/// 7-8: Multiplication/division (mul, sdiv)
/// 9: Modulo pattern (msub)
/// 10: Negation (neg)
/// 11: Comparison (cmp)
/// 12-17: Conditional set (cset with eq/ne/lt/le/gt/ge)
/// 18: Return instruction
/// 19-20: Register allocation and output initialization

const std = @import("std");
const Arm64Codegen = @import("../src/arm64_codegen.zig").Arm64Codegen;
const Register = @import("../src/arm64_codegen.zig").Register;

test "arm64: emit movz immediate (movz x0, #42)" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = Arm64Codegen.init(allocator);
    defer codegen.deinit();

    try codegen.emitMovImm(.x0, 42);
    const output = codegen.output.items;

    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "movz"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "x0"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "#2a") or std.mem.containsAtLeast(u8, output, 1, "#42"));
}

