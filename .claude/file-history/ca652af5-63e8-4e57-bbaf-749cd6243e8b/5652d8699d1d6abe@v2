test "arm64: emit msub mod pattern (sdiv + msub)" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = Arm64Codegen.init(allocator);
    defer codegen.deinit();

    // a % b = a - (a/b)*b
    try codegen.emitSdiv(.x8, .x0, .x1);           // qtmp = a / b
    try codegen.emitMsub(.x0, .x8, .x1, .x0);      // result = a - qtmp*b
    const output = codegen.output.items;

    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "sdiv"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "msub"));
}

