/// Zig Compiler with Multi-Backend Support
///
/// Usage:
/// zig-compiler --emit-riscv input.zig -o output.s
/// zig-compiler --emit-x86-64 input.zig -o output.asm
/// zig-compiler --help
///
/// Pipeline:
/// Source (.zig) → Tokenizer → Parser (AST) → AstGen (ZIR) → Sema (AIR) → Codegen
///                                                                      ↓
///                                         ┌──────────────┬──────────────┐
///                                         ↓              ↓
///                                    RISC-V .s      x86-64 .asm

const std = @import("std");
const RiscvCodegen = @import("riscv_codegen.zig").RiscvCodegen;
const X86_64Codegen = @import("x86_64_codegen.zig").X86_64Codegen;
const Arm64Codegen = @import("arm64_codegen.zig").Arm64Codegen;
const LLVMIRCodegen = @import("llvm_ir_codegen.zig").LLVMIRCodegen;
const CompilerDriver = @import("compiler_driver.zig").CompilerDriver;
const StdlibGen = @import("stdlib_gen.zig").StdlibGen;

const Args = struct {
    input_file: ?[]const u8 = null,
    output_file: ?[]const u8 = null,
    emit_riscv: bool = false,
    emit_x86_64: bool = false,
    emit_arm64: bool = false,
    emit_llvm: bool = false,
    emit_c: bool = false,
    compile: bool = false,
    with_stdlib: bool = false,
    target: ?[]const u8 = null,
    help: bool = false,
};

fn printUsage(program_name: []const u8) void {
    std.debug.print(
        \\Usage: {s} [options] <input-file>
        \\
        \\Options:
        \\  -o, --output <file>      Output file path
        \\  --emit-riscv              Generate RISC-V assembly (.s)
        \\  --emit-x86-64             Generate x86-64 assembly (.asm, Intel syntax)
        \\  --emit-arm64              Generate ARM64 assembly (.s, GNU AS syntax)
        \\  --emit-llvm               Generate LLVM IR (.ll)
        \\  --emit-c                  Generate C code (.c) [default]
        \\  --compile                 Compile to executable (requires --target)
        \\  --stdlib                  Include standard library functions
        \\  --target <arch>           Target architecture (x86_64, riscv64, arm64)
        \\  -h, --help                Print this help message
        \\
        \\Examples:
        \\  {s} --emit-riscv test.zig -o test.s
        \\  {s} --emit-x86-64 test.zig -o test.asm
        \\  {s} --emit-arm64 test.zig -o test.s
        \\  {s} --emit-llvm test.zig -o test.ll
        \\  {s} --emit-x86-64 --compile --target x86_64 test.zig -o test
        \\
        \\Compiler Version: 0.9.0 (Phase 7-9: LLVM IR + Driver + Stdlib)
        \\
    , .{ program_name, program_name, program_name, program_name, program_name, program_name });
}

fn parseArgs(allocator: std.mem.Allocator, argv: [][]const u8) !Args {
    var args = Args{};
    var i: usize = 1; // Skip program name

    while (i < argv.len) : (i += 1) {
        const arg = argv[i];

        if (std.mem.eql(u8, arg, "--help") or std.mem.eql(u8, arg, "-h")) {
            args.help = true;
        } else if (std.mem.eql(u8, arg, "--emit-riscv")) {
            args.emit_riscv = true;
        } else if (std.mem.eql(u8, arg, "--emit-x86-64")) {
            args.emit_x86_64 = true;
        } else if (std.mem.eql(u8, arg, "--emit-arm64")) {
            args.emit_arm64 = true;
        } else if (std.mem.eql(u8, arg, "--emit-llvm")) {
            args.emit_llvm = true;
        } else if (std.mem.eql(u8, arg, "--emit-c")) {
            args.emit_c = true;
        } else if (std.mem.eql(u8, arg, "--compile")) {
            args.compile = true;
        } else if (std.mem.eql(u8, arg, "--stdlib")) {
            args.with_stdlib = true;
        } else if (std.mem.eql(u8, arg, "--target")) {
            i += 1;
            if (i < argv.len) {
                args.target = argv[i];
            } else {
                std.debug.print("Error: --target requires an argument\n", .{});
                return error.MissingArgument;
            }
        } else if (std.mem.eql(u8, arg, "-o") or std.mem.eql(u8, arg, "--output")) {
            i += 1;
            if (i < argv.len) {
                args.output_file = argv[i];
            } else {
                std.debug.print("Error: -o requires an argument\n", .{});
                return error.MissingArgument;
            }
        } else if (std.mem.startsWith(u8, arg, "-")) {
            std.debug.print("Error: Unknown option '{s}'\n", .{arg});
            return error.UnknownOption;
        } else {
            // Input file
            if (args.input_file == null) {
                args.input_file = arg;
            } else {
                std.debug.print("Error: Multiple input files not supported\n", .{});
                return error.MultipleInputFiles;
            }
        }
    }

    // Default to C emission if nothing specified
    if (!args.emit_riscv and !args.emit_x86_64 and !args.emit_arm64 and !args.emit_llvm and !args.compile) {
        args.emit_c = true;
    }

    return args;
}

fn readInputFile(allocator: std.mem.Allocator, path: []const u8) ![]u8 {
    const file = try std.fs.cwd().openFile(path, .{});
    defer file.close();

    const file_size = try file.getEndPos();
    const content = try allocator.alloc(u8, file_size);
    const bytes_read = try file.readAll(content);

    if (bytes_read != file_size) {
        return error.IncompleteRead;
    }

    return content;
}

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const stdout = std.io.getStdOut().writer();
    const stderr = std.io.getStdErr().writer();

    // Parse command line arguments
    const argv = try std.process.argsAlloc(allocator);
    defer std.process.argsFree(allocator, argv);

    const args = parseArgs(allocator, argv) catch |err| {
        try stderr.print("Error parsing arguments: {}\n", .{err});
        if (argv.len > 0) {
            printUsage(argv[0]);
        }
        return;
    };

    if (args.help) {
        if (argv.len > 0) {
            printUsage(argv[0]);
        }
        return;
    }

    if (args.input_file == null) {
        try stderr.print("Error: No input file specified\n", .{});
        if (argv.len > 0) {
            printUsage(argv[0]);
        }
        return;
    }

    const input_file = args.input_file.?;
    const output_file = args.output_file orelse "a.out";

    // Read input file
    const source = try readInputFile(allocator, input_file);
    defer allocator.free(source);

    try stdout.print("Zig Compiler v0.6.0 (Multi-Backend Phase)\n", .{});
    try stdout.print("Input: {s} ({} bytes)\n", .{ input_file, source.len });

    // ========================================================================
