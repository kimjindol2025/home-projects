/// LLVM IR Code Generator - Basic Tests
/// Tests for basic arithmetic, control flow, and function definitions
///
/// Tests:
/// 1-7: Basic arithmetic (const, add, sub, mul, sdiv, srem, neg)
/// 8-11: Integer comparisons (eq, ne, slt, sge)
/// 12: Zero-extend (i1 to i64)
/// 13: Return instruction
/// 14-15: Branches (unconditional, conditional)
/// 16: Labels
/// 17-18: Function begin/end
/// 19: Function call
/// 20: Virtual register counter

const std = @import("std");
const LLVMIRCodegen = @import("../src/llvm_ir_codegen.zig").LLVMIRCodegen;

test "llvm_ir: emit const (add i64 0, 42)" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = LLVMIRCodegen.init(allocator);
    defer codegen.deinit();

    _ = try codegen.emitConst(42);
    const output = codegen.output.items;

    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "add i64 0"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "42"));
}

