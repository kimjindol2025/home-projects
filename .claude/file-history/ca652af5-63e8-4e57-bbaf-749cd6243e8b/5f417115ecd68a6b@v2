test "llvm_ir: virtual register counter (sequential %0, %1, %2)" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = LLVMIRCodegen.init(allocator);
    defer codegen.deinit();

    const v0 = try codegen.emitConst(10);
    const v1 = try codegen.emitConst(20);
    const v2 = try codegen.emitAdd(v0, v1);

    try std.testing.expect(v0 == 0);
    try std.testing.expect(v1 == 1);
    try std.testing.expect(v2 == 2);
}
