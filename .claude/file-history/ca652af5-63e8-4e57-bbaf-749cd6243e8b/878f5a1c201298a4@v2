test "RISC-V: emit label" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = RiscvCodegen.init(allocator);
    defer codegen.deinit();

    const label = try codegen.newLabel(allocator);
    defer allocator.free(label);

    try codegen.emitLabel(label);
    const output = codegen.output.items;

    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, ".L0"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, ":"));
}

