test "RISC-V: if/else pattern" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = RiscvCodegen.init(allocator);
    defer codegen.deinit();

    const else_label = try codegen.newLabel(allocator);
    defer allocator.free(else_label);
    const end_label = try codegen.newLabel(allocator);
    defer allocator.free(end_label);

    // if (cond == 0) goto else
    try codegen.emitBeqz(.x5, else_label);

    // then block
    try codegen.emitMv(.x10, .x6);
    try codegen.emitJump(end_label);

    // else block
    try codegen.emitLabel(else_label);
    try codegen.emitMv(.x10, .x7);

    // end
    try codegen.emitLabel(end_label);

    const output = codegen.output.items;
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "beq"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "j"));
}

test "RISC-V: while loop pattern" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = RiscvCodegen.init(allocator);
    defer codegen.deinit();

    const loop_label = try codegen.newLabel(allocator);
    defer allocator.free(loop_label);
    const end_label = try codegen.newLabel(allocator);
    defer allocator.free(end_label);

    // loop_start:
    try codegen.emitLabel(loop_label);

    // if (cond == 0) goto loop_end
    try codegen.emitBeqz(.x5, end_label);

    // loop body
    try codegen.emitAdd(.x6, .x6, .x7);

    // j loop_start
    try codegen.emitJump(loop_label);

    // loop_end:
    try codegen.emitLabel(end_label);

    const output = codegen.output.items;
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "beq"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "j"));
}

