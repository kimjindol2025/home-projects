/// RISC-V Code Generator - Step 3 Tests
/// Control flow instructions: branches, loops, break/continue
///
/// Tests:
/// 1-4: Label generation and emission
/// 5-7: Unconditional jumps
/// 8-10: Conditional branches (beqz, bnez)
/// 11-13: Loop patterns

const std = @import("std");
const RiscvCodegen = @import("../src/riscv_codegen.zig").RiscvCodegen;
const Register = @import("../src/riscv_codegen.zig").Register;

test "RISC-V: label generation .L0" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = RiscvCodegen.init(allocator);
    defer codegen.deinit();

    const label1 = try codegen.newLabel(allocator);
    defer allocator.free(label1);

    try std.testing.expectEqualStrings(label1, ".L0");
}

