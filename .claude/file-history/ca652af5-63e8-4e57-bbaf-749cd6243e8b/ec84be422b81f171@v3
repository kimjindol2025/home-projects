/// Standard Library Generator - Linux Syscall-Based Built-in Functions
///
/// Generates architecture-specific assembly code for standard library functions.
/// Supports: x86-64, RISC-V, ARM64
///
/// Functions:
/// - std_print(ptr, len): write syscall - output bytes to stdout
/// - std_exit(code): exit syscall - terminate program
/// - std_itoa(n, buf): convert integer to ASCII string
/// - std_strlen(str): calculate string length
/// - std_puts(str): print string with newline
/// - std_putchar(c): print single character
/// - std_atoi(str): convert string to integer
///
/// Linux Syscall Numbers:
/// | Function | x86-64 | ARM64 | RISC-V |
/// |----------|--------|-------|--------|
/// | write    | 1      | 64    | 64     |
/// | exit     | 60     | 93    | 93     |

const std = @import("std");
const Allocator = std.mem.Allocator;

pub const Backend = enum {
    x86_64,
    riscv64,
    arm64,
};

pub const StdlibGen = struct {
    allocator: Allocator,
    backend: Backend,
    output: std.ArrayList(u8),

    pub fn init(allocator: Allocator, backend: Backend) StdlibGen {
        return StdlibGen{
            .allocator = allocator,
            .backend = backend,
            .output = std.ArrayList(u8).init(allocator),
        };
    }

    pub fn deinit(self: *StdlibGen) void {
        self.output.deinit();
    }

    /// Emit a line of assembly
    fn emit(self: *StdlibGen, comptime fmt: []const u8, args: anytype) !void {
        try self.output.writer().print(fmt ++ "\n", args);
    }

    /// Generate all standard library functions
    pub fn generate(self: *StdlibGen) !void {
        try self.emitPrint();
        try self.emit("", .{});
        try self.emitExit();
        try self.emit("", .{});
        try self.emitItoa();
        try self.emit("", .{});
        try self.emitStrlen();
        try self.emit("", .{});
        try self.emitPutchar();
        try self.emit("", .{});
        try self.emitPuts();
        try self.emit("", .{});
        try self.emitAtoi();
    }

    /// Generate std_print(ptr, len) - write syscall
    /// Signature: void std_print(void *ptr, int len)
    /// Arguments: ptr in rdi (x86), x0 (ARM64), a0 (RISC-V); len in rsi (x86), x1 (ARM64), a1 (RISC-V)
    pub fn emitPrint(self: *StdlibGen) !void {
        switch (self.backend) {
            .x86_64 => {
                try self.emit(".globl std_print", .{});
                try self.emit("std_print:", .{});
                try self.emit("    push rbp", .{});
                try self.emit("    mov rbp, rsp", .{});
                try self.emit("    mov rax, 1          ; sys_write", .{});
                try self.emit("    mov rdi, 1          ; fd = stdout", .{});
                try self.emit("    ; rsi = ptr (arg0), rdx = len (arg1)", .{});
                try self.emit("    syscall", .{});
                try self.emit("    pop rbp", .{});
                try self.emit("    ret", .{});
            },
            .arm64 => {
                try self.emit(".globl std_print", .{});
                try self.emit("std_print:", .{});
                try self.emit("    stp x29, x30, [sp, #-16]!", .{});
                try self.emit("    mov x29, sp", .{});
                try self.emit("    mov x8, #64         ; sys_write", .{});
                try self.emit("    mov x0, #1          ; fd = stdout", .{});
                try self.emit("    ; x1 = ptr (arg0), x2 = len (arg1)", .{});
                try self.emit("    svc #0              ; syscall", .{});
                try self.emit("    ldp x29, x30, [sp], #16", .{});
                try self.emit("    ret", .{});
            },
            .riscv64 => {
                try self.emit(".globl std_print", .{});
                try self.emit("std_print:", .{});
                try self.emit("    addi sp, sp, -32", .{});
                try self.emit("    sd ra, 24(sp)", .{});
                try self.emit("    sd s0, 16(sp)", .{});
                try self.emit("    li a7, 64           ; sys_write", .{});
                try self.emit("    li a0, 1            ; fd = stdout", .{});
                try self.emit("    ; a1 = ptr (arg0), a2 = len (arg1)", .{});
                try self.emit("    ecall", .{});
                try self.emit("    ld s0, 16(sp)", .{});
                try self.emit("    ld ra, 24(sp)", .{});
                try self.emit("    addi sp, sp, 32", .{});
                try self.emit("    ret", .{});
            },
        }
    }

    /// Generate std_exit(code) - exit syscall
    /// Signature: void std_exit(int code)
    /// Arguments: code in rdi (x86), x0 (ARM64), a0 (RISC-V)
    pub fn emitExit(self: *StdlibGen) !void {
        switch (self.backend) {
            .x86_64 => {
                try self.emit(".globl std_exit", .{});
                try self.emit("std_exit:", .{});
                try self.emit("    mov rax, 60         ; sys_exit", .{});
                try self.emit("    ; rdi = code (arg0)", .{});
                try self.emit("    syscall", .{});
                try self.emit("    ; unreachable", .{});
            },
            .arm64 => {
                try self.emit(".globl std_exit", .{});
                try self.emit("std_exit:", .{});
                try self.emit("    mov x8, #93         ; sys_exit", .{});
                try self.emit("    ; x0 = code (arg0)", .{});
                try self.emit("    svc #0              ; syscall", .{});
                try self.emit("    ; unreachable", .{});
            },
            .riscv64 => {
                try self.emit(".globl std_exit", .{});
                try self.emit("std_exit:", .{});
                try self.emit("    li a7, 93           ; sys_exit", .{});
                try self.emit("    ; a0 = code (arg0)", .{});
                try self.emit("    ecall", .{});
                try self.emit("    ; unreachable", .{});
            },
        }
    }

    /// Generate std_itoa(n, buf) - convert integer to ASCII string
    /// Simple implementation: handles 0-9 digits + negative sign
    /// This is a placeholder; full implementation would handle large numbers
    pub fn emitItoa(self: *StdlibGen) !void {
        switch (self.backend) {
            .x86_64 => {
                try self.emit(".globl std_itoa", .{});
                try self.emit("std_itoa:", .{});
                try self.emit("    push rbp", .{});
                try self.emit("    mov rbp, rsp", .{});
                try self.emit("    ; rdi = n (arg0), rsi = buf (arg1)", .{});
                try self.emit("    ; simple version: convert single digit", .{});
                try self.emit("    cmp rdi, 0", .{});
                try self.emit("    jge .L_positive", .{});
                try self.emit("    mov byte [rsi], 45  ; '-'", .{});
                try self.emit("    neg rdi", .{});
                try self.emit("    mov rsi, rsi + 1", .{});
                try self.emit(".L_positive:", .{});
                try self.emit("    add rdi, 48         ; '0'", .{});
                try self.emit("    mov byte [rsi], dil", .{});
                try self.emit("    mov byte [rsi + 1], 0", .{});
                try self.emit("    pop rbp", .{});
                try self.emit("    ret", .{});
            },
            .arm64 => {
                try self.emit(".globl std_itoa", .{});
                try self.emit("std_itoa:", .{});
                try self.emit("    stp x29, x30, [sp, #-16]!", .{});
                try self.emit("    mov x29, sp", .{});
                try self.emit("    ; x0 = n (arg0), x1 = buf (arg1)", .{});
                try self.emit("    cmp x0, 0", .{});
                try self.emit("    b.ge .L_arm_positive", .{});
                try self.emit("    mov w2, 45          ; '-'", .{});
                try self.emit("    strb w2, [x1]", .{});
                try self.emit("    neg x0, x0", .{});
                try self.emit("    add x1, x1, 1", .{});
                try self.emit(".L_arm_positive:", .{});
                try self.emit("    add w0, w0, 48      ; '0'", .{});
                try self.emit("    strb w0, [x1]", .{});
                try self.emit("    mov w2, 0", .{});
                try self.emit("    strb w2, [x1, 1]", .{});
                try self.emit("    ldp x29, x30, [sp], #16", .{});
                try self.emit("    ret", .{});
            },
            .riscv64 => {
                try self.emit(".globl std_itoa", .{});
                try self.emit("std_itoa:", .{});
                try self.emit("    addi sp, sp, -32", .{});
                try self.emit("    sd ra, 24(sp)", .{});
                try self.emit("    sd s0, 16(sp)", .{});
                try self.emit("    ; a0 = n (arg0), a1 = buf (arg1)", .{});
                try self.emit("    bge a0, zero, .L_riscv_positive", .{});
                try self.emit("    li a2, 45           ; '-'", .{});
                try self.emit("    sb a2, 0(a1)", .{});
                try self.emit("    neg a0, a0", .{});
                try self.emit("    addi a1, a1, 1", .{});
                try self.emit(".L_riscv_positive:", .{});
                try self.emit("    addi a0, a0, 48     ; '0'", .{});
                try self.emit("    sb a0, 0(a1)", .{});
                try self.emit("    sb zero, 1(a1)", .{});
                try self.emit("    ld s0, 16(sp)", .{});
                try self.emit("    ld ra, 24(sp)", .{});
                try self.emit("    addi sp, sp, 32", .{});
                try self.emit("    ret", .{});
            },
        }
    }

    /// Generate std_strlen(str) - calculate string length
    /// Signature: int std_strlen(char *str)
    /// Arguments: str in rdi (x86), x0 (ARM64), a0 (RISC-V)
    pub fn emitStrlen(self: *StdlibGen) !void {
        switch (self.backend) {
            .x86_64 => {
                try self.emit(".globl std_strlen", .{});
                try self.emit("std_strlen:", .{});
                try self.emit("    xor rax, rax        ; len = 0", .{});
                try self.emit(".L_strlen_loop:", .{});
                try self.emit("    cmp byte [rdi], 0   ; check null terminator", .{});
                try self.emit("    je .L_strlen_done", .{});
                try self.emit("    inc rax", .{});
                try self.emit("    inc rdi", .{});
                try self.emit("    jmp .L_strlen_loop", .{});
                try self.emit(".L_strlen_done:", .{});
                try self.emit("    ret", .{});
            },
            .arm64 => {
                try self.emit(".globl std_strlen", .{});
                try self.emit("std_strlen:", .{});
                try self.emit("    mov x1, 0           ; len = 0", .{});
                try self.emit(".L_strlen_loop:", .{});
                try self.emit("    ldrb w2, [x0]       ; load byte", .{});
                try self.emit("    cmp w2, 0           ; check null terminator", .{});
                try self.emit("    b.eq .L_strlen_done", .{});
                try self.emit("    add x1, x1, 1", .{});
                try self.emit("    add x0, x0, 1", .{});
                try self.emit("    b .L_strlen_loop", .{});
                try self.emit(".L_strlen_done:", .{});
                try self.emit("    mov x0, x1          ; return len", .{});
                try self.emit("    ret", .{});
            },
            .riscv64 => {
                try self.emit(".globl std_strlen", .{});
                try self.emit("std_strlen:", .{});
                try self.emit("    li a1, 0            ; len = 0", .{});
                try self.emit(".L_strlen_loop:", .{});
                try self.emit("    lbu a2, 0(a0)       ; load byte", .{});
                try self.emit("    beq a2, zero, .L_strlen_done", .{});
                try self.emit("    addi a1, a1, 1", .{});
                try self.emit("    addi a0, a0, 1", .{});
                try self.emit("    jal zero, .L_strlen_loop", .{});
                try self.emit(".L_strlen_done:", .{});
                try self.emit("    addi a0, a1, 0      ; return len", .{});
                try self.emit("    ret", .{});
            },
        }
    }

    /// Generate std_putchar(c) - print single character
    /// Signature: void std_putchar(char c)
    /// Arguments: c in rdi (x86), w0 (ARM64), a0 (RISC-V)
    pub fn emitPutchar(self: *StdlibGen) !void {
        switch (self.backend) {
            .x86_64 => {
                try self.emit(".globl std_putchar", .{});
                try self.emit("std_putchar:", .{});
                try self.emit("    push rbp", .{});
                try self.emit("    mov rbp, rsp", .{});
                try self.emit("    sub rsp, 8", .{});
                try self.emit("    mov byte [rsp], dil ; store char", .{});
                try self.emit("    mov rax, 1          ; sys_write", .{});
                try self.emit("    mov rdi, 1          ; fd = stdout", .{});
                try self.emit("    mov rsi, rsp        ; buffer", .{});
                try self.emit("    mov rdx, 1          ; len = 1", .{});
                try self.emit("    syscall", .{});
                try self.emit("    add rsp, 8", .{});
                try self.emit("    pop rbp", .{});
                try self.emit("    ret", .{});
            },
            .arm64 => {
                try self.emit(".globl std_putchar", .{});
                try self.emit("std_putchar:", .{});
                try self.emit("    stp x29, x30, [sp, #-32]!", .{});
                try self.emit("    mov x29, sp", .{});
                try self.emit("    strb w0, [sp, #16]  ; store char", .{});
                try self.emit("    mov x8, #64         ; sys_write", .{});
                try self.emit("    mov x0, #1          ; fd = stdout", .{});
                try self.emit("    add x1, sp, 16      ; buffer", .{});
                try self.emit("    mov x2, #1          ; len = 1", .{});
                try self.emit("    svc #0", .{});
                try self.emit("    ldp x29, x30, [sp], #32", .{});
                try self.emit("    ret", .{});
            },
            .riscv64 => {
                try self.emit(".globl std_putchar", .{});
                try self.emit("std_putchar:", .{});
                try self.emit("    addi sp, sp, -16", .{});
                try self.emit("    sb a0, 0(sp)        ; store char", .{});
                try self.emit("    li a7, 64           ; sys_write", .{});
                try self.emit("    li a0, 1            ; fd = stdout", .{});
                try self.emit("    mv a1, sp           ; buffer", .{});
                try self.emit("    li a2, 1            ; len = 1", .{});
                try self.emit("    ecall", .{});
                try self.emit("    addi sp, sp, 16", .{});
                try self.emit("    ret", .{});
            },
        }
    }

    /// Generate std_puts(str) - print string with newline
    /// Signature: void std_puts(char *str)
    /// Arguments: str in rdi (x86), x0 (ARM64), a0 (RISC-V)
    pub fn emitPuts(self: *StdlibGen) !void {
        switch (self.backend) {
            .x86_64 => {
                try self.emit(".globl std_puts", .{});
                try self.emit("std_puts:", .{});
                try self.emit("    push rbp", .{});
                try self.emit("    mov rbp, rsp", .{});
                try self.emit("    mov rsi, rdi        ; save str pointer", .{});
                try self.emit("    xor rcx, rcx        ; len = 0", .{});
                try self.emit(".L_puts_strlen:", .{});
                try self.emit("    cmp byte [rsi + rcx], 0", .{});
                try self.emit("    je .L_puts_print", .{});
                try self.emit("    inc rcx", .{});
                try self.emit("    jmp .L_puts_strlen", .{});
                try self.emit(".L_puts_print:", .{});
                try self.emit("    mov rax, 1          ; sys_write", .{});
                try self.emit("    mov rdi, 1          ; fd = stdout", .{});
                try self.emit("    mov rdx, rcx        ; len", .{});
                try self.emit("    syscall", .{});
                try self.emit("    mov rax, 1          ; write newline", .{});
                try self.emit("    mov byte [rsp-1], 10", .{});
                try self.emit("    mov rsi, rsp-1", .{});
                try self.emit("    mov rdx, 1", .{});
                try self.emit("    syscall", .{});
                try self.emit("    pop rbp", .{});
                try self.emit("    ret", .{});
            },
            .arm64 => {
                try self.emit(".globl std_puts", .{});
                try self.emit("std_puts:", .{});
                try self.emit("    stp x29, x30, [sp, #-32]!", .{});
                try self.emit("    mov x29, sp", .{});
                try self.emit("    mov x1, x0          ; save str", .{});
                try self.emit("    mov x2, 0           ; len = 0", .{});
                try self.emit(".L_puts_strlen:", .{});
                try self.emit("    ldrb w3, [x1, x2]", .{});
                try self.emit("    cbz w3, .L_puts_print", .{});
                try self.emit("    add x2, x2, 1", .{});
                try self.emit("    b .L_puts_strlen", .{});
                try self.emit(".L_puts_print:", .{});
                try self.emit("    mov x8, #64         ; sys_write", .{});
                try self.emit("    mov x0, #1          ; fd = stdout", .{});
                try self.emit("    syscall", .{});
                try self.emit("    mov x8, #64", .{});
                try self.emit("    mov x1, sp", .{});
                try self.emit("    mov w2, #10         ; newline", .{});
                try self.emit("    strb w2, [x1]", .{});
                try self.emit("    mov x2, #1          ; len = 1", .{});
                try self.emit("    syscall", .{});
                try self.emit("    ldp x29, x30, [sp], #32", .{});
                try self.emit("    ret", .{});
            },
            .riscv64 => {
                try self.emit(".globl std_puts", .{});
                try self.emit("std_puts:", .{});
                try self.emit("    addi sp, sp, -32", .{});
                try self.emit("    sd ra, 24(sp)", .{});
                try self.emit("    mv a1, a0           ; save str", .{});
                try self.emit("    li a2, 0            ; len = 0", .{});
                try self.emit(".L_puts_strlen:", .{});
                try self.emit("    add a3, a1, a2", .{});
                try self.emit("    lbu a4, 0(a3)", .{});
                try self.emit("    beq a4, zero, .L_puts_print", .{});
                try self.emit("    addi a2, a2, 1", .{});
                try self.emit("    jal zero, .L_puts_strlen", .{});
                try self.emit(".L_puts_print:", .{});
                try self.emit("    li a7, 64           ; sys_write", .{});
                try self.emit("    li a0, 1            ; fd = stdout", .{});
                try self.emit("    ecall", .{});
                try self.emit("    li a7, 64", .{});
                try self.emit("    mv a1, sp", .{});
                try self.emit("    li a2, 10           ; newline", .{});
                try self.emit("    sb a2, 0(a1)", .{});
                try self.emit("    li a2, 1            ; len = 1", .{});
                try self.emit("    ecall", .{});
                try self.emit("    ld ra, 24(sp)", .{});
                try self.emit("    addi sp, sp, 32", .{});
                try self.emit("    ret", .{});
            },
        }
    }

    /// Generate std_atoi(str) - convert string to integer
    /// Signature: int std_atoi(char *str)
    /// Arguments: str in rdi (x86), x0 (ARM64), a0 (RISC-V)
    pub fn emitAtoi(self: *StdlibGen) !void {
        switch (self.backend) {
            .x86_64 => {
                try self.emit(".globl std_atoi", .{});
                try self.emit("std_atoi:", .{});
                try self.emit("    xor rax, rax        ; result = 0", .{});
                try self.emit("    xor rcx, rcx        ; sign = 1 (in rcx)", .{});
                try self.emit("    mov rcx, 1", .{});
                try self.emit("    cmp byte [rdi], 45  ; check '-'", .{});
                try self.emit("    jne .L_atoi_loop", .{});
                try self.emit("    mov rcx, -1", .{});
                try self.emit("    inc rdi", .{});
                try self.emit(".L_atoi_loop:", .{});
                try self.emit("    movzx rdx, byte [rdi]", .{});
                try self.emit("    cmp rdx, 48         ; '0'", .{});
                try self.emit("    jl .L_atoi_done", .{});
                try self.emit("    cmp rdx, 57         ; '9'", .{});
                try self.emit("    jg .L_atoi_done", .{});
                try self.emit("    imul rax, 10", .{});
                try self.emit("    sub rdx, 48", .{});
                try self.emit("    add rax, rdx", .{});
                try self.emit("    inc rdi", .{});
                try self.emit("    jmp .L_atoi_loop", .{});
                try self.emit(".L_atoi_done:", .{});
                try self.emit("    imul rax, rcx       ; apply sign", .{});
                try self.emit("    ret", .{});
            },
            .arm64 => {
                try self.emit(".globl std_atoi", .{});
                try self.emit("std_atoi:", .{});
                try self.emit("    mov x1, 0           ; result = 0", .{});
                try self.emit("    mov x2, 1           ; sign = 1", .{});
                try self.emit("    ldrb w3, [x0]       ; load first char", .{});
                try self.emit("    cmp w3, 45          ; check '-'", .{});
                try self.emit("    b.ne .L_atoi_loop", .{});
                try self.emit("    mov x2, -1", .{});
                try self.emit("    add x0, x0, 1", .{});
                try self.emit(".L_atoi_loop:", .{});
                try self.emit("    ldrb w3, [x0]       ; load char", .{});
                try self.emit("    cmp w3, 48          ; '0'", .{});
                try self.emit("    b.lt .L_atoi_done", .{});
                try self.emit("    cmp w3, 57          ; '9'", .{});
                try self.emit("    b.gt .L_atoi_done", .{});
                try self.emit("    mov w4, 10", .{});
                try self.emit("    mul x1, x1, x4      ; result *= 10", .{});
                try self.emit("    sub w3, w3, 48", .{});
                try self.emit("    add x1, x1, x3      ; result += digit", .{});
                try self.emit("    add x0, x0, 1", .{});
                try self.emit("    b .L_atoi_loop", .{});
                try self.emit(".L_atoi_done:", .{});
                try self.emit("    mul x0, x1, x2      ; apply sign", .{});
                try self.emit("    ret", .{});
            },
            .riscv64 => {
                try self.emit(".globl std_atoi", .{});
                try self.emit("std_atoi:", .{});
                try self.emit("    li a1, 0            ; result = 0", .{});
                try self.emit("    li a2, 1            ; sign = 1", .{});
                try self.emit("    lbu a3, 0(a0)       ; load first char", .{});
                try self.emit("    li a4, 45           ; '-'", .{});
                try self.emit("    bne a3, a4, .L_atoi_loop", .{});
                try self.emit("    li a2, -1", .{});
                try self.emit("    addi a0, a0, 1", .{});
                try self.emit(".L_atoi_loop:", .{});
                try self.emit("    lbu a3, 0(a0)       ; load char", .{});
                try self.emit("    li a4, 48           ; '0'", .{});
                try self.emit("    blt a3, a4, .L_atoi_done", .{});
                try self.emit("    li a4, 57           ; '9'", .{});
                try self.emit("    bgt a3, a4, .L_atoi_done", .{});
                try self.emit("    li a5, 10", .{});
                try self.emit("    mul a1, a1, a5      ; result *= 10", .{});
                try self.emit("    addi a3, a3, -48", .{});
                try self.emit("    add a1, a1, a3      ; result += digit", .{});
                try self.emit("    addi a0, a0, 1", .{});
                try self.emit("    jal zero, .L_atoi_loop", .{});
                try self.emit(".L_atoi_done:", .{});
                try self.emit("    mul a0, a1, a2      ; apply sign", .{});
                try self.emit("    ret", .{});
            },
        }
    }

    /// Get backend architecture string
    pub fn getBackendString(self: StdlibGen) []const u8 {
        return switch (self.backend) {
            .x86_64 => "x86_64",
            .riscv64 => "riscv64",
            .arm64 => "arm64",
        };
    }
};
