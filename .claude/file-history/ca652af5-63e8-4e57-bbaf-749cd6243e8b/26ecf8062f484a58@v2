/// ARM64 Code Generator - Step 3 Tests
/// Control flow instructions: branches, labels, conditional jumps
///
/// Tests:
/// 1-4: Label generation and emission
/// 5: Unconditional branch (b)
/// 6-9: Conditional branches (b.eq, b.ne, b.lt, b.ge)
/// 10-11: Zero comparisons (cbz, cbnz)
/// 12-13: Control flow patterns (if/else, while, nested)

const std = @import("std");
const Arm64Codegen = @import("../src/arm64_codegen.zig").Arm64Codegen;
const Register = @import("../src/arm64_codegen.zig").Register;

test "arm64: label generation .L0" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = Arm64Codegen.init(allocator);
    defer codegen.deinit();

    const label1 = try codegen.newLabel(allocator);
    defer allocator.free(label1);

    try std.testing.expectEqualStrings(label1, ".L0");
}

