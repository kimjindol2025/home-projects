test "arm64: if/else pattern (cmp + b.eq + b)" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = Arm64Codegen.init(allocator);
    defer codegen.deinit();

    const else_label = try codegen.newLabel(allocator);
    defer allocator.free(else_label);
    const end_label = try codegen.newLabel(allocator);
    defer allocator.free(end_label);

    // if (x0 != x1) goto else
    try codegen.emitCmp(.x0, .x1);
    try codegen.emitBEq(else_label);

    // then block
    try codegen.emitMov(.x0, .x2);
    try codegen.emitB(end_label);

    // else block
    try codegen.emitLabel(else_label);
    try codegen.emitMov(.x0, .x3);

    // end
    try codegen.emitLabel(end_label);

    const output = codegen.output.items;
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "cmp"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "b.eq"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "b "));
}

test "arm64: while loop pattern (cbz + b)" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = Arm64Codegen.init(allocator);
    defer codegen.deinit();

    const loop_label = try codegen.newLabel(allocator);
    defer allocator.free(loop_label);
    const end_label = try codegen.newLabel(allocator);
    defer allocator.free(end_label);

    // loop_start:
    try codegen.emitLabel(loop_label);

    // if (x0 == 0) goto end
    try codegen.emitCbz(.x0, end_label);

    // loop body
    try codegen.emitAdd(.x1, .x1, .x2);

    // b loop_start
    try codegen.emitB(loop_label);

    // end:
    try codegen.emitLabel(end_label);

    const output = codegen.output.items;
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "cbz"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "b "));
}

test "arm64: nested branches multiple labels" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = Arm64Codegen.init(allocator);
    defer codegen.deinit();

    const else1 = try codegen.newLabel(allocator);
    defer allocator.free(else1);
    const else2 = try codegen.newLabel(allocator);
    defer allocator.free(else2);
    const end = try codegen.newLabel(allocator);
    defer allocator.free(end);

    // if (x0 == 0) goto else1
    try codegen.emitCbz(.x0, else1);
    try codegen.emitMov(.x0, .x1);
    try codegen.emitB(end);

    // else1: if (x1 == 0) goto else2
    try codegen.emitLabel(else1);
    try codegen.emitCbz(.x1, else2);
    try codegen.emitMov(.x0, .x2);
    try codegen.emitB(end);

    // else2:
    try codegen.emitLabel(else2);
    try codegen.emitMov(.x0, .x3);

    // end:
    try codegen.emitLabel(end);

    const output = codegen.output.items;
    try std.testing.expect(output.len > 0);
}
