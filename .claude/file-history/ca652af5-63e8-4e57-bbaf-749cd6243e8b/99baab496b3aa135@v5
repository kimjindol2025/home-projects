/// Build configuration for Zig Compiler with RISC-V backend
///
/// Compile targets:
/// - zig build: build compiler binary
/// - zig build test: run all tests
/// - zig build riscv_basic_test: run basic arithmetic tests
/// - zig build riscv_function_test: run function/calling convention tests
/// - zig build riscv_control_test: run control flow tests

const std = @import("std");

pub fn build(b: *std.Build) void {
    const target = b.standardTargetOptions(.{});
    const optimize = b.standardOptimizeOption(.{});

    // ========================================================================
    // Main Compiler Library
    // ========================================================================

    const riscv_codegen_lib = b.addStaticLibrary(.{
        .name = "riscv_codegen",
        .root_source_file = b.path("src/riscv_codegen.zig"),
        .target = target,
        .optimize = optimize,
    });

    const riscv_codegen_module = b.addModule("riscv_codegen", .{
        .root_source_file = b.path("src/riscv_codegen.zig"),
    });

    const x86_64_codegen_module = b.addModule("x86_64_codegen", .{
        .root_source_file = b.path("src/x86_64_codegen.zig"),
    });

    const arm64_codegen_module = b.addModule("arm64_codegen", .{
        .root_source_file = b.path("src/arm64_codegen.zig"),
    });

    const llvm_ir_codegen_module = b.addModule("llvm_ir_codegen", .{
        .root_source_file = b.path("src/llvm_ir_codegen.zig"),
    });

    const compiler_driver_module = b.addModule("compiler_driver", .{
        .root_source_file = b.path("src/compiler_driver.zig"),
    });

    const stdlib_gen_module = b.addModule("stdlib_gen", .{
        .root_source_file = b.path("src/stdlib_gen.zig"),
    });

    // ========================================================================
    // RISC-V Step 1: Basic Arithmetic Tests (15 tests)
    // ========================================================================

    const riscv_basic_test_exe = b.addTest(.{
        .root_source_file = b.path("test/riscv_basic_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    riscv_basic_test_exe.root_module.addImport("riscv_codegen", riscv_codegen_module);

    const run_riscv_basic_test = b.addRunArtifact(riscv_basic_test_exe);

    const riscv_basic_test_step = b.step("riscv_basic_test", "Run RISC-V basic arithmetic tests (Step 1)");
    riscv_basic_test_step.dependOn(&run_riscv_basic_test.step);

    // ========================================================================
    // Step 2: Function & Calling Convention Tests (12 tests)
    // ========================================================================

    const riscv_function_test_exe = b.addTest(.{
        .root_source_file = b.path("test/riscv_function_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    riscv_function_test_exe.root_module.addImport("riscv_codegen", riscv_codegen_module);

    const run_riscv_function_test = b.addRunArtifact(riscv_function_test_exe);

    const riscv_function_test_step = b.step("riscv_function_test", "Run RISC-V function tests (Step 2)");
    riscv_function_test_step.dependOn(&run_riscv_function_test.step);

    // ========================================================================
    // Step 3: Control Flow Tests (13 tests)
    // ========================================================================

    const riscv_control_test_exe = b.addTest(.{
        .root_source_file = b.path("test/riscv_control_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    riscv_control_test_exe.root_module.addImport("riscv_codegen", riscv_codegen_module);

    const run_riscv_control_test = b.addRunArtifact(riscv_control_test_exe);

    const riscv_control_test_step = b.step("riscv_control_test", "Run RISC-V control flow tests (Step 3)");
    riscv_control_test_step.dependOn(&run_riscv_control_test.step);

    // ========================================================================
    // x86-64 Step 1: Basic Arithmetic Tests (20 tests)
    // ========================================================================

    const x86_64_basic_test_exe = b.addTest(.{
        .root_source_file = b.path("test/x86_64_basic_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    x86_64_basic_test_exe.root_module.addImport("x86_64_codegen", x86_64_codegen_module);

    const run_x86_64_basic_test = b.addRunArtifact(x86_64_basic_test_exe);

    const x86_64_basic_test_step = b.step("x86_64_basic_test", "Run x86-64 basic arithmetic tests (Step 1)");
    x86_64_basic_test_step.dependOn(&run_x86_64_basic_test.step);

    // ========================================================================
    // x86-64 Step 2: Function & Calling Convention Tests (14 tests)
    // ========================================================================

    const x86_64_function_test_exe = b.addTest(.{
        .root_source_file = b.path("test/x86_64_function_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    x86_64_function_test_exe.root_module.addImport("x86_64_codegen", x86_64_codegen_module);

    const run_x86_64_function_test = b.addRunArtifact(x86_64_function_test_exe);

    const x86_64_function_test_step = b.step("x86_64_function_test", "Run x86-64 function tests (Step 2)");
    x86_64_function_test_step.dependOn(&run_x86_64_function_test.step);

    // ========================================================================
    // x86-64 Step 3: Control Flow Tests (13 tests)
    // ========================================================================

    const x86_64_control_test_exe = b.addTest(.{
        .root_source_file = b.path("test/x86_64_control_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    x86_64_control_test_exe.root_module.addImport("x86_64_codegen", x86_64_codegen_module);

    const run_x86_64_control_test = b.addRunArtifact(x86_64_control_test_exe);

    const x86_64_control_test_step = b.step("x86_64_control_test", "Run x86-64 control flow tests (Step 3)");
    x86_64_control_test_step.dependOn(&run_x86_64_control_test.step);

    // ========================================================================
    // ARM64 Step 1: Basic Arithmetic Tests (20 tests)
    // ========================================================================

    const arm64_basic_test_exe = b.addTest(.{
        .root_source_file = b.path("test/arm64_basic_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    arm64_basic_test_exe.root_module.addImport("arm64_codegen", arm64_codegen_module);

    const run_arm64_basic_test = b.addRunArtifact(arm64_basic_test_exe);

    const arm64_basic_test_step = b.step("arm64_basic_test", "Run ARM64 basic arithmetic tests (Step 1)");
    arm64_basic_test_step.dependOn(&run_arm64_basic_test.step);

    // ========================================================================
    // ARM64 Step 2: Function & Calling Convention Tests (14 tests)
    // ========================================================================

    const arm64_function_test_exe = b.addTest(.{
        .root_source_file = b.path("test/arm64_function_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    arm64_function_test_exe.root_module.addImport("arm64_codegen", arm64_codegen_module);

    const run_arm64_function_test = b.addRunArtifact(arm64_function_test_exe);

    const arm64_function_test_step = b.step("arm64_function_test", "Run ARM64 function tests (Step 2)");
    arm64_function_test_step.dependOn(&run_arm64_function_test.step);

    // ========================================================================
    // ARM64 Step 3: Control Flow Tests (13 tests)
    // ========================================================================

    const arm64_control_test_exe = b.addTest(.{
        .root_source_file = b.path("test/arm64_control_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    arm64_control_test_exe.root_module.addImport("arm64_codegen", arm64_codegen_module);

    const run_arm64_control_test = b.addRunArtifact(arm64_control_test_exe);

    const arm64_control_test_step = b.step("arm64_control_test", "Run ARM64 control flow tests (Step 3)");
    arm64_control_test_step.dependOn(&run_arm64_control_test.step);

    // ========================================================================
    // LLVM IR Step 1: Basic Tests (20 tests)
    // ========================================================================

    const llvm_ir_basic_test_exe = b.addTest(.{
        .root_source_file = b.path("test/llvm_ir_basic_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    llvm_ir_basic_test_exe.root_module.addImport("llvm_ir_codegen", llvm_ir_codegen_module);

    const run_llvm_ir_basic_test = b.addRunArtifact(llvm_ir_basic_test_exe);

    const llvm_ir_basic_test_step = b.step("llvm_ir_basic_test", "Run LLVM IR basic tests (Step 1)");
    llvm_ir_basic_test_step.dependOn(&run_llvm_ir_basic_test.step);

    // ========================================================================
    // Compiler Driver Tests (15 tests)
    // ========================================================================

    const compiler_driver_test_exe = b.addTest(.{
        .root_source_file = b.path("test/compiler_driver_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    compiler_driver_test_exe.root_module.addImport("compiler_driver", compiler_driver_module);

    const run_compiler_driver_test = b.addRunArtifact(compiler_driver_test_exe);

    const compiler_driver_test_step = b.step("compiler_driver_test", "Run compiler driver tests (Phase 8)");
    compiler_driver_test_step.dependOn(&run_compiler_driver_test.step);

    // ========================================================================
    // Standard Library Generator Tests (10 tests)
    // ========================================================================

    const stdlib_gen_test_exe = b.addTest(.{
        .root_source_file = b.path("test/stdlib_gen_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    stdlib_gen_test_exe.root_module.addImport("stdlib_gen", stdlib_gen_module);

    const run_stdlib_gen_test = b.addRunArtifact(stdlib_gen_test_exe);

    const stdlib_gen_test_step = b.step("stdlib_gen_test", "Run standard library generator tests (Phase 9)");
    stdlib_gen_test_step.dependOn(&run_stdlib_gen_test.step);

    // ========================================================================
    // Aggregate test step
    // ========================================================================

    const test_step = b.step("test", "Run all tests (40 RISC-V + 47 x86-64 + 47 ARM64 + 20 LLVM IR + 15 Compiler Driver + 10 Stdlib = 179 total)");
    test_step.dependOn(riscv_basic_test_step);
    test_step.dependOn(riscv_function_test_step);
    test_step.dependOn(riscv_control_test_step);
    test_step.dependOn(x86_64_basic_test_step);
    test_step.dependOn(x86_64_function_test_step);
    test_step.dependOn(x86_64_control_test_step);
    test_step.dependOn(arm64_basic_test_step);
    test_step.dependOn(arm64_function_test_step);
    test_step.dependOn(arm64_control_test_step);
    test_step.dependOn(llvm_ir_basic_test_step);
    test_step.dependOn(compiler_driver_test_step);
    test_step.dependOn(stdlib_gen_test_step);

    // ========================================================================
    // Main executable (compiler binary)
    // ========================================================================

    const exe = b.addExecutable(.{
        .name = "zig-compiler",
        .root_source_file = b.path("src/main.zig"),
        .target = target,
        .optimize = optimize,
    });

    exe.root_module.addImport("riscv_codegen", riscv_codegen_module);
    exe.root_module.addImport("x86_64_codegen", x86_64_codegen_module);
    exe.root_module.addImport("arm64_codegen", arm64_codegen_module);

    b.installArtifact(exe);

    const run_cmd = b.addRunArtifact(exe);
    if (b.args) |args| {
        run_cmd.addArgs(args);
    }

    const run_step = b.step("run", "Run the compiler");
    run_step.dependOn(&run_cmd.step);

    // ========================================================================
    // Install step (builds and installs all artifacts)
    // ========================================================================

    const install_step = b.getInstallStep();
}
