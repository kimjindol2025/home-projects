/// Build configuration for Zig Compiler with RISC-V backend
///
/// Compile targets:
/// - zig build: build compiler binary
/// - zig build test: run all tests
/// - zig build riscv_basic_test: run basic arithmetic tests
/// - zig build riscv_function_test: run function/calling convention tests
/// - zig build riscv_control_test: run control flow tests

const std = @import("std");

pub fn build(b: *std.Build) void {
    const target = b.standardTargetOptions(.{});
    const optimize = b.standardOptimizeOption(.{});

    // ========================================================================
    // Main Compiler Library
    // ========================================================================

    const riscv_codegen_lib = b.addStaticLibrary(.{
        .name = "riscv_codegen",
        .root_source_file = b.path("src/riscv_codegen.zig"),
        .target = target,
        .optimize = optimize,
    });

    const riscv_codegen_module = b.addModule("riscv_codegen", .{
        .root_source_file = b.path("src/riscv_codegen.zig"),
    });

    // ========================================================================
    // Step 1: Basic Arithmetic Tests (15 tests)
    // ========================================================================

    const riscv_basic_test_exe = b.addTest(.{
        .root_source_file = b.path("test/riscv_basic_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    riscv_basic_test_exe.root_module.addImport("riscv_codegen", riscv_codegen_module);

    const run_riscv_basic_test = b.addRunArtifact(riscv_basic_test_exe);

    const riscv_basic_test_step = b.step("riscv_basic_test", "Run RISC-V basic arithmetic tests (Step 1)");
    riscv_basic_test_step.dependOn(&run_riscv_basic_test.step);

    // ========================================================================
    // Step 2: Function & Calling Convention Tests (12 tests)
    // ========================================================================

    const riscv_function_test_exe = b.addTest(.{
        .root_source_file = b.path("test/riscv_function_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    riscv_function_test_exe.root_module.addImport("riscv_codegen", riscv_codegen_module);

    const run_riscv_function_test = b.addRunArtifact(riscv_function_test_exe);

    const riscv_function_test_step = b.step("riscv_function_test", "Run RISC-V function tests (Step 2)");
    riscv_function_test_step.dependOn(&run_riscv_function_test.step);

    // ========================================================================
    // Step 3: Control Flow Tests (13 tests)
    // ========================================================================

    const riscv_control_test_exe = b.addTest(.{
        .root_source_file = b.path("test/riscv_control_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    riscv_control_test_exe.root_module.addImport("riscv_codegen", riscv_codegen_module);

    const run_riscv_control_test = b.addRunArtifact(riscv_control_test_exe);

    const riscv_control_test_step = b.step("riscv_control_test", "Run RISC-V control flow tests (Step 3)");
    riscv_control_test_step.dependOn(&run_riscv_control_test.step);

    // ========================================================================
    // Aggregate test step
    // ========================================================================

    const test_step = b.step("test", "Run all tests (40 total: 15+12+13)");
    test_step.dependOn(riscv_basic_test_step);
    test_step.dependOn(riscv_function_test_step);
    test_step.dependOn(riscv_control_test_step);

    // ========================================================================
    // Main executable (compiler binary)
    // ========================================================================

    const exe = b.addExecutable(.{
        .name = "zig-compiler",
        .root_source_file = b.path("src/main.zig"),
        .target = target,
        .optimize = optimize,
    });

    exe.root_module.addImport("riscv_codegen", riscv_codegen_module);

    b.installArtifact(exe);

    const run_cmd = b.addRunArtifact(exe);
    if (b.args) |args| {
        run_cmd.addArgs(args);
    }

    const run_step = b.step("run", "Run the compiler");
    run_step.dependOn(&run_cmd.step);

    // ========================================================================
    // Install step (builds and installs all artifacts)
    // ========================================================================

    const install_step = b.getInstallStep();
}
