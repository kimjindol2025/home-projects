/// Compiler Driver - Platform-Specific Assembly & Linking
///
/// Maps architecture-specific assembly files to assemblers and linkers.
/// Supports: x86-64 (nasm), RISC-V (riscv64-linux-gnu-as), ARM64 (as)
///
/// Usage:
/// var driver = CompilerDriver.init(allocator, .x86_64);
/// try driver.assemble("code.asm", "code.o");
/// try driver.link("code.o", "output");
/// or
/// try driver.compileAndLink("code.asm", "output");

const std = @import("std");
const Allocator = std.mem.Allocator;

pub const Target = enum {
    x86_64,
    riscv64,
    arm64,
};

pub const CompilerDriver = struct {
    allocator: Allocator,
    target: Target,
    verbose: bool,

    pub fn init(allocator: Allocator, target: Target) CompilerDriver {
        return CompilerDriver{
            .allocator = allocator,
            .target = target,
            .verbose = false,
        };
    }

    /// Get assembler command name for target
    pub fn getAssembler(self: CompilerDriver) []const u8 {
        return switch (self.target) {
            .x86_64 => "nasm",
            .riscv64 => "riscv64-linux-gnu-as",
            .arm64 => "as",
        };
    }

    /// Get linker command name
    pub fn getLinker(self: CompilerDriver) []const u8 {
        _ = self;
        return "ld";
    }

    /// Get assembler flags for target
    pub fn getAssemblerFlags(self: CompilerDriver) []const []const u8 {
        return switch (self.target) {
            .x86_64 => &[_][]const u8{"-f", "elf64"},
            .riscv64 => &[_][]const u8{},
            .arm64 => &[_][]const u8{},
        };
    }

    /// Get ELF format string for target
    pub fn getElfFormat(self: CompilerDriver) []const u8 {
        return switch (self.target) {
            .x86_64 => "elf64-x86-64",
            .riscv64 => "elf64-littleriscv",
            .arm64 => "elf64-littleaarch64",
        };
    }

    /// Get linker format flag for target
    pub fn getLinkerFormat(self: CompilerDriver) []const u8 {
        return switch (self.target) {
            .x86_64 => "elf_x86_64",
            .riscv64 => "elf64lriscv",
            .arm64 => "aarch64linux",
        };
    }

    /// Assemble source file to object file
    /// Example: nasm -f elf64 input.asm -o input.o
    pub fn assemble(self: CompilerDriver, input_file: []const u8, output_file: []const u8) !void {
        const assembler = self.getAssembler();
        const flags = self.getAssemblerFlags();

        // Build argument list
        var args = std.ArrayList([]const u8).init(self.allocator);
        defer args.deinit();

        try args.append(assembler);

        // Add architecture-specific flags
        for (flags) |flag| {
            try args.append(flag);
        }

        // Input and output
        try args.append(input_file);
        try args.append("-o");
        try args.append(output_file);

        if (self.verbose) {
            std.debug.print("Assembling: {s}\n", .{input_file});
        }

        // Spawn assembler
        var child = std.process.Child.init(args.items, self.allocator);
        child.stdin_behavior = .Close;
        child.stdout_behavior = .Inherit;
        child.stderr_behavior = .Inherit;

        _ = try child.spawnAndWait();
    }

    /// Link object file to executable
    /// Example: ld -dynamic-linker /lib64/ld-linux-x86-64.so.2 input.o -o output
    pub fn link(self: CompilerDriver, input_file: []const u8, output_file: []const u8) !void {
        const linker = self.getLinker();
        const elf_format = self.getLinkerFormat();

        // Build argument list
        var args = std.ArrayList([]const u8).init(self.allocator);
        defer args.deinit();

        try args.append(linker);
        try args.append("-m");
        try args.append(elf_format);

        // Add dynamic linker for x86-64
        if (self.target == .x86_64) {
            try args.append("-dynamic-linker");
            try args.append("/lib64/ld-linux-x86-64.so.2");
        } else if (self.target == .arm64) {
            try args.append("-dynamic-linker");
            try args.append("/lib/ld-linux-aarch64.so.1");
        }

        try args.append(input_file);
        try args.append("-o");
        try args.append(output_file);

        if (self.verbose) {
            std.debug.print("Linking: {s}\n", .{input_file});
        }

        // Spawn linker
        var child = std.process.Child.init(args.items, self.allocator);
        child.stdin_behavior = .Close;
        child.stdout_behavior = .Inherit;
        child.stderr_behavior = .Inherit;

        _ = try child.spawnAndWait();
    }

    /// Compile and link in one step
    pub fn compileAndLink(self: CompilerDriver, asm_file: []const u8, exe_file: []const u8) !void {
        // Generate intermediate object filename
        var obj_buf: [256]u8 = undefined;
        const obj_file = try std.fmt.bufPrint(&obj_buf, "{s}.o", .{exe_file});

        try self.assemble(asm_file, obj_file);
        try self.link(obj_file, exe_file);

        // Clean up intermediate object file
        _ = std.fs.cwd().deleteFile(obj_file) catch {};
    }

    /// Get target architecture as string
    pub fn getTargetString(self: CompilerDriver) []const u8 {
        return switch (self.target) {
            .x86_64 => "x86_64",
            .riscv64 => "riscv64",
            .arm64 => "arm64",
        };
    }
};
