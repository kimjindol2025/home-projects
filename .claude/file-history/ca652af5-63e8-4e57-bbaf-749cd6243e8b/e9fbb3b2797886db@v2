/// ARM64 Code Generator - Step 2 Tests
/// Function prologue/epilogue, calling convention, and stack management
///
/// Tests:
/// 1-3: Function prologue (stp, mov x29, sp)
/// 4-5: Function epilogue (ldp, ret)
/// 6-7: Stack operations (str, ldr)
/// 8-10: Calling convention (argument registers: x0, x1, x2)
/// 11: Return value in x0
/// 12: Frame size tracking
/// 13-14: Function call and global symbol declaration

const std = @import("std");
const Arm64Codegen = @import("../src/arm64_codegen.zig").Arm64Codegen;
const Register = @import("../src/arm64_codegen.zig").Register;

test "arm64: function prologue (stp x29, x30, ...)" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = Arm64Codegen.init(allocator);
    defer codegen.deinit();

    try codegen.emitFunctionPrologue(32);
    const output = codegen.output.items;

    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "stp"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "x29"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "x30"));
}

