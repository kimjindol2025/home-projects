test "arm64: frame size tracking" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = Arm64Codegen.init(allocator);
    defer codegen.deinit();

    const frame_size = 64;
    try codegen.emitFunctionPrologue(frame_size);

    // Should be aligned to 16
    const expected_aligned = ((frame_size + 15) / 16) * 16;
    try std.testing.expect(codegen.current_frame_size == expected_aligned);
}

