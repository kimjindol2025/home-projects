/// Standard Library Generator Tests
///
/// Tests:
/// 1-3: Backend initialization (x86_64, arm64, riscv64)
/// 4-7: emitPrint per backend
/// 8-10: emitExit, generate, getBackendString

const std = @import("std");
const StdlibGen = @import("../src/stdlib_gen.zig").StdlibGen;
const Backend = @import("../src/stdlib_gen.zig").Backend;

test "stdlib_gen: init x86_64 backend" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var gen = StdlibGen.init(allocator, .x86_64);
    defer gen.deinit();

    try std.testing.expect(gen.backend == .x86_64);
}

