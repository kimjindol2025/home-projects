/// Linker Helper - Execute compiled binaries and validate output
///
/// E2E Testing: source → compile → link → execute → validate
/// Used for binary execution verification

const std = @import("std");
const Allocator = std.mem.Allocator;

pub const Linker = struct {
    allocator: Allocator,
    output: std.ArrayList(u8),

    pub fn init(allocator: Allocator) Linker {
        return Linker{
            .allocator = allocator,
            .output = std.ArrayList(u8).init(allocator),
        };
    }

    pub fn deinit(self: *Linker) void {
        self.output.deinit();
    }

    /// Execute a binary and capture stdout
    pub fn runBinary(self: *Linker, binary_path: []const u8) !void {
        var child = std.process.Child.init(&[_][]const u8{binary_path}, self.allocator);
        child.stdin_behavior = .Close;
        child.stdout_behavior = .Pipe;
        child.stderr_behavior = .Ignore;

        try child.spawn();

        if (child.stdout) |stdout| {
            var buf: [4096]u8 = undefined;
            while (true) {
                const bytes_read = try stdout.read(&buf);
                if (bytes_read == 0) break;
                try self.output.appendSlice(buf[0..bytes_read]);
            }
            stdout.close();
        }

        _ = try child.wait();
    }

    /// Get captured output
    pub fn getOutput(self: Linker) []const u8 {
        return self.output.items;
    }
};
