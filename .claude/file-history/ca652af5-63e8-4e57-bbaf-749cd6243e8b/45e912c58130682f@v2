/// x86-64 Code Generator - Step 3 Tests
/// Control flow instructions: branches, loops, labels
///
/// Tests:
/// 1-4: Label generation and emission
/// 5: Unconditional jump (jmp)
/// 6-9: Conditional jumps (je, jne, jl, jge)
/// 10-13: Control flow patterns (if/else, while, break, nested)

const std = @import("std");
const X86_64Codegen = @import("../src/x86_64_codegen.zig").X86_64Codegen;
const Register = @import("../src/x86_64_codegen.zig").Register;

test "x86-64: label generation .L0" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = X86_64Codegen.init(allocator);
    defer codegen.deinit();

    const label1 = try codegen.newLabel(allocator);
    defer allocator.free(label1);

    try std.testing.expectEqualStrings(label1, ".L0");
}

