test "x86-64: nested if/else multiple labels" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = X86_64Codegen.init(allocator);
    defer codegen.deinit();

    const else1 = try codegen.newLabel(allocator);
    defer allocator.free(else1);
    const else2 = try codegen.newLabel(allocator);
    defer allocator.free(else2);
    const end = try codegen.newLabel(allocator);
    defer allocator.free(end);

    // if (rax == 0) goto else1
    try codegen.emitCmp(.rax, std.mem.zeroInit(Register, .{}));
    try codegen.emitJe(else1);
    try codegen.emitMov(.rax, .rcx);
    try codegen.emitJmp(end);

    // else1: if (rbx == 0) goto else2
    try codegen.emitLabel(else1);
    try codegen.emitCmp(.rbx, std.mem.zeroInit(Register, .{}));
    try codegen.emitJe(else2);
    try codegen.emitMov(.rax, .rdx);
    try codegen.emitJmp(end);

    // else2:
    try codegen.emitLabel(else2);
    try codegen.emitMov(.rax, .rsi);

    // end:
    try codegen.emitLabel(end);

    const output = codegen.output.items;
    try std.testing.expect(output.len > 0);
}
