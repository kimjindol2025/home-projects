test "x86-64: if/else pattern (cmp + je + jmp)" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = X86_64Codegen.init(allocator);
    defer codegen.deinit();

    const else_label = try codegen.newLabel(allocator);
    defer allocator.free(else_label);
    const end_label = try codegen.newLabel(allocator);
    defer allocator.free(end_label);

    // if (rax != rbx) goto else
    try codegen.emitCmp(.rax, .rbx);
    try codegen.emitJe(else_label);

    // then block
    try codegen.emitMov(.rax, .rcx);
    try codegen.emitJmp(end_label);

    // else block
    try codegen.emitLabel(else_label);
    try codegen.emitMov(.rax, .rdx);

    // end
    try codegen.emitLabel(end_label);

    const output = codegen.output.items;
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "cmp"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "je"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "jmp"));
}

test "x86-64: while loop pattern (cmp + jne + jmp)" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var codegen = X86_64Codegen.init(allocator);
    defer codegen.deinit();

    const loop_label = try codegen.newLabel(allocator);
    defer allocator.free(loop_label);
    const end_label = try codegen.newLabel(allocator);
    defer allocator.free(end_label);

    // loop_start:
    try codegen.emitLabel(loop_label);

    // if (rax == 0) goto end
    try codegen.emitTest(.rax);
    try codegen.emitJz(end_label);

    // loop body
    try codegen.emitAdd(.rcx, .rdx);

    // j loop_start
    try codegen.emitJmp(loop_label);

    // end:
    try codegen.emitLabel(end_label);

    const output = codegen.output.items;
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "test"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "jz"));
    try std.testing.expect(std.mem.containsAtLeast(u8, output, 1, "jmp"));
}

