# operators.jl - Julia 연산자 완전 가이드

println("=== Julia 연산자 완전 가이드 ===")
println()

# ============================================
# 1. 산술 연산자 (Arithmetic Operators)
# ============================================
println("1. 산술 연산자:")
a = 17
b = 5

println("  덧셈 (+): $a + $b = $(a + b)")
println("  뺄셈 (-): $a - $b = $(a - b)")
println("  곱셈 (*): $a * $b = $(a * b)")
println("  나눗셈 (/): $a / $b = $(a / b)")
println("  정수 나눗셈 (÷): $a ÷ $b = $(a ÷ b)")
println("  나머지 (%): $a % $b = $(a % b)")
println("  거듭제곱 (^): 2 ^ 10 = $(2 ^ 10)")
println()

# ============================================
# 2. 단항 연산자 (Unary Operators)
# ============================================
println("2. 단항 연산자:")
x = 42
println("  +x: +$x = $(+x)")
println("  -x: -$x = $(-x)")
println("  제곱근 (sqrt): sqrt(16) = $(sqrt(16))")
println("  절댓값 (abs): abs(-10) = $(abs(-10))")
println()

# ============================================
# 3. 비교 연산자 (Comparison Operators)
# ============================================
println("3. 비교 연산자:")
p = 10
q = 8

println("  같음 (==): $p == $q → $(p == q)")
println("  다름 (!=): $p != $q → $(p != q)")
println("  작음 (<): $p < $q → $(p < q)")
println("  큼 (>): $p > $q → $(p > q)")
println("  작거나 같음 (<=): $p <= $q → $(p <= q)")
println("  크거나 같음 (>=): $p >= $q → $(p >= q)")
println()

# ============================================
# 4. 논리 연산자 (Logical Operators)
# ============================================
println("4. 논리 연산자:")
println("  AND (&&):")
println("    true && true = $(true && true)")
println("    true && false = $(true && false)")

println("  OR (||):")
println("    true || false = $(true || false)")
println("    false || false = $(false || false)")

println("  NOT (!):")
println("    !true = $(!true)")
println("    !false = $(!false)")

# 쇼트서킷 평가 (Short-circuit Evaluation)
println("  쇼트서킷 평가 (성능 최적화):")
println("    false && (1/0) → $(false && (1/0))  (오른쪽 평가 안 함)")
println("    true || (1/0) → $(true || (1/0))   (오른쪽 평가 안 함)")
println()

# ============================================
# 5. 비트 연산자 (Bitwise Operators)
# ============================================
println("5. 비트 연산자:")
num1 = 5        # 이진: 101
num2 = 3        # 이진: 011

println("  5의 이진표현: $(bitstring(num1))")
println("  3의 이진표현: $(bitstring(num2))")
println()

println("  AND (&): 5 & 3 = $(num1 & num2)")
println("  OR (|): 5 | 3 = $(num1 | num2)")
println("  XOR (⊻): 5 ⊻ 3 = $(num1 ⊻ num2)")
println("  NOT (~): ~5 = $(~num1)")
println("  왼쪽 시프트 (<<): 5 << 1 = $(num1 << 1)")
println("  오른쪽 시프트 (>>): 16 >> 2 = $(16 >> 2)")
println()

# ============================================
# 6. 문자열 연산자 (String Operators)
# ============================================
println("6. 문자열 연산자:")
str1 = "Hello"
str2 = "World"

println("  연결 (*): \"$str1\" * \" \" * \"$str2\" = \"$(str1 * " " * str2)\"")
println("  반복 (*): \"Hi\" * \" \" ^ 3 = $(\"Hi\" * \" \" ^ 3)")
println("  길이 (length): length(\"$str1\") = $(length(str1))")
println()

# ============================================
# 7. 연산자 우선순위 (Operator Precedence)
# ============================================
println("7. 연산자 우선순위 (높음 → 낮음):")
println("  2 + 3 * 4 = $(2 + 3 * 4)           (곱셈 먼저)")
println("  2 ^ 3 * 4 = $(2 ^ 3 * 4)           (거듭제곱 먼저)")
println("  (2 + 3) * 4 = $((2 + 3) * 4)       (괄호 우선)")
println("  10 - 5 - 2 = $(10 - 5 - 2)         (좌측 결합)")
println("  2 ^ 3 ^ 2 = $(2 ^ 3 ^ 2)           (우측 결합: 3^2=9, 2^9=512)")
println()

# ============================================
# 8. 대입 연산자 (Assignment Operators)
# ============================================
println("8. 대입 연산자:")
var = 10
println("  초기값: var = $var")

var += 5
println("  += : var += 5 → $var")

var -= 3
println("  -= : var -= 3 → $var")

var *= 2
println("  *= : var *= 2 → $var")

var ÷= 4
println("  ÷= : var ÷= 4 → $var")
println()

# ============================================
# 9. 배열 인덱싱과 범위 (Indexing & Ranges)
# ============================================
println("9. 배열 인덱싱과 범위:")
arr = [10, 20, 30, 40, 50]
println("  배열: $arr")
println("  arr[1] = $(arr[1])          (첫 번째, 1-based)")
println("  arr[end] = $(arr[end])      (마지막)")
println("  arr[1:3] = $(arr[1:3])      (범위)")
println("  arr[2:end] = $(arr[2:end])  (2부터 끝까지)")

# 범위 (Range)
range1 = 1:5
range2 = 1:2:10      # 시작:스텝:끝
println("  범위(1:5): $range1")
println("  범위(1:2:10): $range2")
println()

# ============================================
# 10. 타입 검사 연산자 (Type Checking)
# ============================================
println("10. 타입 검사:")
val = 42
println("  val = $val (타입: $(typeof(val)))")
println("  typeof(val) == Int64 → $(typeof(val) == Int64)")
println("  isa(val, Int64) → $(isa(val, Int64))")
println("  isa(val, AbstractFloat) → $(isa(val, AbstractFloat))")
println()

# ============================================
# 11. 특수 연산자 (Special Operators)
# ============================================
println("11. 특수 연산자:")

# 범위 생성
println("  범위: collect(1:5) = $(collect(1:5))")

# 선택 (Ternary)
age = 20
status = age >= 18 ? "성인" : "미성년"
println("  삼항 연산자: age >= 18 ? \"성인\" : \"미성년\" = $status")

# 파이프 연산자
result = 5 |> x -> x * 2 |> y -> y + 10
println("  파이프: 5 |> (*2) |> (+10) = $result")
println()

# ============================================
# 12. 복합 표현식 (Complex Expressions)
# ============================================
println("12. 복합 표현식:")
x = 10
y = 20

# 조건을 포함한 계산
result = (x > 5 && y < 30) ? (x + y) : 0
println("  (x > 5 && y < 30) ? (x + y) : 0")
println("    → ($x > 5 && $y < 30) ? ($x + $y) : 0 = $result")

# 여러 조건
is_valid = (x > 0) && (y > 0) && (x < y)
println("  (x > 0) && (y > 0) && (x < y) = $is_valid")
println()

# ============================================
# 13. 비교 체이닝 (Comparison Chaining)
# ============================================
println("13. 비교 체이닝:")
value = 15
println("  0 < $value < 20 → $(0 < value < 20)")
println("  0 < $value < 10 → $(0 < value < 10)")
println()

# ============================================
# 14. 연산자 덮어쓰기 (Operator Overloading)
# ============================================
println("14. 기본 연산자의 다양한 타입:")
println("  정수: 5 + 3 = $(5 + 3)")
println("  실수: 5.5 + 3.2 = $(5.5 + 3.2)")
println("  문자열: \"5\" * \"3\" = $(\"5\" * \"3\")")
println("  배열: [1,2] + [3,4] = $([1,2] + [3,4])")
println()

# ============================================
# 15. 마지막: 성능 팁
# ============================================
println("15. 성능 팁 (REPL에서 @time 사용):")
println("  Julia는 동일한 연산을 반복하면 최적화됨:")
println("  첫 실행: 컴파일 포함 (느림)")
println("  두 번째 실행: 캐시됨 (매우 빠름)")
println("  → 이것이 Julia의 '동적이면서 빠른' 특징!")
println()

println("=== 연산자 학습 완료! ===")
