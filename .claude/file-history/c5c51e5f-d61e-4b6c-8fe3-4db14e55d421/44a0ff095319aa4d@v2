println()

# ============================================
# 20. 실전: 완전한 DSL 예제
# ============================================
println(\"20. 실전: 쿼리 빌더 DSL:\")

macro query_builder(block)
    quote
        query = Dict()
        query[:select] = [:*]
        query[:from] = :table
        query[:where] = []
        query[:order_by] = []

        println(\"  SELECT: $(query[:select])\")
        println(\"  FROM: $(query[:from])\")
        println(\"  WHERE: $(query[:where])\")
        println(\"  ORDER BY: $(query[:order_by])\")

        query
    end
end

result = @query_builder begin
    select :id, :name, :email
    from :users
    where :age > 18
    order_by :name
end

println()
