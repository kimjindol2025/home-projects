# 3. 테스트 DSL
# ============================================
println(\"3. 테스트 DSL (BDD 스타일):\")

macro test_case(desc, expr)
    quote
        try
            result = $(esc($expr))
            println(\"  ✓ $($desc): $result\")
        catch e
            println(\"  ✗ $($desc): $e\")
        end
    end
end

@test_case \"기본 산술\" (2 + 2 == 4)
@test_case \"배열 생성\" (length([1,2,3]) == 3)
println()

