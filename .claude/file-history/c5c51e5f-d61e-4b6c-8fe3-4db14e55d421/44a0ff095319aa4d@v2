# ============================================
# 1. 기본 DSL 개념
# ============================================
println(\"1. DSL 기본 개념:\")

macro simple_rule(condition, action)
    quote
        if $(esc($condition))
            $(esc($action))
        end
    end
end

@simple_rule 5 > 3 println(\"  규칙 실행: 5 > 3 ✓\")
println()

