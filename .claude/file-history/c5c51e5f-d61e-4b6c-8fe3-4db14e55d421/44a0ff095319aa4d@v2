# 8. 데코레이터 패턴 DSL
# ============================================
println(\"8. 데코레이터 DSL:\")

macro timed(expr)
    quote
        t = @elapsed result = $(esc($expr))
        println(\"  실행 시간: $(round(t*1000; digits=2)) ms\")
        result
    end
end

