# ============================================
# 13. 유효성 검사 DSL
# ============================================
println(\"13. 유효성 검사 DSL:\")

macro validate(value, rules)
    quote
        valid = true
        errors = []

        if $(esc($value)) == nothing
            push!(errors, \"값이 없음\")
            valid = false
        end

        if valid
            println(\"  ✓ 유효성 검사 통과\")
        else
            println(\"  ✗ 검사 실패: $(join(errors, \", \"))\")
        end
    end
end

