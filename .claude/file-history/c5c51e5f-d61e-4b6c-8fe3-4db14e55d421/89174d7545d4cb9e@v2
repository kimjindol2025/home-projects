# ============================================
# 11. 타입 검사 조건
# ============================================
println("11. 타입 검사 조건:")

function process(x)
    if isa(x, Int)
        return "정수: $x"
    elseif isa(x, String)
        return "문자열: $x"
    elseif isa(x, Array)
        return "배열, 길이: $(length(x))"
    else
        return "다른 타입"
    end
end

println("  process(42) = $(process(42))")
println("  process(\"hello\") = $(process("hello"))")
println("  process([1,2,3]) = $(process([1,2,3]))")
println()

