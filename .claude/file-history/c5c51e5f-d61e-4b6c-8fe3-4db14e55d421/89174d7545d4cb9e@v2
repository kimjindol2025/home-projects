println("7. 비교 연산자 활용:")

val = 15

conditions = [
    ("val > 10", val > 10),
    ("val < 20", val < 20),
    ("val == 15", val == 15),
    ("val != 10", val != 10),
    ("val >= 15", val >= 15),
