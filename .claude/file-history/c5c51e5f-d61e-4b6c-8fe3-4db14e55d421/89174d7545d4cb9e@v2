# 15. 계단식 조건 (Switch-like)
# ============================================
println("15. 계단식 조건 (대소문자 변환):")

function get_season(month)
    if month in [12, 1, 2]
        return "겨울"
    elseif month in [3, 4, 5]
        return "봄"
    elseif month in [6, 7, 8]
        return "여름"
    elseif month in [9, 10, 11]
        return "가을"
    else
        return "알 수 없음"
    end
end

for month in [1, 3, 6, 9, 12]
    season = get_season(month)
    println("  $month월: $season")
end
println()

