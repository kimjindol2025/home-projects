# 17. 예외 조건 처리
# ============================================
println("17. 조건으로 에러 처리:")

function divide(a, b)
    if b == 0
        error("0으로 나눌 수 없습니다!")
    else
        return a / b
    end
end

try
    result = divide(10, 2)
    println("  divide(10, 2) = $result")

    result = divide(10, 0)
catch e
    println("  에러: $e")
end
println()

