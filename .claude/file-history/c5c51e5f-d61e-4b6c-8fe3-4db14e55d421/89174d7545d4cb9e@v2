println("14. 단락 평가 (성능 최적화):")

function expensive_check()
    println("    (비용이 많이 드는 계산 실행)")
    return true
end

x = 5

# false && ...는 뒤를 계산하지 않음
println("  false && expensive_check():")
result = false && expensive_check()

println("  true || expensive_check():")
result = true || expensive_check()
println()

