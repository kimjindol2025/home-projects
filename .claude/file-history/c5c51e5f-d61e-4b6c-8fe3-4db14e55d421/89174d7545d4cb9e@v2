# 18. 다중 조건 검사
# ============================================
println("18. 여러 조건 한번에 검사:")

function validate(name, age, email)
    if isempty(name)
        return false, "이름이 필요합니다"
    elseif age < 18
        return false, "18세 이상이어야 합니다"
    elseif !contains(email, "@")
        return false, "유효한 이메일이 필요합니다"
    else
        return true, "유효합니다"
    end
end

test_cases = [
    ("Alice", 25, "alice@email.com"),
    ("", 25, "alice@email.com"),
    ("Bob", 15, "bob@email.com"),
]

for (name, age, email) in test_cases
    valid, msg = validate(name, age, email)
    status = valid ? "✓" : "✗"
    println("  $status $msg")
end
println()

