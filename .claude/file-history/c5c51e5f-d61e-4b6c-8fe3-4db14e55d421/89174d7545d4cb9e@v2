# 4. 논리 연산자와 조건
# ============================================
println("4. 논리 연산자 (&&, ||, !):")

a = 10
b = 20

if a > 5 && b > 15
    println("  a > 5이고 b > 15입니다")
end

if a < 5 || b > 15
    println("  a < 5이거나 b > 15입니다")
end

if !(a > 20)
    println("  a는 20 이하입니다")
end
println()

# ============================================
# 5. 삼항 연산자 (Ternary)
# ============================================
println("5. 삼항 연산자:")

x = 10
result = x > 5 ? "큽니다" : "작습니다"
println("  x = $x")
println("  x > 5 ? \"큽니다\" : \"작습니다\" = $result")

age = 20
