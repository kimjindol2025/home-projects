]

for (expr, result) in conditions
    println("  $expr = $result")
end
println()

# ============================================
# 8. 함수 내 if-else-if 사용
# ============================================
println("8. 함수 내 조건문:")

function classify(x)
    if x < 0
        return "음수"
    elseif x == 0
        return "0"
    else
        return "양수"
    end
end

for val in [-5, 0, 5]
    println("  classify($val) = $(classify(val))")
end
println()

