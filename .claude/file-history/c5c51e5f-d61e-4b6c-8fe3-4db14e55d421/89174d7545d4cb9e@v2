# ============================================
# 13. 배열에서 조건 검사
# ============================================
println("13. 배열 원소 조건 검사:")

arr = [1, 2, 3, 4, 5]

# any: 하나라도 조건 만족?
if any(arr .> 3)
    println("  배열에 3보다 큰 원소가 있습니다")
end

# all: 모두 조건 만족?
if all(arr .< 10)
    println("  배열의 모든 원소가 10보다 작습니다")
end

# count: 조건 만족 개수
count_even = count(x -> x % 2 == 0, arr)
println("  짝수 개수: $count_even")
println()

