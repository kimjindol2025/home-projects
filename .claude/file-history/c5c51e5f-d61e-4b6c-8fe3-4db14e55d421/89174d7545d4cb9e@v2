println("19. 상태 머신 패턴:")

function traffic_light(color)
    if color == "red"
        println("  🔴 멈춤")
    elseif color == "yellow"
        println("  🟡 주의")
    elseif color == "green"
        println("  🟢 진행")
    else
        println("  ❓ 알 수 없는 신호")
    end
end

for light in ["red", "yellow", "green"]
    traffic_light(light)
end
println()

