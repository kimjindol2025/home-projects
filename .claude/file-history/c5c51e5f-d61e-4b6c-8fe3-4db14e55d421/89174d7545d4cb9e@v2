# ============================================
# 1. if 문
# ============================================
println("1. if 문 기본:")

x = 10
if x > 5
    println("  x는 5보다 큽니다")
end

y = 3
if y > 5
    println("  y는 5보다 큽니다")
else
    println("  y는 5 이하입니다")
end
println()

# ============================================
# 2. if-elseif-else
# ============================================
println("2. if-elseif-else 문:")

score = 75
if score >= 90
    grade = "A (우수)"
elseif score >= 80
    grade = "B (좋음)"
elseif score >= 70
    grade = "C (보통)"
elseif score >= 60
    grade = "D (미흡)"
else
    grade = "F (부족)"
end
println("  점수: $score → 등급: $grade")
println()

