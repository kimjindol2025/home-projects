module DataProcessing
    export process_data

    using Statistics

    function process_data(data)
        return (
            mean=mean(data),
            std=std(data),
            min=minimum(data),
            max=maximum(data)
        )
    end
end

using .DataProcessing

data = [1, 2, 3, 4, 5, 10]
result = process_data(data)
println("  data = $data")
println("  process_data():")
println("    mean = $(result.mean)")
println("    std = $(round(result.std; digits=2))")
println("    min = $(result.min)")
println("    max = $(result.max)")
println()

