module Counter
    export get_version, increment_count

    const VERSION = 1.0

    _count = 0

    function get_version()
        return VERSION
    end

    function increment_count()
        global _count
        _count += 1
        return _count
    end
end

using .Counter

println("  VERSION = $(get_version())")
println("  (전역 상태 관리는 일반적으로 피함)")
println()

