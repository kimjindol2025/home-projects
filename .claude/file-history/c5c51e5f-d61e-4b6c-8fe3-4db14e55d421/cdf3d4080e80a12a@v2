module Functional
    export apply_twice

    function apply_twice(f, x)
        return f(f(x))
    end

    double(x) = x * 2
    square(x) = x^2
end

using .Functional

result1 = apply_twice(x -> x + 1, 5)
println("  apply_twice(+1, 5) = $result1")

result2 = apply_twice(Functional.double, 3)
println("  apply_twice(double, 3) = $result2")
println()

