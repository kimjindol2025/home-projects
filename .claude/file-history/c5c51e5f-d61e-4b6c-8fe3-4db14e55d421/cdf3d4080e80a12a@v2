println("1. 간단한 모듈 정의:")

module SimpleModule
    export hello, add

    function hello(name)
        return "Hello, $name!"
    end

    function add(x, y)
        return x + y
    end

    function private_func()
        return "비공개 함수"
    end
end

println("  module SimpleModule ... end 정의")
println()

# ============================================
# 2. using으로 모듈 사용
# ============================================
println("2. using으로 모듈 사용:")

using .SimpleModule  # . = 현재 파일의 모듈

result1 = hello("Julia")
result2 = add(5, 3)

println("  hello(\"Julia\") = $result1")
println("  add(5, 3) = $result2")

try
    private_func()
    println("  private_func() = 성공")
catch
    println("  private_func() = 에러 (비공개 함수)")
end
println()

