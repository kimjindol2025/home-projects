println("8. 모듈 내 다양한 함수:")

module FunctionTypes
    export single_dispatch, multiple_dispatch

    # 단일 인자
    single_dispatch(x::Int) = "정수: $x"
    single_dispatch(x::String) = "문자열: $x"
    single_dispatch(x::Array) = "배열 (길이 $(length(x)))"

    # 다중 인자
    multiple_dispatch(x::Int, y::Int) = x + y
    multiple_dispatch(x::String, y::String) = x * y
end

using .FunctionTypes

println("  single_dispatch(42) = $(single_dispatch(42))")
println("  single_dispatch(\"hello\") = $(single_dispatch("hello"))")
println("  multiple_dispatch(3, 5) = $(multiple_dispatch(3, 5))")
println("  multiple_dispatch(\"a\", \"b\") = $(multiple_dispatch("a", "b"))")
println()

