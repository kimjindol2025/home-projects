module MathTools
    export PI_VALUE, square, Circle, area

    # 상수
    const PI_VALUE = 3.141592653589793

    # 함수
    function square(x)
        return x^2
    end

    # 타입
    struct Circle
        radius::Float64
    end

    # 메서드
    function area(c::Circle)
        return PI_VALUE * c.radius^2
    end

    # 비공개 함수
    function _private_helper()
        return "비공개"
    end
end

println("  상수: PI_VALUE = $(using .MathTools; PI_VALUE)")
println("  함수: square(5) = $(square(5))")
println("  타입: Circle(3.0)")
println()

