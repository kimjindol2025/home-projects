println("6. 타입 정의와 export:")

module GeometryShapes
    export Rectangle, Circle, area, perimeter

    abstract type Shape end

    struct Rectangle <: Shape
        width::Float64
        height::Float64
    end

    struct Circle <: Shape
        radius::Float64
    end

    area(r::Rectangle) = r.width * r.height
    area(c::Circle) = π * c.radius^2

    perimeter(r::Rectangle) = 2 * (r.width + r.height)
    perimeter(c::Circle) = 2 * π * c.radius
end

using .GeometryShapes

rect = Rectangle(4.0, 5.0)
circ = Circle(3.0)

println("  Rectangle(4.0, 5.0):")
println("    area = $(area(rect))")
println("    perimeter = $(round(perimeter(rect); digits=2))")

println("  Circle(3.0):")
println("    area = $(round(area(circ); digits=2))")
println("    perimeter = $(round(perimeter(circ); digits=2))")
println()

