# ============================================
# 17. 고차 함수 체이닝
# ============================================
println("17. 고차 함수 체이닝:")

data = 1:10
println("  데이터: $data")

# 여러 연산 연쇄
result = data |>
    x -> collect(x) |>
    x -> filter(n -> n % 2 == 0, x) |>
    x -> map(n -> n^2, x) |>
    x -> sum(x)

println("  짝수 |> 제곱 |> 합계 = $result")
println()

# ============================================
# 18. 사용자 정의 고차 함수
# ============================================
println("18. 사용자 정의 고차 함수:")

function twice(f, x)
    return f(f(x))
end

add_one = x -> x + 1
result = twice(add_one, 5)
println("  add_one(x) = x + 1")
println("  twice(add_one, 5) = $result (5+1+1)")

double = x -> x * 2
result2 = twice(double, 3)
println("  double(x) = x * 2")
println("  twice(double, 3) = $result2 (3*2*2)")
println()

# ============================================
# 19. 실전: 데이터 변환 파이프라인
# ============================================
println("19. 데이터 변환 파이프라인:")

# 학생 성적 데이터
students = [
    ("Alice", 85),
    ("Bob", 72),
    ("Charlie", 90),
    ("Diana", 78),
    ("Eve", 95)
]

println("  학생 성적: $students")

# 80점 이상 필터링
passed = filter(s -> s[2] >= 80, students)
println("  80점 이상: $passed")

# 이름만 추출
names = map(s -> s[1], passed)
println("  이름: $names")

# 한 줄로
result = students |>
    x -> filter(s -> s[2] >= 80, x) |>
    x -> map(s -> s[1], x)

println("  파이프라인: $result")
println()

# ============================================
# 20. 성능: 루프 vs 고차 함수
# ============================================
println("20. 성능 비교:")

# 루프 방식
@time begin
    result = []
    for i in 1:10000
        if i % 2 == 0
            push!(result, i^2)
        end
    end
end

# 고차 함수
@time begin
    result = map(x -> x^2, filter(x -> x % 2 == 0, 1:10000))
end

# 컴프리헨션
@time begin
    result = [x^2 for x in 1:10000 if x % 2 == 0]
end

println("  위: 루프")
println("  중간: 고차 함수 (map/filter)")
println("  아래: 컴프리헨션 (가장 깔끔하고 빠름)")
println()

println("=== 고차 함수 완료! ===")
