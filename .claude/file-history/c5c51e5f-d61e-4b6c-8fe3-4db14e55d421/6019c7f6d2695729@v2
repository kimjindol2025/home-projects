## 8.6 배열 할당 최소화

```julia
# ✅ 좋은: 사전 할당
function sum_preallocated(n::Int)
    result = 0
    for i in 1:n
        result += i
    end
    return result
end

# ❌ 나쁜: 반복 할당
function sum_allocating(n::Int)
    results = Int[]
    for i in 1:n
        push!(results, i)
    end
    return sum(results)
end
```

