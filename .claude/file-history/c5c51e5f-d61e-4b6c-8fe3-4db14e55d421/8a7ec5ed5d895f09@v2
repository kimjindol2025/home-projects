# 9. 타입 안정성 벤치마크
# ============================================
println(\"9. 타입 안정 vs 불안정:\")

function unstable_loop(n)
    result = 0
    for i in 1:n
        if i % 2 == 0
            result += i
        else
            result += i * 0.5
        end
    end
    return result
end

function stable_loop(n)
    result = 0.0
    for i in 1:n
        if i % 2 == 0
            result += float(i)
        else
            result += i * 0.5
        end
    end
    return result
end

println(\"  타입 불안정:\")
@time unstable_loop(1000000)

println()
println(\"  타입 안정:\")
@time stable_loop(1000000)
println()

