println(\"13. 조건분기 영향:\")

function many_branches(n)
    s = 0
    for i in 1:n
        if i % 2 == 0
            s += i
        elseif i % 3 == 0
            s += i * 2
        elseif i % 5 == 0
            s += i / 2
        end
    end
    return s
end

println(\"  조건분기 루프:\")
@time many_branches(100000)
println()

