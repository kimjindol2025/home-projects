println(\"5. 알고리즘 비교:\")

function bubble_sort(arr)
    arr = copy(arr)
    n = length(arr)
    for i in 1:n
        for j in 1:n-i
            if arr[j] > arr[j+1]
                arr[j], arr[j+1] = arr[j+1], arr[j]
            end
        end
    end
    return arr
end

function quick_sort_impl(arr, left, right)
    if left >= right
        return
    end
    pivot = arr[div(left+right, 2)]
    i = left
    j = right
    while i <= j
        while arr[i] < pivot; i += 1; end
        while arr[j] > pivot; j -= 1; end
        if i <= j
            arr[i], arr[j] = arr[j], arr[i]
            i += 1
            j -= 1
        end
    end
    if left < j; quick_sort_impl(arr, left, j); end
    if i < right; quick_sort_impl(arr, i, right); end
end

function quick_sort(arr)
    arr = copy(arr)
    quick_sort_impl(arr, 1, length(arr))
    return arr
end

test_arr = rand(100)

println(\"  Bubble Sort:\")
@time bubble_result = bubble_sort(test_arr)

println(\"  Quick Sort:\")
@time quick_result = quick_sort(test_arr)
println()

