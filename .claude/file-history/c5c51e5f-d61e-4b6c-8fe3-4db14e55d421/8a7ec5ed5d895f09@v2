# 11. 메모리 접근 패턴 벤치마크
# ============================================
println(\"11. 메모리 접근 순서:\")

M = rand(1000, 1000)

println(\"  행 우선 (비효율):\")
function row_access(M)
    s = 0.0
    for i in 1:size(M,1)
        for j in 1:size(M,2)
            s += M[i,j]
        end
    end
    return s
end

@time result_row = row_access(M)

println()
println(\"  열 우선 (효율, Julia 기본):\")
function col_access(M)
    s = 0.0
    for j in 1:size(M,2)
        for i in 1:size(M,1)
            s += M[i,j]
        end
    end
    return s
end

@time result_col = col_access(M)
println()

