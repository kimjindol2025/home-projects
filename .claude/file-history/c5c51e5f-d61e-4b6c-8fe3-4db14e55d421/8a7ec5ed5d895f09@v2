# 4. 반복 측정으로 통계 계산
# ============================================
println(\"4. 여러 번 실행 통계:\")

function benchmark_function(n_runs)
    times = Float64[]

    for _ in 1:n_runs
        t = @elapsed test_sum(1000000)
        push!(times, t)
    end

    return (
        min=minimum(times),
        max=maximum(times),
        mean=mean(times),
        median=median(times),
        std=std(times)
    )
end

using Statistics
results = benchmark_function(10)
println(\"  최소: $(round(results.min; digits=5)) 초\")
println(\"  최대: $(round(results.max; digits=5)) 초\")
println(\"  평균: $(round(results.mean; digits=5)) 초\")
println(\"  중앙: $(round(results.median; digits=5)) 초\")
println(\"  표준: $(round(results.std; digits=5)) 초\")
println()

