module CompletedPackage
    export Statistics_compute

    function Statistics_compute(data)
        return (
            sum = sum(data),
            mean = sum(data) / length(data),
            count = length(data)
        )
    end
end

using .CompletedPackage

data = [1, 2, 3, 4, 5]
result = Statistics_compute(data)

println("  using CompletedPackage")
println("  data = $data")
println("  result = $result")
println()

