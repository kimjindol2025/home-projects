# first_function.jl - Julia 첫 함수 작성

# 1. 단행 함수 (One-liner)
println("=== 단행 함수 ===")
square(x) = x ^ 2
cube(x) = x ^ 3

println("square(5) = $(square(5))")
println("cube(3) = $(cube(3))")
println()

# 2. 다중행 함수
println("=== 다중행 함수 ===")
function greet(name)
    return "안녕하세요, $name님!"
end

function add(a, b)
    result = a + b
    println("  $a + $b 계산 중...")
    return result
end

println(greet("Julia"))
println("덧셈: $(add(10, 20))")
println()

# 3. 선택적 기본값
println("=== 기본값 있는 함수 ===")
function power(x, exp=2)
    return x ^ exp
end

println("power(2) = $(power(2))")      # exp=2 (기본값)
println("power(2, 3) = $(power(2, 3))")  # exp=3 (명시)
println("power(2, 4) = $(power(2, 4))")  # exp=4 (명시)
println()

# 4. 여러 반환값
println("=== 여러 값 반환 ===")
function divide_with_remainder(a, b)
    quotient = div(a, b)
    remainder = mod(a, b)
    return quotient, remainder
end

q, r = divide_with_remainder(17, 5)
println("17 ÷ 5 = $q 나머지 $r")
println()

# 5. 가변 개수 인자 (varargs)
println("=== 가변 개수 인자 ===")
function sum_all(numbers...)
    total = sum(numbers)
    return total
end

println("sum_all(1, 2, 3) = $(sum_all(1, 2, 3))")
println("sum_all(1, 2, 3, 4, 5) = $(sum_all(1, 2, 3, 4, 5))")
println()

# 6. 타입 명시 (선택)
println("=== 타입 명시 함수 ===")
function multiply(x::Int, y::Int)::Int
    return x * y
end

result = multiply(6, 7)
println("multiply(6, 7) = $result (타입: $(typeof(result)))")
println()

println("=== 함수 학습 완료! ===")
