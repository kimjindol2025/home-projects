# linear-algebra.jl - Julia 선형대수 (LinearAlgebra 패키지)

using LinearAlgebra

println("=== Julia 선형대수 (LinearAlgebra 패키지) ===")
println()

# ============================================
# 1. 기본 행렬 연산
# ============================================
println("1. 기본 행렬 연산:")

A = [1 2; 3 4]
B = [5 6; 7 8]

println("  A = $A")
println("  B = $B")
println()

# 행렬 덧셈/뺄셈
println("  A + B =")
println("  $(A + B)")

println("  A - B =")
println("  $(A - B)")

# 행렬 곱셈 (선형대수)
println("  A * B (행렬 곱셈) =")
println("  $(A * B)")

# 원소별 곱셈
println("  A .* B (원소별 곱셈) =")
println("  $(A .* B)")
println()

# ============================================
# 2. 행렬식 (Determinant)
# ============================================
println("2. 행렬식 (Determinant):")

A = [1 2; 3 4]
d = det(A)
println("  A = $A")
println("  det(A) = $d")

A2 = [1 2 3; 4 5 6; 7 8 10]
d2 = det(A2)
println("  3×3 행렬의 det(A) = $d2")
println()

# ============================================
# 3. 역행렬 (Inverse Matrix)
# ============================================
println("3. 역행렬 (Inverse):")

A = [1 2; 3 4]
A_inv = inv(A)
println("  A = $A")
println("  inv(A) =")
println("  $A_inv")

# 확인: A * inv(A) = I
product = A * A_inv
println("  A * inv(A) =")
println("  $(round.(product; digits=5))")
println("  (거의 단위 행렬)")
println()

# ============================================
# 4. 전치 행렬 (Transpose)
# ============================================
println("4. 전치 행렬:")

A = [1 2 3; 4 5 6]
println("  A = ")
println("  $A")
println("  크기: $(size(A))")

At = A'
println("  A' (전치) =")
println("  $At")
println("  크기: $(size(At))")
println()

# ============================================
# 5. 고유값과 고유벡터 (Eigenvalues & Eigenvectors)
# ============================================
println("5. 고유값과 고유벡터:")

A = [4 -2; 1 1]
println("  A = $A")
println()

eigenvals = eigvals(A)
println("  고유값: $eigenvals")

eigen_result = eigen(A)
println("  고유벡터:")
println("  $(eigen_result.vectors)")
println()

# ============================================
# 6. 놈 (Norm)
# ============================================
println("6. 벡터와 행렬의 놈 (크기):")

v = [3, 4]
println("  벡터: $v")
println("  norm(v) = $(norm(v))        (유클리드 거리)")
println("  norm(v, 1) = $(norm(v, 1))  (맨해튼 거리)")
println()

A = [1 2; 3 4]
println("  행렬: $A")
println("  norm(A) = $(round(norm(A); digits=3))      (Frobenius norm)")
println("  norm(A, 1) = $(norm(A, 1))   (1-norm)")
println("  norm(A, Inf) = $(norm(A, Inf))   (∞-norm)")
println()

# ============================================
# 7. 조건수 (Condition Number)
# ============================================
println("7. 조건수 (수치적 안정성):")

A = [1 2; 3 4]
println("  A = $A")
println("  cond(A) = $(round(cond(A); digits=3))")

# 나쁜 조건수 예제
B = [1 1; 1 1.0001]
println("  거의 특이 행렬: B = $B")
println("  cond(B) = $(round(cond(B); digits=2))")
println("  (조건수가 크면 수치 오차 위험)")
println()

# ============================================
# 8. 선형 방정식 풀이 (Ax = b)
# ============================================
println("8. 선형 방정식 풀이 (Ax = b):")

A = [2 1; 1 3]
b = [5; 6]
println("  A = $A")
println("  b = $b")
println("  (연립방정식: 2x + y = 5, x + 3y = 6)")
println()

# 백슬래시 연산자 (역행렬 곱셈보다 효율적)
x = A \ b
println("  x = A \\ b = $x")
println("  확인: A * x = $(A * x)")
println()

# ============================================
# 9. 최소제곱법 (Least Squares)
# ============================================
println("9. 최소제곱법 (과결정 시스템):")

# m > n (방정식이 미지수보다 많음)
A = [1 0; 1 1; 1 2]  # 3×2
b = [1; 2; 2]
println("  A = (3×2 행렬)")
println("  $A")
println("  b = $b")
println()

x = A \ b  # 최소제곱 해
println("  최소제곱 해: x = $x")
r = A * x - b
println("  잔차: Ax - b = $r")
println("  ||잔차||² = $(sum(r.^2))")
println()

# ============================================
# 10. QR 분해
# ============================================
println("10. QR 분해 (A = QR):")

A = [1 2 3; 4 5 6; 7 8 10]
F = qr(A)

Q = F.Q
R = F.R

println("  원본 A = $A")
println()
println("  Q (직교 행렬) =")
println("  $(round.(Q; digits=3))")
println()
println("  R (상삼각 행렬) =")
println("  $(round.(R; digits=3))")
println()

# 확인
A_reconstructed = Q * R
println("  Q * R (복원) =")
println("  $(round.(A_reconstructed; digits=5))")
println()

# ============================================
# 11. SVD 분해 (특이값 분해)
# ============================================
println("11. SVD 분해 (A = U * Σ * V^T):")

A = [1 0 0; 0 2 0; 0 0 3; 0 0 0]
println("  A (4×3) =")
println("  $A")
println()

F = svd(A)
U = F.U
S = F.S
V = F.V

println("  특이값: $S")
println("  (대각선 성분)")
println()

# 원래 행렬 복원
A_reconstructed = U * Diagonal(S) * V'
println("  U * Σ * V^T =")
println("  $(round.(A_reconstructed; digits=5))")
println()

# ============================================
# 12. 하우스홀더 분해 (다른 분해 방법)
# ============================================
println("12. Cholesky 분해 (대칭 양정부호 행렬):")

# 대칭 양정부호 행렬 생성
A = [4 2; 2 3]
println("  A (대칭 양정부호) = $A")
println()

F = cholesky(A)
L = F.L

println("  Cholesky 인수: L =")
println("  $(round.(L; digits=3))")
println()

# 확인: L * L^T = A
product = L * L'
println("  L * L^T =")
println("  $(round.(product; digits=5))")
println()

# ============================================
# 13. 행렬의 계수 (Rank)
# ============================================
println("13. 행렬의 계수 (Rank):")

A = [1 2 3; 2 4 6; 1 1 1]  # 첫 두 행이 종속
println("  A = $A")
println("  rank(A) = $(rank(A))")
println()

B = [1 2; 3 4]
println("  B = $B")
println("  rank(B) = $(rank(B)) (완전 계수)")
println()

# ============================================
# 14. 특수 행렬들
# ============================================
println("14. 특수 행렬 생성:")

# 단위 행렬
I3 = I(3)
println("  I(3) (3×3 단위 행렬) 타입: $(typeof(I3))")

# 대각 행렬
diag_mat = Diagonal([1, 2, 3])
println("  Diagonal([1,2,3]) = $(Matrix(diag_mat))")

# 삼각 행렬
A = [1 2 3; 4 5 6; 7 8 9]
L = LowerTriangular(A)
U = UpperTriangular(A)
println("  LowerTriangular =")
println("  $(Matrix(L))")

println("  UpperTriangular =")
println("  $(Matrix(U))")
println()

# ============================================
# 15. 행렬과 벡터 연산
# ============================================
println("15. 행렬과 벡터 연산:")

A = [1 2; 3 4]
v = [5; 6]

println("  A = $A")
println("  v = $v")
println()

# 행렬-벡터 곱셈
result = A * v
println("  A * v = $result")

# 벡터-벡터 내적
u = [1, 2, 3]
w = [4, 5, 6]
dot_product = dot(u, w)
println("  dot([1,2,3], [4,5,6]) = $dot_product")
println("  (1*4 + 2*5 + 3*6 = 32)")

# 외적 (3D)
cross_product = cross(u, w)
println("  cross([1,2,3], [4,5,6]) = $cross_product")
println()

# ============================================
# 16. 행렬 분석
# ============================================
println("16. 행렬 분석 도구:")

A = [1 2 3; 4 5 6; 7 8 9]
println("  A = ")
println("  $A")
println()

println("  tr(A) (대각합) = $(tr(A))")
println("  det(A) (행렬식) = $(det(A))")
println("  rank(A) = $(rank(A))")
println("  norm(A) = $(round(norm(A); digits=3))")
println()

# ============================================
# 17. 역행렬과 의사 역행렬 (Pseudoinverse)
# ============================================
println("17. 의사 역행렬 (Pseudoinverse):")

# 정사각형이 아닌 행렬
A = [1 0; 0 1; 0 0]  # 3×2
println("  A (3×2) = ")
println("  $A")
println()

Apinv = pinv(A)
println("  pinv(A) (2×3) =")
println("  $(round.(Apinv; digits=3))")
println()

# ============================================
# 18. 행렬 지수 함수 (Matrix Exponential)
# ============================================
println("18. 행렬 함수:")

A = [0 1; -1 0]
println("  A = $A")
println()

# 행렬 지수
expA = exp(A)
println("  exp(A) =")
println("  $(round.(expA; digits=3))")
println()

# ============================================
# 19. 선형대수 성능 팁
# ============================================
println("19. 성능 팁:")

println("  ✓ A \\ b 사용 (inv(A) * b 피할 것)")
println("  ✓ 인-플레이스 연산: mul!, lmul!, rmul!")
println("  ✓ 특수 행렬 타입 활용: Diagonal, Triangular")
println("  ✓ BLAS 라이브러리 자동 최적화 (큰 행렬)")
println()

# ============================================
# 20. 시각적 예제: 좌표 변환
# ============================================
println("20. 실전 예제: 좌표 변환 (회전):")

# 30도 회전 행렬
θ = π/6  # 30도
R = [cos(θ) -sin(θ); sin(θ) cos(θ)]
println("  30도 회전 행렬:")
println("  $(round.(R; digits=3))")

# 점 (1, 0) 회전
p = [1; 0]
p_rotated = R * p
println("  점 (1,0)을 30도 회전:")
println("  $(round.(p_rotated; digits=3))")
println("  (≈ (0.866, 0.5))")
println()

println("=== 선형대수 학습 완료! ===")
