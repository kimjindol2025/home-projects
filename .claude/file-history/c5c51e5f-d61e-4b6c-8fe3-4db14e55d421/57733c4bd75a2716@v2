# variables.jl - Julia 변수 선언 패턴

println("=== Julia 변수 선언 패턴 ===")
println()

# ============================================
# 1. 동적 타입 변수 (Dynamic Typing)
# ============================================
println("1. 동적 타입 변수 (타입 자동 추론):")
x = 42                  # 정수
y = 3.14                # 실수
name = "Julia"          # 문자열
is_active = true        # 불린
ch = 'A'                # 문자

println("  x = $x (타입: $(typeof(x)))")
println("  y = $y (타입: $(typeof(y)))")
println("  name = $name (타입: $(typeof(name)))")
println("  is_active = $is_active (타입: $(typeof(is_active)))")
println("  ch = $ch (타입: $(typeof(ch)))")
println()

# ============================================
# 2. 타입 변경 가능 (Type Flexibility)
# ============================================
println("2. 타입 변경 (같은 변수, 다른 타입):")
value = 10
println("  초기: value = $value (타입: $(typeof(value)))")
value = 3.5
println("  변경: value = $value (타입: $(typeof(value)))")
println()

# ============================================
# 3. 정수형 타입 (Integer Types)
# ============================================
println("3. 정수형 타입 (명시적 선언):")
a::Int8 = 100           # -128 ~ 127
b::Int16 = 30000        # -32,768 ~ 32,767
c::Int32 = 2000000      # ~±2 billion
d::Int64 = 9000000000   # ~±9 × 10^18
e::UInt32 = 50000       # 0 ~ 4 billion (음수 없음)

println("  Int8 범위: ", typemin(Int8), " ~ ", typemax(Int8))
println("  Int16 범위: ", typemin(Int16), " ~ ", typemax(Int16))
println("  Int64 범위: ", typemin(Int64), " ~ ", typemax(Int64))
println("  UInt32 범위: ", typemin(UInt32), " ~ ", typemax(UInt32))
println()

# ============================================
# 4. 실수형 타입 (Floating-Point Types)
# ============================================
println("4. 실수형 타입:")
f32::Float32 = 3.14     # 32비트 (7자리 정밀도)
f64::Float64 = 2.71828  # 64비트 (15자리 정밀도)

println("  Float32: $f32 (정밀도: ~7자리)")
println("  Float64: $f64 (정밀도: ~15자리)")
println("  π = $π")
println("  ℯ (e) = $ℯ")
println()

# ============================================
# 5. 특수한 실수값 (Special Float Values)
# ============================================
println("5. 특수한 실수값:")
inf = 1 / 0             # Infinity
neg_inf = -1 / 0        # -Infinity
nan = 0 / 0             # NaN (Not a Number)

println("  1 / 0 = $inf (Infinity)")
println("  -1 / 0 = $neg_inf (-Infinity)")
println("  0 / 0 = $nan (NaN)")
println("  isinf(inf) = $(isinf(inf))")
println("  isnan(nan) = $(isnan(nan))")
println()

# ============================================
# 6. 문자 vs 문자열 (Character vs String)
# ============================================
println("6. 문자 vs 문자열:")
char_val = 'Z'          # Character (작은따옴표)
string_val = "Hello"    # String (큰따옴표)

println("  char_val = $char_val (타입: $(typeof(char_val)))")
println("  string_val = $string_val (타입: $(typeof(string_val)))")
println("  첫 문자: $(string_val[1]) (타입: $(typeof(string_val[1])))")
println()

# ============================================
# 7. 상수 (Constants)
# ============================================
println("7. 상수 정의 (const 키워드):")
const PI_VALUE = 3.141592653589793
const EULER = 2.718281828459045
const SPEED_OF_LIGHT = 3.0e8  # 3 × 10^8

println("  PI_VALUE = $PI_VALUE")
println("  EULER = $EULER")
println("  SPEED_OF_LIGHT = $SPEED_OF_LIGHT")
println()

# ============================================
# 8. 타입 변환 (Type Conversion)
# ============================================
println("8. 타입 변환:")
x_int = 42
y_float = Float64(x_int)    # Int → Float
z_string = String(x_int)    # Int → String

println("  Int(42) → Float64: $y_float")
println("  Int(42) → String: $z_string")

# parse() 함수로 문자열 → 숫자
num_from_string = parse(Int, "123")
float_from_string = parse(Float64, "3.14159")

println("  parse(Int, \"123\") = $num_from_string")
println("  parse(Float64, \"3.14159\") = $float_from_string")
println()

# ============================================
# 9. 타입 승격 (Type Promotion)
# ============================================
println("9. 타입 승격 (자동 변환):")
int_val = 5
float_val = 3.5
result = int_val + float_val

println("  Int(5) + Float64(3.5) = $result")
println("  결과 타입: $(typeof(result))")
println("  (Int → Float로 자동 승격)")
println()

# ============================================
# 10. 스코프 (Scope)
# ============================================
println("10. 변수 스코프:")
global_var = 100

function test_scope()
    local_var = 200
    println("  함수 내부 - local_var: $local_var")
    println("  함수 내부 - global_var: $global_var (접근 가능)")
end

println("  함수 외부 - global_var: $global_var")
test_scope()
# println(local_var)  # 오류! local_var는 함수 내부에만 존재
println()

# ============================================
# 11. 튜플과 여러 할당 (Multiple Assignment)
# ============================================
println("11. 여러 변수 동시 할당:")
a, b, c = 1, 2, 3
println("  a, b, c = 1, 2, 3")
println("  a = $a, b = $b, c = $c")

# 튜플 (Tuple)
tuple_val = (10, 20, 30)
println("  튜플: $tuple_val")
println("  첫 요소: $(tuple_val[1])")

# 튜플 언팩 (Unpacking)
x, y, z = tuple_val
println("  언팩 후: x=$x, y=$y, z=$z")
println()

# ============================================
# 12. 변수 이름 규칙 (Naming Conventions)
# ============================================
println("12. 변수 이름 규칙:")
my_variable = 42        # snake_case (권장)
myVariable = 43         # camelCase (가능)
my_const = 44           # 상수는 UPPER_CASE

println("  snake_case: my_variable = $my_variable")
println("  camelCase: myVariable = $myVariable")
println("  간단한 이름: x = $(5 + 3)")
println()

# ============================================
# 13. Nothing과 Missing
# ============================================
println("13. Nothing과 Missing:")
nothing_val = nothing
missing_val = missing

println("  nothing 반환하는 함수:")
function no_return()
    println("    (아무것도 명시적으로 반환하지 않음)")
end
result = no_return()
println("    반환값: $result (타입: $(typeof(result)))")

println("  Missing (데이터 부재):")
data = [1, 2, missing, 4]
println("    배열: $data")
println("    합계 (생략): $(sum(skipmissing(data)))")
println()

# ============================================
# 14. 변수 존재 확인
# ============================================
println("14. 변수 존재 확인:")
defined_var = 999
println("  @isdefined(defined_var) = $(@isdefined defined_var)")
println("  @isdefined(undefined_var) = $(@isdefined undefined_var)")
println()

# ============================================
# 15. 배열로 여러 변수 초기화
# ============================================
println("15. 배열 분해:")
values = [10, 20, 30, 40]
first, second = values[1], values[2]
println("  배열: $values")
println("  first = $first, second = $second")
println()

println("=== 변수 선언 패턴 학습 완료! ===")
