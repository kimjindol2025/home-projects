# ============================================
# 12. 배열 연산 자동화
# ============================================
println("12. 배열 연산 매크로:")

macro array_op(a, op, b)
    quote
        map($(esc($op)), $(esc($a)), $(esc($b)))
    end
end

arr1 = [1, 2, 3]
arr2 = [4, 5, 6]
result = @array_op(arr1, +, arr2)
println("  @array_op([1,2,3], +, [4,5,6]) = $result")
println()

