# ============================================
# 6. 커스텀 매크로 with 인자
# ============================================
println("6. 인자를 받는 매크로:")

macro repeat_print(expr, n)
    quote
        for _ in 1:$(esc($n))
            println($(esc($expr)))
        end
    end
end

println("  @repeat_print(\"Hello\", 3):")
@repeat_print "Hello" 3
println()

