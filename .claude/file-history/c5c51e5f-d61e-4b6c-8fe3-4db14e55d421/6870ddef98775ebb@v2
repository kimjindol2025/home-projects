# ============================================
# 16. 벤치마킹 매크로 (간단한 버전)
# ============================================
println("16. 벤치마킹:")

macro benchmark_simple(expr)
    quote
        times = []
        for _ in 1:3
            t = @elapsed $(esc($expr))
            push!(times, t)
        end
        (min=minimum(times), max=maximum(times), mean=mean(times))
    end
end

using Statistics
result = @benchmark_simple sum(1:10000)
println("  @benchmark_simple sum(1:10000):")
println("    min: $(result.min)")
println("    max: $(result.max)")
println("    mean: $(result.mean)")
println()

# ============================================
# 17. 매크로 조합
# ============================================
println("17. 여러 매크로 조합:")

macro safe_divide(a, b)
    quote
        if $(esc($b)) == 0
            error("0으로 나눌 수 없습니다")
        else
            $(esc($a)) / $(esc($b))
        end
    end
end

result = @safe_divide(10, 2)
println("  @safe_divide(10, 2) = $result")

try
    @safe_divide(10, 0)
catch e
    println("  @safe_divide(10, 0) → 에러: $e")
end
println()

