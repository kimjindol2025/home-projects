# ============================================
# 1. 기본 매크로
# ============================================
println("1. 기본 매크로:")

macro greet(name)
    quote
        println("Hello, $($(esc($name)))!")
    end
end

println("  @greet \"Julia\"를 호출:")
@greet "Julia"
println()

# ============================================
# 2. quote와 esc
# ============================================
println("2. quote와 esc:")

macro twice(expr)
    quote
        $(esc($expr)) + $(esc($expr))
    end
end

result = @twice(5 + 3)
println("  @twice(5 + 3) = $result  (계산: (5+3) + (5+3) = 16)")
println()

