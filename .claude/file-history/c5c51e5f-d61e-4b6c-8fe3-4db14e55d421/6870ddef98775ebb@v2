println("9. 조건부 매크로:")

const DEBUG = false

macro debug_print(expr)
    if DEBUG
        quote
            println("DEBUG: $($(esc($expr)))")
        end
    else
        esc(expr)
    end
end

result = @debug_print(42)
println("  @debug_print(42) = $result (DEBUG=false이므로 출력 없음)")
println()

