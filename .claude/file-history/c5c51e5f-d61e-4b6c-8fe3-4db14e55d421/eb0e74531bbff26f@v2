# basic-dispatch.jl - Julia Multiple Dispatch 기본 패턴

println("=== Julia Multiple Dispatch 기본 패턴 ===")
println()

# ============================================
# 1. 단일 인자 디스패치 (Single Dispatch)
# ============================================
println("1. 단일 인자 디스패치 (같은 이름, 다른 타입):")

process(x::Int) = "정수: $x (2배: $(x*2))"
process(x::Float64) = "실수: $x (5배: $(x*5))"
process(x::String) = "문자열: $x (3배: $(x^3))"
process(x::Bool) = "불린: $x"

println("  process(42) = $(process(42))")
println("  process(3.14) = $(process(3.14))")
println("  process(\"A\") = $(process("A"))")
println("  process(true) = $(process(true))")
println()

# ============================================
# 2. 다중 인자 디스패치 (Multiple Dispatch) - 핵심!
# ============================================
println("2. 다중 인자 디스패치 (2개 인자의 타입 조합):")

combine(a::Int, b::Int) = a + b
combine(a::String, b::String) = a * b
combine(a::Int, b::String) = "$(a)번 '$(b)'"
combine(a::String, b::Int) = "'$a' × $b회"
combine(a::Float64, b::Float64) = a * b

println("  combine(3, 5) = $(combine(3, 5))")
println("  combine(\"Hello\", \"World\") = $(combine("Hello", "World"))")
println("  combine(2, \"times\") = $(combine(2, "times"))")
println("  combine(\"repeat\", 3) = $(combine("repeat", 3))")
println("  combine(2.5, 4.0) = $(combine(2.5, 4.0))")
println()

# ============================================
# 3. 타입에 따른 다른 동작
# ============================================
println("3. 실전 예제: 정보 표시")

show_type(x::Int) = println("  📊 정수: $x (범위: $(typemin(Int64)) ~ $(typemax(Int64)))")
show_type(x::String) = println("  📝 문자열: \"$x\" (길이: $(length(x)))")
show_type(x::Array) = println("  📦 배열: $(x) (크기: $(length(x)))")
show_type(x::Bool) = println("  ✓/✗ 불린: $x")

show_type(42)
show_type("Julia")
show_type([1, 2, 3])
show_type(true)
println()

# ============================================
# 4. 세 개 이상의 인자
# ============================================
println("4. 세 개 이상의 인자 디스패치:")

operation(a::Int, b::Int, c::Int) = a + b + c
operation(a::String, b::String, c::String) = a * " " * b * " " * c
operation(a::Int, b::String, c::Float64) = "$(a): $b (\$$(c))"

println("  operation(10, 20, 30) = $(operation(10, 20, 30))")
println("  operation(\"Julia\", \"is\", \"great\") = $(operation("Julia", "is", "great"))")
println("  operation(5, \"items\", 9.99) = $(operation(5, "items", 9.99))")
println()

# ============================================
# 5. 기본값과 디스패치
# ============================================
println("5. 기본값이 있는 디스패치:")

greet(name::String) = "Hello, $name!"
greet(name::String, greeting::String) = "$greeting, $name!"

println("  greet(\"Alice\") = $(greet("Alice"))")
println("  greet(\"Bob\", \"Hi\") = $(greet("Bob", "Hi"))")
println()

# ============================================
# 6. 메서드 정보 확인
# ============================================
println("6. 정의된 메서드들 확인:")
println("  process() 함수의 메서드들:")
methods(process)
println()

# ============================================
# 7. 배열 타입별 처리
# ============================================
println("7. 배열과 타입별 처리:")

summarize(x::Int) = "단일 정수"
summarize(x::Array) = "$(length(x))개 원소 배열"
summarize(x::Array{Int}) = "$(length(x))개 정수 배열"
summarize(x::Array{String}) = "$(length(x))개 문자열 배열"

println("  summarize(42) = $(summarize(42))")
println("  summarize([1, 2, 3]) = $(summarize([1, 2, 3]))")
println("  summarize([\"a\", \"b\"]) = $(summarize(["a", "b"]))")
println()

# ============================================
# 8. 튜플 디스패치
# ============================================
println("8. 튜플 타입 디스패치:")

process_tuple(t::Tuple{Int, Int}) = "두 정수: $(t[1]), $(t[2])"
process_tuple(t::Tuple{String, String}) = "두 문자열: $(t[1]), $(t[2])"
process_tuple(t::Tuple{Int, String}) = "정수와 문자열: $(t[1]), $(t[2])"

println("  process_tuple((3, 5)) = $(process_tuple((3, 5)))")
println("  process_tuple((\"a\", \"b\")) = $(process_tuple(("a", "b")))")
println("  process_tuple((10, \"test\")) = $(process_tuple((10, "test")))")
println()

# ============================================
# 9. Any 타입 (모든 타입 수용)
# ============================================
println("9. 유연한 디스패치 (기본 메서드):")

describe(x::Any) = "알 수 없는 타입: $(typeof(x))"
describe(x::Int) = "정수: $x"
describe(x::String) = "문자열: $x"

println("  describe(42) = $(describe(42))")
println("  describe(\"Julia\") = $(describe("Julia"))")
println("  describe(3.14) = $(describe(3.14))")  # 기본 메서드 사용
println()

# ============================================
# 10. 가변 개수 인자 (Varargs)
# ============================================
println("10. 가변 개수 인자 디스패치:")

sum_all(args...) = sum(args)
multiply_all(args::Number...) = prod(args)
join_words(words::String...) = join(words, " ")

println("  sum_all(1, 2, 3, 4, 5) = $(sum_all(1, 2, 3, 4, 5))")
println("  multiply_all(2, 3, 4) = $(multiply_all(2, 3, 4))")
println("  join_words(\"Julia\", \"is\", \"great\") = $(join_words("Julia", "is", "great"))")
println()

# ============================================
# 11. 선택적 인자 (Keyword Arguments)
# ============================================
println("11. 키워드 인자와 디스패치:")

display(text::String) = println("  $text")
display(text::String; uppercase=false) =
    println(uppercase ? "  $(uppercase(text))" : "  $text")

display("hello")                      # 기본
display("hello"; uppercase=true)      # 대문자
println()

# ============================================
# 12. 계산 예제
# ============================================
println("12. 수학 연산 예제:")

square(x::Int) = x ^ 2
square(x::Float64) = x ^ 2.0
square(x::String) = x ^ 2

println("  square(5) = $(square(5))")
println("  square(2.5) = $(square(2.5))")
println("  square(\"ab\") = $(square("ab"))")
println()

# ============================================
# 13. 타입 조사 (Introspection)
# ============================================
println("13. 타입 조사:")

val = 42
println("  typeof(42) = $(typeof(val))")
println("  isa(42, Int) = $(isa(val, Int))")
println("  isa(42, Number) = $(isa(val, Number))")

val2 = "hello"
println("  typeof(\"hello\") = $(typeof(val2))")
println("  isa(\"hello\", String) = $(isa(val2, String))")
println("  isa(\"hello\", Number) = $(isa(val2, Number))")
println()

# ============================================
# 14. 메서드 체인 (Method Chain)
# ============================================
println("14. 메서드 실행 흐름:")

# @which를 사용하여 어느 메서드가 실행되는지 확인
println("  combine(3, 5)에서 사용되는 메서드:")
@show @which combine(3, 5)
println()

# ============================================
# 15. 실전: 계산기
# ============================================
println("15. 실전 예제: 간단한 계산기")

calc(op::String, a::Int, b::Int) =
    op == "+" ? a + b :
    op == "-" ? a - b :
    op == "*" ? a * b :
    op == "/" ? div(a, b) :
    "알 수 없는 연산: $op"

println("  calc(\"+\", 10, 3) = $(calc("+", 10, 3))")
println("  calc(\"-\", 10, 3) = $(calc("-", 10, 3))")
println("  calc(\"*\", 10, 3) = $(calc("*", 10, 3))")
println("  calc(\"/\", 10, 3) = $(calc("/", 10, 3))")
println()

println("=== Multiple Dispatch 기본 패턴 완료! ===")
