# ============================================
# 18. 조건분기 최적화
# ============================================
println(\"18. 조건분기 영향:\")

function branchy_code(n)
    total = 0
    for i in 1:n
        if i % 2 == 0
            total += i
        else
            total -= i
        end
    end
    return total
end

@time result_branch = branchy_code(1000000)
println()

