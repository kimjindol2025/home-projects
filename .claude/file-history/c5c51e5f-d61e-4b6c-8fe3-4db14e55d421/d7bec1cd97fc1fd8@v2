# ============================================
# 11. 타입 추론 문제 감지
# ============================================
println(\"11. 타입 추론 문제:\")

function type_unstable(x)
    if x > 5
        return x + 1        # Int 또는 Float64
    else
        return x * 2.5      # Float64
    end
end

@code_warntype type_unstable(3)
println(\"  타입 불안정성 경고 표시됨 (UNION 타입)\")
println()

# ============================================
# 12. 타입 안정 버전
# ============================================
println(\"12. 타입 안정 버전:\")

function type_stable(x::Int)::Float64
    if x > 5
        return float(x + 1)
    else
        return x * 2.5
    end
end

@code_warntype type_stable(3)
println(\"  타입 안정적 (경고 없음)\")
println()

# ============================================
# 13. 메모리 접근 순서
# ============================================
println(\"13. 메모리 접근 순서 (행 우선 vs 열 우선):\")

M = rand(1000, 1000)

println(\"  행 우선 (캐시 친화적):\")
function row_access(M)
    total = 0.0
    for i in 1:size(M,1)
        for j in 1:size(M,2)
            total += M[i,j]
        end
    end
    return total
end

@time sum_row = row_access(M)

println()
println(\"  열 우선 (Julia 기본, 더 빠름):\")
function col_access(M)
    total = 0.0
    for j in 1:size(M,2)
        for i in 1:size(M,1)
            total += M[i,j]
        end
    end
    return total
end

@time sum_col = col_access(M)
println()

# ============================================
# 14. 함수 인라인
# ============================================
println(\"14. 함수 인라인 최적화:\")

@inline function small_add(x, y)
    return x + y
end

function sum_with_inline(n)
    total = 0
    for i in 1:n
        total = small_add(total, i)
    end
    return total
end

@time result = sum_with_inline(1000000)
println()

