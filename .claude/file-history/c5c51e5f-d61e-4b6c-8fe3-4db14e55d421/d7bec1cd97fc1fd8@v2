# performance-profiling.jl - Julia 성능 프로파일링

using Profile

println("=== Julia 성능 프로파일링 ===\")
println()

# ============================================
# 1. @time 기본 사용
# ============================================
println(\"1. @time 매크로 (첫 실행 - JIT 컴파일 포함):\")

function fibonacci(n)
    if n <= 1
        return n
    end
    return fibonacci(n-1) + fibonacci(n-2)
end

@time result = fibonacci(20)
println(\"  결과: $result\")
println()

# ============================================
# 2. 캐시된 실행 (두 번째 @time)
# ============================================
println(\"2. 캐시된 실행 (두 번째 호출 - 더 빠름):\")

@time result = fibonacci(20)
println()

# ============================================
# 3. @elapsed (시간만 반환)
# ============================================
println(\"3. @elapsed (실행 시간만 반환):\")

elapsed_time = @elapsed result = fibonacci(18)
println(\"  경과 시간: $elapsed_time 초\")
println()

# ============================================
# 4. @allocated (메모리 할당)
# ============================================
println(\"4. @allocated (메모리 할당량):\")

bytes_allocated = @allocated (arr = [1:1000000;]; sum(arr))
println(\"  할당된 메모리: $bytes_allocated 바이트\")
println(\"  할당된 메모리: $(bytes_allocated / 1024 / 1024) MB\")
println()

# ============================================
# 5. 성능 비교: 벡터화 vs 루프
# ============================================
println(\"5. 벡터화 vs 명시적 루프:\")

A = rand(1000, 1000)
B = rand(1000, 1000)

println(\"  벡터화 (점곱 연산):\")\
@time result_vec = sum(A .* B)

println()
println(\"  명시적 루프:\")\
function explicit_dot_product(A, B)
    total = 0.0
    for i in eachindex(A)
        total += A[i] * B[i]
    end
    return total
end

@time result_loop = explicit_dot_product(A, B)
println()

# ============================================
# 6. 메모리 할당 추적
# ============================================
println(\"6. 메모리 할당 패턴:\")

function allocating_function(n)
    results = []
    for i in 1:n
        push!(results, i^2)
    end
    return sum(results)
end

@time result_alloc = allocating_function(1000)
println(\"  결과: $result_alloc\")
println()

# ============================================
# 7. 사전 할당 최적화
# ============================================
println(\"7. 사전 할당 최적화:\")

function preallocated_function(n)
    results = zeros(Int, n)
    for i in 1:n
        results[i] = i^2
    end
    return sum(results)
end

@time result_prealloc = preallocated_function(1000)
println(\"  결과: $result_prealloc\")
println()

# ============================================
# 8. 프로파일링 (프로파일 데이터 수집)
# ============================================
println(\"8. 기본 프로파일링:\")

function expensive_loop(n)
    total = 0
    for i in 1:n
        for j in 1:n
            total += sin(i * j)
        end
    end
    return total
end

# 첫 호출: 워밍업
expensive_loop(10)

