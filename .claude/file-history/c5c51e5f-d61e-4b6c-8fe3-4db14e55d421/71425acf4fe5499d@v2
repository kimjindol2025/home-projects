# ============================================
# 9. 패키지 추가 명령 (실행 필요 없이 설명)
# ============================================
println("9. 패키지 설치 명령어:")

println("  REPL에서 ] 키 누르기:")
println("    (@v1.9) pkg>")
println()

println("  주요 명령어:")
println("    add Plots              # 추가")
println("    add DataFrames         # 추가")
println("    add LinearAlgebra      # 표준 라이브러리")
println("    remove Plots           # 제거")
println("    update Plots           # 업데이트")
println("    update                 # 모두 업데이트")
println("    status                 # 설치 목록")
println()

# ============================================
# 10. 프로그래밍으로 패키지 관리
# ============================================
println("10. 프로그래밍 방식 패키지 관리:")

using Pkg

println("  Pkg.status()           # 설치된 패키지 목록")
println("  Pkg.add(\"Plots\")      # 설치")
println("  Pkg.remove(\"Plots\")   # 제거")
println("  Pkg.update()           # 업데이트")
println("  Pkg.precompile()       # 사전 컴파일")
println()

# ============================================
# 11. 패키지 버전 관리
# ============================================
println("11. 패키지 버전 관리:")

println("  Pkg.add(\"Plots@1.0\")      # 특정 버전")
println("  Pkg.add(\"Plots@^1.0\")     # 호환 버전")
println("  Pkg.status(\"Plots\")       # 패키지 정보")
println()

# ============================================
# 12. Project.toml (메타데이터)
# ============================================
println("12. Project.toml 구조:")

println("  [package]")
println("  name = \"MyProject\"")
println("  version = \"0.1.0\"")
println()
println("  [deps]")
println("  LinearAlgebra = \"37e2e46d-...\"")
println("  Plots = \"91a5bcdd-...\"")
println()
println("  [compat]")
println("  Plots = \"1.0\"")
println()

# ============================================
# 13. 환경 관리
# ============================================
println("13. Julia 환경 (Environment) 관리:")

println("  ] activate .           # 로컬 환경 활성화")
println("  ] activate             # 전역 환경으로 돌아가기")
println("  ] activate MyProject   # 특정 환경")
println()

println("  활성 환경는 REPL 프롬프트에 표시:")
println("    (@v1.9) pkg>        # 전역")
println("    (MyProject) pkg>     # 로컬")
println()

