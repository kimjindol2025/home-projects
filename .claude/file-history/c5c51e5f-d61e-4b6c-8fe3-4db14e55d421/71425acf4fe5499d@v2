# packages.jl - Julia 패키지 관리와 사용

println("=== Julia 패키지 관리 (Package Management) ===")
println()

# ============================================
# 1. 표준 라이브러리 패키지
# ============================================
println("1. 표준 라이브러리 패키지:")

# 이미 포함된 표준 패키지들
println("  표준 패키지 (설치 불필요):")
println("    - LinearAlgebra (선형대수)")
println("    - Statistics (통계)")
println("    - Random (난수)")
println("    - Dates (날짜/시간)")
println("    - DelimitedFiles (CSV)")
println()

# ============================================
# 2. LinearAlgebra 사용
# ============================================
println("2. LinearAlgebra 패키지:")

using LinearAlgebra

A = [1 2; 3 4]
println("  A = $A")
println("  det(A) = $(det(A))      (행렬식)")
println("  inv(A) ≈ $(round.(inv(A); digits=2))  (역행렬)")
println("  norm(A) = $(round(norm(A); digits=2))  (노름)")
println()

# ============================================
# 3. Statistics 사용
# ============================================
println("3. Statistics 패키지:")

using Statistics

data = [1, 2, 3, 4, 5, 10]
println("  data = $data")
println("  mean(data) = $(mean(data))")
println("  std(data) = $(round(std(data); digits=2))")
println("  var(data) = $(round(var(data); digits=2))")
println()

# ============================================
# 4. Random 사용
# ============================================
println("4. Random 패키지:")

using Random

Random.seed!(42)  # 재현성
random_vec = rand(3)
println("  Random.seed!(42)")
println("  rand(3) = $(round.(random_vec; digits=2))")

random_int = rand(1:10, 5)
println("  rand(1:10, 5) = $random_int")
println()

# ============================================
# 5. Dates 사용
# ============================================
println("5. Dates 패키지:")

using Dates

today_date = today()
println("  today() = $today_date")

now_time = now()
println("  now() = $now_time")

# 날짜 연산
future = today_date + Day(7)
println("  today() + Day(7) = $future")
println()

# ============================================
# 6. using 다양한 문법
# ============================================
println("6. using 문법 다양성:")

# 전체 import
using LinearAlgebra

# 특정 함수만 import
using Statistics: mean, std

# 별칭 지정
using Dates: Date as D

println("  using LinearAlgebra          # 전체")
println("  using Statistics: mean, std  # 선택적")
println("  using Dates: Date as D       # 별칭")
println()

