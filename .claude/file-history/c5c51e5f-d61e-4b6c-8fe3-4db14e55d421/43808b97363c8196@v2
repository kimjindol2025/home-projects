# 수학 연산 정의
round_to_int(x::Integer) = x
round_to_int(x::Real) = round(Int, x)

println("  round_to_int(42) = $(round_to_int(42))")
println("  round_to_int(3.7) = $(round_to_int(3.7))")
println()

# ============================================
# 7. 신호 처리 예제
# ============================================
println("7. 신호 처리 타입 계층:")

abstract type Signal end

struct SineWave <: Signal
    frequency::Float64
    amplitude::Float64
end

struct SquareWave <: Signal
    frequency::Float64
    amplitude::Float64
end

struct NoiseSignal <: Signal
    amplitude::Float64
end

# 신호 특성 분석
get_frequency(s::Signal) = error("주파수 미정의")
get_frequency(s::SineWave) = s.frequency
get_frequency(s::SquareWave) = s.frequency
get_frequency(s::NoiseSignal) = 0  # 잡음은 주파수 없음

get_amplitude(s::Signal) = error("진폭 미정의")
get_amplitude(s::SineWave) = s.amplitude
get_amplitude(s::SquareWave) = s.amplitude
get_amplitude(s::NoiseSignal) = s.amplitude

# 신호 설명
describe(s::Signal) = "신호 (타입: $(typeof(s)))"
describe(s::SineWave) = "사인파 (주파수: $(s.frequency)Hz, 진폭: $(s.amplitude)V)"
describe(s::SquareWave) = "구형파 (주파수: $(s.frequency)Hz, 진폭: $(s.amplitude)V)"
describe(s::NoiseSignal) = "잡음 (진폭: $(s.amplitude)V)"

sine = SineWave(50.0, 1.0)
square = SquareWave(100.0, 2.0)
noise = NoiseSignal(0.5)

println("  describe(SineWave(...)) = $(describe(sine))")
println("  describe(SquareWave(...)) = $(describe(square))")
println("  describe(NoiseSignal(...)) = $(describe(noise))")
println()

# ============================================
# 8. 벡터 타입 (Vector Type Hierarchy)
# ============================================
println("8. 벡터 타입 계층:")

abstract type Vector2D end

struct CartesianVector <: Vector2D
    x::Float64
    y::Float64
end

struct PolarVector <: Vector2D
    r::Float64
    θ::Float64
end

# 벡터 길이
magnitude(v::CartesianVector) = sqrt(v.x^2 + v.y^2)
magnitude(v::PolarVector) = v.r

# 벡터 출력
show_vector(v::CartesianVector) = "($(v.x), $(v.y))"
show_vector(v::PolarVector) = "(r=$(v.r), θ=$(v.θ))"

cv = CartesianVector(3.0, 4.0)
pv = PolarVector(5.0, 0.927)  # ~53도

println("  Cartesian $(show_vector(cv)) 크기: $(magnitude(cv))")
println("  Polar $(show_vector(pv)) 크기: $(magnitude(pv))")
println()

# ============================================
# 9. Union 타입 (여러 타입 한번에)
# ============================================
println("9. Union 타입 (여러 타입 수용):")

# 숫자 또는 문자열을 받을 수 있는 함수
process_value(v::Union{Int, String}) =
    if isa(v, Int)
        "정수: $(v * 2)"
    else
        "문자열: $(v * 3)"
    end

println("  process_value(5) = $(process_value(5))")
println("  process_value(\"Hi\") = $(process_value("Hi"))")
println()

