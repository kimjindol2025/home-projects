# ============================================
# 12. 제네릭 컨테이너 (Generic Container)
# ============================================
println("12. 제네릭 컨테이너:")

struct Container{T}
    content::T
end

# 다양한 컨테이너
int_container = Container{Int}(42)
str_container = Container{String}("Julia")
shape_container = Container{Circle}(Circle(5.0))

println("  Container{Int}(42): $(int_container.content)")
println("  Container{String}(\"Julia\"): $(str_container.content)")
println("  Container{Circle}(Circle(5.0)): $(shape_container.content)")
println()

