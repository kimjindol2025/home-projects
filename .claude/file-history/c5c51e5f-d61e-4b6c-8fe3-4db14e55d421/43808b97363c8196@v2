# abstract-types.jl - 추상 타입과 타입 계층구조

println("=== Julia 추상 타입과 타입 계층 ===")
println()

# ============================================
# 1. 추상 타입 정의 (Abstract Type Definition)
# ============================================
println("1. 추상 타입 정의:")

# 도형을 나타내는 추상 타입
abstract type Shape end

# 구체적 타입들 (Shape를 상속)
struct Circle <: Shape
    radius::Float64
end

struct Rectangle <: Shape
    width::Float64
    height::Float64
end

struct Triangle <: Shape
    side1::Float64
    side2::Float64
    side3::Float64
end

println("  추상 타입 Shape 정의")
println("  ✓ Circle <: Shape")
println("  ✓ Rectangle <: Shape")
println("  ✓ Triangle <: Shape")
println()

# ============================================
# 2. Shape별 넓이 계산
# ============================================
println("2. 다형성 (Polymorphism):")

# 넓이 계산 (기본 구현)
function area(s::Shape)
    error("area 메서드가 $(typeof(s)) 타입에 대해 구현되지 않았습니다")
end

# 각 도형별 구현
area(c::Circle) = π * c.radius ^ 2
area(r::Rectangle) = r.width * r.height
area(t::Triangle) = begin
    # Heron's formula
    s = (t.side1 + t.side2 + t.side3) / 2
    sqrt(s * (s - t.side1) * (s - t.side2) * (s - t.side3))
end

# 테스트
c = Circle(5.0)
r = Rectangle(4.0, 6.0)
t = Triangle(3.0, 4.0, 5.0)  # 직각삼각형

println("  Circle(5.0) 넓이: $(round(area(c); digits=2))")
println("  Rectangle(4, 6) 넓이: $(area(r))")
println("  Triangle(3, 4, 5) 넓이: $(area(t))")
println()

# ============================================
# 3. 둘레 계산
# ============================================
println("3. 같은 인터페이스, 다른 구현:")

function perimeter(s::Shape)
    error("perimeter 메서드가 구현되지 않았습니다")
end

perimeter(c::Circle) = 2 * π * c.radius
perimeter(r::Rectangle) = 2 * (r.width + r.height)
perimeter(t::Triangle) = t.side1 + t.side2 + t.side3

println("  Circle(5.0) 둘레: $(round(perimeter(c); digits=2))")
println("  Rectangle(4, 6) 둘레: $(perimeter(r))")
println("  Triangle(3, 4, 5) 둘레: $(perimeter(t))")
println()

# ============================================
# 4. 동물 타입 계층 (Animal Hierarchy)
# ============================================
println("4. 다중 레벨 타입 계층:")

# 최상위
abstract type Animal end

# 첫 번째 레벨
abstract type Mammal <: Animal end
abstract type Bird <: Animal end

# 두 번째 레벨
abstract type Predator <: Mammal end
abstract type Herbivore <: Mammal end

# 구체적 타입
struct Dog <: Predator
    name::String
    age::Int
end

struct Cat <: Predator
    name::String
end

struct Deer <: Herbivore
    name::String
    weight::Float64
end

struct Eagle <: Bird
    name::String
    wingspan::Float64
end

println("  타입 계층:")
println("    Animal")
println("      ├─ Mammal")
println("      │   ├─ Predator")
println("      │   │   ├─ Dog")
println("      │   │   └─ Cat")
println("      │   └─ Herbivore")
println("      │       └─ Deer")
println("      └─ Bird")
println("          └─ Eagle")
println()

# ============================================
# 5. 타입 계층을 이용한 디스패치
# ============================================
println("5. 타입 계층 기반 디스패치:")

# 일반적인 동물 동작
sound(a::Animal) = "???"

# 포식동물과 초식동물
sound(p::Predator) = "포식동물: 으르렁"
sound(h::Herbivore) = "초식동물: 음메"

# 구체적 종
sound(d::Dog) = "멍멍! (이름: $(d.name), 나이: $(d.age))"
sound(c::Cat) = "야옹 (이름: $(c.name))"
sound(e::Eagle) = "애애앙 (날개폭: $(e.wingspan)m)"

# 테스트
dog = Dog("Buddy", 5)
cat = Cat("Whiskers")
deer = Deer("Bambi", 50.0)
eagle = Eagle("Sky", 2.0)

println("  sound(Dog(\"Buddy\", 5)) = $(sound(dog))")
println("  sound(Cat(\"Whiskers\")) = $(sound(cat))")
println("  sound(Deer(...)) = $(sound(deer))")
println("  sound(Eagle(...)) = $(sound(eagle))")
println()

# ============================================
# 6. 수학 타입 계층
# ============================================
println("6. 수학 타입 계층 (내장):")

# Julia의 기본 타입 계층 확인
println("  Int <: Number → $(Int <: Number)")
println("  Int <: Integer → $(Int <: Integer)")
println("  Integer <: Real → $(Integer <: Real)")
