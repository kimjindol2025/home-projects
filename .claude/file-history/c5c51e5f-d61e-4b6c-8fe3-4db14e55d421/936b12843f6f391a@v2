# broadcasting.jl - Julia 브로드캐스팅 (차원 자동 확장)

println("=== Julia 브로드캐스팅 (Broadcasting) ===")
println()

# ============================================
# 1. 브로드캐스팅의 개념
# ============================================
println("1. 브로드캐스팅 개념 (. 연산자):")

a = [1, 2, 3]
b = [10]

println("  a = $a (길이 3)")
println("  b = $b (길이 1)")
println()

# 브로드캐스팅으로 자동 확장
result = a .+ b
println("  a .+ b = $result")
println("  (b가 [10, 10, 10]으로 자동 확장)")

result2 = a .* 2
println("  a .* 2 = $result2")
println("  (스칼라 2가 [2, 2, 2]으로 자동 확장)")
println()

# ============================================
# 2. 1D 브로드캐스팅 (Vector)
# ============================================
println("2. 1D 배열 브로드캐스팅:")

v1 = [1, 2, 3, 4]
v2 = [10, 20, 30, 40]

println("  v1 = $v1")
println("  v2 = $v2")
println()

# 원소별 연산 (. 필수!)
add = v1 .+ v2
sub = v1 .- v2
mul = v1 .* v2
div = v1 ./ v2

println("  v1 .+ v2 = $add")
println("  v1 .- v2 = $sub")
println("  v1 .* v2 = $mul")
println("  v1 ./ v2 = $(round.(div; digits=2))")
println()

# 함수 브로드캐스팅
sqrt_result = sqrt.(v1)
sin_result = sin.(v1)
println("  sqrt.(v1) = $(round.(sqrt_result; digits=2))")
println("  sin.(v1) = $(round.(sin_result; digits=2))")
println()

# ============================================
# 3. 2D 브로드캐스팅 (Matrix)
# ============================================
println("3. 2D 배열 브로드캐스팅:")

A = [1 2 3; 4 5 6]
B = [10 20 30; 40 50 60]

println("  A (2×3) = ")
println("  $A")
println("  B (2×3) = ")
println("  $B")
println()

# 같은 크기 간 연산
result_add = A .+ B
println("  A .+ B =")
println("  $result_add")
println()

# ============================================
# 4. 크기가 다른 배열의 브로드캐스팅
# ============================================
println("4. 다른 크기 배열 브로드캐스팅:")

A = [1 2 3; 4 5 6]  # 2×3
b = [10, 100]       # 2 (길이)

println("  A (2×3) = ")
println("  $A")
println("  b (길이 2) = $b")
println()

# 각 행에 b 더함
result = A .+ b'    # b'로 전치
println("  A .+ b' (각 행에 [10, 100] 더함) =")
println("  $result")
println()

# ============================================
# 5. 스칼라와 배열의 브로드캐스팅
# ============================================
println("5. 스칼라 연산 브로드캐스팅:")

A = [1 2 3; 4 5 6]
println("  A = ")
println("  $A")
println()

# 스칼라 연산
println("  A .+ 10 =")
println("  $(A .+ 10)")

println("  A .* 2 =")
println("  $(A .* 2)")

println("  A .^ 2 =")
println("  $(A .^ 2)")
println()

# ============================================
# 6. 비교 연산자와 브로드캐스팅
# ============================================
println("6. 비교 연산자 브로드캐스팅:")

v = [1, 2, 3, 4, 5]
println("  v = $v")
println()

# 비교 연산
gt2 = v .> 2
le4 = v .<= 4
eq3 = v .== 3

println("  v .> 2 = $gt2")
println("  v .<= 4 = $le4")
println("  v .== 3 = $eq3")
println()

# 불린 배열로 필터링
filtered = v[v .> 2]
println("  v[v .> 2] = $filtered (필터링)")
println()

# ============================================
# 7. 복잡한 브로드캐스팅
# ============================================
println("7. 복잡한 브로드캐스팅 표현식:")

A = [1 2 3; 4 5 6]
b = [10, 20]
c = 5

println("  A = ")
println("  $A")
println("  b = $b")
println("  c = $c")
println()

# 복합 연산
result = (A .+ b') .* c
println("  (A .+ b') .* c =")
println("  $result")
println()

# ============================================
# 8. 인-플레이스 브로드캐스팅 (.=)
# ============================================
println("8. 인-플레이스 브로드캐스팅 (.=):")

v = [1, 2, 3, 4, 5]
println("  초기: v = $v")

# 인-플레이스 수정 (새 배열 생성 안 함, 메모리 절약)
v .= v .* 2
println("  v .= v .* 2 => $v")

v .+= 10
println("  v .+= 10 => $v")

v .*= 0.5
println("  v .*= 0.5 => $v")
println()

# ============================================
# 9. 함수 브로드캐스팅 (함수 도트)
# ============================================
println("9. 함수 브로드캐스팅:")

# 내장 함수
v = [0, π/6, π/4, π/3, π/2]
println("  각도: $v")
println()

# 함수 앞에 . 붙이기
sin_vals = sin.(v)
cos_vals = cos.(v)
tan_vals = tan.(v)

println("  sin.(v) = $(round.(sin_vals; digits=3))")
println("  cos.(v) = $(round.(cos_vals; digits=3))")
println("  tan.(v) = $(round.(tan_vals; digits=3))")
println()

# 사용자 정의 함수도 가능
square(x) = x^2
v = [1, 2, 3, 4]
squared = square.(v)
println("  square(x) = x^2")
println("  square.([1,2,3,4]) = $squared")
println()

# ============================================
# 10. 브로드캐스팅 규칙 (Broadcasting Rules)
# ============================================
println("10. 브로드캐스팅 규칙:")

# 규칙: 차원이 작은 쪽이 큰 쪽에 맞춰짐
println("  배열 크기가 다를 때:")
println("  크기 1인 차원은 다른 크기로 반복됨")
println()

# 예제
A = [1 2 3]         # 1×3
B = [1; 2; 3; 4]    # 4×1

println("  A (1×3) = $A")
println("  B (4×1) = $B")
println()

result = A .+ B
println("  A .+ B (4×3 결과) =")
println("  $result")
println()

# ============================================
# 11. 모양 확인 (@. 매크로)
# ============================================
println("11. @. 매크로 (모든 . 자동 붙이기):")

A = [1 2 3]
B = [4 5 6]

# 일반 방식
result1 = A .+ B .* 2
println("  A .+ B .* 2 = $result1")

# @. 매크로 (모든 연산에 . 자동 붙음)
result2 = @. A + B * 2
println("  @. A + B * 2 = $result2 (동일)")
println()

# ============================================
# 12. 뷰와 브로드캐스팅 (@views)
# ============================================
println("12. 뷰 (@views)로 메모리 절약:")

A = collect(1:9)
println("  배열: $A")
println()

# 일반 인덱싱 (복사 생성)
B = A[1:3]
B[1] = 999
println("  B = A[1:3]; B[1] = 999")
println("  A = $A (원본 변경 안 됨)")

# 뷰 (같은 메모리 참조)
A = collect(1:9)
B = @view A[1:3]
B[1] = 999
println("  B = @view A[1:3]; B[1] = 999")
println("  A = $A (원본 변경됨!)")
println()

# ============================================
# 13. 행렬-벡터 브로드캐스팅
# ============================================
println("13. 행렬-벡터 브로드캐스팅:")

A = [1 2 3; 4 5 6]   # 2×3
v = [1, 2, 3]        # 길이 3

println("  A (2×3) = ")
println("  $A")
println("  v (길이 3) = $v")
println()

# 각 행에 v 곱함
result = A .* v
println("  A .* v (각 행에 v를 곱함) =")
println("  $result")
println()

# ============================================
# 14. 행렬-행렬 브로드캐스팅
# ============================================
println("14. 다차원 배열 브로드캐스팅:")

# 3D 배열
A = reshape(1:8, 2, 2, 2)
B = reshape(10:17, 2, 2, 2)

println("  A (2×2×2):")
println("  $(A[:,:,1])")

result = A .+ B
println("  A .+ B 결과 (첫 슬라이스):")
println("  $(result[:,:,1])")
println()

# ============================================
# 15. 성능: 브로드캐스팅 vs 루프
# ============================================
println("15. 성능 비교:")

# 루프 방식
@time begin
    v1 = rand(10000)
    v2 = rand(10000)
    result = zeros(10000)
    for i in 1:10000
        result[i] = v1[i] + v2[i]
    end
end

# 브로드캐스팅 방식
@time begin
    v1 = rand(10000)
    v2 = rand(10000)
    result = v1 .+ v2
end

println("  위: for 루프 방식")
println("  아래: 브로드캐스팅 방식 (더 빠름!)")
println()

# ============================================
# 16. 조건부 브로드캐스팅 (Ternary with .)
# ============================================
println("16. 조건부 브로드캐스팅:")

v = [1, 2, 3, 4, 5]
println("  v = $v")
println()

# 각 원소가 3보다 크면 'x', 아니면 'o'
result = ifelse.(v .> 3, "x", "o")
println("  ifelse.(v .> 3, \"x\", \"o\") = $result")
println()

# ============================================
# 17. 브로드캐스팅과 논리 연산
# ============================================
println("17. 논리 연산 브로드캐스팅:")

A = [true, false, true]
B = [true, true, false]

println("  A = $A")
println("  B = $B")
println()

println("  A .& B = $(A .& B)  (AND)")
println("  A .| B = $(A .| B)  (OR)")
println("  .!A = $(.!A)  (NOT)")
println()

# ============================================
# 18. 실전 예제: 정규화 (Normalization)
# ============================================
println("18. 실전 예제: 데이터 정규화:")

data = [1 100 10000; 2 200 20000; 3 300 30000]
println("  원본 데이터:")
println("  $data")
println()

# 각 열의 최댓값으로 정규화
max_vals = maximum(data, dims=1)
normalized = data ./ max_vals

println("  열 최댓값: $max_vals")
println("  정규화된 데이터:")
println("  $(round.(normalized; digits=3))")
println()

# ============================================
# 19. 브로드캐스팅 디버깅 (크기 확인)
# ============================================
println("19. 브로드캐스팅 디버깅:")

A = rand(3, 4)
B = rand(3)

println("  A 크기: $(size(A))")
println("  B 크기: $(size(B))")
println()

try
    result = A .+ B
    println("  성공: A .+ B'로 수정하면 가능")
catch e
    println("  에러: $e")
end
println()

# ============================================
# 20. 참고: 점 연산자 vs 일반 연산
# ============================================
println("20. 점 연산자 필수 vs 선택:")

v1 = [1, 2]
v2 = [3, 4]

println("  v1 = $v1")
println("  v2 = $v2")
println()

println("  v1 + v2 (벡터 덧셈) = $(v1 + v2)")
println("  v1 .+ v2 (원소별 덧셈) = $(v1 .+ v2)")
println("  (이 경우 둘 다 같은 결과)")
println()

println("  v1 * v2 (오류! 내적하려면 dot(v1,v2))")
println("  v1 .* v2 (원소곱) = $(v1 .* v2)")
println()

println("=== 브로드캐스팅 완료! ===")
