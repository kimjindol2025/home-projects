# repl_basics.jl - Julia REPL 기초 사용법

println("=== Julia REPL 기초 ===")
println()

# 1. 기본 계산
println("1. 기본 계산:")
result = 2 + 3 * 4
println("2 + 3 * 4 = $result")
println()

# 2. 변수 선언
println("2. 변수 선언:")
x = 42
y = 3.14
name = "Alice"
println("x = $x (타입: $(typeof(x)))")
println("y = $y (타입: $(typeof(y)))")
println("name = $name (타입: $(typeof(name)))")
println()

# 3. 문자열 보간
println("3. 문자열 보간:")
age = 25
println("$name은 $age세입니다")
println("$x + $y = $(x + y)")
println()

# 4. 배열
println("4. 배열:")
numbers = [1, 2, 3, 4, 5]
println("배열: $numbers")
println("첫 번째 요소: $(numbers[1])")
println("배열의 크기: $(length(numbers))")
println()

# 5. 반복문
println("5. for 루프:")
for i in 1:3
    println("  i = $i, i² = $(i^2)")
end
println()

# 6. 조건문
println("6. 조건문:")
if x > 40
    println("  x는 40보다 큽니다")
else
    println("  x는 40 이하입니다")
end
println()

# 7. 함수 호출
println("7. 내장 함수:")
println("√16 = $(sqrt(16))")
println("π ≈ $π")
println("sin(π/2) = $(sin(π/2))")
println()

println("=== REPL 기초 학습 완료! ===")
