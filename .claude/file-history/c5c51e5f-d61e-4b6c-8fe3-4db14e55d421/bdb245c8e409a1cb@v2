# 8. 튜플 언팩킹
# ============================================
println(\"8. 튜플 언팩 최적화:\")

@generated function unpack_tuple(::Type{T}) where T <: Tuple
    N = length(T.parameters)
    Expr(:tuple, [:(t[$i]) for i in 1:N]...)
end

println(\"  튜플 언팩킹 코드 생성 완료\")
println()

# ============================================
# 9. 배열 크기 기반 최적화
# ============================================
println(\"9. 배열 크기별 최적화:\")

@generated function fixed_size_op(v::Vector{T}) where T
    n = length(v)
    if n == 2
        :(v[1] + v[2])
    elseif n == 3
        :(v[1] + v[2] + v[3])
    else
        :(sum(v))
    end
end

println(\"  fixed_size_op([1, 2]) = $(fixed_size_op([1, 2]))\")
println(\"  fixed_size_op([1, 2, 3]) = $(fixed_size_op([1, 2, 3]))\")
println(\"  fixed_size_op([1, 2, 3, 4, 5]) = $(fixed_size_op([1, 2, 3, 4, 5]))\")
println()

