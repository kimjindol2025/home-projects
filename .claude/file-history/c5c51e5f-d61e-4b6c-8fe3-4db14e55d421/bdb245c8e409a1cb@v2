println(\"6. 바이트코드 최적화 시뮬레이션:\")

@generated function optimized_loop(n::Int)
    if n <= 10
        :(sum(1:$n))  # 상수 전개
    else
        :(sum(1:n))   # 일반 루프
    end
end

println(\"  optimized_loop(5) = $(optimized_loop(5))\")
println(\"  optimized_loop(100) = $(optimized_loop(100))\")
println()

