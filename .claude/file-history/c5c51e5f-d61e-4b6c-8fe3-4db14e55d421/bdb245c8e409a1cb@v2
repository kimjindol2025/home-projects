println(\"19. 메타정보 접근:\")

@generated function get_type_info(x::T) where T
    typename = string(T)
    :(\"타입: $($typename)\")
end

println(\"  get_type_info(42) = $(get_type_info(42))\")
println(\"  get_type_info(3.14) = $(get_type_info(3.14))\")
println()

