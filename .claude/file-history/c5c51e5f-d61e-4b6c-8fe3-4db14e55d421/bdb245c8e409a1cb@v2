# 13. 추상 타입 처리
# ============================================
println(\"13. 추상 타입 기반 생성:\")

@generated function handle_numeric(x::T) where T <: Number
    if T <: Integer
        :(x * 2)
    elseif T <: AbstractFloat
        :(x + 0.5)
    else
        :(x)
    end
end

println(\"  handle_numeric(5) = $(handle_numeric(5))\")
println(\"  handle_numeric(5.5) = $(handle_numeric(5.5))\")
println()

# ============================================
# 14. 인자 수 기반 분기
# ============================================
println(\"14. 가변 인자 처리:\")

@generated function var_args(args::Tuple)
    n = length(args.parameters)
    Expr(:call, :+, [:(args[$i]) for i in 1:n]...)
end

println(\"  var_args((1, 2)) = $(var_args((1, 2)))\")
println(\"  var_args((1, 2, 3, 4, 5)) = $(var_args((1, 2, 3, 4, 5)))\")
println()

