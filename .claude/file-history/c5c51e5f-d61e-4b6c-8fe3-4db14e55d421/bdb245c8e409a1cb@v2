println(\"11. 내부 표현 접근:\")

@generated function peek_internals(v::Vector{T}) where T
    println(\"  컴파일 중: Vector{$T}\")
    :(v)
end

vec = [1, 2, 3]
result = peek_internals(vec)
println(\"  Vector 컴파일 메시지 출력 완료\")
println()

# ============================================
# 12. 타입 체크 결합
# ============================================
println(\"12. 복합 타입 체크:\")

@generated function smart_div(x::T, y::T) where T
    if T <: AbstractFloat
        :(x / y)
    elseif T <: Integer
        :(div(x, y))
    else
        error(\"숫자 타입만 지원\")
    end
end

println(\"  smart_div(10, 3) = $(smart_div(10, 3)) (정수 나눗셈)\")
println(\"  smart_div(10.0, 3.0) = $(smart_div(10.0, 3.0)) (실수 나눗셈)\")
println()

