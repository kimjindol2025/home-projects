# 20. 실전 사용 예시
# ============================================
println(\"20. 실전: 제너릭 함수 라이브러리:\")

@generated function generic_max(a::T, b::T) where T
    if T <: Number
        :(a > b ? a : b)
    else
        error(\"비교 가능한 타입 필요\")
    end
end

println(\"  generic_max(10, 5) = $(generic_max(10, 5))\")
println(\"  generic_max(3.5, 7.2) = $(generic_max(3.5, 7.2))\")
println()

