# 15. 조건부 컴파일 패턴
# ============================================
println(\"15. 버전별 컴파일:\")

@generated function version_specific(x::T) where T
    if VERSION >= v\"1.8\"
        :(x^2)
    else
        :(x * x)
    end
end

println(\"  version_specific(5) = $(version_specific(5))\")
println()

# ============================================
# 16. 성능 비교 (생성함수 vs 일반 함수)
# ============================================
println(\"16. 성능 시뮬레이션:\")

function regular_add(x, y)
    if isa(x, Integer)
        x + y
    else
        x + y + 0.0
    end
end

@generated function generated_add(x::T, y::T) where T
    if T <: Integer
        :(x + y)
    else
        :(x + y + 0.0)
    end
end

println(\"  generated_add는 컴파일 시점에 최적화\")
println(\"  regular_add는 런타임 분기\")
println()

# ============================================
# 17. 에러 처리
# ============================================
println(\"17. 생성함수 에러 처리:\")

@generated function safe_gen(x::T) where T
    if T <: Number
        :(x * 2)
    else
        error(\"수치 타입만 허용됨\")
    end
end

println(\"  safe_gen(5) = $(safe_gen(5))\")
try
    safe_gen(\"hello\")
catch e
    println(\"  safe_gen(\\\"hello\\\") → 에러: 수치 타입만 허용됨\")
end
println()

# ============================================
# 18. 재귀 생성함수
# ============================================
println(\"18. 재귀 구조 생성:\")

@generated function recursive_sum(v::Vector{T}) where T
    if length(v.parameters) == 0
        :(0)
    else
        :(v[1] + sum(v[2:end]))
    end
end

println(\"  생성함수의 재귀적 코드 생성 가능\")
println()

