# 7. 구조체 필드 접근 최적화
# ============================================
println(\"7. 구조체 필드 접근:\")

struct Person
    name::String
    age::Int
end

@generated function get_field(obj::T, ::Val{field}) where {T, field}
    if field == :name
        :(obj.name)
    elseif field == :age
        :(obj.age)
    else
        error(\"필드 없음\")
    end
end

p = Person(\"Alice\", 30)
println(\"  person.name = $(get_field(p, Val(:name)))\")
println(\"  person.age = $(get_field(p, Val(:age)))\")
println()

