# generated-functions.jl - Julia 생성함수와 고급 메타프로그래밍

println("=== Julia 생성함수 (@generated) ===\")
println()

# ============================================
# 1. 기본 생성함수 개념
# ============================================
println("1. 기본 생성함수:\"")

@generated function my_add(x::T, y::T) where T
    if T <: Integer
        :(x + y)
    else
        :(x + y + 0.0)
    end
end

result_int = my_add(5, 3)
result_float = my_add(5.0, 3.0)
println(\"  my_add(5, 3) = $result_int (정수)\")
println(\"  my_add(5.0, 3.0) = $result_float (실수)\")
println()

# ============================================
# 2. 타입에 따른 최적화
# ============================================
println(\"2. 타입별 최적화 생성함수:\")

@generated function process(x::T) where T
    if T <: Integer
        :(x * 2)
    elseif T <: AbstractFloat
        :(x / 2.0)
    else
        :(length(x))
    end
end

println(\"  process(10) = $(process(10)) (정수)\")
println(\"  process(10.0) = $(process(10.0)) (실수)\")
println(\"  process([1,2,3]) = $(process([1,2,3])) (배열)\")
println()

# ============================================
# 3. 벡터화된 생성함수
# ============================================
println(\"3. 벡터 연산 최적화:\")

@generated function vector_op(v::Vector{T}) where T
    if T <: Number
        :(sum(v))
    else
        :(length(v))
    end
end

vec_num = [1, 2, 3, 4, 5]
vec_str = [\"a\", \"b\", \"c\"]
println(\"  vector_op([1,2,3,4,5]) = $(vector_op(vec_num))\")
println(\"  vector_op([\\\"a\\\",\\\"b\\\",\\\"c\\\"]) = $(vector_op(vec_str))\")
println()

# ============================================
# 4. 행렬 연산 생성함수
# ============================================
println(\"4. 행렬 연산 생성함수:\")

@generated function matrix_trace(M::Matrix{T}) where T
    if T <: Number
        :(sum(diag(M)))
    else
        error(\"수치 타입 필요\")
    end
end

mat = [1 2; 3 4]
println(\"  matrix_trace([1 2; 3 4]) = $(matrix_trace(mat))\")
println()

# ============================================
# 5. 조건부 메서드 생성
# ============================================
println(\"5. 조건부 생성:\")

@generated function conditional_process(x::T, y::T) where T
    if T <: Integer
        :(x > y ? x : y)  # max
    else
        :(x + y)  # sum
    end
end

println(\"  conditional_process(5, 3) = $(conditional_process(5, 3)) (정수: max)\")
println(\"  conditional_process(5.0, 3.0) = $(conditional_process(5.0, 3.0)) (실수: sum)\")
println()

