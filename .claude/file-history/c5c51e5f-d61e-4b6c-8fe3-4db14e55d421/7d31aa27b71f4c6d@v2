using Base.Threads

function parallel_process(data::Vector)
    result = similar(data)
    @threads for i in eachindex(data)
        result[i] = sqrt(abs(data[i])) + sin(data[i])
    end
    return result
end

test_data = randn(10000)
@time parallel_result = parallel_process(test_data)
println()

