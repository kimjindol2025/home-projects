function measure_time(f::Function, args...)
    start = time()
    result = f(args...)
    elapsed = time() - start
    println(\"    시간: $(round(elapsed*1000; digits=2))ms\")
    return result
end

fibonacci(n) = n <= 1 ? n : fibonacci(n-1) + fibonacci(n-2)

result = measure_time(fibonacci, 20)
println()

