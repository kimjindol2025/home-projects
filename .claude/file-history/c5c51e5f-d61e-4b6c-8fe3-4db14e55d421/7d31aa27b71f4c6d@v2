println(\"11. 상태 머신:\")

mutable struct StateMachine
    state::Symbol
end

function next_state(sm::StateMachine)
    if sm.state == :idle
        sm.state = :running
    elseif sm.state == :running
        sm.state = :stopped
    else
        sm.state = :idle
    end
    return sm.state
end

sm = StateMachine(:idle)
println(\"  상태 전이: $(next_state(sm)), $(next_state(sm)), $(next_state(sm))\")
println()

