println(\"9. 캐싱:\")

memo_cache = Dict()

function memo_fib(n)
    if haskey(memo_cache, n)
        return memo_cache[n]
    end

    if n <= 1
        result = n
    else
        result = memo_fib(n-1) + memo_fib(n-2)
    end

    memo_cache[n] = result
    return result
end

println(\"  memo_fib(10) = $(memo_fib(10))\")
println()

