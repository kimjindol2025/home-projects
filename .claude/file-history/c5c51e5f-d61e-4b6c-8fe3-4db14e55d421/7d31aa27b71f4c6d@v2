# 패턴 1: 사전 할당
function opt_preallocate(n)
    result = zeros(n)
    for i in 1:n
        result[i] = sqrt(i)
    end
    return result
end

# 패턴 2: 벡터화
function opt_vectorized(n)
    return sqrt.(1:n)
end

@time opt_preallocate(100000)
@time opt_vectorized(100000)
println()

