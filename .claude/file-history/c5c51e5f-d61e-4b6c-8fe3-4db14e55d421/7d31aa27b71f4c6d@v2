function analyze(data::Vector; method=\"mean\", verbose=false)
    if verbose
        println(\"  분석 방법: $method\")
    end

    if method == \"mean\"
        return mean(data)
    elseif method == \"median\"
        return median(data)
    else
        return std(data)
    end
end

