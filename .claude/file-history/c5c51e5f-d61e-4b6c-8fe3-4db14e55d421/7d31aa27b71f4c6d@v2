# 모든 숫자 타입에서 작동
function generic_minimum(arr::Vector{T})::T where T <: Number
    min_val = arr[1]
    for val in arr
        if val < min_val
            min_val = val
        end
    end
    return min_val
end

println(\"  generic_minimum([5, 2, 8, 1]) = $(generic_minimum([5, 2, 8, 1]))\")
println(\"  generic_minimum([5.5, 2.2, 8.8]) = $(generic_minimum([5.5, 2.2, 8.8]))\")
println()

