function linear_regression(x::Vector{Float64}, y::Vector{Float64})::NamedTuple
    n = length(x)
    x_mean = mean(x)
    y_mean = mean(y)

    β = sum((x .- x_mean) .* (y .- y_mean)) / sum((x .- x_mean).^2)
    α = y_mean - β * x_mean

    return (intercept = α, slope = β)
end

