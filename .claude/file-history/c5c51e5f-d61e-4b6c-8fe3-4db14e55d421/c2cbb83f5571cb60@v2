# Single dispatch: 타입에 따른 분기
function describe(data::NumericDataset)::NamedTuple
    return (
        name = data.name,
        count = length(data.values),
        mean = mean(data.values),
        std = std(data.values),
        min = minimum(data.values),
        max = maximum(data.values),
        median = median(data.values)
    )
end

function describe(data::MatrixDataset)::String
    return \"행렬 데이터: $(data.rows) × $(length(data.columns))\")
end

