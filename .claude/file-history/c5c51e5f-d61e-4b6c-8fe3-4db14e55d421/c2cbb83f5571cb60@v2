function adaptive_analysis(data::Vector{Float64})::String
    n = length(data)
    variance = var(data)

    if n < 100
        method = \"기술통계 (작은 표본)\"
    elseif variance > 10
        method = \"로버스트 통계 (높은 분산)\"
    else
        method = \"표준 통계 (정상 데이터)\"
    end

    return method
end

