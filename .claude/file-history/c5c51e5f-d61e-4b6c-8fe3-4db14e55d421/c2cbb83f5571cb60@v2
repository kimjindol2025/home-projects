# 4. 필터링 & 변환 (Step 5)
# ============================================
println(\"4. 필터링 및 변환:\")

function filter_outliers(data::NumericDataset, threshold::Float64)::Vector{Float64}
    m = mean(data.values)
    s = std(data.values)
    # 2σ 범위 내의 값만 유지
    return filter(x -> abs(x - m) <= threshold * s, data.values)
end

