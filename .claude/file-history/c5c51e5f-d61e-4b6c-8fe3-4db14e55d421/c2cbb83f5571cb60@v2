function matrix_analysis(M::Matrix{Float64})::NamedTuple
    return (
        rows = size(M, 1),
        cols = size(M, 2),
        mean_all = mean(M),
        mean_cols = mean(M, dims=1),
        trace = tr(M) if size(M, 1) == size(M, 2) else NaN,
        norm = norm(M)
    )
end

