println(\"13. 분석 파이프라인:\")

function analysis_pipeline(raw_data::Vector{Float64})::NamedTuple
    # 1. 필터링
    m = mean(raw_data)
    s = std(raw_data)
    cleaned = filter(x -> abs(x - m) <= 3*s, raw_data)

    # 2. 통계
    stats = (mean=mean(cleaned), std=std(cleaned))

    # 3. 정규화
    normalized = @. (cleaned - stats.mean) / stats.std

    return (
        original_count = length(raw_data),
        cleaned_count = length(cleaned),
        stats = stats,
        normalized_data = normalized
    )
end

