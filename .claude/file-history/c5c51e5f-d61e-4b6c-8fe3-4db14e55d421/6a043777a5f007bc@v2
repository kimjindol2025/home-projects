# ============================================
# 3. 성능 비교: 직렬 vs 병렬
# ============================================
println(\"3. 성능 비교 (큰 배열):\")

function serial_computation(n)
    result = zeros(n)
    for i in 1:n
        result[i] = sin(i) * cos(i)
    end
    return result
end

function parallel_computation(n)
    result = zeros(n)
    @threads for i in 1:n
        result[i] = sin(i) * cos(i)
    end
    return result
end

# 워밍업
serial_computation(10)
parallel_computation(10)

println(\"  직렬 처리:\")
@time serial_result = serial_computation(1000000)

println()
println(\"  병렬 처리 (@threads):\")
@time parallel_result = parallel_computation(1000000)
println()

