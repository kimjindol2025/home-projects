# ============================================
# 7. 뮤텍스/락 (Critical Section)
# ============================================
println(\"7. 뮤텍스 보호:\")

lock = ReentrantLock()
shared_value = 0

@threads for i in 1:10000
    lock(lock) do
        shared_value += 1
    end
end

println(\"  보호된 공유 변수: $shared_value  (정확함)\")
println()

