# ============================================
# 13. 배리어 동기화
# ============================================
println(\"13. 메모리 배리어:\")

state = [0, 0, 0]
barrier_lock = ReentrantLock()
barrier_count = Atomic{Int}(0)

@threads for i in 1:min(nthreads(), 3)
    state[i] = i * 10
    # 모든 스레드가 도달할 때까지 대기
    atomic_add!(barrier_count, 1)
    while barrier_count[] < nthreads()
        # 스핀 락 대기
    end
end

println(\"  모든 스레드 동기화 완료\")
println()

# ============================================
# 14. 빠른 루프 (오버헤드가 중요)
# ============================================
println(\"14. 루프 오버헤드:\")

function fast_serial()
    s = 0
    for i in 1:10000
        s += i
    end
    return s
end

function fast_parallel()
    s = Atomic{Int}(0)
    @threads for i in 1:10000
        atomic_add!(s, i)
    end
    return s[]
end

println(\"  직렬 (작은 루프):\")
@time fast_serial()

println()
println(\"  병렬 (오버헤드 > 이득):\")
@time fast_parallel()
println()

# ============================================
# 15. 캐시 친화적 배열 접근
# ============================================
println(\"15. 메모리 접근 패턴:\")

function threaded_row_sum(M)
    results = zeros(size(M, 1))
    @threads for i in 1:size(M, 1)
        results[i] = sum(M[i, :])  # 행 단위
    end
    return sum(results)
end

M = rand(1000, 1000)
@time total = threaded_row_sum(M)
println()

