# ============================================
# 1. 스레드 개수 확인
# ============================================
println(\"1. 스레드 정보:\")

n_threads = nthreads()
thread_id = threadid()

println(\"  사용 가능한 스레드: $n_threads\")
println(\"  현재 스레드 ID: $thread_id\")
println(\"  (julia -t 4 로 실행하면 4개 스레드)\")
