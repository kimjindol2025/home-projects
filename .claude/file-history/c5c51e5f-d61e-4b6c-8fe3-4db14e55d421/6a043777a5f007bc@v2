# ============================================
# 9. 배열 분할 병렬화
# ============================================
println(\"9. 배열 분할:\")

function parallel_sum(arr::Vector)
    n = nthreads()
    partition_size = div(length(arr), n)
    thread_sums = zeros(n)

    @threads for thread_id in 1:n
        start = (thread_id - 1) * partition_size + 1
        stop = thread_id == n ? length(arr) : thread_id * partition_size
        thread_sums[thread_id] = sum(arr[start:stop])
    end

    return sum(thread_sums)
end

large_arr = [1:1000000;]
@time parallel_total = parallel_sum(large_arr)
println(\"  합계: $parallel_total\")
println()

