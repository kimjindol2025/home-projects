# strings.jl - Julia 문자열 조작 완전 가이드

println("=== Julia 문자열 조작 완전 가이드 ===")
println()

# ============================================
# 1. 문자열 기본 (String Basics)
# ============================================
println("1. 문자열 기본:")
s1 = "Hello, Julia!"
s2 = "Python은 "쉽다", Julia는 "빠르다""
s3 = """
다중 라인
문자열도
가능합니다!
"""

println("  단일 라인: $s1")
println("  특수 문자 포함: $s2")
println("  다중 라인: $s3")
println("  길이: length(\"$s1\") = $(length(s1))")
println()

# ============================================
# 2. 문자 vs 문자열 (Character vs String)
# ============================================
println("2. 문자(Char) vs 문자열(String):")
char_val = 'A'
string_val = "A"
string_multiple = "ABC"

println("  문자: '$char_val' (타입: $(typeof(char_val)))")
println("  문자열: \"$string_val\" (타입: $(typeof(string_val)))")
println("  여러 문자: \"$string_multiple\" (타입: $(typeof(string_multiple)))")
println()

# ============================================
# 3. 문자열 인덱싱 (String Indexing)
# ============================================
println("3. 문자열 인덱싱 (1-based):")
str = "Julia"
println("  문자열: \"$str\"")
println("  str[1] = '$(str[1])'      (첫 번째 문자)")
println("  str[end] = '$(str[end])'  (마지막 문자)")
println("  str[2:4] = \"$(str[2:4])\" (2~4번째)")
println("  str[1:3] = \"$(str[1:3])\" (첫 3글자)")
println()

# ============================================
# 4. 문자열 보간 (String Interpolation)
# ============================================
println("4. 문자열 보간 (String Interpolation):")
name = "World"
version = 1.9
count = 42

println("  \"\$name 환영합니다!\"")
println("  → \"$(name) 환영합니다!\"")
println()
println("  \"Julia \$version의 새로운 기능\"")
println("  → \"Julia $version의 새로운 기능\"")
println()

# 표현식
println("  \"2 + 3 = \$(2 + 3)\"")
println("  → \"2 + 3 = $(2 + 3)\"")
println()
println("  \"\$count개의 별\"")
println("  → \"$count개의 별\"")
println()

# 복잡한 표현식
x = 10
y = 20
println("  \"x + y = \$(x + y)\"")
println("  → \"x + y = $(x + y)\"")
println()

# ============================================
# 5. 문자열 연결 (Concatenation)
# ============================================
println("5. 문자열 연결:")
part1 = "Hello"
part2 = "Julia"

# 방법 1: * 연산자
result1 = part1 * " " * part2
println("  방법 1 (*): \"$part1\" * \" \" * \"$part2\"")
println("  → \"$result1\"")

# 방법 2: string() 함수
result2 = string(part1, " ", part2)
println("  방법 2 (string): string(\"$part1\", \" \", \"$part2\")")
println("  → \"$result2\"")

# 방법 3: join()
result3 = join([part1, part2], " ")
println("  방법 3 (join): join([\"$part1\", \"$part2\"], \" \")")
println("  → \"$result3\"")
println()

# ============================================
# 6. 문자열 반복 (Repetition)
# ============================================
println("6. 문자열 반복:")
pattern = "Ha"
println("  \"$pattern\" * 3 = \"$(pattern * " " ^ 3)\" (공백 3개)")
println("  \"★\" * 5 = \"$(\"★\" ^ 5)\"")
println()

# ============================================
# 7. 문자열 슬라이싱 (Slicing)
# ============================================
println("7. 문자열 슬라이싱:")
text = "Programming"
println("  원본: \"$text\"")
println("  text[1:7] = \"$(text[1:7])\"")
println("  text[9:end] = \"$(text[9:end])\"")
println("  text[1:2:end] = \"$(text[1:2:end])\" (홀수 인덱스만)")
println()

# ============================================
# 8. 문자열 메서드 (String Methods)
# ============================================
println("8. 문자열 메서드:")
text = "Hello World"
println("  원본: \"$text\"")

# 대/소문자 변환
println("  uppercase(\"$text\") = \"$(uppercase(text))\"")
println("  lowercase(\"$text\") = \"$(lowercase(text))\"")

# 공백 제거
text_spaces = "  Hello Julia  "
println("  strip(\"  Hello Julia  \") = \"$(strip(text_spaces))\"")

# 위치 찾기
println("  findfirst(\"World\", \"$text\") = $(findfirst("World", text))")
println("  findall('l', \"$text\") = $(findall('l', text))")

# 포함 여부
println("  contains(\"$text\", \"World\") = $(contains(text, "World"))")
println("  startswith(\"$text\", \"Hello\") = $(startswith(text, "Hello"))")
println("  endswith(\"$text\", \"World\") = $(endswith(text, "World"))")
println()

# ============================================
# 9. 문자열 분할 (Split)
# ============================================
println("9. 문자열 분할:")
sentence = "Julia,Python,Rust,Go"
println("  원본: \"$sentence\"")
parts = split(sentence, ",")
println("  split(\",\"): $parts")
println()

# 각 부분 처리
words = split("Hello World from Julia")
println("  split(): $words")
println()

# ============================================
# 10. 문자열 검색과 치환 (Search & Replace)
# ============================================
println("10. 문자열 검색과 치환:")
original = "Julia is great, Julia is fast"
println("  원본: \"$original\"")

# 첫 번째 발생 교체
result1 = replace(original, "Julia" => "FreeLang", count=1)
println("  replace(\"Julia\" => \"FreeLang\", count=1):")
println("  → \"$result1\"")

# 모든 발생 교체
result2 = replace(original, "Julia" => "FreeLang")
println("  replace(\"Julia\" => \"FreeLang\") [모두]:")
println("  → \"$result2\"")
println()

# ============================================
# 11. 정규표현식 (Regular Expressions)
# ============================================
println("11. 정규표현식:")
text = "Julia 1.9.0 released in 2023"
pattern = r"\\d+"   # 숫자 패턴

println("  텍스트: \"$text\"")
println("  패턴: r\"\\\\d+\" (숫자)")

matches = findall(pattern, text)
println("  findall(r\"\\\\d+\"): $matches")

replaced = replace(text, r"\\d+" => "X")
println("  replace(r\"\\\\d+\" => \"X\"):")
println("  → \"$replaced\"")
println()

# ============================================
# 12. 문자 배열과 반복 (Chars & Iteration)
# ============================================
println("12. 문자열 반복 (Iteration):")
str = "Julia"
println("  원본: \"$str\"")
println("  각 문자:")
for char in str
    println("    - '$char' (타입: $(typeof(char)))")
end
println()

# ============================================
# 13. 문자열과 숫자 변환 (String ↔ Number)
# ============================================
println("13. 문자열과 숫자 변환:")

# 문자열 → 숫자
str_int = "42"
str_float = "3.14"
num1 = parse(Int, str_int)
num2 = parse(Float64, str_float)

println("  parse(Int, \"$str_int\") = $num1 (타입: $(typeof(num1)))")
println("  parse(Float64, \"$str_float\") = $num2 (타입: $(typeof(num2)))")

# 숫자 → 문자열
num = 123
s = string(num)
println("  string($num) = \"$s\" (타입: $(typeof(s)))")
println()

# ============================================
# 14. 포매팅 (Formatting)
# ============================================
println("14. 문자열 포매팅:")
x = 3.14159
y = 42

# 기본 보간
println("  π = $x")

# 조정된 출력
@printf("  파이: %.2f\\n", x)  # 소수점 2자리
@printf("  숫자: %05d\\n", y)  # 5자리 0으로 패딩
println()

# ============================================
# 15. 이스케이프 시퀀스 (Escape Sequences)
# ============================================
println("15. 이스케이프 시퀀스:")
println("  일반 문자열:")
println("    \"Hello\\nWorld\"")
println("    → \"Hello\nWorld\"")
println()

println("  탭 문자:")
println("    \"이름\\t값\"")
println("    → \"이름\t값\"")
println()

println("  역슬래시:")
println("    \"경로: C:\\\\Users\\\\name\"")
println("    → \"경로: C:\\Users\\name\"")
println()

# ============================================
# 16. 특수 유니코드 문자 (Unicode)
# ============================================
println("16. 유니코드 문자:")
println("  "쌍따옴표" + '작은따옴표'")
println("  π (파이): $π")
println("  ℯ (자연상수): $ℯ")
println("  ∑ (시그마): ∑")
println("  λ (람다): λ")
println("  α, β, γ, δ...")
println()

# ============================================
# 17. 문자열 비교 (Comparison)
# ============================================
println("17. 문자열 비교:")
s1 = "apple"
s2 = "apple"
s3 = "banana"

println("  \"$s1\" == \"$s2\" → $(s1 == s2)")
println("  \"$s1\" != \"$s3\" → $(s1 != s3)")
println("  \"$s1\" < \"$s3\" → $(s1 < s3)   (사전 순서)")
println()

# ============================================
# 18. 실전 예제 (Real-world Example)
# ============================================
println("18. 실전 예제:")

# 사용자 입력 형식 (시뮬레이션)
firstname = "Julia"
lastname = "Lang"
version = 1.9

# 문자열 조작
greeting = "$(firstname) $(lastname) v$(version) 환영합니다!"
status = uppercase(greeting)
shortened = firstname[1:3]

println("  이름: $firstname $lastname")
println("  인사말: $greeting")
println("  대문자: $status")
println("  단축: $shortened-$(String(rand('a':'z', 3)))")
println()

# ============================================
# 19. 문자열 유틸리티 (Utilities)
# ============================================
println("19. 자주 쓰는 유틸리티:")
text = "  hello world  "
println("  원본 (공백): \"$(text)\"")
println("  strip(): \"$(strip(text))\"")
println("  reverse(): \"$(reverse(string(text)))\"")
println("  repeat(\"hi\", 3): \"$(repeat("hi", 3))\"")
println()

