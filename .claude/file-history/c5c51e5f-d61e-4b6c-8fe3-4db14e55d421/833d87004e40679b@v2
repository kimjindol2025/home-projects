package lexer

import (
	"testing"
)

// TestBasicTokens - 기본 토큰 테스트
func TestBasicTokens(t *testing.T) {
	tests := []struct {
		input    string
		expected []TokenType
	}{
		{
			input:    "x = 5",
			expected: []TokenType{TokenIdentifier, TokenEqual, TokenInteger},
		},
		{
			input:    "sin(x) + 1.0",
			expected: []TokenType{TokenIdentifier, TokenLparen, TokenIdentifier, TokenRparen, TokenPlus, TokenFloat},
		},
		{
			input:    "function add(a, b) return a + b end",
			expected: []TokenType{TokenKeywordFunction, TokenIdentifier, TokenLparen, TokenIdentifier, TokenComma, TokenIdentifier, TokenRparen, TokenKeywordReturn, TokenIdentifier, TokenPlus, TokenIdentifier, TokenKeywordEnd},
		},
	}

	for _, tt := range tests {
		lexer := NewLexer(tt.input)
		for i, expected := range tt.expected {
			token := lexer.NextToken()
			if token.Type != expected {
				t.Errorf("Test: %q, token %d expected %v, got %v (lexeme: %q)", tt.input, i, expected, token.Type, token.Lexeme)
			}
		}
		// 확인: 다음 토큰은 EOF
		finalToken := lexer.NextToken()
		if finalToken.Type != TokenEOF {
			t.Errorf("Expected EOF at end, got %v", finalToken.Type)
		}
	}
}

// TestKeywords - 키워드 테스트
func TestKeywords(t *testing.T) {
	input := "if else for while function end"
	lexer := NewLexer(input)

	expected := []TokenType{
		TokenKeywordIf,
		TokenKeywordElse,
		TokenKeywordFor,
		TokenKeywordWhile,
		TokenKeywordFunction,
		TokenKeywordEnd,
	}

	for i, exp := range expected {
		token := lexer.NextToken()
		if token.Type != exp {
			t.Errorf("Token %d: Expected %v, got %v (lexeme: %q)", i, exp, token.Type, token.Lexeme)
		}
	}
	// 확인: 다음 토큰은 EOF
	finalToken := lexer.NextToken()
	if finalToken.Type != TokenEOF {
		t.Errorf("Expected EOF at end, got %v", finalToken.Type)
	}
}

// TestNumbers - 숫자 테스트
func TestNumbers(t *testing.T) {
	tests := []struct {
		input    string
		expected TokenType
	}{
		{"123", TokenInteger},
		{"123.456", TokenFloat},
		{"1e-10", TokenFloat},
		{"3.14159", TokenFloat},
	}

	for _, tt := range tests {
		lexer := NewLexer(tt.input)
		token := lexer.NextToken()
		if token.Type != tt.expected {
			t.Errorf("Input %q: expected %v, got %v", tt.input, tt.expected, token.Type)
		}
	}
}

// TestOperators - 연산자 테스트
func TestOperators(t *testing.T) {
	input := "+ - * / == != < <= > >= && || ->"
	lexer := NewLexer(input)

	expected := []TokenType{
		TokenPlus,
		TokenMinus,
		TokenStar,
		TokenSlash,
		TokenEqualEqual,
		TokenNotEqual,
		TokenLess,
		TokenLessEqual,
		TokenGreater,
		TokenGreaterEqual,
		TokenAnd,
		TokenOr,
		TokenArrow,
		TokenEOF,
	}

	for _, exp := range expected {
		token := lexer.NextToken()
		if token.Type != exp {
			t.Errorf("Expected %v, got %v", exp, token.Type)
		}
		if token.Type == TokenEOF {
			break
		}
	}
}

// TestStrings - 문자열 테스트
func TestStrings(t *testing.T) {
	input := `"hello" 'world'`
	lexer := NewLexer(input)

	token := lexer.NextToken()
	if token.Type != TokenString {
		t.Errorf("Expected STRING, got %v", token.Type)
	}

	token = lexer.NextToken()
	if token.Type != TokenString {
		t.Errorf("Expected STRING, got %v", token.Type)
	}
}
