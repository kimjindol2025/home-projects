while n <= 5
    println(n)
    n += 1
end

# 4. break와 continue
for i in 1:10
    if i == 3
        continue      # 3 스킵
    end
    if i == 8
        break         # 루프 탈출
    end
    println(i)
end

# 5. 컴프리헨션
