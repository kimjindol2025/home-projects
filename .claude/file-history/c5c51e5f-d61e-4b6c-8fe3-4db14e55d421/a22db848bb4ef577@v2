println()

# ============================================
# 9. continue (다음 반복)
# ============================================
println("9. continue (다음 반복으로):")

println("  1~10 중 짝수 스킵:")
for i in 1:10
    if i % 2 == 0
        continue
    end
    print("  $i ")
end
println()
println()

# ============================================
# 10. break와 continue 조합
# ============================================
println("10. break와 continue 조합:")

println("  1~20, 3의배수 스킵, 15에서 멈춤:")
for i in 1:20
    if i % 3 == 0
        continue
    end
    if i == 15
        break
    end
    print("  $i ")
end
println()
println()

# ============================================
# 11. 기본 while 루프
# ============================================
println("11. 기본 while 루프:")

println("  i = 1, i <= 5일 때:")
i = 1
while i <= 5
    print("  $i ")
