# ============================================
# 19. 루프 성능: 벡터화
# ============================================
println("19. 루프 vs 벡터화:")

@time begin
    result = []
    for i in 1:1000
        push!(result, i^2)
    end
end

@time begin
    result = [i^2 for i in 1:1000]
end

@time begin
    result = (1:1000) .^ 2
end

println("  위: 루프 (느림)")
println("  중간: 컴프리헨션 (빠름)")
println("  아래: 벡터화 (가장 빠름)")
println()

# ============================================
# 20. 루프 패턴: 누적
# ============================================
println("20. 루프 패턴들:")

arr = [1, 2, 3, 4, 5]

# 누적 합
accumulated = 0
for val in arr
    accumulated += val
end
println("  누적 합: $accumulated")

# 누적 곱
product = 1
for val in arr
    product *= val
end
println("  누적 곱: $product")

# 최댓값 찾기
max_val = arr[1]
for val in arr
    if val > max_val
        max_val = val
    end
end
println("  최댓값: $max_val")

# 필터링
evens = []
for val in arr
    if val % 2 == 0
        push!(evens, val)
    end
end
println("  짝수: $evens")
println()

# ============================================
# 21. 복잡한 루프 예제
# ============================================
println("21. 복잡한 루프 예제: 소수 찾기")

function is_prime(n)
    if n < 2
        return false
    end
    for i in 2:Int(sqrt(n))
        if n % i == 0
            return false
        end
    end
    return true
end

println("  10 이하 소수: ", [n for n in 1:10 if is_prime(n)])
println()

