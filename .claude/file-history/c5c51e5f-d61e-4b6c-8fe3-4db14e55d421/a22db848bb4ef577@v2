end
println()

# ============================================
# 5. 이중 루프 (Nested Loops)
# ============================================
println("5. 이중 루프 (중첩):")

println("  구구단 표 (2단과 3단):")
for i in 2:3
    for j in 1:3
        print("  $(i*j) ")
    end
    println()
end
println()

# ============================================
# 6. 이중 루프 축약형
# ============================================
