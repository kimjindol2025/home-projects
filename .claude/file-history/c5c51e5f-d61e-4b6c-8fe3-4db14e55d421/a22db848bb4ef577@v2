# loops.jl - Julia 루프 (for, while) 완전 가이드

println("=== Julia 루프 완전 가이드 ===")
println()

# ============================================
# 1. 기본 for 루프
# ============================================
println("1. 기본 for 루프:")

println("  for i in 1:5:")
for i in 1:5
    print("    $i ")
end
println()

println("  for x in [10, 20, 30]:")
for x in [10, 20, 30]
    print("    $x ")
end
println()
println()

# ============================================
# 2. 범위 루프 (Range)
# ============================================
println("2. 범위 루프 (다양한 범위):")

println("  1:5 = ", collect(1:5))
println("  1:2:10 = ", collect(1:2:10))
println("  0:0.5:2 = ", collect(0:0.5:2))
println("  5:-1:1 = ", collect(5:-1:1))
println()

# ============================================
# 3. enumerate (인덱스와 값)
# ============================================
println("3. enumerate (인덱스와 값):")

arr = ["a", "b", "c"]
println("  배열: $arr")
println("  for (i, val) in enumerate(arr):")
for (i, val) in enumerate(arr)
    println("    $i: $val")
end
println()

# ============================================
# 4. zip (여러 컬렉션 동시)
# ============================================
println("4. zip (여러 배열 동시 순회):")

a = [1, 2, 3]
b = ["x", "y", "z"]
println("  a = $a")
println("  b = $b")
println("  for (x, y) in zip(a, b):")
