println()

# ============================================
# 14. 루프와 배열
# ============================================
println("14. 루프로 배열 생성:")

result = []
for i in 1:5
    push!(result, i^2)
end
println("  [i^2 for i in 1:5] = $result")

# 더 간단한 방법: 컴프리헨션
result2 = [i^2 for i in 1:5]
println("  컴프리헨션: $result2")
println()

# ============================================
# 15. 루프로 2D 배열 생성
# ============================================
println("15. 2D 배열 생성:")

matrix = []
for i in 1:3
    row = []
    for j in 1:3
        push!(row, i * j)
    end
    push!(matrix, row)
end

println("  곱셈표 (3×3):")
for row in matrix
    println("    $row")
end

# 컴프리헨션으로
matrix2 = [i * j for i in 1:3, j in 1:3]
println("  컴프리헨션: $matrix2")
println()

# ============================================
# 16. keys와 values 루프 (딕셔너리)
# ============================================
println("16. 딕셔너리 순회:")

dict = Dict("a" => 1, "b" => 2, "c" => 3)
println("  딕셔너리: $dict")

println("  키 순회:")
for key in keys(dict)
    print("    $key ")
end
println()

println("  값 순회:")
for val in values(dict)
    print("    $val ")
end
println()

println("  키-값 쌍:")
for (k, v) in dict
    println("    $k => $v")
end
println()

