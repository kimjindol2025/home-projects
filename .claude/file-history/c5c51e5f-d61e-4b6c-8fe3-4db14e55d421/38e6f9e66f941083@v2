# ============================================
# 18. 배열 길이 변경
# ============================================
println("18. 배열 길이 변경:")

arr = [1, 2, 3]
println("  초기 배열: $arr")

push!(arr, 4)
println("  push!(arr, 4): $arr")

pop!(arr)
println("  pop!(arr): $arr")

append!(arr, [5, 6])
println("  append!(arr, [5, 6]): $arr")
println()

# ============================================
# 19. 배열과 루프
# ============================================
println("19. 배열과 루프:")

arr = [10, 20, 30]
println("  배열: $arr")
println("  for-in 루프:")
for val in arr
    println("    값: $val")
end

println("  인덱스와 값:")
for (i, val) in enumerate(arr)
    println("    인덱스 $i: $val")
end
println()

# ============================================
# 20. 배열 필터링
# ============================================
println("20. 배열 필터링:")

data = collect(1:10)
println("  원본: $data")

filtered = filter(x -> x > 5, data)
println("  filter(x -> x > 5): $filtered")

filtered2 = [x for x in data if x % 2 == 0]
println("  짝수만: $filtered2")
println()

println("=== 배열 기초 완료! ===")
