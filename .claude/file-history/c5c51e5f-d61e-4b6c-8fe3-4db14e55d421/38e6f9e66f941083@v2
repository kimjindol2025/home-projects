# array-basics.jl - Julia 배열 기초 완전 가이드

println("=== Julia 배열 기초 완전 가이드 ===")
println()

# ============================================
# 1. 배열 생성 (Array Creation)
# ============================================
println("1. 배열 생성 방법:")

# 명시적 생성
a = [1, 2, 3, 4, 5]
println("  수동 생성: $a (타입: $(typeof(a)))")

# 타입 지정
int_array = Int32[10, 20, 30]
float_array = Float64[1.5, 2.5, 3.5]
println("  Int32 배열: $int_array")
println("  Float64 배열: $float_array")

# 범위에서 생성
from_range = collect(1:10)
println("  범위에서: collect(1:10) = $from_range")

# 배열 생성 함수
zeros_arr = zeros(3)
ones_arr = ones(3)
println("  zeros(3) = $zeros_arr")
println("  ones(3) = $ones_arr")

# 난수
rand_arr = rand(3)
randn_arr = randn(3)
println("  rand(3) (0~1 균등): $(round.(rand_arr; digits=2))")
println("  randn(3) (정규분포): $(round.(randn_arr; digits=2))")
println()

# ============================================
# 2. 2D 배열/행렬 (Matrices)
# ============================================
println("2. 2D 배열 (행렬) 생성:")

# 명시적 생성
m1 = [1 2 3; 4 5 6]
println("  m1 = [1 2 3; 4 5 6]:")
println("  $m1")
println("  크기: $(size(m1))")

# 함수로 생성
m2 = zeros(2, 3)
m3 = ones(3, 3)
m4 = rand(2, 4)
println("  zeros(2, 3):")
println("  $m2")

# 행렬 특수 함수
eye_matrix = Matrix(I(3))  # 단위 행렬
println("  단위 행렬 I(3):")
println("  $eye_matrix")
println()

# ============================================
# 3. 배열 인덱싱 (Array Indexing) - 1-based!
# ============================================
println("3. 배열 인덱싱 (1-based):")

arr = [10, 20, 30, 40, 50]
println("  배열: $arr")
println("  arr[1] = $(arr[1])          (첫 요소)")
println("  arr[3] = $(arr[3])          (세 번째)")
println("  arr[end] = $(arr[end])      (마지막)")
println("  arr[end-1] = $(arr[end-1])  (마지막 전)")
println()

# 범위 인덱싱
println("4. 범위 인덱싱:")
println("  arr[1:3] = $(arr[1:3])      (1~3번째)")
println("  arr[2:end] = $(arr[2:end])  (2번째부터 끝)")
println("  arr[1:2:end] = $(arr[1:2:end])  (홀수 인덱스)")
println()

# ============================================
# 5. 2D 배열 인덱싱
# ============================================
println("5. 2D 배열 인덱싱:")

mat = [1 2 3; 4 5 6; 7 8 9]
println("  행렬:")
println("  $mat")
println()

println("  mat[1, 1] = $(mat[1, 1])        (1행 1열)")
println("  mat[2, 3] = $(mat[2, 3])        (2행 3열)")
println("  mat[1, :] = $(mat[1, :])'       (첫 행 전체)")
println("  mat[:, 2] = $(mat[:, 2])        (2열 전체)")
println()

println("  부분 배열:")
println("  mat[1:2, 2:3] =")
println("  $(mat[1:2, 2:3])")
println()

# ============================================
# 6. 배열 크기와 속성
# ============================================
println("6. 배열 크기와 속성:")

a = rand(3, 4, 2)
println("  크기 3×4×2 배열 생성")
println("  size(a) = $(size(a))")
println("  length(a) = $(length(a)) (전체 원소 수)")
println("  ndims(a) = $(ndims(a)) (차원 수)")

b = [1, 2, 3, 4, 5]
println("  1D 배열: $b")
println("  size(b) = $(size(b))")
println("  length(b) = $(length(b))")
println()

# ============================================
# 7. 배열 연산 (Array Operations)
# ============================================
println("7. 배열 연산:")

v1 = [1, 2, 3]
v2 = [4, 5, 6]

println("  v1 = $v1")
println("  v2 = $v2")
println()

println("  덧셈: v1 + v2 = $(v1 + v2)")
println("  뺄셈: v1 - v2 = $(v1 - v2)")
println("  스칼라 곱셈: v1 * 2 = $(v1 * 2)")
println()

# 원소별 연산 (. 연산자!)
println("  원소별 연산 (. 연산자 필수!):")
println("  v1 .* v2 = $(v1 .* v2)      (원소곱)")
println("  v1 ./ v2 = $(v1 ./ v2)      (원소나눗셈)")
println("  v1 .^ 2 = $(v1 .^ 2)        (원소 거듭제곱)")
println("  sin.(v1) = $(round.(sin.(v1); digits=2))  (원소별 sin)")
println()

# ============================================
# 8. 행렬 연산 (Matrix Operations)
# ============================================
println("8. 행렬 연산:")

A = [1 2; 3 4]
B = [5 6; 7 8]

println("  A = $A")
println("  B = $B")
println()

println("  행렬 덧셈: A + B =")
println("  $(A + B)")
println()

println("  행렬 곱셈: A * B =")
println("  $(A * B)")
println()

println("  원소별 곱셈: A .* B =")
println("  $(A .* B)")
println()

println("  전치: A' =")
println("  $(A')")
println()

# ============================================
# 9. 배열 메서드 (Array Methods)
# ============================================
println("9. 배열 메서드:")

data = [3, 1, 4, 1, 5, 9, 2, 6]
println("  배열: $data")
println()

println("  sum(data) = $(sum(data))        (합계)")
println("  mean(data) = $(mean(data))      (평균)")
println("  std(data) = $(round(std(data); digits=2))  (표준편차)")
println("  minimum(data) = $(minimum(data))    (최솟값)")
println("  maximum(data) = $(maximum(data))    (최댓값)")
println()

println("  sort(data) = $(sort(data))      (정렬)")
println("  reverse(data) = $(reverse(data))  (역순)")
println()

# ============================================
# 10. 배열 검색 (Array Searching)
# ============================================
println("10. 배열 검색:")

arr = [10, 20, 30, 40, 50]
println("  배열: $arr")
println()

idx = findfirst(x -> x > 25, arr)
println("  findfirst(x -> x > 25) = $idx (인덱스 4)")

idx_all = findall(x -> x > 25, arr)
println("  findall(x -> x > 25) = $idx_all (인덱스 [3,4,5])")

val, idx = findmax(arr)
println("  findmax(arr) = ($val, $idx) (최댓값과 인덱스)")
println()

# ============================================
# 11. 배열 결합 (Concatenation)
# ============================================
println("11. 배열 결합:")

a = [1, 2, 3]
b = [4, 5, 6]

println("  a = $a")
println("  b = $b")
println()

# 수직 결합
vcat_result = vcat(a, b)
println("  vcat(a, b) = $vcat_result")
println("  [a; b] = $(vcat_result)")

# 수평 결합
hcat_result = hcat(a, b)
println("  hcat(a, b) =")
println("  $hcat_result")
println()

# ============================================
# 12. 배열 변형 (Reshape & Transform)
# ============================================
println("12. 배열 변형:")

v = collect(1:6)
println("  벡터: $v")
println()

m = reshape(v, 2, 3)
println("  reshape(v, 2, 3) =")
println("  $m")
println()

v2 = vec(m)
println("  vec(m) = $v2 (다시 벡터로)")
println()

# ============================================
# 13. 배열 컴프리헨션 (Array Comprehension)
# ============================================
println("13. 배열 컴프리헨션:")

# 1D 컴프리헨션
squares = [x^2 for x in 1:5]
println("  [x^2 for x in 1:5] = $squares")

# 조건 포함
evens = [x for x in 1:10 if x % 2 == 0]
println("  [x for x in 1:10 if x % 2 == 0] = $evens")

# 2D 컴프리헨션
table = [i*j for i in 1:3, j in 1:3]
println("  곱셈표 [i*j for i in 1:3, j in 1:3]:")
println("  $table")
println()

# ============================================
# 14. 배열 복사 (Copying Arrays)
# ============================================
println("14. 배열 복사:")

original = [1, 2, 3]
copy_array = copy(original)
reference = original  # 참조

copy_array[1] = 999
reference[2] = 888

println("  original = $original")
println("  copy_array = $copy_array (수정됨, 원본 영향 없음)")
println("  reference = $reference (같은 참조, 같이 변함)")
println()

# ============================================
# 15. 배열과 성능 팁
# ============================================
println("15. 성능 팁:")

# 배열 사전 할당
@time begin
    result = Float64[]
    for i in 1:10000
        push!(result, i)
    end
end

@time begin
    result = zeros(10000)
    for i in 1:10000
        result[i] = i
    end
end

println("  위: 반복 할당 (느림)")
println("  아래: 사전 할당 (빠름)")
println()

# ============================================
# 16. 특수 배열 (Special Arrays)
# ============================================
println("16. 특수 배열:")

# 고정값으로 채우기
filled = fill(7, 3, 3)
println("  fill(7, 3, 3):")
println("  $filled")
println()

# 범위에서 배열
from_range = collect(0:0.5:2)
println("  collect(0:0.5:2) = $from_range")
println()

# ============================================
# 17. 배열 타입 확인
# ============================================
println("17. 배열 타입 확인:")

arr_int = [1, 2, 3]
