package lexer

// Phase 1: Lexer (토큰화)
// 파일: internal/lexer/lexer.go
// 예상 코드량: 500-800줄

import (
	"fmt"
	"unicode"
)

// TokenType - 토큰 종류
type TokenType int

const (
	// 기본
	TokenEOF TokenType = iota
	TokenError
	TokenNewline

	// 키워드
	TokenKeywordFunction
	TokenKeywordIf
	TokenKeywordElse
	TokenKeywordElseif
	TokenKeywordFor
	TokenKeywordWhile
	TokenKeywordReturn
	TokenKeywordEnd
	TokenKeywordStruct
	TokenKeywordModule
	TokenKeywordImport
	TokenKeywordUsing
	TokenKeywordAbstract
	TokenKeywordMutable
	TokenKeywordConst
	TokenKeywordLet
	TokenKeywordTrue
	TokenKeywordFalse
	TokenKeywordNothing

	// 리터럴
	TokenInteger
	TokenFloat
	TokenString
	TokenSymbol
	TokenIdentifier

	// 연산자
	TokenPlus      // +
	TokenMinus     // -
	TokenStar      // *
	TokenSlash     // /
	TokenPercent   // %
	TokenCaret     // ^
	TokenEqual     // =
	TokenEqualEqual // ==
	TokenNotEqual  // !=
	TokenLess      // <
	TokenLessEqual // <=
	TokenGreater   // >
	TokenGreaterEqual // >=
	TokenAnd       // &&
	TokenOr        // ||
	TokenNot       // !
	TokenDot       // .
	TokenDotDot    // ..
	TokenDoubleColon // ::
	TokenArrow     // ->
	TokenPipe      // |>

	// 괄호
	TokenLparen    // (
	TokenRparen    // )
	TokenLbrace    // {
	TokenRbrace    // }
	TokenLbracket  // [
	TokenRbracket  // ]

	// 구분자
	TokenComma
	TokenSemicolon
	TokenColon
	TokenAt        // @
)

// Token 구조체
type Token struct {
	Type   TokenType
	Lexeme string
	Line   int
	Column int
}

// Lexer 구조체
type Lexer struct {
	input  string
	pos    int  // 현재 위치
	line   int  // 현재 줄
	column int  // 현재 열
	ch     rune // 현재 문자
}

// NewLexer - 새로운 Lexer 생성
func NewLexer(input string) *Lexer {
	l := &Lexer{
		input:  input,
		pos:    0,
		line:   1,
		column: 0,
		ch:     rune(0),
	}
	l.readChar()
	return l
}

// readChar - 다음 문자 읽기
func (l *Lexer) readChar() {
	if l.pos >= len(l.input) {
		l.ch = rune(0)
	} else {
		l.ch = rune(l.input[l.pos])
	}
	l.pos++
	l.column++
}

// peekChar - 다음 문자 미리보기 (읽지 않음)
func (l *Lexer) peekChar() rune {
	if l.pos >= len(l.input) {
		return rune(0)
	}
	return rune(l.input[l.pos])
}

// NextToken - 다음 토큰 반환
func (l *Lexer) NextToken() Token {
	// 공백 건너뛰기
	for l.ch == ' ' || l.ch == '\t' || l.ch == '\r' {
		l.readChar()
	}

	line := l.line
	column := l.column

	// EOF
	if l.ch == rune(0) {
		return Token{Type: TokenEOF, Lexeme: "", Line: line, Column: column}
	}

	// 개행
	if l.ch == '\n' {
		l.readChar()
		l.line++
		l.column = 0
		return Token{Type: TokenNewline, Lexeme: "\n", Line: line, Column: column}
	}

	// 주석 (# ... 또는 #= ... =#)
	if l.ch == '#' {
		// TODO: 주석 처리
		return l.NextToken()
	}

	// 문자열
	if l.ch == '"' || l.ch == '\'' {
		return l.readString(line, column)
	}

	// 숫자
	if unicode.IsDigit(l.ch) {
		return l.readNumber(line, column)
	}

	// 식별자 또는 키워드
	if unicode.IsLetter(l.ch) || l.ch == '_' {
		return l.readIdentifier(line, column)
	}

	// 연산자 및 기타
	return l.readOperator(line, column)
}

// readString - 문자열 읽기
func (l *Lexer) readString(line, column int) Token {
	quote := l.ch
	l.readChar()
	start := l.pos - 1
	if start < 0 {
		start = 0
	}

	for l.ch != quote && l.ch != rune(0) {
		if l.ch == '\n' {
			l.line++
			l.column = 0
		}
		l.readChar()
	}

	end := l.pos
	if end > len(l.input) {
		end = len(l.input)
	}
	lexeme := l.input[start:end]
	if l.ch == quote {
		l.readChar()
	}

	return Token{Type: TokenString, Lexeme: lexeme, Line: line, Column: column}
}

// readNumber - 숫자 읽기
func (l *Lexer) readNumber(line, column int) Token {
	start := l.pos - 1
	if start < 0 {
		start = 0
	}

	for unicode.IsDigit(l.ch) {
		l.readChar()
	}

	// 안전한 pos 값 확보
	end := l.pos
	if end > len(l.input) {
		end = len(l.input)
	}

	// 부동소수점
	if l.ch == '.' && l.pos < len(l.input) && unicode.IsDigit(l.peekChar()) {
		l.readChar()
		for unicode.IsDigit(l.ch) {
			l.readChar()
		}
		end = l.pos
		if end > len(l.input) {
			end = len(l.input)
		}
		return Token{Type: TokenFloat, Lexeme: l.input[start:end], Line: line, Column: column}
	}

	// 지수 표기법 (e, E)
	if l.ch == 'e' || l.ch == 'E' {
		l.readChar()
		if l.ch == '+' || l.ch == '-' {
			l.readChar()
		}
		for unicode.IsDigit(l.ch) {
			l.readChar()
		}
		end = l.pos
		if end > len(l.input) {
			end = len(l.input)
		}
		return Token{Type: TokenFloat, Lexeme: l.input[start:end], Line: line, Column: column}
	}

	return Token{Type: TokenInteger, Lexeme: l.input[start:end], Line: line, Column: column}
}

// readIdentifier - 식별자 읽기
func (l *Lexer) readIdentifier(line, column int) Token {
	start := l.pos - 1
	if start < 0 {
		start = 0
	}

	for unicode.IsLetter(l.ch) || unicode.IsDigit(l.ch) || l.ch == '_' {
		l.readChar()
	}

	end := l.pos
	if end > len(l.input) {
		end = len(l.input)
	}
	lexeme := l.input[start:end]

	// 키워드 검사
	tokenType := keywordOrIdentifier(lexeme)

	return Token{Type: tokenType, Lexeme: lexeme, Line: line, Column: column}
}

// readOperator - 연산자 읽기
func (l *Lexer) readOperator(line, column int) Token {
	ch := l.ch
	lexeme := string(ch)

	switch ch {
	case '+':
		l.readChar()
		return Token{Type: TokenPlus, Lexeme: lexeme, Line: line, Column: column}
	case '-':
		l.readChar()
		if l.ch == '>' {
			l.readChar()
			return Token{Type: TokenArrow, Lexeme: "->", Line: line, Column: column}
		}
		return Token{Type: TokenMinus, Lexeme: lexeme, Line: line, Column: column}
	case '*':
		l.readChar()
		return Token{Type: TokenStar, Lexeme: lexeme, Line: line, Column: column}
	case '/':
		l.readChar()
		return Token{Type: TokenSlash, Lexeme: lexeme, Line: line, Column: column}
	case '%':
		l.readChar()
		return Token{Type: TokenPercent, Lexeme: lexeme, Line: line, Column: column}
	case '^':
		l.readChar()
		return Token{Type: TokenCaret, Lexeme: lexeme, Line: line, Column: column}
	case '=':
		l.readChar()
		if l.ch == '=' {
			l.readChar()
			return Token{Type: TokenEqualEqual, Lexeme: "==", Line: line, Column: column}
		}
		return Token{Type: TokenEqual, Lexeme: lexeme, Line: line, Column: column}
	case '!':
		l.readChar()
		if l.ch == '=' {
			l.readChar()
			return Token{Type: TokenNotEqual, Lexeme: "!=", Line: line, Column: column}
		}
		return Token{Type: TokenNot, Lexeme: lexeme, Line: line, Column: column}
	case '<':
		l.readChar()
		if l.ch == '=' {
			l.readChar()
			return Token{Type: TokenLessEqual, Lexeme: "<=", Line: line, Column: column}
		}
		return Token{Type: TokenLess, Lexeme: lexeme, Line: line, Column: column}
	case '>':
		l.readChar()
		if l.ch == '=' {
			l.readChar()
			return Token{Type: TokenGreaterEqual, Lexeme: ">=", Line: line, Column: column}
		}
		return Token{Type: TokenGreater, Lexeme: lexeme, Line: line, Column: column}
	case '&':
		l.readChar()
		if l.ch == '&' {
			l.readChar()
			return Token{Type: TokenAnd, Lexeme: "&&", Line: line, Column: column}
		}
		return Token{Type: TokenError, Lexeme: "&는 &&를 사용하세요", Line: line, Column: column}
	case '|':
		l.readChar()
		if l.ch == '|' {
			l.readChar()
			return Token{Type: TokenOr, Lexeme: "||", Line: line, Column: column}
		}
		if l.ch == '>' {
			l.readChar()
			return Token{Type: TokenPipe, Lexeme: "|>", Line: line, Column: column}
		}
		return Token{Type: TokenError, Lexeme: "|는 ||를 사용하세요", Line: line, Column: column}
	case '.':
		l.readChar()
		if l.ch == '.' {
			l.readChar()
			return Token{Type: TokenDotDot, Lexeme: "..", Line: line, Column: column}
		}
		return Token{Type: TokenDot, Lexeme: lexeme, Line: line, Column: column}
	case ':':
		l.readChar()
		if l.ch == ':' {
			l.readChar()
			return Token{Type: TokenDoubleColon, Lexeme: "::", Line: line, Column: column}
		}
		return Token{Type: TokenColon, Lexeme: lexeme, Line: line, Column: column}
	case '(':
		l.readChar()
		return Token{Type: TokenLparen, Lexeme: lexeme, Line: line, Column: column}
	case ')':
		l.readChar()
		return Token{Type: TokenRparen, Lexeme: lexeme, Line: line, Column: column}
	case '{':
		l.readChar()
		return Token{Type: TokenLbrace, Lexeme: lexeme, Line: line, Column: column}
	case '}':
		l.readChar()
		return Token{Type: TokenRbrace, Lexeme: lexeme, Line: line, Column: column}
	case '[':
		l.readChar()
		return Token{Type: TokenLbracket, Lexeme: lexeme, Line: line, Column: column}
	case ']':
		l.readChar()
		return Token{Type: TokenRbracket, Lexeme: lexeme, Line: line, Column: column}
	case ',':
		l.readChar()
		return Token{Type: TokenComma, Lexeme: lexeme, Line: line, Column: column}
	case ';':
		l.readChar()
		return Token{Type: TokenSemicolon, Lexeme: lexeme, Line: line, Column: column}
	case '@':
		l.readChar()
		return Token{Type: TokenAt, Lexeme: lexeme, Line: line, Column: column}
	default:
		l.readChar()
		return Token{Type: TokenError, Lexeme: fmt.Sprintf("예상치 못한 문자: %c", ch), Line: line, Column: column}
	}
}

// keywordOrIdentifier - 키워드 또는 식별자 판별
func keywordOrIdentifier(text string) TokenType {
	keywords := map[string]TokenType{
		"function":  TokenKeywordFunction,
		"if":        TokenKeywordIf,
		"else":      TokenKeywordElse,
		"elseif":    TokenKeywordElseif,
		"for":       TokenKeywordFor,
		"while":     TokenKeywordWhile,
		"return":    TokenKeywordReturn,
		"end":       TokenKeywordEnd,
		"struct":    TokenKeywordStruct,
		"module":    TokenKeywordModule,
		"import":    TokenKeywordImport,
		"using":     TokenKeywordUsing,
		"abstract":  TokenKeywordAbstract,
		"mutable":   TokenKeywordMutable,
		"const":     TokenKeywordConst,
		"let":       TokenKeywordLet,
		"true":      TokenKeywordTrue,
		"false":     TokenKeywordFalse,
		"nothing":   TokenKeywordNothing,
	}

	if tokenType, ok := keywords[text]; ok {
		return tokenType
	}
	return TokenIdentifier
}

// String - 토큰 타입을 문자열로 변환
func (t TokenType) String() string {
	switch t {
	case TokenEOF:
		return "EOF"
	case TokenError:
		return "ERROR"
	case TokenNewline:
		return "NEWLINE"
	case TokenInteger:
		return "INTEGER"
	case TokenFloat:
		return "FLOAT"
	case TokenString:
		return "STRING"
	case TokenIdentifier:
		return "IDENT"
	case TokenPlus:
		return "PLUS"
	case TokenMinus:
		return "MINUS"
	// ... 다른 토큰 타입들
	default:
		return "UNKNOWN"
	}
}
