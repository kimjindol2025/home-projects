# advanced-dispatch.jl - Julia Multiple Dispatch 고급 기법

println("=== Julia Multiple Dispatch 고급 기법 ===")
println()

# ============================================
# 1. 메서드 모호성 (Method Ambiguity)
# ============================================
println("1. 메서드 모호성 문제와 해결:")

# 이 부분은 실제로 실행하면 에러가 발생할 수 있으니 주석 처리
# func(a::Number, b::Int) = "Number-Int"
# func(a::Int, b::Number) = "Int-Number"
# func(5, 3)  # ❌ MethodError: func(::Int64, ::Int64) is ambiguous

# 해결책: 더 구체적인 메서드 추가
func(a::Number, b::Int) = "Number-Int"
func(a::Int, b::Number) = "Int-Number"
func(a::Int, b::Int) = "Int-Int"  # 명확함

println("  func(a::Number, b::Int) 정의")
println("  func(a::Int, b::Number) 정의")
println("  func(a::Int, b::Int) 정의 (모호성 해결)")
println()
println("  func(5, 3) = $(func(5, 3))")
println("  func(5, 3.14) = $(func(5, 3.14))")
println("  func(5.0, 3) = $(func(5.0, 3))")
println()

# ============================================
# 2. 메서드 특이성 (Method Specificity)
# ============================================
println("2. 메서드 특이성 (더 구체적인 것 우선):")

operation(x::Number) = "숫자"
operation(x::Real) = "실수"
operation(x::Integer) = "정수"
operation(x::Int) = "Int"

println("  operation(42):      $(operation(42))      (Int 가장 구체적)")
println("  operation(3.14):    $(operation(3.14))    (Real가 가장 구체적)")
println("  operation(UInt8(5)): $(operation(UInt8(5))) (Integer/UInt8)")
println()

# ============================================
# 3. 선택적 인자 (Keyword Arguments)
# ============================================
println("3. 선택적 인자 (Keyword Arguments):")

greet(name::String) = "Hello, $name!"
greet(name::String; formal=false, caps=false) = begin
    greeting = formal ? "Good day" : "Hi"
    greeting = caps ? uppercase(greeting) : greeting
    "$greeting, $name!"
end

println("  greet(\"Alice\") = $(greet("Alice"))")
println("  greet(\"Bob\"; formal=true) = $(greet("Bob"; formal=true))")
println("  greet(\"Charlie\"; formal=true, caps=true) = $(greet("Charlie"; formal=true, caps=true))")
println()

# ============================================
# 4. Varargs와 디스패치 (Variable Arguments)
# ============================================
println("4. 가변 개수 인자 디스패치:")

sum_numbers(args...) = sum(args)
sum_strings(words::String...) = join(words, " ")
repeat_values(value, times::Int) = value ^ times

println("  sum_numbers(1, 2, 3, 4, 5) = $(sum_numbers(1, 2, 3, 4, 5))")
println("  sum_strings(\"Hello\", \"World\", \"!\") = $(sum_strings("Hello", "World", "!"))")
println("  repeat_values(\"x\", 3) = $(repeat_values("x", 3))")
println()

# ============================================
# 5. Tuple 디스패치 (Tuple Types)
# ============================================
println("5. Tuple 타입 디스패치:")

extract(t::Tuple{Int, Int}) = "두 정수: $(t[1]), $(t[2])"
extract(t::Tuple{String, String}) = "두 문자열: $(t[1]), $(t[2])"
extract(t::Tuple{Int, String, Float64}) = "혼합: Int=$(t[1]), String=$(t[2]), Float=$(t[3])"

println("  extract((5, 10)) = $(extract((5, 10)))")
println("  extract((\"a\", \"b\")) = $(extract(("a", "b")))")
println("  extract((42, \"test\", 3.14)) = $(extract((42, "test", 3.14)))")
println()

# ============================================
# 6. Union 타입 디스패치 (Union Types)
# ============================================
println("6. Union 타입 디스패치:")

process_flexible(x::Union{Int, Float64}) = "숫자: $x"
process_flexible(x::Union{String, Symbol}) = "텍스트: $x"
process_flexible(x::Union{Array, Tuple}) = "컬렉션: 길이 $(length(x))"

println("  process_flexible(42) = $(process_flexible(42))")
println("  process_flexible(3.14) = $(process_flexible(3.14))")
println("  process_flexible(\"hello\") = $(process_flexible("hello"))")
println("  process_flexible([1, 2, 3]) = $(process_flexible([1, 2, 3]))")
println()

# ============================================
# 7. 상한 타입 제약 (Upper Type Bound)
# ============================================
println("7. 상한 타입 제약 (Type Bounds):")

# Real 타입 이하만
process_number(x::Real) = "실수 타입: $x"

# Integer 타입 이하만
process_integer(x::Integer) = "정수 타입: $x"

println("  process_number(42) = $(process_number(42))")
println("  process_number(3.14) = $(process_number(3.14))")
println("  process_integer(Int32(5)) = $(process_integer(Int32(5)))")
println()

# ============================================
# 8. 매개변수 타입 (Parametric Types)
# ============================================
println("8. 매개변수 타입 (Generic Types):")

struct Box{T}
    content::T
end

process_box(b::Box{Int}) = "정수 상자: $(b.content * 2)"
process_box(b::Box{String}) = "문자열 상자: $(b.content * 3)"
process_box(b::Box{T} where T) = "일반 상자: $(typeof(b.content))"

box_int = Box(42)
box_str = Box("Hi")

println("  Box{Int}(42)의 내용을 2배: $(process_box(box_int))")
println("  Box{String}(\"Hi\")를 3배: $(process_box(box_str))")
println()

# ============================================
# 9. 메서드 우선순위 (Method Resolution Order)
# ============================================
println("9. 메서드 해석 순서:")

abstract type Vehicle end
struct Car <: Vehicle end
struct SportsCar <: Car end

describe(v::Vehicle) = "탈것"
describe(c::Car) = "자동차"
describe(s::SportsCar) = "스포츠카"

sc = SportsCar()
println("  SportsCar 인스턴스:")
println("    describe(SportsCar()) = $(describe(sc))")
println("    (가장 구체적인 SportsCar 메서드 사용)")
println()

# ============================================
# 10. 메서드 정보 조사 (Introspection)
# ============================================
println("10. 메서드 정보 조사:")

# 어떤 메서드가 실행될지 확인
