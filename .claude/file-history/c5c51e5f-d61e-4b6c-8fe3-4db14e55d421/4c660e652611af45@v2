# 16. 상수 전파
# ============================================
println(\"16. 상수 전파:\")

const CONST_VALUE = 42

function use_const()
    return CONST_VALUE * 2
end

@code_warntype use_const()
println(\"  상수는 컴파일 타임에 계산\")
println()

# ============================================
# 17. 타입 힌트 사용
# ============================================
println(\"17. 타입 힌트 최적화:\")

function process_typed(x::Int, y::Int)::Int
    # 타입 정보가 풍부 → 컴파일러 최적화
    return x + y
end

function process_generic(x, y)
    # 타입 정보 부족 → 동적 디스패치
    return x + y
end

@code_warntype process_typed(5, 3)
@code_warntype process_generic(5, 3)
println()

