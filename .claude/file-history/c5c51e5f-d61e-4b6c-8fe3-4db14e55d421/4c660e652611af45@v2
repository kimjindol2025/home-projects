# 19. 타입 안정성 체크 도구
# ============================================
println(\"19. 타입 체크 도구:\")

function complex_function(x::Int, y::Float64)
    a = x + 1       # Int
    b = y * 2.0     # Float64
    c = a / b       # Float64
    d = floor(Int, c)  # Int
    return d
end

@code_warntype complex_function(5, 3.14)
println(\"  모든 연산이 타입 안정적\")
println()

