# 10. 함수 반환 타입 선언
# ============================================
println(\"10. 반환 타입 선언:\")

function add_numbers(x::Int, y::Int)::Int
    return x + y
end

@code_warntype add_numbers(3, 5)
println()

# ============================================
# 11. 제너릭 타입 안정성
# ============================================
println(\"11. 제너릭 함수:\")

function generic_sum(arr::Vector{T})::T where T <: Number
    total = zero(T)  # T 타입의 0
    for elem in arr
        total += elem
    end
    return total
end

@code_warntype generic_sum([1, 2, 3])
@code_warntype generic_sum([1.0, 2.0, 3.0])
println()

# ============================================
# 12. Union 타입 피하기
# ============================================
println(\"12. Union 타입 제거:\")

function bad_union(x)
    if x > 0
        return x        # Int
    else
        return nothing  # Nothing (Union{Int, Nothing})
    end
end

@code_warntype bad_union(5)
println(\"  UNION{INT64, NOTHING} 경고\")
println()

# ============================================
# 13. 명시적 타입으로 Union 제거
# ============================================
println(\"13. Optional 타입 처리:\")

function good_optional(x::Int)::Union{Int, Nothing}
    if x > 0
        return x
    else
        return nothing
    end
end

@code_warntype good_optional(5)
println(\"  명시적 Union (컴파일러 최적화)\")
println()

