# ============================================
# 15. 메서드 특화 (Specialization)
# ============================================
println(\"15. 타입별 메서드 특화:\")

function process(x::Int)
    return x * 2
end

function process(x::Float64)
    return x / 2.0
end

function process(x::String)
    return length(x)
end

@code_warntype process(42)
@code_warntype process(3.14)
println(\"  각 타입별 특화 코드 생성\")
println()

