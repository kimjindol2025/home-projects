# type-stability.jl - Julia 타입 안정성

println("=== Julia 타입 안정성 (Type Stability) ===\")
println()

# ============================================
# 1. 기본 타입 안정성 문제
# ============================================
println(\"1. 타입 불안정한 함수:\")

function unstable_function(x)
    if x > 0
        return x + 1         # Int
    else
        return x + 1.5       # Float64
    end
end

@code_warntype unstable_function(5)
println()

# ============================================
# 2. 타입 안정 버전
# ============================================
println(\"2. 타입 안정 버전:\")

function stable_function(x::Int)::Float64
    if x > 0
        return float(x + 1)  # 명시적으로 Float64
    else
        return x + 1.5
    end
end

@code_warntype stable_function(5)
println(\"  경고 없음 = 타입 안정적\")
println()

# ============================================
# 3. 성능 차이
# ============================================
println(\"3. 성능 비교:\")

println(\"  타입 불안정 (UNION 타입):\")
@time [unstable_function(i) for i in 1:100000]

println()
println(\"  타입 안정:\")
@time [stable_function(i) for i in 1:100000]
println()

# ============================================
# 4. 조건부 반환 타입 문제
# ============================================
println(\"4. 조건부 반환 타입:\")

function conditional_return(x)
    if x > 0
        return \"양수\"        # String
    else
        return 0             # Int
    end
end

@code_warntype conditional_return(5)
println(\"  UNION 타입 경고 표시\")
println()

# ============================================
# 5. 배열 요소 타입 혼재
# ============================================
println(\"5. 배열 타입 혼재:\")

function mixed_array_unstable()
    arr = []  # 타입 정보 없음
    push!(arr, 1)
    push!(arr, 1.5)
    push!(arr, \"text\")
    return arr
end

result = mixed_array_unstable()
@code_warntype mixed_array_unstable()
println(\"  배열 요소 타입: $(eltype(result))\")
println()

# ============================================
# 6. 안전한 배열 생성
# ============================================
println(\"6. 타입 안정 배열:\")

function typed_array()
    arr = Float64[]  # 명시적 타입
    push!(arr, 1.0)
    push!(arr, 1.5)
    push!(arr, 2.5)
    return arr
end

@code_warntype typed_array()
println(\"  배열 타입: Float64\")
println()

# ============================================
# 7. 사전 할당 안정성
# ============================================
println(\"7. 사전 할당과 타입:\")

function preallocated(n)
    arr = zeros(Int, n)  # 명시적 타입 + 크기
    for i in 1:n
        arr[i] = i * 2
    end
    return arr
end

@code_warntype preallocated(100)
println(\"  타입 안정적 (사전 할당)\")
println()

# ============================================
# 8. 루프 내 타입 변환
# ============================================
println(\"8. 루프 내 타입 추론:\")

function loop_with_type_change(n)
    total = 0  # Int로 시작
    for i in 1:n
        total += i / 2  # ← 여기서 Float64로 변환?
    end
    return total
end

@code_warntype loop_with_type_change(100)
println()

# ============================================
# 9. 안정적인 누적
# ============================================
println(\"9. 안정적인 루프 누적:\")

function stable_accumulation(n)
    total = 0.0  # Float64로 명시
    for i in 1:n
        total += i / 2
    end
    return total
end

@code_warntype stable_accumulation(100)
println(\"  Float64 타입 일관성\")
println()

