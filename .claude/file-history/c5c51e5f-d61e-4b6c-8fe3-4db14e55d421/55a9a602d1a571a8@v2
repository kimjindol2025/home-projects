# ============================================
# 9. 캐시 제어
# ============================================
println(\"9. 원격 캐시:\")

@everywhere cache = Dict()

@everywhere function cached_task(key, value)
    if haskey(cache, key)
        return cache[key]
    else
        result = value^2
        cache[key] = result
        return result
    end
end

println(\"  원격 워커의 로컬 캐시 활용\")
println()

