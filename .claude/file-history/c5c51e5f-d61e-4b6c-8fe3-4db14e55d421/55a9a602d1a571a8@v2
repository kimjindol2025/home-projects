# 2. 함수 정의 공유 (@everywhere)
# ============================================
println(\"2. 모든 워커에 함수 정의:\")

@everywhere function expensive_task(x)
    # 모든 워커에서 실행 가능
    return x^2 + sqrt(x) + sin(x)
end

println(\"  @everywhere로 함수 정의 완료\")
