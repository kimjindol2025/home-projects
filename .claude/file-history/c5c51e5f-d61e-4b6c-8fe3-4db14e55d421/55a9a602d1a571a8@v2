println(\"7. 데이터 분할:\")

data = [1:1000;]
n_workers = max(1, nworkers())  # 최소 1개

chunks = [data[(i-1)*div(length(data), n_workers)+1:i*div(length(data), n_workers)]
          for i in 1:n_workers-1]

println(\"  데이터를 $(n_workers)개 청크로 분할\")
println(\"  첫 청크 크기: $(length(chunks[1]) if length(chunks) > 0 else 0)\")
println()

