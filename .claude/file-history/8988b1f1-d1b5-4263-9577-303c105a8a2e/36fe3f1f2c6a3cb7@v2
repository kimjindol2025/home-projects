/**
 * Plugin System 테스트
 * PluginManager와 Plugin의 모든 기능을 검증
 */

const PluginManager = require('./plugin-system');
const {
  Plugin,
  DevToolsPlugin,
  LoggerPlugin,
  AnalyticsPlugin,
} = require('./plugin-system');

let testsPassed = 0;
let testsFailed = 0;

// 테스트 유틸리티
function assertEqual(actual, expected, message) {
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    console.error(`❌ ${message}`);
    console.error(`   Expected: ${JSON.stringify(expected)}`);
    console.error(`   Actual: ${JSON.stringify(actual)}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertTrue(condition, message) {
  if (!condition) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertExists(value, message) {
  if (value === null || value === undefined) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

// 테스트 케이스
console.log('\n╔════════════════════════════════════════════╗');
console.log('║  Plugin System 테스트                     ║');
console.log('╚════════════════════════════════════════════╝\n');

// Test 1: 플러그인 등록 및 관리
try {
  console.log('📝 Test 1: 플러그인 등록 및 관리');
  const manager = new PluginManager();

  const plugin1 = new Plugin('plugin1', '1.0.0');
  const plugin2 = new Plugin('plugin2', '2.0.0');

  (async () => {
    const result1 = await manager.registerPlugin(plugin1);
    assertTrue(result1 === true, '플러그인 1 등록 성공');

    const result2 = await manager.registerPlugin(plugin2);
    assertTrue(result2 === true, '플러그인 2 등록 성공');

    const list = manager.listPlugins();
    assertEqual(list.length, 2, '2개 플러그인 등록됨');
  })();

  console.log('✅ 플러그인 등록 및 관리 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 2: Hook 등록 및 실행
try {
  console.log('📝 Test 2: Hook 등록 및 실행');
  const manager = new PluginManager();

  let hookExecuted = false;
  const handler = async (data) => {
    hookExecuted = true;
    return { ...data, modified: true };
  };

  manager.registerHook('testHook', handler);

  (async () => {
    const result = await manager.executeHook('testHook', { value: 42 });
    assertTrue(hookExecuted, 'Hook 실행됨');
    assertEqual(result.modified, true, '데이터 수정됨');
    assertEqual(result.value, 42, '원본 데이터 유지');
  })();

  console.log('✅ Hook 등록 및 실행 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 3: Hook 우선도
try {
  console.log('📝 Test 3: Hook 우선도');
  const manager = new PluginManager();

  let order = [];

  manager.registerHook('orderedHook', async (data) => {
    order.push('high');
    return data;
  }, 10);

  manager.registerHook('orderedHook', async (data) => {
    order.push('medium');
    return data;
  }, 5);

  manager.registerHook('orderedHook', async (data) => {
    order.push('low');
    return data;
  }, 0);

  (async () => {
    await manager.executeHook('orderedHook', {});
    assertEqual(order[0], 'high', '높은 우선도 먼저 실행');
    assertEqual(order[1], 'medium', '중간 우선도 다음');
    assertEqual(order[2], 'low', '낮은 우선도 마지막');
  })();

  console.log('✅ Hook 우선도 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 4: 플러그인 초기화
try {
  console.log('📝 Test 4: 플러그인 초기화');
  const manager = new PluginManager();

  class TestPlugin extends Plugin {
    constructor() {
      super('testPlugin', '1.0.0');
      this.initialized = false;
    }

    async initialize(context) {
      this.initialized = true;
      this.registerHook('custom', async (data) => {
        return { ...data, processed: true };
      });
    }
  }

  const plugin = new TestPlugin();

  (async () => {
    await manager.registerPlugin(plugin);
    assertTrue(plugin.initialized === false, 'Initialize 전 false');

    await manager.initializePlugin('testPlugin');
    assertTrue(plugin.initialized === true, 'Initialize 후 true');

    const info = manager.getPluginInfo('testPlugin');
    assertEqual(info.name, 'testPlugin', '플러그인 정보 확인');
    assertTrue(info.hooks.includes('custom'), 'Hook 등록됨');
  })();

  console.log('✅ 플러그인 초기화 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 5: 플러그인 활성화/비활성화
try {
  console.log('📝 Test 5: 플러그인 활성화/비활성화');
  const manager = new PluginManager();
  const plugin = new Plugin('togglePlugin', '1.0.0');

  (async () => {
    await manager.registerPlugin(plugin);
    assertTrue(plugin.enabled === true, '초기 상태: 활성화');

    await manager.disablePlugin('togglePlugin');
    assertTrue(plugin.enabled === false, 'disable 후: 비활성화');

    await manager.enablePlugin('togglePlugin');
    assertTrue(plugin.enabled === true, 'enable 후: 활성화');
  })();

  console.log('✅ 플러그인 활성화/비활성화 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 6: Built-in Plugins (DevTools, Logger, Analytics)
try {
  console.log('📝 Test 6: Built-in Plugins');
  const manager = new PluginManager();

  (async () => {
    const devTools = new DevToolsPlugin();
    const logger = new LoggerPlugin();
    const analytics = new AnalyticsPlugin();

    await manager.registerPlugin(devTools);
    await manager.registerPlugin(logger);
    await manager.registerPlugin(analytics);

    await manager.initializeAll();

    // DevTools 테스트
    await manager.executeHook('beforeHook', { action: 'test' });
    const logs = devTools.getLogs();
    assertTrue(logs.length > 0, 'DevTools에 로그 기록됨');

    // Analytics 테스트
    await manager.executeHook('event', { type: 'click', target: 'button' });
    const events = analytics.getEvents();
    assertTrue(events.length > 0, 'Analytics에 이벤트 기록됨');

    const stats = manager.getStats();
    assertEqual(stats.pluginCount, 3, '3개 플러그인 등록');
  })();

  console.log('✅ Built-in Plugins 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 7: 플러그인 제거
try {
  console.log('📝 Test 7: 플러그인 제거');
  const manager = new PluginManager();
  const plugin = new Plugin('removeMe', '1.0.0');

  (async () => {
    await manager.registerPlugin(plugin);
    assertEqual(manager.listPlugins().length, 1, '1개 플러그인 등록');

    await manager.unregisterPlugin('removeMe');
    assertEqual(manager.listPlugins().length, 0, '플러그인 제거됨');
  })();

  console.log('✅ 플러그인 제거 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 8: 플러그인 메타데이터
try {
  console.log('📝 Test 8: 플러그인 메타데이터');
  const plugin = new Plugin('metaPlugin', '1.0.0');

  plugin.setMetadata('author', 'John Doe');
  plugin.setMetadata('license', 'MIT');
  plugin.setMetadata('tags', ['utility', 'core']);

  assertEqual(plugin.getMetadata('author'), 'John Doe', 'Author 메타데이터');
  assertEqual(plugin.getMetadata('license'), 'MIT', 'License 메타데이터');
  assertTrue(
    Array.isArray(plugin.getMetadata('tags')),
    'Tags 메타데이터 배열'
  );

  console.log('✅ 플러그인 메타데이터 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

