/**
 * Vue Component Adapter 테스트
 * VueComponentAdapter의 모든 기능을 검증
 */

const VueComponentAdapter = require('./vue-adapter');

let testsPassed = 0;
let testsFailed = 0;

// 테스트 유틸리티
function assertEqual(actual, expected, message) {
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    console.error(`❌ ${message}`);
    console.error(`   Expected: ${JSON.stringify(expected)}`);
    console.error(`   Actual: ${JSON.stringify(actual)}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertTrue(condition, message) {
  if (!condition) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertContains(str, substring, message) {
  if (!str.includes(substring)) {
    console.error(`❌ ${message}`);
    console.error(`   Expected substring: ${substring}`);
    console.error(`   In string: ${str}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

// 테스트 케이스
console.log('\n╔════════════════════════════════════════════╗');
console.log('║  Vue Component Adapter 테스트            ║');
console.log('╚════════════════════════════════════════════╝\n');

// Test 1: 기본 Props 변환
try {
  console.log('📝 Test 1: 기본 Props 변환');
  const component = {
    name: 'Button',
    props: {
      label: { type: 'string', required: true },
      type: { type: 'string', default: 'primary' },
      disabled: { type: 'bool', default: false },
    },
  };

  const adapter = new VueComponentAdapter(component);
  const vueProps = adapter.getVueProps();

  assertTrue('label' in vueProps, 'label prop이 존재해야 함');
  assertTrue('type' in vueProps, 'type prop이 존재해야 함');
  assertTrue('disabled' in vueProps, 'disabled prop이 존재해야 함');

  assertEqual(vueProps.label.type, String, 'label은 String 타입이어야 함');
  assertEqual(vueProps.type.default, 'primary', 'type 기본값은 "primary"');
  assertEqual(vueProps.disabled.default, false, 'disabled 기본값은 false');

  console.log('✅ Props 변환 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 2: 타입 매핑
try {
  console.log('📝 Test 2: FreeLang 타입 → Vue 타입 매핑');
  const component = {
    name: 'Card',
    props: {
      title: { type: 'string' },
      count: { type: 'number' },
      items: { type: 'array' },
      config: { type: 'object' },
      active: { type: 'bool' },
    },
  };

  const adapter = new VueComponentAdapter(component);
  const vueProps = adapter.getVueProps();

  assertEqual(vueProps.title.type, String, 'string → String');
  assertEqual(vueProps.count.type, Number, 'number → Number');
  assertEqual(vueProps.items.type, Array, 'array → Array');
  assertEqual(vueProps.config.type, Object, 'object → Object');
  assertEqual(vueProps.active.type, Boolean, 'bool → Boolean');

  console.log('✅ 타입 매핑 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 3: Template 변환 - Props 바인딩
try {
  console.log('📝 Test 3: Props 바인딩 변환');
  const component = {
    name: 'Button',
    markup: '<button>{label}</button>',
  };

  const adapter = new VueComponentAdapter(component);
  const template = adapter.getVueTemplate();

  assertContains(template, '{{ label }}', 'Props는 {{ }} 형식으로 변환되어야 함');

  console.log('✅ Props 바인딩 변환 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 4: Template 변환 - 조건부 렌더링
try {
  console.log('📝 Test 4: 조건부 렌더링 (if) 변환');
  const component = {
    name: 'Card',
    markup: `
      <div>
        if showFooter {
          <footer>Footer</footer>
        }
      </div>
    `,
  };

  const adapter = new VueComponentAdapter(component);
  const template = adapter.getVueTemplate();

  assertContains(template, 'v-if', 'if는 v-if로 변환되어야 함');
  assertContains(template, 'showFooter', 'showFooter 조건이 유지되어야 함');

  console.log('✅ 조건부 렌더링 변환 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 5: Template 변환 - 반복 렌더링
try {
  console.log('📝 Test 5: 반복 렌더링 (for) 변환');
  const component = {
    name: 'List',
    markup: `
      <div>
        for item in items {
          <li>{item.name}</li>
        }
      </div>
    `,
  };

  const adapter = new VueComponentAdapter(component);
  const template = adapter.getVueTemplate();

  assertContains(template, 'v-for', 'for는 v-for로 변환되어야 함');
  assertContains(template, ':key', ':key 속성이 추가되어야 함');

  console.log('✅ 반복 렌더링 변환 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 6: Vue Component 객체 생성
try {
  console.log('📝 Test 6: Vue Component 객체 생성');
  const component = {
    name: 'Button',
    props: {
      label: { type: 'string' },
    },
    markup: '<button>{label}</button>',
    style: '.btn { padding: 10px; }',
  };

  const adapter = new VueComponentAdapter(component);
  const vueComponent = adapter.toVueComponent();

  assertEqual(vueComponent.name, 'Button', 'name이 설정되어야 함');
  assertTrue('props' in vueComponent, 'props가 있어야 함');
  assertTrue('data' in vueComponent, 'data가 있어야 함');
  assertTrue('methods' in vueComponent, 'methods가 있어야 함');

  console.log('✅ Vue Component 객체 생성 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 7: Vue SFC (.vue) 생성
try {
  console.log('📝 Test 7: Vue SFC 파일 생성');
  const component = {
    name: 'Card',
    props: {
      title: { type: 'string' },
    },
    markup: '<div>{title}</div>',
    style: '.card { border: 1px solid #ddd; }',
  };

  const adapter = new VueComponentAdapter(component);
  const sfc = adapter.toVueSFC();

  assertContains(sfc, '<template>', 'SFC는 <template> 태그를 포함해야 함');
  assertContains(sfc, '<script>', 'SFC는 <script> 태그를 포함해야 함');
  assertContains(sfc, '<style scoped>', 'SFC는 <style scoped> 태그를 포함해야 함');
  assertContains(sfc, 'export default', 'SFC는 export default를 포함해야 함');

  console.log('✅ Vue SFC 파일 생성 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 8: 호환성 검사
try {
  console.log('📝 Test 8: 호환성 검사');
  const component = {
    name: 'Button',
    props: {
      label: { type: 'string' },
    },
    markup: '<button>{label}</button>',
    style: '.btn { padding: 10px; }',
  };

  const adapter = new VueComponentAdapter(component);
  const compatibility = adapter.checkCompatibility();

  assertEqual(compatibility.compatible, true, '유효한 컴포넌트는 호환 가능해야 함');
  assertEqual(compatibility.issues.length, 0, 'issues가 없어야 함');
  assertTrue('info' in compatibility, 'info가 있어야 함');
  assertEqual(compatibility.info.componentName, 'Button', 'componentName이 설정되어야 함');

  console.log('✅ 호환성 검사 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 9: 호환성 검사 - 오류 감지
try {
  console.log('📝 Test 9: 호환성 검사 - 오류 감지');
  const component = {
    name: 'Button',
    props: {
      label: {}, // 타입 미정의
    },
    // markup이 없음
  };

  const adapter = new VueComponentAdapter(component);
  const compatibility = adapter.checkCompatibility();

  assertEqual(compatibility.compatible, false, '오류가 있으면 호환 불가능해야 함');
  assertTrue(compatibility.issues.length > 0, 'issues가 있어야 함');

  console.log('✅ 호환성 검사 - 오류 감지 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 10: 마이그레이션 가이드 생성
try {
  console.log('📝 Test 10: 마이그레이션 가이드 생성');
  const component = {
    name: 'Button',
    props: {
      label: { type: 'string' },
    },
    markup: '<button>{label}</button>',
    style: '.btn { padding: 10px; }',
  };

  const adapter = new VueComponentAdapter(component);
  const guide = adapter.getMigrationGuide();

  assertContains(guide, 'Button', '컴포넌트 이름이 가이드에 포함되어야 함');
  assertContains(guide, 'props:', 'props 정보가 포함되어야 함');
  assertContains(guide, '<template>', 'template이 포함되어야 함');
  assertContains(guide, '<style scoped>', 'style 정보가 포함되어야 함');

  console.log('✅ 마이그레이션 가이드 생성 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// 최종 보고서
console.log('╔════════════════════════════════════════════╗');
console.log(`║  Test 결과: ${testsPassed}/10 통과              ║`);
console.log('╚════════════════════════════════════════════╝\n');

if (testsFailed === 0) {
  console.log('🎉 모든 테스트 통과!\n');
  process.exit(0);
} else {
  console.log(`❌ ${testsFailed}개 테스트 실패\n`);
  process.exit(1);
}
