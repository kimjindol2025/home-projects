  const adapter = new ReactComponentAdapter(component);
  const jsx = adapter.getJSX();

  assertTrue(jsx.includes('&&'), 'if는 && 연산자로 변환');
  assertTrue(jsx.includes('showFooter'), 'showFooter 조건 유지');

  console.log('✅ 조건부 렌더링 변환 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 5: 반복 렌더링 변환
try {
  console.log('📝 Test 5: 반복 렌더링 (for) 변환');
  const component = {
    name: 'List',
    markup: `
      <div>
        for item in items { <li>{item}</li> }
      </div>
    `,
  };

  const adapter = new ReactComponentAdapter(component);
  const jsx = adapter.getJSX();

  assertTrue(jsx.includes('.map'), 'for는 .map()으로 변환');
  assertTrue(jsx.includes('key={'), 'key prop이 추가되어야 함');

  console.log('✅ 반복 렌더링 변환 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 6: React 컴포넌트 코드 생성
try {
  console.log('📝 Test 6: React 함수형 컴포넌트 생성');
  const component = {
    name: 'Button',
    props: {
      label: { type: 'string' },
    },
    markup: '<button>{label}</button>',
    style: '.btn { padding: 10px; }',
    script: '',
  };

  const adapter = new ReactComponentAdapter(component);
  const code = adapter.toReactComponent();

  assertContains(code, 'import React', 'React import 포함');
  assertContains(code, `const ${component.name} = ({`, '컴포넌트 선언');
  assertContains(code, 'export default', 'export default 포함');
  assertContains(code, 'propTypes', 'PropTypes 정의 포함');
  assertContains(code, 'defaultProps', 'defaultProps 정의 포함');

  console.log('✅ React 컴포넌트 코드 생성 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 7: TypeScript 버전 생성
try {
  console.log('📝 Test 7: TypeScript React 컴포넌트 생성');
  const component = {
    name: 'Card',
    props: {
      title: { type: 'string', required: true },
      count: { type: 'number' },
    },
    markup: '<div>{title}: {count}</div>',
    script: '',
  };

  const adapter = new ReactComponentAdapter(component);
  const tsCode = adapter.toReactComponentTS();

  assertContains(tsCode, 'interface', 'TypeScript 인터페이스 포함');
  assertContains(tsCode, `${component.name}Props`, 'Props 인터페이스 포함');
  assertContains(tsCode, 'string', 'string 타입');
  assertContains(tsCode, 'number', 'number 타입');

  console.log('✅ TypeScript React 컴포넌트 생성 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 8: 인라인 스타일 변환
try {
  console.log('📝 Test 8: CSS → 인라인 스타일 변환');
  const component = {
    name: 'Button',
    style: '.btn { padding: 10px; background-color: #007bff; }',
    props: {},
    markup: '',
  };

  const adapter = new ReactComponentAdapter(component);
  const inlineStyles = adapter.getInlineStyles();

  assertTrue('.btn' in inlineStyles, '.btn 스타일 존재');
  assertTrue('padding' in inlineStyles['.btn'], 'padding 속성 있음');
  assertTrue('backgroundColor' in inlineStyles['.btn'], 'camelCase 변환됨');

  console.log('✅ 인라인 스타일 변환 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 9: 호환성 검사
try {
  console.log('📝 Test 9: 호환성 검사');
  const component = {
    name: 'Button',
    props: {
      label: { type: 'string' },
    },
    markup: '<button>{label}</button>',
    style: '',
    script: '',
  };

  const adapter = new ReactComponentAdapter(component);
  const compatibility = adapter.checkCompatibility();

  assertEqual(compatibility.compatible, true, '유효한 컴포넌트는 호환 가능');
  assertEqual(compatibility.issues.length, 0, 'issues 없음');
  assertTrue('info' in compatibility, 'info 객체 포함');

  console.log('✅ 호환성 검사 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 10: 마이그레이션 가이드 및 추가 기능
try {
  console.log('📝 Test 10: 마이그레이션 가이드 + Storybook + Jest');
  const component = {
    name: 'Counter',
    props: {
      initial: { type: 'number', default: 0 },
    },
    markup: '<div>{count}</div>',
    style: '',
    script: 'let count = 0;',
  };

  const adapter = new ReactComponentAdapter(component);

  // 마이그레이션 가이드
  const guide = adapter.getMigrationGuide();
  assertContains(guide, 'Props 인터페이스', '마이그레이션 가이드 포함');

  // Storybook 스토리
  const story = adapter.getStorybookStory();
  assertContains(story, 'export default', 'Storybook default export');
  assertContains(story, '@storybook/react', 'Storybook 임포트');

  // Jest 테스트
  const testCode = adapter.getTestCode();
  assertContains(testCode, 'describe', 'Jest describe 블록');
  assertContains(testCode, 'render', 'render 함수');
  assertContains(testCode, 'expect', 'expect 함수');

  console.log('✅ 마이그레이션 가이드 + 테스트 코드 생성 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// 최종 보고서
console.log('╔════════════════════════════════════════════╗');
console.log(`║  Test 결과: ${testsPassed}/10 통과              ║`);
console.log('╚════════════════════════════════════════════╝\n');

if (testsFailed === 0) {
  console.log('🎉 모든 테스트 통과!\n');
  process.exit(0);
} else {
  console.log(`❌ ${testsFailed}개 테스트 실패\n`);
  process.exit(1);
}
