/**
 * React Component Adapter 테스트
 * ReactComponentAdapter의 모든 기능을 검증
 */

const ReactComponentAdapter = require('./react-adapter');

let testsPassed = 0;
let testsFailed = 0;

// 테스트 유틸리티
function assertEqual(actual, expected, message) {
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    console.error(`❌ ${message}`);
    console.error(`   Expected: ${JSON.stringify(expected)}`);
    console.error(`   Actual: ${JSON.stringify(actual)}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertTrue(condition, message) {
  if (!condition) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertContains(str, substring, message) {
  if (!str.includes(substring)) {
    console.error(`❌ ${message}`);
    console.error(`   Expected substring: ${substring}`);
    console.error(`   In string (first 100 chars): ${str.substring(0, 100)}...`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

// 테스트 케이스
console.log('\n╔════════════════════════════════════════════╗');
console.log('║  React Component Adapter 테스트         ║');
console.log('╚════════════════════════════════════════════╝\n');

// Test 1: PropTypes 생성
try {
  console.log('📝 Test 1: PropTypes 코드 생성');
  const component = {
    name: 'Button',
    props: {
      label: { type: 'string', required: true },
      type: { type: 'string', default: 'primary' },
      disabled: { type: 'bool' },
    },
  };

  const adapter = new ReactComponentAdapter(component);
  const propTypes = adapter.getPropTypes();

  assertTrue('label' in propTypes, 'label PropType이 있어야 함');
  assertTrue(propTypes.label.includes('PropTypes.string'), 'label은 PropTypes.string');
  assertTrue(propTypes.label.includes('isRequired'), 'label은 필수');
  assertTrue(propTypes.type.includes('PropTypes.string'), 'type은 PropTypes.string');
  assertContains(propTypes.disabled, 'PropTypes.bool', 'disabled는 PropTypes.bool');

  console.log('✅ PropTypes 생성 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 2: 기본값 설정
try {
  console.log('📝 Test 2: 기본값 (defaultProps) 설정');
  const component = {
    name: 'Card',
    props: {
      title: { type: 'string', default: 'Untitled' },
      count: { type: 'number', default: 0 },
      active: { type: 'bool', default: true },
    },
  };

  const adapter = new ReactComponentAdapter(component);
  const defaultProps = adapter.getDefaultProps();

  assertEqual(defaultProps.title, 'Untitled', 'title 기본값 확인');
  assertEqual(defaultProps.count, 0, 'count 기본값 확인');
  assertEqual(defaultProps.active, true, 'active 기본값 확인');

  console.log('✅ 기본값 설정 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 3: JSX 생성
try {
  console.log('📝 Test 3: JSX 마크업 변환');
  const component = {
    name: 'Button',
    markup: '<button onclick="handleClick">{label}</button>',
  };

  const adapter = new ReactComponentAdapter(component);
  const jsx = adapter.getJSX();

  assertTrue(jsx.includes('onClick'), 'onclick → onClick 변환');
  assertTrue(jsx.includes('{label}'), 'Props 바인딩 유지');

  console.log('✅ JSX 생성 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 4: 조건부 렌더링 변환
try {
  console.log('📝 Test 4: 조건부 렌더링 (if) 변환');
  const component = {
    name: 'Card',
    markup: `
      <div>
        if showFooter { <footer>Footer</footer> }
      </div>
    `,
