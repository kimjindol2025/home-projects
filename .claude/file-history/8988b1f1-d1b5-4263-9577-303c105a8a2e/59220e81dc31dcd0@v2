/**
 * Phase 5 통합 테스트
 * Vue Adapter, React Adapter, Tailwind Compiler 통합 테스트
 */

const VueComponentAdapter = require('./vue-adapter');
const ReactComponentAdapter = require('./react-adapter');
const TailwindCompiler = require('./tailwind-compiler');

let testsPassed = 0;
let testsFailed = 0;

// 테스트 유틸리티
function assertEqual(actual, expected, message) {
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertTrue(condition, message) {
  if (!condition) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertContains(str, substring, message) {
  if (!str.includes(substring)) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

// 테스트 케이스
console.log('\n╔════════════════════════════════════════════╗');
console.log('║  Phase 5 통합 테스트                   ║');
console.log('║  Vue + React + Tailwind                 ║');
console.log('╚════════════════════════════════════════════╝\n');

// Test 1: Vue 컴포넌트 생성 → Tailwind 스타일 적용
try {
  console.log('📝 Test 1: Vue + Tailwind 통합');
  const component = {
    name: 'Button',
    props: {
      label: { type: 'string', default: 'Click me' },
      variant: { type: 'string', default: 'primary' },
    },
    markup: '<button class="px-4 py-2 rounded">{label}</button>',
    style: `
      .btn-primary { @apply bg-blue-500 text-white; }
      .btn-secondary { @apply bg-gray-500 text-white; }
    `,
  };

  // Vue 어댑터로 변환
  const vueAdapter = new VueComponentAdapter(component);
  const vueSFC = vueAdapter.toVueSFC();

  assertContains(vueSFC, '<template>', 'Vue SFC 템플릿 포함');
  assertContains(vueSFC, '<style scoped>', 'Vue scoped 스타일 포함');

  // Tailwind 컴파일
  const tailwindCompiler = new TailwindCompiler();
  const compiledStyle = tailwindCompiler.compileCSS(component.style);

  assertContains(compiledStyle, 'btn-primary', 'Tailwind 컴파일 후 커스텀 클래스 유지');
  assertTrue(compiledStyle.length > 0, '@apply 지시문 처리 확인');

  console.log('✅ Vue + Tailwind 통합 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 2: React 컴포넌트 생성 → Tailwind 클래스 변환
try {
  console.log('📝 Test 2: React + Tailwind 통합');
  const component = {
    name: 'Card',
    props: {
      title: { type: 'string', default: 'Card Title' },
      description: { type: 'string' },
    },
    markup: '<div class="p-4 rounded-lg shadow"><h2>{title}</h2><p>{description}</p></div>',
    style: '.card { @apply bg-white border border-gray-200; }',
    script: '',
  };

  // React 어댑터로 변환
  const reactAdapter = new ReactComponentAdapter(component);
  const reactCode = reactAdapter.toReactComponent();

  assertContains(reactCode, 'import React', 'React import 포함');
  assertContains(reactCode, 'propTypes', 'PropTypes 정의 포함');

  // Tailwind 클래스 추출
  const tailwindCompiler = new TailwindCompiler();
  const classes = tailwindCompiler.extractClasses(component.markup);

  assertTrue(classes.has('p-4'), 'p-4 클래스 추출');
  assertTrue(classes.has('rounded-lg'), 'rounded-lg 클래스 추출');
  assertTrue(classes.has('shadow'), 'shadow 클래스 추출');

  console.log('✅ React + Tailwind 통합 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 3: 복합 컴포넌트 (Vue + React + Tailwind)
try {
  console.log('📝 Test 3: 복합 컴포넌트 변환 (Vue & React)');
  const component = {
    name: 'ListItem',
    props: {
      text: { type: 'string', required: true },
      completed: { type: 'bool', default: false },
    },
    markup: `
      <div class="flex items-center gap-2 px-3 py-2 hover:bg-gray-100">
        if completed {
          <span class="line-through text-gray-500">{text}</span>
        } else {
          <span class="text-gray-900">{text}</span>
        }
      </div>
    `,
    style: `
      .list-item { @apply flex items-center gap-2; }
      .list-item:hover { @apply bg-gray-50; }
    `,
    script: '',
  };

  // Vue 변환
  const vueAdapter = new VueComponentAdapter(component);
  const vueTemplate = vueAdapter.getVueTemplate();
  assertContains(vueTemplate, 'v-if', 'Vue if 지시문 포함');

  // React 변환
  const reactAdapter = new ReactComponentAdapter(component);
  const reactCode = reactAdapter.toReactComponent();
  assertContains(reactCode, '&&', 'React && 연산자 포함');

  // Tailwind 클래스 추출
  const tailwindCompiler = new TailwindCompiler();
  const classes = tailwindCompiler.extractClasses(component.markup);
  assertTrue(classes.has('flex'), 'flex 클래스 추출');
  assertTrue(classes.has('items-center'), 'items-center 클래스 추출');

  console.log('✅ 복합 컴포넌트 변환 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 4: 호환성 검사 (Vue + React)
try {
  console.log('📝 Test 4: 호환성 검사 (Vue & React)');
  const component = {
    name: 'Badge',
    props: {
      count: { type: 'number', default: 0 },
      color: { type: 'string', default: 'red' },
    },
    markup: '<span class="px-2 py-1 rounded-full text-white bg-{color}">{count}</span>',
    style: '.badge { @apply px-2 py-1 rounded-full; }',
  };

  // Vue 호환성
  const vueAdapter = new VueComponentAdapter(component);
  const vueCompatibility = vueAdapter.checkCompatibility();
  assertTrue(vueCompatibility.compatible, 'Vue 호환성 확인');

  // React 호환성
  const reactAdapter = new ReactComponentAdapter(component);
  const reactCompatibility = reactAdapter.checkCompatibility();
  assertTrue(reactCompatibility.compatible, 'React 호환성 확인');

  console.log('✅ 호환성 검사 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 5: 마이그레이션 가이드 생성
try {
  console.log('📝 Test 5: 마이그레이션 가이드 생성');
  const component = {
    name: 'Header',
    props: {
      title: { type: 'string', required: true },
      subtitle: { type: 'string' },
    },
    markup: '<header><h1>{title}</h1><p>{subtitle}</p></header>',
    style: '.header { @apply py-6 px-4 bg-blue-600 text-white; }',
  };

  // Vue 가이드
  const vueAdapter = new VueComponentAdapter(component);
  const vueGuide = vueAdapter.getMigrationGuide();
  assertContains(vueGuide, 'props:', 'Vue 가이드에 props 정보 포함');
  assertContains(vueGuide, '<template>', 'Vue 가이드에 template 정보 포함');

  // React 가이드
  const reactAdapter = new ReactComponentAdapter(component);
  const reactGuide = reactAdapter.getMigrationGuide();
  assertContains(reactGuide, 'interface', 'React 가이드에 interface 정보 포함');
  assertContains(reactGuide, 'export', 'React 가이드에 export 정보 포함');

  console.log('✅ 마이그레이션 가이드 생성 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 6: Tailwind 최적화
try {
  console.log('📝 Test 6: Tailwind CSS 최적화');
  const markup = `
    <div class="flex items-center px-4 py-2">
      <span class="text-lg font-bold">Title</span>
      <button class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">Click</button>
    </div>
  `;

  const compiler = new TailwindCompiler();
  const classes = compiler.extractClasses(markup);

  assertEqual(classes.size, 10, '10개의 유니크 클래스 추출');

  // 통계 확인
  const stats = compiler.getStats();
  assertTrue(stats.classCount >= 0, '클래스 카운트 통계 포함');

  console.log('✅ Tailwind 최적화 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 7: Props 타입 매핑 (Vue + React)
try {
  console.log('📝 Test 7: Props 타입 매핑 일관성');
  const component = {
    name: 'Modal',
    props: {
      isOpen: { type: 'bool', default: false },
      title: { type: 'string', required: true },
      size: { type: 'string', default: 'md' },
      items: { type: 'array', default: [] },
      config: { type: 'object' },
    },
    markup: '<div>{title}</div>',
  };

  // Vue Props 검증
  const vueAdapter = new VueComponentAdapter(component);
  const vueProps = vueAdapter.getVueProps();
  assertEqual(vueProps.isOpen.type, Boolean, 'Vue bool → Boolean');
  assertEqual(vueProps.items.type, Array, 'Vue array → Array');

  // React PropTypes 검증
  const reactAdapter = new ReactComponentAdapter(component);
  const reactPropTypes = reactAdapter.getPropTypes();
  assertTrue(reactPropTypes.isOpen.includes('PropTypes.bool'), 'React bool → PropTypes.bool');
  assertTrue(reactPropTypes.items.includes('PropTypes.array'), 'React array → PropTypes.array');

  console.log('✅ Props 타입 매핑 일관성 확인 완료\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 8: 이벤트 핸들러 변환 (Vue vs React)
try {
  console.log('📝 Test 8: 이벤트 핸들러 변환');
  const component = {
    name: 'Form',
    markup: `
      <form onclick="submit()">
        <input onchange="handleChange" />
        <button onclick="handleSubmit">Submit</button>
      </form>
    `,
    style: '',
  };

  // Vue 변환
  const vueAdapter = new VueComponentAdapter(component);
  const vueTemplate = vueAdapter.getVueTemplate();
  // Vue는 @click, @change 등으로 변환

  // React 변환
  const reactAdapter = new ReactComponentAdapter(component);
  const reactJSX = reactAdapter.getJSX();
  assertContains(reactJSX, 'onClick', 'React onClick 변환');

  console.log('✅ 이벤트 핸들러 변환 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// 최종 보고서
console.log('╔════════════════════════════════════════════╗');
console.log(`║  통합 테스트 결과: ${testsPassed}/8 통과         ║`);
console.log('╚════════════════════════════════════════════╝\n');

if (testsFailed === 0) {
  console.log('🎉 모든 통합 테스트 통과!\n');
  process.exit(0);
} else {
  console.log(`❌ ${testsFailed}개 테스트 실패\n`);
  process.exit(1);
}
