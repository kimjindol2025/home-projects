/**
 * Phase 7 통합 테스트
 * 모든 Phase 7 모듈의 완벽한 통합
 */

const PluginManager = require('./plugin-system');
const { Plugin } = require('./plugin-system');
const i18n = require('./i18n');
const { LocaleManager } = require('./i18n');
const ThemeManager = require('./theme-system');
const { Theme } = require('./theme-system');
const SSREngine = require('./ssr-engine');
const PerformanceMonitor = require('./performance-monitor');
const { Profiler } = require('./performance-monitor');

let testsPassed = 0;
let testsFailed = 0;

function assertEqual(actual, expected, message) {
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertTrue(condition, message) {
  if (!condition) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

console.log('\n╔════════════════════════════════════════════╗');
console.log('║  Phase 7 통합 테스트                      ║');
console.log('╚════════════════════════════════════════════╝\n');

// Test 1: 플러그인 + i18n 통합
try {
  console.log('📝 Test 1: 플러그인 + i18n 통합');
  const manager = new PluginManager();

  class i18nPlugin extends Plugin {
    constructor(i18nInstance) {
      super('i18n-plugin', '1.0.0');
      this.i18nInstance = i18nInstance;
    }

    async initialize(context) {
      this.registerHook('changeLanguage', async (data) => {
        this.i18nInstance.setLocale(data.locale);
        return data;
      });
    }
  }

  const i18nInstance = new i18n('en');
  i18nInstance.registerLocale('en', { hello: 'Hello' });
  i18nInstance.registerLocale('ko', { hello: 'Hi' });

  const plugin = new i18nPlugin(i18nInstance);

  (async () => {
    await manager.registerPlugin(plugin);
    await manager.initializePlugin('i18n-plugin');

    assertTrue(
      manager.hooks.has('changeLanguage'),
      'i18n Hook 등록됨'
    );
  })();

  console.log('✅ 플러그인 + i18n 통합 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 2: 테마 + i18n 통합
try {
  console.log('📝 Test 2: 테마 + i18n 통합');
  const themeManager = new ThemeManager('light');
  const i18nInstance = new i18n('en');

  const lightTheme = new Theme('light', 'light');
  lightTheme.setColors({ primary: '#007AFF' });

  const darkTheme = new Theme('dark', 'dark');
  darkTheme.setColors({ primary: '#00D9FF' });

  themeManager.registerTheme(lightTheme);
  themeManager.registerTheme(darkTheme);

  i18nInstance.registerLocale('en', { theme: 'Light Theme' });
  i18nInstance.registerLocale('ko', { theme: '다크 테마' });

  themeManager.setTheme('light');
  i18nInstance.setLocale('ko');

  const message = i18nInstance.t('theme');
  assertEqual(message, '다크 테마', '테마와 i18n 동작');

  console.log('✅ 테마 + i18n 통합 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 3: SSR + 성능 모니터링
try {
  console.log('📝 Test 3: SSR + 성능 모니터링');
  const engine = new SSREngine();
  const monitor = new PerformanceMonitor();

  const TestComponent = {
    render: async (context) => {
      return `<h1>${context.props.title}</h1>`;
    },
  };

  engine.registerComponent('TestComponent', TestComponent);

  (async () => {
    monitor.mark('render-start');

    const html = await engine.renderComponent('TestComponent', {
      title: 'Performance Test',
    });

    monitor.mark('render-end');
    const duration = monitor.measure('ssr-render', 'render-start', 'render-end');

    assertTrue(html.includes('Performance Test'), 'SSR 렌더링 성공');
    assertTrue(duration !== null, '성능 측정 성공');
  })();

  console.log('✅ SSR + 성능 모니터링 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 4: 플러그인 + 성능 모니터링
try {
  console.log('📝 Test 4: 플러그인 + 성능 모니터링');
  const manager = new PluginManager();
  const monitor = new PerformanceMonitor();

  class PerformancePlugin extends Plugin {
    constructor(monitor) {
      super('performance-plugin', '1.0.0');
      this.monitor = monitor;
    }

    async initialize(context) {
      this.registerHook('render', async (data) => {
        this.monitor.trackStateUpdate(data.component, data.time);
        return data;
      });
    }
  }

  const plugin = new PerformancePlugin(monitor);

  (async () => {
    await manager.registerPlugin(plugin);
    await manager.initializePlugin('performance-plugin');

    await manager.executeHook('render', {
      component: 'App',
      time: 25,
    });

    const stats = monitor.getStats();
    assertTrue(stats.measuredMetrics >= 0, '성능 통계 수집됨');
  })();

  console.log('✅ 플러그인 + 성능 모니터링 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 5: 완전한 다국어 + 테마 앱
try {
  console.log('📝 Test 5: 완전한 다국어 + 테마 앱');
  const i18nInstance = new i18n('en');
  const localeManager = new LocaleManager(i18nInstance);
  const themeManager = new ThemeManager('light');

  // 다국어 메시지
  localeManager.addLanguage('en', {
    app: { title: 'My App' },
  });
  localeManager.addLanguage('ko', {
    app: { title: '내 앱' },
  });

  // 테마
  const themes = {
    light: new Theme('light', 'light'),
    dark: new Theme('dark', 'dark'),
  };

  themes.light.setColors({ primary: '#007AFF' });
  themes.dark.setColors({ primary: '#00D9FF' });

  themeManager.registerTheme(themes.light);
  themeManager.registerTheme(themes.dark);

  // 앱 실행
  localeManager.switchLocale('ko');
  themeManager.setTheme('light');

  const title = i18nInstance.t('app.title');
  assertEqual(title, '내 앱', '다국어 + 테마 앱 동작');

  console.log('✅ 완전한 다국어 + 테마 앱 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 6: 성능 프로파일링 및 최적화 제안
try {
  console.log('📝 Test 6: 성능 프로파일링 및 최적화 제안');
  const profiler = new Profiler();

  // 빠른 컴포넌트
  profiler.recordComponentRender('Button', 5);
  profiler.recordComponentRender('Button', 6);

  // 느린 컴포넌트
  profiler.recordComponentRender('DataGrid', 250);
  profiler.recordComponentRender('DataGrid', 280);

  const report = profiler.getReport();
  assertTrue(report.totalComponents >= 2, '2개 컴포넌트 프로파일됨');
  assertTrue(report.recommendations.length > 0, '최적화 제안 생성됨');

  const slowComponents = profiler.getSlowComponents(100);
  assertTrue(
    slowComponents.some((c) => c.name === 'DataGrid'),
    'DataGrid 느린 컴포넌트로 감지'
  );

  console.log('✅ 성능 프로파일링 및 최적화 제안 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

console.log('╔════════════════════════════════════════════╗');
console.log(`║  Test 결과: ${testsPassed}/6 통과               ║`);
console.log('╚════════════════════════════════════════════╝\n');

if (testsFailed === 0) {
  console.log('🎉 모든 테스트 통과!\n');
  process.exit(0);
} else {
  console.log(`❌ ${testsFailed}개 테스트 실패\n`);
  process.exit(1);
}
