/**
 * Middleware 테스트
 * MiddlewarePipeline과 Built-in Middlewares 검증
 */

const MiddlewarePipeline = require('./middleware');
const { BuiltInMiddlewares } = require('./middleware');

let testsPassed = 0;
let testsFailed = 0;

// 테스트 유틸리티
function assertEqual(actual, expected, message) {
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    console.error(`❌ ${message}`);
    console.error(`   Expected: ${JSON.stringify(expected)}`);
    console.error(`   Actual: ${JSON.stringify(actual)}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertTrue(condition, message) {
  if (!condition) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

// 테스트 케이스
console.log('\n╔════════════════════════════════════════════╗');
console.log('║  Middleware 테스트                        ║');
console.log('╚════════════════════════════════════════════╝\n');

// Test 1: 미들웨어 파이프라인 기본 실행
try {
  console.log('📝 Test 1: 미들웨어 파이프라인 기본 실행');
  const pipeline = new MiddlewarePipeline();

  let execution = [];

  pipeline.use(async (context) => {
    execution.push('middleware1');
    return true;
  });

  pipeline.use(async (context) => {
    execution.push('middleware2');
    return true;
  });

  pipeline.use(async (context) => {
    execution.push('middleware3');
    return true;
  });

  (async () => {
    const result = await pipeline.execute({ path: '/test' });
    assertTrue(result === true, '파이프라인 정상 실행');
    assertEqual(execution.length, 3, '3개 미들웨어 모두 실행');
    assertEqual(execution[0], 'middleware1', '순차 실행 확인');
  })();

  console.log('✅ 미들웨어 파이프라인 기본 실행 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 2: 조건부 미들웨어 실행
try {
  console.log('📝 Test 2: 조건부 미들웨어 실행');
  const pipeline = new MiddlewarePipeline();

  let execution = [];

  // 조건 없는 미들웨어
  pipeline.use(
    async (context) => {
      execution.push('always');
      return true;
    },
    { name: 'always' }
  );

  // 조건 있는 미들웨어
  pipeline.use(
    async (context) => {
      execution.push('conditional');
      return true;
    },
    {
      name: 'conditional',
      condition: (context) => context.route?.meta?.requiresAuth === true,
    }
  );

  (async () => {
    // 조건 불만족
    execution = [];
    await pipeline.execute({ route: { meta: { requiresAuth: false } } });
    assertEqual(execution.length, 1, '조건 불만족 시 1개만 실행');
    assertTrue(execution.includes('always'), 'always 미들웨어 실행됨');
  })();

  console.log('✅ 조건부 미들웨어 실행 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 3: 미들웨어 중단 (false 반환)
try {
  console.log('📝 Test 3: 미들웨어 중단 (false 반환)');
  const pipeline = new MiddlewarePipeline();

  let execution = [];

  pipeline.use(async (context) => {
    execution.push('first');
    return true;
  });

  pipeline.use(async (context) => {
    execution.push('second');
    return false; // 중단
  });

  pipeline.use(async (context) => {
    execution.push('third');
    return true;
  });

  (async () => {
    const result = await pipeline.execute({});
    assertTrue(result === false, '파이프라인 중단됨');
    assertEqual(execution.length, 2, '두 번째 미들웨어까지만 실행');
    assertTrue(!execution.includes('third'), '세 번째 미들웨어는 실행 안 됨');
  })();

  console.log('✅ 미들웨어 중단 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 4: Built-in 미들웨어 (로깅)
try {
  console.log('📝 Test 4: Built-in 미들웨어 (로깅)');
  const logs = [];
  const loggingMiddleware = BuiltInMiddlewares.loggingMiddleware({
    verbose: false,
    onLog: (msg) => logs.push(msg),
  });

  const context = {
    route: {
      path: '/dashboard',
      meta: { title: 'Dashboard' },
    },
    method: 'NAVIGATE',
  };

  (async () => {
    const result = await loggingMiddleware(context);
    assertTrue(result === true, '로깅 미들웨어 성공');
    assertTrue(logs.length > 0, '로그 기록됨');
    assertTrue(logs[0].includes('/dashboard'), '경로 로깅됨');
  })();

  console.log('✅ Built-in 미들웨어 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 5 (추가): 미들웨어 우선도
try {
  console.log('📝 Test 5 (추가): 미들웨어 우선도');
  const pipeline = new MiddlewarePipeline();

  let execution = [];

  // 우선도 0 (기본값)
  pipeline.use(
    async () => {
      execution.push('priority0');
      return true;
    },
    { name: 'priority0' }
  );

  // 우선도 10
  pipeline.use(
    async () => {
      execution.push('priority10');
      return true;
    },
    { name: 'priority10', priority: 10 }
  );

  // 우선도 5
  pipeline.use(
    async () => {
      execution.push('priority5');
      return true;
    },
    { name: 'priority5', priority: 5 }
  );

  (async () => {
    await pipeline.execute({});
    assertEqual(execution[0], 'priority10', '높은 우선도 먼저 실행');
    assertEqual(execution[1], 'priority5', '중간 우선도 다음');
    assertEqual(execution[2], 'priority0', '낮은 우선도 마지막');
  })();

  console.log('✅ 미들웨어 우선도 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 6 (추가): 미들웨어 에러 처리
try {
  console.log('📝 Test 6 (추가): 미들웨어 에러 처리');
  const pipeline = new MiddlewarePipeline();

  let errors = [];
  pipeline.onError((error, middlewareName, context) => {
    errors.push({ error: error.message, name: middlewareName });
  });

  pipeline.use(
    async (context) => {
      throw new Error('Test error');
    },
    { name: 'errorMiddleware' }
  );

  (async () => {
    const result = await pipeline.execute({});
    assertTrue(result === false, '에러로 인해 false 반환');
    assertTrue(errors.length > 0, '에러 핸들러 호출됨');
    assertEqual(errors[0].name, 'errorMiddleware', '에러난 미들웨어 기록됨');
  })();

  console.log('✅ 미들웨어 에러 처리 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// 최종 보고서
console.log('╔════════════════════════════════════════════╗');
console.log(`║  Test 결과: ${testsPassed}/6 통과               ║`);
console.log('╚════════════════════════════════════════════╝\n');

if (testsFailed === 0) {
  console.log('🎉 모든 테스트 통과!\n');
  process.exit(0);
} else {
  console.log(`❌ ${testsFailed}개 테스트 실패\n`);
  process.exit(1);
}
