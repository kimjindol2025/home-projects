fn test_cache_invalidate_by_pattern() -> void {
  let config: CacheConfig = {
    maxSize: 100,
    ttlMillis: 60000,
    cleanupInterval: 5000
  }

  let cache: QueryCache = cacheNew(config)

  // Set values with pattern
  cacheSet(cache, "user:1", "data1", 60000)
  cacheSet(cache, "user:2", "data2", 60000)
  cacheSet(cache, "post:1", "data3", 60000)

  assertEqual(cache.stats.totalEntries, 3, "Should have 3 entries")

  // Invalidate by pattern
  let invalidated: i32 = cacheInvalidate(cache, "user:")

  assertEqual(invalidated, 2, "Should invalidate 2 entries")
  assertEqual(cache.stats.totalEntries, 1, "Should have 1 entry remaining")
}

fn test_cache_clear() -> void {
  let config: CacheConfig = {
    maxSize: 100,
    ttlMillis: 60000,
    cleanupInterval: 5000
  }

  let cache: QueryCache = cacheNew(config)

  // Add entries
  cacheSet(cache, "key1", "value1", 60000)
  cacheSet(cache, "key2", "value2", 60000)
  cacheSet(cache, "key3", "value3", 60000)

  assertEqual(cache.stats.totalEntries, 3, "Should have 3 entries")

  // Clear cache
  cacheClear(cache)

  assertEqual(cache.stats.totalEntries, 0, "Should have 0 entries after clear")
  assertEqual(cache.entries.length, 0, "Entries array should be empty")
}

fn test_cache_statistics() -> void {
  let config: CacheConfig = {
    maxSize: 100,
    ttlMillis: 60000,
    cleanupInterval: 5000
  }

  let cache: QueryCache = cacheNew(config)

  // Set and get values
  cacheSet(cache, "key1", "value1", 60000)
  cacheSet(cache, "key2", "value2", 60000)
  cacheGet(cache, "key1")
  cacheGet(cache, "key1")
  cacheGet(cache, "nonexistent")

  let stats: CacheStats = cacheGetStats(cache)

  assertEqual(stats.totalEntries, 2, "Total entries should be 2")
  assertEqual(stats.hits, 2, "Hits should be 2")
  assertEqual(stats.misses, 1, "Misses should be 1")
  assertEqual(stats.maxSize, 100, "Max size should be 100")
}

fn test_cache_reset_statistics() -> void {
  let config: CacheConfig = {
    maxSize: 100,
    ttlMillis: 60000,
    cleanupInterval: 5000
  }

  let cache: QueryCache = cacheNew(config)

  cacheSet(cache, "key1", "value1", 60000)
  cacheGet(cache, "key1")
  cacheGet(cache, "key1")
  cacheGet(cache, "nonexistent")

  let statsBefore: CacheStats = cacheGetStats(cache)
  assertEqual(statsBefore.hits, 2, "Should have 2 hits before reset")

  cacheResetStats(cache)

  let statsAfter: CacheStats = cacheGetStats(cache)
  assertEqual(statsAfter.hits, 0, "Hits should be 0 after reset")
  assertEqual(statsAfter.misses, 0, "Misses should be 0 after reset")
  assertEqual(statsAfter.totalEntries, 1, "Total entries should still be 1")
}

