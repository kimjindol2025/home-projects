fn test_cache_initialization() -> void {
  let config: CacheConfig = {
    maxSize: 100,
    ttlMillis: 60000,
    cleanupInterval: 5000
  }

  let cache: QueryCache = cacheNew(config)

  assertEqual(cache.entries.length, 0, "Cache should be empty initially")
  assertEqual(cache.stats.totalEntries, 0, "Total entries should be 0")
  assertEqual(cache.stats.hits, 0, "Hits should be 0")
  assertEqual(cache.stats.misses, 0, "Misses should be 0")
  assertEqual(cache.stats.evictions, 0, "Evictions should be 0")
  assertEqual(cache.config.maxSize, 100, "Max size should be 100")
}

fn test_cache_set_and_get() -> void {
  let config: CacheConfig = {
    maxSize: 100,
    ttlMillis: 60000,
    cleanupInterval: 5000
  }

  let cache: QueryCache = cacheNew(config)

  // Set a value
  let success: boolean = cacheSet(cache, "key1", "value1", 60000)
  assertEqual(success, true, "Set should succeed")
  assertEqual(cache.stats.totalEntries, 1, "Total entries should be 1")

  // Get the value
  let value: any = cacheGet(cache, "key1")
  assertEqual(value, "value1", "Retrieved value should match")
  assertEqual(cache.stats.hits, 1, "Hits should be 1")
}

fn test_cache_miss() -> void {
  let config: CacheConfig = {
    maxSize: 100,
    ttlMillis: 60000,
    cleanupInterval: 5000
  }

  let cache: QueryCache = cacheNew(config)

  // Get non-existent key
  let value: any = cacheGet(cache, "nonexistent")
  assertEqual(value, null, "Missing key should return null")
  assertEqual(cache.stats.misses, 1, "Misses should be 1")
}

fn test_cache_update_existing() -> void {
  let config: CacheConfig = {
    maxSize: 100,
    ttlMillis: 60000,
    cleanupInterval: 5000
  }

  let cache: QueryCache = cacheNew(config)

  // Set initial value
  cacheSet(cache, "key1", "value1", 60000)
  assertEqual(cache.stats.totalEntries, 1, "Total entries should be 1")

  // Update same key
  cacheSet(cache, "key1", "value2", 60000)
