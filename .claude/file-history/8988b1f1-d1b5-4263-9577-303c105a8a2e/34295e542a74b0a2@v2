fn test_cache_lru_eviction() -> void {
  let config: CacheConfig = {
    maxSize: 3,
    ttlMillis: 60000,
    cleanupInterval: 5000
  }

  let cache: QueryCache = cacheNew(config)

  // Fill cache to max
  cacheSet(cache, "key1", "value1", 60000)
  cacheSet(cache, "key2", "value2", 60000)
  cacheSet(cache, "key3", "value3", 60000)

  let statsBefore: CacheStats = cacheGetStats(cache)
  assertEqual(statsBefore.totalEntries, 3, "Should have 3 entries")

  // Add one more - should trigger eviction
  cacheSet(cache, "key4", "value4", 60000)

  let statsAfter: CacheStats = cacheGetStats(cache)
  assertEqual(statsAfter.totalEntries, 3, "Should still have 3 entries after eviction")
  assertEqual(statsAfter.evictions, 1, "Should have 1 eviction")
}

