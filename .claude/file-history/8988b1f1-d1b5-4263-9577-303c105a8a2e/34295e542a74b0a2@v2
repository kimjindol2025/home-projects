fn test_cache_expiration_check() -> void {
  let config: CacheConfig = {
    maxSize: 100,
    ttlMillis: 60000,
    cleanupInterval: 5000
  }

  let cache: QueryCache = cacheNew(config)

  // Create entry
  let entry: CacheEntry = {
    key: "test",
    value: "testvalue",
    createdAt: 0,
    ttl: 60000,
    accessCount: 1
  }

  // At time 0, should not be expired
  let isExp1: boolean = isExpired(entry, 0)
  assertEqual(isExp1, false, "Entry should not be expired at time 0")

  // At time > 60000, should be expired
  let isExp2: boolean = isExpired(entry, 100000)
  assertEqual(isExp2, true, "Entry should be expired after TTL")
}

