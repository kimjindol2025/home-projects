/**
 * Theme System 테스트
 * ThemeManager, Theme, ColorSystem의 모든 기능을 검증
 */

const ThemeManager = require('./theme-system');
const { Theme, ColorSystem } = require('./theme-system');

let testsPassed = 0;
let testsFailed = 0;

// 테스트 유틸리티
function assertEqual(actual, expected, message) {
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    console.error(`❌ ${message}`);
    console.error(`   Expected: ${JSON.stringify(expected)}`);
    console.error(`   Actual: ${JSON.stringify(actual)}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertTrue(condition, message) {
  if (!condition) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

// 테스트 케이스
console.log('\n╔════════════════════════════════════════════╗');
console.log('║  Theme System 테스트                      ║');
console.log('╚════════════════════════════════════════════╝\n');

// Test 1: 색상 시스템 기본
try {
  console.log('📝 Test 1: 색상 시스템 기본');
  const colorSystem = new ColorSystem();

  // Hex to RGB
  const rgb = colorSystem.hexToRgb('#FF0000');
  assertEqual(rgb.r, 255, 'R 값');
  assertEqual(rgb.g, 0, 'G 값');
  assertEqual(rgb.b, 0, 'B 값');

  // RGB to Hex
  const hex = colorSystem.rgbToHex(255, 0, 0);
  assertEqual(hex, '#ff0000', 'RGB to Hex');

  console.log('✅ 색상 시스템 기본 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 2: 색상 팔레트 생성
try {
  console.log('📝 Test 2: 색상 팔레트 생성');
  const colorSystem = new ColorSystem();

  const palette = colorSystem.generatePalette('#007AFF', 'primary');

  assertTrue(palette['primary-50'] !== undefined, '밝은 색 생성');
  assertTrue(palette['primary-800'] !== undefined, '어두운 색 생성');
  assertTrue(palette['primary-50'] !== palette['primary-800'], '색상 차이 있음');

  console.log('✅ 색상 팔레트 생성 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 3: 색상 대비도
try {
  console.log('📝 Test 3: 색상 대비도');
  const colorSystem = new ColorSystem();

  // 흰색과 검은색은 높은 대비도
  const contrast = colorSystem.getContrast('#FFFFFF', '#000000');
  assertTrue(contrast > 10, '흰색/검은색 대비도 높음');

  // 높은 대비도 = 접근성 좋음
  const isAccessible = colorSystem.isAccessible('#FFFFFF', '#000000');
  assertTrue(isAccessible === true, 'WCAG AA 기준 충족');

  console.log('✅ 색상 대비도 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 4: 테마 정의 및 CSS 생성
try {
  console.log('📝 Test 4: 테마 정의 및 CSS 생성');
  const theme = new Theme('light', 'light');

  theme.setColors({
    primary: '#007AFF',
    secondary: '#5AC8FA',
    background: '#FFFFFF',
    text: '#000000',
  });

  theme.setTypography({
    'base': '16px',
    'heading': '24px',
  });

  const css = theme.generateCSS();
  assertTrue(css.includes('--primary'), 'Primary 색상 포함');
  assertTrue(css.includes('--font-base'), '기본 폰트 포함');
  assertTrue(css.includes(':root'), 'CSS Root 정의');

  console.log('✅ 테마 정의 및 CSS 생성 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 5: ThemeManager 테마 전환
try {
  console.log('📝 Test 5: ThemeManager 테마 전환');
  const manager = new ThemeManager('light');

  const lightTheme = new Theme('light-theme', 'light');
  lightTheme.setColors({
    background: '#FFFFFF',
    text: '#000000',
  });

  const darkTheme = new Theme('dark-theme', 'dark');
  darkTheme.setColors({
    background: '#1E1E1E',
    text: '#FFFFFF',
  });

  manager.registerTheme(lightTheme);
  manager.registerTheme(darkTheme);

  manager.setTheme('light-theme');
  assertEqual(manager.getCurrentTheme().name, 'light-theme', '라이트 테마 적용');

  manager.setTheme('dark-theme');
  assertEqual(manager.getCurrentTheme().name, 'dark-theme', '다크 테마 적용');

  console.log('✅ ThemeManager 테마 전환 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 6: 모드 변경 및 구독
try {
  console.log('📝 Test 6: 모드 변경 및 구독');
  const manager = new ThemeManager('light');

  const theme = new Theme('default', 'light');
  theme.setColors({ primary: '#007AFF' });
  manager.registerTheme(theme);
  manager.setTheme('default');

  let changeCount = 0;
  const unsubscribe = manager.subscribe((change) => {
    changeCount++;
  });

  const initialCount = changeCount;
  manager.setMode('dark');
  assertEqual(manager.currentMode, 'dark', '다크 모드 전환');
  assertTrue(changeCount > initialCount, '모드 변경 감지됨');

  const darkCount = changeCount;
  manager.setMode('light');
  assertEqual(manager.currentMode, 'light', '라이트 모드 전환');
  assertTrue(changeCount > darkCount, '두 번째 변경 감지');

  unsubscribe();
  const finalCount = changeCount;
  manager.setMode('dark');
  assertEqual(changeCount, finalCount, '구독 해제 후 감지 안 됨');

  console.log('✅ 모드 변경 및 구독 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// 최종 보고서
console.log('╔════════════════════════════════════════════╗');
console.log(`║  Test 결과: ${testsPassed}/6 통과               ║`);
console.log('╚════════════════════════════════════════════╝\n');

if (testsFailed === 0) {
  console.log('🎉 모든 테스트 통과!\n');
  process.exit(0);
} else {
  console.log(`❌ ${testsFailed}개 테스트 실패\n`);
  process.exit(1);
}
