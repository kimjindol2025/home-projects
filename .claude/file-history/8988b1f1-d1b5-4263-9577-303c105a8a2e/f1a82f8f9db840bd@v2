/**
 * Phase 9: Design Compiler 통합 테스트
 * FreeLang 파일에서 디자인 블록을 추출하여 CSS+JavaScript 생성
 */

const DesignCompiler = require('./design-compiler');

let testsPassed = 0;
let testsFailed = 0;

function assertEqual(actual, expected, message) {
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    console.error(`❌ ${message}`);
    console.error(`   Expected: ${JSON.stringify(expected)}`);
    console.error(`   Actual: ${JSON.stringify(actual)}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertTrue(condition, message) {
  if (!condition) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

console.log('\n╔════════════════════════════════════════════╗');
console.log('║  Phase 9: Design Compiler 통합 테스트    ║');
console.log('╚════════════════════════════════════════════╝\n');

// Test 1: 간단한 .free 파일 컴파일
try {
  console.log('📝 Test 1: 간단한 .free 파일 디자인 블록 컴파일');

  const freeContent = `
component Button {
  props {
    label: string
  }

  @animation fadeIn {
    duration: 300
    opacity: 0 → 1
  }

  @glass {
    background: rgba(255, 255, 255, 0.1)
    backdropFilter: blur(10px)
    borderRadius: 8px
  }

  markup {
    <button class="btn-glass">{label}</button>
  }
}
  `;

  const compiler = new DesignCompiler();
  const result = compiler.compileDesignBlocks(freeContent);

  assertTrue(result.css !== '', 'CSS 생성됨');
  assertTrue(result.css.includes('fadeIn'), 'CSS에 fadeIn 애니메이션 포함');
  assertTrue(result.css.includes('glass-0'), 'CSS에 glass 클래스 포함');
  // JavaScript는 트리거가 있을 때만 생성됨
  assertTrue(typeof result.javascript === 'string', 'JavaScript 타입 확인');

  console.log('✅ Test 1 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 2: 다중 디자인 블록 처리
try {
  console.log('📝 Test 2: 다중 디자인 블록 처리');

  const freeContent = `
component Card {
  @animation slideIn {
    duration: 200
    transform: translateX(-20px) → translateX(0px)
  }

  @animation bounce {
    duration: 500
    transform: scale(1) → scale(1.1) → scale(1)
  }

  @glass {
    background: rgba(255, 255, 255, 0.08)
    backdropFilter: blur(8px)
  }

  @3d {
    perspective: 1000px
    rotateY: 10deg
  }

  markup {
    <div class="card"></div>
  }
}
  `;

  const compiler = new DesignCompiler();
  const result = compiler.compileDesignBlocks(freeContent);

  assertTrue(result.css.includes('slideIn'), 'CSS에 slideIn 포함');
  assertTrue(result.css.includes('bounce'), 'CSS에 bounce 포함');
  assertTrue(result.css.includes('3d-0'), 'CSS에 3d 변환 포함');

  const stats = compiler.getStats();
  assertTrue(stats.animations.totalAnimations === 2, '2개 애니메이션 감지');
  assertTrue(stats.glassmorphisms.totalComponents === 1, 'Glassmorphism 감지');
  assertTrue(stats.transforms.totalTransforms === 1, '3D Transform 감지');

  console.log('✅ Test 2 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 3: Micro-interaction과 Scroll Trigger
try {
  console.log('📝 Test 3: Micro-interaction 과 Scroll Trigger');

  const freeContent = `
component InteractiveSection {
  @micro {
    selector: .counter
    event: click
    action: count-up
    duration: 1000
  }

  @scroll {
    selector: .reveal
    animation: fadeIn
    offset: -100px
  }

  markup {
    <div class="counter">0</div>
    <div class="reveal">Content</div>
  }
}
  `;

  const compiler = new DesignCompiler();
  const result = compiler.compileDesignBlocks(freeContent);

  assertTrue(result.javascript.includes('IntersectionObserver') || result.javascript.includes('scroll'),
    'JavaScript에 scroll 트리거 포함');

  console.log('✅ Test 3 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 4: 복잡한 컴포넌트 (모든 디자인 엔진 조합)
try {
  console.log('📝 Test 4: 모든 디자인 엔진 조합 (복잡한 컴포넌트)');

  const freeContent = `
component HeroSection {
  @animation heroFadeIn {
    duration: 800
    opacity: 0 → 1
    transform: translateY(20px) → translateY(0px)
  }

  @animation textReveal {
    duration: 600
    delay: 200
    opacity: 0 → 1
  }

  @glass {
    background: rgba(255, 255, 255, 0.05)
    backdropFilter: blur(20px)
    border: 1px solid rgba(255, 255, 255, 0.1)
  }

  @3d {
    perspective: 1200px
    rotateX: 5deg
    rotateY: -10deg
  }

  @micro {
    selector: .cta-button
    event: hover
    action: pulse
    duration: 500
  }

  @scroll {
    selector: .parallax
    animation: slideIn
    offset: -50px
    once: true
  }

  markup {
    <section class="hero">
      <h1 class="hero-title">Welcome</h1>
      <p class="hero-text">Content</p>
      <button class="cta-button">Click me</button>
      <div class="parallax">Scroll effect</div>
    </section>
  }
}
  `;

  const compiler = new DesignCompiler();
  const result = compiler.compileDesignBlocks(freeContent);

  // 모든 CSS 요소 확인
  assertTrue(result.css.includes('heroFadeIn'), 'CSS에 heroFadeIn 애니메이션');
  assertTrue(result.css.includes('textReveal'), 'CSS에 textReveal 애니메이션');
  assertTrue(result.css.includes('glass-0'), 'CSS에 glassmorphism');
  assertTrue(result.css.includes('3d-0'), 'CSS에 3D transform');

  // 통계 확인
  const stats = compiler.getStats();
  assertTrue(stats.animations.totalAnimations === 2, '2개 애니메이션');
  assertTrue(stats.interactions.totalInteractions > 0, 'Micro-interaction 있음');
  assertTrue(stats.scrollTriggers.totalTriggers > 0, 'Scroll trigger 있음');

  console.log('✅ Test 4 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 5: CSS 및 JavaScript 출력 품질 검증
try {
  console.log('📝 Test 5: 생성된 CSS/JavaScript 품질 검증');

  const freeContent = `
component TestComponent {
  @animation test {
    duration: 300
    opacity: 0 → 1
  }

  @glass {
    background: rgba(255, 255, 255, 0.1)
  }

  markup {
    <div></div>
  }
}
  `;

  const compiler = new DesignCompiler();
  const result = compiler.compileDesignBlocks(freeContent);

  // CSS 문법 검증
  assertTrue(result.css.includes('@keyframes'), 'CSS에 @keyframes 포함');
  assertTrue(result.css.includes('{'), 'CSS가 중괄호 포함');
  assertTrue(result.css.includes('}'), 'CSS가 닫는 괄호 포함');

  // JavaScript 문법 검증
  if (result.javascript) {
    assertTrue(result.javascript.includes('function') || result.javascript.includes('=>'),
      'JavaScript가 함수 정의 포함');
  }

  console.log('✅ Test 5 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 6: 컴파일러 리셋 및 재사용
try {
  console.log('📝 Test 6: 컴파일러 리셋 및 재사용');

  const compiler = new DesignCompiler();

  // 첫 번째 컴파일
  let result1 = compiler.compileDesignBlocks(`
    component Comp1 {
      @animation test1 {
        duration: 100
        opacity: 0 → 1
      }
      markup { <div></div> }
    }
  `);

  let stats1 = compiler.getStats();
  assertTrue(stats1.animations.totalAnimations === 1, '첫 번째 컴파일: 1개 애니메이션');

  // 리셋
  compiler.reset();

  let stats2 = compiler.getStats();
  assertTrue(stats2.animations.totalAnimations === 0, '리셋 후: 0개 애니메이션');

  // 두 번째 컴파일
  let result2 = compiler.compileDesignBlocks(`
    component Comp2 {
      @animation test2a {
        duration: 200
        opacity: 0 → 1
      }
      @animation test2b {
        duration: 300
        scale: 0.8 → 1
      }
      markup { <div></div> }
    }
  `);

  stats2 = compiler.getStats();
  assertTrue(stats2.animations.totalAnimations === 2, '두 번째 컴파일: 2개 애니메이션');

  console.log('✅ Test 6 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

console.log('╔════════════════════════════════════════════╗');
console.log(`║  Test 결과: ${testsPassed}/6 통과               ║`);
console.log('╚════════════════════════════════════════════╝\n');

if (testsFailed === 0) {
  console.log('🎉 모든 Phase 9 통합 테스트 통과!\n');
  process.exit(0);
} else {
  console.log(`❌ ${testsFailed}개 테스트 실패\n`);
  process.exit(1);
}
