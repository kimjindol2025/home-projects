/**
 * i18n 테스트
 * i18n과 LocaleManager의 모든 기능을 검증
 */

const i18n = require('./i18n');
const { LocaleManager } = require('./i18n');

let testsPassed = 0;
let testsFailed = 0;

// 테스트 유틸리티
function assertEqual(actual, expected, message) {
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    console.error(`❌ ${message}`);
    console.error(`   Expected: ${JSON.stringify(expected)}`);
    console.error(`   Actual: ${JSON.stringify(actual)}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertTrue(condition, message) {
  if (!condition) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

// 테스트 케이스
console.log('\n╔════════════════════════════════════════════╗');
console.log('║  i18n 테스트                             ║');
console.log('╚════════════════════════════════════════════╝\n');

// Test 1: 기본 번역
try {
  console.log('📝 Test 1: 기본 번역');
  const i18nInstance = new i18n('en');

  const enMessages = {
    common: {
      hello: 'Hello',
      goodbye: 'Goodbye',
    },
    greeting: {
      morning: 'Good morning',
    },
  };

  const koMessages = {
    common: {
      hello: '안녕하세요',
      goodbye: '안녕히 가세요',
    },
    greeting: {
      morning: '좋은 아침',
    },
  };

  i18nInstance.registerLocale('en', enMessages);
  i18nInstance.registerLocale('ko', koMessages);

  assertEqual(i18nInstance.t('common.hello'), 'Hello', '영어 번역');
  i18nInstance.setLocale('ko');
  assertEqual(i18nInstance.t('common.hello'), '안녕하세요', '한국어 번역');

  console.log('✅ 기본 번역 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 2: 메시지 매개변수 치환
try {
  console.log('📝 Test 2: 메시지 매개변수 치환');
  const i18nInstance = new i18n('en');

  const messages = {
    greeting: 'Hello, {name}!',
    message: 'You have {count} messages from {user}',
  };

  i18nInstance.registerLocale('en', messages);

  const result1 = i18nInstance.t('greeting', { name: 'John' });
  assertEqual(result1, 'Hello, John!', '단일 매개변수 치환');

  const result2 = i18nInstance.t('message', { count: 5, user: 'Alice' });
  assertEqual(result2, 'You have 5 messages from Alice', '여러 매개변수 치환');

  console.log('✅ 메시지 매개변수 치환 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 3: 복수형 처리
try {
  console.log('📝 Test 3: 복수형 처리');
  const i18nInstance = new i18n('en');

  const messages = {
    items: {
      zero: 'No items',
      one: 'One item',
      other: '{count} items',
    },
  };

  i18nInstance.registerLocale('en', messages);

  assertEqual(i18nInstance.tc('items', 0), 'No items', '복수형 0');
  assertEqual(i18nInstance.tc('items', 1), 'One item', '복수형 1');
  assertEqual(
    i18nInstance.tc('items', 5),
    '5 items',
    '복수형 other'
  );

  console.log('✅ 복수형 처리 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 4: 언어 변경 및 구독
try {
  console.log('📝 Test 4: 언어 변경 및 구독');
  const i18nInstance = new i18n('en');

  const messages = {
    en: { hello: 'Hello' },
    ko: { hello: '안녕하세요' },
  };

  i18nInstance.registerLocale('en', messages.en);
  i18nInstance.registerLocale('ko', messages.ko);

  let changeCount = 0;
  const unsubscribe = i18nInstance.subscribe(() => {
    changeCount++;
  });

  i18nInstance.setLocale('ko');
  assertEqual(changeCount, 1, '첫 번째 변경 감지');

  i18nInstance.setLocale('en');
  assertEqual(changeCount, 2, '두 번째 변경 감지');

  unsubscribe();
  i18nInstance.setLocale('ko');
  assertEqual(changeCount, 2, '구독 해제 후 감지 안 됨');

  console.log('✅ 언어 변경 및 구독 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 5: LocaleManager 언어 전환
try {
  console.log('📝 Test 5: LocaleManager 언어 전환');
  const i18nInstance = new i18n('en');
  const manager = new LocaleManager(i18nInstance);

  const messages = {
    en: { test: 'English' },
    ko: { test: '한국어' },
    ja: { test: '日本語' },
  };

  manager.addLanguage('en', messages.en);
  manager.addLanguage('ko', messages.ko);
  manager.addLanguage('ja', messages.ja);

  assertEqual(i18nInstance.getLocale(), 'en', '초기 언어: 영어');

  manager.switchLocale('ko');
  assertEqual(i18nInstance.getLocale(), 'ko', '한국어로 전환');

  manager.switchLocale('ja');
  assertEqual(i18nInstance.getLocale(), 'ja', '일본어로 전환');

  const reverted = manager.revertLocale();
  assertEqual(reverted, 'ko', '한국어로 복귀');

  console.log('✅ LocaleManager 언어 전환 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 6: 사용자 선호도
try {
  console.log('📝 Test 6: 사용자 선호도');
  const i18nInstance = new i18n('en');
  const manager = new LocaleManager(i18nInstance);

  manager.setPreference('defaultLocale', 'ko');
  manager.setPreference('autoDetect', true);
  manager.setPreference('theme', 'dark');

  assertEqual(
    manager.getPreference('defaultLocale'),
    'ko',
    '언어 선호도'
  );
  assertEqual(manager.getPreference('autoDetect'), true, '자동 감지 선호도');
  assertEqual(manager.getPreference('theme'), 'dark', '테마 선호도');

  console.log('✅ 사용자 선호도 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 7: 통계 및 내보내기
try {
  console.log('📝 Test 7: 통계 및 내보내기');
  const i18nInstance = new i18n('en');
  const manager = new LocaleManager(i18nInstance);

  const messages = {
    en: { hello: 'Hello', goodbye: 'Goodbye' },
    ko: { hello: '안녕하세요', goodbye: '안녕히 가세요' },
  };

  manager.addLanguage('en', messages.en);
  manager.addLanguage('ko', messages.ko);

  const stats = i18nInstance.getStats();
  assertEqual(stats.currentLocale, 'en', '현재 로케일');
  assertTrue(
    stats.availableLocales.includes('ko'),
    '사용 가능한 로케일'
  );

  const exported = manager.exportMessages();
  assertEqual(Object.keys(exported).length, 2, '2개 로케일 내보내기');

  console.log('✅ 통계 및 내보내기 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// 최종 보고서
console.log('╔════════════════════════════════════════════╗');
console.log(`║  Test 결과: ${testsPassed}/7 통과               ║`);
console.log('╚════════════════════════════════════════════╝\n');

if (testsFailed === 0) {
  console.log('🎉 모든 테스트 통과!\n');
  process.exit(0);
} else {
  console.log(`❌ ${testsFailed}개 테스트 실패\n`);
  process.exit(1);
}
