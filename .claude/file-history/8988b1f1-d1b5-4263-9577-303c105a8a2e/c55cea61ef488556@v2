/**
 * SSR Engine 테스트
 */

const SSREngine = require('./ssr-engine');
const { Hydration } = require('./ssr-engine');

let testsPassed = 0;
let testsFailed = 0;

function assertEqual(actual, expected, message) {
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertTrue(condition, message) {
  if (!condition) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

console.log('\n╔════════════════════════════════════════════╗');
console.log('║  SSR Engine 테스트                        ║');
console.log('╚════════════════════════════════════════════╝\n');

// Test 1: 컴포넌트 렌더링
try {
  console.log('📝 Test 1: 컴포넌트 렌더링');
  const engine = new SSREngine();

  const TestComponent = {
    render: async (context) => {
      return `<div class="test">${context.props.title}</div>`;
    },
  };

  engine.registerComponent('TestComponent', TestComponent);

  (async () => {
    const html = await engine.renderComponent('TestComponent', {
      title: 'Hello',
    });

    assertTrue(html.includes('Hello'), '렌더링된 HTML에 제목 포함');
    assertTrue(html.includes('class="test"'), 'CSS 클래스 포함');
  })();

  console.log('✅ 컴포넌트 렌더링 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 2: 초기 상태 직렬화
try {
  console.log('📝 Test 2: 초기 상태 직렬화');
  const engine = new SSREngine();

  const initialState = { count: 0, user: 'John' };
  const serialized = engine.serializeState(initialState);

  assertTrue(serialized.includes('count'), 'count 포함');
  assertTrue(serialized.includes('John'), 'user 포함');

  const parsed = JSON.parse(serialized);
  assertEqual(parsed.count, 0, 'count 값 확인');

  console.log('✅ 초기 상태 직렬화 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 3: 하이드레이션 스크립트
try {
  console.log('📝 Test 3: 하이드레이션 스크립트');
  const engine = new SSREngine();

  const state = { count: 5 };
  const script = engine.generateHydrationScript(state);

  assertTrue(script.includes('<script>'), '스크립트 태그 포함');
  assertTrue(script.includes('__INITIAL_STATE__'), '상태 변수 포함');
  assertTrue(script.includes('count'), 'count 값 포함');

  console.log('✅ 하이드레이션 스크립트 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 4: 전체 HTML 페이지
try {
  console.log('📝 Test 4: 전체 HTML 페이지');
  const engine = new SSREngine();

  const Component = {
    render: async (context) => `<h1>${context.props.title}</h1>`,
  };

  engine.registerComponent('Page', Component);

  (async () => {
    const html = await engine.renderFullPage(
      'Test Page',
      'Page',
      { title: 'Welcome' },
      { count: 0 }
    );

    assertTrue(html.includes('<!DOCTYPE html>'), 'DOCTYPE 포함');
    assertTrue(html.includes('<title>Test Page</title>'), '페이지 제목');
    assertTrue(html.includes('Welcome'), '컴포넌트 렌더링');
    assertTrue(
      html.includes('__INITIAL_STATE__'),
      '초기 상태 포함'
    );
  })();

  console.log('✅ 전체 HTML 페이지 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 5: Hydration
try {
  console.log('📝 Test 5: Hydration');

  const initialState = { count: 0, user: 'Alice' };
  const hydration = new Hydration(initialState);

  assertTrue(!hydration.isMounted(), '초기: 미마운트');

  (async () => {
    const result = await hydration.initialize({}, {});
    assertTrue(hydration.isMounted(), 'Initialize 후: 마운트됨');
    assertEqual(result.user, 'Alice', '초기 상태 복원');

    hydration.syncState({ count: 5 });
    assertEqual(hydration.initialState.count, 5, '상태 동기화');
  })();

  console.log('✅ Hydration 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

console.log('╔════════════════════════════════════════════╗');
console.log(`║  Test 결과: ${testsPassed}/5 통과               ║`);
console.log('╚════════════════════════════════════════════╝\n');

if (testsFailed === 0) {
  console.log('🎉 모든 테스트 통과!\n');
  process.exit(0);
} else {
  console.log(`❌ ${testsFailed}개 테스트 실패\n`);
  process.exit(1);
}
