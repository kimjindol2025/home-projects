/**
 * Router 테스트
 * Router의 모든 기능을 검증
 */

const Router = require('./router');

let testsPassed = 0;
let testsFailed = 0;

// 테스트 유틸리티
function assertEqual(actual, expected, message) {
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    console.error(`❌ ${message}`);
    console.error(`   Expected: ${JSON.stringify(expected)}`);
    console.error(`   Actual: ${JSON.stringify(actual)}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertTrue(condition, message) {
  if (!condition) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertExists(value, message) {
  if (value === null || value === undefined) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

// Mock window 객체
global.window = {
  location: {
    hash: '',
    pathname: '/',
    search: '',
  },
  history: {
    pushState: () => {},
    replaceState: () => {},
    back: () => {},
    forward: () => {},
    go: () => {},
  },
  addEventListener: () => {},
};

// 테스트 케이스
console.log('\n╔════════════════════════════════════════════╗');
console.log('║  Router 테스트                            ║');
console.log('╚════════════════════════════════════════════╝\n');

// Test 1: 기본 라우트 등록 및 매칭
try {
  console.log('📝 Test 1: 기본 라우트 등록 및 매칭');
  const router = new Router([], { mode: 'hash', baseUrl: '/' });

  const homeComponent = { name: 'Home' };
  router.registerRoute('/', homeComponent, { title: 'Home' });

  const route = router.matchRoute('/');
  assertExists(route, '라우트 매칭 결과 존재');
  assertEqual(route.path, '/', '경로 일치');
  assertEqual(route.component.name, 'Home', '컴포넌트 일치');

  console.log('✅ 기본 라우트 등록 및 매칭 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 2: 동적 라우트 및 매개변수 추출
try {
  console.log('📝 Test 2: 동적 라우트 및 매개변수 추출');
  const router = new Router([], { mode: 'hash' });

  const userComponent = { name: 'UserProfile' };
  router.registerRoute('/user/:id', userComponent);

  const route = router.matchRoute('/user/123');
  assertExists(route, '동적 라우트 매칭');
  assertEqual(route.params.id, '123', 'ID 매개변수 추출');

  const route2 = router.matchRoute('/user/john-doe');
  assertEqual(route2.params.id, 'john-doe', '문자열 ID 추출');

  console.log('✅ 동적 라우트 및 매개변수 추출 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 3: 여러 매개변수
try {
  console.log('📝 Test 3: 여러 매개변수 추출');
  const router = new Router([], { mode: 'hash' });

  router.registerRoute('/blog/:category/:id', { name: 'BlogPost' });

  const route = router.matchRoute('/blog/tech/42');
  assertEqual(route.params.category, 'tech', 'category 매개변수');
  assertEqual(route.params.id, '42', 'id 매개변수');

  console.log('✅ 여러 매개변수 추출 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 4: 구독 시스템
try {
  console.log('📝 Test 4: 구독 시스템');
  const routes = [
    {
      path: '/',
      component: { name: 'Home' },
      meta: {},
      regex: /^\/$/,
      params: [],
    },
  ];
  const router = new Router(routes, { mode: 'hash' });

  let updateCount = 0;
  const unsubscribe = router.subscribe(() => {
    updateCount++;
  });

  // 직접 상태 변경으로 구독자 호출
  router.currentRoute = { path: '/' };
  router._notifyListeners();
  assertEqual(updateCount, 1, '첫 번째 업데이트 감지');

  unsubscribe();
  router._notifyListeners();
  assertEqual(updateCount, 1, '구독 해제 후 감지 안 됨');

  console.log('✅ 구독 시스템 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 5: 라우트 가드
try {
  console.log('📝 Test 5: 라우트 가드 (beforeEnter)');
  const router = new Router([], { mode: 'hash' });

  let guardCalled = false;
  const guardComponent = { name: 'Protected' };

  router.registerRoute('/admin', guardComponent, {
    beforeEnter: async (route) => {
      guardCalled = true;
      return true;
    },
  });

  (async () => {
    await router.navigate('/admin');
    assertTrue(guardCalled, 'beforeEnter 가드 실행됨');
  })();

  console.log('✅ 라우트 가드 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 6: 미들웨어
try {
  console.log('📝 Test 6: 미들웨어 시스템');
  const router = new Router([], { mode: 'hash' });

  let middlewareCalled = false;
  router.use(async (route) => {
    middlewareCalled = true;
    return true;
  });

  router.registerRoute('/test', { name: 'Test' });

  (async () => {
    await router.navigate('/test');
    assertTrue(middlewareCalled, '미들웨어 실행됨');
  })();

  console.log('✅ 미들웨어 시스템 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 7: 라우트 생성 (createPath)
try {
  console.log('📝 Test 7: 라우트 생성 (createPath)');
  const router = new Router([], { mode: 'hash' });

  const path = router.createPath('/user/:id/post/:postId', {
    id: '123',
    postId: '456',
  });

  assertEqual(path, '/user/123/post/456', '경로 생성 확인');

  console.log('✅ 라우트 생성 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 8: 활성 라우트 확인
try {
  console.log('📝 Test 8: 활성 라우트 확인 (isActive)');
  const router = new Router([], { mode: 'hash' });

  // 초기 경로 - currentRoute가 없으므로 비활성
  assertTrue(!router.isActive('/about'), '초기 경로 비활성');

  // 라우트 설정 후
  router.currentRoute = { path: '/' };
  assertTrue(router.isActive('/'), '현재 경로 활성');

  // 다른 경로 확인
  router.currentRoute = { path: '/about' };
  assertTrue(!router.isActive('/'), '다른 경로 비활성');

  console.log('✅ 활성 라우트 확인 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 9: 히스토리 관리
try {
  console.log('📝 Test 9: 히스토리 관리');
  const router = new Router([], { mode: 'hash' });

  router.registerRoute('/', { name: 'Home' });
  router.registerRoute('/about', { name: 'About' });
  router.registerRoute('/contact', { name: 'Contact' });

  (async () => {
    await router.navigate('/');
    await router.navigate('/about');
    await router.navigate('/contact');

    const history = router.getHistory();
    assertTrue(history.length > 0, '히스토리 항목 존재');
    const lastEntry = history[history.length - 1];
    assertTrue(lastEntry.path === '/contact' || lastEntry.path === undefined, '마지막 경로 기록');
  })();

  console.log('✅ 히스토리 관리 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 10: 라우터 통계
try {
  console.log('📝 Test 10: 라우터 통계 정보');
  const router = new Router([], { mode: 'hash' });

  router.registerRoute('/', { name: 'Home' });
  router.registerRoute('/about', { name: 'About' });
  router.use(() => true);
  router.registerGuard('auth', () => true);

  const stats = router.getStats();
  assertEqual(stats.routeCount, 2, '라우트 개수');
  assertEqual(stats.middlewareCount, 1, '미들웨어 개수');
  assertEqual(stats.guardCount, 1, '가드 개수');
  assertTrue(stats.historyLength >= 0, '히스토리 길이 유효');

  console.log('✅ 라우터 통계 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// 최종 보고서
console.log('╔════════════════════════════════════════════╗');
console.log(`║  Test 결과: ${testsPassed}/10 통과              ║`);
console.log('╚════════════════════════════════════════════╝\n');

if (testsFailed === 0) {
  console.log('🎉 모든 테스트 통과!\\n');
  process.exit(0);
} else {
  console.log(`❌ ${testsFailed}개 테스트 실패\n`);
  process.exit(1);
}
