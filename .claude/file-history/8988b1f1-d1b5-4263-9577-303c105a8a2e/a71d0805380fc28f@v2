/**
 * Performance Monitor 테스트
 */

const PerformanceMonitor = require('./performance-monitor');
const { Profiler } = require('./performance-monitor');

let testsPassed = 0;
let testsFailed = 0;

function assertTrue(condition, message) {
  if (!condition) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

console.log('\n╔════════════════════════════════════════════╗');
console.log('║  Performance Monitor 테스트               ║');
console.log('╚════════════════════════════════════════════╝\n');

// Test 1: 성능 마크 및 측정
try {
  console.log('📝 Test 1: 성능 마크 및 측정');
  const monitor = new PerformanceMonitor();

  monitor.mark('start');
  // 시뮬레이션: 약 10ms 대기
  const end = Date.now() + 10;
  while (Date.now() < end) {}

  monitor.mark('end');
  const duration = monitor.measure('operation', 'start', 'end');

  assertTrue(duration !== null, '측정 성공');
  assertTrue(duration >= 10, '시간 측정 정확함');

  console.log('✅ 성능 마크 및 측정 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 2: 상태 업데이트 추적
try {
  console.log('📝 Test 2: 상태 업데이트 추적');
  const monitor = new PerformanceMonitor();

  monitor.trackStateUpdate('Component1', 15);
  monitor.trackStateUpdate('Component1', 20);
  monitor.trackStateUpdate('Component2', 30);

  const stats = monitor.getStats();
  assertTrue(stats.measuredMetrics >= 0, '통계 생성됨');

  console.log('✅ 상태 업데이트 추적 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 3: 병목 지점 감지
try {
  console.log('📝 Test 3: 병목 지점 감지');
  const monitor = new PerformanceMonitor();

  // 빠른 작업
  monitor.mark('fast-start');
  monitor.mark('fast-end');
  monitor.measure('fast-op', 'fast-start', 'fast-end');

  // 느린 작업 시뮬레이션
  for (let i = 0; i < 3; i++) {
    monitor.mark(`slow-start-${i}`);
    const end = Date.now() + 150;
    while (Date.now() < end) {}
    monitor.mark(`slow-end-${i}`);
    monitor.measure('slow-op', `slow-start-${i}`, `slow-end-${i}`);
  }

  const bottlenecks = monitor.detectBottlenecks(100);
  assertTrue(bottlenecks.length > 0, '병목 지점 감지됨');
  assertTrue(bottlenecks[0].name === 'slow-op', '느린 작업 감지');

  console.log('✅ 병목 지점 감지 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 4: Profiler 컴포넌트 분석
try {
  console.log('📝 Test 4: Profiler 컴포넌트 분석');
  const profiler = new Profiler();

  profiler.recordComponentRender('Header', 10);
  profiler.recordComponentRender('Header', 12);
  profiler.recordComponentRender('Content', 50);
  profiler.recordComponentRender('Content', 55);
  profiler.recordComponentRender('Sidebar', 100);

  const report = profiler.getReport();
  assertTrue(report.totalComponents >= 3, '3개 컴포넌트 추적');
  assertTrue(report.totalRenders === 5, '5개 렌더링 기록');

  const slowComponents = profiler.getSlowComponents(40);
  assertTrue(slowComponents.length > 0, '느린 컴포넌트 감지');

  console.log('✅ Profiler 컴포넌트 분석 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

console.log('╔════════════════════════════════════════════╗');
console.log(`║  Test 결과: ${testsPassed}/4 통과               ║`);
console.log('╚════════════════════════════════════════════╝\n');

if (testsFailed === 0) {
  console.log('🎉 모든 테스트 통과!\n');
  process.exit(0);
} else {
  console.log(`❌ ${testsFailed}개 테스트 실패\n`);
  process.exit(1);
}
