/**
 * State Router 테스트
 * StateRouter와 RouteState의 모든 기능을 검증
 */

const StateRouter = require('./state-router');
const { RouteState } = require('./state-router');

let testsPassed = 0;
let testsFailed = 0;

// 테스트 유틸리티
function assertEqual(actual, expected, message) {
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    console.error(`❌ ${message}`);
    console.error(`   Expected: ${JSON.stringify(expected)}`);
    console.error(`   Actual: ${JSON.stringify(actual)}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertTrue(condition, message) {
  if (!condition) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertExists(value, message) {
  if (value === null || value === undefined) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

// Mock window 객체
global.window = {
  location: {
    hash: '',
    pathname: '/',
    search: '',
  },
  history: {
    pushState: () => {},
    replaceState: () => {},
    back: () => {},
    forward: () => {},
    go: () => {},
  },
  addEventListener: () => {},
};

// 테스트 케이스
console.log('\n╔════════════════════════════════════════════╗');
console.log('║  State Router 테스트                      ║');
console.log('╚════════════════════════════════════════════╝\n');

// Test 1: RouteState 기본 기능
try {
  console.log('📝 Test 1: RouteState 기본 기능');
  const routeState = new RouteState('/dashboard', {
    currentTab: 'overview',
    data: null,
  });

  assertEqual(routeState.path, '/dashboard', '경로 확인');
  assertEqual(routeState.getState('currentTab'), 'overview', '상태 조회');

  routeState.setState({ currentTab: 'analytics' });
  assertEqual(routeState.getState('currentTab'), 'analytics', '상태 업데이트');

  console.log('✅ RouteState 기본 기능 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 2: RouteState 메타데이터
try {
  console.log('📝 Test 2: RouteState 메타데이터');
  const routeState = new RouteState('/profile');

  routeState.setMetadata('requiresAuth', true);
  routeState.setMetadata('title', 'User Profile');

  assertTrue(routeState.getMetadata('requiresAuth'), 'Auth 메타데이터 확인');
  assertEqual(routeState.getMetadata('title'), 'User Profile', '제목 메타데이터');

  console.log('✅ RouteState 메타데이터 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 3: StateRouter 라우트 상태 격리
try {
  console.log('📝 Test 3: StateRouter 라우트 상태 격리');
  const stateTemplate = {
    currentTab: 'overview',
    count: 0,
  };

  const stateRouter = new StateRouter([], stateTemplate, {
    persist: false,
  });

  // 첫 번째 라우트 상태 설정
  stateRouter.setRouteState('/dashboard', { currentTab: 'overview', count: 0 });

  // 두 번째 라우트 상태 설정
  stateRouter.setRouteState('/analytics', { currentTab: 'charts', count: 5 });

  // 상태 격리 확인
  const dashboardState = stateRouter.getRouteState('/dashboard');
  const analyticsState = stateRouter.getRouteState('/analytics');

  assertEqual(dashboardState.getState('count'), 0, '대시보드 상태');
  assertEqual(analyticsState.getState('count'), 5, '분석 상태');

  console.log('✅ 라우트 상태 격리 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 4: 라우트 전환 시 상태 동기화
try {
  console.log('📝 Test 4: 라우트 전환 시 상태 동기화');
  const routes = [
    {
      path: '/',
      component: { name: 'Home' },
      meta: {},
      regex: /^\/$/,
      params: [],
    },
    {
      path: '/settings',
      component: { name: 'Settings' },
      meta: {},
      regex: /^\/settings$/,
      params: [],
    },
  ];

  const stateTemplate = { theme: 'light', language: 'en' };
  const stateRouter = new StateRouter(routes, stateTemplate, { persist: false });

  // 라우트별 상태 설정
  stateRouter.setRouteState('/', { theme: 'light', language: 'en' });
  stateRouter.setRouteState('/settings', { theme: 'dark', language: 'ko' });

  // 상태 동기화 확인
  const currentState = stateRouter.globalState.getState();
  assertTrue(
    currentState.theme === 'light' || currentState.theme === 'dark',
    '글로벌 상태 동기화'
  );

  console.log('✅ 상태 동기화 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 5: 캐싱 시스템
try {
  console.log('📝 Test 5: 캐싱 시스템');
  const stateTemplate = { data: null };
  const stateRouter = new StateRouter([], stateTemplate, {
    persist: false,
    maxCacheAge: 5000,
  });

  // 라우트 상태 생성
  stateRouter.setRouteState('/page1', { data: 'content1' });
  stateRouter.setRouteState('/page2', { data: 'content2' });

  // 현재 라우트 설정하고 캐시 저장
  stateRouter.currentRouteState = stateRouter.getRouteState('/page1');

  // 캐시에 수동으로 상태 저장 (라우트 전환 시뮬레이션)
  stateRouter.cache.set('/page1', {
    state: { data: 'content1' },
    timestamp: Date.now(),
  });

  // 캐시 통계 확인
  const cacheStats = stateRouter.getCacheStats();
  assertTrue(cacheStats.totalRoutes >= 2, '라우트 개수 확인');
  assertTrue(cacheStats.cacheSize >= 0, '캐시 크기 유효함');
  assertTrue(stateRouter.cache.size > 0, '캐시에 항목 존재');

  console.log('✅ 캐싱 시스템 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 6: StateRouter 통계 및 리셋
try {
  console.log('📝 Test 6: StateRouter 통계 및 리셋');
  const stateTemplate = { count: 0 };
  const stateRouter = new StateRouter([], stateTemplate, { persist: false });

  // 초기 통계
  const initialStats = stateRouter.getStats();
  assertTrue(initialStats.routerStats !== undefined, '라우터 통계 포함');
  assertTrue(initialStats.globalStateStats !== undefined, '글로벌 상태 통계 포함');
  assertEqual(initialStats.routeStateCount, 0, '초기 라우트 상태 개수');

  // 라우트 상태 추가
  stateRouter.setRouteState('/page1', { count: 5 });
  stateRouter.setRouteState('/page2', { count: 10 });

  const beforeResetStats = stateRouter.getStats();
  assertEqual(beforeResetStats.routeStateCount, 2, 'Reset 전 라우트 상태 개수');

  // 리셋
  stateRouter.reset({ count: 0 });
  const afterResetStats = stateRouter.getStats();
  assertEqual(afterResetStats.routeStateCount, 0, 'Reset 후 라우트 상태 개수');

  console.log('✅ 통계 및 리셋 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// 최종 보고서
console.log('╔════════════════════════════════════════════╗');
console.log(`║  Test 결과: ${testsPassed}/6 통과               ║`);
console.log('╚════════════════════════════════════════════╝\n');

if (testsFailed === 0) {
  console.log('🎉 모든 테스트 통과!\n');
  process.exit(0);
} else {
  console.log(`❌ ${testsFailed}개 테스트 실패\n`);
  process.exit(1);
}
