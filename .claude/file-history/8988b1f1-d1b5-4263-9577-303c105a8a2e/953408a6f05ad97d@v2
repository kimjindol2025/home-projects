/**
 * Phase 6 통합 테스트
 * GlobalState + Router + StateRouter + Middleware의 완벽한 통합
 */

const GlobalStateManager = require('./global-state-manager');
const Router = require('./router');
const StateRouter = require('./state-router');
const MiddlewarePipeline = require('./middleware');
const { BuiltInMiddlewares } = require('./middleware');

let testsPassed = 0;
let testsFailed = 0;

// 테스트 유틸리티
function assertEqual(actual, expected, message) {
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    console.error(`❌ ${message}`);
    console.error(`   Expected: ${JSON.stringify(expected)}`);
    console.error(`   Actual: ${JSON.stringify(actual)}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertTrue(condition, message) {
  if (!condition) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

// Mock window 객체
global.window = {
  location: {
    hash: '',
    pathname: '/',
    search: '',
  },
  history: {
    pushState: () => {},
    replaceState: () => {},
    back: () => {},
    forward: () => {},
    go: () => {},
  },
  addEventListener: () => {},
};

// 테스트 케이스
console.log('\n╔════════════════════════════════════════════╗');
console.log('║  Phase 6 통합 테스트                      ║');
console.log('╚════════════════════════════════════════════╝\n');

// Test 1: GlobalState + Router 통합
try {
  console.log('📝 Test 1: GlobalState + Router 통합');

  const globalState = new GlobalStateManager(
    { theme: 'light', user: null },
    { persist: false }
  );

  const router = new Router(
    [
      {
        path: '/',
        component: { name: 'Home' },
        meta: {},
        regex: /^\/$/,
        params: [],
      },
      {
        path: '/settings',
        component: { name: 'Settings' },
        meta: {},
        regex: /^\/settings$/,
        params: [],
      },
    ],
    { mode: 'hash' }
  );

  let routeChangeCount = 0;
  router.subscribe((route) => {
    routeChangeCount++;
  });

  let stateChangeCount = 0;
  globalState.subscribe((state) => {
    stateChangeCount++;
  });

  // 상태 변경
  globalState.setState({ theme: 'dark' });
  assertEqual(globalState.getState('theme'), 'dark', '글로벌 상태 업데이트');

  // 라우트 매칭
  const route = router.matchRoute('/settings');
  assertTrue(route !== null, '라우트 매칭 성공');
  assertEqual(route.component.name, 'Settings', '컴포넌트 확인');

  console.log('✅ GlobalState + Router 통합 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 2: StateRouter 전체 흐름
try {
  console.log('📝 Test 2: StateRouter 전체 흐름');

  const routes = [
    {
      path: '/',
      component: { name: 'Home' },
      meta: {},
      regex: /^\/$/,
      params: [],
    },
    {
      path: '/dashboard',
      component: { name: 'Dashboard' },
      meta: {},
      regex: /^\/dashboard$/,
      params: [],
    },
  ];

  const stateTemplate = {
    theme: 'light',
    notifications: [],
    currentUser: null,
  };

  const stateRouter = new StateRouter(routes, stateTemplate, {
    persist: false,
  });

  // 라우트별 상태 설정
  stateRouter.setRouteState('/', { theme: 'light' });
  stateRouter.setRouteState('/dashboard', { theme: 'dark', notifications: [] });

  // 라우트 상태 확인
  const homeState = stateRouter.getRouteState('/');
  assertTrue(homeState !== null, '홈 라우트 상태 존재');
  assertEqual(homeState.getState('theme'), 'light', '홈 테마 확인');

  const dashboardState = stateRouter.getRouteState('/dashboard');
  assertEqual(dashboardState.getState('theme'), 'dark', '대시보드 테마 확인');

  console.log('✅ StateRouter 전체 흐름 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 3: 미들웨어 + 라우터 통합
try {
  console.log('📝 Test 3: 미들웨어 + 라우터 통합');

  const pipeline = new MiddlewarePipeline();
  const logs = [];

  // 로깅 미들웨어 추가
  const loggingMiddleware = BuiltInMiddlewares.loggingMiddleware({
    verbose: false,
    onLog: (msg) => logs.push(msg),
  });

  pipeline.use(loggingMiddleware);

  // 인증 미들웨어 추가
  let isAuth = false;
  const authMiddleware = BuiltInMiddlewares.authMiddleware({
    isAuthenticated: () => isAuth,
    redirectPath: '/login',
  });

  pipeline.use(authMiddleware);

  (async () => {
    // 미인증 상태
    const context1 = {
      route: {
        path: '/admin',
        meta: { requiresAuth: true },
      },
    };

    const result1 = await pipeline.execute(context1);
    assertTrue(result1 === false, '인증 실패로 false 반환');
    assertTrue(logs.length > 0, '로그 기록됨');

    // 인증 상태로 변경
    isAuth = true;
    const result2 = await pipeline.execute(context1);
    assertTrue(result2 === true, '인증 성공으로 true 반환');
  })();

  console.log('✅ 미들웨어 + 라우터 통합 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 4: 전체 애플리케이션 흐름 (State + Router + Middleware)
try {
  console.log('📝 Test 4: 전체 애플리케이션 흐름');

  // 1. 상태 초기화
  const appState = new GlobalStateManager(
    {
      user: null,
      theme: 'light',
      notifications: [],
      loading: false,
    },
    { persist: false }
  );

  // 2. 미들웨어 파이프라인 설정
  const middlewarePipeline = new MiddlewarePipeline();

  const logs = [];
  middlewarePipeline.use(
    BuiltInMiddlewares.loggingMiddleware({
      onLog: (msg) => logs.push(msg),
    }),
    { priority: 10 }
  );

  // 3. Computed property 설정
  appState.defineComputed('isAuthenticated', (state) => state.user !== null);

  appState.defineComputed('isDarkMode', (state) => state.theme === 'dark');

  // 4. 액션 정의
  appState.defineAction('login', (context, userData) => {
    context.setState({ user: userData, loading: false });
  });

  appState.defineAction('logout', (context) => {
    context.setState({ user: null });
  });

  // 5. 상태 변경
  appState.setState({ loading: true });
  appState.dispatch('login', { id: 1, name: 'John' });

  // 6. Computed 값 확인
  const isAuth = appState.getComputed('isAuthenticated');
  assertTrue(isAuth === true, 'Computed: isAuthenticated = true');

  // 7. 액션 실행 후 상태 확인
  appState.dispatch('logout');
  const isAuthAfterLogout = appState.getComputed('isAuthenticated');
  assertTrue(isAuthAfterLogout === false, 'Logout 후 isAuthenticated = false');

  console.log('✅ 전체 애플리케이션 흐름 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 5: 동적 라우트 + 상태 동기화
try {
  console.log('📝 Test 5: 동적 라우트 + 상태 동기화');

  const routes = [
    {
      path: '/user/:id',
      component: { name: 'UserProfile' },
      meta: {},
      regex: /^\/user\/([^\/]+)$/,
      params: ['id'],
    },
  ];

  const stateTemplate = { selectedUserId: null, userData: null };
  const stateRouter = new StateRouter(routes, stateTemplate, { persist: false });

  // 사용자별 상태 설정
  stateRouter.setRouteState('/user/123', {
    selectedUserId: '123',
    userData: { name: 'John', role: 'admin' },
  });

  stateRouter.setRouteState('/user/456', {
    selectedUserId: '456',
    userData: { name: 'Jane', role: 'user' },
  });

  // 라우트 매칭
  const route = stateRouter.router.matchRoute('/user/123');
  assertTrue(route !== null, '동적 라우트 매칭');
  assertEqual(route.params.id, '123', 'ID 매개변수 추출');

  // 상태 확인
  const user123State = stateRouter.getRouteState('/user/123');
  assertEqual(user123State.getState('selectedUserId'), '123', '사용자 123 상태');

  console.log('✅ 동적 라우트 + 상태 동기화 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 6: 에러 처리 및 복원력
try {
  console.log('📝 Test 6: 에러 처리 및 복원력');

  const stateManager = new GlobalStateManager({ count: 0 }, { persist: false });

  let errorCaught = false;

  // 에러 발생하는 watcher
  stateManager.watch('count', (newVal, oldVal) => {
    if (newVal > 10) {
      throw new Error('Count too high');
    }
  });

  // 상태 변경 (에러 처리)
  stateManager.setState({ count: 5 });
  assertTrue(stateManager.getState('count') === 5, '정상 상태 변경');

  // try-catch로 보호된 상태 변경
  try {
    stateManager.setState({ count: 15 });
  } catch (e) {
    errorCaught = true;
  }

  // 에러 발생했지만 상태는 업데이트됨 (watcher 에러는 별도 처리)
  assertTrue(stateManager.getState('count') === 15, '에러에도 상태 업데이트됨');

  // 복원: 유효한 상태로 리셋
  stateManager.reset({ count: 0 });
  assertEqual(stateManager.getState('count'), 0, '상태 복원됨');

  console.log('✅ 에러 처리 및 복원력 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

