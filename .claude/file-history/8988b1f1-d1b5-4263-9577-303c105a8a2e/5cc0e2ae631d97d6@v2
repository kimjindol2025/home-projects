/**
 * Tailwind CSS 컴파일러 테스트
 * TailwindCompiler의 모든 기능을 검증
 */

const TailwindCompiler = require('./tailwind-compiler');

let testsPassed = 0;
let testsFailed = 0;

// 테스트 유틸리티
function assertEqual(actual, expected, message) {
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    console.error(`❌ ${message}`);
    console.error(`   Expected: ${JSON.stringify(expected)}`);
    console.error(`   Actual: ${JSON.stringify(actual)}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertTrue(condition, message) {
  if (!condition) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertContains(str, substring, message) {
  if (!str.includes(substring)) {
    console.error(`❌ ${message}`);
    console.error(`   Expected substring: ${substring}`);
    console.error(`   In string: ${str.substring(0, 100)}...`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

// 테스트 케이스
console.log('\n╔════════════════════════════════════════════╗');
console.log('║  Tailwind CSS 컴파일러 테스트          ║');
console.log('╚════════════════════════════════════════════╝\n');

// Test 1: 기본 컴파일
try {
  console.log('📝 Test 1: 기본 CSS 컴파일');
  const compiler = new TailwindCompiler();

  const css = `
    .btn {
      padding: 10px;
      background: blue;
    }
  `;

  const compiled = compiler.compileCSS(css);

  assertTrue(compiled.length > 0, '컴파일된 CSS가 있어야 함');
  assertContains(compiled, 'btn', 'btn 클래스가 유지되어야 함');

  console.log('✅ 기본 컴파일 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 2: @tailwind 디렉티브 처리
try {
  console.log('📝 Test 2: @tailwind 디렉티브 처리');
  const compiler = new TailwindCompiler();

  const css = `
    @tailwind base;
    @tailwind components;
    @tailwind utilities;
  `;

  const compiled = compiler.compileCSS(css);

  assertContains(compiled, 'box-sizing', '@tailwind base가 생성되어야 함');
  assertContains(compiled, '.btn', '@tailwind components가 생성되어야 함');
  assertContains(compiled, '.flex', '@tailwind utilities가 생성되어야 함');

  console.log('✅ @tailwind 디렉티브 처리 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 3: @apply 지시문 처리
try {
  console.log('📝 Test 3: @apply 지시문 처리');
  const compiler = new TailwindCompiler();

  const css = `
    .custom-btn {
      @apply px-4 py-2 bg-blue-500 text-white rounded;
    }
  `;

  const compiled = compiler.compileCSS(css);

  assertContains(compiled, 'padding-left', '@apply px-4가 확장되어야 함');
  assertContains(compiled, 'background-color', '@apply bg-blue-500가 확장되어야 함');
  assertContains(compiled, 'color', '@apply text-white가 확장되어야 함');

  console.log('✅ @apply 지시문 처리 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 4: 커스텀 스타일 등록
try {
  console.log('📝 Test 4: 커스텀 스타일 등록');
  const compiler = new TailwindCompiler();

  compiler.registerCustomStyle('.my-custom', {
    'color': 'red',
    'font-size': '16px',
  });

  const css = compiler.compileCSS('.btn { padding: 10px; }');

  assertContains(css, 'my-custom', '커스텀 스타일 선택자가 포함되어야 함');
  assertContains(css, 'red', '커스텀 속성이 포함되어야 함');

  console.log('✅ 커스텀 스타일 등록 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 5: CSS 최적화
try {
  console.log('📝 Test 5: CSS 최적화 (중복 제거)');
  const compiler = new TailwindCompiler();

  const css = `
    /* 주석 */
    .btn { color: blue; }
    .btn { color: blue; }
    .btn { color: blue; }
  `;

  const compiled = compiler.compileCSS(css);

  // 최적화 후 주석 제거 확인
  assertTrue(!compiled.includes('/*'), '주석이 제거되어야 함');

  console.log('✅ CSS 최적화 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 6: 클래스 추출
try {
  console.log('📝 Test 6: HTML에서 클래스 추출');
  const compiler = new TailwindCompiler();

  const html = `
    <button class="px-4 py-2 bg-blue-500">Button</button>
    <div className="flex items-center justify-center">Content</div>
  `;

  const classes = compiler.extractClasses(html);

  assertTrue(classes.has('px-4'), 'px-4 클래스 추출됨');
  assertTrue(classes.has('py-2'), 'py-2 클래스 추출됨');
  assertTrue(classes.has('bg-blue-500'), 'bg-blue-500 클래스 추출됨');
  assertTrue(classes.has('flex'), 'flex 클래스 추출됨');
  assertTrue(classes.has('items-center'), 'items-center 클래스 추출됨');

  console.log('✅ 클래스 추출 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 7: PurgeCSS (사용되지 않는 클래스 제거 감지)
try {
  console.log('📝 Test 7: 사용되지 않는 클래스 감지');
  const compiler = new TailwindCompiler();

  const css = `
    .px-4 { padding-left: 1rem; padding-right: 1rem; }
    .py-2 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
    .unused-class { color: red; }
  `;

  const html = `<button class="px-4 py-2">Button</button>`;

  // purgeUnusedCSS는 사용되지 않는 클래스 감지
  const result = compiler.purgeUnusedCSS(css, html);

  assertTrue(result.includes('px-4'), 'px-4 사용됨');
  assertTrue(result.includes('unused-class'), '감지만 하고 제거하지는 않음');

  console.log('✅ 사용되지 않는 클래스 감지 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 8: Tailwind Config 로드
try {
  console.log('📝 Test 8: Tailwind Config 로드');
  const config = {
    theme: {
      colors: {
        primary: '#3b82f6',
        secondary: '#6b7280',
      },
    },
  };

  const compiler = new TailwindCompiler({ config });

  compiler.loadConfig(config);

  const stats = compiler.getStats();

  assertTrue(stats.hasConfig, 'Config가 로드되어야 함');

  console.log('✅ Tailwind Config 로드 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 9: 통계 정보
try {
  console.log('📝 Test 9: 통계 정보');
  const compiler = new TailwindCompiler();

  compiler.registerCustomStyle('.custom1', { color: 'red' });
  compiler.registerCustomStyle('.custom2', { color: 'blue' });
  compiler.addPurgePatterns(['src/**/*.html', 'src/**/*.jsx']);

  const stats = compiler.getStats();

  assertEqual(stats.customStyles, 2, '커스텀 스타일 2개');
  assertEqual(stats.purgePatterns, 2, 'Purge 패턴 2개');

  console.log('✅ 통계 정보 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 10: 복합 CSS 컴파일
try {
  console.log('📝 Test 10: 복합 CSS 컴파일 (@tailwind + @apply + 커스텀)');
  const compiler = new TailwindCompiler();

  const css = `
    @tailwind base;

    .my-button {
      @apply px-4 py-2 rounded bg-blue-500 text-white;
      transition: all 0.2s;
    }

    .my-button:hover {
      @apply bg-blue-600 shadow-lg;
    }
  `;

  const compiled = compiler.compileCSS(css);

  assertContains(compiled, 'my-button', '커스텀 버튼 클래스 포함');
  assertContains(compiled, 'padding', '@apply 확장됨');
  assertContains(compiled, 'background-color', '@tailwind 유틸리티 포함');

  console.log('✅ 복합 CSS 컴파일 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// 최종 보고서
console.log('╔════════════════════════════════════════════╗');
console.log(`║  Test 결과: ${testsPassed}/10 통과              ║`);
console.log('╚════════════════════════════════════════════╝\n');

if (testsFailed === 0) {
  console.log('🎉 모든 테스트 통과!\n');
  process.exit(0);
} else {
  console.log(`❌ ${testsFailed}개 테스트 실패\n`);
  process.exit(1);
}
