/**
 * Global State Manager 테스트
 * GlobalStateManager의 모든 기능을 검증
 */

const GlobalStateManager = require('./global-state-manager');

let testsPassed = 0;
let testsFailed = 0;

// 테스트 유틸리티
function assertEqual(actual, expected, message) {
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    console.error(`❌ ${message}`);
    console.error(`   Expected: ${JSON.stringify(expected)}`);
    console.error(`   Actual: ${JSON.stringify(actual)}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertTrue(condition, message) {
  if (!condition) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

function assertContains(obj, key, message) {
  if (!(key in obj)) {
    console.error(`❌ ${message}`);
    testsFailed++;
    throw new Error(`Assertion failed: ${message}`);
  }
}

// 테스트 케이스
console.log('\n╔════════════════════════════════════════════╗');
console.log('║  Global State Manager 테스트            ║');
console.log('╚════════════════════════════════════════════╝\n');

// Test 1: 초기 상태 설정
try {
  console.log('📝 Test 1: 초기 상태 설정');
  const initialState = { count: 0, message: 'Hello' };
  const manager = new GlobalStateManager(initialState, { persist: false });

  assertEqual(manager.getState(), initialState, '초기 상태 확인');
  assertEqual(manager.getState('count'), 0, '상태 경로 접근');
  assertEqual(manager.getState('message'), 'Hello', '메시지 상태 확인');

  console.log('✅ 초기 상태 설정 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 2: 상태 업데이트
try {
  console.log('📝 Test 2: 상태 업데이트');
  const manager = new GlobalStateManager({ count: 0 }, { persist: false });

  manager.setState({ count: 1 });
  assertEqual(manager.getState('count'), 1, '상태 업데이트 확인');

  manager.setState({ count: 5, status: 'active' });
  assertEqual(manager.getState('count'), 5, '여러 업데이트');
  assertEqual(manager.getState('status'), 'active', '새 속성 추가');

  console.log('✅ 상태 업데이트 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 3: 구독 시스템
try {
  console.log('📝 Test 3: 구독 시스템');
  const manager = new GlobalStateManager({ count: 0 }, { persist: false });
  let updateCount = 0;

  const unsubscribe = manager.subscribe(() => {
    updateCount++;
  });

  manager.setState({ count: 1 });
  assertEqual(updateCount, 1, '첫 번째 업데이트 감지');

  manager.setState({ count: 2 });
  assertEqual(updateCount, 2, '두 번째 업데이트 감지');

  unsubscribe();
  manager.setState({ count: 3 });
  assertEqual(updateCount, 2, '구독 해제 후 감지 안 됨');

  console.log('✅ 구독 시스템 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 4: 깊은 상태 업데이트
try {
  console.log('📝 Test 4: 깊은 상태 업데이트 (setDeep)');
  const manager = new GlobalStateManager(
    { user: { name: 'John', age: 30 } },
    { persist: false }
  );

  manager.setDeep('user.name', 'Jane');
  assertEqual(manager.getState('user.name'), 'Jane', '깊은 경로 업데이트');

  manager.setDeep('user.email', 'jane@example.com');
  assertEqual(manager.getState('user.email'), 'jane@example.com', '새 깊은 속성 추가');

  console.log('✅ 깊은 상태 업데이트 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 5: Computed Properties
try {
  console.log('📝 Test 5: Computed Properties');
  const manager = new GlobalStateManager(
    { firstName: 'John', lastName: 'Doe' },
    { persist: false }
  );

  manager.defineComputed('fullName', (state) => {
    return state.firstName + ' ' + state.lastName;
  });

  assertEqual(manager.getComputed('fullName'), 'John Doe', 'Computed 값 확인');

  manager.setState({ firstName: 'Jane' });
  assertEqual(manager.getComputed('fullName'), 'Jane Doe', 'Computed 값 자동 업데이트');

  console.log('✅ Computed Properties 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 6: Watchers
try {
  console.log('📝 Test 6: Watchers');
  const manager = new GlobalStateManager({ count: 0 }, { persist: false });
  let watcherCalled = false;
  let newValue = null;
  let oldValue = null;

  manager.watch('count', (newVal, oldVal) => {
    watcherCalled = true;
    newValue = newVal;
    oldValue = oldVal;
  });

  manager.setState({ count: 5 });
  assertTrue(watcherCalled, 'Watcher 호출됨');
  assertEqual(newValue, 5, '새 값 전달');

  console.log('✅ Watchers 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 7: 액션
try {
  console.log('📝 Test 7: 액션 (Actions)');
  const manager = new GlobalStateManager({ count: 0 }, { persist: false });

  manager.defineAction('increment', (context) => {
    const current = context.getState('count');
    context.setState({ count: current + 1 });
  });

  manager.dispatch('increment');
  assertEqual(manager.getState('count'), 1, '액션 실행 후 상태 변경');

  manager.dispatch('increment');
  assertEqual(manager.getState('count'), 2, '액션 재실행');

  console.log('✅ 액션 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 8: 히스토리 (실행 취소/다시 실행)
try {
  console.log('📝 Test 8: 히스토리 (Undo/Redo)');
  const manager = new GlobalStateManager({ count: 0 }, { persist: false });

  // 상태 변경
  manager.setState({ count: 1 });
  manager.setState({ count: 2 });
  manager.setState({ count: 3 });

  // 현재 상태 확인
  assertTrue(manager.getState('count') === 3, '현재 상태 count=3');

  // 상태 리셋 테스트 (히스토리 관련 기능)
  manager.reset({ count: 0 });
  assertEqual(manager.getState('count'), 0, 'Reset 후 상태 초기화');

  // 히스토리 인덱스 확인
  assertTrue(manager.historyIndex >= 0, '히스토리 인덱스 유효함');
  assertTrue(manager.history.length > 0, '히스토리 항목 존재');

  console.log('✅ 히스토리 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 9: 상태 검증
try {
  console.log('📝 Test 9: 상태 검증 (Validation)');
  const manager = new GlobalStateManager({ age: 25, name: 'John' }, { persist: false });

  const schema = {
    age: { type: 'number', required: true, validate: (val) => val >= 0 },
    name: { type: 'string', required: true },
  };

  const result = manager.validate(schema);
  assertTrue(result.valid, '유효한 상태');
  assertEqual(result.errors.length, 0, '검증 에러 없음');

  // 유효하지 않은 상태
  manager.setState({ age: 'invalid' });
  const result2 = manager.validate(schema);
  assertTrue(!result2.valid, '유효하지 않은 타입 감지');

  console.log('✅ 상태 검증 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// Test 10: 통계 정보 및 기타 기능
try {
  console.log('📝 Test 10: 통계 정보 및 기타 기능');
  const manager = new GlobalStateManager({ count: 0 }, { persist: false });

  manager.subscribe(() => {});
  manager.defineComputed('doubled', (state) => state.count * 2);
  manager.watch('count', () => {});
  manager.defineAction('inc', () => {});

  const stats = manager.getStats();
  assertContains(stats, 'stateSize', '통계에 stateSize 포함');
  assertContains(stats, 'listenerCount', '통계에 listenerCount 포함');
  assertContains(stats, 'computedCount', '통계에 computedCount 포함');
  assertEqual(stats.computedCount, 1, 'Computed 개수 확인');
  assertEqual(stats.actionCount, 1, 'Action 개수 확인');

  // 상태 복사
  const cloned = manager.clone();
  assertEqual(cloned.getState('count'), 0, '복사된 상태 확인');

  // 상태 리셋
  manager.setState({ count: 99 });
  manager.reset({ count: 0 });
  assertEqual(manager.getState('count'), 0, 'Reset 후 상태');

  console.log('✅ 통계 정보 및 기타 기능 성공\n');
  testsPassed++;
} catch (err) {
  console.error(`   Error: ${err.message}\n`);
}

// 최종 보고서
console.log('╔════════════════════════════════════════════╗');
console.log(`║  Test 결과: ${testsPassed}/10 통과              ║`);
console.log('╚════════════════════════════════════════════╝\n');

if (testsFailed === 0) {
  console.log('🎉 모든 테스트 통과!\n');
  process.exit(0);
} else {
  console.log(`❌ ${testsFailed}개 테스트 실패\n`);
  process.exit(1);
}
