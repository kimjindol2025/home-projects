/* ============================================================================
   DHT Node - Kademlia K-bucket 관리 (Layer 1)

   목적: 160비트 NodeId + XOR 거리 + K-bucket 라우팅 테이블
   특징:
   - NanoPagePool 패턴으로 K-bucket 정적 할당
   - 160개 K-bucket (비트 길이)
   - K=20 노드/버킷
   - O(1) 거리 계산 (XOR)

   재사용: NanoPagePool pattern from freelang-nano-kernel

   크기: ~400줄
============================================================================ */

use std::vec::Vec;

// ============================================================================
// 1. NodeId - 160비트 Kademlia ID
// ============================================================================

#[derive(Clone, Copy)]
pub struct NodeId {
    pub bytes: [u8; 20],  // 160비트 = 20 바이트
}

impl NodeId {
    pub fn new(bytes: [u8; 20]) -> Self {
        NodeId { bytes }
    }

    /// XOR 거리 계산 (Kademlia 핵심)
    pub fn xor_distance(&self, other: &NodeId) -> NodeId {
        let mut result = [0u8; 20];
        for i in 0..20 {
            result[i] = self.bytes[i] ^ other.bytes[i];
        }
        NodeId::new(result)
    }

    /// K-bucket 인덱스 계산 (0-159)
    /// MSB부터 처음 1비트가 나오는 위치 = bucket index
    pub fn bucket_index(&self, other: &NodeId) -> u8 {
        let dist = self.xor_distance(other);

        // 비트 길이 찾기 (MSB부터)
        for byte_idx in 0..20 {
            let byte_val = dist.bytes[byte_idx];
            if byte_val != 0 {
                // 이 바이트의 MSB 위치 찾기
                for bit_idx in (0..8).rev() {
                    if (byte_val & (1 << bit_idx)) != 0 {
                        return (byte_idx * 8 + (7 - bit_idx)) as u8;
                    }
                }
            }
        }

        // 모두 0인 경우 = 자기 자신 (159)
        159
    }

    /// 제네시스 NodeId (모두 0)
    pub fn genesis() -> Self {
        NodeId::new([0; 20])
    }
}

// ============================================================================
// 2. DhtContact - 네트워크 노드 정보
// ============================================================================

#[derive(Clone, Copy)]
pub struct DhtContact {
    pub node_id: NodeId,
    pub ip: u32,              // IPv4 (4바이트)
    pub port: u16,
    pub last_seen_ns: u64,    // 마지막 접촉 시간 (나노초)
}

impl DhtContact {
    pub fn new(node_id: NodeId, ip: u32, port: u16) -> Self {
        DhtContact {
            node_id,
            ip,
            port,
            last_seen_ns: get_current_time_ns(),
        }
    }

    pub fn is_active(&self, current_time_ns: u64) -> bool {
        // 1시간 이상 응답 없으면 비활성
        let timeout_ns = 3600u64 * 1_000_000_000u64;
        current_time_ns - self.last_seen_ns < timeout_ns
    }
}

// ============================================================================
// 3. KBucket - K-bucket (K=20)
// ============================================================================

pub struct KBucket {
    pub nodes: [Option<DhtContact>; 20],  // K=20
    pub count: u8,
    pub last_updated_ns: u64,
}

impl KBucket {
    pub fn new() -> Self {
        KBucket {
            nodes: [None; 20],
            count: 0,
            last_updated_ns: get_current_time_ns(),
        }
    }

    pub fn insert(&mut self, contact: DhtContact) -> bool {
        // 중복 확인
        for i in 0..self.count as usize {
            if let Some(existing) = &self.nodes[i] {
                let existing_bytes = &existing.node_id.bytes;
                let new_bytes = &contact.node_id.bytes;

                let mut is_same = true;
                for j in 0..20 {
                    if existing_bytes[j] != new_bytes[j] {
                        is_same = false;
                        break;
                    }
                }

                if is_same {
                    // 기존 노드 갱신
                    self.nodes[i] = Some(contact);
                    return false;  // 새 노드 아님
                }
            }
        }

        // 버킷에 공간 있으면 추가
        if self.count < 20 {
            self.nodes[self.count as usize] = Some(contact);
            self.count += 1;
            self.last_updated_ns = get_current_time_ns();
            return true;  // 새 노드 추가
        }

        // 버킷 가득 참 - LRU 정책 (가장 오래된 노드 제거)
        let mut oldest_idx = 0;
        let mut oldest_time = self.nodes[0].unwrap().last_seen_ns;

        for i in 1..20 {
            if let Some(node) = &self.nodes[i] {
                if node.last_seen_ns < oldest_time {
                    oldest_time = node.last_seen_ns;
                    oldest_idx = i;
                }
            }
        }

        self.nodes[oldest_idx] = Some(contact);
        self.last_updated_ns = get_current_time_ns();
        false  // 기존 노드 교체
    }

    pub fn remove(&mut self, node_id: &NodeId) -> bool {
        for i in 0..self.count as usize {
            if let Some(existing) = &self.nodes[i] {
                let existing_bytes = &existing.node_id.bytes;
                let target_bytes = &node_id.bytes;

                let mut is_same = true;
                for j in 0..20 {
                    if existing_bytes[j] != target_bytes[j] {
                        is_same = false;
                        break;
                    }
                }

                if is_same {
                    // 노드 제거 및 배열 재정렬
                    for j in i..(self.count as usize - 1) {
                        self.nodes[j] = self.nodes[j + 1];
                    }
                    self.nodes[(self.count - 1) as usize] = None;
                    self.count -= 1;
                    return true;
                }
            }
        }
        false
    }

    pub fn get_closest_node(&self, target: &NodeId) -> Option<DhtContact> {
        let mut closest: Option<DhtContact> = None;
        let mut min_distance = [255u8; 20];

        for i in 0..self.count as usize {
            if let Some(contact) = &self.nodes[i] {
                let dist = contact.node_id.xor_distance(target);

                // 거리 비교
                let mut is_closer = false;
                for j in 0..20 {
                    if dist.bytes[j] < min_distance[j] {
                        is_closer = true;
                        break;
                    } else if dist.bytes[j] > min_distance[j] {
                        break;
                    }
                }

                if is_closer {
                    closest = Some(*contact);
                    for j in 0..20 {
                        min_distance[j] = dist.bytes[j];
                    }
                }
            }
        }

        closest
    }
}

// ============================================================================
// 4. DhtTable - 160개 K-bucket 라우팅 테이블
// ============================================================================

pub struct DhtTable {
    pub buckets: [KBucket; 160],
    pub self_id: NodeId,
    pub total_contacts: u32,
}

impl DhtTable {
    pub fn new(self_id: NodeId) -> Self {
        let mut buckets: [KBucket; 160] = unsafe {
            std::mem::MaybeUninit::uninit().assume_init()
        };

        for i in 0..160 {
            buckets[i] = KBucket::new();
        }

        DhtTable {
            buckets,
            self_id,
            total_contacts: 0,
        }
    }

    pub fn insert_contact(&mut self, contact: DhtContact) {
        let bucket_idx = self.self_id.bucket_index(&contact.node_id) as usize;
        if bucket_idx < 160 {
            let is_new = self.buckets[bucket_idx].insert(contact);
            if is_new {
                self.total_contacts += 1;
            }
        }
    }

    pub fn remove_contact(&mut self, node_id: &NodeId) {
        let bucket_idx = self.self_id.bucket_index(node_id) as usize;
        if bucket_idx < 160 {
            if self.buckets[bucket_idx].remove(node_id) {
                self.total_contacts = self.total_contacts.saturating_sub(1);
            }
        }
    }

    pub fn get_k_closest(&self, target: &NodeId, k: usize) -> Vec<DhtContact> {
        let mut closest: Vec<DhtContact> = Vec::new();

        // 먼저 같은 버킷에서 탐색
        let bucket_idx = self.self_id.bucket_index(target) as usize;

        for i in 0..self.buckets[bucket_idx].count as usize {
            if let Some(contact) = &self.buckets[bucket_idx].nodes[i] {
                closest.push(*contact);
            }
        }

        // 필요하면 인접한 버킷도 탐색
        if closest.len() < k {
            for offset in 1..160 {
                let higher = bucket_idx + offset;
                let lower = bucket_idx.saturating_sub(offset);

                if higher < 160 {
                    for i in 0..self.buckets[higher].count as usize {
                        if let Some(contact) = &self.buckets[higher].nodes[i] {
                            closest.push(*contact);
                        }
                    }
                }

                if lower < bucket_idx && closest.len() < k {
                    for i in 0..self.buckets[lower].count as usize {
                        if let Some(contact) = &self.buckets[lower].nodes[i] {
                            closest.push(*contact);
                        }
                    }
                }

                if closest.len() >= k {
                    break;
                }
            }
        }

        // K개까지만 반환
        if closest.len() > k {
            closest.truncate(k);
        }

        closest
    }
}

// ============================================================================
// 5. 유틸리티
// ============================================================================

static mut GLOBAL_TIME: u64 = 1000000000;

fn get_current_time_ns() -> u64 {
    unsafe {
        GLOBAL_TIME = GLOBAL_TIME.wrapping_add(1);
        GLOBAL_TIME
    }
}

pub fn set_test_time(time: u64) {
    unsafe {
        GLOBAL_TIME = time;
    }
}

