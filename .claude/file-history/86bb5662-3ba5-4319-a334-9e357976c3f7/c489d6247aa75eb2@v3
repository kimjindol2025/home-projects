/* ============================================================================
   Path Optimizer - L0NeuralNet 경로 최적화 (Layer 4)

   목적: < 5ms 경로 결정 (규칙 4)
   특징:
   - 16입력 → 8출력 L0NeuralNet (ReLU + Softmax)
   - 8가지 경로 선택 (로컬/원격/DHT/캐시 우선 등)
   - NgramAnalyzer 이상 쿼리 탐지
   - 슬라이딩 윈도우 패턴 학습

   크기: ~400줄
============================================================================ */

#[derive(Clone, Copy)]
pub struct DnsQuery {
    pub domain: [u8; 253],
    pub query_type: u8,       // 0=A, 1=AAAA, 2=MX, ...
    pub client_ip: u32,
    pub is_recursive: bool,
}

#[derive(Clone, Copy, PartialEq)]
pub enum ResolverPathType {
    LocalCache = 0,           // 로컬 캐시 우선
    DhtFast = 1,             // DHT 빠른 경로 (K=3)
    DhtBalanced = 2,         // DHT 균형 경로 (K=10)
    DhtThorough = 3,         // DHT 철저한 경로 (K=20)
    CacheThenDht = 4,        // 캐시 → DHT 폴백
    ParallelPath = 5,        // 병렬 쿼리
    ProactiveRefresh = 6,    // 사전 갱신
    FallbackSecondary = 7,   // 보조 경로 폴백
}

#[derive(Clone, Copy)]
pub struct ResolverPath {
    pub path_type: ResolverPathType,
    pub path_score: [f32; 8],
    pub selected_path: u8,
    pub confidence: f32,
    pub estimated_latency_ms: u16,
}

pub struct DnsPathOptimizer {
    pub nn_weights: [[f32; 8]; 16],    // 16→8 뉴럴넷 가중치
    pub nn_bias: [f32; 8],
    pub total_decisions: u64,
    pub fast_decisions: u64,            // < 5ms 카운터
    pub slow_decisions: u64,            // >= 5ms 카운터
    pub pattern_window: [u8; 32],       // 최근 32개 쿼리 (NgramAnalyzer)
    pub window_idx: u8,
    pub anomaly_count: u64,
}

impl DnsPathOptimizer {
    pub fn new() -> Self {
        let mut optimizer = DnsPathOptimizer {
            nn_weights: [[0.1f32; 8]; 16],
            nn_bias: [0.0f32; 8],
            total_decisions: 0,
            fast_decisions: 0,
            slow_decisions: 0,
            pattern_window: [0; 32],
            window_idx: 0,
            anomaly_count: 0,
        };

        // 가중치 초기화 (8개 경로 분류)
        for i in 0..16 {
            for j in 0..8 {
                let weight = ((i * 7 + j * 13) as f32 + 1.0) / 256.0;
                optimizer.nn_weights[i][j] = weight.max(0.01).min(0.99);
            }
        }

        // 편향 초기화
        for j in 0..8 {
            optimizer.nn_bias[j] = ((j as f32) - 4.0) * 0.1;
        }

        optimizer
    }

    /// L0NeuralNet 경로 결정 < 5ms (규칙 4)
    pub fn optimize_path(&mut self, query: &DnsQuery) -> ResolverPath {
        let start = get_optimizer_time();

        // Step 1: 16개 피처 추출
        let features = self.extract_features(query);

        // Step 2: Forward pass (16→8)
        let mut hidden: [f32; 8] = [0.0f32; 8];
        for j in 0..8 {
            let mut sum = self.nn_bias[j];
            for i in 0..16 {
                sum += features[i] * self.nn_weights[i][j];
            }
            // ReLU activation
            hidden[j] = if sum > 0.0 { sum } else { 0.0 };
        }

        // Step 3: Softmax (확률 분포)
        let mut path_score = [0.0f32; 8];
        let mut sum_exp = 0.0f32;

        for j in 0..8 {
            let exp_val = (hidden[j] * 2.0).exp().min(100.0);  // 오버플로우 방지
            path_score[j] = exp_val;
            sum_exp += exp_val;
        }

        // 정규화
        if sum_exp > 0.0 {
            for j in 0..8 {
                path_score[j] /= sum_exp;
            }
        } else {
            // 평균 분포로 폴백
            for j in 0..8 {
                path_score[j] = 0.125;
            }
        }

        // Step 4: 최선 경로 선택
        let mut selected_path = 0u8;
        let mut max_score = path_score[0];

        for j in 1..8 {
            if path_score[j] > max_score {
                max_score = path_score[j];
                selected_path = j as u8;
            }
        }

        // Step 5: 경로 타입 매핑
        let path_type = match selected_path {
            0 => ResolverPathType::LocalCache,
            1 => ResolverPathType::DhtFast,
            2 => ResolverPathType::DhtBalanced,
            3 => ResolverPathType::DhtThorough,
            4 => ResolverPathType::CacheThenDht,
            5 => ResolverPathType::ParallelPath,
            6 => ResolverPathType::ProactiveRefresh,
            _ => ResolverPathType::FallbackSecondary,
        };

        // Step 6: 레이턴시 추정
        let estimated_latency = match path_type {
            ResolverPathType::LocalCache => 1,           // < 1ms
            ResolverPathType::DhtFast => 3,              // ~3ms
            ResolverPathType::DhtBalanced => 5,          // ~5ms
            ResolverPathType::DhtThorough => 8,          // ~8ms
            ResolverPathType::CacheThenDht => 4,         // ~4ms
            ResolverPathType::ParallelPath => 3,         // ~3ms (병렬)
            ResolverPathType::ProactiveRefresh => 2,     // ~2ms
            ResolverPathType::FallbackSecondary => 6,    // ~6ms
        };

        let elapsed = get_optimizer_time() - start;

        self.total_decisions += 1;
        if elapsed < 5_000_000 {  // < 5ms (규칙 4)
            self.fast_decisions += 1;
        } else {
            self.slow_decisions += 1;
        }

        // 패턴 윈도우 업데이트
        self.pattern_window[self.window_idx as usize] = selected_path;
        self.window_idx = (self.window_idx + 1) % 32;

        ResolverPath {
            path_type,
            path_score,
            selected_path,
            confidence: max_score,
            estimated_latency_ms: estimated_latency,
        }
    }

    /// 16개 피처 추출 (도메인 + 쿼리 통계)
    fn extract_features(&self, query: &DnsQuery) -> [f32; 16] {
        let mut features = [0.0f32; 16];

        // Feature 0-7: 도메인 통계
        let mut domain_len = 0;
        let mut vowel_count = 0;
        let mut digit_count = 0;

        for (idx, byte) in query.domain.iter().enumerate() {
            if *byte == 0 || idx >= 253 {
                break;
            }

            domain_len += 1;

            // 모음 카운트
            match *byte {
                b'a' | b'e' | b'i' | b'o' | b'u' |
                b'A' | b'E' | b'I' | b'O' | b'U' => vowel_count += 1,
                b'0'..=b'9' => digit_count += 1,
                _ => {}
            }
        }

        features[0] = (domain_len as f32) / 253.0;          // 길이 정규화
        features[1] = (vowel_count as f32) / (domain_len as f32 + 1.0);  // 모음 비율
        features[2] = (digit_count as f32) / (domain_len as f32 + 1.0);  // 숫자 비율
        features[3] = if query.is_recursive { 1.0 } else { 0.0 };  // 재귀 쿼리 여부

        // Feature 4-7: 추가 통계
        features[4] = ((query.query_type as f32) / 7.0).min(1.0);  // 쿼리 타입 (0-7)
        features[5] = ((query.client_ip >> 24) as f32) / 255.0;   // IP 첫 octet
        features[6] = ((query.client_ip >> 16) as f32) / 255.0;   // IP 두 번째 octet
        features[7] = (domain_len as f32 % 10.0) / 10.0;          // 길이 mod 10

        // Feature 8-15: 패턴 윈도우 (NgramAnalyzer)
        for i in 0..8 {
            let idx = ((self.window_idx as usize + i) % 32) as usize;
            features[8 + i] = (self.pattern_window[idx] as f32) / 8.0;
        }

        features
    }

    /// N-gram 패턴 분석 (이상 쿼리 탐지)
    pub fn analyze_query_pattern(&mut self, domain: &[u8]) -> QueryAnomaly {
        // 2-gram 분석
        let mut bigram_counts = [0u32; 256];
        let mut total_bigrams = 0u32;

        for i in 0..domain.len().saturating_sub(1) {
            if domain[i] == 0 {
                break;
            }

            let bigram_val = (domain[i] as usize ^ (domain[i + 1] as usize << 4)) % 256;
            bigram_counts[bigram_val] += 1;
            total_bigrams += 1;
        }

        // 이상도 계산 (엔트로피 기반)
        let mut entropy = 0.0f32;
        for count in &bigram_counts {
            if *count > 0 {
                let prob = (*count as f32) / (total_bigrams as f32 + 1.0);
                entropy -= prob * prob.log2();
            }
        }

        // 엔트로피 > 4.0이면 이상 (정상은 ~3.0)
        let is_anomaly = entropy > 4.0;
        let anomaly_score = (entropy - 3.0).max(0.0) / 5.0;

        if is_anomaly {
            self.anomaly_count += 1;
        }

        QueryAnomaly {
            is_anomaly,
            anomaly_score: anomaly_score.min(1.0),
        }
    }

    /// 통계
    pub fn stats(&self) -> (u64, u64, u64, u64) {
        (self.total_decisions, self.fast_decisions, self.slow_decisions, self.anomaly_count)
    }
}

#[derive(Clone, Copy)]
pub struct QueryAnomaly {
    pub is_anomaly: bool,
    pub anomaly_score: f32,
}

// ============================================================================
// 시간 함수
// ============================================================================

static mut OPTIMIZER_TIME: u64 = 1000000000;

pub fn get_optimizer_time() -> u64 {
    unsafe {
        OPTIMIZER_TIME = OPTIMIZER_TIME.wrapping_add(1);
        OPTIMIZER_TIME
    }
}

pub fn set_optimizer_time(time: u64) {
    unsafe {
        OPTIMIZER_TIME = time;
    }
}
