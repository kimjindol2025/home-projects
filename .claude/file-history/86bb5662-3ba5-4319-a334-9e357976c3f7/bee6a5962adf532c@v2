/* ============================================================================
   DAG Node - Atomic-Ledger Layer 1

   목적: 트랜잭션을 DAG 노드로 표현 (이중 부모 참조)
   특징:
   - parent_hash_1/2: 이중 부모 참조 (DAG의 핵심)
   - self_hash: SHA-3-256(parent1 || parent2 || tx_data)
   - amount_commitment: Pedersen 금액 은닉
   - 규칙 1: DAG 노드 생성 < 1ms

   재사용:
   - sha3_256() from freelang-signal/crypto/sha3_hash.fl
   - PedersenCommitment from freelang-signal/zkp/commitment.fl

   크기: ~400줄
============================================================================ */

// ============================================================================
// 1. DAG 노드 구조체
// ============================================================================

pub struct DagNode {
    pub node_id: u64,
    pub parent_hash_1: [u8; 32],    // 첫 번째 부모 (genesis: [0;32])
    pub parent_hash_2: [u8; 32],    // 두 번째 부모 (DAG 이중 참조)
    pub tx_data: [u8; 256],         // 트랜잭션 데이터
    pub tx_amount: u64,             // 거래 금액
    pub nonce: u64,                 // 계정 nonce (이중지출 방지)
    pub timestamp: u64,             // 타임스탬프 (ns)
    pub self_hash: [u8; 32],        // H(parent1 || parent2 || tx_data || nonce || ts)
    pub amount_commitment: [u8; 32], // Pedersen commitment (금액 은닉)
    pub is_genesis: bool,           // 제네시스 노드 여부
}

impl DagNode {
    /// DAG 노드 생성 (< 1ms)
    pub fn new(
        node_id: u64,
        parent_hash_1: [u8; 32],
        parent_hash_2: [u8; 32],
        tx_data: [u8; 256],
        tx_amount: u64,
        nonce: u64,
        timestamp: u64,
    ) -> Self {
        let mut node = DagNode {
            node_id,
            parent_hash_1,
            parent_hash_2,
            tx_data,
            tx_amount,
            nonce,
            timestamp,
            self_hash: [0u8; 32],
            amount_commitment: [0u8; 32],
            is_genesis: false,
        };

        // self_hash 계산: SHA-3-256(parent1 || parent2 || tx_data || nonce || timestamp)
        node.self_hash = compute_dag_node_hash(&node);

        // amount_commitment: 간단한 Pedersen 시뮬레이션
        node.amount_commitment = compute_amount_commitment(tx_amount);

        node
    }

    /// 제네시스 노드 생성
    pub fn genesis(node_id: u64, timestamp: u64) -> Self {
        let mut node = DagNode {
            node_id,
            parent_hash_1: [0u8; 32],
            parent_hash_2: [0u8; 32],
            tx_data: [0u8; 256],
            tx_amount: 0,
            nonce: 0,
            timestamp,
            self_hash: [0u8; 32],
            amount_commitment: [0u8; 32],
            is_genesis: true,
        };

        node.self_hash = compute_dag_node_hash(&node);
        node
    }

    /// 부모 검증
    pub fn has_valid_parents(&self) -> bool {
        // 둘 다 [0;32]이면 제네시스
        if self.parent_hash_1 == [0u8; 32] && self.parent_hash_2 == [0u8; 32] {
            return self.is_genesis;
        }

        // 최소 하나의 부모는 0이 아니어야 함
        self.parent_hash_1 != [0u8; 32] || self.parent_hash_2 != [0u8; 32]
    }

    /// 노드 무결성 검증
    pub fn verify_integrity(&self) -> bool {
        let computed_hash = compute_dag_node_hash(self);
        computed_hash == self.self_hash
    }

    /// 클론
    pub fn clone(&self) -> Self {
        DagNode {
            node_id: self.node_id,
            parent_hash_1: self.parent_hash_1,
            parent_hash_2: self.parent_hash_2,
            tx_data: self.tx_data,
            tx_amount: self.tx_amount,
            nonce: self.nonce,
            timestamp: self.timestamp,
            self_hash: self.self_hash,
            amount_commitment: self.amount_commitment,
            is_genesis: self.is_genesis,
        }
    }
}

// ============================================================================
// 2. 해시 계산 (SHA-3-256 시뮬레이션)
// ============================================================================

fn compute_dag_node_hash(node: &DagNode) -> [u8; 32] {
    // parent1 || parent2 || tx_data || nonce || timestamp 연결
    let mut input = [0u8; 512];

    // 복사 (간단한 시뮬레이션)
    let mut idx = 0;

    // parent_hash_1 (32바이트)
    for i in 0..32 {
        input[idx] = node.parent_hash_1[i];
        idx += 1;
    }

    // parent_hash_2 (32바이트)
    for i in 0..32 {
        input[idx] = node.parent_hash_2[i];
        idx += 1;
    }

    // tx_data (256바이트)
    for i in 0..256 {
        input[idx] = node.tx_data[i];
        idx += 1;
    }

    // nonce (8바이트)
    let nonce_bytes = node.nonce.to_le_bytes();
    for i in 0..8 {
        input[idx] = nonce_bytes[i];
        idx += 1;
    }

    // timestamp (8바이트)
    let ts_bytes = node.timestamp.to_le_bytes();
    for i in 0..8 {
        input[idx] = ts_bytes[i];
        idx += 1;
    }

    // SHA-3-256 시뮬레이션 (간단한 해시 함수)
    simple_sha3_256(&input[0..idx])
}

fn compute_amount_commitment(amount: u64) -> [u8; 32] {
    // Pedersen commitment 시뮬레이션
    // C = H(amount || random_point)
    let amount_bytes = amount.to_le_bytes();

    let mut input = [0u8; 40];
    for i in 0..8 {
        input[i] = amount_bytes[i];
    }

    // random_point 시뮬레이션 (32바이트)
    for i in 0..32 {
        input[8 + i] = ((amount as usize).wrapping_mul(i + 1) % 256) as u8;
    }

    simple_sha3_256(&input)
}

fn simple_sha3_256(data: &[u8]) -> [u8; 32] {
    // SHA-3-256 시뮬레이션 (MurmurHash 기반)
    let mut hash = [0u8; 32];
    let mut state = 0u64;

    for &byte in data {
        state = state.wrapping_mul(6364136223846793005)
            .wrapping_add(1442695040888963407);
        state ^= byte as u64;
    }

    // state를 32바이트로 확장
    for i in 0..32 {
        hash[i] = ((state.wrapping_add((i as u64) * 31)) >> (i % 8)) as u8;
    }

    hash
}

// ============================================================================
// 3. DAG 엣지 (부모-자식 관계)
// ============================================================================

pub struct DagEdge {
    pub from: u64,     // 부모 node_id
    pub to: u64,       // 자식 node_id
    pub edge_type: EdgeType,
}

pub enum EdgeType {
    Primary = 1,       // parent_hash_1
    Secondary = 2,     // parent_hash_2
}

impl DagEdge {
    pub fn new(from: u64, to: u64, is_primary: bool) -> Self {
        DagEdge {
            from,
            to,
            edge_type: if is_primary {
                EdgeType::Primary
            } else {
                EdgeType::Secondary
            },
        }
    }

    pub fn clone(&self) -> Self {
        DagEdge {
            from: self.from,
            to: self.to,
            edge_type: match self.edge_type {
                EdgeType::Primary => EdgeType::Primary,
                EdgeType::Secondary => EdgeType::Secondary,
            },
        }
    }
}

