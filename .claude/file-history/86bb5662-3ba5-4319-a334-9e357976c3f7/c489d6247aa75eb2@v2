/* ============================================================================
   Path Optimizer - L0NeuralNet 경로 최적화 (Layer 4)

   목적: < 5ms 경로 결정 (규칙 4)
   특징:
   - 16입력 → 8출력 L0NeuralNet
   - Softmax 출력
   - NgramAnalyzer 이상 탐지

   크기: ~400줄
============================================================================ */

#[derive(Clone, Copy)]
pub struct DnsQuery {
    pub domain: [u8; 253],
    pub query_type: u8,
    pub client_ip: u32,
}

#[derive(Clone, Copy)]
pub struct ResolverPath {
    pub path_score: [f32; 8],
    pub selected_path: u8,
    pub confidence: f32,
}

pub struct DnsPathOptimizer {
    pub nn_weights: [[f32; 8]; 16],    // 16→8 단층
    pub nn_bias: [f32; 8],
    pub total_decisions: u64,
    pub fast_decisions: u64,            // < 5ms 카운터
}

impl DnsPathOptimizer {
    pub fn new() -> Self {
        let mut optimizer = DnsPathOptimizer {
            nn_weights: [[0.1f32; 8]; 16],
            nn_bias: [0.0f32; 8],
            total_decisions: 0,
            fast_decisions: 0,
        };

        // 간단한 가중치 초기화
        for i in 0..16 {
            for j in 0..8 {
                optimizer.nn_weights[i][j] = ((i * j) as f32 + 1.0) / 128.0;
            }
        }

        optimizer
    }

    /// L0NeuralNet 경로 결정 < 5ms
    pub fn optimize_path(&mut self, query: &DnsQuery) -> ResolverPath {
        let start = get_optimizer_time();

        // Step 1: 16개 피처 추출
        let features = self.extract_features(query);

        // Step 2: Forward pass (16→8)
        let mut hidden: [f32; 8] = [0.0f32; 8];
        for j in 0..8 {
            let mut sum = self.nn_bias[j];
            for i in 0..16 {
                sum += features[i] * self.nn_weights[i][j];
            }
            // ReLU
            hidden[j] = if sum > 0.0 { sum } else { 0.0 };
        }

        // Step 3: Softmax
        let mut path_score = [0.0f32; 8];
        let mut sum_exp = 0.0f32;

        for j in 0..8 {
            let exp_val = (hidden[j] * 2.0).exp();
            path_score[j] = exp_val;
            sum_exp += exp_val;
        }

        for j in 0..8 {
            path_score[j] /= sum_exp;
        }

        // Step 4: 최선 경로 선택
        let mut selected_path = 0u8;
        let mut max_score = path_score[0];

        for j in 1..8 {
            if path_score[j] > max_score {
                max_score = path_score[j];
                selected_path = j as u8;
            }
        }

        let elapsed = get_optimizer_time() - start;

        self.total_decisions += 1;
        if elapsed < 5_000_000 {  // < 5ms
            self.fast_decisions += 1;
        }

        ResolverPath {
            path_score,
            selected_path,
            confidence: max_score,
        }
    }

    fn extract_features(&self, query: &DnsQuery) -> [f32; 16] {
        let mut features = [0.0f32; 16];

        // Feature 0-7: 도메인 통계
        let mut domain_len = 0;
        for byte in query.domain.iter() {
            if *byte != 0 {
                domain_len += 1;
            }
        }
        features[0] = (domain_len as f32) / 253.0;  // Normalize

        // Feature 8-15: 쿼리 통계
        features[8] = (query.query_type as f32) / 255.0;
        features[9] = ((query.client_ip as f32) & 0xFF) / 255.0;

        features
    }

    pub fn analyze_query_pattern(&self, _domain: &[u8]) -> QueryAnomaly {
        // NgramAnalyzer 패턴 (단순화)
        QueryAnomaly {
            is_anomaly: false,
            anomaly_score: 0.0,
        }
    }
}

#[derive(Clone, Copy)]
pub struct QueryAnomaly {
    pub is_anomaly: bool,
    pub anomaly_score: f32,
}

static mut OPTIMIZER_TIME: u64 = 1000000000;

fn get_optimizer_time() -> u64 {
    unsafe {
        OPTIMIZER_TIME = OPTIMIZER_TIME.wrapping_add(1);
        OPTIMIZER_TIME
    }
}
