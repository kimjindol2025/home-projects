/* ============================================================================
   DAG Store - Atomic-Ledger Layer 1

   목적: DAG 노드 저장소 + 위상 정렬 + 팁 관리
   특징:
   - NanoPagePool 패턴 재사용 (4096 노드 풀)
   - O(1) 할당/해제 (비트맵 기반)
   - 링 버퍼로 오래된 노드 자동 교체
   - 위상 정렬 (DAG 순환 없음 검증)
   - 팁(tip) 관리: 아직 자식 없는 노드

   재사용:
   - NanoPagePool pattern from freelang-nano-kernel/src/boot/nano_memory.fl

   크기: ~400줄
============================================================================ */

pub struct DagNodePool {
    // 노드 저장소 (4096 × 512바이트 = 2MB)
    pub nodes: [Option<DagNode>; 4096],

    // 할당 비트맵 (4096비트 = 512바이트)
    pub alloc_bitmap: [u32; 128],

    // 통계
    pub total_nodes: u32,
    pub active_nodes: u32,
    pub peak_dag_size: u32,
    pub next_free_idx: u32,
}

impl DagNodePool {
    /// 새 DAG 노드 풀 생성
    pub fn new() -> Self {
        let mut pool = DagNodePool {
            nodes: [None; 4096],
            alloc_bitmap: [0u32; 128],
            total_nodes: 0,
            active_nodes: 0,
            peak_dag_size: 0,
            next_free_idx: 0,
        };

        // 제네시스 노드 추가
        if let Some(idx) = pool.alloc_index() {
            let genesis = DagNode::genesis(0, get_current_time_ns());
            pool.nodes[idx as usize] = Some(genesis.clone());
            pool.total_nodes = 1;
            pool.active_nodes = 1;
            pool.peak_dag_size = 1;
        }

        pool
    }

    /// O(1) 인덱스 할당 (비트맵 기반)
    pub fn alloc_index(&mut self) -> Option<u32> {
        for i in 0..128 {
            if self.alloc_bitmap[i] != 0xFFFFFFFFu32 {
                // 0인 비트 찾기
                for j in 0..32 {
                    if (self.alloc_bitmap[i] & (1u32 << j)) == 0 {
                        // 비트 설정
                        self.alloc_bitmap[i] |= 1u32 << j;
                        let idx = (i * 32 + j) as u32;
                        self.active_nodes += 1;
                        return Some(idx);
                    }
                }
            }
        }

        // 풀 가득 찼음 (링 버퍼: 가장 오래된 노드 덮어쓰기)
        let idx = self.next_free_idx;
        self.next_free_idx = (self.next_free_idx + 1) % 4096;
        Some(idx)
    }

    /// O(1) 인덱스 해제
    pub fn free_index(&mut self, idx: u32) -> bool {
        if idx >= 4096 {
            return false;
        }

        let bitmap_idx = (idx / 32) as usize;
        let bit_idx = (idx % 32) as u32;

        if (self.alloc_bitmap[bitmap_idx] & (1u32 << bit_idx)) != 0 {
            self.alloc_bitmap[bitmap_idx] &= !(1u32 << bit_idx);
            self.nodes[idx as usize] = None;
            if self.active_nodes > 0 {
                self.active_nodes -= 1;
            }
            return true;
        }

        false
    }

    /// DAG 노드 추가
    pub fn add_node(&mut self, node: DagNode) -> Option<u32> {
        let idx = self.alloc_index()?;
        self.nodes[idx as usize] = Some(node);
        self.peak_dag_size = max(self.peak_dag_size, self.active_nodes);
        Some(idx)
    }

    /// 인덱스로 노드 조회
    pub fn get_node(&self, idx: u32) -> Option<DagNode> {
        if idx >= 4096 {
            return None;
        }

        self.nodes[idx as usize].as_ref().map(|n| n.clone())
    }

    /// hash로 노드 찾기
    pub fn find_by_hash(&self, hash: &[u8; 32]) -> Option<(u32, DagNode)> {
        for i in 0..4096 {
            if let Some(node) = &self.nodes[i] {
                if &node.self_hash == hash {
                    return Some((i as u32, node.clone()));
                }
            }
        }
        None
    }

    /// 활성 노드 개수
    pub fn count_active(&self) -> u32 {
        self.active_nodes
    }

    /// 풀 사용률 (%)
    pub fn utilization(&self) -> f32 {
        (self.active_nodes as f32 / 4096.0) * 100.0
    }

    /// 풀 상태 출력
    pub fn print_stats(&self) {
        // 통계 출력 (시뮬레이션)
    }
}

impl Clone for DagNodePool {
    fn clone(&self) -> Self {
        let mut new_nodes = [None; 4096];
        for i in 0..4096 {
            if let Some(node) = &self.nodes[i] {
                new_nodes[i] = Some(node.clone());
            }
        }

        DagNodePool {
            nodes: new_nodes,
            alloc_bitmap: self.alloc_bitmap,
            total_nodes: self.total_nodes,
            active_nodes: self.active_nodes,
            peak_dag_size: self.peak_dag_size,
            next_free_idx: self.next_free_idx,
        }
    }
}

// ============================================================================
// 2. DAG Tips (현재 팁 = 아직 자식 없는 노드)
// ============================================================================

pub struct DagTips {
    pub tips: [Option<[u8; 32]>; 256],  // 최대 256개 팁
    pub tip_count: u32,
}

impl DagTips {
    pub fn new() -> Self {
        DagTips {
            tips: [None; 256],
            tip_count: 0,
        }
    }

    /// 팁 추가
    pub fn add_tip(&mut self, hash: [u8; 32]) -> bool {
        if self.tip_count >= 256 {
            return false;  // 팁 풀 가득 찼음
        }

        // 중복 확인
        for i in 0..self.tip_count {
            if let Some(tip) = self.tips[i as usize] {
                if tip == hash {
                    return false;  // 이미 존재
                }
            }
        }

        self.tips[self.tip_count as usize] = Some(hash);
        self.tip_count += 1;
        true
    }

    /// 팁 제거 (부모로 참조되는 노드는 팁이 아님)
    pub fn remove_tip(&mut self, hash: &[u8; 32]) -> bool {
        for i in 0..self.tip_count {
            if let Some(tip) = self.tips[i as usize] {
                if &tip == hash {
                    // i번째 항목을 마지막 항목으로 덮어쓰기
                    if i < self.tip_count - 1 {
                        self.tips[i as usize] = self.tips[(self.tip_count - 1) as usize];
                    }
                    self.tips[(self.tip_count - 1) as usize] = None;
                    self.tip_count -= 1;
                    return true;
                }
            }
        }
        false
    }

    /// 팁 개수
    pub fn count(&self) -> u32 {
        self.tip_count
    }

    /// 팁 목록 조회
    pub fn get_tips(&self) -> Vec<[u8; 32]> {
        let mut tips_vec = Vec::new();
        for i in 0..self.tip_count {
            if let Some(tip) = self.tips[i as usize] {
                tips_vec.push(tip);
            }
        }
        tips_vec
    }

    pub fn clone(&self) -> Self {
        DagTips {
            tips: self.tips,
            tip_count: self.tip_count,
        }
    }
}

// ============================================================================
// 3. DAG 위상 정렬 검증
// ============================================================================

pub struct DagValidator {
    pub visited: [bool; 4096],
    pub recursion_stack: [bool; 4096],
    pub violation_count: u32,
}

impl DagValidator {
    pub fn new() -> Self {
        DagValidator {
            visited: [false; 4096],
            recursion_stack: [false; 4096],
            violation_count: 0,
        }
    }

    /// DAG 검증: 순환 없음 확인 (DFS)
    pub fn is_dag_valid(pool: &DagNodePool) -> bool {
        let mut validator = DagValidator::new();

        // 모든 활성 노드에 대해 순환 검사
        for i in 0..4096 {
            if let Some(node) = &pool.nodes[i] {
                if !validator.visited[i] {
                    if validator.has_cycle_dfs(pool, i) {
                        return false;
                    }
                }
            }
        }

        true
    }

    /// DFS로 순환 검사
    fn has_cycle_dfs(&mut self, pool: &DagNodePool, idx: usize) -> bool {
        self.visited[idx] = true;
        self.recursion_stack[idx] = true;

        if let Some(node) = &pool.nodes[idx] {
            // parent_hash_1 확인
            if let Some((parent_idx, _)) = pool.find_by_hash(&node.parent_hash_1) {
                let pidx = parent_idx as usize;
                if !self.visited[pidx] {
                    if self.has_cycle_dfs(pool, pidx) {
                        return true;
                    }
                } else if self.recursion_stack[pidx] {
                    // 후진 에지 발견 = 순환
                    self.violation_count += 1;
                    return true;
                }
            }

            // parent_hash_2 확인
            if let Some((parent_idx, _)) = pool.find_by_hash(&node.parent_hash_2) {
                let pidx = parent_idx as usize;
                if !self.visited[pidx] {
                    if self.has_cycle_dfs(pool, pidx) {
                        return true;
                    }
                } else if self.recursion_stack[pidx] {
                    self.violation_count += 1;
                    return true;
                }
            }
        }

        self.recursion_stack[idx] = false;
        false
    }
}

impl Clone for DagValidator {
    fn clone(&self) -> Self {
        DagValidator {
            visited: self.visited,
            recursion_stack: self.recursion_stack,
            violation_count: self.violation_count,
        }
    }
}

// ============================================================================
// 4. DAG 위상 정렬
// ============================================================================

pub fn topological_sort(pool: &DagNodePool) -> Vec<u32> {
    let mut sorted = Vec::new();
    let mut visited = [false; 4096];
    let mut in_degree = [0u32; 4096];

    // in_degree 계산
    for i in 0..4096 {
        if let Some(node) = &pool.nodes[i] {
            // parent_hash_1의 모든 자식이 이 노드
            if let Some((pidx, _)) = pool.find_by_hash(&node.parent_hash_1) {
                in_degree[i] += 1;
            }
            // parent_hash_2의 모든 자식이 이 노드
            if let Some((pidx, _)) = pool.find_by_hash(&node.parent_hash_2) {
                in_degree[i] += 1;
            }
        }
    }

    // Kahn's algorithm (in_degree 0인 노드부터 시작)
    for i in 0..4096 {
        if in_degree[i] == 0 && pool.nodes[i].is_some() {
            dfs_topological(&mut sorted, pool, i, &mut visited);
        }
    }

    sorted
}

fn dfs_topological(sorted: &mut Vec<u32>, pool: &DagNodePool, idx: usize, visited: &mut [bool; 4096]) {
    if visited[idx] {
        return;
    }

    visited[idx] = true;

    if let Some(node) = &pool.nodes[idx] {
        // parent 먼저 방문
        if let Some((pidx, _)) = pool.find_by_hash(&node.parent_hash_1) {
            dfs_topological(sorted, pool, pidx as usize, visited);
        }
        if let Some((pidx, _)) = pool.find_by_hash(&node.parent_hash_2) {
            dfs_topological(sorted, pool, pidx as usize, visited);
        }
    }

    sorted.push(idx as u32);
}

// ============================================================================
// 5. 유틸리티
// ============================================================================

fn max(a: u32, b: u32) -> u32 {
    if a > b {
        a
    } else {
        b
    }
}

fn get_current_time_ns() -> u64 {
    // 시뮬레이션
    static mut TIME: u64 = 1000000000;
    unsafe {
        TIME += 1;
        TIME
    }
}

