/* ============================================================================
   Sovereign Registry - 도메인 등록소 (Layer 2)

   목적: CASCore 재사용 + 도메인 등록/관리
   특징:
   - 4096개 레코드 저장소
   - 도메인 → 소유자 매핑
   - ZKP 검증 필수

   크기: ~400줄
============================================================================ */

use crate::registry::dns_record::{DnsRecord, RecordType};

// CASCore placeholder (실제는 atomic-ledger에서 import)
pub struct CASCore {
    pub chunk_count: u32,
}

impl CASCore {
    pub fn new() -> Self {
        CASCore { chunk_count: 0 }
    }

    pub fn store_chunk(&mut self, _chunk_idx: u32, _data: &[u8; 4096]) -> bool {
        self.chunk_count += 1;
        true
    }
}

pub struct SovereignRegistry {
    pub cas: CASCore,
    pub records: [Option<DnsRecord>; 4096],
    pub record_count: u32,
    pub ownership_map: [Option<[u8; 32]>; 4096],
}

impl SovereignRegistry {
    pub fn new() -> Self {
        SovereignRegistry {
            cas: CASCore::new(),
            records: [None; 4096],
            record_count: 0,
            ownership_map: [None; 4096],
        }
    }

    pub fn register_domain(&mut self, record: DnsRecord) -> bool {
        // 빈 슬롯 찾기
        for i in 0..4096 {
            if self.records[i].is_none() {
                self.records[i] = Some(record);
                self.record_count += 1;

                // CAS에 저장
                let mut cas_data = [0u8; 4096];
                self.cas.store_chunk(i as u32, &cas_data);

                return true;
            }
        }

        false  // 저장소 가득
    }

    pub fn lookup_record(&self, domain: &[u8]) -> Option<DnsRecord> {
        // 도메인 해시 계산 (단순화)
        let mut domain_hash = 0u32;
        for byte in domain.iter() {
            domain_hash = domain_hash.wrapping_mul(31).wrapping_add(*byte as u32);
        }

        let idx = (domain_hash as usize) % 4096;

        self.records[idx]
    }
}
