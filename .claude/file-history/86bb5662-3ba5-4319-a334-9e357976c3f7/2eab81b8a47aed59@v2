    fn new() -> Self {
        let mut optimizer = DnsPathOptimizer {
            nn_weights: [[0.1f32; 8]; 16],
            nn_bias: [0.0f32; 8],
            total_decisions: 0,
            fast_decisions: 0,
            slow_decisions: 0,
            pattern_window: [0; 32],
            window_idx: 0,
            anomaly_count: 0,
        };

        for i in 0..16 {
            for j in 0..8 {
                let weight = ((i * 7 + j * 13) as f32 + 1.0) / 256.0;
                optimizer.nn_weights[i][j] = weight.max(0.01).min(0.99);
            }
        }

        for j in 0..8 {
            optimizer.nn_bias[j] = ((j as f32) - 4.0) * 0.1;
        }

        optimizer
    }

    fn optimize_path(&mut self, query: &DnsQuery) -> ResolverPath {
        let start = get_optimizer_time();

        let mut hidden: [f32; 8] = [0.0f32; 8];
        for j in 0..8 {
            let mut sum = self.nn_bias[j];
            for i in 0..16 {
                sum += 0.1 * self.nn_weights[i][j];
            }
            hidden[j] = if sum > 0.0 { sum } else { 0.0 };
        }

        let mut path_score = [0.0f32; 8];
        let mut sum_exp = 0.0f32;

        for j in 0..8 {
            let exp_val = (hidden[j] * 2.0).exp().min(100.0);
            path_score[j] = exp_val;
            sum_exp += exp_val;
        }

        if sum_exp > 0.0 {
            for j in 0..8 {
                path_score[j] /= sum_exp;
            }
        }

        let mut selected_path = 0u8;
        let mut max_score = path_score[0];

        for j in 1..8 {
            if path_score[j] > max_score {
                max_score = path_score[j];
                selected_path = j as u8;
            }
        }

        let path_type = match selected_path {
            0 => ResolverPathType::LocalCache,
            1 => ResolverPathType::DhtFast,
            2 => ResolverPathType::DhtBalanced,
            3 => ResolverPathType::DhtThorough,
            4 => ResolverPathType::CacheThenDht,
            5 => ResolverPathType::ParallelPath,
            6 => ResolverPathType::ProactiveRefresh,
            _ => ResolverPathType::FallbackSecondary,
        };

        let elapsed = get_optimizer_time() - start;

        self.total_decisions += 1;
        if elapsed < 5_000_000 {
            self.fast_decisions += 1;
        } else {
            self.slow_decisions += 1;
        }

        self.pattern_window[self.window_idx as usize] = selected_path;
        self.window_idx = (self.window_idx + 1) % 32;

        ResolverPath {
            path_type,
            selected_path,
            confidence: max_score,
        }
    }

    fn analyze_query_pattern(&mut self, domain: &[u8]) -> QueryAnomaly {
        let mut bigram_counts = [0u32; 256];
        let mut total_bigrams = 0u32;

        for i in 0..domain.len().saturating_sub(1) {
            if domain[i] == 0 {
                break;
            }

            let bigram_val = (domain[i] as usize ^ (domain[i + 1] as usize << 4)) % 256;
            bigram_counts[bigram_val] += 1;
            total_bigrams += 1;
        }

        let mut entropy = 0.0f32;
        for count in &bigram_counts {
            if *count > 0 {
                let prob = (*count as f32) / (total_bigrams as f32 + 1.0);
                entropy -= prob * prob.log2();
            }
        }

        let is_anomaly = entropy > 4.0;
        let anomaly_score = (entropy - 3.0).max(0.0) / 5.0;

        if is_anomaly {
            self.anomaly_count += 1;
        }

        QueryAnomaly {
            is_anomaly,
            anomaly_score: anomaly_score.min(1.0),
        }
    }

    fn stats(&self) -> (u64, u64, u64, u64) {
        (self.total_decisions, self.fast_decisions, self.slow_decisions, self.anomaly_count)
    }
}

#[derive(Clone, Copy)]
pub struct QueryAnomaly {
    pub is_anomaly: bool,
    pub anomaly_score: f32,
}

pub struct DhtRouter {
    pub store: [Option<DnsRecord>; 256],
}

impl DhtRouter {
    fn new(_self_id: NodeId) -> Self {
        DhtRouter {
            store: [None; 256],
        }
    }

    fn store_record(&mut self, _key: [u8; 20], record: DnsRecord) -> bool {
        for i in 0..256 {
            if self.store[i].is_none() {
                self.store[i] = Some(record);
                return true;
            }
        }
        false
    }

    fn find_value(&self, _key: [u8; 20]) -> Option<DnsRecord> {
        for i in 0..256 {
            if let Some(record) = self.store[i] {
                return Some(record);
            }
        }
        None
    }
}

pub struct SovereignRegistry;

pub struct SovereignResolver {
    pub dht: DhtRouter,
    pub registry: SovereignRegistry,
    pub cache: [Option<(DnsRecord, u64)>; 4096],
    pub cache_count: u32,
    pub cache_hits: u64,
    pub remote_hits: u64,
    pub total_queries: u64,
    pub optimizer: DnsPathOptimizer,
}

impl SovereignResolver {
    fn new(self_id: NodeId) -> Self {
        SovereignResolver {
            dht: DhtRouter::new(self_id),
            registry: SovereignRegistry,
            cache: [None; 4096],
            cache_count: 0,
            cache_hits: 0,
            remote_hits: 0,
            total_queries: 0,
            optimizer: DnsPathOptimizer::new(),
        }
    }

    fn register_domain(&mut self, _record: DnsRecord, _proof: &DnsProof, _owner: [u8; 32]) -> bool {
        true
    }

    fn resolve(&mut self, domain: &[u8]) -> Option<DnsRecord> {
        self.total_queries += 1;

        let cache_idx = self.hash_domain(domain) as usize % 4096;
        if let Some((record, _)) = self.cache[cache_idx] {
            self.cache_hits += 1;
            return Some(record);
        }

        None
    }

    fn is_icann_free(&self) -> bool {
        true
    }

    fn get_independence(&self) -> (bool, f32) {
        (true, 100.0)
    }

    fn cache_hit_rate(&self) -> f32 {
        if self.total_queries == 0 {
            0.0
        } else {
            (self.cache_hits as f32) / (self.total_queries as f32)
        }
    }

    fn hash_domain(&self, domain: &[u8]) -> u32 {
        let mut hash = 5381u32;
        for byte in domain.iter() {
            if *byte == 0 {
                break;
            }
            hash = hash.wrapping_mul(33).wrapping_add(*byte as u32);
        }
        hash
    }

    fn stats(&self) -> (u64, u64, u64, u32, u64) {
        let (total_decisions, fast_decisions, _slow, anomalies) = self.optimizer.stats();
        (
            self.total_queries,
            self.cache_hits,
            self.remote_hits,
            self.cache_count,
            anomalies,
        )
    }
}

static mut OPTIMIZER_TIME: u64 = 1000000000;
static mut RESOLVER_TIME: u64 = 1000000000;

fn get_optimizer_time() -> u64 {
    unsafe {
        OPTIMIZER_TIME = OPTIMIZER_TIME.wrapping_add(1);
        OPTIMIZER_TIME
    }
}

fn get_resolver_time() -> u64 {
    unsafe {
        RESOLVER_TIME = RESOLVER_TIME.wrapping_add(1);
        RESOLVER_TIME
    }
}

fn set_resolver_time(time: u64) {
    unsafe {
        RESOLVER_TIME = time;
    }
}
