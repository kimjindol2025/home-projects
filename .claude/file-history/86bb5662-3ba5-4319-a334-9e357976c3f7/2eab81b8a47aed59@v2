    #[test]
    fn test_e1_ttl_expiration_and_refresh() {
        let mut resolver = SovereignResolver::new(NodeId::new([1; 20]));
        let mut domain = [0u8; 253];
        domain[0] = b'e';
        domain[1] = b'1';

        // 짧은 TTL로 레코드 등록 (1초)
        let record = DnsRecord::new(domain, RecordType::A, [0u8; 512], 1);
        let proof = DnsProof {
            commitment: [1u8; 32],
            challenge: [2u8; 32],
            response: [3u8; 32],
            domain_hash: [0u8; 32],
            nonce: 11111,
        };
        let owner = [0x11u8; 32];

        let _reg = resolver.register_domain(record, &proof, owner);

        // 캐시에 추가
        let cache_idx = resolver.hash_domain(&domain) as usize % 4096;
        let expire_time = get_resolver_time() + 1_000_000_000u64;  // 1초
        resolver.cache[cache_idx] = Some((record, expire_time));
        resolver.cache_count = 1;

        // 즉시 조회 → 캐시 히트
        let found = resolver.resolve(&domain);
        assert!(found.is_some());
        assert_eq!(resolver.cache_hits, 1);

        // 시간 경과 (2초)
        set_resolver_time(get_resolver_time() + 2_000_000_000u64);

        // TTL 만료 후 조회 → 캐시 미스
        let found2 = resolver.resolve(&domain);
        assert!(found2.is_none());
        assert_eq!(resolver.cache_hits, 1);  // 변화 없음

        println!("✅ E1: TTL 만료 및 캐시 갱신 통과");
    }

