    #[test]
    fn test_e3_path_selection_consistency() {
        let mut optimizer = DnsPathOptimizer::new();

        // 같은 도메인으로 100회 경로 선택
        let mut domain = [0u8; 253];
        domain[0] = b'c';
        domain[1] = b'o';
        domain[2] = b'n';
        domain[3] = b's';

        let query = DnsQuery {
            domain,
            query_type: 0,
            client_ip: 0x7F000001,
            is_recursive: true,
        };

        let first_path = optimizer.optimize_path(&query).selected_path;

        // 다음 99회도 같은 경로 선택 여부 확인
        let mut same_path_count = 1u32;
        for _ in 0..99 {
            let path = optimizer.optimize_path(&query);
            if path.selected_path == first_path {
                same_path_count += 1;
            }
        }

        // 신경망 기반 결정이므로 80% 이상 일관성 검증
        assert!(same_path_count >= 80, "경로 선택 일관성 부족 ({}%)", same_path_count);

        println!("✅ E3: 경로 선택 일관성 통과 ({}% 일관성)", same_path_count);
    }

    // ================================================================
    // E4: 캐시 LRU 교체
    // ================================================================

    #[test]
    fn test_e4_cache_lru_replacement() {
        let mut resolver = SovereignResolver::new(NodeId::new([4; 20]));

        // 도메인 2개 캐시에 저장
        let mut domain1 = [0u8; 253];
        domain1[0] = b'l';
        domain1[1] = b'r';
        domain1[2] = b'u';
        domain1[3] = b'1';

        let mut domain2 = [0u8; 253];
        domain2[0] = b'l';
        domain2[1] = b'r';
        domain2[2] = b'u';
        domain2[3] = b'2';

        let record = DnsRecord::new(domain1, RecordType::A, [0u8; 512], 3600);
        let cache_idx1 = resolver.hash_domain(&domain1) as usize % 4096;
        let cache_idx2 = resolver.hash_domain(&domain2) as usize % 4096;

        if cache_idx1 != cache_idx2 {
            // 서로 다른 캐시 인덱스
            resolver.cache[cache_idx1] = Some((record, get_resolver_time() + 3600_000_000_000u64));
            resolver.cache[cache_idx2] = Some((record, get_resolver_time() + 3600_000_000_000u64));
            resolver.cache_count = 2;

            // domain1 접근 (LRU 업데이트)
            let _found1 = resolver.resolve(&domain1);
            assert_eq!(resolver.cache_hits, 1);

            // 통계 확인
            let (_total, hits, _remote, cached, _anomalies) = resolver.stats();
            assert_eq!(cached, 2);
            assert!(hits >= 1);

            println!("✅ E4: 캐시 LRU 교체 통과");
        } else {
            println!("⚠️  E4: 해시 충돌로 스킵 (cache_idx1 == cache_idx2)");
        }
    }

