    #[test]
    fn test_d6_statistics_and_independence() {
        let mut resolver = SovereignResolver::new(NodeId::new([5; 20]));

        // 10개 쿼리
        for i in 0..10 {
            let mut domain = [0u8; 253];
            domain[0] = (b'a' + (i % 26) as u8);
            domain[1] = (b'b' + (i % 25) as u8);
            domain[2] = (b'c' + (i % 24) as u8);

            let _found = resolver.resolve(&domain);
        }

        // 통계 확인
        let (total_queries, cache_hits, remote_hits, cache_count, anomalies) = resolver.stats();
        assert_eq!(total_queries, 10);

        // 캐시 히트율
        let hit_rate = resolver.cache_hit_rate();
        assert!(hit_rate >= 0.0 && hit_rate <= 1.0);

        // ICANN 독립성 검증 (규칙 6: 0%)
        assert!(resolver.is_icann_free(), "ICANN 의존성 있음");

        let (is_free, independence_pct) = resolver.get_independence();
        assert!(is_free);
        assert_eq!(independence_pct, 100.0);

        println!("✅ D6: 통계 및 독립성 검증 통과");
        println!("   - 총 쿼리: {}", total_queries);
        println!("   - 캐시 히트: {}", cache_hits);
        println!("   - 원격 히트: {}", remote_hits);
        println!("   - 캐시된 레코드: {}", cache_count);
        println!("   - 탐지된 이상: {}", anomalies);
        println!("   - 캐시 히트율: {:.2}%", hit_rate * 100.0);
        println!("   - ICANN 독립도: {}%", independence_pct);
    }

