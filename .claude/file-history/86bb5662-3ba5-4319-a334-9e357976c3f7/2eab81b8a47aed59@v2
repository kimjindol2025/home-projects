    #[test]
    fn test_e2_multiple_domain_resolution() {
        let mut resolver = SovereignResolver::new(NodeId::new([2; 20]));

        // 10개 다른 도메인 등록
        let mut records = [DnsRecord::new([0u8; 253], RecordType::A, [0u8; 512], 3600); 10];
        let proof = DnsProof {
            commitment: [1u8; 32],
            challenge: [2u8; 32],
            response: [3u8; 32],
            domain_hash: [0u8; 32],
            nonce: 22222,
        };
        let owner = [0x22u8; 32];

        for i in 0..10 {
            let mut domain = [0u8; 253];
            domain[0] = b'e';
            domain[1] = b'2';
            domain[2] = (b'0' + (i % 10) as u8);
            records[i].domain = domain;

            let _reg = resolver.register_domain(records[i], &proof, owner);
        }

        // 모든 도메인 캐시에 추가
        for i in 0..10 {
            let cache_idx = resolver.hash_domain(&records[i].domain) as usize % 4096;
            let expire_time = get_resolver_time() + 3600_000_000_000u64;
            resolver.cache[cache_idx] = Some((records[i], expire_time));
            resolver.cache_count += 1;
        }

        // 각 도메인 조회
        for i in 0..10 {
            let found = resolver.resolve(&records[i].domain);
            assert!(found.is_some(), "도메인 {} 해석 실패", i);
        }

        let (total, hits, _remote, _cached, _anomalies) = resolver.stats();
        assert_eq!(total, 10);
        assert!(hits >= 9, "캐시 히트가 90% 이상이어야 함");

        println!("✅ E2: 다중 도메인 해석 통과 ({}개 도메인)", total);
    }

