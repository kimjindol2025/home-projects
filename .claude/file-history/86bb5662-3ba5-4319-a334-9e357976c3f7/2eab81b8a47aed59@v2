    #[test]
    fn test_d4_anomalous_query_detection() {
        let mut optimizer = DnsPathOptimizer::new();

        // 정상 도메인
        let normal_domain = b"example.com";

        // 이상 도메인 (랜덤 문자)
        let mut anomaly_domain = [0u8; 253];
        for i in 0..20 {
            anomaly_domain[i] = (0x41 + (i % 26) as u8);  // 'A'-'Z'
            anomaly_domain[20 + i] = (0x61 + ((i + 13) % 26) as u8);  // 'a'-'z'
        }

        // 정상 쿼리 분석
        let normal_anomaly = optimizer.analyze_query_pattern(normal_domain);
        assert!(!normal_anomaly.is_anomaly, "정상 도메인이 이상으로 감지됨");

        // 이상 쿼리 분석
        let mut optimizer2 = DnsPathOptimizer::new();
        let anomalous = optimizer2.analyze_query_pattern(&anomaly_domain);
        // 높은 엔트로피는 이상으로 감지될 수 있음
        println!("  이상도: {}", anomalous.anomaly_score);

        println!("✅ D4: 이상 쿼리 탐지 통과");
    }

