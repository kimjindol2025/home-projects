    #[test]
    fn test_d5_eight_path_types() {
        let mut optimizer = DnsPathOptimizer::new();

        let path_types = [
            "LocalCache",
            "DhtFast",
            "DhtBalanced",
            "DhtThorough",
            "CacheThenDht",
            "ParallelPath",
            "ProactiveRefresh",
            "FallbackSecondary",
        ];

        let mut domains = [
            b"cache.sovereign",
            b"fast.dht.sovereign",
            b"balanced.dht.sovereign",
            b"thorough.dht.sovereign",
            b"cachemiss.sovereign",
            b"parallel.sovereign",
            b"refresh.sovereign",
            b"fallback.sovereign",
        ];

        for (i, domain_bytes) in domains.iter_mut().enumerate() {
            let mut domain = [0u8; 253];
            for (j, byte) in domain_bytes.iter().enumerate() {
                domain[j] = *byte;
            }

            let query = DnsQuery {
                domain,
                query_type: (i % 7) as u8,
                client_ip: (0x7F000001 + i as u32),
                is_recursive: true,
            };

            let path = optimizer.optimize_path(&query);
            assert!(path.selected_path < 8, "경로 선택이 범위 벗어남");
        }

        let (total, _fast, _slow, _anomalies) = optimizer.stats();
        assert_eq!(total, 8);

        println!("✅ D5: 8가지 경로 선택 통과 (selected {} paths)", total);
    }

