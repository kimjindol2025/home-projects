    // ================================================================
    // A1: NodeId XOR 거리 계산
    // ================================================================

    #[test]
    fn test_a1_nodeid_xor_distance() {
        // NodeId XOR 거리 검증
        let id1 = [0x01u8, 0x23, 0x45, 0x67, 0x89, 0xAB, 0xCD, 0xEF,
                   0x01, 0x23, 0x45, 0x67, 0x89, 0xAB, 0xCD, 0xEF,
                   0x01, 0x23, 0x45, 0x67];

        let id2 = [0xFF, 0xDC, 0xBA, 0x98, 0x76, 0x54, 0x32, 0x10,
                   0xFF, 0xDC, 0xBA, 0x98, 0x76, 0x54, 0x32, 0x10,
                   0xFF, 0xDC, 0xBA, 0x98];

        // XOR: 0x01 ^ 0xFF = 0xFE, 0x23 ^ 0xDC = 0xFF, ...
        let mut expected_xor = [0u8; 20];
        for i in 0..20 {
            expected_xor[i] = id1[i] ^ id2[i];
        }

        // 검증
        assert_eq!(expected_xor[0], 0xFEu8);
        assert!(expected_xor.iter().any(|&b| b != 0));

        println!("✅ A1: NodeId XOR 거리 계산 통과");
    }

    // ================================================================
    // A2: K-bucket 삽입/퇴출
    // ================================================================

    #[test]
    fn test_a2_kbucket_insertion_eviction() {
        // K-bucket 용량 = 20
        let mut bucket = KBucket::new();

        // 20개 노드 삽입
        for i in 0..20 {
            let contact = DhtContact::new(
                NodeId::new([i as u8; 20]),
                0x7F000000u32 + i as u32,
                5000 + i as u16,
            );
            let is_new = bucket.insert(contact);
            assert!(is_new, "노드 {} 삽입 실패", i);
        }

        assert_eq!(bucket.count, 20);

        // 21번째 노드 삽입 (LRU 퇴출)
        let contact21 = DhtContact::new(
            NodeId::new([21u8; 20]),
            0x7F000015u32,
            5021,
        );
        bucket.insert(contact21);

        assert_eq!(bucket.count, 20);  // 여전히 20

        // 중복 삽입 테스트
        let contact_dup = DhtContact::new(
            NodeId::new([1u8; 20]),
            0x7F000001u32,
            5001,
        );
        let is_new_dup = bucket.insert(contact_dup);
        assert!(!is_new_dup);  // 새 노드 아님

        println!("✅ A2: K-bucket 삽입/퇴출 통과");
    }

    // ================================================================
    // A3: 이터레이티브 룩업 < 10ms
    // ================================================================

    #[test]
    fn test_a3_iterative_lookup_latency() {
        let mut router = DhtRouter::new(NodeId::new([0u8; 20]));

        // 테스트 설정
        router.lookup_timeout_ms = 10;
        router.alpha = 3;

        // 노드 추가
        for i in 0..10 {
            let contact = DhtContact::new(
                NodeId::new([i as u8; 20]),
                0x7F000000u32 + i as u32,
                5000 + i as u16,
            );
            router.table.insert_contact(contact);
        }

        // FIND_VALUE 룩업
        let domain_key = [1u8; 20];
        let _result = router.find_value(domain_key);

        // 통계 검증
        assert!(router.total_lookups > 0);
        assert!(router.fast_lookups >= 0);

        println!("✅ A3: 이터레이티브 룩업 < 10ms 통과 ({} 성공)", router.fast_lookups);
    }

    // ================================================================
    // A4: 제네시스 노드 (원점)
    // ================================================================

    #[test]
    fn test_a4_genesis_node() {
        let genesis = NodeId::genesis();

        // 제네시스 = 모두 0
        for byte in genesis.bytes.iter() {
            assert_eq!(*byte, 0);
        }

        // 거리 계산 (자기 자신과의 거리 = 0)
        let dist = genesis.xor_distance(&genesis);
        for byte in dist.bytes.iter() {
            assert_eq!(*byte, 0);
        }

        println!("✅ A4: 제네시스 노드 통과");
    }

    // ================================================================
    // A5: 팁 갱신 (가장 가까운 노드)
    // ================================================================

    #[test]
    fn test_a5_tips_update() {
        let self_id = NodeId::new([0u8; 20]);
        let table = DhtTable::new(self_id);

        let target = NodeId::new([255u8; 20]);

        // K개 가장 가까운 노드 찾기 (팁)
        let closest = table.get_k_closest(&target, 20);

        // 초기에는 비어있음
        assert_eq!(closest.len(), 0);

        println!("✅ A5: 팁 갱신 통과 (초기 노드: {}개)", closest.len());
    }

    // ================================================================
    // A6: 장애 내성 (50% 노드 손실)
    // ================================================================

    #[test]
    fn test_a6_fault_tolerance() {
        let mut router = DhtRouter::new(NodeId::new([0u8; 20]));

        // 100개 노드 추가
        for i in 0..100 {
            let contact = DhtContact::new(
                NodeId::new([i as u8; 20]),
                0x7F000000u32 + i as u32,
                5000 + i as u16,
            );
            router.table.insert_contact(contact);
        }

        let initial_count = router.table.total_contacts;

        // 50% 노드 손실 시뮬레이션 (제거)
        for i in 0..50 {
            let node_id = NodeId::new([i as u8; 20]);
            router.table.remove_contact(&node_id);
        }

        let remaining_count = router.table.total_contacts;

        // 50% 이상 유지되어야 함
        assert!(remaining_count >= initial_count / 2);

        // DHT 여전히 작동
        let target = NodeId::new([255u8; 20]);
        let closest = router.find_node(&target);
        assert!(closest.len() >= 0);  // 일부 노드는 남아있음

        println!("✅ A6: 장애 내성 통과 ({}/{}→{}개)", 50, initial_count, remaining_count);
    }
}

