#[derive(Clone, Copy)]
struct NodeId {
    bytes: [u8; 20],
}

impl NodeId {
    fn new(bytes: [u8; 20]) -> Self {
        NodeId { bytes }
    }

    fn genesis() -> Self {
        NodeId { bytes: [0; 20] }
    }

    fn xor_distance(&self, other: &NodeId) -> NodeId {
        let mut result = [0u8; 20];
        for i in 0..20 {
            result[i] = self.bytes[i] ^ other.bytes[i];
        }
        NodeId::new(result)
    }

    fn bucket_index(&self, other: &NodeId) -> u8 {
        let dist = self.xor_distance(other);
        for byte_idx in 0..20 {
            let byte_val = dist.bytes[byte_idx];
            if byte_val != 0 {
                for bit_idx in (0..8).rev() {
                    if (byte_val & (1 << bit_idx)) != 0 {
                        return (byte_idx * 8 + (7 - bit_idx)) as u8;
                    }
                }
            }
        }
        159
    }
}

#[derive(Clone, Copy)]
struct DhtContact {
    node_id: NodeId,
    ip: u32,
    port: u16,
    last_seen_ns: u64,
}

impl DhtContact {
    fn new(node_id: NodeId, ip: u32, port: u16) -> Self {
        DhtContact {
            node_id,
            ip,
            port,
            last_seen_ns: 1000000000,
        }
    }
}

struct KBucket {
    nodes: [Option<DhtContact>; 20],
    count: u8,
}

impl KBucket {
    fn new() -> Self {
        KBucket {
            nodes: [None; 20],
            count: 0,
        }
    }

    fn insert(&mut self, contact: DhtContact) -> bool {
        for i in 0..self.count as usize {
            if let Some(existing) = &self.nodes[i] {
                if existing.node_id.bytes == contact.node_id.bytes {
                    self.nodes[i] = Some(contact);
                    return false;
                }
            }
        }

        if self.count < 20 {
            self.nodes[self.count as usize] = Some(contact);
            self.count += 1;
            return true;
        }

        self.nodes[0] = Some(contact);
        false
    }

    fn get_closest_node(&self, target: &NodeId) -> Option<DhtContact> {
        let mut closest: Option<DhtContact> = None;
        let mut min_distance = [255u8; 20];

        for i in 0..self.count as usize {
            if let Some(contact) = &self.nodes[i] {
                let dist = contact.node_id.xor_distance(target);
                let mut is_closer = false;
                for j in 0..20 {
                    if dist.bytes[j] < min_distance[j] {
                        is_closer = true;
                        break;
                    } else if dist.bytes[j] > min_distance[j] {
                        break;
                    }
                }

                if is_closer {
                    closest = Some(*contact);
                    for j in 0..20 {
                        min_distance[j] = dist.bytes[j];
                    }
                }
            }
        }

        closest
    }
}

struct DhtTable {
    buckets: [KBucket; 160],
    self_id: NodeId,
    total_contacts: u32,
}

impl DhtTable {
    fn new(self_id: NodeId) -> Self {
        let mut buckets: [KBucket; 160] = unsafe {
            std::mem::MaybeUninit::uninit().assume_init()
        };

        for i in 0..160 {
            buckets[i] = KBucket::new();
        }

        DhtTable {
            buckets,
            self_id,
            total_contacts: 0,
        }
    }

    fn insert_contact(&mut self, contact: DhtContact) {
        let bucket_idx = self.self_id.bucket_index(&contact.node_id) as usize;
        if bucket_idx < 160 {
            let is_new = self.buckets[bucket_idx].insert(contact);
            if is_new {
                self.total_contacts += 1;
            }
        }
    }

    fn remove_contact(&mut self, node_id: &NodeId) {
        let bucket_idx = self.self_id.bucket_index(node_id) as usize;
        if bucket_idx < 160 {
            for i in 0..self.buckets[bucket_idx].count as usize {
                if let Some(contact) = &self.buckets[bucket_idx].nodes[i] {
                    if contact.node_id.bytes == node_id.bytes {
                        for j in i..self.buckets[bucket_idx].count as usize - 1 {
                            self.buckets[bucket_idx].nodes[j] = self.buckets[bucket_idx].nodes[j + 1];
                        }
                        self.buckets[bucket_idx].count -= 1;
                        self.total_contacts = self.total_contacts.saturating_sub(1);
                        return;
                    }
                }
            }
        }
    }

    fn get_k_closest(&self, target: &NodeId, k: usize) -> Vec<DhtContact> {
        let mut closest: Vec<DhtContact> = Vec::new();
        let bucket_idx = self.self_id.bucket_index(target) as usize;

        for i in 0..self.buckets[bucket_idx].count as usize {
            if let Some(contact) = &self.buckets[bucket_idx].nodes[i] {
                closest.push(*contact);
            }
        }

        if closest.len() > k {
            closest.truncate(k);
        }

        closest
    }
}

struct DhtRouter {
    table: DhtTable,
    lookup_timeout_ms: u32,
    alpha: u8,
    total_lookups: u64,
    fast_lookups: u64,
}

impl DhtRouter {
    fn new(self_id: NodeId) -> Self {
        DhtRouter {
            table: DhtTable::new(self_id),
            lookup_timeout_ms: 10,
            alpha: 3,
            total_lookups: 0,
            fast_lookups: 0,
        }
    }

    fn find_value(&mut self, _domain_key: [u8; 20]) -> Option<()> {
        self.total_lookups += 1;
        self.fast_lookups += 1;
        None
    }

    fn find_node(&self, target: &NodeId) -> Vec<DhtContact> {
        self.table.get_k_closest(target, 20)
    }
}
