/* ============================================================================
   Kernel I/O Layer - Atomic-Ledger Layer 3

   목적: Sovereign-FS CAS 연동 + 블록 저장소 관리
   특징:
   - persist_block() → CAS에 4KB 청크 저장
   - retrieve_block() → CAS에서 복원
   - verify_block() → 무결성 검증
   - 규칙 6: 감사 로그 100% 보존, 규칙 7: 복구 가능성 100%

   재사용:
   - CASCore from sovereign-fs/src/cas/cas_core.fl (시뮬레이션)
   - IntegrityChecker from sovereign-fs/src/integrity/integrity_checker.fl

   크기: ~400줄
============================================================================ */

use crate::dag::DagNode;

// ============================================================================
// 1. 파일 매니페스트 (Sovereign-FS 재사용)
// ============================================================================

pub struct FileManifest {
    pub file_id: u64,
    pub file_hash: [u8; 32],
    pub chunk_count: u32,
    pub chunk_hashes: [Option<[u8; 32]>; 256],  // 최대 256개 청크
    pub total_size: u64,
    pub created_at: u64,
    pub integrity_verified: bool,
}

impl FileManifest {
    pub fn new(file_id: u64, file_hash: [u8; 32], total_size: u64) -> Self {
        FileManifest {
            file_id,
            file_hash,
            chunk_count: 0,
            chunk_hashes: [None; 256],
            total_size,
            created_at: get_current_time_ns(),
            integrity_verified: false,
        }
    }

    pub fn add_chunk(&mut self, idx: usize, hash: [u8; 32]) -> bool {
        if idx >= 256 || idx >= self.chunk_count as usize {
            return false;
        }

        self.chunk_hashes[idx] = Some(hash);
        true
    }

    pub fn clone(&self) -> Self {
        FileManifest {
            file_id: self.file_id,
            file_hash: self.file_hash,
            chunk_count: self.chunk_count,
            chunk_hashes: self.chunk_hashes,
            total_size: self.total_size,
            created_at: self.created_at,
            integrity_verified: self.integrity_verified,
        }
    }
}

// ============================================================================
// 2. 무결성 상태
// ============================================================================

pub enum IntegrityStatus {
    Valid,
    Tampered,
    Missing,
    Corrupted,
}

impl IntegrityStatus {
    pub fn clone(&self) -> Self {
        match self {
            IntegrityStatus::Valid => IntegrityStatus::Valid,
            IntegrityStatus::Tampered => IntegrityStatus::Tampered,
            IntegrityStatus::Missing => IntegrityStatus::Missing,
            IntegrityStatus::Corrupted => IntegrityStatus::Corrupted,
        }
    }
}

// ============================================================================
// 3. CAS Core (시뮬레이션)
// ============================================================================

pub struct CASCore {
    // 청크 저장소 (블록해시 → 데이터)
    pub chunk_map: [Option<[u8; 4096]>; 1024],  // 최대 1024개 청크 (4MB)
    pub chunk_count: u32,
    pub total_stored_bytes: u64,
}

impl CASCore {
    pub fn new() -> Self {
        CASCore {
            chunk_map: [None; 1024],
            chunk_count: 0,
            total_stored_bytes: 0,
        }
    }

    /// 청크 저장 (O(1))
    pub fn store_chunk(&mut self, chunk_idx: u32, data: &[u8]) -> bool {
        if chunk_idx >= 1024 {
            return false;
        }

        let mut chunk = [0u8; 4096];
        let copy_len = if data.len() > 4096 {
            4096
        } else {
            data.len()
        };

        for i in 0..copy_len {
            chunk[i] = data[i];
        }

        self.chunk_map[chunk_idx as usize] = Some(chunk);
        self.chunk_count += 1;
        self.total_stored_bytes += copy_len as u64;

        true
    }

    /// 청크 복원 (O(1))
    pub fn retrieve_chunk(&self, chunk_idx: u32) -> Option<[u8; 4096]> {
        if chunk_idx >= 1024 {
            return None;
        }

        self.chunk_map[chunk_idx as usize]
    }

    /// 청크 존재 확인
    pub fn has_chunk(&self, chunk_idx: u32) -> bool {
        if chunk_idx >= 1024 {
            return false;
        }

        self.chunk_map[chunk_idx as usize].is_some()
    }

    /// 청크 삭제
    pub fn delete_chunk(&mut self, chunk_idx: u32) -> bool {
        if chunk_idx >= 1024 {
            return false;
        }

        if self.chunk_map[chunk_idx as usize].is_some() {
            self.chunk_map[chunk_idx as usize] = None;
            if self.chunk_count > 0 {
                self.chunk_count -= 1;
            }
            return true;
        }

        false
    }

    pub fn clone(&self) -> Self {
        let mut new_map = [None; 1024];
        for i in 0..1024 {
            new_map[i] = self.chunk_map[i];
        }

        CASCore {
            chunk_map: new_map,
            chunk_count: self.chunk_count,
            total_stored_bytes: self.total_stored_bytes,
        }
    }
}

// ============================================================================
// 4. 무결성 검증기
// ============================================================================

pub struct IntegrityChecker {
    pub verified_count: u32,
    pub violation_count: u32,
    pub last_error: u32,
}

impl IntegrityChecker {
    pub fn new() -> Self {
        IntegrityChecker {
            verified_count: 0,
            violation_count: 0,
            last_error: 0,
        }
    }

    /// 파일 무결성 검증
    pub fn verify_file(&mut self, manifest: &FileManifest, cas: &CASCore) -> IntegrityStatus {
        // Step 1: 모든 청크 존재 확인
        for i in 0..manifest.chunk_count {
            if !cas.has_chunk(i) {
                self.violation_count += 1;
                return IntegrityStatus::Missing;
            }
        }

        // Step 2: 청크 해시 검증
        for i in 0..manifest.chunk_count {
            if let Some(expected_hash) = manifest.chunk_hashes[i as usize] {
                if let Some(chunk) = cas.retrieve_chunk(i) {
                    let computed_hash = simple_sha3_256(&chunk);
                    if computed_hash != expected_hash {
                        self.violation_count += 1;
                        return IntegrityStatus::Tampered;
                    }
                } else {
                    self.violation_count += 1;
                    return IntegrityStatus::Missing;
                }
            }
        }

        // Step 3: 파일 해시 검증
        let mut file_data = Vec::new();
        for i in 0..manifest.chunk_count {
            if let Some(chunk) = cas.retrieve_chunk(i) {
                for j in 0..4096 {
                    file_data.push(chunk[j]);
                }
            }
        }

        let computed_file_hash = simple_sha3_256(&file_data);
        if computed_file_hash != manifest.file_hash {
            self.violation_count += 1;
            return IntegrityStatus::Corrupted;
        }

        self.verified_count += 1;
        IntegrityStatus::Valid
    }

    /// 검증 통계
    pub fn verification_rate(&self) -> f32 {
        let total = self.verified_count + self.violation_count;
        if total == 0 {
            return 0.0;
        }

        (self.verified_count as f32 / total as f32) * 100.0
    }

    pub fn clone(&self) -> Self {
        IntegrityChecker {
            verified_count: self.verified_count,
            violation_count: self.violation_count,
            last_error: self.last_error,
        }
    }
}

// ============================================================================
// 5. 커널 I/O 계층
// ============================================================================

pub struct LedgerIoLayer {
    pub cas: CASCore,
    pub integrity: IntegrityChecker,
    pub manifest_map: [Option<FileManifest>; 256],  // 최대 256개 파일
    pub total_manifests: u32,
}

impl LedgerIoLayer {
    pub fn new() -> Self {
        LedgerIoLayer {
            cas: CASCore::new(),
            integrity: IntegrityChecker::new(),
            manifest_map: [None; 256],
            total_manifests: 0,
        }
    }

    /// DAG 노드를 블록으로 저장
    pub fn persist_block(&mut self, node: &DagNode, manifest_id: u32) -> Option<FileManifest> {
        if manifest_id >= 256 || self.total_manifests >= 256 {
            return None;
        }

        // Step 1: 노드를 바이너리로 변환
        let mut block_data = [0u8; 512];
        let mut idx = 0;

        // node_id (8)
        let id_bytes = node.node_id.to_le_bytes();
        for i in 0..8 {
            block_data[idx] = id_bytes[i];
            idx += 1;
        }

        // parent_hash_1 (32)
        for i in 0..32 {
            block_data[idx] = node.parent_hash_1[i];
            idx += 1;
        }

        // parent_hash_2 (32)
        for i in 0..32 {
            block_data[idx] = node.parent_hash_2[i];
            idx += 1;
        }

        // tx_data (256)
        for i in 0..256 {
            block_data[idx] = node.tx_data[i];
            idx += 1;
        }

        // self_hash (32)
        for i in 0..32 {
            block_data[idx] = node.self_hash[i];
            idx += 1;
        }

        // Step 2: CAS에 저장
        let chunk_hash = simple_sha3_256(&block_data[0..idx]);
        let chunk_idx = self.cas.chunk_count;

        if !self.cas.store_chunk(chunk_idx, &block_data[0..idx]) {
            return None;
        }

        // Step 3: 매니페스트 생성
        let file_hash = simple_sha3_256(&block_data[0..idx]);
        let mut manifest = FileManifest::new(manifest_id as u64, file_hash, idx as u64);
        manifest.chunk_count = 1;
        manifest.chunk_hashes[0] = Some(chunk_hash);
        manifest.integrity_verified = true;

        self.manifest_map[manifest_id as usize] = Some(manifest.clone());
        self.total_manifests += 1;

        Some(manifest)
    }

    /// CAS에서 블록 복원
    pub fn retrieve_block(&self, manifest_id: u32) -> Option<DagNode> {
        if manifest_id >= 256 {
            return None;
        }

        let manifest = self.manifest_map[manifest_id as usize].as_ref()?;

        if manifest.chunk_count == 0 {
            return None;
        }

        let chunk = self.cas.retrieve_chunk(0)?;

        // 바이너리를 DagNode로 역직렬화 (간단화)
        let node = DagNode {
            node_id: 0,
            parent_hash_1: [0u8; 32],
            parent_hash_2: [0u8; 32],
            tx_data: [0u8; 256],
            tx_amount: 0,
            nonce: 0,
            timestamp: 0,
            self_hash: manifest.file_hash,
            amount_commitment: [0u8; 32],
            is_genesis: false,
        };

        Some(node)
    }

    /// 블록 무결성 검증
    pub fn verify_block(&mut self, manifest_id: u32) -> IntegrityStatus {
        if manifest_id >= 256 {
            return IntegrityStatus::Missing;
        }

        let manifest = match self.manifest_map[manifest_id as usize].as_ref() {
            Some(m) => m.clone(),
            None => return IntegrityStatus::Missing,
        };

        self.integrity.verify_file(&manifest, &self.cas)
    }

    pub fn clone(&self) -> Self {
        let mut new_manifests = [None; 256];
        for i in 0..256 {
            if let Some(m) = &self.manifest_map[i] {
                new_manifests[i] = Some(m.clone());
            }
        }

        LedgerIoLayer {
            cas: self.cas.clone(),
            integrity: self.integrity.clone(),
            manifest_map: new_manifests,
            total_manifests: self.total_manifests,
        }
    }
}

// ============================================================================
// 6. 유틸리티
// ============================================================================

fn simple_sha3_256(data: &[u8]) -> [u8; 32] {
    let mut hash = [0u8; 32];
    let mut state = 0u64;

    for &byte in data {
        state = state.wrapping_mul(6364136223846793005)
            .wrapping_add(1442695040888963407);
        state ^= byte as u64;
    }

    for i in 0..4 {
        let val = state.wrapping_add((i as u64) * 31).wrapping_mul(1111111111111111111u64);
        hash[i * 8] = (val & 0xFF) as u8;
        hash[i * 8 + 1] = ((val >> 8) & 0xFF) as u8;
        hash[i * 8 + 2] = ((val >> 16) & 0xFF) as u8;
        hash[i * 8 + 3] = ((val >> 24) & 0xFF) as u8;
        hash[i * 8 + 4] = ((val >> 32) & 0xFF) as u8;
        hash[i * 8 + 5] = ((val >> 40) & 0xFF) as u8;
        hash[i * 8 + 6] = ((val >> 48) & 0xFF) as u8;
        hash[i * 8 + 7] = ((val >> 56) & 0xFF) as u8;
    }

    hash
}

fn get_current_time_ns() -> u64 {
    static mut TIME: u64 = 1000000000;
    unsafe {
        TIME = TIME.wrapping_add(1);
        TIME
    }
}

