/* ============================================================================
   DNS Record - 도메인 레코드 구조 (Layer 2)

   목적: RecordType + DnsRecord + 버전 관리
   특징:
   - A/AAAA/MX/TXT/CNAME/NS/SOA 레코드 타입
   - TTL 기반 만료
   - ZKP 소유권 증명 해시
   - 버전 체인 (DAG 패턴)

   크기: ~350줄
============================================================================ */

use std::vec::Vec;

#[derive(Clone, Copy, PartialEq)]
pub enum RecordType {
    A,      // IPv4 - 4바이트
    AAAA,   // IPv6 - 16바이트
    MX,     // Mail Exchange - 도메인 + 우선순위
    TXT,    // Text - 문자열
    CNAME,  // Canonical Name - 별칭
    NS,     // Name Server - 네임서버
    SOA,    // Start of Authority - 권한
}

#[derive(Clone, Copy)]
pub struct DnsRecord {
    pub domain: [u8; 253],
    pub record_type: RecordType,
    pub value: [u8; 512],
    pub value_len: u16,
    pub ttl: u32,
    pub owner_hash: [u8; 32],      // PedersenCommitment (소유자)
    pub proof_hash: [u8; 32],      // ZKP 증명 해시
    pub timestamp: u64,
    pub signature: [u8; 64],       // ECDSA 서명
    pub version: u32,              // 버전 (DAG 버전 체인)
    pub parent_version_hash: [u8; 32],  // 이전 버전 해시
}

impl DnsRecord {
    pub fn new(domain: [u8; 253], record_type: RecordType, value: [u8; 512], ttl: u32) -> Self {
        DnsRecord {
            domain,
            record_type,
            value,
            value_len: 0,
            ttl,
            owner_hash: [0; 32],
            proof_hash: [0; 32],
            timestamp: get_record_time(),
            signature: [0; 64],
            version: 1,
            parent_version_hash: [0; 32],
        }
    }

    pub fn is_expired(&self) -> bool {
        let ttl_ns = self.ttl as u64 * 1_000_000_000u64;
        get_record_time() - self.timestamp > ttl_ns
    }

    pub fn compute_hash(&self) -> [u8; 32] {
        // SHA-3-256 시뮬레이션: domain + value_len을 해시
        let mut hash = [0u8; 32];

        for i in 0..32 {
            if i < 20 {
                hash[i] = self.domain[i].wrapping_mul(31);
            } else {
                let val_idx = (self.value_len as usize + i - 20) % 512;
                hash[i] = self.value[val_idx].wrapping_mul(17);
            }
        }

        hash
    }

    pub fn set_owner(&mut self, owner_hash: [u8; 32]) {
        self.owner_hash = owner_hash;
    }

    pub fn set_proof(&mut self, proof_hash: [u8; 32]) {
        self.proof_hash = proof_hash;
    }

    pub fn set_version_parent(&mut self, version: u32, parent_hash: [u8; 32]) {
        self.version = version;
        self.parent_version_hash = parent_hash;
    }
}

// ============================================================================
// RecordType 유틸리티
// ============================================================================

impl RecordType {
    pub fn name(&self) -> &'static str {
        match self {
            RecordType::A => "A",
            RecordType::AAAA => "AAAA",
            RecordType::MX => "MX",
            RecordType::TXT => "TXT",
            RecordType::CNAME => "CNAME",
            RecordType::NS => "NS",
            RecordType::SOA => "SOA",
        }
    }

    pub fn expected_size(&self) -> u16 {
        match self {
            RecordType::A => 4,
            RecordType::AAAA => 16,
            RecordType::MX => 14,
            RecordType::TXT => 255,
            RecordType::CNAME => 253,
            RecordType::NS => 253,
            RecordType::SOA => 100,
        }
    }

    pub fn validate_value(&self, value: &[u8], len: u16) -> bool {
        match self {
            RecordType::A => len == 4,          // IPv4
            RecordType::AAAA => len == 16,      // IPv6
            RecordType::MX => len > 0 && len <= 255,
            RecordType::TXT => len > 0 && len <= 255,
            RecordType::CNAME => len > 0 && len <= 253,
            RecordType::NS => len > 0 && len <= 253,
            RecordType::SOA => len > 0 && len <= 100,
        }
    }
}

// ============================================================================
// 시간 함수
// ============================================================================

static mut RECORD_TIME: u64 = 1000000000;

pub fn get_record_time() -> u64 {
    unsafe {
        RECORD_TIME = RECORD_TIME.wrapping_add(1);
        RECORD_TIME
    }
}

pub fn set_record_time(time: u64) {
    unsafe {
        RECORD_TIME = time;
    }
}
