    // ================================================================
    // C3: 레코드 업데이트 (버전 체인)
    // ================================================================

    #[test]
    fn test_c3_record_update_version_chain() {
        let mut registry = SovereignRegistry::new();

        let mut domain = [0u8; 253];
        domain[0] = b'u';
        domain[1] = b'p';
        domain[2] = b'd';

        let mut record_v1 = DnsRecord::new(domain, RecordType::A, [0u8; 512], 3600);
        let mut value = [0u8; 512];
        value[0] = 192;
        value[1] = 168;
        value[2] = 1;
        value[3] = 1;
        record_v1.value = value;
        record_v1.value_len = 4;

        let proof = DnsProof {
            commitment: [1u8; 32],
            challenge: [2u8; 32],
            response: [3u8; 32],
            domain_hash: [0u8; 32],
            nonce: 12345,
        };

        let owner = [0xFFu8; 32];

        // Version 1 등록
        registry.register_domain(record_v1, &proof, owner);
        assert_eq!(registry.record_count, 1);

        // Version 2 업데이트
        let mut record_v2 = DnsRecord::new(domain, RecordType::A, [0u8; 512], 7200);
        let mut value2 = [0u8; 512];
        value2[0] = 10;
        value2[1] = 0;
        value2[2] = 0;
        value2[3] = 1;
        record_v2.value = value2;
        record_v2.value_len = 4;

        let result = registry.update_record(record_v2, &proof, owner);
        assert!(result, "업데이트 실패");

        // 조회해서 버전 확인
        let found = registry.lookup_record(&domain);
        assert!(found.is_some(), "업데이트된 레코드 조회 실패");

        let found_record = found.unwrap();
        assert_eq!(found_record.version, 2, "버전이 업데이트되지 않음");

        println!("✅ C3: 레코드 업데이트 (버전 체인) 통과");
    }

