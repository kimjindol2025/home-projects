    #[test]
    fn test_b5_duplicate_registration_rejected() {
        let mut registry = SovereignRegistry::new();

        let mut domain = [0u8; 253];
        domain[0] = b'd';
        domain[1] = b'u';
        domain[2] = b'p';

        let record = DnsRecord::new(domain, RecordType::A, [0u8; 512], 3600);
        let proof = DnsProof {
            commitment: [1u8; 32],
            challenge: [2u8; 32],
            response: [3u8; 32],
            domain_hash: [0u8; 32],
            nonce: 12345,
        };

        let owner = [0xDDu8; 32];

        // 첫 번째 등록
        let result1 = registry.register_domain(record, &proof, owner);
        assert!(result1, "첫 번째 등록 실패");

        // 두 번째 등록 (같은 도메인) - 거부되어야 함
        let result2 = registry.register_domain(record, &proof, owner);
        assert!(!result2, "중복 등록이 허용되었음 (should be rejected)");

        assert_eq!(registry.record_count, 1, "레코드가 2개가 되었음");

        println!("✅ B5: 중복 등록 거부 통과");
    }

