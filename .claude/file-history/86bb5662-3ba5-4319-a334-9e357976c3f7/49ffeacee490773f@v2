    #[test]
    fn test_b6_statistics() {
        let mut registry = SovereignRegistry::new();

        // 3개 도메인 등록
        for i in 0..3 {
            let mut domain = [0u8; 253];
            domain[0] = (b'a' + i as u8);

            let record = DnsRecord::new(domain, RecordType::A, [0u8; 512], 3600);
            let proof = DnsProof {
                commitment: [1u8; 32],
                challenge: [2u8; 32],
                response: [3u8; 32],
                domain_hash: [0u8; 32],
                nonce: 12345,
            };

            let owner = [(0xAAu8 + i as u8); 32];
            registry.register_domain(record, &proof, owner);
        }

        let (count, stored, verified) = registry.stats();
        assert_eq!(count, 3, "레코드 개수 불일치");
        assert_eq!(stored, 3, "저장된 개수 불일치");

        println!("✅ B6: 통계 통과 (records: {}, stored: {}, verified: {})", count, stored, verified);
