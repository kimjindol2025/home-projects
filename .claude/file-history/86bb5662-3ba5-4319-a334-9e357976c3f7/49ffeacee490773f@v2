#[derive(Clone, Copy)]
pub enum RecordType {
    A,
    AAAA,
    MX,
    TXT,
    CNAME,
    NS,
    SOA,
}

impl RecordType {
    fn name(&self) -> &'static str {
        match self {
            RecordType::A => "A",
            RecordType::AAAA => "AAAA",
            RecordType::MX => "MX",
            RecordType::TXT => "TXT",
            RecordType::CNAME => "CNAME",
            RecordType::NS => "NS",
            RecordType::SOA => "SOA",
        }
    }

    fn expected_size(&self) -> u16 {
        match self {
            RecordType::A => 4,
            RecordType::AAAA => 16,
            RecordType::MX => 14,
            RecordType::TXT => 255,
            RecordType::CNAME => 253,
            RecordType::NS => 253,
            RecordType::SOA => 100,
        }
    }
}

#[derive(Clone, Copy)]
pub struct DnsRecord {
    pub domain: [u8; 253],
    pub record_type: RecordType,
    pub value: [u8; 512],
    pub value_len: u16,
    pub ttl: u32,
    pub version: u32,
}

impl DnsRecord {
    fn new(domain: [u8; 253], record_type: RecordType, value: [u8; 512], ttl: u32) -> Self {
        DnsRecord {
            domain,
            record_type,
            value,
            value_len: 0,
            ttl,
            version: 1,
        }
    }

    fn is_expired(&self) -> bool {
        false
    }

    fn compute_hash(&self) -> [u8; 32] {
        let mut hash = [0u8; 32];
        for i in 0..32 {
            if i < 20 {
                hash[i] = self.domain[i].wrapping_mul(31);
            }
        }
        hash
    }
}

pub struct DnsProof {
    pub commitment: [u8; 32],
    pub challenge: [u8; 32],
    pub response: [u8; 32],
    pub domain_hash: [u8; 32],
    pub nonce: u64,
}

pub struct SovereignRegistry {
    pub cas: CASCore,
    pub records: [Option<DnsRecord>; 4096],
    pub record_count: u32,
    pub ownership_map: [Option<[u8; 32]>; 4096],
    pub version_chain: [Option<(u32, [u8; 32])>; 4096],
    pub total_stored: u64,
    pub cas_verified: u64,
}

pub struct CASCore {
    pub chunks: [Option<[u8; 4096]>; 1024],
    pub chunk_count: u32,
}

impl CASCore {
    fn new() -> Self {
        CASCore {
            chunks: [None; 1024],
            chunk_count: 0,
        }
    }

    fn has_chunk(&self, idx: u32) -> bool {
        if idx >= 1024 {
            return false;
        }
        self.chunks[idx as usize].is_some()
    }

    fn retrieve_chunk(&self, idx: u32) -> Option<[u8; 4096]> {
        if idx >= 1024 {
            return None;
        }
        self.chunks[idx as usize]
    }
}

impl SovereignRegistry {
    fn new() -> Self {
        SovereignRegistry {
            cas: CASCore::new(),
            records: [None; 4096],
            record_count: 0,
            ownership_map: [None; 4096],
            version_chain: [None; 4096],
            total_stored: 0,
            cas_verified: 0,
        }
    }

    fn hash_domain(&self, domain: &[u8]) -> u32 {
        let mut hash = 5381u32;
        for byte in domain.iter() {
            if *byte == 0 {
                break;
            }
            hash = hash.wrapping_mul(33).wrapping_add(*byte as u32);
        }
        hash
    }

    fn register_domain(&mut self, mut record: DnsRecord, proof: &DnsProof, owner: [u8; 32]) -> bool {
        if !self.verify_proof(proof) {
            return false;
        }

        let domain_hash = self.hash_domain(&record.domain);
        let idx = (domain_hash as usize) % 4096;

        if let Some(_) = &self.records[idx] {
            return false;
        }

        self.records[idx] = Some(record);
        self.record_count += 1;
        self.ownership_map[idx] = Some(owner);
        self.version_chain[idx] = Some((1, record.compute_hash()));
        self.total_stored += 1;

        let mut cas_data = [0u8; 4096];
        self.cas.chunks[self.cas.chunk_count as usize] = Some(cas_data);
        self.cas.chunk_count += 1;

        true
    }

    fn lookup_record(&self, domain: &[u8]) -> Option<DnsRecord> {
        let domain_hash = self.hash_domain(domain);
        let idx = (domain_hash as usize) % 4096;
        self.records[idx]
    }

    fn lookup_owner(&self, domain: &[u8]) -> Option<[u8; 32]> {
        let domain_hash = self.hash_domain(domain);
        let idx = (domain_hash as usize) % 4096;
        self.ownership_map[idx]
    }

    fn update_record(&mut self, mut record: DnsRecord, proof: &DnsProof, owner: [u8; 32]) -> bool {
        let domain_hash = self.hash_domain(&record.domain);
        let idx = (domain_hash as usize) % 4096;

        if let Some(_) = &self.records[idx] {
            if let Some(existing_owner) = self.ownership_map[idx] {
                for i in 0..32 {
                    if existing_owner[i] != owner[i] {
                        return false;
                    }
                }
            }
        } else {
            return false;
        }

        if !self.verify_proof(proof) {
            return false;
        }

        record.version += 1;
        self.records[idx] = Some(record);
        self.version_chain[idx] = Some((record.version, record.compute_hash()));
        self.total_stored += 1;

        true
    }

    fn verify_cas_integrity(&mut self, idx: u32) -> bool {
        if let Some(_) = self.cas.chunks[idx as usize] {
            self.cas_verified += 1;
            return true;
        }
        false
    }

    fn verify_proof(&self, _proof: &DnsProof) -> bool {
        true
    }

    fn stats(&self) -> (u32, u64, u64) {
        (self.record_count, self.total_stored, self.cas_verified)
    }
}
