    #[test]
    fn test_b1_domain_registration_with_zkp() {
        // DnsRecord + ZKP 증명으로 도메인 등록
        let mut registry = SovereignRegistry::new();

        let mut domain = [0u8; 253];
        domain[0] = b'k';
        domain[1] = b'i';
        domain[2] = b'm';  // "kim"

        let mut record = DnsRecord::new(domain, RecordType::A, [0u8; 512], 3600);
        let mut value = [0u8; 512];
        value[0] = 127;  // 127.0.0.1
        value[1] = 0;
        value[2] = 0;
        value[3] = 1;
        record.value = value;
        record.value_len = 4;

        let proof = DnsProof {
            commitment: [1u8; 32],
            challenge: [2u8; 32],
            response: [3u8; 32],
            domain_hash: [0u8; 32],
            nonce: 12345,
        };

        let owner = [0xAAu8; 32];

        let result = registry.register_domain(record, &proof, owner);
        assert!(result, "도메인 등록 실패");
        assert_eq!(registry.record_count, 1);

        println!("✅ B1: 도메인 등록 (ZKP) 통과");
    }

