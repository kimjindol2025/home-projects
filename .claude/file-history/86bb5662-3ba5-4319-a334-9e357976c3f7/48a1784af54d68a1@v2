/// H2: 이중지출 100번 시도 → 전부 거부
pub fn test_h2_double_spend_100_attempts() -> bool {
    let mut engine = TxEngine::new();
    let mut rejected = 0u32;

    // 같은 nonce로 100번 시도
    for i in 1..101 {
        let tx = Transaction::new(
            i as u64,
            100,
            200,
            1000u64,
            1u64,  // 모두 같은 nonce = 이중지출 시도
            1000000000u64 + (i as u64),
        );

        match engine.commit_tx(&tx) {
            TxResult::Committed(_) => {}  // 첫 번째만 성공
            TxResult::Duplicate => rejected += 1,
            TxResult::Rejected(_) => rejected += 1,
        }
    }

    rejected >= 99  // 99개 이상 거부
}

