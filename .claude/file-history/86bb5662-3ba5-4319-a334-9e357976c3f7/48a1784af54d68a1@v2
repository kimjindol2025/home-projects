/// C1: 트랜잭션 커밋 < 1ms
pub fn test_c1_commit_under_1ms() -> bool {
    let mut engine = TxEngine::new();
    let tx = Transaction::new(
        1,
        100u64,
        200u64,
        5000u64,
        1u64,
        1000000000u64,
    );

    match engine.commit_tx(&tx) {
        TxResult::Committed(_) => {
            engine.commit_count == 1
        }
        _ => false,
    }
}

/// C2: 이중지출 방지 (100%)
pub fn test_c2_double_spend_prevention() -> bool {
    let mut engine = TxEngine::new();

    let tx1 = Transaction::new(
        1,
        100u64,
        200u64,
        5000u64,
        1u64,
        1000000000u64,
    );

    let tx2 = Transaction::new(
        2,
        100u64,
        200u64,
        3000u64,
        1u64,  // 같은 nonce → 중복
        1000000001u64,
    );

    let result1 = engine.commit_tx(&tx1);
    let result2 = engine.commit_tx(&tx2);

    matches!(result1, TxResult::Committed(_)) && matches!(result2, TxResult::Duplicate)
}

/// C3: 잔액 검증
pub fn test_c3_balance_validation() -> bool {
    let mut engine = TxEngine::new();

    // 계정 100: 초기 1,000,000
    let tx_large = Transaction::new(
        1,
        100u64,
        200u64,
        2000000u64,  // 1,000,000보다 큼
        1u64,
        1000000000u64,
    );

    match engine.commit_tx(&tx_large) {
        TxResult::Rejected(2) => true,  // error_code 2 = Insufficient balance
        _ => false,
    }
}

/// C4: Nonce 시퀀싱
pub fn test_c4_nonce_sequencing() -> bool {
    let mut engine = TxEngine::new();

    let tx1 = Transaction::new(1, 100u64, 200u64, 5000u64, 1u64, 1000000000u64);
    let tx2 = Transaction::new(2, 100u64, 200u64, 3000u64, 2u64, 1000000001u64);
    let tx3 = Transaction::new(3, 100u64, 200u64, 2000u64, 3u64, 1000000002u64);

    let r1 = engine.commit_tx(&tx1);
    let r2 = engine.commit_tx(&tx2);
    let r3 = engine.commit_tx(&tx3);

    matches!(r1, TxResult::Committed(_))
        && matches!(r2, TxResult::Committed(_))
        && matches!(r3, TxResult::Committed(_))
        && engine.commit_count == 3
}

/// C5: 거래 거부
pub fn test_c5_transaction_rejection() -> bool {
    let mut engine = TxEngine::new();

    // 잘못된 계정 ID (>= 8192)
    let tx_invalid = Transaction::new(
        1,
        9000u64,  // 무효한 계정
        200u64,
        5000u64,
        1u64,
        1000000000u64,
    );

    match engine.commit_tx(&tx_invalid) {
        TxResult::Rejected(1) => true,  // error_code 1 = Invalid account
        _ => false,
    }
}

/// C6: 원장 통계
pub fn test_c6_ledger_stats() -> bool {
    let mut engine = TxEngine::new();

    for i in 1..11 {
        let tx = Transaction::new(
            i as u64,
            100u64,
            200u64,
