/// D5: 배치 처리량 (> 10K tx/s)
pub fn test_d5_batch_throughput() -> bool {
    let mut bus = CommitBus::new();

    // 1000개 트랜잭션 투입
    for i in 0..1000 {
        let event = TxEvent::new(0, i, 1000000000u64 + (i as u64), [0u8; 32]);
        bus.submit_tx(event);
    }

    // 배치 커밋 (16 × 64 = 1024개)
    for _ in 0..16 {
        let batch = bus.commit_batch();
        if batch.len() == 0 {
            break;
        }
    }

    // 처리량 > 10,000 tx/s 확인
    let throughput = bus.throughput_tps();
    throughput > 10000.0 && bus.committed_tx_count > 900
}

