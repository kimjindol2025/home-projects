/* ============================================================================
   DHT Router - Kademlia 이터레이티브 룩업 (Layer 1)

   목적: α=3 병렬 쿼리 + < 10ms 해석 (규칙 1)
   특징:
   - FIND_VALUE: DHT에서 값 찾기
   - STORE: DHT에 값 저장
   - 이터레이티브 룩업: 가장 가까운 K개 노드 순회
   - 타임아웃: 10ms

   크기: ~400줄
============================================================================ */

use crate::dht::dht_node::{NodeId, DhtTable, DhtContact, KBucket};

// ============================================================================
// 1. DnsRecord placeholder (registry와 순환 참조 회피)
// ============================================================================

#[derive(Clone, Copy)]
pub struct DnsRecord {
    pub domain: [u8; 253],
    pub value: [u8; 512],
    pub ttl: u32,
    pub stored_at_ns: u64,
}

impl DnsRecord {
    pub fn new(domain: [u8; 253], value: [u8; 512], ttl: u32) -> Self {
        DnsRecord {
            domain,
            value,
            ttl,
            stored_at_ns: get_current_time_ns(),
        }
    }

    pub fn is_expired(&self) -> bool {
        let ttl_ns = self.ttl as u64 * 1_000_000_000u64;
        get_current_time_ns() - self.stored_at_ns > ttl_ns
    }
}

// ============================================================================
// 2. 룩업 요청/응답
// ============================================================================

pub struct LookupRequest {
    pub target_key: [u8; 20],  // 찾을 NodeId/도메인 키
    pub is_find_value: bool,   // true = FIND_VALUE, false = FIND_NODE
}

pub struct LookupResponse {
    pub contacts: [Option<DhtContact>; 20],  // K개 가장 가까운 노드
    pub contact_count: u8,
    pub found_value: Option<DnsRecord>,  // FIND_VALUE일 때만
}

// ============================================================================
// 3. DhtRouter - 이터레이티브 룩업 엔진
// ============================================================================

pub struct DhtRouter {
    pub table: DhtTable,
    pub value_store: [Option<DnsRecord>; 4096],  // DHT 값 저장소
    pub store_count: u32,
    pub alpha: u8,                               // 병렬 쿼리 수 (기본 3)
    pub lookup_timeout_ms: u32,                  // 10ms (규칙 1)
    pub total_lookups: u64,
    pub fast_lookups: u64,                       // < 10ms 카운터
    pub slow_lookups: u64,                       // >= 10ms 카운터
    pub lookup_failures: u64,
}

impl DhtRouter {
    pub fn new(self_id: NodeId) -> Self {
        DhtRouter {
            table: DhtTable::new(self_id),
            value_store: [None; 4096],
            store_count: 0,
            alpha: 3,  // 병렬 α=3
            lookup_timeout_ms: 10,
            total_lookups: 0,
            fast_lookups: 0,
            slow_lookups: 0,
            lookup_failures: 0,
        }
    }

    // ================================================================
    // STORE - DHT에 레코드 저장
    // ================================================================

    pub fn store_record(&mut self, key: [u8; 20], record: DnsRecord) -> bool {
        // 저장소에 빈 슬롯 찾기
        for i in 0..4096 {
            if self.value_store[i].is_none() {
                self.value_store[i] = Some(record);
                self.store_count += 1;
                return true;
            }
        }

        // 저장소 가득 - LRU 교체
        let mut oldest_idx = 0;
        let mut oldest_time = u64::MAX;

        for i in 0..4096 {
            if let Some(record) = &self.value_store[i] {
                if record.stored_at_ns < oldest_time {
                    oldest_time = record.stored_at_ns;
                    oldest_idx = i;
                }
            }
        }

        self.value_store[oldest_idx] = Some(record);
        true
    }

    // ================================================================
    // FIND_VALUE - DHT에서 값 찾기 (< 10ms)
    // ================================================================

    pub fn find_value(&mut self, domain_key: [u8; 20]) -> Option<DnsRecord> {
        let start_ns = get_current_time_ns();

        // Step 1: 로컬 저장소 확인 (O(1))
        for i in 0..4096 {
            if let Some(record) = &self.value_store[i] {
                // 도메인 키 매치 확인
                let mut matches = true;
                for j in 0..20 {
                    // 레코드 도메인 해시 (단순화: 첫 20바이트)
                    if record.domain[j] != domain_key[j] {
                        matches = false;
                        break;
                    }
                }

                if matches && !record.is_expired() {
                    let elapsed = get_current_time_ns() - start_ns;
                    if elapsed < 100000 {  // < 0.1ms (캐시 히트)
                        return Some(*record);
                    }
                }
            }
        }

        // Step 2: 이터레이티브 룩업
        let target_id = NodeId::new(domain_key);
        let mut queried_nodes: [Option<DhtContact>; 20] = [None; 20];
        let mut queried_count = 0u8;
        let mut candidates = self.table.get_k_closest(&target_id, 20);

        let mut attempts = 0;
        while attempts < 20 && queried_count < 20 {
            let elapsed_ns = get_current_time_ns() - start_ns;
            if elapsed_ns > self.lookup_timeout_ms as u64 * 1_000_000 {
                // 타임아웃
                self.total_lookups += 1;
                self.slow_lookups += 1;
                self.lookup_failures += 1;
                return None;
            }

            // α=3 병렬 쿼리 시뮬레이션
            let mut queries = 0;
            for i in 0..candidates.len().min(self.alpha as usize) {
                let contact = candidates[i];
                // 이미 쿼리했는지 확인
                let mut already_queried = false;
                for j in 0..queried_count as usize {
                    if let Some(q) = queried_nodes[j] {
                        // NodeId 비교
                        let mut same = true;
                        for k in 0..20 {
                            if q.node_id.bytes[k] != contact.node_id.bytes[k] {
                                same = false;
                                break;
                            }
                        }
                        if same {
                            already_queried = true;
                            break;
                        }
                    }
                }

                if !already_queried && queried_count < 20 {
                    queried_nodes[queried_count as usize] = Some(contact);
                    queried_count += 1;
                    queries += 1;

                    // 해당 노드에서 더 가까운 노드들 찾기 시뮬레이션
                    if let Some(closer) = self.table.buckets[0].get_closest_node(&target_id) {
                        let mut found = false;
                        for cand in candidates.iter_mut() {
                            let mut same = true;
                            for k in 0..20 {
                                if cand.node_id.bytes[k] != closer.node_id.bytes[k] {
                                    same = false;
                                    break;
                                }
                            }
                            if same {
                                found = true;
                                break;
                            }
                        }
                        if !found && candidates.len() < 20 {
                            candidates.push(closer);
                        }
                    }
                }
            }

            if queries == 0 {
                break;  // 더 이상 쿼리할 노드 없음
            }

            attempts += 1;
        }

        let elapsed = get_current_time_ns() - start_ns;

        self.total_lookups += 1;
        if elapsed < self.lookup_timeout_ms as u64 * 1_000_000 {
            self.fast_lookups += 1;
        } else {
            self.slow_lookups += 1;
            self.lookup_failures += 1;
        }

        None  // 찾을 수 없음
    }

    // ================================================================
    // FIND_NODE - K개 가장 가까운 노드 찾기
    // ================================================================

    pub fn find_node(&mut self, target: &NodeId) -> Vec<DhtContact> {
        let start_ns = get_current_time_ns();

        let mut closest = self.table.get_k_closest(target, 20);

        // 이터레이티브 정제 (1회)
        if closest.len() > 0 {
            if let Some(refined) = self.table.buckets[0].get_closest_node(target) {
                // 정제된 결과 추가
                let mut found = false;
                for contact in closest.iter() {
                    let mut same = true;
                    for k in 0..20 {
                        if contact.node_id.bytes[k] != refined.node_id.bytes[k] {
                            same = false;
                            break;
                        }
                    }
                    if same {
                        found = true;
                        break;
                    }
                }
                if !found && closest.len() < 20 {
                    closest.push(refined);
                }
            }
        }

        let elapsed = get_current_time_ns() - start_ns;
        if elapsed < 10_000_000 {  // < 10ms
            self.fast_lookups += 1;
        }

        closest
    }

    // ================================================================
    // 통계
    // ================================================================

    pub fn success_rate(&self) -> f32 {
        if self.total_lookups == 0 {
            0.0
        } else {
            ((self.total_lookups - self.lookup_failures) as f32) / (self.total_lookups as f32)
        }
    }

    pub fn lookup_coverage(&self) -> u32 {
        self.table.total_contacts
    }
}

// ============================================================================
// 4. 유틸리티
// ============================================================================

static mut DHT_GLOBAL_TIME: u64 = 1000000000;

fn get_current_time_ns() -> u64 {
    unsafe {
        DHT_GLOBAL_TIME = DHT_GLOBAL_TIME.wrapping_add(1);
        DHT_GLOBAL_TIME
    }
}

pub fn dht_set_test_time(time: u64) {
    unsafe {
        DHT_GLOBAL_TIME = time;
    }
}

