/* ============================================================================
   Chain Verifier - Atomic-Ledger Layer 4

   목적: DAG 체인 무결성 검증 + 경로 검증
   특징:
   - 전체 DAG 순회 검증
   - 경로 존재성 검증 (from → to)
   - 에포크 기반 부분 검증
   - 규칙 2: 데이터 무결성 100%, 규칙 4: DAG 수렴 100%

   재사용:
   - DFS 순환 탐지 from dag_store.fl
   - HashChainedAuditLog pattern from freelang-os-kernel/src/audit/hash_chain.rs

   크기: ~400줄
============================================================================ */

use crate::dag::{DagNode, DagNodePool, DagValidator};

// ============================================================================
// 1. DAG 체인 검증기
// ============================================================================

pub struct DagChainVerifier {
    pub genesis_hash: [u8; 32],
    pub epoch_checkpoints: [Option<(u64, [u8; 32])>; 256],  // (에포크, 루트 해시)
    pub checkpoint_count: u32,
    pub verified_nodes: u64,
    pub integrity_violations: u64,
}

impl DagChainVerifier {
    pub fn new(genesis_hash: [u8; 32]) -> Self {
        let mut verifier = DagChainVerifier {
            genesis_hash,
            epoch_checkpoints: [None; 256],
            checkpoint_count: 0,
            verified_nodes: 0,
            integrity_violations: 0,
        };

        // 첫 번째 체크포인트 = 제네시스
        verifier.epoch_checkpoints[0] = Some((0, genesis_hash));
        verifier.checkpoint_count = 1;

        verifier
    }

    /// 전체 DAG 검증 (순환 없음 확인)
    pub fn full_dag_scan(&mut self, pool: &DagNodePool) -> (bool, u64) {
        // Step 1: DAG 구조 검증 (순환 없음)
        if !DagValidator::is_dag_valid(pool) {
            self.integrity_violations += 1;
            return (false, 0);
        }

        // Step 2: 모든 노드의 무결성 검증
        let mut valid_nodes = 0u64;
        for i in 0..4096 {
            if let Some(node) = pool.get_node(i as u32) {
                if node.verify_integrity() {
                    valid_nodes += 1;
                    self.verified_nodes += 1;
                } else {
                    self.integrity_violations += 1;
                }
            }
        }

        // Step 3: 모든 노드가 유효한지 확인
        let all_valid = self.integrity_violations == 0;

        (all_valid, valid_nodes)
    }

    /// DAG 경로 검증 (from → to)
    pub fn verify_dag_path(
        &mut self,
        pool: &DagNodePool,
        from: &[u8; 32],
        to: &[u8; 32],
    ) -> bool {
        // from 노드부터 시작해서 to에 도달 가능한지 확인 (BFS)
        if from == to {
            return true;
        }

        let mut queue = [None; 256];
        let mut queue_idx = 0;
        let mut visited = [false; 4096];

        // 시작 노드 찾기
        if let Some((start_idx, _)) = pool.find_by_hash(from) {
            queue[0] = Some(start_idx);
            queue_idx = 1;
            visited[start_idx as usize] = true;
        } else {
            return false;  // from 노드 없음
        }

        // BFS
        let mut queue_read = 0;
        while queue_read < queue_idx {
            if let Some(idx) = queue[queue_read] {
                queue_read += 1;

                if let Some(node) = pool.get_node(idx) {
                    // 자식 노드들 찾기 (부모 해시 일치하는 노드)
                    for i in 0..4096 {
                        if !visited[i] {
                            if let Some(child) = pool.get_node(i as u32) {
                                if child.parent_hash_1 == node.self_hash
                                    || child.parent_hash_2 == node.self_hash
                                {
                                    if &child.self_hash == to {
                                        return true;
                                    }

                                    if queue_idx < 256 {
                                        queue[queue_idx] = Some(i as u32);
                                        queue_idx += 1;
                                        visited[i] = true;
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                break;
            }
        }

        false
    }

    /// 에포크 기반 부분 검증
    pub fn verify_from_checkpoint(&mut self, pool: &DagNodePool, epoch: u64) -> (bool, [u8; 32]) {
        if epoch >= 256 {
            return (false, [0u8; 32]);
        }

        let checkpoint = match self.epoch_checkpoints[epoch as usize] {
            Some((_, hash)) => hash,
            None => return (false, [0u8; 32]),
        };

        // 체크포인트부터 현재까지의 노드들만 검증
        let mut valid_count = 0;
        let mut current_hash = checkpoint;

        for i in 0..4096 {
            if let Some(node) = pool.get_node(i as u32) {
                if node.verify_integrity() {
                    valid_count += 1;
                }
            }
        }

        (valid_count > 0, current_hash)
    }

    /// 에포크 체크포인트 추가
    pub fn add_checkpoint(&mut self, epoch: u64, root_hash: [u8; 32]) -> bool {
        if epoch >= 256 || self.checkpoint_count >= 256 {
            return false;
        }

        self.epoch_checkpoints[epoch as usize] = Some((epoch, root_hash));
        self.checkpoint_count += 1;
        true
    }

    /// 검증 성공률
    pub fn verification_rate(&self) -> f32 {
        if self.verified_nodes == 0 {
            return 0.0;
        }

        let total = self.verified_nodes + self.integrity_violations;
        (self.verified_nodes as f32 / total as f32) * 100.0
    }

    pub fn clone(&self) -> Self {
        DagChainVerifier {
            genesis_hash: self.genesis_hash,
            epoch_checkpoints: self.epoch_checkpoints,
            checkpoint_count: self.checkpoint_count,
            verified_nodes: self.verified_nodes,
            integrity_violations: self.integrity_violations,
        }
    }
}

// ============================================================================
// 2. 순환 탐지 (DFS)
// ============================================================================

pub fn has_cycle_in_dag(pool: &DagNodePool) -> bool {
    let mut visited = [false; 4096];
    let mut recursion_stack = [false; 4096];

    for i in 0..4096 {
        if pool.get_node(i as u32).is_some() && !visited[i] {
            if dfs_cycle_check(pool, i, &mut visited, &mut recursion_stack) {
                return true;
            }
        }
    }

    false
}

fn dfs_cycle_check(
    pool: &DagNodePool,
    node_idx: usize,
    visited: &mut [bool; 4096],
    recursion_stack: &mut [bool; 4096],
) -> bool {
    visited[node_idx] = true;
    recursion_stack[node_idx] = true;

    if let Some(node) = pool.get_node(node_idx as u32) {
        // 부모 노드들 확인
        if let Some((parent_idx, _)) = pool.find_by_hash(&node.parent_hash_1) {
            let pidx = parent_idx as usize;
            if !visited[pidx] {
                if dfs_cycle_check(pool, pidx, visited, recursion_stack) {
                    return true;
                }
            } else if recursion_stack[pidx] {
                return true;  // 순환 발견
            }
        }

        if let Some((parent_idx, _)) = pool.find_by_hash(&node.parent_hash_2) {
            let pidx = parent_idx as usize;
            if !visited[pidx] {
                if dfs_cycle_check(pool, pidx, visited, recursion_stack) {
                    return true;
                }
            } else if recursion_stack[pidx] {
                return true;
            }
        }
    }

    recursion_stack[node_idx] = false;
    false
}

