/* ============================================================================
   DNS Record - 도메인 레코드 구조 (Layer 2)

   목적: RecordType + DnsRecord 정의 (최소)
   특징:
   - A/AAAA/MX/TXT/CNAME/NS/SOA 레코드 타입
   - TTL 기반 만료
   - ZKP 소유권 증명 해시

   크기: ~350줄
============================================================================ */

#[derive(Clone, Copy)]
pub enum RecordType {
    A,      // IPv4
    AAAA,   // IPv6
    MX,     // Mail Exchange
    TXT,    // Text
    CNAME,  // Canonical Name
    NS,     // Name Server
    SOA,    // Start of Authority
}

#[derive(Clone, Copy)]
pub struct DnsRecord {
    pub domain: [u8; 253],
    pub record_type: RecordType,
    pub value: [u8; 512],
    pub ttl: u32,
    pub owner_hash: [u8; 32],      // PedersenCommitment (소유자)
    pub proof_hash: [u8; 32],      // ZKP 증명 해시
    pub timestamp: u64,
    pub signature: [u8; 64],       // 서명
}

impl DnsRecord {
    pub fn new(domain: [u8; 253], record_type: RecordType, value: [u8; 512], ttl: u32) -> Self {
        DnsRecord {
            domain,
            record_type,
            value,
            ttl,
            owner_hash: [0; 32],
            proof_hash: [0; 32],
            timestamp: get_current_time(),
            signature: [0; 64],
        }
    }

    pub fn is_expired(&self) -> bool {
        let ttl_ns = self.ttl as u64 * 1_000_000_000u64;
        get_current_time() - self.timestamp > ttl_ns
    }
}

fn get_current_time() -> u64 {
    1000000000
}
