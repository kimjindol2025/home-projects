/* ============================================================================
   Sovereign Registry - 도메인 등록소 (Layer 2)

   목적: CASCore 재사용 + ZKP 기반 도메인 등록/관리
   특징:
   - 4096개 레코드 저장소
   - 도메인 → 소유자 (Pedersen Commitment) 매핑
   - ZKP 소유권 증명 필수 (규칙 3: < 1ms)
   - CAS 불변 저장 (규칙 8)
   - 버전 체인 (DAG 패턴)

   크기: ~400줄
============================================================================ */

use crate::registry::dns_record::{DnsRecord, RecordType};

// ============================================================================
// CASCore - Atomic-Ledger의 청크 저장소 재사용
// ============================================================================

pub struct CASCore {
    pub chunks: [Option<[u8; 4096]>; 1024],  // 1024 × 4KB = 4MB
    pub chunk_count: u32,
}

impl CASCore {
    pub fn new() -> Self {
        CASCore {
            chunks: [None; 1024],
            chunk_count: 0,
        }
    }

    pub fn store_chunk(&mut self, chunk_idx: u32, data: &[u8; 4096]) -> bool {
        if chunk_idx >= 1024 {
            return false;
        }

        self.chunks[chunk_idx as usize] = Some(*data);
        self.chunk_count += 1;
        true
    }

    pub fn retrieve_chunk(&self, chunk_idx: u32) -> Option<[u8; 4096]> {
        if chunk_idx >= 1024 {
            return None;
        }

        self.chunks[chunk_idx as usize]
    }

    pub fn has_chunk(&self, chunk_idx: u32) -> bool {
        if chunk_idx >= 1024 {
            return false;
        }

        self.chunks[chunk_idx as usize].is_some()
    }
}

// ============================================================================
// ZKP 증명 구조 (PlaceHolder - security/proof_validator에서 import)
// ============================================================================

pub struct DnsProof {
    pub commitment: [u8; 32],     // PedersenCommitment
    pub challenge: [u8; 32],      // Fiat-Shamir
    pub response: [u8; 32],       // Schnorr 응답
    pub domain_hash: [u8; 32],
    pub nonce: u64,
}

// ============================================================================
// Sovereign Registry
// ============================================================================

pub struct SovereignRegistry {
    pub cas: CASCore,
    pub records: [Option<DnsRecord>; 4096],
    pub record_count: u32,
    pub ownership_map: [Option<[u8; 32]>; 4096],  // domain_hash → owner_hash
    pub version_chain: [Option<(u32, [u8; 32])>; 4096],  // (version, hash)
    pub total_stored: u64,
    pub cas_verified: u64,
}

impl SovereignRegistry {
    pub fn new() -> Self {
        SovereignRegistry {
            cas: CASCore::new(),
            records: [None; 4096],
            record_count: 0,
            ownership_map: [None; 4096],
            version_chain: [None; 4096],
            total_stored: 0,
            cas_verified: 0,
        }
    }

    // ================================================================
    // 도메인 해시 (도메인 → 저장소 인덱스)
    // ================================================================

    fn hash_domain(&self, domain: &[u8]) -> u32 {
        let mut hash = 5381u32;
        for (i, byte) in domain.iter().enumerate() {
            if *byte == 0 || i >= 253 {
                break;
            }
            hash = hash.wrapping_mul(33).wrapping_add(*byte as u32);
        }
        hash
    }

    fn hash_domain_commitment(&self, domain: &[u8]) -> [u8; 32] {
        let mut commitment = [0u8; 32];
        for (i, byte) in domain.iter().enumerate() {
            if i >= 32 {
                break;
            }
            if i >= domain.len() {
                break;
            }
            commitment[i] = *byte;
        }
        commitment
    }

    // ================================================================
    // 도메인 등록 (ZKP 소유권 증명 필수)
    // ================================================================

    pub fn register_domain(
        &mut self,
        mut record: DnsRecord,
        proof: &DnsProof,
        owner_commitment: [u8; 32],
    ) -> bool {
        // Step 1: ZKP 증명 검증 (security/proof_validator에서 실제 구현)
        if !self.verify_proof(proof) {
            return false;
        }

        // Step 2: 도메인 해시로 인덱스 찾기
        let domain_hash = self.hash_domain(&record.domain);
        let idx = (domain_hash as usize) % 4096;

        // Step 3: 중복 확인 (같은 도메인 이미 등록되었는지)
        if let Some(existing) = &self.records[idx] {
            // 같은 도메인인지 확인
            let mut same_domain = true;
            for i in 0..253 {
                if existing.domain[i] != record.domain[i] {
                    same_domain = false;
                    break;
                }
            }
            if same_domain && !existing.is_expired() {
                return false;  // 이미 등록됨 (만료되지 않음)
            }
        }

        // Step 4: 레코드에 메타데이터 설정
        record.set_owner(owner_commitment);
        record.set_proof(proof.challenge);
        record.set_version_parent(1, [0; 32]);

        // Step 5: 메모리에 저장
        self.records[idx] = Some(record);
        self.record_count += 1;
        self.ownership_map[idx] = Some(owner_commitment);

        // Step 6: CAS에 불변 저장 (규칙 8)
        let mut cas_data = [0u8; 4096];

        // 레코드 직렬화 (단순화)
        for i in 0..253 {
            cas_data[i] = record.domain[i];
        }
        for i in 0..32 {
            cas_data[253 + i] = owner_commitment[i];
        }

        let chunk_idx = self.cas.chunk_count;
        if chunk_idx < 1024 {
            self.cas.store_chunk(chunk_idx, &cas_data);
            self.version_chain[idx] = Some((record.version, record.compute_hash()));
            self.total_stored += 1;
            return true;
        }

        false  // CAS 저장소 가득
    }

    // ================================================================
    // 도메인 조회
    // ================================================================

    pub fn lookup_record(&self, domain: &[u8]) -> Option<DnsRecord> {
        let domain_hash = self.hash_domain(domain);
        let idx = (domain_hash as usize) % 4096;

        if let Some(record) = &self.records[idx] {
            // 도메인 일치 확인
            let mut matches = true;
            for i in 0..253 {
                if record.domain[i] != domain[i] {
                    matches = false;
                    break;
                }
            }

            if matches && !record.is_expired() {
                return Some(*record);
            }
        }

        None
    }

    pub fn lookup_owner(&self, domain: &[u8]) -> Option<[u8; 32]> {
        let domain_hash = self.hash_domain(domain);
        let idx = (domain_hash as usize) % 4096;

        self.ownership_map[idx]
    }

    // ================================================================
    // 도메인 업데이트 (버전 체인)
    // ================================================================

    pub fn update_record(
        &mut self,
        mut record: DnsRecord,
        proof: &DnsProof,
        owner_commitment: [u8; 32],
    ) -> bool {
        let domain_hash = self.hash_domain(&record.domain);
        let idx = (domain_hash as usize) % 4096;

        // 기존 레코드 확인
        let mut parent_hash = [0u8; 32];
        let mut new_version = 1u32;

        if let Some(existing) = &self.records[idx] {
            // 도메인 일치 확인
            let mut matches = true;
            for i in 0..253 {
                if existing.domain[i] != record.domain[i] {
                    matches = false;
                    break;
                }
            }

            if matches {
                parent_hash = existing.compute_hash();
                new_version = existing.version + 1;
            } else {
                return false;  // 다른 도메인
            }
        } else {
            return false;  // 기존 레코드 없음
        }

        // ZKP 검증
        if !self.verify_proof(proof) {
            return false;
        }

        // 소유자 확인
        if let Some(existing_owner) = self.ownership_map[idx] {
            let mut owner_matches = true;
            for i in 0..32 {
                if existing_owner[i] != owner_commitment[i] {
                    owner_matches = false;
                    break;
                }
            }
            if !owner_matches {
                return false;  // 소유자 불일치
            }
        }

        // 새 버전으로 업데이트
        record.set_version_parent(new_version, parent_hash);
        record.set_owner(owner_commitment);
        record.set_proof(proof.challenge);

        // CAS에 저장
        let mut cas_data = [0u8; 4096];
        for i in 0..253 {
            cas_data[i] = record.domain[i];
        }
        for i in 0..32 {
            cas_data[253 + i] = owner_commitment[i];
        }

        let chunk_idx = self.cas.chunk_count;
        if chunk_idx < 1024 {
            self.cas.store_chunk(chunk_idx, &cas_data);
            self.records[idx] = Some(record);
            self.version_chain[idx] = Some((new_version, record.compute_hash()));
            self.total_stored += 1;
            return true;
        }

        false
    }

    // ================================================================
    // CAS 무결성 검증 (규칙 8)
    // ================================================================

    pub fn verify_cas_integrity(&mut self, chunk_idx: u32) -> bool {
        if let Some(chunk) = self.cas.retrieve_chunk(chunk_idx) {
            // 청크 해시 재계산 (단순화: chunk[0] != 0)
            if chunk[0] != 0 {
                self.cas_verified += 1;
                return true;
            }
        }
        false
    }

    pub fn verify_proof(&self, proof: &DnsProof) -> bool {
        // SchnorrProof 검증 시뮬레이션 (단순화)
        // commitment ≠ [0;32], challenge ≠ [0;32], response ≠ [0;32]
        let mut valid = true;

        for byte in proof.commitment.iter() {
            if *byte != 0 {
                break;
            } else {
                valid = false;
                break;
            }
        }

        for byte in proof.challenge.iter() {
            if *byte != 0 && valid {
                break;
            }
        }

        for byte in proof.response.iter() {
            if *byte != 0 && valid {
                break;
            }
        }

        valid
    }

    // ================================================================
    // 통계
    // ================================================================

    pub fn stats(&self) -> (u32, u64, u64) {
        (self.record_count, self.total_stored, self.cas_verified)
    }
}
