// 🦎 Mini Zig Compiler - Main Entry Point
// src/main.zig: Tokenizer → Parser → AST → AstGen → ZIR → Sema → AIR

const std = @import("std");
const Tokenizer = @import("tokenizer.zig").Tokenizer;
const Token = @import("tokenizer.zig").Token;
const Parser = @import("parser.zig").Parser;
const Ast = @import("ast.zig");
const printAst = @import("ast.zig").printAst;
const AstGen = @import("astgen.zig").AstGen;
const printZir = @import("zir.zig").printZir;
const Sema = @import("sema.zig").Sema;
const printAir = @import("air.zig").printAir;

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    // 테스트 소스 코드
    const source =
        \\fn add(a: i32, b: i32) -> i32 {
        \\    return a + b;
        \\}
        \\
        \\fn main() -> i32 {
        \\    const x = add(1, 2);
        \\    const y = x + 3;
        \\    return y;
        \\}
    ;

    std.debug.print("========== Mini Zig Compiler ==========\n\n", .{});

    // Step 1: Tokenize
    std.debug.print("[Step 1] TOKENIZE\n", .{});
    std.debug.print("─────────────────────────\n", .{});

    var tokenizer = Tokenizer.init(source);
    var tokens = std.ArrayList(Token).init(allocator);
    defer tokens.deinit();

    while (true) {
        const token = tokenizer.nextToken();
        try tokens.append(token);

        std.debug.print("{s:15} = \"{s}\"\n", .{ @tagName(token.tag), token.lexeme(source) });

        if (token.tag == .eof) break;
    }

    std.debug.print("\nTokens: {} total\n\n", .{tokens.items.len});

    // Step 2: Parse
    std.debug.print("[Step 2] PARSE\n", .{});
    std.debug.print("─────────────────────────\n", .{});

    var parser = Parser.init(tokens.items, source, allocator);
    const ast = try parser.parseProgram();

    // AST 출력
    std.debug.print("\nGenerated AST:\n", .{});
    printAst(&ast.root, 0);

    std.debug.print("\n✅ Parsing successful!\n\n", .{});

    // Step 3: AstGen (AST → ZIR)
    std.debug.print("[Step 3] ASTGEN (AST → ZIR)\n", .{});
    std.debug.print("─────────────────────────\n", .{});

    var astgen = try AstGen.init(allocator, source);
    try astgen.genProgram(&ast);

    std.debug.print("\nGenerated ZIR:\n", .{});
    printZir(astgen.zir, 0);

    std.debug.print("\n✅ AstGen successful!\n\n", .{});

    // Step 4: Sema (ZIR → AIR with Type Information)
    std.debug.print("[Step 4] SEMA (ZIR → AIR)\n", .{});
    std.debug.print("─────────────────────────\n", .{});

    var sema = try Sema.init(allocator, astgen.zir);
    try sema.analyzeProgram();

    std.debug.print("\nGenerated AIR:\n", .{});
    printAir(sema.air, 0);

    if (sema.hasErrors()) {
        std.debug.print("\n⚠️ Semantic errors found:\n", .{});
        sema.printErrors();
    }

    sema.deinit();
    astgen.deinit();

    std.debug.print("\n✅ Sema successful!\n", .{});
}
