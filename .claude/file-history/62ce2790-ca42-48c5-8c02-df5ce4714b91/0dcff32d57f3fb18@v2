    // 헤더: Accept: application/json
    // 파라미터: code, client_id, client_secret, redirect_uri

    // 응답 파싱 (JSON)
    // access_token, token_type, scope, expires_in

    // 임시 구현
    return Ok(GitHubTokenResponse {
