// 클라이언트 ID/Secret: config/oauth.env에서 로드

use std::io::*
use "./auth"

pub struct GitHubOAuthConfig {
  client_id: string,
  client_secret: string,
  redirect_uri: string,
  scope: string
}

pub struct GitHubTokenResponse {
  access_token: string,
  token_type: string,
  scope: string,
  expires_in: i32
}

pub struct GitHubUserInfo {
  id: i64,
  login: string,
  name: string,
  email: string,
  avatar_url: string,
  bio: string,
  company: string,
  location: string
}

// ============================================================================
// OAuth 흐름
// ============================================================================

pub fn github_get_auth_url(config: GitHubOAuthConfig) -> string
  intent "GitHub OAuth 인증 URL 생성"
  do
    let scope = string_replace_all(config.scope, " ", "%20")
    let auth_url = "https://github.com/login/oauth/authorize"
      + "?client_id=" + config.client_id
      + "&redirect_uri=" + config.redirect_uri
      + "&scope=" + scope
      + "&state=" + generate_random_state()
      + "&allow_signup=true"

    return auth_url
  end

