// ============================================================================
// HeroCard Component - Phase 9 Design Compiler 예제
// ============================================================================
// 모든 5가지 디자인 엔진을 활용한 풀 스택 컴포넌트

component HeroCard {
  // ============================================================================
  // 1. Animation 블록 (4개)
  // ============================================================================

  @animation slideInLeft {
    duration: "0.8s"
    timing: "cubic-bezier(0.34, 1.56, 0.64, 1)"
    keyframes: [
      "0% { opacity: 0; transform: translateX(-100px); }",
      "100% { opacity: 1; transform: translateX(0); }"
    ]
  }

  @animation fadeInUp {
    duration: "0.6s"
    timing: "ease-out"
    keyframes: [
      "0% { opacity: 0; transform: translateY(30px); }",
      "100% { opacity: 1; transform: translateY(0); }"
    ]
  }

  @animation scaleInCenter {
    duration: "0.5s"
    timing: "ease-out"
    keyframes: [
      "0% { opacity: 0; transform: scale(0.8); }",
      "100% { opacity: 1; transform: scale(1); }"
    ]
  }

  @animation rotateInY {
    duration: "0.8s"
    timing: "ease-out"
    keyframes: [
      "0% { opacity: 0; transform: rotateY(-90deg); }",
      "100% { opacity: 1; transform: rotateY(0); }"
    ]
  }

  // ============================================================================
  // 2. Glass Morphism 블록 (2개)
  // ============================================================================

  @glass headerCard {
    blur: "20px"
    opacity: 0.1
    color: "rgba(255, 255, 255, 0.1)"
    selector: ".hero-header"
  }

  @glass contentPanel {
    blur: "15px"
    opacity: 0.08
    color: "rgba(255, 255, 255, 0.08)"
    selector: ".hero-content"
  }

  // ============================================================================
  // 3. 3D Transform 블록 (2개)
  // ============================================================================

  @3d cardPerspective {
    perspective: "1200px"
    transforms: [
      "perspective(1200px)",
      "rotateX(0deg)",
      "rotateY(0deg)"
    ]
    selector: ".hero-card"
  }

  @3d imageDepth {
    perspective: "1000px"
    transforms: [
      "translateZ(50px)",
      "rotateX(5deg)"
    ]
    selector: ".hero-image"
  }

  // ============================================================================
  // 4. Micro Interaction 블록 (2개)
  // ============================================================================

  @micro buttonHoverScale {
    interaction: "hover"
    effect: "scale"
    value: "1.08"
    selector: ".cta-button"
  }

  @micro linkHoverSlide {
    interaction: "hover"
    effect: "translate"
    value: "5px"
    selector: ".nav-link"
  }

  // ============================================================================
  // 5. Scroll Animation 블록 (2개)
  // ============================================================================

  @scroll heroTitleReveal {
    trigger: "reveal"
    offset: "50px"
    duration: "0.6s"
    selector: ".hero-title"
  }

  @scroll contentParallax {
    trigger: "parallax"
    offset: "100px"
    duration: "1s"
    selector: ".hero-content"
  }

  // ============================================================================
  // HTML 구조
  // ============================================================================

  template {
    <div class="hero-card" style="animation: slideInLeft 0.8s cubic-bezier(0.34, 1.56, 0.64, 1)">
      <div class="hero-header glass-effect">
        <h1 class="hero-title">Welcome to Design System</h1>
      </div>

      <div class="hero-image" style="animation: rotateInY 0.8s ease-out">
        <img src="/assets/hero.png" alt="Hero Image" />
      </div>

      <div class="hero-content glass-content">
        <p class="description" style="animation: fadeInUp 0.6s ease-out">
          Powerful design compiler for modern web applications
        </p>

        <div class="action-buttons">
          <button class="cta-button interactive" style="animation: scaleInCenter 0.5s ease-out">
            Get Started
          </button>
          <a href="/docs" class="nav-link" style="animation: fadeInUp 0.6s ease-out 0.2s both">
            Learn More
          </a>
        </div>
      </div>
    </div>
  }

  // ============================================================================
  // Styles (자동 생성됨)
  // ============================================================================

  styles {
    .hero-card {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border-radius: 20px;
      padding: 40px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      overflow: hidden;
      position: relative;
    }

    .glass-effect {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 15px;
      padding: 30px;
    }

    .glass-content {
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(15px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      padding: 20px;
      margin-top: 20px;
    }

    .hero-title {
      font-size: 3.5rem;
      font-weight: 700;
      color: white;
      margin: 0;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
    }

    .description {
      font-size: 1.125rem;
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.6;
      margin: 15px 0 0 0;
    }

    .action-buttons {
      display: flex;
      gap: 15px;
      margin-top: 25px;
      flex-wrap: wrap;
    }

    .cta-button {
      padding: 12px 32px;
      background: white;
      color: #667eea;
      border: none;
      border-radius: 10px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .cta-button:hover {
      transform: scale(1.08);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

    .nav-link {
      padding: 12px 32px;
      border: 2px solid white;
      color: white;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
      display: inline-block;
    }

    .nav-link:hover {
      transform: translateX(5px);
      background: rgba(255, 255, 255, 0.1);
    }

    .interactive {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .scroll-trigger {
      opacity: 0;
      transform: translateY(20px);
      transition: all 0.6s ease-out;
    }

    .scroll-trigger.in-view {
      opacity: 1;
      transform: translateY(0);
    }

    @keyframes slideInLeft {
      from {
        opacity: 0;
        transform: translateX(-100px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes scaleInCenter {
      from {
        opacity: 0;
        transform: scale(0.8);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @keyframes rotateInY {
      from {
        opacity: 0;
        transform: rotateY(-90deg);
      }
      to {
        opacity: 1;
        transform: rotateY(0);
      }
    }
  }
}
