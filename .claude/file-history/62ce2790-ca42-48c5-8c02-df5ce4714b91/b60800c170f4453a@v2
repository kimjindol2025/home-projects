// ============================================================================
// 사용자 활동 실시간 이벤트
// ============================================================================

pub fn handle_user_typing(manager: &mut WebSocketManager, post_id: string, user_id: string, username: string) -> void
  intent "사용자 댓글 작성 중 표시"
  do
    let channel = "post:" + post_id

    let ws_event = WebSocketEvent {
      event_type: "user_typing",
      channel: channel,
      data: {
        "user_id": user_id,
        "username": username,
        "post_id": post_id
      },
      timestamp: get_current_time_unix(),
      sender_id: user_id
    }

    // 2초 후 자동 취소
    schedule_typing_cleanup(manager, post_id, user_id, 2000)

    broadcast_event(manager, ws_event)
  end

pub fn handle_user_stopped_typing(manager: &mut WebSocketManager, post_id: string, user_id: string) -> void
  intent "사용자 댓글 작성 중지"
  do
    let channel = "post:" + post_id

    let ws_event = WebSocketEvent {
      event_type: "user_stopped_typing",
      channel: channel,
      data: {
        "user_id": user_id,
        "post_id": post_id
      },
      timestamp: get_current_time_unix(),
      sender_id: user_id
    }

    broadcast_event(manager, ws_event)
  end

pub fn handle_user_online_status(manager: &mut WebSocketManager, user_id: string, is_online: bool) -> void
  intent "사용자 온/오프라인 상태 실시간 업데이트"
  do
    let ws_event = WebSocketEvent {
      event_type: if is_online then "user_online" else "user_offline" end,
      channel: "global",
      data: {
        "user_id": user_id,
        "is_online": string_of_bool(is_online)
      },
      timestamp: get_current_time_unix(),
      sender_id: user_id
    }

    broadcast_event(manager, ws_event)
  end

pub fn handle_user_followed(manager: &mut WebSocketManager, follower_id: string, following_id: string, username: string) -> void
  intent "팔로우 알림"
  do
    // 팔로우된 사용자에게 개인 알림
    let ws_event = WebSocketEvent {
      event_type: "user_followed",
      channel: "user:" + following_id,
      data: {
        "follower_id": follower_id,
        "follower_name": username
      },
      timestamp: get_current_time_unix(),
      sender_id: follower_id
    }

    broadcast_to_user(manager, following_id, ws_event)
  end

// ============================================================================
// 활동 피드 (Activity Feed)
// ============================================================================

pub struct ActivityFeedEvent {
  activity_type: string,  // "comment", "like", "follow", "mention"
  actor_id: string,
  actor_name: string,
  target_id: string,
  target_type: string,   // "post", "user", "comment"
  content: string,
  created_at: i64
}

pub fn handle_activity_feed_update(manager: &mut WebSocketManager, activity: ActivityFeedEvent) -> void
  intent "활동 피드에 새 항목 추가 (실시간)"
  do
    let channel = "user:" + activity.target_id

    let ws_event = WebSocketEvent {
      event_type: "activity_feed_update",
      channel: channel,
      data: {
        "activity_type": activity.activity_type,
        "actor_id": activity.actor_id,
        "actor_name": activity.actor_name,
        "target_id": activity.target_id,
        "target_type": activity.target_type,
        "content": activity.content
      },
      timestamp: activity.created_at,
      sender_id: activity.actor_id
    }

    broadcast_to_user(manager, activity.target_id, ws_event)
  end

// ============================================================================
// 알림 (Notifications)
// ============================================================================

pub struct Notification {
  notification_id: string,
  user_id: string,
  title: string,
  message: string,
  notification_type: string,  // "comment_reply", "post_like", "follow"
  related_id: string,          // post_id, user_id, etc
  is_read: bool,
  created_at: i64
}

pub fn handle_notification_received(manager: &mut WebSocketManager, notification: Notification) -> void
  intent "알림 수신 (실시간)"
  do
    let channel = "user:" + notification.user_id

    let ws_event = WebSocketEvent {
      event_type: "notification",
      channel: channel,
      data: {
        "notification_id": notification.notification_id,
        "title": notification.title,
        "message": notification.message,
        "type": notification.notification_type,
        "related_id": notification.related_id,
        "is_read": string_of_bool(notification.is_read)
      },
      timestamp: notification.created_at,
      sender_id: "system"
    }

    broadcast_to_user(manager, notification.user_id, ws_event)
  end

pub fn handle_notifications_batch(manager: &mut WebSocketManager, user_id: string, notifications: array<Notification>) -> void
  intent "여러 알림 일괄 전송"
  do
    for i in 0 to array_length(notifications)
      let notification = notifications[i]
      handle_notification_received(manager, notification)
    end
  end

