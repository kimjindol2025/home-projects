// 협업 기능 (Collaborative Editing)
// ============================================================================

pub struct CollaborationEvent {
  document_id: string,
  user_id: string,
  username: string,
  action: string,        // "cursor_moved", "selection_changed", "text_inserted"
  position: i32,
  content: string,
  color: string          // 사용자별 색상
}

pub fn handle_collaboration_cursor(manager: &mut WebSocketManager, event: CollaborationEvent) -> void
  intent "협업 에디터에서 커서 위치 공유"
  do
    let channel = "doc:" + event.document_id

    let ws_event = WebSocketEvent {
      event_type: "cursor_moved",
      channel: channel,
      data: {
        "user_id": event.user_id,
        "username": event.username,
        "position": string_of_int(event.position),
        "color": event.color
      },
      timestamp: get_current_time_unix(),
      sender_id: event.user_id
    }

    broadcast_event(manager, ws_event)
  end

pub fn handle_collaboration_text_change(manager: &mut WebSocketManager, event: CollaborationEvent) -> void
  intent "협업 에디터에서 텍스트 변경 공유"
  do
    let channel = "doc:" + event.document_id

    let ws_event = WebSocketEvent {
      event_type: "text_changed",
      channel: channel,
      data: {
        "user_id": event.user_id,
        "position": string_of_int(event.position),
        "content": event.content,
        "action": event.action
      },
      timestamp: get_current_time_unix(),
      sender_id: event.user_id
    }

    broadcast_event(manager, ws_event)
  end

