    }

    broadcast_event(manager, ws_event)
  end

// ============================================================================
// 포스트 실시간 이벤트
// ============================================================================

pub struct PostEvent {
  post_id: string,
  title: string,
  content: string,
  author_id: string,
  event_type: string  // "published", "updated", "deleted"
}

pub fn handle_post_published(manager: &mut WebSocketManager, event: PostEvent) -> void
  intent "새 포스트 발행 알림"
  do
    let ws_event = WebSocketEvent {
      event_type: "post_published",
      channel: "global",
      data: {
        "post_id": event.post_id,
        "title": event.title,
        "author_id": event.author_id
      },
      timestamp: get_current_time_unix(),
      sender_id: event.author_id
    }

    broadcast_event(manager, ws_event)

    // 팔로워들에게 개인 알림
    broadcast_to_followers(manager, event.author_id, ws_event)
  end

pub fn handle_post_updated(manager: &mut WebSocketManager, post_id: string, updated_fields: map<string, string>) -> void
  intent "포스트 수정 알림"
  do
