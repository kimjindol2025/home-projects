// ============================================================================
// 댓글 실시간 이벤트
// ============================================================================

pub struct CommentEvent {
  comment_id: string,
  post_id: string,
  content: string,
  author: string,
  author_id: string,
  created_at: i64,
  event_type: string  // "added", "updated", "deleted"
}

pub fn handle_comment_added(manager: &mut WebSocketManager, event: CommentEvent) -> void
  intent "새 댓글 실시간 알림"
  do
    // 포스트 구독자들에게 브로드캐스트
    let channel = "post:" + event.post_id

    let ws_event = WebSocketEvent {
      event_type: "comment_added",
      channel: channel,
      data: {
        "comment_id": event.comment_id,
        "post_id": event.post_id,
        "content": event.content,
        "author": event.author,
        "author_id": event.author_id,
        "created_at": string_of_i64(event.created_at)
      },
      timestamp: get_current_time_unix(),
      sender_id: event.author_id
    }

    broadcast_event(manager, ws_event)

    // 포스트 작성자에게 개인 알림
    let post_author_id = get_post_author(event.post_id)
    broadcast_to_user(manager, post_author_id, ws_event)
  end

pub fn handle_comment_deleted(manager: &mut WebSocketManager, post_id: string, comment_id: string, author_id: string) -> void
  intent "댓글 삭제 실시간 알림"
  do
    let channel = "post:" + post_id

    let ws_event = WebSocketEvent {
      event_type: "comment_deleted",
      channel: channel,
      data: {
        "comment_id": comment_id,
        "post_id": post_id
      },
      timestamp: get_current_time_unix(),
      sender_id: author_id
    }

    broadcast_event(manager, ws_event)
  end

pub fn handle_comment_reactions(manager: &mut WebSocketManager, comment_id: string, post_id: string, user_id: string, reaction: string) -> void
  intent "댓글 반응(이모지) 실시간 업데이트"
  do
