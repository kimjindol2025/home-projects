pub struct NaverOAuthConfig {
  client_id: string,
  client_secret: string,
  redirect_uri: string
}

pub struct NaverUserProfile {
  id: string,
  name: string,
  email: string,
  profile_image: string
}

pub fn create_naver_oauth_config(client_id: string, client_secret: string) -> NaverOAuthConfig
  do
    return NaverOAuthConfig {
      client_id: client_id,
      client_secret: client_secret,
      redirect_uri: "https://253.dclub.kr/auth/naver/callback"
    }
  end

pub fn get_naver_authorization_url(config: NaverOAuthConfig) -> string
  do
    let params = "?" +
      "client_id=" + config.client_id +
      "&redirect_uri=" + config.redirect_uri +
      "&response_type=code"

    return "https://nid.naver.com/oauth2.0/authorize" + params
  end

