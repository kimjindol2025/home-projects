fn handle_http_request(req: HttpRequest) -> HttpResponse {
  intent "HTTP 요청 처리 및 응답 생성 (모니터링 포함)"
  do
    print("📨 Processing: " + req.method + " " + req.path)

    // ✅ 요청 모니터링 기록
    let request_start_time = get_request_start_time()
    error_logger::log_info("HTTP 요청: " + req.method + " " + req.path)

    // 요청 타입에 따라 라우팅
    let response = route_request(req, &mut GLOBAL_DB)

    // ✅ 응답 모니터링 기록
    let request_end_time = get_request_end_time()
    let request_duration_ms = request_end_time - request_start_time
    error_logger::log_info("응답: " + req.method + " " + req.path + " → " + string_of_int(response.status) + " (" + string_of_int(request_duration_ms) + "ms)")

    // ✅ 에러 로그 (5xx 응답)
    if response.status >= 500
      error_logger::log_error("서버 에러 발생: " + req.method + " " + req.path + " (상태: " + string_of_int(response.status) + ")")
    end

    // ✅ 경고 로그 (4xx 응답)
    if response.status >= 400 && response.status < 500
      error_logger::log_warn("클라이언트 에러: " + req.method + " " + req.path + " (상태: " + string_of_int(response.status) + ")")
    end

    return response
  end
}

