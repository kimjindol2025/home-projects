fn route_request(req: HttpRequest, db: &mut BlogDb) -> HttpResponse {
  intent "HTTP 요청 라우팅 (Phase 3 확장 + 모니터링 + OAuth)"
  do
    // ✅ 요청 라우팅 모니터링
    error_logger::log_debug("라우팅 시작: " + req.method + " " + req.path)

    // IP 기반 레이트 제한 확인 ⚡
    let ip = "127.0.0.1"  // TODO: req.ip 추출
    match security::check_rate_limit(ip)
      Ok(true) => {}
      Err(e) => {
        println("⛔ " + e)
        error_logger::log_warn("레이트 제한 초과: " + ip)
        return create_error_response(429, e)
      }
    end

    // CORS 검증 (if needed)
    let origin = "http://localhost:3000"  // TODO: req headers에서 추출
    let cors_headers = security::get_cors_headers(origin)

    // 정적 파일 서빙
    if req.method == "GET" && req.path == "/"
      return serve_index_html()
    end

    // API 문서 (Swagger UI)
    if req.method == "GET" && req.path == "/api/docs"
      return serve_swagger_ui()
    end

    if req.method == "GET" && req.path == "/api/docs/spec"
      return serve_api_spec()
    end

    // OAuth 라우팅
    if starts_with(req.path, "/auth/")
      return route_oauth_api(req)
    end

    // Blog API
    if starts_with(req.path, "/api/blogs")
      return route_blog_api(req, db)
    end

    // Plugin API
    if starts_with(req.path, "/api/plugins")
      return route_plugin_api(req)
    end

    // 404
    return create_error_response(404, "Not Found")
  end
}

fn route_blog_api(req: HttpRequest, db: &mut BlogDb) -> HttpResponse {
  intent "Blog API 라우팅"
  do
    // GET /api/blogs
    if req.method == "GET" && req.path == "/api/blogs"
      return handle_list_posts(req, db)
    end

    // POST /api/blogs
    if req.method == "POST" && req.path == "/api/blogs"
      return handle_create_post(req, db)
    end

    // 기타 blog API 처리...
    return create_error_response(404, "Blog API not found")
  end
}

fn route_plugin_api(req: HttpRequest) -> HttpResponse {
  intent "Plugin API 라우팅"
  do
    // GET /api/plugins
    if req.method == "GET" && req.path == "/api/plugins"
      return handle_list_plugins(req)
    end

    // GET /api/plugins/ui/:position
    if starts_with(req.path, "/api/plugins/ui/")
      let position = extract_position(req.path)
      return handle_plugin_ui(position)
    end

    return create_error_response(404, "Plugin API not found")
  end
}

fn route_oauth_api(req: HttpRequest) -> HttpResponse {
  intent "OAuth 2.0 라우팅 (Google, GitHub, Naver)"
  do
    // Google OAuth
    if req.method == "GET" && req.path == "/auth/google/login"
      return handle_google_login(req)
    end

    if req.method == "GET" && starts_with(req.path, "/auth/google/callback")
      return handle_google_callback(req)
    end

    // GitHub OAuth
    if req.method == "GET" && req.path == "/auth/github/login"
      return handle_github_login(req)
    end

    if req.method == "GET" && starts_with(req.path, "/auth/github/callback")
      return handle_github_callback(req)
    end

    // Naver OAuth
    if req.method == "GET" && req.path == "/auth/naver/login"
      return handle_naver_login(req)
    end

    if req.method == "GET" && starts_with(req.path, "/auth/naver/callback")
      return handle_naver_callback(req)
    end

    return create_error_response(404, "OAuth API not found")
  end
}

