// ============================================================================
// Subscription 관리
// ============================================================================

pub fn unsubscribe(manager: &mut SubscriptionManager, subscription_id: string) -> Result<void, string>
  intent "구독 해제"
  do
    match manager.subscriptions[subscription_id]
      subscription => {
        // 채널 리스너에서 제거
        for channel in manager.event_listeners.keys()
          let listeners = manager.event_listeners[channel]
          remove_element(&mut listeners, subscription_id)
        end

        // 구독 삭제
        delete_subscription(&mut manager.subscriptions, subscription_id)
        manager.active_count = manager.active_count - 1

        return Ok(())
      }
      _ => Err("Subscription not found")
    end
  end

pub fn get_subscription_count(manager: SubscriptionManager) -> i32
  intent "활성 구독 수 조회"
  do
