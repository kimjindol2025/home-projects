pub fn batch_subscription_events(manager: &mut SubscriptionManager, channel: string, events: array<string>) -> void
  intent "배치로 여러 이벤트 브로드캐스트"
  do
    let subscribers = get_channel_subscribers(manager, channel)

    for i in 0 to array_length(subscribers)
      let subscription_id = subscribers[i]

      // 배치 이벤트 생성
      let batch_data = "{\"batch\": ["

      for j in 0 to array_length(events)
        batch_data = batch_data + events[j] + ","
      end

      batch_data = batch_data + "]}"

      broadcast_subscription_event(manager, channel, batch_data)
    end
  end

