  end

pub fn get_channel_subscribers(manager: SubscriptionManager, channel: string) -> array<string>
  intent "채널의 구독자 목록 조회"
  do
    match manager.event_listeners[channel]
      subscribers => subscribers
      _ => []
    end
  end

// ============================================================================
// Subscription Event 브로드캐스팅
// ============================================================================

pub fn broadcast_subscription_event(manager: &mut SubscriptionManager, channel: string, data: string) -> void
  intent "채널의 모든 구독자에게 이벤트 브로드캐스트"
  do
    let subscribers = get_channel_subscribers(manager, channel)

    for i in 0 to array_length(subscribers)
      let subscription_id = subscribers[i]

      match manager.subscriptions[subscription_id]
        subscription => {
          if subscription.is_active
            let event = SubscriptionEvent {
              subscription_id: subscription_id,
              data: data,
              errors: [],
              timestamp: get_current_time_unix()
            }

            // TODO: WebSocket을 통해 클라이언트에게 전송
            send_subscription_event(subscription_id, event)
          end
        }
        _ => {}
      end
    end
  end

