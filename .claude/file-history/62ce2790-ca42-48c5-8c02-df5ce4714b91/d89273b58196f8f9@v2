fn index_of(s: string, pattern: string) -> i32
  intent "첫 인덱스"
  do
    let len = length(s)
    let plen = length(pattern)
    for i = 0; i < len - plen + 1; i++
      if substring(s, i, i + plen) == pattern return i end
    end
    return -1
  end

fn last_index_of(s: string, pattern: string) -> i32
  intent "마지막 인덱스"
  do
    let index = -1
    let len = length(s)
    let plen = length(pattern)
    for i = 0; i < len - plen + 1; i++
      if substring(s, i, i + plen) == pattern index = i end
    end
    return index
  end

