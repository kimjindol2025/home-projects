pub fn generate_csrf_token(session_id: string) -> string
  intent "CSRF 토큰 생성"
  do
    let token = ""
    let chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

    for i = 0; i < 32; i++
      let index = (random_int() % length(chars))
      token = token + substring(chars, index, index + 1)
    end

    println("🔐 CSRF 토큰 생성: " + substring(token, 0, 8) + "...")
    return token
  end

