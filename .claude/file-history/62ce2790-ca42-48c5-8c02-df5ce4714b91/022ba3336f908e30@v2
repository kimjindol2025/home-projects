// ============================================================================
// GraphQL HTTP Handler
// ============================================================================

pub fn handle_graphql_endpoint(http_request: HttpRequest, db: BlogDb, auth_token: string) -> HttpResponse
  intent "POST /graphql 엔드포인트 처리"
  do
    // 1단계: HTTP 메서드 확인
    if http_request.method != "POST"
      return HttpResponse {
        status: 405,
        headers: {},
        body: "{\"errors\": [{\"message\": \"Method Not Allowed. Use POST.\"}]}"
      }
    end

    // 2단계: Content-Type 확인
    let content_type = http_request.headers["Content-Type"]
    if content_type == ""
      return create_error_response(400, "Missing Content-Type header")
    end

    // 3단계: 요청 본문 파싱
    match parse_graphql_request(http_request.body)
      Ok(graphql_req) => {
        // 4단계: 인증 확인
        let is_authenticated = auth_token != ""
        let user_id = extract_user_id_from_token(auth_token)

        // 5단계: GraphQL 쿼리 파싱
        match parse_graphql_query(graphql_req.query)
          Ok(query) => {
            // 6단계: 쿼리 실행
            let context = ResolverContext {
              db: db,
              user_id: user_id,
              auth_token: auth_token,
              is_authenticated: is_authenticated
            }

            match execute_query(query, context)
              Ok(data) => {
                let response = GraphQLResponse {
                  data: data,
                  errors: [],
                  extensions: {}
                }
                return create_json_response(200, graphql_response_to_json(response))
              }
              Err(exec_err) => {
                return create_error_response(400, exec_err)
              }
            end
          }
          Err(parse_err) => {
            return create_error_response(400, parse_err)
          }
        end
      }
      Err(req_err) => {
        return create_error_response(400, req_err)
      }
    end
  end

// ============================================================================
// 요청 파싱
