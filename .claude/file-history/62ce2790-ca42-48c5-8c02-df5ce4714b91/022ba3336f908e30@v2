// ============================================================================
// 응답 생성 헬퍼
// ============================================================================

fn create_json_response(status: i32, body: string) -> HttpResponse
  intent "JSON 응답 생성"
  do
    let response = HttpResponse {
      status: status,
      headers: {
        "Content-Type": "application/json",
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization"
      },
      body: body
    }

    return response
  end

fn create_error_response(status: i32, message: string) -> HttpResponse
  intent "에러 응답 생성"
  do
    let error_body = "{\"errors\": [{\"message\": \"" + message + "\"}]}"

    return create_json_response(status, error_body)
  end

