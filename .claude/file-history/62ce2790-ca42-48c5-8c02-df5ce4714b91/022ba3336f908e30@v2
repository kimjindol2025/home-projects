    // TODO: JSON 파싱
    // 현재는 간단한 구현

    let graphql_req = GraphQLRequest {
      query: "",
      operation_name: "",
      variables: {}
    }

    // 쿼리 필드 추출 (임시)
    graphql_req.query = extract_json_field(body, "query")

    if graphql_req.query == ""
      return Err("Missing 'query' field in request")
    end

    graphql_req.operation_name = extract_json_field(body, "operationName")
