// ============================================================================
// Introspection 엔드포인트
// ============================================================================

pub fn handle_graphql_introspection(schema: GraphQLSchema) -> HttpResponse
  intent "GraphQL 스키마 인트로스펙션 반환"
  do
    match get_schema_introspection(schema)
      Ok(introspection_json) => {
        return create_json_response(200, introspection_json)
      }
      Err(e) => {
        return create_error_response(500, e)
      }
    end
  end

