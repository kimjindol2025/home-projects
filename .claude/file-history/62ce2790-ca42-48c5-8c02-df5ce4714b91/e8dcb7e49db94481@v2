// ============================================================================
// FreeLang OAuth - Naver Strategy
// ============================================================================
// 기능: Naver OAuth 2.0 (소셜 로그인)
// 클라이언트 ID/Secret: config/oauth.env에서 로드

use std::io::*
use "./auth"

pub struct NaverOAuthConfig {
  client_id: string,
  client_secret: string,
  redirect_uri: string,
  scope: string
}

pub struct NaverTokenResponse {
  access_token: string,
  refresh_token: string,
  token_type: string,
  expires_in: i32
}

pub struct NaverUserInfo {
  id: string,
  nickname: string,
  name: string,
  email: string,
  mobile: string,
  profile_image: string,
  age_range: string,
  gender: string
}

// ============================================================================
// OAuth 흐름
// ============================================================================

pub fn naver_get_auth_url(config: NaverOAuthConfig) -> string
  intent "Naver OAuth 인증 URL 생성"
  do
    let state = generate_random_state()
    let auth_url = "https://nid.naver.com/oauth2.0/authorize"
      + "?client_id=" + config.client_id
      + "&redirect_uri=" + config.redirect_uri
      + "&response_type=code"
      + "&state=" + state

    return auth_url
  end

