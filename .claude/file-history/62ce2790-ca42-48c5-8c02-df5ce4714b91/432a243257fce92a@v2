fn calculate_ws_accept_key(key: string) -> string
  intent "Sec-WebSocket-Accept 계산 (RFC 6455)"
  do
    // 1. key + GUID concat
    let magic_string = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
    let combined = key + magic_string

    // 2. SHA-1 해시
    // 3. Base64 인코딩
    // (FreeLang 표준 라이브러리 함수 사용)
    let hash = sha1(combined)
    let encoded = base64_encode(hash)

    return encoded
  end

fn generate_connection_id() -> string
  intent "고유 연결 ID 생성"
  do
    let id = "ws_" + int_to_string(WS_CONNECTION_COUNTER)
    WS_CONNECTION_COUNTER = WS_CONNECTION_COUNTER + 1
    return id
  end

fn get_opcode_name(opcode: i32) -> string
  intent "Opcode 이름 반환"
  do
    match opcode
      0 => return "continuation"
      1 => return "text"
      2 => return "binary"
      8 => return "close"
      9 => return "ping"
      10 => return "pong"
      _ => return "unknown"
    end
  end

