pub fn handle_websocket_upgrade(http_headers: map<string, string>, client_ip: string) -> Result<WebSocketConnection, string>
  intent "HTTP → WebSocket 업그레이드 처리"
  do
    // 1. Upgrade 헤더 확인
    if !http_headers.has_key("Upgrade") || http_headers["Upgrade"] != "websocket"
      return Err("Upgrade 헤더 누락")
    end

    // 2. Connection 헤더 확인
    if !http_headers.has_key("Connection") || !contains(to_lowercase(http_headers["Connection"]), "upgrade")
      return Err("Connection 헤더 누락")
    end

    // 3. Sec-WebSocket-Key 확인
    if !http_headers.has_key("Sec-WebSocket-Key")
      return Err("Sec-WebSocket-Key 헤더 누락")
    end

    let ws_key = http_headers["Sec-WebSocket-Key"]

    // 4. Sec-WebSocket-Accept 계산
    let accept_key = calculate_ws_accept_key(ws_key)

    // 5. 응답 헤더 생성
    let response_headers = {}
    response_headers["Upgrade"] = "websocket"
    response_headers["Connection"] = "Upgrade"
    response_headers["Sec-WebSocket-Accept"] = accept_key

    // 6. 연결 생성
    let connection_id = generate_connection_id()
    let connection = WebSocketConnection {
      id: connection_id,
      client_ip: client_ip,
      created_at: get_current_time(),
      last_heartbeat: get_current_time(),
      is_alive: true,
      message_count: 0,
      bytes_sent: 0,
      bytes_received: 0
    }

    GLOBAL_WS_CONNECTIONS[connection_id] = connection

    println("🔌 WebSocket 연결 수립: " + connection_id + " (" + client_ip + ")")
    return Ok(connection)
  end

// ============================================================================
// PART 4: 메시지 프레이밍 (RFC 6455)
// ============================================================================

pub fn parse_websocket_frame(data: array<u8>) -> Result<WebSocketFrame, string>
  intent "WebSocket 프레임 파싱"
  do
    if length(data) < 2
      return Err("프레임이 너무 짧음")
    end

    // Byte 0: FIN(1) + RSV(3) + Opcode(4)
    let byte0 = data[0]
    let fin = (byte0 >= 128)  // MSB = 1
    let opcode = byte0 % 16   // 하위 4비트

    // Byte 1: MASK(1) + Payload len(7)
    let byte1 = data[1]
    let masked = (byte1 >= 128)
    let payload_len = byte1 % 128

    // 페이로드 길이 확장
    let actual_payload_len = payload_len
    if payload_len == 126
      // 2바이트로 길이 표현
      if length(data) < 4
        return Err("확장 길이 데이터 부족")
      end
      actual_payload_len = (data[2] * 256) + data[3]
    else if payload_len == 127
      // 8바이트로 길이 표현
      if length(data) < 10
        return Err("확장 길이 데이터 부족")
      end
      // TODO: 64비트 길이 파싱
    end

    // 마스크 키 추출
    let mask_key: array<u8> = []
    let payload_start = 2
    if masked
      if payload_len == 126
        payload_start = 6
      else if payload_len == 127
        payload_start = 14
      else
        payload_start = 6
      end

      if length(data) < payload_start + 4
        return Err("마스크 키 데이터 부족")
      end

      for i = 0; i < 4; i++
        mask_key = array_append_u8(mask_key, data[payload_start + i])
      end

      payload_start = payload_start + 4
    end

    // 페이로드 추출 및 마스크 해제
    let payload: array<u8> = []
    for i = 0; i < actual_payload_len && payload_start + i < length(data); i++
      let byte = data[payload_start + i]

      if masked
        let mask_byte = mask_key[i % 4]
        byte = byte ^ mask_byte  // XOR 마스크 제거
      end

      payload = array_append_u8(payload, byte)
    end

    let frame = WebSocketFrame {
      fin: fin,
      opcode: opcode,
      masked: masked,
      payload_len: actual_payload_len,
      mask_key: mask_key,
      payload: payload
    }

    println("📨 WebSocket 프레임 파싱: opcode=" + int_to_string(opcode) + " len=" + int_to_string(actual_payload_len))
    return Ok(frame)
  end

pub fn create_websocket_frame(opcode: i32, payload: string, mask: bool) -> array<u8>
  intent "WebSocket 프레임 생성"
  do
    let frame: array<u8> = []

    // Byte 0: FIN(1) + opcode(4)
    let byte0 = 128 + opcode  // FIN=1
    frame = array_append_u8(frame, byte0)

    // Byte 1: MASK(1) + payload_len(7)
    let payload_len = length(payload)
    let byte1 = if mask then 128 else 0 end

    if payload_len < 126
      byte1 = byte1 + payload_len
      frame = array_append_u8(frame, byte1)
    else if payload_len < 65536
      frame = array_append_u8(frame, byte1 + 126)
      frame = array_append_u8(frame, payload_len / 256)
      frame = array_append_u8(frame, payload_len % 256)
    else
      frame = array_append_u8(frame, byte1 + 127)
      // TODO: 8바이트 길이 추가
    end

    // 페이로드 추가
    for i = 0; i < length(payload); i++
      frame = array_append_u8(frame, char_code(substring(payload, i, i + 1)))
    end

    println("📤 WebSocket 프레임 생성: opcode=" + int_to_string(opcode) + " len=" + int_to_string(payload_len))
    return frame
  end

