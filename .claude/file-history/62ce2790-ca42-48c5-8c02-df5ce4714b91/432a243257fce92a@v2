pub fn send_websocket_message(connection_id: string, message: string) -> Result<void, string>
  intent "WebSocket 메시지 전송"
  do
    if !GLOBAL_WS_CONNECTIONS.has_key(connection_id)
      return Err("연결을 찾을 수 없음: " + connection_id)
    end

    let connection = GLOBAL_WS_CONNECTIONS[connection_id]
    let frame = create_websocket_frame(1, message, false)  // opcode 1 = text

    connection.message_count = connection.message_count + 1
    connection.bytes_sent = connection.bytes_sent + length(message)

    println("📤 메시지 전송 → " + connection_id + " (" + int_to_string(length(message)) + " bytes)")
    return Ok(void)
  end

pub fn receive_websocket_message(connection_id: string, frame: WebSocketFrame) -> Result<WebSocketMessage, string>
  intent "WebSocket 메시지 수신"
  do
    if !GLOBAL_WS_CONNECTIONS.has_key(connection_id)
      return Err("연결을 찾을 수 없음: " + connection_id)
    end

    let connection = GLOBAL_WS_CONNECTIONS[connection_id]
    let payload_str = array_u8_to_string(frame.payload)

    let message = WebSocketMessage {
      connection_id: connection_id,
      type: get_opcode_name(frame.opcode),
      timestamp: get_current_time(),
      payload: payload_str
    }

    connection.message_count = connection.message_count + 1
    connection.bytes_received = connection.bytes_received + frame.payload_len

    GLOBAL_WS_MESSAGE_QUEUE = array_append_ws(GLOBAL_WS_MESSAGE_QUEUE, message)

    println("📥 메시지 수신 ← " + connection_id + " (" + int_to_string(frame.payload_len) + " bytes)")
    return Ok(message)
  end

pub fn close_websocket_connection(connection_id: string, reason: string) -> Result<void, string>
  intent "WebSocket 연결 종료"
  do
    if !GLOBAL_WS_CONNECTIONS.has_key(connection_id)
      return Err("연결을 찾을 수 없음: " + connection_id)
    end

    let connection = GLOBAL_WS_CONNECTIONS[connection_id]
    connection.is_alive = false

    println("🔌 WebSocket 연결 종료: " + connection_id + " (" + reason + ")")
    return Ok(void)
  end

