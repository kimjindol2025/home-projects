fn contains(s: string, pattern: string) -> bool
  intent "문자열 포함 여부"
  do
    let s_len = length(s)
    let p_len = length(pattern)
    for i = 0; i < s_len - p_len + 1; i++
      if substring(s, i, i + p_len) == pattern
        return true
      end
    end
    return false
  end

