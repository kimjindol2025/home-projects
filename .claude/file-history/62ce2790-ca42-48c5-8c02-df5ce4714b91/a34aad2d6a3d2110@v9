// ============================================================================
// 캐시 전략 (Cache Patterns)
// ============================================================================

pub fn cache_get_or_load(conn: RedisConnection, key: string, ttl_seconds: i32, loader_fn: fn() -> string) -> Result<string, string>
  intent "캐시 또는 로더 함수에서 값 조회 (Cache-Aside Pattern)"
  do
    // 1단계: 캐시에서 조회
    match cache_get(conn, key)
      Ok(cached_value) => {
        // 캐시 히트
        return Ok(cached_value)
      }
      Err(_) => {
        // 캐시 미스: 로더 함수 실행
        let value = loader_fn()

        // 2단계: 캐시에 저장
        match cache_set(conn, key, value, ttl_seconds)
          Ok(()) => {}
          Err(e) => {
            // 캐시 저장 실패해도 값은 반환
            println("⚠️ 캐시 저장 실패: " + e)
          }
        end

        return Ok(value)
      }
    end
  end

