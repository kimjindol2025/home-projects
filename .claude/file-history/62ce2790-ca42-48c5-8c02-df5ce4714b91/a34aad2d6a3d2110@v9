pub fn cache_invalidate_related(conn: RedisConnection, prefix: string) -> Result<i32, string>
  intent "관련 캐시 모두 무효화 (prefix 기반)"
  do
    // 예: "post:*" → 모든 포스트 캐시 삭제
    let pattern = prefix + "*"
    return cache_delete_pattern(conn, pattern)
  end

