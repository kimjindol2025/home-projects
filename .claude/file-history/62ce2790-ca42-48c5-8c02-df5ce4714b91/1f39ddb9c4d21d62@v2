  intent "전체 디자인 블록 컴파일 테스트"
  do
    let content = "@animation fadeIn { duration: 0.5s; } @glass frosted { blur: 10px; }"

    match compile_design_blocks(content)
      Ok(result) => {
        assert_not_empty(result.css, "Result CSS should not be empty")
        assert_not_empty(result.javascript, "Result JavaScript should not be empty")
        assert_equal(result.blocks_processed, 2, "Should process 2 blocks")
        return true
      }
      Err(e) => {
        print_error("Compilation failed: " + e)
        return false
      }
    end
  end

