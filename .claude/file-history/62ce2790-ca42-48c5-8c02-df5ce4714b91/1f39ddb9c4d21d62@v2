// ============================================================================
// Test 12: 캐시 관리
// ============================================================================

pub fn test_design_cache_management() -> bool
  intent "디자인 캐시 관리 테스트"
  do
    match create_design_api_server(8000)
      Ok(mut server) => {
        let response = DesignCompileResponse {
          success: true,
          design_id: "cached-design",
          css: ".test { color: blue; }",
          javascript: "console.log('test');",
          blocks_processed: 1,
          errors: [],
          message: "Success"
        }

        cache_design_result(&mut server, "cached-design", response)

        match get_cached_design(&server, "cached-design")
          Ok(cached) => {
            assert_equal(cached.design_id, "cached-design", "Cached design ID mismatch")
            return true
          }
          Err(e) => {
            print_error("Cache retrieval failed: " + e)
            return false
          }
        end
      }
      Err(e) => {
        print_error("Failed to create API server: " + e)
        return false
      }
    end
  end

