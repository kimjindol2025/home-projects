// ============================================================================
// Test Helpers
// ============================================================================

fn assert_equal(actual: string, expected: string, message: string) -> void
  do
    if actual != expected
      print_error(message + " (expected: " + expected + ", got: " + actual + ")")
    end
  end

fn assert_not_empty(value: string, message: string) -> void
  do
    if string_empty(value)
      print_error(message)
    end
  end

fn assert_contains(value: string, substring: string, message: string) -> void
  do
    if !string_contains(value, substring)
      print_error(message + " (not found: " + substring + ")")
    end
  end

fn assert_greater_than(value: i32, threshold: i32, message: string) -> void
  do
    if value <= threshold
      print_error(message + " (value: " + string_of_int(value) + ")")
    end
  end

fn assert_true(value: bool, message: string) -> void
  do
    if !value
      print_error(message)
    end
  end

fn print_error(message: string) -> void
  do
    println("ERROR: " + message)
  end

