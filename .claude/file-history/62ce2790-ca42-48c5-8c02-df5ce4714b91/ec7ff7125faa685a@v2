fn test_ws_upgrade() -> bool {
  intent "WebSocket 업그레이드 핸드셰이크"
  do
    println("✅ TEST 1: WebSocket Upgrade")
    let headers = {}
    headers["Upgrade"] = "websocket"
    headers["Connection"] = "Upgrade"
    headers["Sec-WebSocket-Key"] = "dGhlIHNhbXBsZSBub25jZQ=="
    match websocket::handle_websocket_upgrade(headers, "127.0.0.1")
      Ok(conn) => return true
      Err(_) => return false
    end
  end
}

fn test_ws_frame_parsing() -> bool {
  intent "WebSocket 프레임 파싱"
  do
    println("✅ TEST 2: WebSocket Frame Parsing")
    let data: array<u8> = [129, 5, 72, 101, 108, 108, 111]  // "Hello" text frame
    match websocket::parse_websocket_frame(data)
      Ok(frame) => return true
      Err(_) => return false
    end
  end
}

