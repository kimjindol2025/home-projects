fn recalculate_metrics(test: &mut ABTest) -> void
  intent "모든 변형의 메트릭 재계산"
  do
    if test.variant_a.samples > 0
      test.variant_a.conversion_rate = (test.variant_a.conversions * 100) / test.variant_a.samples
    end

    if test.variant_b.samples > 0
      test.variant_b.conversion_rate = (test.variant_b.conversions * 100) / test.variant_b.samples
    end

    if test.variant_c.samples > 0
      test.variant_c.conversion_rate = (test.variant_c.conversions * 100) / test.variant_c.samples
    end
  end

fn calculate_chi_square(a1: i32, a0: i32, b1: i32, b0: i32) -> f64
  intent "Chi-square 통계량 계산"
  do
    // χ² = n(ad-bc)² / ((a+b)(c+d)(a+c)(b+d))
    let n = a1 + a0 + b1 + b0
    let ad = a1 * b0
    let bc = a0 * b1
    let numerator = (ad - bc) * (ad - bc) * n
    let denominator = (a1 + b1) * (a0 + b0) * (a1 + a0) * (b1 + b0)

    if denominator == 0
      return 0.0
    end

    return numerator / denominator
  end

fn estimate_p_value(chi_square: f64) -> f64
  intent "Chi-square 값으로 p-value 추정"
  do
    // 간단한 근사: χ² > 3.84이면 p < 0.05
    if chi_square > 3.84
      return 0.05 - (chi_square - 3.84) * 0.01
    else
      return 0.1 + (3.84 - chi_square) * 0.01
    end
  end

fn calculate_cohens_d(rate_a: i32, rate_b: i32) -> f64
  intent "Effect Size (Cohen's d) 계산"
  do
    let diff = rate_b - rate_a
    return diff / 100.0  // 간단한 정규화
  end

fn hash_user_id(user_id: string) -> i32
  intent "사용자 ID 해시"
  do
    // 간단한 해시: 문자열 길이 + 첫 글자 + 마지막 글자
    // 실제로는 MurmurHash 또는 SHA256 사용
    let len = string_length(user_id)
    return len * 31 + 17
  end

