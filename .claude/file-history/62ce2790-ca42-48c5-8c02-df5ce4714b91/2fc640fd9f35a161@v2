use std::io::*

// ============================================================================
// A/B Test 구조
// ============================================================================

pub struct ABTest {
  test_id: string,
  name: string,
  description: string,
  hypothesis: string,
  status: string,  // DRAFT, RUNNING, PAUSED, COMPLETED
  variant_a: Variant,
  variant_b: Variant,
  variant_c: Variant,  // 옵션
  start_time: i64,
  end_time: i64,
  created_by: string,
  created_at: i64
}

pub struct Variant {
  variant_id: string,
  name: string,  // "Control", "Treatment A", "Treatment B"
  description: string,
  traffic_allocation: i32,  // 0-100%
  samples: i32,
  conversions: i32,
  conversion_rate: f64,
  revenue: f64,
  avg_session_duration: f64
}

pub struct TestResult {
  test_id: string,
  winner: string,  // "A" | "B" | "C" | "INCONCLUSIVE"
  confidence: f64,  // 0-1 (95% 신뢰도 기준)
  effect_size: f64,  // Cohen's d
  p_value: f64,
  statistical_significance: bool,
  recommendation: string
}

pub struct Experiment {
  experiment_id: string,
  user_id: string,
  test_id: string,
  assigned_variant: string,  // A | B | C
  timestamp: i64,
  actions: array<string>,  // 사용자 행동 기록
  conversion: bool,
  revenue: f64
}

// ============================================================================
// Test 관리
// ============================================================================

pub fn create_ab_test(name: string, hypothesis: string, variant_a_name: string, variant_b_name: string) -> Result<ABTest, string>
  intent "새로운 A/B 테스트 생성"
  do
    let test_id = generate_uuid()

    let test = ABTest {
      test_id: test_id,
      name: name,
      description: "",
      hypothesis: hypothesis,
      status: "DRAFT",
      variant_a: Variant {
        variant_id: test_id + "_a",
        name: variant_a_name,
        description: "",
        traffic_allocation: 50,
        samples: 0,
        conversions: 0,
        conversion_rate: 0.0,
        revenue: 0.0,
        avg_session_duration: 0.0
      },
      variant_b: Variant {
        variant_id: test_id + "_b",
        name: variant_b_name,
        description: "",
        traffic_allocation: 50,
        samples: 0,
        conversions: 0,
        conversion_rate: 0.0,
        revenue: 0.0,
        avg_session_duration: 0.0
      },
      variant_c: Variant {
        variant_id: test_id + "_c",
        name: "Unused",
        description: "",
        traffic_allocation: 0,
        samples: 0,
        conversions: 0,
        conversion_rate: 0.0,
        revenue: 0.0,
        avg_session_duration: 0.0
      },
      start_time: 0,
      end_time: 0,
      created_by: "",
      created_at: get_current_time_unix()
    }

    return Ok(test)
  end

pub fn start_ab_test(test: &mut ABTest) -> Result<void, string>
  intent "테스트 시작"
  do
    if test.status != "DRAFT"
      return Err("Test is not in DRAFT status")
    end

    test.status = "RUNNING"
    test.start_time = get_current_time_unix()

    return Ok(())
  end

pub fn pause_ab_test(test: &mut ABTest) -> Result<void, string>
  intent "테스트 일시 중지"
  do
    if test.status != "RUNNING"
      return Err("Test is not running")
    end

    test.status = "PAUSED"

    return Ok(())
  end

pub fn complete_ab_test(test: &mut ABTest) -> Result<TestResult, string>
  intent "테스트 완료 및 결과 분석"
  do
    if test.status != "RUNNING"
      return Err("Test is not running")
    end

    test.status = "COMPLETED"
    test.end_time = get_current_time_unix()

    // 통계 분석
    let result = analyze_test_result(test)

    return Ok(result)
  end

// ============================================================================
// 사용자 할당 (트래픽 분산)
// ============================================================================

pub fn assign_user_to_variant(test: ABTest, user_id: string) -> Result<string, string>
  intent "사용자를 테스트 변형에 할당"
  do
    // Consistent hashing으로 동일 사용자는 항상 같은 변형 할당
    let hash = hash_user_id(user_id)
    let allocation = hash % 100

    if allocation < test.variant_a.traffic_allocation
      return Ok("A")
    else if allocation < (test.variant_a.traffic_allocation + test.variant_b.traffic_allocation)
      return Ok("B")
    else
      return Ok("C")
    end
  end

pub fn record_experiment(test: &mut ABTest, user_id: string, variant: string, action: string, conversion: bool, revenue: f64) -> Result<void, string>
  intent "실험 결과 기록"
  do
    // 해당 변형의 샘플 증가
    match variant
      "A" => {
        test.variant_a.samples = test.variant_a.samples + 1
        if conversion
          test.variant_a.conversions = test.variant_a.conversions + 1
          test.variant_a.revenue = test.variant_a.revenue + revenue
        end
      }
      "B" => {
        test.variant_b.samples = test.variant_b.samples + 1
        if conversion
          test.variant_b.conversions = test.variant_b.conversions + 1
          test.variant_b.revenue = test.variant_b.revenue + revenue
        end
      }
      "C" => {
        test.variant_c.samples = test.variant_c.samples + 1
        if conversion
          test.variant_c.conversions = test.variant_c.conversions + 1
          test.variant_c.revenue = test.variant_c.revenue + revenue
        end
      }
      _ => {}
    end

    // 전환율 재계산
    recalculate_metrics(&mut test)

    return Ok(())
  end

// ============================================================================
// 통계 분석 (Statistical Tests)
// ============================================================================

pub fn analyze_test_result(test: ABTest) -> TestResult
  intent "A/B 테스트 결과 분석 (Chi-square test)"
  do
    let result = TestResult {
      test_id: test.test_id,
      winner: "INCONCLUSIVE",
      confidence: 0.0,
      effect_size: 0.0,
      p_value: 1.0,
      statistical_significance: false,
      recommendation: "Continue running test"
    }

    // 기본 전환율 계산
    let rate_a = if test.variant_a.samples > 0
      (test.variant_a.conversions * 100) / test.variant_a.samples
    else
      0
    end

    let rate_b = if test.variant_b.samples > 0
      (test.variant_b.conversions * 100) / test.variant_b.samples
    else
      0
    end

    // 차이 계산
    let difference = rate_b - rate_a

    // Chi-square 유사 계산 (간단한 버전)
    let chi_square = calculate_chi_square(
      test.variant_a.conversions,
      test.variant_a.samples - test.variant_a.conversions,
      test.variant_b.conversions,
      test.variant_b.samples - test.variant_b.conversions
    )

    // p-value 추정 (실제 구현에서는 테이블 조회)
    let p_value = estimate_p_value(chi_square)

    // 95% 신뢰도 기준
    if p_value < 0.05
      result.statistical_significance = true
      result.p_value = p_value
      result.confidence = 1.0 - p_value

      if difference > 0.0
        result.winner = "B"
        result.recommendation = "Variant B shows statistically significant improvement. Deploy B as new control."
      else
        result.winner = "A"
        result.recommendation = "Variant A maintains baseline. Continue with A."
      end
    else
      result.recommendation = "No statistical significance. Increase sample size or run longer."
    end

    // Cohen's d (Effect Size)
    result.effect_size = calculate_cohens_d(rate_a, rate_b)

    return result
  end

// ============================================================================
// 다변량 테스트 (Multivariate Testing)
// ============================================================================

pub struct MultivariateTest {
  test_id: string,
  name: string,
  variables: array<string>,  // ["headline", "button_color", "layout"]
  variants_count: i32,  // 변수 개수의 곱
  results: map<string, i32>  // variant_combination -> conversions
}

pub fn create_multivariate_test(name: string, variables: array<string>) -> Result<MultivariateTest, string>
  intent "다변량 테스트 생성"
  do
    // 각 변수는 A/B 2가지 옵션 = 2^n 조합
    let variants_count = 1
    for i in 0 to array_length(variables)
      variants_count = variants_count * 2
    end

    let test = MultivariateTest {
      test_id: generate_uuid(),
      name: name,
      variables: variables,
      variants_count: variants_count,
      results: {}
    }

    return Ok(test)
  end

pub fn get_multivariate_assignment(test: MultivariateTest, user_id: string) -> map<string, string>
  intent "다변량 테스트 사용자 할당"
  do
    let assignment = {}
    let hash = hash_user_id(user_id)

    for i in 0 to array_length(test.variables)
      let variable = test.variables[i]
      let bit = (hash >> i) & 1

      if bit == 0
        assignment[variable] = "Control"
      else
        assignment[variable] = "Treatment"
      end
    end

    return assignment
  end

// ============================================================================
// 추천 및 자동 최적화
// ============================================================================

pub fn should_auto_deploy_winner(result: TestResult) -> bool
  intent "자동 배포 조건 확인"
  do
    // 95% 신뢰도 이상 & 효과크기 0.15 이상
    return result.statistical_significance &&
           result.confidence > 0.95 &&
           result.effect_size > 0.15
  end

pub fn calculate_test_duration(initial_sample_size: i32, baseline_conversion: f64, target_improvement: f64) -> i32
  intent "필요한 테스트 기간 추정 (초 단위)"
  do
    // 표본 크기 계산: Power analysis
    // n = 2 * (z_alpha + z_beta)^2 * p(1-p) / (effect_size)^2
    // 간단한 추정: 기본값 4,000 이상 샘플

    if initial_sample_size < 4000
      return 86400  // 1일 (86,400초)
    else if initial_sample_size < 10000
      return 259200  // 3일
    else
      return 604800  // 1주
    end
  end

pub fn estimate_revenue_impact(current_revenue: f64, conversion_improvement: f64, users_per_day: i32) -> f64
  intent "수익 영향 추정 (월간)"
  do
    let daily_impact = (current_revenue / 100.0) * conversion_improvement * users_per_day
    let monthly_impact = daily_impact * 30.0

    return monthly_impact
  end

