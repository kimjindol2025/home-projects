.sidebar {
  width: 260px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  display: flex;
  flex-direction: column;
  box-shadow: 2px 0 8px rgba(0, 0, 0, 0.1);
}

.sidebar-header {
  padding: 24px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
}

.sidebar-header h2 {
  font-size: 24px;
  font-weight: 700;
  margin-bottom: 4px;
}

.sidebar-header p {
  font-size: 13px;
  opacity: 0.9;
}

.sidebar-nav {
  flex: 1;
  padding: 16px 0;
  overflow-y: auto;
}

.nav-item {
  display: flex;
  align-items: center;
  padding: 12px 20px;
  color: rgba(255, 255, 255, 0.8);
  text-decoration: none;
  transition: all 0.3s ease;
  border-left: 4px solid transparent;
}

.nav-item:hover {
  background: rgba(255, 255, 255, 0.1);
  color: white;
}

.nav-item.active {
  background: rgba(255, 255, 255, 0.15);
  color: white;
  border-left-color: #fbbf24;
}

.nav-icon {
  font-size: 18px;
  margin-right: 12px;
  display: flex;
  align-items: center;
}

.nav-label {
  font-size: 14px;
  font-weight: 500;
}

.sidebar-footer {
  padding: 16px 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
  text-align: center;
}

.version {
  font-size: 12px;
  opacity: 0.7;
  margin-bottom: 8px;
}

.blog-link {
  display: inline-block;
  color: #fbbf24;
  text-decoration: none;
  font-size: 13px;
  transition: color 0.3s;
}

.blog-link:hover {
  color: #fcd34d;
}

@media (max-width: 768px) {
  .sidebar {
    width: 200px;
  }

  .sidebar-header {
    padding: 16px;
  }

  .nav-item {
    padding: 10px 16px;
  }

  .nav-label {
    display: none;
  }
}
