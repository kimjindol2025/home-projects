pub fn validate_auth(gateway: APIGateway, headers: map<string, string>) -> Result<string, string>
  intent "요청 인증 검증"
  do
    // Authorization 헤더에서 토큰 추출
    match headers["Authorization"]
      auth_header => {
        // "Bearer <token>" 형식 파싱
        if string_contains(auth_header, "Bearer ")
          let token = string_substring(auth_header, 7)

          // JWT 검증
          match verify_jwt(token, gateway.auth_middleware.secret_key)
            Ok(claims) => {
              match claims["sub"]
                user_id => Ok(user_id)
                _ => Err("Invalid token claims")
              end
            }
            Err(e) => Err("JWT verification failed: " + e)
          end
        else
          Err("Missing Bearer token")
        end
      }
      _ => Err("Missing Authorization header")
    end
  end

