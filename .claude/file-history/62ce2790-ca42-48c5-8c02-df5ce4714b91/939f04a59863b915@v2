// ============================================================================
// 속도 제한 (Rate Limiting)
// ============================================================================

pub fn create_rate_limiter(user_id: string, requests_per_second: i32, requests_per_hour: i32) -> RateLimiter
  intent "사용자별 속도 제한 생성"
  do
    return RateLimiter {
      limiter_id: generate_uuid(),
      user_id: user_id,
      requests_per_second: requests_per_second,
      requests_per_hour: requests_per_hour,
      window_start: get_current_time_unix(),
      current_requests: 0
    }
  end

pub fn check_rate_limit(gateway: &mut APIGateway, user_id: string) -> Result<void, string>
  intent "요청이 속도 제한 범위 내인지 확인"
  do
    match gateway.rate_limiters[user_id]
      limiter => {
        let current_time = get_current_time_unix()
        let time_since_window = current_time - limiter.window_start

        // 1초 단위 윈도우 재설정
        if time_since_window >= 1
          limiter.current_requests = 0
          limiter.window_start = current_time
        end

        // 요청 수 확인
        if limiter.current_requests >= limiter.requests_per_second
          return Err("Exceeded requests_per_second: " + string_of_int(limiter.requests_per_second))
        end

        limiter.current_requests = limiter.current_requests + 1

        return Ok(())
      }
      _ => {
        // 기본 제한: 100 req/s, 100,000 req/hour
        let limiter = create_rate_limiter(user_id, 100, 100000)
        gateway.rate_limiters[user_id] = limiter

        return Ok(())
      }
    end
  end

