// 로드 밸런싱
// ============================================================================

pub fn select_service_instance(gateway: APIGateway, service_name: string) -> Result<Service, string>
  intent "가용 서비스 인스턴스 선택 (가중 라운드 로빈)"
  do
    // 모든 UP 상태의 서비스 수집
    let available_services = []
    let total_weight = 0

    for service_id in gateway.upstream_services.keys()
      match gateway.upstream_services[service_id]
        service => {
          if service.status == "UP"
            array_append(&mut available_services, service)
            total_weight = total_weight + service.weight
          end
        }
        _ => {}
      end
    end

    if array_length(available_services) == 0
      return Err("No available service instances")
    end

    // 가중 라운드 로빈 선택
    let random_weight = random_int(0, total_weight)
    let cumulative_weight = 0

    for i in 0 to array_length(available_services)
      let service = available_services[i]
      cumulative_weight = cumulative_weight + service.weight

      if random_weight <= cumulative_weight
        return Ok(service)
      end
    end

    // 폴백: 첫 번째 서비스
    return Ok(available_services[0])
  end

