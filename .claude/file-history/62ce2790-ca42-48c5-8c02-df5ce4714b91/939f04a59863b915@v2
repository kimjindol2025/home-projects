pub fn log_request(gateway: &mut APIGateway, request_id: string, method: string, path: string, service_id: string, status: i32, response_time: i64, user_id: string, error: string) -> void
  intent "요청 로깅"
  do
    let log_entry = RequestLog {
      request_id: request_id,
      timestamp: get_current_time_unix(),
      method: method,
      path: path,
      upstream_service: service_id,
      status_code: status,
      response_time_ms: response_time,
      user_id: user_id,
      error: error
    }

    array_append(&mut gateway.request_log, log_entry)

    // 로그 크기 제한 (최근 10,000 요청만 유지)
    if array_length(gateway.request_log) > 10000
      gateway.request_log = array_slice(gateway.request_log, 1, 10000)
    end
  end

pub fn get_gateway_metrics(gateway: APIGateway) -> map<string, string>
  intent "게이트웨이 성능 메트릭"
  do
    let metrics = {}

    let total_requests = array_length(gateway.request_log)
    if total_requests == 0
      return metrics
    end

    // 상태코드 분포
    let success = 0    // 2xx
    let client_error = 0  // 4xx
    let server_error = 0  // 5xx

    let total_response_time = 0

    for i in 0 to total_requests
      let log_entry = gateway.request_log[i]
      let status = log_entry.status_code

      if status >= 200 && status < 300
        success = success + 1
      else if status >= 400 && status < 500
        client_error = client_error + 1
      else if status >= 500
        server_error = server_error + 1
      end

      total_response_time = total_response_time + log_entry.response_time_ms
    end

    metrics["total_requests"] = string_of_int(total_requests)
    metrics["success_rate"] = string_of_int((success * 100) / total_requests) + "%"
    metrics["error_rate"] = string_of_int(((client_error + server_error) * 100) / total_requests) + "%"
    metrics["avg_response_time_ms"] = string_of_int(total_response_time / total_requests)

    return metrics
  end

