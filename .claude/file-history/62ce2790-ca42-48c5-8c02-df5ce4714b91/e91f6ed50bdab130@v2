pub struct DecisionEngine {
  engine_id: string,
  models: map<string, f64>,  // model_name -> weight (앙상블 가중치)
  risk_threshold: f64,
  last_decision: Decision,
  decision_history: array<Decision>,
  performance_metrics: map<string, f64>
}

pub struct Decision {
  decision_id: string,
  timestamp: i64,
  context: map<string, string>,
  recommendation: string,
  confidence: f64,
  risk_score: f64,
  model_scores: map<string, f64>,
  action: string,
  outcome: string
}

pub struct RiskAssessment {
  risk_id: string,
  risk_score: f64,  // 0-100
  risk_factors: map<string, f64>,
  critical_issues: array<string>,
  recommendations: array<string>
}

pub struct ModelEnsemble {
  ensemble_id: string,
  models: array<string>,  // ["collab", "content", "deep_learning"]
  weights: array<f64>,  // [0.3, 0.3, 0.4]
  combination_method: string,  // "weighted_sum", "voting", "stacking"
  performance: f64
}

