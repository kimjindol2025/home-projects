pub struct TrendingMetrics {
  post_id: i32,
  velocity: f64,          // 시간당 상호작용 증가율
  momentum: f64,          // 최근 1시간 vs 1일 전
  comment_velocity: f64,  // 시간당 댓글 수
  share_velocity: f64     // 시간당 공유 수
}

pub fn trending_recommendations(num_recommendations: i32, time_window_hours: i32) -> array<RecommendationResult>
  intent "최근 트렌딩 포스트 추천"
  do
    let recommendations = []

    // 지난 N시간의 포스트 조회
    let trending_posts = get_posts_by_time_window(time_window_hours)

    // 각 포스트의 트렌딩 지표 계산
    let trending_metrics = []
    for i in 0 to array_length(trending_posts)
      let post = trending_posts[i]
      let metrics = compute_trending_metrics(post, time_window_hours)
      array_append(&mut trending_metrics, metrics)
    end

    // 종합 트렌딩 점수 계산
    for i in 0 to array_length(trending_metrics)
      let metrics = trending_metrics[i]
      let post = trending_posts[i]

      // 트렌딩 점수 = velocity * 0.5 + momentum * 0.3 + comment_velocity * 0.2
      let trending_score =
        metrics.velocity * 0.5 +
        metrics.momentum * 0.3 +
        metrics.comment_velocity * 0.2

      let result = RecommendationResult {
        post_id: post.post_id,
        title: post.title,
        score: trending_score,
        reason: "지금 인기 있는 글입니다",
        algorithm: "trending"
      }

      array_append(&mut recommendations, result)
    end

    sort_recommendations(&mut recommendations)
    return array_slice(recommendations, 0, num_recommendations)
  end

// ============================================================================
// 협업 필터링 - Item-Item 방식
// ============================================================================

pub fn item_item_collaborative_filtering(post_id: i32, num_recommendations: i32) -> array<RecommendationResult>
  intent "현재 포스트와 유사한 포스트 추천 ('이 글을 본 사람들이 본 글')"
  do
    let recommendations = []

    // 현재 포스트를 본 사용자들 찾기
    let users_who_viewed = get_users_who_viewed_post(post_id)

    // 그 사용자들이 본 다른 포스트들
    let related_posts = {}

    for i in 0 to array_length(users_who_viewed)
      let user = users_who_viewed[i]

      for j in 0 to array_length(user.viewed_posts)
        let viewed_post_id = user.viewed_posts[j]

        if viewed_post_id != post_id
          // 카운트 증가
          if !related_posts.has_key(viewed_post_id)
            related_posts[viewed_post_id] = 0
          end

          related_posts[viewed_post_id] = related_posts[viewed_post_id] + 1
        end
      end
    end

    // 상위 포스트 반환
    for post_id_key in related_posts.keys()
      let count = related_posts[post_id_key]
      let score = count / array_length(users_who_viewed)

      let result = RecommendationResult {
        post_id: post_id_key,
        title: get_post_title(post_id_key),
        score: score,
        reason: "이 글을 본 사람들이 읽은 글입니다",
        algorithm: "item_item_cf"
      }

      array_append(&mut recommendations, result)
    end

    sort_recommendations(&mut recommendations)
    return array_slice(recommendations, 0, num_recommendations)
  end

