fn compute_cosine_similarity_vectors(vec1: array<f64>, vec2: array<f64>) -> f64
  intent "코사인 유사도 계산 (두 벡터)"
  do
    // TODO: 실제 구현
    let dot_product = 0.0
    let magnitude1 = 0.0
    let magnitude2 = 0.0

    for i in 0 to array_length(vec1)
      dot_product = dot_product + vec1[i] * vec2[i]
      magnitude1 = magnitude1 + vec1[i] * vec1[i]
      magnitude2 = magnitude2 + vec2[i] * vec2[i]
    end

    if magnitude1 > 0.0 && magnitude2 > 0.0
      return dot_product / (sqrt(magnitude1) * sqrt(magnitude2))
    end

    return 0.0
  end

