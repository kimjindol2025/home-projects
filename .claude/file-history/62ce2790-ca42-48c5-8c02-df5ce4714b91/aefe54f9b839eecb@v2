// ============================================================================
// 협업 필터링 (Collaborative Filtering)
// ============================================================================

pub fn collaborative_filtering(user_id: string, similar_users: array<UserProfile>, num_recommendations: i32) -> array<RecommendationResult>
  intent "협업 필터링으로 추천 생성 (User-User)"
  do
    let recommendations = []

    // 1단계: 유사 사용자 찾기 (코사인 유사도)
    let user_profile = get_user_profile(user_id)

    for i in 0 to array_length(similar_users)
      let similar_user = similar_users[i]
      let similarity = compute_cosine_similarity(user_profile.preferences, similar_user.preferences)

      // 2단계: 유사 사용자가 읽은 포스트 중 현재 사용자가 안 읽은 것
      for j in 0 to array_length(similar_user.liked_posts)
        let post_id = similar_user.liked_posts[j]

        if !array_contains(user_profile.liked_posts, post_id)
          // 3단계: 점수 계산 (유사도 * 좋아요 가중치)
          let score = similarity * 0.8

          let result = RecommendationResult {
            post_id: post_id,
            title: get_post_title(post_id),
            score: score,
            reason: "유사한 사용자들이 좋아한 글입니다",
            algorithm: "collaborative_filtering"
          }

          array_append(&mut recommendations, result)
        end
      end
    end

    // 점수로 정렬 후 상위 num_recommendations개만 반환
    sort_recommendations(&mut recommendations)
    return array_slice(recommendations, 0, num_recommendations)
  end

// ============================================================================
// 콘텐츠 기반 필터링 (Content-Based Filtering)
// ============================================================================

pub fn content_based_filtering(user_id: string, all_posts: array<PostProfile>, num_recommendations: i32) -> array<RecommendationResult>
  intent "콘텐츠 기반 필터링으로 추천 생성"
  do
    let recommendations = []
    let user_profile = get_user_profile(user_id)

    // 사용자가 본 포스트 분석
    let user_preference_vector = compute_user_preference_vector(user_profile)

    // 모든 포스트와 사용자 선호도 비교
    for i in 0 to array_length(all_posts)
      let post = all_posts[i]

      // 사용자가 이미 본 포스트는 제외
      if !array_contains(user_profile.viewed_posts, post.post_id)
        // 코사인 유사도 계산
        let similarity = compute_cosine_similarity_vectors(user_preference_vector, post.content_vector)

        // 태그 매칭 추가 점수
        let tag_bonus = 0.0
        for j in 0 to array_length(post.tags)
          let tag = post.tags[j]
          if user_profile.preferences[tag] > 0.5
            tag_bonus = tag_bonus + 0.1
          end
        end

        let total_score = similarity * 0.7 + tag_bonus * 0.3

        let result = RecommendationResult {
          post_id: post.post_id,
          title: post.title,
          score: total_score,
          reason: "당신의 관심사와 맞는 글입니다",
          algorithm: "content_based"
        }

        array_append(&mut recommendations, result)
      end
    end

    sort_recommendations(&mut recommendations)
    return array_slice(recommendations, 0, num_recommendations)
  end

// ============================================================================
// 하이브리드 추천 (Hybrid Approach)
// ============================================================================

pub fn hybrid_recommendations(user_id: string, similar_users: array<UserProfile>, all_posts: array<PostProfile>, num_recommendations: i32) -> array<RecommendationResult>
  intent "협업 + 콘텐츠 기반 필터링 (하이브리드)"
  do
    // 1단계: 협업 필터링 결과
    let collab_results = collaborative_filtering(user_id, similar_users, num_recommendations * 2)

    // 2단계: 콘텐츠 기반 필터링 결과
    let content_results = content_based_filtering(user_id, all_posts, num_recommendations * 2)

    // 3단계: 결과 병합 및 점수 재계산
    let combined = []

    // 협업 결과: 가중치 60%
    for i in 0 to array_length(collab_results)
      let result = collab_results[i]
      result.score = result.score * 0.6
      array_append(&mut combined, result)
    end

    // 콘텐츠 결과: 가중치 40%
    for i in 0 to array_length(content_results)
      let result = content_results[i]
      result.score = result.score * 0.4
      array_append(&mut combined, result)
    end

    // 중복 제거 및 점수 합산
    let final_recommendations = deduplicate_and_merge(combined)

    sort_recommendations(&mut final_recommendations)
    return array_slice(final_recommendations, 0, num_recommendations)
  end

// ============================================================================
// 인기도 기반 추천 (Popularity)
// ============================================================================

pub fn popularity_based_recommendations(num_recommendations: i32) -> array<RecommendationResult>
  intent "인기 있는 포스트 추천 (Cold Start 문제 해결)"
  do
    let recommendations = []

    // 모든 포스트를 인기도로 정렬
    let all_posts = get_all_posts_sorted_by_popularity()

    for i in 0 to num_recommendations
      let post = all_posts[i]

      let result = RecommendationResult {
        post_id: post.post_id,
        title: post.title,
        score: post.popularity_score,
        reason: "많은 사용자들이 관심 있는 글입니다",
        algorithm: "popularity"
      }

      array_append(&mut recommendations, result)
    end

    return recommendations
  end

