pub fn personalized_recommendations(user_id: string, num_recommendations: i32) -> array<RecommendationResult>
  intent "사용자 맞춤 추천 (최적 알고리즘 선택)"
  do
    let user_profile = get_user_profile(user_id)

    // Cold Start 문제 확인
    if array_length(user_profile.viewed_posts) < 5
      // 새 사용자: 인기도 기반 + 태그 기반
      return popularity_based_recommendations(num_recommendations)
    end

    // Warm Start: 하이브리드 추천
    let similar_users = find_similar_users(user_id, 10)
    let all_posts = get_all_posts()

    return hybrid_recommendations(user_id, similar_users, all_posts, num_recommendations)
  end

