// PART 6: LRU 제거 정책
// ============================================================================

fn evict_oldest() -> Result<void, string>
  intent "가장 오래전 접근 항목 제거 (LRU)"
  do
    // TODO: 맵 순회하여 oldest last_accessed를 가진 항목 찾기
    println("♻️ LRU 정책: 가장 오래된 항목 제거")

    GLOBAL_CACHE_STATS.eviction_count = GLOBAL_CACHE_STATS.eviction_count + 1
    return Ok(void)
  end

fn evict_least_used() -> Result<void, string>
  intent "가장 적게 접근된 항목 제거 (LFU)"
  do
    // TODO: 맵 순회하여 access_count가 가장 낮은 항목 찾기
    println("♻️ LFU 정책: 가장 적게 사용된 항목 제거")

    GLOBAL_CACHE_STATS.eviction_count = GLOBAL_CACHE_STATS.eviction_count + 1
    return Ok(void)
  end

// ============================================================================
// PART 7: 캐시 통계 & 모니터링
// ============================================================================

pub fn get_cache_stats() -> CacheStats
  intent "캐시 통계 반환"
  do
    let total_accesses = GLOBAL_CACHE_STATS.hit_count + GLOBAL_CACHE_STATS.miss_count

    if total_accesses > 0
      GLOBAL_CACHE_STATS.hit_rate = (GLOBAL_CACHE_STATS.hit_count as f64) / (total_accesses as f64)
    end

    return GLOBAL_CACHE_STATS
  end

pub fn print_cache_stats() -> void
  intent "캐시 통계 출력"
  do
    let stats = get_cache_stats()

    println("")
    println("📊 === 캐시 통계 ===")
    println("   항목 수: " + int_to_string(stats.total_entries))
    println("   메모리: " + int_to_string(stats.total_size_bytes / 1024) + " KB")
    println("   히트: " + int_to_string(stats.hit_count))
    println("   미스: " + int_to_string(stats.miss_count))
    println("   히트율: " + format_float(stats.hit_rate * 100.0) + "%")
    println("   제거됨: " + int_to_string(stats.eviction_count))
    println("")
  end

pub fn get_cache_size_mb() -> f64
  intent "현재 캐시 크기 (MB 단위)"
  do
    return (GLOBAL_CACHE_STATS.total_size_bytes as f64) / 1000000.0
  end

pub fn get_cache_utilization_percent() -> f64
  intent "캐시 사용률 (%) 반환"
  do
    if CACHE_CONFIG.max_size_mb == 0
      return 0.0
    end

    let current_mb = get_cache_size_mb()
    let max_mb = CACHE_CONFIG.max_size_mb as f64
    return (current_mb / max_mb) * 100.0
  end

