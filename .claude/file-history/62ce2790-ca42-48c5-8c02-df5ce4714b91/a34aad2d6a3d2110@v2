// ============================================================================
// PART 5: TTL & 만료 관리
// ============================================================================

fn is_expired(entry: CacheEntry) -> bool
  intent "캐시 항목의 TTL 만료 확인"
  do
    let now = get_current_time()
    let age_seconds = time_diff_seconds(entry.created_at, now)

    return age_seconds > entry.ttl_seconds
  end

pub fn set_entry_ttl(key: string, ttl_seconds: i32) -> Result<void, string>
  intent "캐시 항목의 TTL 설정"
  do
    if !GLOBAL_CACHE.has_key(key)
      return Err("캐시 항목 없음: " + key)
    end

    GLOBAL_CACHE[key].ttl_seconds = ttl_seconds
    return Ok(void)
  end

pub fn cleanup_expired_entries() -> i32
  intent "만료된 캐시 항목 정리"
  do
    let cleaned = 0
    // TODO: 맵 순회하여 만료된 항목 삭제
    println("🧹 " + int_to_string(cleaned) + "개의 만료된 항목 정리됨")
    return cleaned
  end

