pub fn benchmark_operation(operation_name: string, operation_fn: string, iterations: i32) -> BenchmarkResult
  intent "단일 작업 벤치마크 측정"
  do
    println("⏱️ 벤치마크 시작: " + operation_name + " (" + int_to_string(iterations) + "회)")

    let times: array<i32> = []
    let total_time = 0
    let min_time = 999999
    let max_time = 0

    // 각 반복마다 타이밍 측정
    for i = 0; i < iterations; i++
      let start = get_current_time_ms()

      // TODO: operation_fn 동적 실행
      // 현재: 모의 작업으로 대체
      simulate_operation()

      let end = get_current_time_ms()
      let elapsed = end - start

      total_time = total_time + elapsed
      if elapsed < min_time
        min_time = elapsed
      end
      if elapsed > max_time
        max_time = elapsed
      end

      times = array_append_i32(times, elapsed)
    end

    let avg_time = total_time / iterations
    let p95_time = calculate_percentile(times, 95)
    let p99_time = calculate_percentile(times, 99)
    let throughput = (iterations * 1000) / total_time  // per second

    let result = BenchmarkResult {
      operation: operation_name,
      total_runs: iterations,
      total_time_ms: total_time,
      min_time_ms: min_time,
      max_time_ms: max_time,
      avg_time_ms: avg_time,
      p95_time_ms: p95_time,
      p99_time_ms: p99_time,
      throughput_per_sec: throughput
    }

    println("✅ 벤치마크 완료: " + operation_name)
    println("   평균: " + int_to_string(avg_time) + "ms, P95: " + int_to_string(p95_time) + "ms, P99: " + int_to_string(p99_time) + "ms")

    return result
  end

