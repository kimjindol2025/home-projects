pub fn run_full_benchmark_suite() -> BenchmarkSuite
  intent "모든 주요 작업의 벤치마크 실행"
  do
    println("")
    println("⚡ ════════════════════════════════════════════")
    println("⚡ FreeLang 성능 벤치마크 스위트 시작")
    println("⚡ ════════════════════════════════════════════")
    println("")

    let start_time = get_current_time()
    let suite_start_ms = get_current_time_ms()

    let results: array<BenchmarkResult> = []

    // 각 작업별 벤치마크
    results = array_append_result(results, benchmark_cache_operations(1000))
    results = array_append_result(results, benchmark_search_operations(100))
    results = array_append_result(results, benchmark_auth_operations(500))
    results = array_append_result(results, benchmark_json_operations(500))
    results = array_append_result(results, benchmark_websocket_operations(1000))

    let suite_end_ms = get_current_time_ms()
    let total_duration = suite_end_ms - suite_start_ms
    let end_time = get_current_time()

    let suite = BenchmarkSuite {
      name: "Phase 1-5 Full Benchmark",
      results: results,
      total_duration_ms: total_duration,
      start_time: start_time,
      end_time: end_time
    }

    // 결과 출력
    print_benchmark_summary(suite)

    return suite
  end

pub fn print_benchmark_summary(suite: BenchmarkSuite) -> void
  intent "벤치마크 결과 출력"
  do
    println("")
    println("⚡ ════════════════════════════════════════════")
    println("📊 벤치마크 결과 요약")
    println("⚡ ════════════════════════════════════════════")
    println("")
    println("📍 시간대: " + suite.start_time + " ~ " + suite.end_time)
    println("⏱️ 총 소요시간: " + int_to_string(suite.total_duration_ms) + "ms")
    println("")

    for i = 0; i < length(suite.results); i++
      let result = get_result_at(suite.results, i)
      println("📈 " + result.operation)
      println("   실행: " + int_to_string(result.total_runs) + "회")
      println("   총합: " + int_to_string(result.total_time_ms) + "ms")
      println("   최소: " + int_to_string(result.min_time_ms) + "ms")
      println("   최대: " + int_to_string(result.max_time_ms) + "ms")
      println("   평균: " + int_to_string(result.avg_time_ms) + "ms")
      println("   P95: " + int_to_string(result.p95_time_ms) + "ms")
      println("   P99: " + int_to_string(result.p99_time_ms) + "ms")
      println("   처리량: " + int_to_string(result.throughput_per_sec) + " ops/sec")

      // 목표값 확인
      if result.avg_time_ms < 50
        println("   ✅ PASS (목표: <50ms)")
      else
        println("   ⚠️ SLOW (목표: <50ms, 실제: " + int_to_string(result.avg_time_ms) + "ms)")
      end
      println("")
    end

    println("⚡ ════════════════════════════════════════════")
  end

