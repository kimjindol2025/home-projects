pub fn profile_memory(operation_name: string) -> MemoryProfile
  intent "메모리 사용량 프로파일링"
  do
    let before = get_memory_usage_kb()

    // TODO: operation 실행

    let after = get_memory_usage_kb()
    let used = after - before

    let profile = MemoryProfile {
      operation: operation_name,
      memory_before_kb: before,
      memory_after_kb: after,
      memory_used_kb: used,
      peak_memory_kb: after
    }

    println("💾 메모리 프로파일: " + operation_name)
    println("   사용: " + int_to_string(used) + "KB, 피크: " + int_to_string(after) + "KB")

    return profile
  end

