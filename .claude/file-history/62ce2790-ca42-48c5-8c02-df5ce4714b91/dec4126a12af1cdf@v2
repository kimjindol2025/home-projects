pub fn compare_benchmarks(baseline: BenchmarkSuite, current: BenchmarkSuite) -> void
  intent "두 벤치마크 비교 분석"
  do
    println("")
    println("📊 벤치마크 비교 분석 (기준선 vs 현재)")
    println("")

    for i = 0; i < length(baseline.results); i++
      let base_result = get_result_at(baseline.results, i)
      let curr_result = get_result_at(current.results, i)

      let improvement = ((base_result.avg_time_ms - curr_result.avg_time_ms) * 100) / base_result.avg_time_ms

      println("📈 " + base_result.operation)
      println("   기준선: " + int_to_string(base_result.avg_time_ms) + "ms")
      println("   현재: " + int_to_string(curr_result.avg_time_ms) + "ms")

      if improvement > 0
        println("   ✅ 개선: " + int_to_string(improvement) + "%")
      else
        println("   ⚠️ 악화: " + int_to_string(improvement) + "%")
      end
      println("")
    end
  end

