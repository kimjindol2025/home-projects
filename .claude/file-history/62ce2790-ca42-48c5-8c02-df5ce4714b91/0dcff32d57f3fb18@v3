pub struct GitHubOAuthConfig {
  client_id: string,
  client_secret: string,
  redirect_uri: string
}

pub struct GitHubUserProfile {
  id: string,
  login: string,
  email: string,
  avatar_url: string
}

pub fn create_github_oauth_config(client_id: string, client_secret: string) -> GitHubOAuthConfig
  do
    return GitHubOAuthConfig {
      client_id: client_id,
      client_secret: client_secret,
      redirect_uri: "https://253.dclub.kr/auth/github/callback"
    }
  end

pub fn get_github_authorization_url(config: GitHubOAuthConfig) -> string
  do
    let params = "?" +
      "client_id=" + config.client_id +
      "&redirect_uri=" + config.redirect_uri +
      "&scope=user:email"

    return "https://github.com/login/oauth/authorize" + params
  end

