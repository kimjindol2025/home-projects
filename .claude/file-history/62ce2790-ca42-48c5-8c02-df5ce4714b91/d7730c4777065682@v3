pub struct GoogleOAuthConfig {
  client_id: string,
  client_secret: string,
  redirect_uri: string
}

pub struct GoogleUserProfile {
  id: string,
  email: string,
  name: string,
  picture: string
}

pub fn create_google_oauth_config(client_id: string, client_secret: string) -> GoogleOAuthConfig
  do
    return GoogleOAuthConfig {
      client_id: client_id,
      client_secret: client_secret,
      redirect_uri: "https://253.dclub.kr/auth/google/callback"
    }
  end

pub fn get_google_authorization_url(config: GoogleOAuthConfig) -> string
  do
    let scope = "openid email profile"
    let params = "?" +
      "client_id=" + config.client_id +
      "&redirect_uri=" + config.redirect_uri +
      "&response_type=code" +
      "&scope=" + scope

    return "https://accounts.google.com/o/oauth2/v2/auth" + params
  end

