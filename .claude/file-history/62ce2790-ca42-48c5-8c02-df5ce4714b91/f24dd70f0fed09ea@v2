// ============================================================================
// Query Root Type
// ============================================================================

pub fn define_query_type() -> GraphQLType
  intent "Query 루트 타입 정의"
  do
    let query_type = GraphQLType {
      name: "Query",
      kind: "OBJECT",
      fields: {},
      description: "루트 쿼리"
    }

    // post(id: ID!): Post
    query_type.fields["post"] = GraphQLField {
      name: "post",
      type_name: "Post",
      is_nullable: true,
      is_list: false,
      description: "ID로 포스트 조회",
      args: {
        "id": GraphQLArg {
          name: "id",
          type_name: "ID",
          is_nullable: false,
          default_value: ""
        }
      }
    }

    // posts(limit: Int, offset: Int): [Post!]!
    query_type.fields["posts"] = GraphQLField {
      name: "posts",
      type_name: "Post",
      is_nullable: false,
      is_list: true,
      description: "포스트 목록 조회",
      args: {
        "limit": GraphQLArg {
          name: "limit",
          type_name: "Int",
          is_nullable: true,
          default_value: "10"
        },
        "offset": GraphQLArg {
          name: "offset",
          type_name: "Int",
          is_nullable: true,
          default_value: "0"
        }
      }
    }

    // user(id: ID!): User
    query_type.fields["user"] = GraphQLField {
      name: "user",
      type_name: "User",
      is_nullable: true,
      is_list: false,
      description: "ID로 사용자 조회",
      args: {
        "id": GraphQLArg {
          name: "id",
          type_name: "ID",
          is_nullable: false,
          default_value: ""
        }
      }
    }

    // users: [User!]!
    query_type.fields["users"] = GraphQLField {
      name: "users",
      type_name: "User",
      is_nullable: false,
      is_list: true,
      description: "모든 사용자 조회",
      args: {}
    }

    // search(query: String!): [Post!]!
    query_type.fields["search"] = GraphQLField {
      name: "search",
      type_name: "Post",
      is_nullable: false,
      is_list: true,
      description: "포스트 검색",
      args: {
        "query": GraphQLArg {
          name: "query",
          type_name: "String",
          is_nullable: false,
          default_value: ""
        }
      }
    }

    return query_type
  end

