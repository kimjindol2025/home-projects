// ============================================================================
// Schema 정의
// ============================================================================

pub struct GraphQLSchema {
  query_type: GraphQLType,
  mutation_type: GraphQLType,
  types: map<string, GraphQLType>
}

pub fn build_schema() -> Result<GraphQLSchema, string>
  intent "완전한 GraphQL 스키마 빌드"
  do
    let schema = GraphQLSchema {
      query_type: define_query_type(),
      mutation_type: define_mutation_type(),
      types: {}
    }

    // 모든 타입 등록
    let scalars = define_scalar_types()
    for scalar_name in scalars.keys()
      schema.types[scalar_name] = scalars[scalar_name]
    end

    schema.types["Post"] = define_post_type()
    schema.types["Comment"] = define_comment_type()
    schema.types["User"] = define_user_type()
    schema.types["Query"] = schema.query_type
    schema.types["Mutation"] = schema.mutation_type

    return Ok(schema)
  end

// ============================================================================
// 인트로스펙션 (스키마 자동 발견)
// ============================================================================

pub fn get_schema_introspection(schema: GraphQLSchema) -> Result<string, string>
  intent "GraphQL 스키마 인트로스펙션 반환"
  do
    let introspection = "{"
    introspection = introspection + "\"__schema\": {"
    introspection = introspection + "\"types\": ["

    for type_name in schema.types.keys()
      let graphql_type = schema.types[type_name]
      introspection = introspection + "{\"name\": \"" + graphql_type.name + "\", \"kind\": \"" + graphql_type.kind + "\"},"
    end

    introspection = introspection + "]"
    introspection = introspection + "}"
    introspection = introspection + "}"

    return Ok(introspection)
  end

