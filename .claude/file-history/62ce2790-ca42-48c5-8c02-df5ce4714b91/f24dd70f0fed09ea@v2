// ============================================================================
// FreeLang GraphQL Schema Definition & Types
// ============================================================================
// 기능: GraphQL 타입 정의, 스키마 검증, 인트로스펙션

use std::io::*

// ============================================================================
// GraphQL 타입 정의
// ============================================================================

pub struct GraphQLType {
  name: string,
  kind: string,  // SCALAR, OBJECT, INTERFACE, UNION, ENUM, LIST, NON_NULL
  fields: map<string, GraphQLField>,
  description: string
}

pub struct GraphQLField {
  name: string,
  type_name: string,
  is_nullable: bool,
  is_list: bool,
  description: string,
  args: map<string, GraphQLArg>
}

pub struct GraphQLArg {
  name: string,
  type_name: string,
  is_nullable: bool,
  default_value: string
}

// ============================================================================
// 스칼라 타입 정의
// ============================================================================

pub fn define_scalar_types() -> map<string, GraphQLType>
  intent "GraphQL 기본 스칼라 타입 정의"
  do
    let scalars = {}

    // String
    scalars["String"] = GraphQLType {
      name: "String",
      kind: "SCALAR",
      fields: {},
      description: "텍스트 문자열"
    }

    // Int
    scalars["Int"] = GraphQLType {
      name: "Int",
      kind: "SCALAR",
      fields: {},
      description: "32비트 정수"
    }

    // Float
    scalars["Float"] = GraphQLType {
      name: "Float",
      kind: "SCALAR",
      fields: {},
      description: "실수"
    }

    // Boolean
    scalars["Boolean"] = GraphQLType {
      name: "Boolean",
      kind: "SCALAR",
      fields: {},
      description: "참/거짓"
    }

    // ID
    scalars["ID"] = GraphQLType {
      name: "ID",
      kind: "SCALAR",
      fields: {},
      description: "고유 식별자"
    }

    // DateTime
    scalars["DateTime"] = GraphQLType {
      name: "DateTime",
      kind: "SCALAR",
      fields: {},
      description: "ISO 8601 날짜-시간"
    }

    // JSON
    scalars["JSON"] = GraphQLType {
      name: "JSON",
      kind: "SCALAR",
      fields: {},
      description: "JSON 객체"
    }

    return scalars
  end

