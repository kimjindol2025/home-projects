// ============================================================================
// GraphQL Response 생성
// ============================================================================

pub struct GraphQLResponse {
  data: string,
  errors: array<string>,
  extensions: map<string, string>
}

pub fn create_response(data: string, errors: array<string>) -> GraphQLResponse
  intent "GraphQL 응답 객체 생성"
  do
    let response = GraphQLResponse {
      data: data,
      errors: errors,
      extensions: {}
    }

    response.extensions["executedAt"] = get_current_timestamp()
    response.extensions["version"] = "1.0.0"

    return response
  end

pub fn graphql_response_to_json(response: GraphQLResponse) -> string
  intent "GraphQL 응답을 JSON으로 변환"
  do
    let json = "{"
    json = json + "\"data\": " + response.data + ","
    json = json + "\"errors\": ["

    for i in 0 to array_length(response.errors)
      json = json + "\"" + response.errors[i] + "\","
    end

    json = json + "]"
    json = json + "}"

    return json
  end

