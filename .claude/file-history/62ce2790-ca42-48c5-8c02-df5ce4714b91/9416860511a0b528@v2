pub fn parse_graphql_query(query_string: string) -> Result<GraphQLQuery, string>
  intent "GraphQL 쿼리 문자열을 AST로 파싱"
  do
    if query_string == ""
      return Err("Empty query string")
    end

    // 1단계: 작업 타입 감지 (query, mutation)
    let operation_type = "query"
    if string_contains(query_string, "mutation")
      operation_type = "mutation"
    end

    // 2단계: 작업명 추출
    let operation_name = extract_operation_name(query_string)

    // 3단계: 필드 파싱
    let fields = parse_fields(query_string)

    // 4단계: 변수 추출
    let variables = extract_variables(query_string)

    let query = GraphQLQuery {
      operation_type: operation_type,
      operation_name: operation_name,
      fields: fields,
      variables: variables
    }

    return Ok(query)
  end

