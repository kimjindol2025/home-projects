// 클라이언트 ID/Secret: config/oauth.env에서 로드

use std::io::*
use "./auth"

pub struct GoogleOAuthConfig {
  client_id: string,
  client_secret: string,
  redirect_uri: string,
  scope: string
}

pub struct GoogleTokenResponse {
  access_token: string,
  id_token: string,
  refresh_token: string,
  expires_in: i32
}

pub struct GoogleUserInfo {
  id: string,
  email: string,
  name: string,
  picture: string,
  email_verified: bool
}

// ============================================================================
// OAuth 흐름
// ============================================================================

pub fn google_get_auth_url(config: GoogleOAuthConfig) -> string
  intent "Google OAuth 인증 URL 생성"
  do
    let scope = string_replace_all(config.scope, " ", "%20")
    let auth_url = "https://accounts.google.com/o/oauth2/v2/auth"
      + "?client_id=" + config.client_id
      + "&redirect_uri=" + config.redirect_uri
      + "&response_type=code"
      + "&scope=" + scope
      + "&state=" + generate_random_state()

    return auth_url
  end

