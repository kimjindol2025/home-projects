// ============================================================================
// 번역 함수
// ============================================================================

pub fn translate(key: string, language: string) -> Result<string, string>
  intent "번역 키를 사용해 메시지 조회"
  do
    let catalog = get_translation_catalog()

    match catalog[key]
      localized => {
        match language
          "ko" => Ok(localized.korean)
          "en" => Ok(localized.english)
          "ja" => Ok(localized.japanese)
          "zh" => Ok(localized.chinese)
          "es" => Ok(localized.spanish)
          "fr" => Ok(localized.french)
          _ => Ok(localized.korean)  // 기본값: 한국어
        end
      }
      _ => Err("Translation key not found: " + key)
    end
  end

