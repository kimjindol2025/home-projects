  intent "매개변수가 있는 번역"
  do
    // 번역 조회
    match translate(key, language)
      Ok(translated) => {
        // 매개변수 치환
        let result = translated

        for param_key in params.keys()
          let param_value = params[param_key]
          let placeholder = "{{" + param_key + "}}"

          // TODO: 문자열 replace 구현
          // result = result.replace(placeholder, param_value)
        end

        return Ok(result)
      }
      Err(e) => Err(e)
    end
  end

pub fn t(key: string, language: string) -> string
  intent "단축 함수: translate"
  do
    match translate(key, language)
      Ok(translated) => translated
      Err(_) => key
    end
  end

