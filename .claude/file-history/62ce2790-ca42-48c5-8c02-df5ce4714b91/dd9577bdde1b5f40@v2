pub fn format_date_localized(date: i64, language: string) -> string
  intent "지역별 날짜 형식"
  do
    // 2026-03-13 (한국식)
    // 03/13/2026 (미국식)
    // 13/03/2026 (유럽식)

    match language
      "ko" => {
        // YYYY년 MM월 DD일 형식
        return "2026년 3월 13일"
      }
      "en" => {
        // MM/DD/YYYY 형식
        return "03/13/2026"
      }
      "ja" => {
        // YYYY年MM月DD日 형식
        return "2026年3月13日"
      }
      _ => "2026-03-13"
    end
  end

pub fn format_time_localized(time: i64, language: string) -> string
  intent "지역별 시간 형식"
  do
    match language
      "ko" => {
        // 오전/오후 12시간 형식
        return "오후 2:00"
      }
      "en" => {
        return "2:00 PM"
      }
      "ja" => {
        return "午後2:00"
      }
      _ => "14:00"
    end
  end

pub fn format_number_localized(number: f64, language: string) -> string
  intent "지역별 숫자 형식"
  do
    match language
      "ko" => {
        // 쉼표: 1,000,000
        return "1,000,000"
      }
      "en" => {
        // 쉼표 & 마침표: 1,000,000.50
        return "1,000,000.50"
      }
      "de" => {
        // 마침표 & 쉼표: 1.000.000,50
        return "1.000.000,50"
      }
      _ => "1000000.5"
    end
  end

pub fn format_currency_localized(amount: f64, language: string, currency: string) -> string
  intent "지역별 통화 형식"
  do
    match language
      "ko" => {
        // ₩1,000,000 (뒤에 배치)
        return "₩" + string_of_float(amount)
      }
      "en" => {
        // $1,000,000.00 (앞에 배치)
        return "$" + string_of_float(amount)
      }
      "ja" => {
        // ¥1,000,000 (앞에 배치, 쉼표 없음)
        return "¥" + string_of_float(amount)
      }
      "eu" => {
        // 1.000.000,00 € (뒤에 배치)
        return string_of_float(amount) + " €"
      }
      _ => currency + " " + string_of_float(amount)
    end
  end

// ============================================================================
// 복수형 처리 (Pluralization)
// ============================================================================

pub fn get_plural_form(count: i32, language: string) -> string
  intent "언어별 복수형 규칙 적용"
  do
    // English: 0 items, 1 item, 2 items
    // Korean: 0개, 1개, 2개 (복수형 없음)
    // Japanese: 0個, 1個, 2個 (복수형 없음)

    match language
      "en" => {
        if count == 1
          return "singular"
        else
          return "plural"
        end
      }
      "ko" | "ja" | "zh" => {
        // 한글, 일본어, 중국어는 복수형 구분 없음
        return "neutral"
      }
      _ => "plural"
    end
  end

pub fn translate_plural(key: string, count: i32, language: string) -> Result<string, string>
  intent "복수형을 고려한 번역"
  do
    let plural_form = get_plural_form(count, language)
    let plural_key = key + "." + plural_form

    return translate(plural_key, language)
  end

// ============================================================================
// 번역 캐싱 (Performance Optimization)
// ============================================================================

pub struct TranslationCache {
  cache: map<string, string>,
  max_size: i32,
  hit_count: i32,
  miss_count: i32
}

pub fn create_translation_cache(max_size: i32) -> TranslationCache
  intent "번역 캐시 생성"
  do
    return TranslationCache {
      cache: {},
      max_size: max_size,
      hit_count: 0,
      miss_count: 0
    }
  end

pub fn cache_get_or_translate(cache: &mut TranslationCache, key: string, language: string) -> Result<string, string>
  intent "캐시에서 번역 조회, 없으면 생성"
  do
    let cache_key = key + ":" + language

    // 캐시 히트
    match cache.cache[cache_key]
      translated => {
        cache.hit_count = cache.hit_count + 1
        return Ok(translated)
      }
      _ => {}
    end

    // 캐시 미스: 번역 수행
    match translate(key, language)
      Ok(translated) => {
        cache.miss_count = cache.miss_count + 1

        // 캐시 크기 제한
        if cache.cache.size() >= cache.max_size
          // LRU 제거 (가장 오래된 항목 삭제)
          // TODO: 실제 LRU 구현
        end

        cache.cache[cache_key] = translated
        return Ok(translated)
      }
      Err(e) => Err(e)
    end
  end

pub fn get_cache_stats(cache: TranslationCache) -> Result<string, string>
  intent "캐시 통계 반환"
  do
    let total = cache.hit_count + cache.miss_count
    let hit_rate = if total > 0 then
      (cache.hit_count * 100) / total
    else
      0
    end

    let stats = "캐시 통계: 히트=" + string_of_int(cache.hit_count) +
                ", 미스=" + string_of_int(cache.miss_count) +
                ", 히트율=" + string_of_int(hit_rate) + "%"

    return Ok(stats)
  end

// ============================================================================
// RTL (Right-to-Left) 언어 지원
// ============================================================================

pub fn is_rtl_language(language: string) -> bool
  intent "RTL 언어 여부 확인"
  do
    match language
      "ar" | "he" | "fa" | "ur" => true
      _ => false
    end
  end

pub fn get_text_direction(language: string) -> string
  intent "텍스트 방향 반환 (ltr/rtl)"
  do
    if is_rtl_language(language)
      return "rtl"
    else
      return "ltr"
    end
  end

