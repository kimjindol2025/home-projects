pub fn detect_language_from_accept_header(accept_language: string) -> string
  intent "Accept-Language 헤더에서 언어 자동 감지"
  do
    // Accept-Language: ko-KR,ko;q=0.9,en;q=0.8
    if string_contains(accept_language, "ko")
      return "ko"
    else if string_contains(accept_language, "en")
      return "en"
    else if string_contains(accept_language, "ja")
      return "ja"
    else if string_contains(accept_language, "zh")
      return "zh"
    else if string_contains(accept_language, "es")
      return "es"
    else if string_contains(accept_language, "fr")
      return "fr"
    else
      return "en"  // 기본값: 영어
    end
  end

