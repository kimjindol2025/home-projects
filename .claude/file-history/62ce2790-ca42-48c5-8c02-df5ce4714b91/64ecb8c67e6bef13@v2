// 유사도 및 추천
// ============================================================================

pub fn deep_learning_recommendation(user_embedding: Embedding, item_embeddings: map<string, Embedding>) -> array<string>
  intent "딥러닝 기반 추천"
  do
    let recommendations = []
    let scores = {}

    // 각 아이템과의 유사도 계산 (코사인 유사도)
    for item_id in item_embeddings.keys()
      let item_embedding = item_embeddings[item_id]
      let similarity = cosine_similarity(user_embedding.vector, item_embedding.vector)

      scores[item_id] = similarity
    end

    // Top-K 추천 (K=10)
    let top_items = get_top_k_items(scores, 10)

    return top_items
  end

pub fn contextual_bandit_recommendation(context: array<f64>, model: NeuralNetwork, candidates: array<string>) -> string
  intent "컨텍스트 밴딧: 탐색-활용 균형"
  do
    // Thompson Sampling을 이용한 최적화
    let scores = {}

    for i in 0 to array_length(candidates)
      let candidate_id = candidates[i]

      match forward_pass(model, context)
        Ok(score) => {
          // Epsilon-greedy: 90% 최고 선택, 10% 탐색
          let random = random_0_to_1()
          if random < 0.1
            scores[candidate_id] = random_0_to_1()  // 탐색
          else
            scores[candidate_id] = score  // 활용
          end
        }
        Err(_) => {}
      end
    end

    let best_candidate = ""
    let best_score = -1.0

    for candidate_id in scores.keys()
      let score = scores[candidate_id]
      if score > best_score
        best_score = score
        best_candidate = candidate_id
      end
    end

    return best_candidate
  end

