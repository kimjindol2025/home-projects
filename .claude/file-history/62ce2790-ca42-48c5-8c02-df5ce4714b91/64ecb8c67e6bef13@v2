  name: string,
  architecture: string,  // "sequential", "collaborative", "content_based"
  input_size: i32,
  hidden_layer_sizes: array<i32>,
  output_size: i32,
  activation: string,  // "relu", "sigmoid", "tanh"
  loss: f64,
  accuracy: f64,
  epoch: i32,
  trained: bool
}

pub struct Layer {
  layer_id: string,
  layer_type: string,  // "dense", "embedding", "dropout", "batchnorm"
  input_size: i32,
  output_size: i32,
  weights: array<f64>,
  bias: array<f64>,
  activation: string
}

pub struct Embedding {
  embedding_id: string,
  entity_type: string,  // "user", "post", "tag"
  entity_id: string,
  vector: array<f64>,
  dimension: i32,
  norm: f64
}

pub struct TrainingData {
  samples: i32,
  features: array<array<f64>>,
  labels: array<f64>,
  batch_size: i32,
  learning_rate: f64,
  epochs: i32
}

