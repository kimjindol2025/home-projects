pub fn evaluate_model(model: NeuralNetwork, test_data: array<array<f64>>, test_labels: array<f64>) -> Result<f64, string>
  intent "모델 정확도 평가"
  do
    let correct = 0
    let total = array_length(test_data)

    for i in 0 to total
      match forward_pass(model, test_data[i])
        Ok(prediction) => {
          let predicted_label = if prediction > 0.5 then 1.0 else 0.0 end
          if predicted_label == test_labels[i]
            correct = correct + 1
          end
        }
        Err(_) => {}
      end
    end

    let accuracy = (correct * 100) / total
    return Ok(accuracy)
  end

pub fn calculate_ndcg(predictions: array<f64>, relevant: array<i32>, k: i32) -> f64
  intent "NDCG (정규화된 할인 누적 이득) 계산"
  do
    // 추천 순서의 관련성 측정
    let dcg = 0.0

    for i in 0 to min(k, array_length(predictions))
      let relevance = relevant[i]
      if relevance > 0
        dcg = dcg + (relevance / log2(i + 2.0))  // log2(i+2)로 할인
      end
    end

    // IDCG (이상적인 DCG) 계산
    let idcg = 0.0
    for i in 0 to min(k, array_length(relevant))
      if relevant[i] > 0
        idcg = idcg + (relevant[i] / log2(i + 2.0))
      end
    end

    if idcg == 0.0
      return 0.0
    end

    return dcg / idcg
  end

pub fn calculate_mean_reciprocal_rank(predictions: array<string>, ground_truth: string) -> f64
  intent "MRR (평균 상호 순위) 계산"
  do
    // 첫 관련 아이템의 순위의 역수
    for i in 0 to array_length(predictions)
      if predictions[i] == ground_truth
        return 1.0 / (i + 1.0)
      end
    end

    return 0.0
  end

