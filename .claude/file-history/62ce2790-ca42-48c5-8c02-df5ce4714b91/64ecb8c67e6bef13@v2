pub fn learn_user_embeddings(users: array<string>, interactions: array<array<f64>>) -> map<string, Embedding>
  intent "사용자 임베딩 학습 (Matrix Factorization)"
  do
    let embeddings = {}

    // 각 사용자의 32차원 임베딩 벡터 학습
    for i in 0 to array_length(users)
      let user_id = users[i]
      let interaction_vector = interactions[i]

      // SVD 또는 SGD로 임베딩 계산
      let embedding = Embedding {
        embedding_id: generate_uuid(),
        entity_type: "user",
        entity_id: user_id,
        vector: normalize_vector(interaction_vector),
        dimension: 32,
        norm: calculate_norm(interaction_vector)
      }

      embeddings[user_id] = embedding
    end

    return embeddings
  end

pub fn learn_item_embeddings(items: array<string>, features: array<array<f64>>) -> map<string, Embedding>
  intent "아이템 임베딩 학습"
  do
    let embeddings = {}

    for i in 0 to array_length(items)
      let item_id = items[i]
      let feature_vector = features[i]

      let embedding = Embedding {
        embedding_id: generate_uuid(),
        entity_type: "post",
        entity_id: item_id,
        vector: normalize_vector(feature_vector),
        dimension: 32,
        norm: calculate_norm(feature_vector)
      }

      embeddings[item_id] = embedding
    end

    return embeddings
  end

