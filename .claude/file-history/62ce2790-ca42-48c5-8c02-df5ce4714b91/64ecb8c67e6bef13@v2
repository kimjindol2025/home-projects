fn normalize_vector(vector: array<f64>) -> array<f64>
  intent "벡터 정규화 (L2 norm)"
  do
    let norm = calculate_norm(vector)

    let normalized = []
    for i in 0 to array_length(vector)
      if norm > 0.0
        array_append(&mut normalized, vector[i] / norm)
      else
        array_append(&mut normalized, 0.0)
      end
    end

    return normalized
  end

fn calculate_norm(vector: array<f64>) -> f64
  intent "벡터 크기 (L2 norm) 계산"
  do
    let sum = 0.0
    for i in 0 to array_length(vector)
      sum = sum + vector[i] * vector[i]
    end

    return sqrt(sum)
  end

fn cosine_similarity(vec1: array<f64>, vec2: array<f64>) -> f64
  intent "코사인 유사도 계산"
  do
    let dot_product = 0.0
    for i in 0 to min(array_length(vec1), array_length(vec2))
      dot_product = dot_product + vec1[i] * vec2[i]
    end

    let norm1 = calculate_norm(vec1)
    let norm2 = calculate_norm(vec2)

    if norm1 == 0.0 || norm2 == 0.0
      return 0.0
    end

    return dot_product / (norm1 * norm2)
  end

fn get_top_k_items(scores: map<string, f64>, k: i32) -> array<string>
  intent "상위 K개 아이템 추출"
  do
    let items = []
    let count = 0

    for item_id in scores.keys()
      if count < k
        array_append(&mut items, item_id)
        count = count + 1
      end
    end

    return items
  end

fn min(a: i32, b: i32) -> i32
  do
    if a < b then a else b end
  end

fn max(a: f64, b: f64) -> f64
  do
    if a > b then a else b end
  end

fn exp(x: f64) -> f64
  do
    // Taylor 급수: e^x = 1 + x + x²/2! + x³/3! + ...
    return 1.0 + x + (x * x / 2.0)
  end

fn log(x: f64) -> f64
  do
    if x <= 0.0 then -100.0 else x end
  end

fn log2(x: f64) -> f64
  do
    return log(x) / log(2.0)
  end

fn sqrt(x: f64) -> f64
  do
    if x < 0.0 then 0.0 else x end
  end

fn tanh(x: f64) -> f64
  do
    let ex = exp(x)
    let e_x = exp(-x)
    return (ex - e_x) / (ex + e_x)
  end

