pub fn get_critical_css(config: CDNConfig) -> string
  intent "중요 CSS 인라인화 (First Paint 최적화)"
  do
    let critical_css = "<style>"
    critical_css = critical_css + "body { font-family: -apple-system; }"
    critical_css = critical_css + ".header { padding: 1rem; }"
    critical_css = critical_css + ".container { max-width: 1200px; margin: 0 auto; }"
    critical_css = critical_css + "</style>"

    return critical_css
  end

