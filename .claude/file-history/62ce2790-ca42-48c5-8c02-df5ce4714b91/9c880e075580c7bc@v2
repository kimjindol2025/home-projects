pub fn get_cdn_url(asset_path: string, config: CDNConfig) -> string
  intent "CDN URL 생성"
  do
    // https://cdn.freelang.kr/path/to/asset.png
    let url = "https://" + config.domain + asset_path

    return url
  end

pub fn get_optimized_image_url(image_path: string, width: i32, height: i32, quality: i32, config: CDNConfig) -> string
  intent "최적화된 이미지 URL 생성 (동적 리사이징)"
  do
    // 쿼리 파라미터로 최적화 옵션 지정
    let url = get_cdn_url(image_path, config)

    // https://cdn.freelang.kr/images/post-1.jpg?w=800&h=600&q=80
    url = url + "?w=" + string_of_int(width) +
               "&h=" + string_of_int(height) +
               "&q=" + string_of_int(quality)

    return url
  end

pub fn get_minified_asset_url(asset_path: string, config: CDNConfig) -> string
  intent "축소된 자산 URL (자동 CSS/JS 축소)"
  do
    let url = get_cdn_url(asset_path, config)

    // 파일 확장자 감지
    if string_ends_with(asset_path, ".css")
      url = url + "?minify=true"
    else if string_ends_with(asset_path, ".js")
      url = url + "?minify=true"
    end

    return url
  end

pub fn get_compressed_asset_url(asset_path: string, config: CDNConfig) -> string
  intent "압축된 자산 URL (Brotli/Gzip)"
  do
    let url = get_cdn_url(asset_path, config)

    // 클라이언트가 Accept-Encoding을 지원하면 자동 압축
    // CDN이 br (Brotli) > gzip > 원본 순서로 제공

    return url
  end

// ============================================================================
// 캐시 관리
// ============================================================================

pub fn set_cache_headers(asset: CDNAsset, config: CDNConfig) -> map<string, string>
  intent "캐시 제어 헤더 설정"
  do
    let headers = {}

    // Cache-Control
    match asset.content_type
      "text/html" => {
        // HTML은 짧은 캐시 (유효성 검증)
        headers["Cache-Control"] = "public, max-age=3600, must-revalidate"
      }
      "text/css" | "application/javascript" => {
        // CSS/JS는 장기 캐시 (파일명 해시 사용)
        headers["Cache-Control"] = "public, max-age=31536000, immutable"
      }
      "image/png" | "image/jpeg" | "image/gif" | "image/webp" => {
        // 이미지는 장기 캐시
        headers["Cache-Control"] = "public, max-age=31536000, immutable"
      }
      _ => {
        // 기타 파일
        headers["Cache-Control"] = "public, max-age=" + string_of_int(config.cache_ttl_seconds)
      }
    end

    // ETag (파일 변경 감지)
    headers["ETag"] = "\"" + asset.file_hash + "\""

    // Last-Modified
    headers["Last-Modified"] = unix_timestamp_to_http_date(asset.last_modified)

    // Vary (캐시 변형 지정)
    headers["Vary"] = "Accept-Encoding, Accept"

    // CORS
    headers["Access-Control-Allow-Origin"] = "*"

    // Security
    headers["X-Content-Type-Options"] = "nosniff"
    headers["X-Frame-Options"] = "SAMEORIGIN"

    return headers
  end

