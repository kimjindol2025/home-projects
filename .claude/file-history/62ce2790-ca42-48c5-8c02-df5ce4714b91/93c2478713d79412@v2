### 코드 예시 3: 에러 처리 & 응답 (20줄)

```freelang
fn handle_request(req: HttpRequest) -> HttpResponse {
  intent "요청을 처리하고 응답 생성"
  do
    // 1. 레이트 제한 확인
    let ip = req.remote_ip
    match security::check_rate_limit(ip)
      Ok(true) => {}
      Err(e) => {
        return create_error_response(429, e)  // Too Many Requests
      }
    end

    // 2. 라우팅
    if req.method == "GET" && req.path == "/api/blogs"
      return handle_list_posts()
    else if req.method == "POST" && req.path == "/api/blogs"
      return handle_create_post(req)
    else if req.method == "GET" && starts_with(req.path, "/api/blogs/")
      let id = extract_id_from_path(req.path)
      return handle_get_post(id)
    else
      return create_error_response(404, "Not Found")
    end
  end
}

fn create_error_response(status: i32, message: string) -> HttpResponse {
  intent "에러 응답 생성"
  do
    let json = "{\"error\":\"" + message + "\"}"
    return HttpResponse {
      status: status,
      headers: { "Content-Type": "application/json" },
      body: json
    }
  end
}
```

**에러 처리의 3단계**:
1. **검증** (레이트 제한, 인증)
2. **라우팅** (경로에 맞는 핸들러 호출)
3. **에러 반환** (실패하면 적절한 상태 코드)

