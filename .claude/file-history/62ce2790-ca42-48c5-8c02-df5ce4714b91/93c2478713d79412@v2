### 코드 예시 2: JSON 직렬화 (25줄)

포스트 데이터를 JSON 문자열로 변환:

```freelang
fn serialize_post_to_json(post: BlogPost) -> string {
  intent "BlogPost 구조체를 JSON 문자열로"
  do
    let json = "{"

    // 각 필드를 JSON 형식으로
    json = json + "\"id\":" + int_to_string(post.id) + ","
    json = json + "\"title\":\"" + escape_json_string(post.title) + "\","
    json = json + "\"content\":\"" + escape_json_string(post.content) + "\","
    json = json + "\"author\":\"" + post.author + "\","
    json = json + "\"created_at\":\"" + post.created_at + "\","
    json = json + "\"views\":" + int_to_string(post.views) + ","
    json = json + "\"likes\":" + int_to_string(post.likes)

    json = json + "}"
    return json
  end
}

fn escape_json_string(s: string) -> string {
  intent "JSON 이스케이프 처리"
  do
    let result = ""
    for i = 0; i < length(s); i++
      let char = get_char_at(s, i)
      if char == "\""
        result = result + "\\\""  // " → \"
      else if char == "\\"
        result = result + "\\\\"  // \ → \\
      else if char == "\n"
        result = result + "\\n"   // 줄바꿈
      else
        result = result + char
      end
    end
    return result
  end
}
```

**왜 이렇게 복잡한가?**
- `"Hello \"World\""` ← 문자열 내 따옴표는 이스케이프 필요
- `C:\Path\To\File` ← 역슬래시도 이스케이프 필요
- 이스케이프 없으면 JSON 파서가 깨짐

**실제 동작**:
```
입력: Post { title: "10 "Best" Tips", ... }
출력: {"title":"10 \"Best\" Tips", ...}
```

