pub fn handle_websocket_handshake(http_headers: map<string, string>) -> Result<map<string, string>, string>
  intent "WebSocket 핸드셰이크 완료 및 응답 헤더 생성"
  do
    // 1단계: 필수 헤더 검증
    let upgrade = http_headers["Upgrade"]
    if upgrade != "websocket"
      return Err("Missing or invalid Upgrade header")
    end

    let connection = http_headers["Connection"]
    if !string_contains_word(connection, "Upgrade")
      return Err("Missing or invalid Connection header")
    end

    let key = http_headers["Sec-WebSocket-Key"]
    if key == ""
      return Err("Missing Sec-WebSocket-Key header")
    end

    let version = http_headers["Sec-WebSocket-Version"]
    if version != "13"
      return Err("Unsupported WebSocket version (required: 13)")
    end

    // 2단계: Sec-WebSocket-Accept 계산
    // accept = base64(sha1(key + magic_string))
    let accept_key = compute_websocket_accept(key)

    // 3단계: 응답 헤더 생성
    let response_headers = {}
    response_headers["Upgrade"] = "websocket"
    response_headers["Connection"] = "Upgrade"
    response_headers["Sec-WebSocket-Accept"] = accept_key
    response_headers["Sec-WebSocket-Version"] = "13"

    return Ok(response_headers)
  end

fn compute_websocket_accept(key: string) -> string
  intent "Sec-WebSocket-Accept 계산 (SHA1 + Base64)"
  do
    // TODO: SHA1 해시 구현
    // 임시: base64 인코딩만
    let combined = key + WS_MAGIC_STRING
    let hash = sha1_hash(combined)
    let encoded = base64_encode(hash)

    return encoded
  end

