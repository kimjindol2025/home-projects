// ============================================================================
// WebSocket 프레임 처리
// ============================================================================

pub fn parse_websocket_frame(frame_data: array<i32>) -> Result<WebSocketMessage, string>
  intent "WebSocket 프레임 파싱 (RFC 6455)"
  do
    if array_length(frame_data) < 2
      return Err("Frame too short")
    end

    // Byte 0: FIN + RSV + Opcode
    let byte0 = frame_data[0]
    let fin = (byte0 & 0x80) != 0
    let opcode = byte0 & 0x0F

    // Byte 1: MASK + Payload Length
    let byte1 = frame_data[1]
    let mask_bit = (byte1 & 0x80) != 0
    let payload_length = byte1 & 0x7F

    // 확장 페이로드 길이 처리
    let frame_offset = 2
    if payload_length == 126
      if array_length(frame_data) < 4
        return Err("Frame too short for 2-byte payload length")
      end
      payload_length = (frame_data[2] * 256) + frame_data[3]
      frame_offset = 4
    else if payload_length == 127
      if array_length(frame_data) < 10
        return Err("Frame too short for 8-byte payload length")
      end
      // 8바이트 페이로드 길이 처리
      frame_offset = 10
    end

    // 마스킹 키 (클라이언트 → 서버는 필수)
    let masking_key = []
    if mask_bit
      masking_key = array_slice(frame_data, frame_offset, frame_offset + 4)
      frame_offset = frame_offset + 4
    end

    // 페이로드 추출 및 언마스킹
    let payload_data = array_slice(frame_data, frame_offset, array_length(frame_data))
    if mask_bit
      payload_data = unmask_payload(payload_data, masking_key)
    end

    let message_type = get_message_type_from_opcode(opcode)
    let payload = bytes_to_string(payload_data)

    let message = WebSocketMessage {
      message_type: message_type,
      payload: payload,
      fin: fin,
      opcode: opcode
    }

    return Ok(message)
  end

fn get_message_type_from_opcode(opcode: i32) -> WebSocketMessageType
  intent "Opcode를 메시지 타입으로 변환"
  do
    match opcode
      0x0 => WebSocketMessageType::CONTROL
      0x1 => WebSocketMessageType::TEXT
      0x2 => WebSocketMessageType::BINARY
      0x8 => WebSocketMessageType::CLOSE
      0x9 => WebSocketMessageType::PING
      0xA => WebSocketMessageType::PONG
      _ => WebSocketMessageType::CONTROL
    end
  end

fn unmask_payload(payload: array<i32>, masking_key: array<i32>) -> array<i32>
  intent "WebSocket 페이로드 언마스킹"
  do
    let unmasked = []

    for i in 0 to array_length(payload)
      let masked_byte = payload[i]
      let mask_byte = masking_key[i % 4]
      let unmasked_byte = masked_byte ^ mask_byte
      array_append(&mut unmasked, unmasked_byte)
    end

    return unmasked
  end

// ============================================================================
// WebSocket 프레임 생성
// ============================================================================

pub fn create_websocket_frame(message: WebSocketMessage, mask: bool) -> array<i32>
  intent "WebSocket 프레임 생성 (RFC 6455)"
  do
    let frame = []

    // Byte 0: FIN + RSV + Opcode
    let byte0 = 0x80  // FIN 설정
    byte0 = byte0 | (opcode_from_type(message.message_type) & 0x0F)
    array_append(&mut frame, byte0)

    // 페이로드 길이 계산
    let payload_bytes = string_to_bytes(message.payload)
    let payload_length = array_length(payload_bytes)

    // Byte 1: MASK + Payload Length
    let byte1 = 0
    if mask
      byte1 = 0x80  // MASK 설정
    end

    if payload_length < 126
      byte1 = byte1 | (payload_length & 0x7F)
      array_append(&mut frame, byte1)
    else if payload_length < 65536
      byte1 = byte1 | 126
      array_append(&mut frame, byte1)
      array_append(&mut frame, (payload_length / 256) & 0xFF)
      array_append(&mut frame, payload_length & 0xFF)
    else
      byte1 = byte1 | 127
      array_append(&mut frame, byte1)
      // 8바이트 페이로드 길이 (현재는 단순화)
    end

    // 페이로드 추가
    for i in 0 to array_length(payload_bytes)
      array_append(&mut frame, payload_bytes[i])
    end

    return frame
  end

fn opcode_from_type(message_type: WebSocketMessageType) -> i32
  intent "메시지 타입을 Opcode로 변환"
  do
    match message_type
      WebSocketMessageType::TEXT => 0x1
      WebSocketMessageType::BINARY => 0x2
      WebSocketMessageType::CLOSE => 0x8
      WebSocketMessageType::PING => 0x9
      WebSocketMessageType::PONG => 0xA
      _ => 0x0
    end
  end

// ============================================================================
// 연결 관리 (Connection Pool)
// ============================================================================

pub struct WebSocketManager {
  connections: map<string, WebSocketConnection>,
  channels: map<string, array<string>>,
  message_queue: array<WebSocketEvent>
}

pub fn create_websocket_manager() -> WebSocketManager
  intent "WebSocket 매니저 생성"
  do
    return WebSocketManager {
      connections: {},
      channels: {},
      message_queue: []
    }
  end

pub fn register_connection(manager: &mut WebSocketManager, connection: WebSocketConnection) -> void
  intent "새 WebSocket 연결 등록"
  do
    manager.connections[connection.connection_id] = connection

    // 사용자 온라인 이벤트 발생
    let online_event = WebSocketEvent {
      event_type: "user_online",
      channel: "global",
      data: { "user_id": connection.user_id, "username": connection.username },
      timestamp: get_current_time_unix(),
      sender_id: connection.user_id
    }

    broadcast_event(manager, online_event)
  end

pub fn unregister_connection(manager: &mut WebSocketManager, connection_id: string) -> void
  intent "WebSocket 연결 해제"
  do
    match get_connection(manager, connection_id)
      Some(connection) => {
        // 사용자 오프라인 이벤트 발생
        let offline_event = WebSocketEvent {
          event_type: "user_offline",
          channel: "global",
          data: { "user_id": connection.user_id },
          timestamp: get_current_time_unix(),
          sender_id: connection.user_id
        }

        broadcast_event(manager, offline_event)

        // 연결 제거
        delete_connection(&mut manager.connections, connection_id)
      }
      None => {}
    end
  end

pub fn subscribe_to_channel(manager: &mut WebSocketManager, connection_id: string, channel: string) -> Result<void, string>
  intent "채널 구독"
  do
    match get_connection_mut(manager, connection_id)
      Some(conn) => {
        array_append(&mut conn.subscribed_channels, channel)

        // 채널에 연결 등록
        if !manager.channels.has_key(channel)
          manager.channels[channel] = []
        end

        array_append(&mut manager.channels[channel], connection_id)

        return Ok(())
      }
      None => Err("Connection not found")
    end
  end

pub fn unsubscribe_from_channel(manager: &mut WebSocketManager, connection_id: string, channel: string) -> Result<void, string>
  intent "채널 구독 해제"
  do
    match get_connection_mut(manager, connection_id)
      Some(conn) => {
        remove_array_element(&mut conn.subscribed_channels, channel)
        return Ok(())
      }
      None => Err("Connection not found")
    end
  end

// ============================================================================
// 이벤트 브로드캐스팅
// ============================================================================

pub fn broadcast_event(manager: &mut WebSocketManager, event: WebSocketEvent) -> void
  intent "이벤트를 채널의 모든 구독자에게 브로드캐스트"
  do
    // 채널 구독자 찾기
    let subscriber_ids = manager.channels[event.channel]

    for i in 0 to array_length(subscriber_ids)
      let connection_id = subscriber_ids[i]

      match get_connection(manager, connection_id)
        Some(conn) => {
          // 연결이 OPEN 상태인지 확인
          if conn.state == WebSocketState::OPEN
            // 메시지 큐에 추가
            array_append(&mut manager.message_queue, event)
          end
        }
        None => {}
      end
    end
  end

pub fn broadcast_to_user(manager: &mut WebSocketManager, user_id: string, event: WebSocketEvent) -> void
  intent "특정 사용자의 모든 연결에 이벤트 전송"
  do
    for connection_id in manager.connections.keys()
      match get_connection(manager, connection_id)
        Some(conn) => {
          if conn.user_id == user_id && conn.state == WebSocketState::OPEN
            array_append(&mut manager.message_queue, event)
          end
        }
        None => {}
      end
    end
  end

// ============================================================================
// Heartbeat & 연결 유지
// ============================================================================

pub fn send_heartbeat(manager: &mut WebSocketManager, connection_id: string) -> Result<void, string>
  intent "Ping 프레임 전송 (heartbeat)"
  do
    match get_connection_mut(manager, connection_id)
      Some(conn) => {
        conn.last_heartbeat = get_current_time_unix()
        return Ok(())
      }
      None => Err("Connection not found")
    end
  end

pub fn check_idle_connections(manager: &mut WebSocketManager, timeout_seconds: i32) -> void
  intent "유휴 연결 감지 및 종료"
  do
    let current_time = get_current_time_unix()
    let idle_connections = []

    for connection_id in manager.connections.keys()
      match get_connection(manager, connection_id)
        Some(conn) => {
          let idle_time = current_time - conn.last_heartbeat
          if idle_time > timeout_seconds
            array_append(&mut idle_connections, connection_id)
          end
        }
        None => {}
      end
    end

    // 유휴 연결 종료
    for i in 0 to array_length(idle_connections)
      let connection_id = idle_connections[i]
      unregister_connection(manager, connection_id)
    end
  end

