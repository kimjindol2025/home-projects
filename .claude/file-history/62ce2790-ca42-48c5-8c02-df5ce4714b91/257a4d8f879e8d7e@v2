// ============================================================================
// Comments Realtime Module - 실시간 댓글 시스템
// ============================================================================
// 기능: 댓글 작성, 실시간 동기화, 스레드 지원
// 특징: WebSocket 기반 실시간 푸시

use std::io::*

// ============================================================================
// PART 1: 댓글 구조체
// ============================================================================

pub struct Comment {
  id: i32,
  post_id: i32,
  user_id: i32,
  author: string,
  content: string,
  created_at: string,
  updated_at: string,
  likes: i32,
  replies: i32,
  is_deleted: bool
}

pub struct CommentThread {
  root_comment_id: i32,
  replies: array<Comment>,
  reply_count: i32
}

pub struct RealtimeCommentUpdate {
  event_type: string,  // "new", "edit", "delete", "like"
  post_id: i32,
  comment_id: i32,
  comment: Comment,
  timestamp: string
}

pub struct CommentStats {
  total_comments: i32,
  total_threads: i32,
  avg_replies_per_thread: f64,
  most_active_post_id: i32,
  most_liked_comment_id: i32
}

// ============================================================================
// PART 2: 전역 댓글 저장소
// ============================================================================

pub let GLOBAL_COMMENTS = {}  // map<i32, Comment>
pub let GLOBAL_COMMENT_THREADS: array<CommentThread> = []
pub let GLOBAL_COMMENT_ID_COUNTER = 1
pub let GLOBAL_REALTIME_QUEUE: array<RealtimeCommentUpdate> = []

// ============================================================================
// PART 3: 댓글 생성 & 관리
// ============================================================================

pub fn create_comment(post_id: i32, user_id: i32, author: string, content: string) -> Result<Comment, string>
  intent "새 댓글 생성"
  do
    // 1. 입력 검증
    if length(content) < 1
      return Err("댓글 내용은 필수입니다")
    end

    if length(content) > 5000
      return Err("댓글은 5000자 이하여야 합니다")
    end

    // 2. 댓글 객체 생성
    let comment = Comment {
      id: GLOBAL_COMMENT_ID_COUNTER,
      post_id: post_id,
      user_id: user_id,
      author: author,
      content: content,
      created_at: get_current_time(),
      updated_at: get_current_time(),
      likes: 0,
      replies: 0,
      is_deleted: false
    }

    // 3. 저장
    GLOBAL_COMMENTS[comment.id] = comment
    GLOBAL_COMMENT_ID_COUNTER = GLOBAL_COMMENT_ID_COUNTER + 1

    // 4. 실시간 이벤트 큐에 추가
    let update = RealtimeCommentUpdate {
      event_type: "new",
      post_id: post_id,
      comment_id: comment.id,
      comment: comment,
      timestamp: get_current_time()
    }
    GLOBAL_REALTIME_QUEUE = array_append(GLOBAL_REALTIME_QUEUE, update)

    println("💬 새 댓글: #" + int_to_string(comment.id) + " (포스트 #" + int_to_string(post_id) + ")")
    return Ok(comment)
  end

pub fn edit_comment(comment_id: i32, new_content: string) -> Result<Comment, string>
  intent "댓글 수정"
  do
    if !GLOBAL_COMMENTS.has_key(comment_id)
      return Err("댓글을 찾을 수 없음")
    end

    if length(new_content) < 1 || length(new_content) > 5000
      return Err("댓글 길이가 유효하지 않음")
    end

    let comment = GLOBAL_COMMENTS[comment_id]
    comment.content = new_content
    comment.updated_at = get_current_time()

    // 실시간 이벤트
    let update = RealtimeCommentUpdate {
      event_type: "edit",
      post_id: comment.post_id,
      comment_id: comment_id,
      comment: comment,
      timestamp: get_current_time()
    }
    GLOBAL_REALTIME_QUEUE = array_append(GLOBAL_REALTIME_QUEUE, update)

    println("✏️ 댓글 수정: #" + int_to_string(comment_id))
    return Ok(comment)
  end

pub fn delete_comment(comment_id: i32) -> Result<void, string>
  intent "댓글 삭제 (소프트 삭제)"
  do
    if !GLOBAL_COMMENTS.has_key(comment_id)
      return Err("댓글을 찾을 수 없음")
    end

    let comment = GLOBAL_COMMENTS[comment_id]
    comment.is_deleted = true
    comment.content = "[삭제된 댓글]"

    // 실시간 이벤트
    let update = RealtimeCommentUpdate {
      event_type: "delete",
      post_id: comment.post_id,
      comment_id: comment_id,
      comment: comment,
      timestamp: get_current_time()
    }
    GLOBAL_REALTIME_QUEUE = array_append(GLOBAL_REALTIME_QUEUE, update)

    println("🗑️ 댓글 삭제: #" + int_to_string(comment_id))
    return Ok(void)
  end

pub fn like_comment(comment_id: i32) -> Result<void, string>
  intent "댓글 좋아요"
  do
    if !GLOBAL_COMMENTS.has_key(comment_id)
      return Err("댓글을 찾을 수 없음")
    end

    let comment = GLOBAL_COMMENTS[comment_id]
    comment.likes = comment.likes + 1

    // 실시간 이벤트
    let update = RealtimeCommentUpdate {
      event_type: "like",
      post_id: comment.post_id,
      comment_id: comment_id,
      comment: comment,
      timestamp: get_current_time()
    }
    GLOBAL_REALTIME_QUEUE = array_append(GLOBAL_REALTIME_QUEUE, update)

    println("❤️ 댓글 좋아요: #" + int_to_string(comment_id) + " (좋아요: " + int_to_string(comment.likes) + ")")
    return Ok(void)
  end

