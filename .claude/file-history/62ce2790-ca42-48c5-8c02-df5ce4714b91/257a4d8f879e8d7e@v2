  do
    let total_comments = length(GLOBAL_COMMENTS)
    let total_threads = length(GLOBAL_COMMENT_THREADS)
    let avg_replies = 0.0

    if total_threads > 0
      let total_replies = 0
      // TODO: 모든 스레드의 replies 합산
      avg_replies = (total_replies as f64) / (total_threads as f64)
    end

    let stats = CommentStats {
      total_comments: total_comments,
      total_threads: total_threads,
      avg_replies_per_thread: avg_replies,
      most_active_post_id: 0,
      most_liked_comment_id: 0
    }

    return stats
  end

