pub fn reply_to_comment(parent_comment_id: i32, user_id: i32, author: string, content: string) -> Result<Comment, string>
  intent "댓글에 대댓글 작성"
  do
    match get_comment_by_id(parent_comment_id)
      Ok(parent) => {
        // 대댓글 생성
        let comment = Comment {
          id: GLOBAL_COMMENT_ID_COUNTER,
          post_id: parent.post_id,
          user_id: user_id,
          author: author,
          content: content,
          created_at: get_current_time(),
          updated_at: get_current_time(),
          likes: 0,
          replies: 0,
          is_deleted: false
        }

        GLOBAL_COMMENTS[comment.id] = comment
        GLOBAL_COMMENT_ID_COUNTER = GLOBAL_COMMENT_ID_COUNTER + 1

        // 부모 댓글의 replies 증가
        parent.replies = parent.replies + 1

        // 실시간 이벤트
        let update = RealtimeCommentUpdate {
          event_type: "new_reply",
          post_id: parent.post_id,
          comment_id: comment.id,
          comment: comment,
          timestamp: get_current_time()
        }
        GLOBAL_REALTIME_QUEUE = array_append(GLOBAL_REALTIME_QUEUE, update)

        println("💬 대댓글: #" + int_to_string(comment.id) + " ← #" + int_to_string(parent_comment_id))
        return Ok(comment)
      }
      Err(e) => return Err(e)
    end
  end

