# ============================================================================
# FreeLang Environment Configuration Example
# Copy this file to .env and fill in your values
# ============================================================================

# Server Configuration
NODE_ENV=development
SERVER_PORT=3001
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# OAuth Configuration
# Google (get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub (get from https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Naver (get from https://developers.naver.com)
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=2592000

SESSION_SECRET=your-session-secret-change-this

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/freelang
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL=86400

# Cache (Redis)
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600
CACHE_ENABLED=true

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=admin123

# API Documentation
API_DOCS_ENABLED=true
SWAGGER_UI_PATH=/api/docs

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/freelang.log

# Email (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_ENDPOINT=https://analytics.example.com

# SSL/TLS
SSL_ENABLED=true
SSL_CERT_PATH=/etc/letsencrypt/live/253.dclub.kr/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/253.dclub.kr/privkey.pem

# Feature Flags
FEATURE_OAUTH=true
FEATURE_ADMIN_PANEL=true
FEATURE_API_DOCS=true
FEATURE_ANALYTICS=true
