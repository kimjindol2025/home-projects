name: FreeLang-C CI/CD

on:
  push:
    branches: [ master, main ]
  pull_request:
    branches: [ master, main ]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  validate:
    name: Validate Repository
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Check structure
        run: |
          echo "✅ FreeLang-C Repository"
          echo "📂 Contents:"
          ls -lah | head -20

      - name: Validate files
        run: |
          echo "📚 Documentation:"
          ls -1 *.md 2>/dev/null || echo "Found markdown files"

      - name: Status
        run: |
          echo "✅ Validation complete"
