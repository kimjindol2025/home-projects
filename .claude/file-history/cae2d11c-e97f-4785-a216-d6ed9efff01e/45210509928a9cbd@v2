## 📚 문법 가이드

### 리터럴

```mindlang
42              // 숫자
3.14            // 실수
1e10            // 지수 표기법
"hello"         // 문자열
true, false     // 불린
null            // null
[1, 2, 3]       // 배열
{ x: 1, y: 2 }  // 객체
```

### 변수 & 함수

```mindlang
let x = 5;           // 변수 선언
let a = 1, b = 2;    // 다중 선언

fn add(a, b) {       // 함수
  return a + b;
}

fn factorial(n) {
  if (n <= 1) {
    return 1;
  }
  return n * factorial(n - 1);
}
```

### 제어문

```mindlang
// if-else
if (x > 10) {
  // ...
} else if (x > 5) {
  // ...
} else {
  // ...
}

// while
while (x < 100) {
  x = x + 1;
}

// for
for (let i = 0; i < 10; i = i + 1) {
  // ...
}

// break, continue
while (true) {
  if (shouldBreak) break;
  if (shouldSkip) continue;
}
```

### 예외 처리

```mindlang
try {
  // 위험한 코드
  throw "error occurred";
} catch (e) {
  // e는 에러
  throw e;
} finally {
  // 항상 실행
}
```

### 표현식

```mindlang
// 산술
2 + 3 * 4         // 14 (우선순위 존중)
10 / 2            // 5
10 % 3            // 1
2 ** 3            // 8 (지수)

// 비교
x == y
x != y
x < y
x > y
x <= y
x >= y

// 논리
x && y            // AND
x || y            // OR
!x                // NOT

// 멤버 접근
obj.prop
arr[0]
obj["key"]

// 함수 호출
foo()
foo(1, 2, 3)
obj.method()

// 대입
x = 5
x += 1
x -= 1
```

