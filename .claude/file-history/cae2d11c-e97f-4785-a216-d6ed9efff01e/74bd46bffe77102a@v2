/**
 * MindLang Lexer (토크나이저)
 * 문자열 → 토큰 스트림
 *
 * 기능:
 * - 모든 토큰 타입 지원 (키워드, 식별자, 숫자, 문자열, 연산자)
 * - 위치 정보 추적 (line, column, offset)
 * - 문자열 이스케이프 처리
 * - 상세 에러 리포팅
 */

export const TokenType = {
  // 리터럴
  NUMBER: 'NUMBER',
  STRING: 'STRING',
  IDENTIFIER: 'IDENTIFIER',

  // 키워드
  LET: 'LET',
  FN: 'FN',
  IF: 'IF',
  ELSE: 'ELSE',
  WHILE: 'WHILE',
  FOR: 'FOR',
  RETURN: 'RETURN',
  TRUE: 'TRUE',
  FALSE: 'FALSE',
  NULL: 'NULL',
  TRY: 'TRY',
  CATCH: 'CATCH',
  FINALLY: 'FINALLY',
  THROW: 'THROW',
  BREAK: 'BREAK',
  CONTINUE: 'CONTINUE',

  // 연산자
  PLUS: 'PLUS',
  MINUS: 'MINUS',
  MULT: 'MULT',
  DIV: 'DIV',
  MOD: 'MOD',
  POW: 'POW',

  EQ: 'EQ',           // ==
  NEQ: 'NEQ',         // !=
  LT: 'LT',           // <
  LTE: 'LTE',         // <=
  GT: 'GT',           // >
  GTE: 'GTE',         // >=
  AND: 'AND',         // &&
  OR: 'OR',           // ||
  NOT: 'NOT',         // !
  ASSIGN: 'ASSIGN',   // =
  PLUS_ASSIGN: 'PLUS_ASSIGN',   // +=
  MINUS_ASSIGN: 'MINUS_ASSIGN', // -=

  // 구분자
  LPAREN: 'LPAREN',   // (
  RPAREN: 'RPAREN',   // )
  LBRACE: 'LBRACE',   // {
  RBRACE: 'RBRACE',   // }
  LBRACKET: 'LBRACKET', // [
  RBRACKET: 'RBRACKET', // ]
  SEMICOLON: 'SEMICOLON', // ;
  COMMA: 'COMMA',     // ,
  DOT: 'DOT',         // .
  COLON: 'COLON',     // :
  ARROW: 'ARROW',     // =>

  // 특수
  EOF: 'EOF',
  NEWLINE: 'NEWLINE',
}

export class Token {
  constructor(type, value, line, column, offset) {
    this.type = type
    this.value = value
    this.line = line
    this.column = column
    this.offset = offset
  }

  toString() {
    return `Token(${this.type}, ${JSON.stringify(this.value)}, ${this.line}:${this.column})`
  }
}

export class LexerError extends Error {
  constructor(message, line, column, offset) {
    super(message)
    this.name = 'LexerError'
    this.line = line
    this.column = column
    this.offset = offset
  }

  toString() {
    return `${this.name} at ${this.line}:${this.column}: ${this.message}`
  }
}

export class Lexer {
  constructor(source) {
    this.source = source
    this.pos = 0
    this.line = 1
    this.column = 1
    this.offset = 0
    this.currentChar = source[0] || null

    // 키워드 맵 (O(1) 검색)
    this.keywords = new Map([
      ['let', TokenType.LET],
      ['fn', TokenType.FN],
      ['if', TokenType.IF],
      ['else', TokenType.ELSE],
      ['while', TokenType.WHILE],
      ['for', TokenType.FOR],
      ['return', TokenType.RETURN],
      ['true', TokenType.TRUE],
      ['false', TokenType.FALSE],
      ['null', TokenType.NULL],
      ['try', TokenType.TRY],
      ['catch', TokenType.CATCH],
      ['finally', TokenType.FINALLY],
      ['throw', TokenType.THROW],
      ['break', TokenType.BREAK],
      ['continue', TokenType.CONTINUE],
    ])
  }

  advance() {
    if (this.currentChar === '\n') {
      this.line++
      this.column = 1
    } else {
      this.column++
    }
    this.pos++
    this.offset++
    this.currentChar = this.pos < this.source.length ? this.source[this.pos] : null
  }

  peek(offset = 1) {
    const pos = this.pos + offset
    return pos < this.source.length ? this.source[pos] : null
  }

  skipWhitespace() {
    while (this.currentChar && /[ \t\r]/.test(this.currentChar)) {
      this.advance()
    }
  }

  skipComment() {
    // 한 줄 주석 //
    if (this.currentChar === '/' && this.peek() === '/') {
      this.advance() // /
      this.advance() // /
      while (this.currentChar && this.currentChar !== '\n') {
        this.advance()
      }
      return true
    }
    // 블록 주석 /* ... */
    if (this.currentChar === '/' && this.peek() === '*') {
      this.advance() // /
      this.advance() // *
      while (this.currentChar) {
        if (this.currentChar === '*' && this.peek() === '/') {
          this.advance() // *
          this.advance() // /
          return true
        }
        this.advance()
      }
      throw new LexerError('Unclosed block comment', this.line, this.column, this.offset)
    }
    return false
  }

  readIdentifier() {
    const startLine = this.line
    const startColumn = this.column
    const startOffset = this.offset

    let result = ''
    while (this.currentChar && /[a-zA-Z0-9_$]/.test(this.currentChar)) {
      result += this.currentChar
      this.advance()
    }

    // 키워드 확인 (O(1))
    const type = this.keywords.has(result) ? this.keywords.get(result) : TokenType.IDENTIFIER
    return new Token(type, result, startLine, startColumn, startOffset)
  }

  readNumber() {
    const startLine = this.line
    const startColumn = this.column
    const startOffset = this.offset

    let result = ''

    // 정수 부분
    while (this.currentChar && /[0-9]/.test(this.currentChar)) {
      result += this.currentChar
      this.advance()
    }

    // 소수점 처리
    if (this.currentChar === '.' && /[0-9]/.test(this.peek())) {
      result += '.'
      this.advance()
      while (this.currentChar && /[0-9]/.test(this.currentChar)) {
        result += this.currentChar
        this.advance()
      }
    }

    // 지수 표기법 (e/E)
    if (this.currentChar && /[eE]/.test(this.currentChar)) {
      result += this.currentChar
      this.advance()
      if (this.currentChar && /[+-]/.test(this.currentChar)) {
        result += this.currentChar
        this.advance()
      }
      while (this.currentChar && /[0-9]/.test(this.currentChar)) {
        result += this.currentChar
        this.advance()
      }
    }

    return new Token(TokenType.NUMBER, Number(result), startLine, startColumn, startOffset)
  }

  readString(quote) {
    const startLine = this.line
    const startColumn = this.column
    const startOffset = this.offset

    let result = ''
    this.advance() // 시작 따옴표 건너뛰기

    while (this.currentChar && this.currentChar !== quote) {
      if (this.currentChar === '\\') {
        this.advance()
        // 이스케이프 시퀀스
        switch (this.currentChar) {
          case 'n': result += '\n'; break
          case 't': result += '\t'; break
          case 'r': result += '\r'; break
          case '\\': result += '\\'; break
          case '"': result += '"'; break
          case "'": result += "'"; break
          case '0': result += '\0'; break
          default: result += this.currentChar
        }
        this.advance()
      } else {
        result += this.currentChar
        this.advance()
      }
    }

    if (!this.currentChar) {
      throw new LexerError(
        `Unclosed string starting at line ${startLine}`,
        startLine,
        startColumn,
        startOffset
      )
    }

    this.advance() // 종료 따옴표 건너뛰기
    return new Token(TokenType.STRING, result, startLine, startColumn, startOffset)
  }

  getNextToken() {
    while (this.currentChar) {
      // 공백 건너뛰기
      if (/[ \t\r]/.test(this.currentChar)) {
        this.skipWhitespace()
        continue
      }

      // 주석 건너뛰기
      if (this.currentChar === '/' && (this.peek() === '/' || this.peek() === '*')) {
        this.skipComment()
        continue
      }

      // 개행
      if (this.currentChar === '\n') {
        const token = new Token(TokenType.NEWLINE, '\n', this.line, this.column, this.offset)
        this.advance()
        return token
      }

      // 식별자 또는 키워드
      if (/[a-zA-Z_$]/.test(this.currentChar)) {
        return this.readIdentifier()
      }

      // 숫자
      if (/[0-9]/.test(this.currentChar)) {
        return this.readNumber()
      }

      // 문자열
      if (this.currentChar === '"' || this.currentChar === "'") {
        return this.readString(this.currentChar)
      }

      // 연산자 및 구분자 (2자 연산자 먼저 확인)
      const line = this.line
      const column = this.column
      const offset = this.offset

      const twoChar = this.currentChar + this.peek()
      const twoCharTokens = {
        '==': TokenType.EQ,
        '!=': TokenType.NEQ,
        '<=': TokenType.LTE,
        '>=': TokenType.GTE,
        '&&': TokenType.AND,
        '||': TokenType.OR,
        '+=': TokenType.PLUS_ASSIGN,
        '-=': TokenType.MINUS_ASSIGN,
        '=>': TokenType.ARROW,
        '**': TokenType.POW,
      }

      if (twoCharTokens[twoChar]) {
        this.advance()
        this.advance()
        return new Token(twoCharTokens[twoChar], twoChar, line, column, offset)
      }

      // 1자 토큰
      const char = this.currentChar
      const oneCharTokens = {
        '+': TokenType.PLUS,
        '-': TokenType.MINUS,
        '*': TokenType.MULT,
        '/': TokenType.DIV,
        '%': TokenType.MOD,
        '=': TokenType.ASSIGN,
        '<': TokenType.LT,
        '>': TokenType.GT,
        '!': TokenType.NOT,
        '(': TokenType.LPAREN,
        ')': TokenType.RPAREN,
        '{': TokenType.LBRACE,
        '}': TokenType.RBRACE,
        '[': TokenType.LBRACKET,
        ']': TokenType.RBRACKET,
        ';': TokenType.SEMICOLON,
        ',': TokenType.COMMA,
        '.': TokenType.DOT,
        ':': TokenType.COLON,
      }

      if (oneCharTokens[char]) {
        this.advance()
        return new Token(oneCharTokens[char], char, line, column, offset)
      }

      // 알 수 없는 문자
      throw new LexerError(
        `Unexpected character: ${char}`,
        line,
        column,
        offset
      )
    }

    // EOF
    return new Token(TokenType.EOF, null, this.line, this.column, this.offset)
  }

  tokenize() {
    const tokens = []
    let token
    do {
      token = this.getNextToken()
      // NEWLINE은 선택적 (일반적으로 스킵하지만 필요시 저장)
      if (token.type !== TokenType.NEWLINE) {
        tokens.push(token)
      }
    } while (token.type !== TokenType.EOF)
    tokens.push(token) // EOF 추가
    return tokens
  }

  // 편의 메서드: 소스와 함께 토큰 출력
  tokenizeWithDebug() {
    const tokens = this.tokenize()
    console.log('=== TOKENS ===')
    tokens.forEach((token, i) => {
      console.log(`${i}: ${token}`)
    })
    return tokens
  }
}

export default Lexer
