/**
 * MindLang Parser (파서)
 * 토큰 → AST (Abstract Syntax Tree)
 *
 * 재귀 하강 파서 구현:
 * - 7단계 연산자 우선순위
 * - 함수 정의/호출
 * - 제어문 (if/while/for)
 * - 배열/객체
 * - 예외 처리 (try/catch/finally)
 * - 상세 에러 리포팅
 */

import { TokenType, Token } from './lexer.js'
import * as AST from './ast.js'

export class ParseError extends Error {
  constructor(message, token) {
    super(message)
    this.name = 'ParseError'
    this.token = token
    this.line = token?.line || 0
    this.column = token?.column || 0
  }

  toString() {
    return `${this.name} at ${this.line}:${this.column}: ${this.message}`
  }
}

export class Parser {
  constructor(tokens) {
    this.tokens = tokens
    this.pos = 0
    this.currentToken = tokens[0]
  }

  // ============================================
  // 기본 유틸리티
  // ============================================

  advance() {
    this.pos++
    if (this.pos < this.tokens.length) {
      this.currentToken = this.tokens[this.pos]
    }
  }

  peek(offset = 1) {
    const pos = this.pos + offset
    return pos < this.tokens.length ? this.tokens[pos] : null
  }

  expect(type) {
    if (this.currentToken.type !== type) {
      throw new ParseError(
        `Expected ${type} but got ${this.currentToken.type}`,
        this.currentToken
      )
    }
    const token = this.currentToken
    this.advance()
    return token
  }

  match(...types) {
    return types.includes(this.currentToken.type)
  }

  consume(type) {
    if (this.match(type)) {
      const token = this.currentToken
      this.advance()
      return token
    }
    return null
  }

  // ============================================
  // 메인 파싱 메서드
  // ============================================

  /**
   * 프로그램 파싱: 최상위 레벨
   * Program = { Statement }
   */
  parseProgram() {
    const statements = []

    while (this.currentToken.type !== TokenType.EOF) {
      const stmt = this.parseStatement()
      if (stmt) {
        statements.push(stmt)
      }
    }

    return new AST.Program(statements)
  }

  /**
   * 문 파싱
   */
  parseStatement() {
    // 블록
    if (this.match(TokenType.LBRACE)) {
      return this.parseBlockStatement()
    }

    // 함수 선언
    if (this.match(TokenType.FN)) {
      return this.parseFunctionDeclaration()
    }

    // 변수 선언
    if (this.match(TokenType.LET)) {
      return this.parseVariableDeclaration()
    }

    // 제어문
    if (this.match(TokenType.IF)) {
      return this.parseIfStatement()
    }

    if (this.match(TokenType.WHILE)) {
      return this.parseWhileStatement()
    }

    if (this.match(TokenType.FOR)) {
      return this.parseForStatement()
    }

    // 반환
    if (this.match(TokenType.RETURN)) {
      return this.parseReturnStatement()
    }

    // 반복 제어
    if (this.match(TokenType.BREAK)) {
      this.advance()
      this.consume(TokenType.SEMICOLON)
      return new AST.BreakStatement(null, this.currentToken.line, this.currentToken.column)
    }

    if (this.match(TokenType.CONTINUE)) {
      this.advance()
      this.consume(TokenType.SEMICOLON)
      return new AST.ContinueStatement(null, this.currentToken.line, this.currentToken.column)
    }

    // 예외 처리
    if (this.match(TokenType.TRY)) {
      return this.parseTryStatement()
    }

    if (this.match(TokenType.THROW)) {
      return this.parseThrowStatement()
    }

    // 표현식 문
    return this.parseExpressionStatement()
  }

  parseBlockStatement() {
    const line = this.currentToken.line
    const column = this.currentToken.column

    this.expect(TokenType.LBRACE)
    const statements = []

    while (!this.match(TokenType.RBRACE) && this.currentToken.type !== TokenType.EOF) {
      const stmt = this.parseStatement()
      if (stmt) {
        statements.push(stmt)
      }
    }

    this.expect(TokenType.RBRACE)
    return new AST.BlockStatement(statements, line, column)
  }

  parseFunctionDeclaration() {
    const line = this.currentToken.line
    const column = this.currentToken.column

    this.expect(TokenType.FN)
    const name = this.expect(TokenType.IDENTIFIER).value
    this.expect(TokenType.LPAREN)

    const params = []
    if (!this.match(TokenType.RPAREN)) {
      do {
        const paramName = this.expect(TokenType.IDENTIFIER).value
        let defaultValue = null

        // 기본값 지원 (선택사항)
        if (this.consume(TokenType.ASSIGN)) {
          defaultValue = this.parseAssignment()
        }

        params.push(new AST.Parameter(paramName, defaultValue))
      } while (this.consume(TokenType.COMMA))
    }

    this.expect(TokenType.RPAREN)
    const body = this.parseBlockStatement()

    return new AST.FunctionDeclaration(name, params, body, line, column)
  }

  parseVariableDeclaration() {
    const line = this.currentToken.line
    const column = this.currentToken.column

    this.expect(TokenType.LET)
    const declarations = []

    do {
      const name = this.expect(TokenType.IDENTIFIER).value
      let init = null

      if (this.consume(TokenType.ASSIGN)) {
        init = this.parseAssignment()
      }

      declarations.push(new AST.VariableDeclarator(
        new AST.Identifier(name),
        init
      ))
    } while (this.consume(TokenType.COMMA))

    this.consume(TokenType.SEMICOLON) // 선택사항
    return new AST.VariableDeclaration('let', declarations, line, column)
  }

  parseIfStatement() {
    const line = this.currentToken.line
    const column = this.currentToken.column

    this.expect(TokenType.IF)
    this.expect(TokenType.LPAREN)
    const test = this.parseExpression()
    this.expect(TokenType.RPAREN)

    const consequent = this.parseStatement()
    let alternate = null

    if (this.consume(TokenType.ELSE)) {
      alternate = this.parseStatement()
    }

    return new AST.IfStatement(test, consequent, alternate, line, column)
  }

  parseWhileStatement() {
    const line = this.currentToken.line
    const column = this.currentToken.column

    this.expect(TokenType.WHILE)
    this.expect(TokenType.LPAREN)
    const test = this.parseExpression()
    this.expect(TokenType.RPAREN)

    const body = this.parseStatement()
    return new AST.WhileStatement(test, body, line, column)
  }

  parseForStatement() {
    const line = this.currentToken.line
    const column = this.currentToken.column

    this.expect(TokenType.FOR)
    this.expect(TokenType.LPAREN)

    // 초기화
    let init = null
    if (!this.match(TokenType.SEMICOLON)) {
      if (this.match(TokenType.LET)) {
        init = this.parseVariableDeclaration()
      } else {
        init = this.parseExpression()
        this.consume(TokenType.SEMICOLON)
      }
    } else {
      this.advance()
    }

    // 조건
    let test = null
    if (!this.match(TokenType.SEMICOLON)) {
      test = this.parseExpression()
    }
    this.expect(TokenType.SEMICOLON)

    // 업데이트
    let update = null
    if (!this.match(TokenType.RPAREN)) {
      update = this.parseExpression()
    }
    this.expect(TokenType.RPAREN)

    const body = this.parseStatement()
    return new AST.ForStatement(init, test, update, body, line, column)
  }

  parseReturnStatement() {
    const line = this.currentToken.line
    const column = this.currentToken.column

    this.expect(TokenType.RETURN)
    let argument = null

    if (!this.match(TokenType.SEMICOLON) && !this.match(TokenType.RBRACE)) {
      argument = this.parseExpression()
    }

    this.consume(TokenType.SEMICOLON) // 선택사항
    return new AST.ReturnStatement(argument, line, column)
  }

  parseTryStatement() {
    const line = this.currentToken.line
    const column = this.currentToken.column

    this.expect(TokenType.TRY)
    const block = this.parseBlockStatement()

    let handler = null
    let finalizer = null

    if (this.consume(TokenType.CATCH)) {
      this.expect(TokenType.LPAREN)
      const paramName = this.expect(TokenType.IDENTIFIER).value
      this.expect(TokenType.RPAREN)

      const body = this.parseBlockStatement()
      handler = new AST.CatchClause(
        new AST.Identifier(paramName),
        body
      )
    }

    if (this.consume(TokenType.FINALLY)) {
      finalizer = this.parseBlockStatement()
    }

    if (!handler && !finalizer) {
      throw new ParseError('Missing catch or finally after try', this.currentToken)
    }

    return new AST.TryStatement(block, handler, finalizer, line, column)
  }

  parseThrowStatement() {
    const line = this.currentToken.line
    const column = this.currentToken.column

    this.expect(TokenType.THROW)
    const argument = this.parseExpression()
    this.consume(TokenType.SEMICOLON) // 선택사항

    return new AST.ThrowStatement(argument, line, column)
  }

  parseExpressionStatement() {
    const expr = this.parseExpression()
    this.consume(TokenType.SEMICOLON) // 선택사항
    return new AST.ExpressionStatement(expr)
  }

  // ============================================
  // 표현식 파싱 (우선순위)
  // ============================================

  // 레벨 0: 식 (Assignment, 삼항 연산)
  parseExpression() {
    return this.parseConditional()
  }

  // 레벨 1: 삼항 조건부 (? :)
  parseConditional() {
    let expr = this.parseAssignment()

    while (this.currentToken.type === TokenType.LPAREN &&
           this.peek()?.type === TokenType.COLON) { // 간소화된 버전
      // 삼항 연산자는 생략 (필요시 추가)
    }

    return expr
  }

  // 레벨 2: 대입 (=, +=, -=)
  parseAssignment() {
    const expr = this.parseLogicalOr()

    if (this.match(TokenType.ASSIGN, TokenType.PLUS_ASSIGN, TokenType.MINUS_ASSIGN)) {
      const operator = this.currentToken.value
      this.advance()
      const right = this.parseAssignment()
      return new AST.AssignmentExpression(operator, expr, right)
    }

    return expr
  }

  // 레벨 3: 논리합 (||)
  parseLogicalOr() {
    let expr = this.parseLogicalAnd()

    while (this.match(TokenType.OR)) {
      const operator = this.currentToken.value
      const line = this.currentToken.line
      const column = this.currentToken.column
      this.advance()
      const right = this.parseLogicalAnd()
      expr = new AST.LogicalExpression(operator, expr, right, line, column)
    }

    return expr
  }

  // 레벨 4: 논리곱 (&&)
  parseLogicalAnd() {
    let expr = this.parseEquality()

    while (this.match(TokenType.AND)) {
      const operator = this.currentToken.value
      const line = this.currentToken.line
      const column = this.currentToken.column
      this.advance()
      const right = this.parseEquality()
      expr = new AST.LogicalExpression(operator, expr, right, line, column)
    }

    return expr
  }

  // 레벨 5: 동등성 (==, !=)
  parseEquality() {
    let expr = this.parseRelational()

    while (this.match(TokenType.EQ, TokenType.NEQ)) {
      const operator = this.currentToken.value
      const line = this.currentToken.line
      const column = this.currentToken.column
      this.advance()
      const right = this.parseRelational()
      expr = new AST.BinaryExpression(operator, expr, right, line, column)
    }

    return expr
  }

  // 레벨 6: 비교 (<, >, <=, >=)
  parseRelational() {
    let expr = this.parseAdditive()

    while (this.match(TokenType.LT, TokenType.LTE, TokenType.GT, TokenType.GTE)) {
      const operator = this.currentToken.value
      const line = this.currentToken.line
      const column = this.currentToken.column
      this.advance()
      const right = this.parseAdditive()
      expr = new AST.BinaryExpression(operator, expr, right, line, column)
    }

    return expr
  }

  // 레벨 7: 더하기/빼기
  parseAdditive() {
    let expr = this.parseMultiplicative()

    while (this.match(TokenType.PLUS, TokenType.MINUS)) {
      const operator = this.currentToken.value
      const line = this.currentToken.line
      const column = this.currentToken.column
      this.advance()
      const right = this.parseMultiplicative()
      expr = new AST.BinaryExpression(operator, expr, right, line, column)
    }

    return expr
  }

  // 레벨 8: 곱하기/나누기/나머지
  parseMultiplicative() {
    let expr = this.parseExponentiation()

    while (this.match(TokenType.MULT, TokenType.DIV, TokenType.MOD)) {
      const operator = this.currentToken.value
      const line = this.currentToken.line
      const column = this.currentToken.column
      this.advance()
      const right = this.parseExponentiation()
      expr = new AST.BinaryExpression(operator, expr, right, line, column)
    }

    return expr
  }

  // 레벨 9: 지수 (**)
  parseExponentiation() {
    let expr = this.parseUnary()

    while (this.match(TokenType.POW)) {
      const operator = this.currentToken.value
      const line = this.currentToken.line
      const column = this.currentToken.column
      this.advance()
      const right = this.parseUnary()
      expr = new AST.BinaryExpression(operator, expr, right, line, column)
    }

    return expr
  }

  // 레벨 10: 단항 (-, !, typeof)
  parseUnary() {
    if (this.match(TokenType.MINUS, TokenType.NOT)) {
      const operator = this.currentToken.value
      const line = this.currentToken.line
      const column = this.currentToken.column
      this.advance()
      const argument = this.parseUnary()
      return new AST.UnaryExpression(operator, argument, true, line, column)
    }

    return this.parsePostfix()
  }

  // 후위 (++, --)
  parsePostfix() {
    let expr = this.parseMember()

    if (this.match(TokenType.IDENTIFIER)) { // 간소화: 실제로는 ++/-- 토큰 필요
      // 생략
    }

    return expr
  }

  // 멤버 접근 & 함수 호출
  parseMember() {
    let expr = this.parsePrimary()

    while (true) {
      if (this.match(TokenType.DOT)) {
        const line = this.currentToken.line
        const column = this.currentToken.column
        this.advance()
        const property = this.expect(TokenType.IDENTIFIER).value
        expr = new AST.MemberExpression(
          expr,
          new AST.Identifier(property),
          false, // computed = false
          line,
          column
        )
      } else if (this.match(TokenType.LBRACKET)) {
        const line = this.currentToken.line
        const column = this.currentToken.column
        this.advance()
        const property = this.parseExpression()
        this.expect(TokenType.RBRACKET)
        expr = new AST.MemberExpression(
          expr,
          property,
          true, // computed = true
          line,
          column
        )
      } else if (this.match(TokenType.LPAREN)) {
        const line = this.currentToken.line
        const column = this.currentToken.column
        this.advance()
        const args = []

        if (!this.match(TokenType.RPAREN)) {
          do {
            args.push(this.parseAssignment())
          } while (this.consume(TokenType.COMMA))
        }

        this.expect(TokenType.RPAREN)
        expr = new AST.CallExpression(expr, args, line, column)
      } else {
        break
      }
    }

    return expr
  }

  // 기본 표현식 (리터럴, 식별자, 괄호)
  parsePrimary() {
    const line = this.currentToken.line
    const column = this.currentToken.column

    // 숫자
    if (this.match(TokenType.NUMBER)) {
      const value = this.currentToken.value
      this.advance()
      return new AST.NumberLiteral(value, line, column)
    }

    // 문자열
    if (this.match(TokenType.STRING)) {
      const value = this.currentToken.value
      this.advance()
      return new AST.StringLiteral(value, line, column)
    }

    // 불린
    if (this.match(TokenType.TRUE)) {
      this.advance()
      return new AST.BooleanLiteral(true, line, column)
    }

    if (this.match(TokenType.FALSE)) {
      this.advance()
      return new AST.BooleanLiteral(false, line, column)
    }

    // null
    if (this.match(TokenType.NULL)) {
      this.advance()
      return new AST.NullLiteral(line, column)
    }

    // 식별자
    if (this.match(TokenType.IDENTIFIER)) {
      const name = this.currentToken.value
      this.advance()
      return new AST.Identifier(name, line, column)
    }

    // 배열
    if (this.match(TokenType.LBRACKET)) {
      return this.parseArrayLiteral()
    }

    // 객체
    if (this.match(TokenType.LBRACE)) {
      return this.parseObjectLiteral()
    }

    // 괄호
    if (this.match(TokenType.LPAREN)) {
      this.advance()
      const expr = this.parseExpression()
      this.expect(TokenType.RPAREN)
      return expr
    }

    // 화살표 함수 (단순 버전)
    // expr => body
    // 생략 (필요시 추가)

    throw new ParseError(`Unexpected token: ${this.currentToken.type}`, this.currentToken)
  }

  parseArrayLiteral() {
    const line = this.currentToken.line
    const column = this.currentToken.column

    this.expect(TokenType.LBRACKET)
    const elements = []

    if (!this.match(TokenType.RBRACKET)) {
      do {
        if (this.match(TokenType.COMMA)) {
          elements.push(new AST.NullLiteral()) // sparse array
        } else {
          elements.push(this.parseAssignment())
        }
      } while (this.consume(TokenType.COMMA) && !this.match(TokenType.RBRACKET))
    }

    this.expect(TokenType.RBRACKET)
    return new AST.ArrayLiteral(elements, line, column)
  }

  parseObjectLiteral() {
    const line = this.currentToken.line
    const column = this.currentToken.column

    this.expect(TokenType.LBRACE)
    const properties = []

    if (!this.match(TokenType.RBRACE)) {
      do {
        const keyToken = this.currentToken

        // 키: 식별자 또는 문자열
        let key
        if (this.match(TokenType.IDENTIFIER)) {
          key = this.currentToken.value
          this.advance()
        } else if (this.match(TokenType.STRING)) {
          key = this.currentToken.value
          this.advance()
        } else {
          throw new ParseError(`Expected property key`, this.currentToken)
        }

        this.expect(TokenType.COLON)
        const value = this.parseAssignment()

        properties.push(new AST.Property(key, value, keyToken.line, keyToken.column))
      } while (this.consume(TokenType.COMMA) && !this.match(TokenType.RBRACE))
    }

    this.expect(TokenType.RBRACE)
    return new AST.ObjectLiteral(properties, line, column)
  }

  parse() {
    try {
      return this.parseProgram()
    } catch (err) {
      if (err instanceof ParseError) {
        throw err
      }
      throw new ParseError(err.message, this.currentToken)
    }
  }
}

export default Parser
