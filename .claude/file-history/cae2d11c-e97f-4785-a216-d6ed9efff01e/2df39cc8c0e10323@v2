/**
 * Parser 테스트 스위트
 */

import { strict as assert } from 'assert'
import { Lexer } from '../src/lexer.js'
import { Parser, ParseError } from '../src/parser.js'
import * as AST from '../src/ast.js'

function parse(source) {
  const lexer = new Lexer(source)
  const tokens = lexer.tokenize()
  const parser = new Parser(tokens)
  return parser.parse()
}

describe('Parser Tests', () => {
  describe('Literals', () => {
    test('should parse number', () => {
      const ast = parse('42')
      assert.equal(ast.body[0].expression.type, 'NumberLiteral')
      assert.equal(ast.body[0].expression.value, 42)
    })

    test('should parse string', () => {
      const ast = parse('"hello"')
      assert.equal(ast.body[0].expression.type, 'StringLiteral')
      assert.equal(ast.body[0].expression.value, 'hello')
    })

    test('should parse boolean', () => {
      const ast = parse('true false')
      assert.equal(ast.body[0].expression.type, 'BooleanLiteral')
      assert.equal(ast.body[0].expression.value, true)
    })

    test('should parse null', () => {
      const ast = parse('null')
      assert.equal(ast.body[0].expression.type, 'NullLiteral')
    })

    test('should parse identifier', () => {
      const ast = parse('x')
      assert.equal(ast.body[0].expression.type, 'Identifier')
      assert.equal(ast.body[0].expression.name, 'x')
    })

    test('should parse array literal', () => {
      const ast = parse('[1, 2, 3]')
      assert.equal(ast.body[0].expression.type, 'ArrayLiteral')
      assert.equal(ast.body[0].expression.elements.length, 3)
    })

    test('should parse object literal', () => {
      const ast = parse('{ x: 1, y: 2 }')
      assert.equal(ast.body[0].expression.type, 'ObjectLiteral')
      assert.equal(ast.body[0].expression.properties.length, 2)
    })
  })

  describe('Binary Operations', () => {
    test('should parse addition', () => {
      const ast = parse('1 + 2')
      assert.equal(ast.body[0].expression.type, 'BinaryExpression')
      assert.equal(ast.body[0].expression.operator, '+')
    })

    test('should parse multiplication', () => {
      const ast = parse('2 * 3')
      assert.equal(ast.body[0].expression.operator, '*')
    })

    test('should respect operator precedence', () => {
      const ast = parse('2 + 3 * 4')
      const expr = ast.body[0].expression
      assert.equal(expr.type, 'BinaryExpression')
      assert.equal(expr.operator, '+')
      assert.equal(expr.right.type, 'BinaryExpression')
      assert.equal(expr.right.operator, '*')
    })

    test('should handle parentheses', () => {
      const ast = parse('(2 + 3) * 4')
      const expr = ast.body[0].expression
      assert.equal(expr.operator, '*')
      assert.equal(expr.left.type, 'BinaryExpression')
      assert.equal(expr.left.operator, '+')
    })

    test('should parse comparison operators', () => {
      const ast = parse('x < 10')
      assert.equal(ast.body[0].expression.operator, '<')
    })

    test('should parse equality operators', () => {
      const ast = parse('x == 5')
      assert.equal(ast.body[0].expression.operator, '==')
    })

    test('should parse logical AND', () => {
      const ast = parse('true && false')
      assert.equal(ast.body[0].expression.type, 'LogicalExpression')
      assert.equal(ast.body[0].expression.operator, '&&')
    })

    test('should parse logical OR', () => {
      const ast = parse('true || false')
      assert.equal(ast.body[0].expression.type, 'LogicalExpression')
      assert.equal(ast.body[0].expression.operator, '||')
    })
  })

  describe('Unary Operations', () => {
    test('should parse negation', () => {
      const ast = parse('-5')
      assert.equal(ast.body[0].expression.type, 'UnaryExpression')
      assert.equal(ast.body[0].expression.operator, '-')
    })

    test('should parse logical NOT', () => {
      const ast = parse('!true')
      assert.equal(ast.body[0].expression.type, 'UnaryExpression')
      assert.equal(ast.body[0].expression.operator, '!')
    })
  })

  describe('Assignment', () => {
    test('should parse simple assignment', () => {
      const ast = parse('x = 5')
      assert.equal(ast.body[0].expression.type, 'AssignmentExpression')
      assert.equal(ast.body[0].expression.operator, '=')
    })

    test('should parse += operator', () => {
      const ast = parse('x += 5')
      assert.equal(ast.body[0].expression.operator, '+=')
    })

    test('should parse -= operator', () => {
      const ast = parse('x -= 5')
      assert.equal(ast.body[0].expression.operator, '-=')
    })
  })

  describe('Member Access', () => {
    test('should parse dot notation', () => {
      const ast = parse('obj.prop')
      assert.equal(ast.body[0].expression.type, 'MemberExpression')
      assert.equal(ast.body[0].expression.computed, false)
    })

    test('should parse bracket notation', () => {
      const ast = parse('arr[0]')
      assert.equal(ast.body[0].expression.type, 'MemberExpression')
      assert.equal(ast.body[0].expression.computed, true)
    })

    test('should parse chained access', () => {
      const ast = parse('obj.a.b.c')
      let expr = ast.body[0].expression
      assert.equal(expr.type, 'MemberExpression')
    })
  })

  describe('Function Call', () => {
    test('should parse simple call', () => {
      const ast = parse('foo()')
      assert.equal(ast.body[0].expression.type, 'CallExpression')
      assert.equal(ast.body[0].expression.args.length, 0)
    })

    test('should parse call with arguments', () => {
      const ast = parse('foo(1, 2, 3)')
      assert.equal(ast.body[0].expression.args.length, 3)
    })

    test('should parse nested calls', () => {
      const ast = parse('foo(bar(5))')
      const expr = ast.body[0].expression
      assert.equal(expr.type, 'CallExpression')
      assert.equal(expr.args[0].type, 'CallExpression')
    })
  })

  describe('Variable Declaration', () => {
    test('should parse let without init', () => {
      const ast = parse('let x;')
      assert.equal(ast.body[0].type, 'VariableDeclaration')
      assert.equal(ast.body[0].declarations[0].id.name, 'x')
      assert.equal(ast.body[0].declarations[0].init, null)
    })

    test('should parse let with init', () => {
      const ast = parse('let x = 5;')
      assert.equal(ast.body[0].declarations[0].init.type, 'NumberLiteral')
    })

    test('should parse multiple declarations', () => {
      const ast = parse('let x = 1, y = 2;')
      assert.equal(ast.body[0].declarations.length, 2)
    })
  })

  describe('Control Flow', () => {
    test('should parse if statement', () => {
      const ast = parse('if (x > 5) { }')
      assert.equal(ast.body[0].type, 'IfStatement')
      assert(ast.body[0].test)
      assert(ast.body[0].consequent)
    })

    test('should parse if-else statement', () => {
      const ast = parse('if (x) { } else { }')
      assert.equal(ast.body[0].type, 'IfStatement')
      assert(ast.body[0].alternate)
    })

    test('should parse while loop', () => {
      const ast = parse('while (true) { }')
      assert.equal(ast.body[0].type, 'WhileStatement')
    })

    test('should parse for loop', () => {
      const ast = parse('for (let i = 0; i < 10; i = i + 1) { }')
      assert.equal(ast.body[0].type, 'ForStatement')
      assert(ast.body[0].init)
      assert(ast.body[0].test)
      assert(ast.body[0].update)
    })

    test('should parse for loop without init', () => {
      const ast = parse('for (; i < 10; ) { }')
      assert.equal(ast.body[0].init, null)
    })

    test('should parse break statement', () => {
      const ast = parse('while (true) { break; }')
      const stmt = ast.body[0].body.body[0]
      assert.equal(stmt.type, 'BreakStatement')
    })

    test('should parse continue statement', () => {
      const ast = parse('while (true) { continue; }')
      const stmt = ast.body[0].body.body[0]
      assert.equal(stmt.type, 'ContinueStatement')
    })
  })

  describe('Function Declaration', () => {
    test('should parse simple function', () => {
      const ast = parse('fn foo() { }')
      assert.equal(ast.body[0].type, 'FunctionDeclaration')
      assert.equal(ast.body[0].name, 'foo')
    })

    test('should parse function with parameters', () => {
      const ast = parse('fn add(a, b) { }')
      assert.equal(ast.body[0].params.length, 2)
      assert.equal(ast.body[0].params[0].name, 'a')
    })

    test('should parse function with return', () => {
      const ast = parse('fn foo() { return 42; }')
      const returnStmt = ast.body[0].body.body[0]
      assert.equal(returnStmt.type, 'ReturnStatement')
    })
  })

  describe('Exception Handling', () => {
    test('should parse try-catch', () => {
      const ast = parse('try { } catch (e) { }')
      assert.equal(ast.body[0].type, 'TryStatement')
      assert(ast.body[0].handler)
    })

    test('should parse try-finally', () => {
      const ast = parse('try { } finally { }')
      assert.equal(ast.body[0].type, 'TryStatement')
      assert(ast.body[0].finalizer)
    })

    test('should parse try-catch-finally', () => {
      const ast = parse('try { } catch (e) { } finally { }')
      assert(ast.body[0].handler)
      assert(ast.body[0].finalizer)
    })

    test('should parse throw statement', () => {
      const ast = parse('throw new Error("msg");')
      assert.equal(ast.body[0].type, 'ThrowStatement')
    })
  })

  describe('Block Statements', () => {
    test('should parse block with multiple statements', () => {
      const ast = parse('{ let x = 1; let y = 2; }')
      assert.equal(ast.body[0].type, 'BlockStatement')
      assert.equal(ast.body[0].body.length, 2)
    })
  })

  describe('Error Handling', () => {
    test('should throw on unexpected token', () => {
      assert.throws(() => parse('if x'), ParseError)
    })

    test('should throw on mismatched parentheses', () => {
      assert.throws(() => parse('(1 + 2'), ParseError)
    })

    test('should throw on unclosed block', () => {
      assert.throws(() => parse('{ let x = 1;'), ParseError)
    })
  })

  describe('Complex Programs', () => {
    test('should parse fibonacci function', () => {
      const source = `
        fn fib(n) {
          if (n <= 1) {
            return n;
          }
          return fib(n - 1) + fib(n - 2);
        }
      `
      const ast = parse(source)
      assert(ast.body[0].type === 'FunctionDeclaration')
    })

    test('should parse nested loops', () => {
      const source = `
        for (let i = 0; i < 10; i = i + 1) {
          for (let j = 0; j < 10; j = j + 1) {
            let x = i * j;
          }
        }
      `
      const ast = parse(source)
      assert(ast.body[0].type === 'ForStatement')
    })

    test('should parse mixed expressions and statements', () => {
      const source = `
        let x = 1 + 2 * 3;
        let y = [1, 2, 3];
        let z = { a: 1, b: 2 };
        if (x > 5) {
          x = x + 1;
        }
      `
      const ast = parse(source)
      assert.equal(ast.body.length, 4)
    })
  })
})
