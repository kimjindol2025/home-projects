/**
 * MindLang AST (Abstract Syntax Tree) 노드 정의
 * 모든 노드는 공통 base 클래스를 상속
 */

export class ASTNode {
  constructor(type, line = 1, column = 1) {
    this.type = type
    this.line = line
    this.column = column
  }

  toString() {
    return JSON.stringify(this, null, 2)
  }
}

// ============================================
// 리터럴 & 기본
// ============================================

export class NumberLiteral extends ASTNode {
  constructor(value, line, column) {
    super('NumberLiteral', line, column)
    this.value = value
  }
}

export class StringLiteral extends ASTNode {
  constructor(value, line, column) {
    super('StringLiteral', line, column)
    this.value = value
  }
}

export class BooleanLiteral extends ASTNode {
  constructor(value, line, column) {
    super('BooleanLiteral', line, column)
    this.value = value
  }
}

export class NullLiteral extends ASTNode {
  constructor(line, column) {
    super('NullLiteral', line, column)
  }
}

export class Identifier extends ASTNode {
  constructor(name, line, column) {
    super('Identifier', line, column)
    this.name = name
  }
}

// ============================================
// 배열 & 객체
// ============================================

export class ArrayLiteral extends ASTNode {
  constructor(elements, line, column) {
    super('ArrayLiteral', line, column)
    this.elements = elements // ASTNode[]
  }
}

export class ObjectLiteral extends ASTNode {
  constructor(properties, line, column) {
    super('ObjectLiteral', line, column)
    this.properties = properties // { key: string, value: ASTNode }[]
  }
}

export class Property extends ASTNode {
  constructor(key, value, line, column) {
    super('Property', line, column)
    this.key = key // string
    this.value = value // ASTNode
  }
}

// ============================================
// 연산 & 표현식
// ============================================

export class BinaryExpression extends ASTNode {
  constructor(operator, left, right, line, column) {
    super('BinaryExpression', line, column)
    this.operator = operator // +, -, *, /, ==, !=, <, >, etc.
    this.left = left // ASTNode
    this.right = right // ASTNode
  }
}

export class UnaryExpression extends ASTNode {
  constructor(operator, argument, prefix = true, line, column) {
    super('UnaryExpression', line, column)
    this.operator = operator // -, !, typeof, etc.
    this.argument = argument // ASTNode
    this.prefix = prefix // 전위/후위
  }
}

export class LogicalExpression extends ASTNode {
  constructor(operator, left, right, line, column) {
    super('LogicalExpression', line, column)
    this.operator = operator // &&, ||
    this.left = left // ASTNode
    this.right = right // ASTNode
  }
}

export class MemberExpression extends ASTNode {
  constructor(object, property, computed = false, line, column) {
    super('MemberExpression', line, column)
    this.object = object // ASTNode
    this.property = property // ASTNode
    this.computed = computed // true: obj[prop], false: obj.prop
  }
}

export class CallExpression extends ASTNode {
  constructor(callee, args, line, column) {
    super('CallExpression', line, column)
    this.callee = callee // ASTNode (함수명)
    this.args = args // ASTNode[] (인수)
  }
}

// ============================================
// 함수
// ============================================

export class FunctionDeclaration extends ASTNode {
  constructor(name, params, body, line, column) {
    super('FunctionDeclaration', line, column)
    this.name = name // string or Identifier
    this.params = params // Parameter[]
    this.body = body // BlockStatement
  }
}

export class ArrowFunctionExpression extends ASTNode {
  constructor(params, body, line, column) {
    super('ArrowFunctionExpression', line, column)
    this.params = params // Parameter[]
    this.body = body // BlockStatement or ASTNode (표현식)
    this.isExpression = !(body instanceof BlockStatement)
  }
}

export class Parameter extends ASTNode {
  constructor(name, defaultValue = null, line, column) {
    super('Parameter', line, column)
    this.name = name // string
    this.defaultValue = defaultValue // ASTNode or null
  }
}

// ============================================
// 문 (Statement)
// ============================================

export class Program extends ASTNode {
  constructor(body, line = 1, column = 1) {
    super('Program', line, column)
    this.body = body // ASTNode[]
  }
}

export class BlockStatement extends ASTNode {
  constructor(body, line, column) {
    super('BlockStatement', line, column)
    this.body = body // ASTNode[]
  }
}

export class ExpressionStatement extends ASTNode {
  constructor(expression, line, column) {
    super('ExpressionStatement', line, column)
    this.expression = expression // ASTNode
  }
}

export class VariableDeclaration extends ASTNode {
  constructor(kind, declarations, line, column) {
    super('VariableDeclaration', line, column)
    this.kind = kind // 'let', 'const', 'var'
    this.declarations = declarations // VariableDeclarator[]
  }
}

export class VariableDeclarator extends ASTNode {
  constructor(id, init = null, line, column) {
    super('VariableDeclarator', line, column)
    this.id = id // Identifier
    this.init = init // ASTNode or null
  }
}

// ============================================
// 제어문
// ============================================

export class IfStatement extends ASTNode {
  constructor(test, consequent, alternate = null, line, column) {
    super('IfStatement', line, column)
    this.test = test // ASTNode (조건)
    this.consequent = consequent // ASTNode (then 블록)
    this.alternate = alternate // ASTNode (else 블록) or null
  }
}

export class WhileStatement extends ASTNode {
  constructor(test, body, line, column) {
    super('WhileStatement', line, column)
    this.test = test // ASTNode (조건)
    this.body = body // ASTNode (루프 본문)
  }
}

export class ForStatement extends ASTNode {
  constructor(init, test, update, body, line, column) {
    super('ForStatement', line, column)
    this.init = init // ASTNode or null (초기화)
    this.test = test // ASTNode or null (조건)
    this.update = update // ASTNode or null (업데이트)
    this.body = body // ASTNode (루프 본문)
  }
}

export class ForInStatement extends ASTNode {
  constructor(left, right, body, line, column) {
    super('ForInStatement', line, column)
    this.left = left // Identifier
    this.right = right // ASTNode (객체/배열)
    this.body = body // ASTNode
  }
}

export class BreakStatement extends ASTNode {
  constructor(label = null, line, column) {
    super('BreakStatement', line, column)
    this.label = label // string or null
  }
}

export class ContinueStatement extends ASTNode {
  constructor(label = null, line, column) {
    super('ContinueStatement', line, column)
    this.label = label // string or null
  }
}

export class ReturnStatement extends ASTNode {
  constructor(argument = null, line, column) {
    super('ReturnStatement', line, column)
    this.argument = argument // ASTNode or null
  }
}

// ============================================
// 예외 처리
// ============================================

export class TryStatement extends ASTNode {
  constructor(block, handler = null, finalizer = null, line, column) {
    super('TryStatement', line, column)
    this.block = block // BlockStatement
    this.handler = handler // CatchClause or null
    this.finalizer = finalizer // BlockStatement or null
  }
}

export class CatchClause extends ASTNode {
  constructor(param, body, line, column) {
    super('CatchClause', line, column)
    this.param = param // Identifier
    this.body = body // BlockStatement
  }
}

export class ThrowStatement extends ASTNode {
  constructor(argument, line, column) {
    super('ThrowStatement', line, column)
    this.argument = argument // ASTNode
  }
}

// ============================================
// 대입
// ============================================

export class AssignmentExpression extends ASTNode {
  constructor(operator, left, right, line, column) {
    super('AssignmentExpression', line, column)
    this.operator = operator // =, +=, -=, etc.
    this.left = left // ASTNode
    this.right = right // ASTNode
  }
}

// ============================================
// 조건 (삼항) 연산자
// ============================================

export class ConditionalExpression extends ASTNode {
  constructor(test, consequent, alternate, line, column) {
    super('ConditionalExpression', line, column)
    this.test = test // ASTNode
    this.consequent = consequent // ASTNode
    this.alternate = alternate // ASTNode
  }
}

// ============================================
// 업데이트 표현식 (++, --)
// ============================================

export class UpdateExpression extends ASTNode {
  constructor(operator, argument, prefix = true, line, column) {
    super('UpdateExpression', line, column)
    this.operator = operator // ++, --
    this.argument = argument // ASTNode
    this.prefix = prefix // 전위/후위
  }
}

// ============================================
// 유틸리티
// ============================================

export function createAST(type, props = {}) {
  const nodeClass = {
    Program,
    BlockStatement,
    FunctionDeclaration,
    VariableDeclaration,
    IfStatement,
    WhileStatement,
    ForStatement,
    ReturnStatement,
    BinaryExpression,
    UnaryExpression,
    CallExpression,
    Identifier,
    NumberLiteral,
    StringLiteral,
  }[type]

  if (!nodeClass) {
    throw new Error(`Unknown AST node type: ${type}`)
  }

  return new nodeClass(props)
}

export default {
  ASTNode,
  NumberLiteral,
  StringLiteral,
  BooleanLiteral,
  NullLiteral,
  Identifier,
  ArrayLiteral,
  ObjectLiteral,
  BinaryExpression,
  UnaryExpression,
  LogicalExpression,
  MemberExpression,
  CallExpression,
  FunctionDeclaration,
  ArrowFunctionExpression,
  Parameter,
  Program,
  BlockStatement,
  ExpressionStatement,
  VariableDeclaration,
  VariableDeclarator,
  IfStatement,
  WhileStatement,
  ForStatement,
  ForInStatement,
  BreakStatement,
  ContinueStatement,
  ReturnStatement,
  TryStatement,
  CatchClause,
  ThrowStatement,
  AssignmentExpression,
  ConditionalExpression,
  UpdateExpression,
}
