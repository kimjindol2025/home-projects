/**
 * MindLang 정식 파서 - 메인 모듈
 * 완전한 파이프라인: Lexer → Parser → Semantic Analyzer
 *
 * 사용법:
 * ```javascript
 * import { MindLangParser } from './src/index.js'
 *
 * const parser = new MindLangParser()
 * const result = parser.parse(sourceCode)
 *
 * if (!result.success) {
 *   console.error(result.errors)
 * } else {
 *   console.log(JSON.stringify(result.ast, null, 2))
 * }
 * ```
 */

import { Lexer, Token, TokenType, LexerError } from './lexer.js'
import { Parser, ParseError } from './parser.js'
import { SemanticAnalyzer, SemanticError } from './semantic.js'
import * as AST from './ast.js'

export class ParseResult {
  constructor(success, ast = null, tokens = null, errors = [], warnings = []) {
    this.success = success
    this.ast = ast
    this.tokens = tokens
    this.errors = errors
    this.warnings = warnings
  }

  toJSON() {
    return {
      success: this.success,
      errors: this.errors,
      warnings: this.warnings,
      ast: this.ast ? this.ast.toString() : null,
    }
  }
}

export class MindLangParser {
  constructor(options = {}) {
    this.debug = options.debug || false
    this.includeTokens = options.includeTokens || false
    this.skipSemantic = options.skipSemantic || false
  }

  /**
   * 완전한 파싱 파이프라인 실행
   * @param {string} source - 소스 코드
   * @returns {ParseResult}
   */
  parse(source) {
    const errors = []
    const warnings = []

    // 1단계: 렉싱
    let tokens
    try {
      const lexer = new Lexer(source)
      tokens = lexer.tokenize()

      if (this.debug) {
        console.log('=== TOKENS ===')
        tokens.forEach((tok, i) => {
          if (tok.type !== 'EOF') {
            console.log(`${i}: ${tok}`)
          }
        })
      }
    } catch (err) {
      if (err instanceof LexerError) {
        errors.push(err.toString())
        return new ParseResult(false, null, null, errors, warnings)
      }
      throw err
    }

    // 2단계: 파싱
    let ast
    try {
      const parser = new Parser(tokens)
      ast = parser.parse()

      if (this.debug) {
        console.log('=== AST ===')
        console.log(JSON.stringify(ast, null, 2))
      }
    } catch (err) {
      if (err instanceof ParseError) {
        errors.push(err.toString())
        return new ParseResult(false, null, tokens, errors, warnings)
      }
      throw err
    }

    // 3단계: 의미론 분석
    if (!this.skipSemantic) {
      try {
        const analyzer = new SemanticAnalyzer()
        const result = analyzer.check(ast)

        if (!result.valid) {
          errors.push(...result.errors)
        }
        warnings.push(...result.warnings)

        if (this.debug && result.warnings.length > 0) {
          console.log('=== WARNINGS ===')
          result.warnings.forEach(w => console.log(w))
        }
      } catch (err) {
        if (err instanceof SemanticError) {
          errors.push(err.toString())
          return new ParseResult(false, ast, tokens, errors, warnings)
        }
        throw err
      }
    }

    return new ParseResult(
      errors.length === 0,
      ast,
      this.includeTokens ? tokens : null,
      errors,
      warnings
    )
  }

  /**
   * 렉싱만 수행
   */
  lex(source) {
    try {
      const lexer = new Lexer(source)
      return {
        success: true,
        tokens: lexer.tokenize(),
        errors: [],
      }
    } catch (err) {
      return {
        success: false,
        tokens: [],
        errors: [err.toString()],
      }
    }
  }

  /**
   * 파싱만 수행 (의미론 분석 제외)
   */
  parseAST(source) {
    const temp = this.skipSemantic
    this.skipSemantic = true
    const result = this.parse(source)
    this.skipSemantic = temp
    return result
  }

  /**
   * 전체 파이프라인 상세 리포트 (디버깅용)
   */
  parseDetailed(source) {
    this.debug = true
    const result = this.parse(source)
    this.debug = false
    return result
  }
}

// ============================================
// 간편 함수
// ============================================

/**
 * 한 줄로 전체 파싱 실행
 */
export function parse(source) {
  const parser = new MindLangParser()
  return parser.parse(source)
}

/**
 * 렉싱만 실행
 */
export function tokenize(source) {
  const parser = new MindLangParser()
  return parser.lex(source)
}

// ============================================
// 내보내기
// ============================================

export {
  // Lexer
  Lexer,
  Token,
  TokenType,
  LexerError,

  // Parser
  Parser,
  ParseError,

  // Semantic
  SemanticAnalyzer,
  SemanticError,

  // AST
  AST,
}

export default MindLangParser
