/**
 * Lexer 테스트 스위트
 */

import { strict as assert } from 'assert'
import { Lexer, TokenType, LexerError } from '../src/lexer.js'

describe('Lexer Tests', () => {
  describe('Basic Tokens', () => {
    test('should tokenize numbers', () => {
      const lexer = new Lexer('123 45.67 1e10')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.NUMBER)
      assert.equal(tokens[0].value, 123)
      assert.equal(tokens[1].type, TokenType.NUMBER)
      assert.equal(tokens[1].value, 45.67)
      assert.equal(tokens[2].type, TokenType.NUMBER)
      assert.equal(tokens[2].value, 1e10)
    })

    test('should tokenize strings', () => {
      const lexer = new Lexer('"hello" \'world\'')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.STRING)
      assert.equal(tokens[0].value, 'hello')
      assert.equal(tokens[1].type, TokenType.STRING)
      assert.equal(tokens[1].value, 'world')
    })

    test('should tokenize string escapes', () => {
      const lexer = new Lexer('"hello\\nworld"')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].value, 'hello\nworld')
    })

    test('should tokenize identifiers', () => {
      const lexer = new Lexer('foo bar_baz $test')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.IDENTIFIER)
      assert.equal(tokens[0].value, 'foo')
      assert.equal(tokens[1].type, TokenType.IDENTIFIER)
      assert.equal(tokens[2].type, TokenType.IDENTIFIER)
    })

    test('should tokenize keywords', () => {
      const lexer = new Lexer('let fn if else while for return')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.LET)
      assert.equal(tokens[1].type, TokenType.FN)
      assert.equal(tokens[2].type, TokenType.IF)
      assert.equal(tokens[3].type, TokenType.ELSE)
      assert.equal(tokens[4].type, TokenType.WHILE)
      assert.equal(tokens[5].type, TokenType.FOR)
      assert.equal(tokens[6].type, TokenType.RETURN)
    })

    test('should tokenize booleans and null', () => {
      const lexer = new Lexer('true false null')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.TRUE)
      assert.equal(tokens[1].type, TokenType.FALSE)
      assert.equal(tokens[2].type, TokenType.NULL)
    })
  })

  describe('Operators', () => {
    test('should tokenize arithmetic operators', () => {
      const lexer = new Lexer('+ - * / %')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.PLUS)
      assert.equal(tokens[1].type, TokenType.MINUS)
      assert.equal(tokens[2].type, TokenType.MULT)
      assert.equal(tokens[3].type, TokenType.DIV)
      assert.equal(tokens[4].type, TokenType.MOD)
    })

    test('should tokenize comparison operators', () => {
      const lexer = new Lexer('< > <= >=')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.LT)
      assert.equal(tokens[1].type, TokenType.GT)
      assert.equal(tokens[2].type, TokenType.LTE)
      assert.equal(tokens[3].type, TokenType.GTE)
    })

    test('should tokenize equality operators', () => {
      const lexer = new Lexer('== !=')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.EQ)
      assert.equal(tokens[1].type, TokenType.NEQ)
    })

    test('should tokenize logical operators', () => {
      const lexer = new Lexer('&& || !')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.AND)
      assert.equal(tokens[1].type, TokenType.OR)
      assert.equal(tokens[2].type, TokenType.NOT)
    })

    test('should tokenize assignment operators', () => {
      const lexer = new Lexer('= += -=')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.ASSIGN)
      assert.equal(tokens[1].type, TokenType.PLUS_ASSIGN)
      assert.equal(tokens[2].type, TokenType.MINUS_ASSIGN)
    })

    test('should tokenize arrow operator', () => {
      const lexer = new Lexer('=>')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.ARROW)
    })

    test('should tokenize power operator', () => {
      const lexer = new Lexer('**')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.POW)
    })
  })

  describe('Delimiters', () => {
    test('should tokenize parentheses', () => {
      const lexer = new Lexer('( )')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.LPAREN)
      assert.equal(tokens[1].type, TokenType.RPAREN)
    })

    test('should tokenize braces', () => {
      const lexer = new Lexer('{ }')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.LBRACE)
      assert.equal(tokens[1].type, TokenType.RBRACE)
    })

    test('should tokenize brackets', () => {
      const lexer = new Lexer('[ ]')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.LBRACKET)
      assert.equal(tokens[1].type, TokenType.RBRACKET)
    })

    test('should tokenize punctuation', () => {
      const lexer = new Lexer('; , . :')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.SEMICOLON)
      assert.equal(tokens[1].type, TokenType.COMMA)
      assert.equal(tokens[2].type, TokenType.DOT)
      assert.equal(tokens[3].type, TokenType.COLON)
    })
  })

  describe('Comments', () => {
    test('should skip line comments', () => {
      const lexer = new Lexer('foo // comment\nbar')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].value, 'foo')
      assert.equal(tokens[1].value, 'bar')
      assert.equal(tokens[2].type, TokenType.EOF)
    })

    test('should skip block comments', () => {
      const lexer = new Lexer('foo /* comment */ bar')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].value, 'foo')
      assert.equal(tokens[1].value, 'bar')
      assert.equal(tokens[2].type, TokenType.EOF)
    })
  })

  describe('Position Tracking', () => {
    test('should track line and column', () => {
      const lexer = new Lexer('foo\nbar')
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].line, 1)
      assert.equal(tokens[0].column, 1)
      assert.equal(tokens[1].line, 2)
      assert.equal(tokens[1].column, 1)
    })
  })

  describe('Error Handling', () => {
    test('should throw on unclosed string', () => {
      const lexer = new Lexer('"unclosed')
      assert.throws(() => lexer.tokenize(), LexerError)
    })

    test('should throw on unknown character', () => {
      const lexer = new Lexer('foo @ bar')
      assert.throws(() => lexer.tokenize(), LexerError)
    })

    test('should throw on unclosed block comment', () => {
      const lexer = new Lexer('/* unclosed')
      assert.throws(() => lexer.tokenize(), LexerError)
    })
  })

  describe('Complex Source', () => {
    test('should tokenize variable declaration', () => {
      const source = 'let x = 42;'
      const lexer = new Lexer(source)
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.LET)
      assert.equal(tokens[1].type, TokenType.IDENTIFIER)
      assert.equal(tokens[2].type, TokenType.ASSIGN)
      assert.equal(tokens[3].type, TokenType.NUMBER)
      assert.equal(tokens[4].type, TokenType.SEMICOLON)
    })

    test('should tokenize function', () => {
      const source = 'fn add(a, b) { return a + b; }'
      const lexer = new Lexer(source)
      const tokens = lexer.tokenize()
      assert(tokens.some(t => t.type === TokenType.FN))
      assert(tokens.some(t => t.type === TokenType.LPAREN))
      assert(tokens.some(t => t.type === TokenType.RETURN))
    })

    test('should tokenize array literal', () => {
      const source = '[1, 2, 3]'
      const lexer = new Lexer(source)
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.LBRACKET)
      assert.equal(tokens[1].type, TokenType.NUMBER)
      assert.equal(tokens[2].type, TokenType.COMMA)
    })

    test('should tokenize object literal', () => {
      const source = '{ x: 1, y: 2 }'
      const lexer = new Lexer(source)
      const tokens = lexer.tokenize()
      assert.equal(tokens[0].type, TokenType.LBRACE)
      assert.equal(tokens[1].type, TokenType.IDENTIFIER)
      assert.equal(tokens[2].type, TokenType.COLON)
    })
  })
})
