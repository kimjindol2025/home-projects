/**
 * Semantic Analyzer 테스트 스위트
 */

import { strict as assert } from 'assert'
import { Lexer } from '../src/lexer.js'
import { Parser } from '../src/parser.js'
import { SemanticAnalyzer, SemanticError } from '../src/semantic.js'

function analyze(source) {
  const lexer = new Lexer(source)
  const tokens = lexer.tokenize()
  const parser = new Parser(tokens)
  const ast = parser.parse()
  const analyzer = new SemanticAnalyzer()
  return analyzer.check(ast)
}

describe('Semantic Analyzer Tests', () => {
  describe('Valid Programs', () => {
    test('should accept simple variable declaration', () => {
      const result = analyze('let x = 5;')
      assert.equal(result.valid, true)
    })

    test('should accept variable usage', () => {
      const result = analyze('let x = 5; x + 1;')
      assert.equal(result.valid, true)
    })

    test('should accept function declaration and call', () => {
      const result = analyze(`
        fn foo(a, b) { return a + b; }
        foo(1, 2);
      `)
      assert.equal(result.valid, true)
    })

    test('should accept nested scopes', () => {
      const result = analyze(`
        let x = 1;
        { let y = 2; x + y; }
      `)
      assert.equal(result.valid, true)
    })

    test('should accept if statement', () => {
      const result = analyze(`
        let x = 5;
        if (x > 3) { }
      `)
      assert.equal(result.valid, true)
    })

    test('should accept loop statements', () => {
      const result = analyze(`
        let x = 0;
        while (x < 10) { x = x + 1; }
      `)
      assert.equal(result.valid, true)
    })

    test('should accept try-catch', () => {
      const result = analyze(`
        try {
          let x = 1;
        } catch (e) {
          let y = 2;
        }
      `)
      assert.equal(result.valid, true)
    })

    test('should accept function with return', () => {
      const result = analyze(`
        fn foo() {
          return 42;
        }
      `)
      assert.equal(result.valid, true)
    })
  })

  describe('Undeclared Variable Errors', () => {
    test('should error on undeclared variable usage', () => {
      const result = analyze('x + 1;')
      assert.equal(result.valid, false)
      assert(result.errors.some(e => e.includes('not declared')))
    })

    test('should error on undeclared function call', () => {
      const result = analyze('foo();')
      assert.equal(result.valid, false)
      assert(result.errors.some(e => e.includes('not declared')))
    })

    test('should allow variable in nested scope', () => {
      const result = analyze(`
        let x = 1;
        { x + 1; }
      `)
      assert.equal(result.valid, true)
    })

    test('should error on variable used outside scope', () => {
      const result = analyze(`
        { let x = 1; }
        x + 1;
      `)
      assert.equal(result.valid, false)
    })
  })

  describe('Duplicate Declaration Errors', () => {
    test('should error on duplicate variable declaration', () => {
      const result = analyze(`
        let x = 1;
        let x = 2;
      `)
      assert.equal(result.valid, false)
      assert(result.errors.some(e => e.includes('already declared')))
    })

    test('should allow duplicate in different scopes', () => {
      const result = analyze(`
        { let x = 1; }
        { let x = 2; }
      `)
      assert.equal(result.valid, true)
    })
  })

  describe('Type Inference', () => {
    test('should infer number type', () => {
      const result = analyze('let x = 42;')
      assert.equal(result.valid, true)
    })

    test('should infer string type', () => {
      const result = analyze('let x = "hello";')
      assert.equal(result.valid, true)
    })

    test('should infer boolean type', () => {
      const result = analyze('let x = true;')
      assert.equal(result.valid, true)
    })

    test('should infer array type', () => {
      const result = analyze('let x = [1, 2, 3];')
      assert.equal(result.valid, true)
    })

    test('should infer object type', () => {
      const result = analyze('let x = { a: 1 };')
      assert.equal(result.valid, true)
    })

    test('should infer function type', () => {
      const result = analyze(`
        fn foo() { }
        let f = foo;
      `)
      assert.equal(result.valid, true)
    })
  })

  describe('Function Scope', () => {
    test('should allow function parameters', () => {
      const result = analyze(`
        fn foo(a, b) {
          a + b;
        }
      `)
      assert.equal(result.valid, true)
    })

    test('should error on undeclared parameter', () => {
      const result = analyze(`
        fn foo() {
          x + 1;
        }
      `)
      assert.equal(result.valid, false)
    })

    test('should reject return outside function', () => {
      const result = analyze('return 42;')
      assert.equal(result.valid, false)
      assert(result.errors.some(e => e.includes('outside function')))
    })
  })

  describe('Loop Control', () => {
    test('should reject break outside loop', () => {
      const result = analyze('break;')
      assert.equal(result.valid, false)
      assert(result.errors.some(e => e.includes('outside loop')))
    })

    test('should reject continue outside loop', () => {
      const result = analyze('continue;')
      assert.equal(result.valid, false)
      assert(result.errors.some(e => e.includes('outside loop')))
    })

    test('should allow break inside while', () => {
      const result = analyze('while (true) { break; }')
      assert.equal(result.valid, true)
    })

    test('should allow break inside for', () => {
      const result = analyze('for (;;) { break; }')
      assert.equal(result.valid, true)
    })
  })

  describe('Exception Handling', () => {
    test('should allow throw in try', () => {
      const result = analyze('try { throw "error"; } catch (e) { }')
      assert.equal(result.valid, true)
    })

    test('should allow exception parameter access', () => {
      const result = analyze(`
        try { } catch (e) { e; }
      `)
      assert.equal(result.valid, true)
    })

    test('should disallow exception parameter outside catch', () => {
      const result = analyze(`
        try { } catch (e) { }
        e;
      `)
      assert.equal(result.valid, false)
    })
  })

  describe('Warnings', () => {
    test('should warn on unused variable', () => {
      const result = analyze('let x = 5; let y = 10;')
      assert(result.warnings.some(w => w.includes('never used')))
    })

    test('should not warn on used variable', () => {
      const result = analyze('let x = 5; x + 1;')
      assert(!result.warnings.some(w => w.includes('never used')))
    })

    test('should not warn on function parameters', () => {
      const result = analyze('fn foo(a, b) { }')
      assert(!result.warnings.some(w => w.includes('never used')))
    })
  })

  describe('Complex Programs', () => {
    test('should analyze fibonacci', () => {
      const result = analyze(`
        fn fib(n) {
          if (n <= 1) {
            return n;
          }
          return fib(n - 1) + fib(n - 2);
        }
        fib(10);
      `)
      assert.equal(result.valid, true)
    })

    test('should analyze nested functions', () => {
      const result = analyze(`
        fn outer(x) {
          fn inner(y) {
            return x + y;
          }
          return inner;
        }
      `)
      assert.equal(result.valid, true)
    })

    test('should analyze closure', () => {
      const result = analyze(`
        let x = 10;
        fn makeAdder(n) {
          return n + x;
        }
      `)
      assert.equal(result.valid, true)
    })
  })
})
