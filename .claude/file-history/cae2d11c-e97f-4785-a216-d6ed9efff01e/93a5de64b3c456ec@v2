/**
 * MindLang 파서 - 기본 사용 예제
 */

import { MindLangParser } from '../src/index.js'

// 예제 1: 간단한 변수 선언
console.log('=== 예제 1: 변수 선언 ===')
const parser = new MindLangParser()
let result = parser.parse('let x = 42;')
console.log('성공:', result.success)
console.log('AST:', JSON.stringify(result.ast, null, 2))
console.log()

// 예제 2: 함수 정의와 호출
console.log('=== 예제 2: 함수 ===')
result = parser.parse(`
  fn add(a, b) {
    return a + b;
  }
  add(5, 3);
`)
console.log('성공:', result.success)
console.log()

// 예제 3: 제어문
console.log('=== 예제 3: 제어문 ===')
result = parser.parse(`
  let sum = 0;
  for (let i = 0; i < 10; i = i + 1) {
    sum = sum + i;
  }
`)
console.log('성공:', result.success)
console.log()

// 예제 4: 배열과 객체
console.log('=== 예제 4: 배열과 객체 ===')
result = parser.parse(`
  let numbers = [1, 2, 3, 4, 5];
  let person = {
    name: "Alice",
    age: 30,
    city: "Seoul"
  };
`)
console.log('성공:', result.success)
console.log()

// 예제 5: 예외 처리
console.log('=== 예제 5: 예외 처리 ===')
result = parser.parse(`
  try {
    let x = 1 / 0;
  } catch (e) {
    throw "Division by zero!";
  } finally {
    let cleanup = true;
  }
`)
console.log('성공:', result.success)
console.log()

// 예제 6: 오류 감지
console.log('=== 예제 6: 오류 감지 ===')
result = parser.parse(`
  let x = 5;
  y = 10;  // 오류: y가 선언되지 않음
`)
console.log('성공:', result.success)
console.log('오류:', result.errors)
console.log()

// 예제 7: 피보나치 함수
console.log('=== 예제 7: 피보나치 ===')
result = parser.parse(`
  fn fibonacci(n) {
    if (n <= 1) {
      return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
  }

  fibonacci(10);
`)
console.log('성공:', result.success)
console.log()

// 예제 8: 복잡한 표현식
console.log('=== 예제 8: 복잡한 표현식 ===')
result = parser.parse(`
  let result = 2 + 3 * 4 - 5 / 2;
  let logical = (x > 10 && y < 20) || (z == 0);
  let nested = obj.method(arr[0], { a: 1, b: 2 });
`)
console.log('성공:', result.success)
console.log()

// 예제 9: 디버깅 모드
console.log('=== 예제 9: 디버깅 모드 (상세 출력) ===')
const debugParser = new MindLangParser({ debug: true })
result = debugParser.parse('let x = 1 + 2;')
console.log()

// 예제 10: 렉싱만 수행
console.log('=== 예제 10: 렉싱만 수행 ===')
result = parser.lex('let x = 42;')
console.log('토큰 수:', result.tokens.length)
result.tokens.forEach(tok => {
  if (tok.type !== 'EOF') {
    console.log(`- ${tok.type}: ${tok.value}`)
  }
})
