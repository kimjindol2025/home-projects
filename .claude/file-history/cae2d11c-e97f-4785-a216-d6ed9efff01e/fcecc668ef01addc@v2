/**
 * MindLang Semantic Analyzer (의미론 분석기)
 * AST → 검증된 AST (타입 체크, 스코프 관리, 오류 감지)
 *
 * 기능:
 * - 심볼 테이블 (변수, 함수)
 * - 스코프 관리 (전역, 함수, 블록)
 * - 타입 추론
 * - 오류 감지 (사용하지 않은 변수, 중복 정의, 타입 불일치)
 * - 의미론적 검증
 */

import * as AST from './ast.js'

export class SemanticError extends Error {
  constructor(message, node) {
    super(message)
    this.name = 'SemanticError'
    this.node = node
    this.line = node?.line || 0
    this.column = node?.column || 0
  }

  toString() {
    return `${this.name} at ${this.line}:${this.column}: ${this.message}`
  }
}

export class SymbolInfo {
  constructor(name, type, kind, node) {
    this.name = name
    this.type = type // 'number', 'string', 'boolean', 'function', 'object', 'array', 'any'
    this.kind = kind // 'variable', 'function', 'parameter'
    this.node = node // AST node
    this.used = false
    this.initialized = false
  }
}

export class SemanticAnalyzer {
  constructor() {
    this.scopes = [new Map()] // Global scope
    this.errors = []
    this.warnings = []
    this.currentFunction = null
    this.inLoop = false
  }

  // ============================================
  // 스코프 관리
  // ============================================

  pushScope() {
    this.scopes.push(new Map())
  }

  popScope() {
    if (this.scopes.length > 1) {
      const scope = this.scopes.pop()
      // 사용하지 않은 변수 경고
      for (const [name, info] of scope) {
        if (!info.used && info.kind === 'variable') {
          this.warnings.push(
            `Variable '${name}' is declared but never used at ${info.node.line}:${info.node.column}`
          )
        }
      }
    }
  }

  currentScope() {
    return this.scopes[this.scopes.length - 1]
  }

  declareSymbol(name, info) {
    const scope = this.currentScope()

    if (scope.has(name)) {
      throw new SemanticError(
        `Symbol '${name}' already declared in this scope`,
        info.node
      )
    }

    scope.set(name, info)
  }

  lookupSymbol(name) {
    // 역순으로 스코프 검색 (클로저)
    for (let i = this.scopes.length - 1; i >= 0; i--) {
      if (this.scopes[i].has(name)) {
        const info = this.scopes[i].get(name)
        info.used = true
        return info
      }
    }
    return null
  }

  // ============================================
  // 타입 추론
  // ============================================

  inferType(node) {
    if (!node) return 'any'

    switch (node.type) {
      case 'NumberLiteral':
        return 'number'

      case 'StringLiteral':
        return 'string'

      case 'BooleanLiteral':
        return 'boolean'

      case 'NullLiteral':
        return 'null'

      case 'ArrayLiteral':
        return 'array'

      case 'ObjectLiteral':
        return 'object'

      case 'Identifier': {
        const info = this.lookupSymbol(node.name)
        return info ? info.type : 'any'
      }

      case 'BinaryExpression': {
        const leftType = this.inferType(node.left)
        const rightType = this.inferType(node.right)

        // 기본 타입 체크
        switch (node.operator) {
          case '+':
            if (leftType === 'string' || rightType === 'string') return 'string'
            if (leftType === 'number' && rightType === 'number') return 'number'
            return 'any'
          case '-':
          case '*':
          case '/':
          case '%':
            if (leftType === 'number' && rightType === 'number') return 'number'
            return 'any'
          case '==':
          case '!=':
          case '<':
          case '>':
          case '<=':
          case '>=':
            return 'boolean'
          default:
            return 'any'
        }
      }

      case 'LogicalExpression':
        return 'boolean'

      case 'UnaryExpression':
        if (node.operator === '!') return 'boolean'
        return this.inferType(node.argument)

      case 'CallExpression': {
        const calleeInfo = this.lookupSymbol(node.callee.name)
        return calleeInfo && calleeInfo.type === 'function' ? 'any' : 'any'
      }

      case 'MemberExpression':
        return 'any' // 배열/객체 멤버는 any로 처리

      case 'AssignmentExpression':
        return this.inferType(node.right)

      case 'ConditionalExpression': {
        const consequentType = this.inferType(node.consequent)
        const alternateType = this.inferType(node.alternate)
        return consequentType === alternateType ? consequentType : 'any'
      }

      case 'FunctionDeclaration':
        return 'function'

      case 'ArrowFunctionExpression':
        return 'function'

      default:
        return 'any'
    }
  }

  // ============================================
  // 검증
  // ============================================

  analyze(node) {
    if (!node) return

    switch (node.type) {
      case 'Program':
        this.analyzeProgram(node)
        break

      case 'BlockStatement':
        this.analyzeBlockStatement(node)
        break

      case 'VariableDeclaration':
        this.analyzeVariableDeclaration(node)
        break

      case 'FunctionDeclaration':
        this.analyzeFunctionDeclaration(node)
        break

      case 'IfStatement':
        this.analyzeIfStatement(node)
        break

      case 'WhileStatement':
        this.analyzeWhileStatement(node)
        break

      case 'ForStatement':
        this.analyzeForStatement(node)
        break

      case 'ReturnStatement':
        this.analyzeReturnStatement(node)
        break

      case 'TryStatement':
        this.analyzeTryStatement(node)
        break

      case 'ThrowStatement':
        this.analyzeThrowStatement(node)
        break

      case 'ExpressionStatement':
        this.analyzeExpression(node.expression)
        break

      case 'BreakStatement':
      case 'ContinueStatement':
        if (!this.inLoop) {
          throw new SemanticError(
            `'${node.type}' not allowed outside loop`,
            node
          )
        }
        break

      case 'AssignmentExpression':
        this.analyzeAssignment(node)
        break

      default:
        this.analyzeExpression(node)
    }
  }

  analyzeProgram(node) {
    for (const stmt of node.body) {
      this.analyze(stmt)
    }
  }

  analyzeBlockStatement(node) {
    this.pushScope()
    for (const stmt of node.body) {
      this.analyze(stmt)
    }
    this.popScope()
  }

  analyzeVariableDeclaration(node) {
    for (const decl of node.declarations) {
      const name = decl.id.name
      let type = 'any'

      // 초기화된 경우 타입 추론
      if (decl.init) {
        type = this.inferType(decl.init)
        this.analyzeExpression(decl.init)
      }

      const info = new SymbolInfo(name, type, 'variable', node)
      info.initialized = !!decl.init

      this.declareSymbol(name, info)
    }
  }

  analyzeFunctionDeclaration(node) {
    const name = typeof node.name === 'string' ? node.name : node.name.name
    const info = new SymbolInfo(name, 'function', 'function', node)
    this.declareSymbol(name, info)

    // 함수 본문 분석
    const prevFunction = this.currentFunction
    this.currentFunction = node

    this.pushScope()
    for (const param of node.params) {
      const paramInfo = new SymbolInfo(param.name, 'any', 'parameter', param)
      paramInfo.used = true // 파라미터는 자동으로 used 처리
      this.declareSymbol(param.name, paramInfo)
    }

    this.analyze(node.body)
    this.popScope()

    this.currentFunction = prevFunction
  }

  analyzeIfStatement(node) {
    this.analyzeExpression(node.test)

    // 조건이 항상 true/false인지 확인
    if (node.test.type === 'BooleanLiteral') {
      if (!node.test.value && !node.alternate) {
        this.warnings.push(
          `Condition is always false, else block unreachable at ${node.line}:${node.column}`
        )
      }
    }

    this.analyze(node.consequent)
    if (node.alternate) {
      this.analyze(node.alternate)
    }
  }

  analyzeWhileStatement(node) {
    this.analyzeExpression(node.test)

    const prevInLoop = this.inLoop
    this.inLoop = true
    this.analyze(node.body)
    this.inLoop = prevInLoop
  }

  analyzeForStatement(node) {
    this.pushScope()

    if (node.init) {
      this.analyze(node.init)
    }

    if (node.test) {
      this.analyzeExpression(node.test)
    }

    if (node.update) {
      this.analyzeExpression(node.update)
    }

    const prevInLoop = this.inLoop
    this.inLoop = true
    this.analyze(node.body)
    this.inLoop = prevInLoop

    this.popScope()
  }

  analyzeReturnStatement(node) {
    if (!this.currentFunction) {
      throw new SemanticError('Return statement outside function', node)
    }

    if (node.argument) {
      this.analyzeExpression(node.argument)
    }
  }

  analyzeTryStatement(node) {
    this.analyze(node.block)

    if (node.handler) {
      this.pushScope()
      const paramName = node.handler.param.name
      const info = new SymbolInfo(paramName, 'any', 'variable', node.handler.param)
      this.declareSymbol(paramName, info)
      this.analyze(node.handler.body)
      this.popScope()
    }

    if (node.finalizer) {
      this.analyze(node.finalizer)
    }
  }

  analyzeThrowStatement(node) {
    this.analyzeExpression(node.argument)
  }

  analyzeAssignment(node) {
    if (node.left.type === 'Identifier') {
      const info = this.lookupSymbol(node.left.name)
      if (!info) {
        throw new SemanticError(
          `Variable '${node.left.name}' not declared`,
          node.left
        )
      }
      info.initialized = true
    }

    this.analyzeExpression(node.right)
  }

  analyzeExpression(node) {
    if (!node) return

    switch (node.type) {
      case 'Identifier': {
        const info = this.lookupSymbol(node.name)
        if (!info) {
          throw new SemanticError(
            `Variable '${node.name}' not declared`,
            node
          )
        }
        break
      }

      case 'BinaryExpression': {
        this.analyzeExpression(node.left)
        this.analyzeExpression(node.right)

        const leftType = this.inferType(node.left)
        const rightType = this.inferType(node.right)

        // 타입 호환성 체크 (선택적)
        if (node.operator === '+' && leftType === 'boolean' && rightType === 'number') {
          this.warnings.push(
            `Implicit type conversion: boolean + number at ${node.line}:${node.column}`
          )
        }
        break
      }

      case 'UnaryExpression':
        this.analyzeExpression(node.argument)
        break

      case 'LogicalExpression':
        this.analyzeExpression(node.left)
        this.analyzeExpression(node.right)
        break

      case 'CallExpression': {
        this.analyzeExpression(node.callee)

        if (node.callee.type === 'Identifier') {
          const info = this.lookupSymbol(node.callee.name)
          if (!info) {
            throw new SemanticError(
              `Function '${node.callee.name}' not declared`,
              node.callee
            )
          }
          if (info.type !== 'function') {
            throw new SemanticError(
              `'${node.callee.name}' is not a function`,
              node.callee
            )
          }
        }

        for (const arg of node.args) {
          this.analyzeExpression(arg)
        }
        break
      }

      case 'MemberExpression':
        this.analyzeExpression(node.object)
        if (node.computed) {
          this.analyzeExpression(node.property)
        }
        break

      case 'AssignmentExpression':
        this.analyzeAssignment(node)
        break

      case 'ConditionalExpression':
        this.analyzeExpression(node.test)
        this.analyzeExpression(node.consequent)
        this.analyzeExpression(node.alternate)
        break

      case 'ArrayLiteral':
        for (const elem of node.elements) {
          if (elem) this.analyzeExpression(elem)
        }
        break

      case 'ObjectLiteral':
        for (const prop of node.properties) {
          this.analyzeExpression(prop.value)
        }
        break
    }
  }

  // ============================================
  // 메인 API
  // ============================================

  check(ast) {
    try {
      this.analyze(ast)
      return {
        valid: this.errors.length === 0,
        errors: this.errors,
        warnings: this.warnings,
        ast: ast,
      }
    } catch (err) {
      if (err instanceof SemanticError) {
        this.errors.push(err.toString())
        return {
          valid: false,
          errors: [...this.errors, err.toString()],
          warnings: this.warnings,
          ast: ast,
        }
      }
      throw err
    }
  }
}

export default SemanticAnalyzer
