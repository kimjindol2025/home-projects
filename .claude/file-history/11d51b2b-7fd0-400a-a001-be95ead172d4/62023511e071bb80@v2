/**
 * JavaScript Compiler for FreeLang Light
 * script 블록을 JavaScript로 컴파일
 */

class JSCompiler {
  compile(ast) {
    let js = '';

    // 헤더 주석
    js += '// FreeLang Light - Auto-generated JavaScript\n';
    js += `// Component: ${ast.name}\n`;
    js += `// Generated: ${new Date().toISOString()}\n\n`;

    // Props 초기화
    if (ast.props.properties.length > 0) {
      js += '// Props\n';
      js += 'const props = {\n';
      ast.props.properties.forEach(prop => {
        const defaultValue = this.getDefaultValue(prop.type);
        js += `  ${prop.name}: ${defaultValue},\n`;
      });
      js += '};\n\n';
    }

    // 함수 컴파일
    if (ast.script.functions.length > 0) {
      js += '// Functions\n';
      ast.script.functions.forEach(fn => {
        js += this.compileFunction(fn);
        js += '\n';
      });
    }

    return js;
  }

  /**
   * 함수 컴파일
   */
  compileFunction(fn) {
    let code = `function ${fn.name}(${fn.params.join(', ')}) {\n`;
    code += this.indentCode(fn.body, 2);
    code += '\n}\n';
    return code;
  }

  /**
   * 기본값 생성
   */
  getDefaultValue(type) {
    switch (type) {
      case 'string':
        return '""';
      case 'number':
        return '0';
      case 'boolean':
        return 'false';
      case 'array<string>':
      case 'array<number>':
        return '[]';
      case 'object':
        return '{}';
      default:
        return 'null';
    }
  }

  /**
   * 코드 들여쓰기
   */
  indentCode(code, spaces) {
    const indent = ' '.repeat(spaces);
    return code.split('\n')
      .map(line => line ? indent + line : line)
      .join('\n');
  }
}

module.exports = { JSCompiler };
