/**
 * FreeLang Light Search API Server
 * 검색 엔드포인트 제공
 */

const http = require('http');
const fs = require('fs');
const path = require('path');
const url = require('url');
const { FreeLangIndexer } = require('./indexer');

const PORT = 4002;

class FreeLangSearchAPI {
  constructor() {
    this.indexer = new FreeLangIndexer();
    this.indexPath = path.join(__dirname, '..', 'freelang-light.index.json');
    this.loadOrCreateIndex();
  }

  loadOrCreateIndex() {
    if (fs.existsSync(this.indexPath)) {
      try {
        this.indexer.loadIndex(this.indexPath);
        console.log(`✅ Loaded existing index`);
      } catch (e) {
        console.warn(`⚠️ Failed to load index, creating new one`);
        this.createIndex();
      }
    } else {
      this.createIndex();
    }
  }

  createIndex() {
    const examplesDir = path.join(__dirname, '..', 'examples');
    if (fs.existsSync(examplesDir)) {
      this.indexer.indexDirectory(examplesDir);
      this.indexer.saveIndex(this.indexPath);
    }
  }

  startServer() {
    const server = http.createServer((req, res) => {
      // CORS 설정
      res.setHeader('Content-Type', 'application/json');
      res.setHeader('Access-Control-Allow-Origin', '*');
      res.setHeader('Access-Control-Allow-Methods', 'GET, OPTIONS');
      res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

      // OPTIONS 요청 처리
      if (req.method === 'OPTIONS') {
        res.writeHead(200);
        return res.end();
      }

      const parsedUrl = url.parse(req.url, true);
      const pathname = parsedUrl.pathname;
      const query = parsedUrl.query;

      // 헬스 체크
      if (pathname === '/api/health') {
        const stats = this.indexer.getStats();
        return res.end(JSON.stringify({
          status: '✅ ok',
          indexed_at: new Date().toISOString(),
          ...stats
        }));
      }

      // 검색
      if (pathname === '/api/search') {
        const q = query.q || '';

        if (!q) {
          res.writeHead(400);
          return res.end(JSON.stringify({
            error: 'Query parameter "q" is required'
          }));
        }

        const results = this.indexer.search(q);
        return res.end(JSON.stringify(results));
      }

      // 3단어 검색 (freelang-v2의 KPM과 호환)
      if (pathname === '/api/search-three-words') {
        const word1 = query.w1 || '';
        const word2 = query.w2 || '';
        const word3 = query.w3 || '';

        const allWords = [word1, word2, word3].filter(w => w).join(' ');

        if (!allWords) {
          res.writeHead(400);
          return res.end(JSON.stringify({
            error: 'At least one word parameter required (w1, w2, w3)'
          }));
        }

        const results = this.indexer.search(allWords);
        return res.end(JSON.stringify({
          ...results,
          search_mode: 'three-words'
        }));
      }

      // 컴포넌트 상세 조회
      if (pathname.startsWith('/api/component/')) {
        const componentName = pathname.replace('/api/component/', '');
        const entry = this.indexer.index.find(e =>
          e.component.toLowerCase() === componentName.toLowerCase()
        );

        if (!entry) {
          res.writeHead(404);
          return res.end(JSON.stringify({
            error: `Component '${componentName}' not found`
          }));
        }

        return res.end(JSON.stringify({
          component: entry.component,
          file: entry.file,
          props: entry.props,
          functions: entry.functions,
          styles: entry.styles,
          markup_elements: entry.markup,
          file_size: entry.file_size,
          ranking: entry.ranking
        }));
      }

      // 모든 컴포넌트 목록
      if (pathname === '/api/components') {
        const list = this.indexer.index.map(e => ({
          name: e.component,
          file: e.file,
          props_count: e.props.length,
          functions_count: e.functions.length,
          styles_count: e.styles.length,
          ranking: e.ranking
        }));

        return res.end(JSON.stringify({
          total: list.length,
          components: list
        }));
      }

      // API 문서
      if (pathname === '/api/docs') {
        return res.end(JSON.stringify({
          name: 'FreeLang Light Search API',
          version: '1.0',
          endpoints: [
            {
              method: 'GET',
              path: '/api/health',
              description: 'Health check',
              example: 'GET /api/health'
            },
            {
              method: 'GET',
              path: '/api/search?q=button',
              description: 'Search components by query',
              example: 'GET /api/search?q=button'
            },
            {
              method: 'GET',
              path: '/api/search-three-words?w1=button&w2=click&w3=event',
              description: 'Search with three words (compatible with KPM)',
              example: 'GET /api/search-three-words?w1=button&w2=click&w3=event'
            },
            {
              method: 'GET',
              path: '/api/component/Button',
              description: 'Get component details',
              example: 'GET /api/component/Button'
            },
            {
              method: 'GET',
              path: '/api/components',
              description: 'List all components',
              example: 'GET /api/components'
            },
            {
              method: 'GET',
              path: '/api/docs',
              description: 'API documentation',
              example: 'GET /api/docs'
            }
          ],
          examples: [
            {
              description: 'Search for button-related components',
              request: 'GET http://localhost:4002/api/search?q=button',
              response: {
                query: 'button',
                total_results: 2,
                results: [
                  {
                    component: 'Button',
                    file: 'examples/button.free',
                    type: 'component',
                    props: 2,
                    functions: 3,
                    ranking: 45
                  }
                ]
              }
            }
          ]
        }));
      }

      // 404
      res.writeHead(404);
      res.end(JSON.stringify({
        error: 'Not found',
        available_endpoints: ['/api/health', '/api/search', '/api/components', '/api/docs']
      }));
    });

    server.listen(PORT, () => {
      console.log(`\n🚀 FreeLang Light Search API running on http://localhost:${PORT}`);
      console.log(`📖 API Docs: http://localhost:${PORT}/api/docs\n`);
      console.log(`📊 Server Stats:`);
      const stats = this.indexer.getStats();
      console.log(`   Components: ${stats.total_components}`);
      console.log(`   Indexed Items: ${stats.total_indexed_items}`);
      console.log(`   Total Functions: ${stats.total_functions}\n`);
    });

    return server;
  }

  // CLI 사용을 위한 메서드들
  searchCLI(query) {
    const results = this.indexer.search(query);
    return results;
  }

  indexDirectoryCLI(dirPath) {
    this.indexer.indexDirectory(dirPath);
    this.indexer.saveIndex(this.indexPath);
  }

  getStatsCLI() {
    return this.indexer.getStats();
  }
}

// 직접 실행 시
if (require.main === module) {
  const api = new FreeLangSearchAPI();
  api.startServer();
}

module.exports = { FreeLangSearchAPI };
