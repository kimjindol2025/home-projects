#!/usr/bin/env node

/**
 * FreeLang Light CLI
 * 커맨드라인 인터페이스
 */

const fs = require('fs');
const path = require('path');
const { parseFreeLang } = require('./parser');
const { FreeLangIndexer } = require('./indexer');
const { FreeLangSearchAPI } = require('./search-api');
const { CSSCompiler } = require('./css-compiler');
const { JSCompiler } = require('./js-compiler');
const { HTMLGenerator } = require('./html-generator');

class FreeLangCLI {
  constructor() {
    this.indexer = new FreeLangIndexer();
    this.searchAPI = new FreeLangSearchAPI();
  }

  showHelp() {
    console.log(`
╔════════════════════════════════════════════════╗
║         FreeLang Light CLI v1.0               ║
║  Unified Frontend Language Compiler            ║
╚════════════════════════════════════════════════╝

📖 USAGE:
   freelang <command> [options]

🎯 COMMANDS:

   compile <file>          Compile .free file to CSS/JS/HTML
   search <query>          Search components
   index <dir>             Index directory
   serve                   Start search API server (port 4002)
   list                    List all indexed components
   stats                   Show indexing statistics
   help                    Show this help message

📝 EXAMPLES:

   # Compile a component
   freelang compile card.free
   → Generates: card.css, card.js, card.html

   # Search for components
   freelang search "button"
   → Find all components matching 'button'

   # Index a directory
   freelang index ./components
   → Creates freelang-light.index.json

   # Start API server
   freelang serve
   → Runs on http://localhost:4002

   # List all components
   freelang list
   → Shows all indexed components

   # Show statistics
   freelang stats
   → Total components, functions, styles, etc.

🔧 OPTIONS:

   -o, --output <dir>      Output directory (default: current dir)
   -f, --format <format>   Output format: html, css, js, all (default: all)
   -m, --minify            Minify output
   -v, --version           Show version
   -h, --help              Show help

📚 DOCUMENTATION:

   https://github.com/kim/freelang-light
   Documentation: ./docs/SPEC.md
    `);
  }

  showVersion() {
    console.log('FreeLang Light v1.0.0');
  }

  /**
   * compile <file> 명령
   */
  async compileFile(filePath, options = {}) {
    console.log(`\n📦 Compiling: ${filePath}`);

    if (!fs.existsSync(filePath)) {
      console.error(`❌ File not found: ${filePath}`);
      process.exit(1);
    }

    try {
      const content = fs.readFileSync(filePath, 'utf-8');
      const ast = parseFreeLang(content);

      console.log(`✅ Parsed component: ${ast.name}`);

      const outputDir = options.output || '.';
      const baseName = path.basename(filePath, '.free');

      // CSS 컴파일
      const cssCompiler = new CSSCompiler();
      const cssCode = cssCompiler.compile(ast);
      const cssFile = path.join(outputDir, `${baseName}.css`);
      fs.writeFileSync(cssFile, cssCode);
      console.log(`   ✅ Generated: ${baseName}.css (${cssCode.length} bytes)`);

      // JavaScript 컴파일
      const jsCompiler = new JSCompiler();
      const jsCode = jsCompiler.compile(ast);
      const jsFile = path.join(outputDir, `${baseName}.js`);
      fs.writeFileSync(jsFile, jsCode);
      console.log(`   ✅ Generated: ${baseName}.js (${jsCode.length} bytes)`);

      // HTML 생성
      const htmlGen = new HTMLGenerator();
      const htmlCode = htmlGen.generate(ast);
      const htmlFile = path.join(outputDir, `${baseName}.html`);
      fs.writeFileSync(htmlFile, htmlCode);
      console.log(`   ✅ Generated: ${baseName}.html (${htmlCode.length} bytes)`);

      console.log(`\n✨ Compilation successful!`);
      console.log(`   Output directory: ${path.resolve(outputDir)}\n`);
    } catch (error) {
      console.error(`❌ Compilation failed: ${error.message}`);
      process.exit(1);
    }
  }

  /**
   * search <query> 명령
   */
  searchComponents(query) {
    console.log(`\n🔍 Searching for: "${query}"`);

    const results = this.searchAPI.searchCLI(query);

    if (results.total_results === 0) {
      console.log(`❌ No results found\n`);
      return;
    }

    console.log(`\n✅ Found ${results.total_results} result(s):\n`);
    results.results.forEach((result, i) => {
      console.log(`${i + 1}. ${result.component}`);
      console.log(`   File: ${result.file}`);
      console.log(`   Props: ${result.props}, Functions: ${result.functions}, Styles: ${result.styles}`);
      console.log(`   Match fields: ${result.match_fields.join(', ')}`);
      console.log(`   Ranking: ${result.ranking}\n`);
    });
  }

  /**
   * index <dir> 명령
   */
  indexDirectory(dirPath) {
    console.log(`\n📂 Indexing directory: ${dirPath}`);

    if (!fs.existsSync(dirPath)) {
      console.error(`❌ Directory not found: ${dirPath}`);
      process.exit(1);
    }

    try {
      this.searchAPI.indexDirectoryCLI(dirPath);
      const stats = this.searchAPI.getStatsCLI();

      console.log(`\n✅ Indexing complete!`);
      console.log(`   Components: ${stats.total_components}`);
      console.log(`   Indexed items: ${stats.total_indexed_items}`);
      console.log(`   Total functions: ${stats.total_functions}`);
      console.log(`   Total styles: ${stats.total_styles}\n`);
    } catch (error) {
      console.error(`❌ Indexing failed: ${error.message}`);
      process.exit(1);
    }
  }

  /**
   * list 명령
   */
  listComponents() {
    console.log(`\n📋 Indexed Components:\n`);

    const components = this.searchAPI.indexer.components;

    if (components.length === 0) {
      console.log(`   (No components indexed)\n`);
      return;
    }

    components.forEach((name, i) => {
      const entry = this.searchAPI.indexer.index.find(e => e.component === name);
      console.log(`${i + 1}. ${name}`);
      console.log(`   File: ${entry.file}`);
      console.log(`   Props: ${entry.props.length}, Functions: ${entry.functions.length}`);
      console.log(`   Ranking: ${entry.ranking}\n`);
    });

    console.log(`Total: ${components.length} components\n`);
  }

  /**
   * stats 명령
   */
  showStats() {
    console.log(`\n📊 FreeLang Light Statistics:\n`);

    const stats = this.searchAPI.getStatsCLI();

    console.log(`   Components indexed: ${stats.total_components}`);
    console.log(`   Total indexed items: ${stats.total_indexed_items}`);
    console.log(`   Total props: ${stats.total_props}`);
    console.log(`   Total functions: ${stats.total_functions}`);
    console.log(`   Total styles: ${stats.total_styles}`);
    console.log(`   Avg file size: ${stats.avg_file_size} bytes\n`);
  }

  /**
   * serve 명령
   */
  startServer() {
    const api = new FreeLangSearchAPI();
    api.startServer();
  }

  /**
   * 메인 CLI 처리
   */
  async run(args) {
    if (args.length === 0) {
      this.showHelp();
      return;
    }

    const command = args[0];
    const cmdArgs = args.slice(1);

    switch (command) {
      case 'compile':
        if (!cmdArgs[0]) {
          console.error('❌ Usage: freelang compile <file>');
          process.exit(1);
        }
        await this.compileFile(cmdArgs[0]);
        break;

      case 'search':
        if (!cmdArgs[0]) {
          console.error('❌ Usage: freelang search <query>');
          process.exit(1);
        }
        this.searchComponents(cmdArgs.join(' '));
        break;

      case 'index':
        if (!cmdArgs[0]) {
          console.error('❌ Usage: freelang index <directory>');
          process.exit(1);
        }
        this.indexDirectory(cmdArgs[0]);
        break;

      case 'list':
        this.listComponents();
        break;

      case 'stats':
        this.showStats();
        break;

      case 'serve':
        this.startServer();
        break;

      case 'help':
      case '-h':
      case '--help':
        this.showHelp();
        break;

      case 'version':
      case '-v':
      case '--version':
        this.showVersion();
        break;

      default:
        console.error(`❌ Unknown command: ${command}`);
        console.log(`\nRun 'freelang help' for usage information.\n`);
        process.exit(1);
    }
  }
}

// CLI 실행
if (require.main === module) {
  const cli = new FreeLangCLI();
  cli.run(process.argv.slice(2));
}

module.exports = { FreeLangCLI };
