/**
 * Expression Evaluator for FreeLang Light
 * 템플릿 표현식 평가 (조건, 반복, 계산)
 */

class ExpressionEvaluator {
  constructor(props = {}) {
    this.props = props;
    this.variables = new Map();
  }

  /**
   * 표현식 평가
   * 예: "count > 0", "item.name", "items.length"
   */
  evaluate(expression, context = {}) {
    const allContext = { ...this.props, ...context };

    try {
      // 변수 치환
      let expr = expression;
      for (const [key, value] of Object.entries(allContext)) {
        // {변수}를 실제 값으로 대체
        expr = expr.replace(new RegExp(`\\b${key}\\b`, 'g'), this.getValueCode(value));
      }

      // 안전한 평가
      const result = Function('"use strict"; return (' + expr + ')')();
      return result;
    } catch (error) {
      console.warn(`Expression evaluation failed: "${expression}"`, error.message);
      return null;
    }
  }

  /**
   * 값을 JavaScript 코드로 변환
   */
  getValueCode(value) {
    if (value === null || value === undefined) {
      return 'null';
    }
    if (typeof value === 'string') {
      return JSON.stringify(value);
    }
    if (typeof value === 'number' || typeof value === 'boolean') {
      return String(value);
    }
    if (Array.isArray(value)) {
      return JSON.stringify(value);
    }
    if (typeof value === 'object') {
      return JSON.stringify(value);
    }
    return JSON.stringify(value);
  }

  /**
   * 조건부 평가
   * if 표현식 평가
   */
  evaluateCondition(condition, context = {}) {
    const result = this.evaluate(condition, context);
    return Boolean(result);
  }

  /**
   * 반복 평가
   * for item in items → [{item, index}, ...]
   */
  evaluateLoop(loopExpression, context = {}) {
    // "item in items" 형식 파싱
    const match = loopExpression.match(/^\s*(\w+)\s+in\s+(\w+)\s*$/);

    if (!match) {
      throw new Error(`Invalid loop expression: "${loopExpression}"`);
    }

    const [, itemVar, arrayVar] = match;
    const array = context[arrayVar] || this.props[arrayVar];

    if (!Array.isArray(array)) {
      console.warn(`"${arrayVar}" is not an array`);
      return [];
    }

    return array.map((item, index) => ({
      [itemVar]: item,
      index,
      first: index === 0,
      last: index === array.length - 1
    }));
  }

  /**
   * 삼항 연산자 처리
   * "condition ? true_value : false_value"
   */
  evaluateTernary(expression, context = {}) {
    const match = expression.match(/^(.+?)\s*\?\s*(.+?)\s*:\s*(.+)$/);

    if (!match) {
      return this.evaluate(expression, context);
    }

    const [, condition, trueExpr, falseExpr] = match;
    const condResult = this.evaluateCondition(condition, context);

    return condResult
      ? this.evaluate(trueExpr, context)
      : this.evaluate(falseExpr, context);
  }

  /**
   * Props 기본값 처리
   * "name: string = 'default'" → { name: 'default' }
   */
  parseDefaultValue(typeDeclaration) {
    // "string = 'default'" 형식 파싱
    const match = typeDeclaration.match(/^(.+?)\s*=\s*(.+)$/);

    if (!match) {
      // 기본값이 없으면 타입 기본값 반환
      return this.getDefaultForType(typeDeclaration.trim());
    }

    const [, type, defaultValue] = match;
    const typeStr = type.trim();

    // 문자열 값
    if (defaultValue.match(/^['"](.*)['"]$/)) {
      const value = defaultValue.slice(1, -1);
      return value;
    }

    // 숫자 값
    if (!isNaN(defaultValue)) {
      return Number(defaultValue);
    }

    // boolean 값
    if (defaultValue === 'true') return true;
    if (defaultValue === 'false') return false;

    // null
    if (defaultValue === 'null') return null;

    // 배열 값
    if (defaultValue === '[]') return [];

    // 객체 값
    if (defaultValue === '{}') return {};

    // 평가해서 반환
    try {
      return Function('"use strict"; return (' + defaultValue + ')')();
    } catch (e) {
      return this.getDefaultForType(typeStr);
    }
  }

  /**
   * 타입별 기본값
   */
  getDefaultForType(type) {
    if (type.includes('array')) return [];
    if (type.includes('object')) return {};
    if (type.includes('number')) return 0;
    if (type.includes('boolean')) return false;
    return ''; // string
  }

  /**
   * 표현식에서 변수 추출
   */
  extractVariables(expression) {
    const vars = new Set();
    const matches = expression.match(/\b[a-zA-Z_]\w*\b/g);

    if (matches) {
      matches.forEach(m => {
        if (!this.isKeyword(m)) {
          vars.add(m);
        }
      });
    }

    return Array.from(vars);
  }

  /**
   * JavaScript 예약어 확인
   */
  isKeyword(word) {
    const keywords = [
      'true', 'false', 'null', 'undefined',
      'if', 'else', 'for', 'while', 'return',
      'function', 'var', 'let', 'const',
      'and', 'or', 'not', 'in'
    ];
    return keywords.includes(word);
  }
}

module.exports = { ExpressionEvaluator };
