/**
 * FreeLang Light Indexer
 * .free 파일들을 파싱해서 검색 인덱스 생성
 */

const fs = require('fs');
const path = require('path');
const { parseFreeLang } = require('./parser');

class FreeLangIndexer {
  constructor() {
    this.index = [];
    this.components = [];
  }

  /**
   * 디렉토리의 모든 .free 파일 인덱싱
   */
  indexDirectory(dirPath) {
    console.log(`📂 Indexing directory: ${dirPath}`);

    const files = this.findFreeLangFiles(dirPath);
    console.log(`📄 Found ${files.length} .free files`);

    files.forEach(file => {
      try {
        this.indexFile(file);
      } catch (error) {
        console.error(`❌ Error indexing ${file}: ${error.message}`);
      }
    });

    console.log(`✅ Indexed ${this.components.length} components`);
    return this.index;
  }

  /**
   * 단일 .free 파일 인덱싱
   */
  indexFile(filePath) {
    const content = fs.readFileSync(filePath, 'utf-8');
    const ast = parseFreeLang(content);

    const indexEntry = {
      file: filePath,
      component: ast.name,
      type: 'component',
      props: ast.props.properties.map(p => ({
        name: p.name,
        type: p.type
      })),
      functions: ast.script.functions.map(f => ({
        name: f.name,
        params: f.params
      })),
      styles: this.extractStyleSelectors(ast.style.content),
      markup: this.extractMarkupElements(ast.markup.content),
      searchable_text: this.generateSearchableText(ast),
      file_size: content.length,
      indexed_at: new Date().toISOString(),
      ranking: 0
    };

    // 랭킹 계산
    indexEntry.ranking = this.calculateRanking(indexEntry);

    this.index.push(indexEntry);
    this.components.push(ast.name);
  }

  /**
   * CSS 선택자 추출
   */
  extractStyleSelectors(styleContent) {
    const selectors = [];
    const regex = /\.([a-zA-Z0-9_-]+)|#([a-zA-Z0-9_-]+)|@media/g;
    let match;

    while ((match = regex.exec(styleContent)) !== null) {
      if (match[1]) selectors.push(`.${match[1]}`);
      if (match[2]) selectors.push(`#${match[2]}`);
    }

    return [...new Set(selectors)]; // 중복 제거
  }

  /**
   * HTML 요소 추출
   */
  extractMarkupElements(markupContent) {
    const elements = [];
    const regex = /<([a-zA-Z][a-zA-Z0-9]*)/g;
    let match;

    while ((match = regex.exec(markupContent)) !== null) {
      elements.push(match[1]);
    }

    return [...new Set(elements)];
  }

  /**
   * 검색 가능한 텍스트 생성
   */
  generateSearchableText(ast) {
    const parts = [
      ast.name,
      ...ast.props.properties.map(p => p.name),
      ...ast.script.functions.map(f => f.name),
      ...this.extractStyleSelectors(ast.style.content),
      ...this.extractMarkupElements(ast.markup.content)
    ];

    return parts.join(' ').toLowerCase();
  }

  /**
   * 검색 랭킹 계산
   */
  calculateRanking(entry) {
    let score = 0;

    // Props 개수 (더 많으면 더 복잡)
    score += entry.props.length * 5;

    // 함수 개수
    score += entry.functions.length * 10;

    // 스타일 선택자 개수
    score += entry.styles.length * 3;

    // 마크업 요소 개수
    score += entry.markup.length * 2;

    // 파일 크기
    score += Math.floor(entry.file_size / 100);

    return score;
  }

  /**
   * .free 파일 찾기
   */
  findFreeLangFiles(dirPath) {
    const files = [];

    const traverse = (currentPath) => {
      const entries = fs.readdirSync(currentPath, { withFileTypes: true });

      entries.forEach(entry => {
        const fullPath = path.join(currentPath, entry.name);

        if (entry.isDirectory() && !entry.name.startsWith('.')) {
          traverse(fullPath);
        } else if (entry.isFile() && entry.name.endsWith('.free')) {
          files.push(fullPath);
        }
      });
    };

    traverse(dirPath);
    return files;
  }

  /**
   * 검색
   */
  search(query) {
    const q = query.toLowerCase();

    const results = this.index
      .filter(entry => {
        // 컴포넌트 이름 매칭
        if (entry.component.toLowerCase().includes(q)) return true;

        // Props 매칭
        if (entry.props.some(p => p.name.toLowerCase().includes(q))) return true;

        // 함수 매칭
        if (entry.functions.some(f => f.name.toLowerCase().includes(q))) return true;

        // 스타일 선택자 매칭
        if (entry.styles.some(s => s.toLowerCase().includes(q))) return true;

        // 전체 검색 텍스트 매칭
        if (entry.searchable_text.includes(q)) return true;

        return false;
      })
      .map(entry => ({
        component: entry.component,
        file: entry.file,
        type: 'component',
        props: entry.props.length,
        functions: entry.functions.length,
        styles: entry.styles.length,
        ranking: entry.ranking,
        match_fields: this.getMatchFields(entry, q)
      }))
      .sort((a, b) => b.ranking - a.ranking);

    return {
      query,
      total_results: results.length,
      results
    };
  }

  /**
   * 매칭된 필드 반환
   */
  getMatchFields(entry, query) {
    const q = query.toLowerCase();
    const fields = [];

    if (entry.component.toLowerCase().includes(q)) fields.push('component');
    if (entry.props.some(p => p.name.toLowerCase().includes(q))) fields.push('props');
    if (entry.functions.some(f => f.name.toLowerCase().includes(q))) fields.push('functions');
    if (entry.styles.some(s => s.toLowerCase().includes(q))) fields.push('styles');

    return fields;
  }

  /**
   * 인덱스를 파일로 저장
   */
  saveIndex(outputFile) {
    const data = {
      version: '1.0',
      created_at: new Date().toISOString(),
      total_components: this.components.length,
      total_indexed_items: this.index.length,
      components: this.components,
      index: this.index
    };

    fs.writeFileSync(outputFile, JSON.stringify(data, null, 2));
    console.log(`✅ Index saved to ${outputFile}`);
    return data;
  }

  /**
   * 인덱스 로드
   */
  loadIndex(inputFile) {
    const data = JSON.parse(fs.readFileSync(inputFile, 'utf-8'));
    this.index = data.index;
    this.components = data.components;
    console.log(`✅ Loaded ${data.total_components} components from ${inputFile}`);
    return data;
  }

  /**
   * 통계 반환
   */
  getStats() {
    return {
      total_components: this.components.length,
      total_indexed_items: this.index.length,
      total_props: this.index.reduce((sum, e) => sum + e.props.length, 0),
      total_functions: this.index.reduce((sum, e) => sum + e.functions.length, 0),
      total_styles: this.index.reduce((sum, e) => sum + e.styles.length, 0),
      avg_file_size: Math.floor(this.index.reduce((sum, e) => sum + e.file_size, 0) / this.index.length)
    };
  }
}

module.exports = { FreeLangIndexer };
