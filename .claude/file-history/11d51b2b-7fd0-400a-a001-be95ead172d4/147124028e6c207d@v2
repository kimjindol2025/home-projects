// ============================================================================
// FreeLang Phase 5: Circuit Breaker Pattern with Weighted Load Balancing
// ============================================================================

// Circuit Breaker States
const STATE = {
  CLOSED: 'CLOSED',           // Normal operation, requests pass through
  OPEN: 'OPEN',               // Failure detected, fast-fail
  HALF_OPEN: 'HALF_OPEN'      // Recovery attempt, single request allowed
};

class CircuitBreaker {
  constructor(options = {}) {
    this.failureThreshold = options.failureThreshold || 5;      // Failures before OPEN
    this.successThreshold = options.successThreshold || 2;      // Successes to CLOSED
    this.timeout = options.timeout || 60000;                    // Timeout before HALF_OPEN
    this.monitoringPeriod = options.monitoringPeriod || 10000;  // Period to reset counter

    this.state = STATE.CLOSED;
    this.failureCount = 0;
    this.successCount = 0;
    this.lastFailureTime = null;
    this.nextAttemptTime = null;
    this.totalCalls = 0;
    this.totalFailures = 0;
    this.metrics = [];

    this.onStateChange = options.onStateChange || (() => {});
  }

  isCallable() {
    if (this.state === STATE.CLOSED) return true;
    if (this.state === STATE.OPEN) {
      if (Date.now() >= this.nextAttemptTime) {
        this.transitionTo(STATE.HALF_OPEN);
        return true;
      }
      return false;
    }
    if (this.state === STATE.HALF_OPEN) return true;
    return false;
  }

  recordSuccess() {
    this.totalCalls++;
    this.logMetric('SUCCESS');

    if (this.state === STATE.HALF_OPEN) {
      this.successCount++;
      if (this.successCount >= this.successThreshold) {
        this.transitionTo(STATE.CLOSED);
        this.failureCount = 0;
        this.successCount = 0;
      }
    } else if (this.state === STATE.CLOSED) {
      this.failureCount = Math.max(0, this.failureCount - 1);
    }
  }

  recordFailure() {
    this.totalCalls++;
    this.totalFailures++;
    this.failureCount++;
    this.lastFailureTime = Date.now();
    this.logMetric('FAILURE');

    if (this.state === STATE.HALF_OPEN) {
      this.transitionTo(STATE.OPEN);
      this.successCount = 0;
    } else if (this.state === STATE.CLOSED && this.failureCount >= this.failureThreshold) {
      this.transitionTo(STATE.OPEN);
      this.nextAttemptTime = Date.now() + this.timeout;
    }
  }

  transitionTo(newState) {
    const oldState = this.state;
    this.state = newState;

    console.log(`🔄 Circuit Breaker: ${oldState} → ${newState}`);
    this.onStateChange({
      from: oldState,
      to: newState,
      timestamp: new Date().toISOString()
    });
  }

  logMetric(status) {
    this.metrics.push({
      timestamp: new Date().toISOString(),
      status,
      state: this.state,
      failureCount: this.failureCount
    });

    // Keep last 1000 metrics
    if (this.metrics.length > 1000) {
      this.metrics.shift();
    }
  }

  getStatus() {
    const successRate = this.totalCalls > 0
      ? ((this.totalCalls - this.totalFailures) / this.totalCalls * 100).toFixed(2)
      : 100;

    return {
      state: this.state,
      failureCount: this.failureCount,
      successCount: this.successCount,
      totalCalls: this.totalCalls,
      totalFailures: this.totalFailures,
      successRate: `${successRate}%`,
      lastFailureTime: this.lastFailureTime,
      nextAttemptTime: this.nextAttemptTime,
      metrics: this.metrics.slice(-10)
    };
  }

  reset() {
    this.state = STATE.CLOSED;
    this.failureCount = 0;
    this.successCount = 0;
    this.lastFailureTime = null;
    this.nextAttemptTime = null;
    console.log('🔄 Circuit Breaker reset to CLOSED');
  }
}

// ──────────────────────────────────────────────────────────────────────────
// Service with Weighted Load Balancing
// ──────────────────────────────────────────────────────────────────────────

class Service {
  constructor(name, host, port, weight = 1) {
    this.name = name;
    this.host = host;
    this.port = port;
    this.weight = weight;  // Higher weight = higher chance of selection
    this.breaker = new CircuitBreaker({
      failureThreshold: 5,
      successThreshold: 2,
      timeout: 30000
    });
    this.requestCount = 0;
    this.averageResponseTime = 0;
  }

  isHealthy() {
    return this.breaker.state !== STATE.OPEN;
  }

  isCallable() {
    return this.breaker.isCallable();
  }

  getScore() {
    // Score = weight * health * response_time_factor
    const healthFactor = this.breaker.state === STATE.CLOSED ? 1.0 : 0.5;
    const responseTimeFactor = Math.max(0.1, 1.0 / (1 + this.averageResponseTime / 100));
    return this.weight * healthFactor * responseTimeFactor;
  }

  recordCall(success, responseTime = 0) {
    this.requestCount++;
    if (success) {
      this.breaker.recordSuccess();
    } else {
      this.breaker.recordFailure();
    }

    // Exponential moving average for response time
    this.averageResponseTime = (this.averageResponseTime * 0.9) + (responseTime * 0.1);
  }
}

// ──────────────────────────────────────────────────────────────────────────
// Service Registry with Load Balancing
// ──────────────────────────────────────────────────────────────────────────

class ServiceRegistry {
  constructor() {
    this.services = new Map();
    this.callHistory = [];
    this.totalCalls = 0;
  }

  registerService(name, host, port, weight = 1) {
    if (this.services.has(name)) {
      console.warn(`⚠️ Service '${name}' already registered`);
      return false;
    }

    const service = new Service(name, host, port, weight);
    this.services.set(name, service);

    console.log(`✅ Service registered: ${name} (${host}:${port}, weight=${weight})`);
    return true;
  }

  deregisterService(name) {
    if (this.services.delete(name)) {
      console.log(`✅ Service deregistered: ${name}`);
      return true;
    }
    return false;
  }

  // Weighted round-robin selection
  selectService(serviceName) {
    const instance = this.services.get(serviceName);
    if (!instance) {
      return { success: false, error: `Service '${serviceName}' not found` };
    }

    // Get all callable instances of this service
    const callableInstances = [instance].filter(s => s.isCallable());

    if (callableInstances.length === 0) {
      return {
        success: false,
        error: `No callable instances of '${serviceName}' available`,
        breakerState: instance.breaker.state
      };
    }

    // Select by weight score
    const selectedService = this.weightedSelect(callableInstances);
    return { success: true, service: selectedService };
  }

  weightedSelect(services) {
    if (services.length === 1) return services[0];

    // Weighted selection
    const totalScore = services.reduce((sum, s) => sum + s.getScore(), 0);
    let random = Math.random() * totalScore;

    for (const service of services) {
      random -= service.getScore();
      if (random <= 0) return service;
    }

    return services[0];
  }

  async callService(serviceName, options = {}) {
    const startTime = Date.now();

    // 1. Select service instance
    const selection = this.selectService(serviceName);
    if (!selection.success) {
      this.totalCalls++;
      this.logCall(serviceName, false, 0, selection.error);
      return selection;
    }

    const service = selection.service;

    try {
      // 2. Simulate service call (replace with actual HTTP/RPC call)
      const result = await this.simulateServiceCall(service, options);

      // 3. Record success
      const responseTime = Date.now() - startTime;
      service.recordCall(true, responseTime);
      this.totalCalls++;
      this.logCall(serviceName, true, responseTime);

      return {
        success: true,
        data: result,
        service: `${service.host}:${service.port}`,
        responseTime,
        breaker: service.breaker.getStatus()
      };
    } catch (error) {
      // Record failure
      const responseTime = Date.now() - startTime;
      service.recordCall(false, responseTime);
      this.totalCalls++;
      this.logCall(serviceName, false, responseTime, error.message);

      return {
        success: false,
        error: error.message,
        service: `${service.host}:${service.port}`,
        responseTime,
        breaker: service.breaker.getStatus()
      };
    }
  }

  async simulateServiceCall(service, options = {}) {
    // Simulate varying response times and occasional failures
    const delay = Math.random() * 100;
    const failureRate = 0.1;  // 10% failure rate for testing

    return new Promise((resolve, reject) => {
      setTimeout(() => {
        if (Math.random() < failureRate) {
          reject(new Error(`Service call failed (simulated)`));
        } else {
          resolve({
            service: service.name,
            timestamp: new Date().toISOString(),
            data: options.data || {},
            delay
          });
        }
      }, delay);
    });
  }

  healthCheck(serviceName) {
    const service = this.services.get(serviceName);
    if (!service) {
      return { success: false, error: `Service '${serviceName}' not found` };
    }

    return {
      success: true,
      service: serviceName,
      host: service.host,
      port: service.port,
      healthy: service.isHealthy(),
      breaker: {
        state: service.breaker.state,
        failureCount: service.breaker.failureCount,
        successRate: service.breaker.getStatus().successRate
      },
      metrics: {
        requestCount: service.requestCount,
        averageResponseTime: service.averageResponseTime.toFixed(2) + 'ms'
      }
    };
  }

  healthCheckAll() {
    const results = [];
    for (const [name] of this.services) {
      results.push(this.healthCheck(name));
    }
    return results;
  }

  logCall(serviceName, success, responseTime, error = null) {
    this.callHistory.push({
      timestamp: new Date().toISOString(),
      service: serviceName,
      success,
      responseTime,
      error
    });

    // Keep last 1000 calls
    if (this.callHistory.length > 1000) {
      this.callHistory.shift();
    }
  }

  getMetrics() {
    const successfulCalls = this.callHistory.filter(c => c.success).length;
    const failedCalls = this.callHistory.filter(c => !c.success).length;
    const avgResponseTime = this.callHistory.length > 0
      ? (this.callHistory.reduce((sum, c) => sum + c.responseTime, 0) / this.callHistory.length).toFixed(2)
      : 0;

    const serviceMetrics = {};
    for (const [name, service] of this.services) {
      serviceMetrics[name] = {
        healthy: service.isHealthy(),
        state: service.breaker.state,
        weight: service.weight,
        requestCount: service.requestCount,
        averageResponseTime: service.averageResponseTime.toFixed(2)
      };
    }

    return {
      totalCalls: this.totalCalls,
      successfulCalls,
      failedCalls,
      successRate: this.totalCalls > 0
        ? ((successfulCalls / this.totalCalls) * 100).toFixed(2) + '%'
        : '100%',
      averageResponseTime: avgResponseTime + 'ms',
      serviceCount: this.services.size,
      healthyServices: Array.from(this.services.values()).filter(s => s.isHealthy()).length,
      services: serviceMetrics
    };
  }

  // Retries with exponential backoff
  async callServiceWithRetry(serviceName, options = {}, maxRetries = 3) {
    let lastError;

    for (let attempt = 0; attempt < maxRetries; attempt++) {
      const result = await this.callService(serviceName, options);

      if (result.success) {
        result.attempts = attempt + 1;
        return result;
      }

      lastError = result;

      if (attempt < maxRetries - 1) {
        // Exponential backoff: 100ms, 200ms, 400ms
        const backoffMs = Math.pow(2, attempt) * 100;
        await new Promise(resolve => setTimeout(resolve, backoffMs));
      }
    }

    lastError.attempts = maxRetries;
    return lastError;
  }

  reset() {
    this.services.forEach(service => service.breaker.reset());
    this.callHistory = [];
    this.totalCalls = 0;
    console.log('✅ Service registry reset');
  }
}

// ──────────────────────────────────────────────────────────────────────────
// Helper Functions
// ──────────────────────────────────────────────────────────────────────────

async function createRegistryWithServices() {
  const registry = new ServiceRegistry();

  // Register services with different weights
  registry.registerService('api-gateway', '127.0.0.1', 8000, 2);      // High weight
  registry.registerService('auth-service', '127.0.0.1', 8001, 1);
  registry.registerService('data-service', '127.0.0.1', 8002, 1.5);

  return registry;
}

// Export
module.exports = {
  CircuitBreaker,
  Service,
  ServiceRegistry,
  STATE,
  createRegistryWithServices
};
