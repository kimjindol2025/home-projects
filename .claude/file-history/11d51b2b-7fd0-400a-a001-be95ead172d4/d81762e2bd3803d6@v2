/**
 * FreeLang Light Bundler
 * CSS/JS/HTML 병합 및 최적화
 */

const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

class Bundler {
  constructor(options = {}) {
    this.options = {
      minify: options.minify !== false,
      sourcemap: options.sourcemap === true,
      bundleName: options.bundleName || 'app',
      outputDir: options.outputDir || '.',
      ...options
    };

    this.assets = {
      css: [],
      js: [],
      html: []
    };

    this.manifest = {
      version: '1.0',
      components: [],
      bundled_at: new Date().toISOString(),
      checksums: {}
    };
  }

  /**
   * 여러 컴포넌트 번들링
   */
  bundleComponents(componentFiles) {
    console.log(`\n📦 Bundling ${componentFiles.length} components...\n`);

    componentFiles.forEach(file => {
      this.bundleComponent(file);
    });

    return this.generate();
  }

  /**
   * 단일 컴포넌트 번들링
   */
  bundleComponent(filePath) {
    if (!fs.existsSync(filePath)) {
      console.warn(`⚠️  File not found: ${filePath}`);
      return;
    }

    const name = path.basename(filePath, '.free');

    // CSS 로드
    const cssFile = path.join(path.dirname(filePath), `${name}.css`);
    if (fs.existsSync(cssFile)) {
      const css = fs.readFileSync(cssFile, 'utf-8');
      this.assets.css.push({ name, content: css, file: cssFile });
      console.log(`   ✅ CSS: ${name}.css`);
    }

    // JavaScript 로드
    const jsFile = path.join(path.dirname(filePath), `${name}.js`);
    if (fs.existsSync(jsFile)) {
      const js = fs.readFileSync(jsFile, 'utf-8');
      this.assets.js.push({ name, content: js, file: jsFile });
      console.log(`   ✅ JS: ${name}.js`);
    }

    // HTML 로드
    const htmlFile = path.join(path.dirname(filePath), `${name}.html`);
    if (fs.existsSync(htmlFile)) {
      const html = fs.readFileSync(htmlFile, 'utf-8');
      this.assets.html.push({ name, content: html, file: htmlFile });
      console.log(`   ✅ HTML: ${name}.html`);
    }

    this.manifest.components.push(name);
  }

  /**
   * 번들 생성
   */
  generate() {
    console.log(`\n🔗 Generating bundles...\n`);

    const bundleDir = this.options.outputDir;
    if (!fs.existsSync(bundleDir)) {
      fs.mkdirSync(bundleDir, { recursive: true });
    }

    // CSS 번들
    const cssBundle = this.generateCSSBundle();
    const cssPath = path.join(bundleDir, `${this.options.bundleName}.css`);
    fs.writeFileSync(cssPath, cssBundle);
    this.manifest.checksums.css = this.calculateHash(cssBundle);
    console.log(`   ✅ Generated: ${this.options.bundleName}.css (${cssBundle.length} bytes)`);

    // JavaScript 번들
    const jsBundle = this.generateJSBundle();
    const jsPath = path.join(bundleDir, `${this.options.bundleName}.js`);
    fs.writeFileSync(jsPath, jsBundle);
    this.manifest.checksums.js = this.calculateHash(jsBundle);
    console.log(`   ✅ Generated: ${this.options.bundleName}.js (${jsBundle.length} bytes)`);

    // HTML 번들
    const htmlBundle = this.generateHTMLBundle();
    const htmlPath = path.join(bundleDir, `${this.options.bundleName}.html`);
    fs.writeFileSync(htmlPath, htmlBundle);
    this.manifest.checksums.html = this.calculateHash(htmlBundle);
    console.log(`   ✅ Generated: ${this.options.bundleName}.html (${htmlBundle.length} bytes)`);

    // Manifest 저장
    const manifestPath = path.join(bundleDir, `${this.options.bundleName}.manifest.json`);
    fs.writeFileSync(manifestPath, JSON.stringify(this.manifest, null, 2));
    console.log(`   ✅ Generated: ${this.options.bundleName}.manifest.json`);

    // 소스맵 생성
    if (this.options.sourcemap) {
      this.generateSourceMaps(bundleDir);
    }

    console.log(`\n✨ Bundling complete!\n`);

    return {
      css: cssPath,
      js: jsPath,
      html: htmlPath,
      manifest: manifestPath,
      stats: this.getStats()
    };
  }

  /**
   * CSS 번들 생성
   */
  generateCSSBundle() {
    let css = '/* FreeLang Light - Bundled CSS */\n';
    css += `/* Generated: ${new Date().toISOString()} */\n`;
    css += `/* Components: ${this.manifest.components.join(', ')} */\n\n`;

    // 각 컴포넌트의 CSS 합치기
    this.assets.css.forEach(asset => {
      css += `/* Component: ${asset.name} */\n`;
      css += asset.content + '\n\n';
    });

    // 최소화
    if (this.options.minify) {
      css = this.minifyCSS(css);
    }

    return css;
  }

  /**
   * JavaScript 번들 생성
   */
  generateJSBundle() {
    let js = '// FreeLang Light - Bundled JavaScript\n';
    js += `// Generated: ${new Date().toISOString()}\n`;
    js += `// Components: ${this.manifest.components.join(', ')}\n\n`;

    js += '(function() {\n';
    js += '  "use strict";\n\n';

    // 각 컴포넌트의 JS 함수 합치기
    this.assets.js.forEach(asset => {
      js += `  // Component: ${asset.name}\n`;
      js += this.indentCode(asset.content, 2) + '\n\n';
    });

    js += '})();\n';

    // 최소화
    if (this.options.minify) {
      js = this.minifyJS(js);
    }

    return js;
  }

  /**
   * HTML 번들 생성
   */
  generateHTMLBundle() {
    let html = '<!DOCTYPE html>\n';
    html += '<html lang="ko">\n';
    html += '<head>\n';
    html += '  <meta charset="UTF-8">\n';
    html += '  <meta name="viewport" content="width=device-width, initial-scale=1.0">\n';
    html += `  <title>FreeLang Light - ${this.options.bundleName}</title>\n`;
    html += `  <link rel="stylesheet" href="${this.options.bundleName}.css">\n`;
    html += '</head>\n';
    html += '<body>\n\n';

    // 컴포넌트 마크업 합치기
    this.assets.html.forEach(asset => {
      html += `  <!-- Component: ${asset.name} -->\n`;
      html += this.indentCode(asset.content, 2) + '\n\n';
    });

    html += `  <script src="${this.options.bundleName}.js"><\/script>\n`;
    html += '</body>\n';
    html += '</html>\n';

    return html;
  }

  /**
   * CSS 최소화
   */
  minifyCSS(css) {
    return css
      // 주석 제거
      .replace(/\/\*[\s\S]*?\*\//g, '')
      // 불필요한 공백 제거
      .replace(/\s+/g, ' ')
      .replace(/\s*[{}:;,]\s*/g, match => match.trim())
      // 빈 줄 제거
      .replace(/^\s*\n/gm, '')
      .trim();
  }

  /**
   * JavaScript 최소화
   */
  minifyJS(js) {
    return js
      // 단일 줄 주석 제거
      .replace(/\/\/.*$/gm, '')
      // 다중 줄 주석 제거
      .replace(/\/\*[\s\S]*?\*\//g, '')
      // 불필요한 공백 제거
      .replace(/\s+/g, ' ')
      // 줄바꿈 정리
      .replace(/;\s*/g, ';')
      .replace(/\s*[{}()[\],]\s*/g, match => match.trim())
      .trim();
  }

  /**
   * 소스맵 생성
   */
  generateSourceMaps(bundleDir) {
    const cssMap = {
      version: 3,
      sources: this.assets.css.map(a => a.file),
      sourcesContent: this.assets.css.map(a => a.content),
      mappings: ''
    };

    const jsMap = {
      version: 3,
      sources: this.assets.js.map(a => a.file),
      sourcesContent: this.assets.js.map(a => a.content),
      mappings: ''
    };

    fs.writeFileSync(
      path.join(bundleDir, `${this.options.bundleName}.css.map`),
      JSON.stringify(cssMap)
    );

    fs.writeFileSync(
      path.join(bundleDir, `${this.options.bundleName}.js.map`),
      JSON.stringify(jsMap)
    );

    console.log(`   ✅ Source maps generated`);
  }

  /**
   * 해시값 계산 (무결성 검증)
   */
  calculateHash(content) {
    return crypto.createHash('sha256').update(content).digest('hex').slice(0, 8);
  }

  /**
   * 코드 들여쓰기
   */
  indentCode(code, spaces) {
    const indent = ' '.repeat(spaces);
    return code.split('\n')
      .map(line => line ? indent + line : line)
      .join('\n');
  }

  /**
   * 번들 통계
   */
  getStats() {
    const cssSize = this.assets.css.reduce((sum, a) => sum + a.content.length, 0);
    const jsSize = this.assets.js.reduce((sum, a) => sum + a.content.length, 0);
    const htmlSize = this.assets.html.reduce((sum, a) => sum + a.content.length, 0);

    return {
      components: this.manifest.components.length,
      css_files: this.assets.css.length,
      js_files: this.assets.js.length,
      html_files: this.assets.html.length,
      total_size_uncompressed: cssSize + jsSize + htmlSize,
      css_size: cssSize,
      js_size: jsSize,
      html_size: htmlSize
    };
  }
}

module.exports = { Bundler };
