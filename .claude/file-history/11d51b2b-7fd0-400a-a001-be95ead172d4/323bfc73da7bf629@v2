// ============================================================================
// Phase 2: Database with Transaction Support (Pure Node.js)
// ============================================================================

const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

const DB_PATH = path.join(__dirname, '../../db/blogs-transactions.json');
const LOCK_DIR = path.join(__dirname, '../../db/locks');
const TRANSACTION_LOG_PATH = path.join(__dirname, '../../db/transaction-log.json');

// Ensure directories exist
function ensureDirs() {
  const dbDir = path.dirname(DB_PATH);
  if (!fs.existsSync(dbDir)) {
    fs.mkdirSync(dbDir, { recursive: true });
  }
  if (!fs.existsSync(LOCK_DIR)) {
    fs.mkdirSync(LOCK_DIR, { recursive: true });
  }
}

// ──────────────────────────────────────────────────────────────────────────
// Transaction Management
// ──────────────────────────────────────────────────────────────────────────

class TransactionManager {
  constructor() {
    this.activeTransactions = new Map();
    this.transactionLog = [];
    this.locks = new Map();
    ensureDirs();
  }

  beginTransaction(txId = null) {
    const id = txId || generateId();
    this.activeTransactions.set(id, {
      id,
      status: 'ACTIVE',
      startTime: Date.now(),
      operations: [],
      snapshot: this.getCurrentSnapshot()
    });

    this.logTransaction(id, null, 'BEGIN', 'started');
    console.log(`✅ Transaction started: ${id}`);

    return {
      success: true,
      transactionId: id,
      timestamp: new Date().toISOString()
    };
  }

  recordOperation(txId, operation, data) {
    const tx = this.activeTransactions.get(txId);
    if (!tx) {
      return { success: false, error: 'Transaction not found' };
    }

    tx.operations.push({
      type: operation,
      data,
      timestamp: Date.now()
    });

    return { success: true };
  }

  commitTransaction(txId) {
    const tx = this.activeTransactions.get(txId);
    if (!tx) {
      return { success: false, error: 'Transaction not found' };
    }

    try {
      // Write all operations to file atomically
      const data = this.loadDatabase();

      for (const op of tx.operations) {
        this.applyOperation(data, op);
      }

      // Atomic write
      fs.writeFileSync(DB_PATH, JSON.stringify(data, null, 2));

      this.activeTransactions.delete(txId);
      this.logTransaction(txId, null, 'COMMIT', 'completed');

      console.log(`✅ Transaction committed: ${txId}`);
      return { success: true };
    } catch (err) {
      console.error('❌ Commit failed:', err.message);
      return { success: false, error: err.message };
    }
  }

  rollbackTransaction(txId) {
    const tx = this.activeTransactions.get(txId);
    if (!tx) {
      return { success: false, error: 'Transaction not found' };
    }

    this.activeTransactions.delete(txId);
    this.logTransaction(txId, null, 'ROLLBACK', 'rolled_back');

    console.log(`⚠️ Transaction rolled back: ${txId}`);
    return { success: true };
  }

  applyOperation(data, op) {
    switch (op.type) {
      case 'INSERT':
        data.push(op.data);
        break;
      case 'UPDATE':
        const updateIdx = data.findIndex(b => b.id === op.data.id);
        if (updateIdx >= 0) {
          data[updateIdx] = { ...data[updateIdx], ...op.data };
          data[updateIdx].version = (data[updateIdx].version || 0) + 1;
        }
        break;
      case 'DELETE':
        const deleteIdx = data.findIndex(b => b.id === op.data.id);
        if (deleteIdx >= 0) {
          data.splice(deleteIdx, 1);
        }
        break;
    }
  }

  getCurrentSnapshot() {
    try {
      return JSON.parse(fs.readFileSync(DB_PATH, 'utf8'));
    } catch {
      return [];
    }
  }

  loadDatabase() {
    ensureDirs();
    try {
      if (fs.existsSync(DB_PATH)) {
        return JSON.parse(fs.readFileSync(DB_PATH, 'utf8'));
      }
    } catch (err) {
      console.warn('⚠️ Database load warning:', err.message);
    }
    return [];
  }

  logTransaction(txId, blogId, operation, status) {
    this.transactionLog.push({
      id: txId,
      blogId,
      operation,
      status,
      timestamp: new Date().toISOString()
    });

    // Keep last 1000 logs
    if (this.transactionLog.length > 1000) {
      this.transactionLog.shift();
    }

    // Persist transaction log
    try {
      fs.writeFileSync(TRANSACTION_LOG_PATH, JSON.stringify(this.transactionLog, null, 2));
    } catch (err) {
      console.warn('⚠️ Transaction log write failed:', err.message);
    }
  }

  getTransactionLog(limit = 100) {
    return {
      success: true,
      data: this.transactionLog.slice(-limit)
    };
  }

  // Optimistic locking
  acquireLock(blogId, txId) {
    if (this.locks.has(blogId)) {
      const lock = this.locks.get(blogId);
      if (Date.now() - lock.acquiredAt > 30000) {
        // Lock expired
        this.locks.delete(blogId);
      } else {
        return {
          success: false,
          error: `Resource locked by ${lock.txId}`
        };
      }
    }

    this.locks.set(blogId, {
      txId,
      acquiredAt: Date.now()
    });

    return { success: true };
  }

  releaseLock(blogId) {
    this.locks.delete(blogId);
  }
}

// ──────────────────────────────────────────────────────────────────────────
// Database Operations
// ──────────────────────────────────────────────────────────────────────────

const txManager = new TransactionManager();

function connectDatabase() {
  ensureDirs();
  return {
    insertBlog,
    getBlog,
    getAllBlogs,
    updateBlog,
    deleteBlog,
    searchBlogs,
    beginTransaction,
    commitTransaction,
    rollbackTransaction,
    getTransactionLog
  };
}

function beginTransaction(txId = null) {
  return txManager.beginTransaction(txId);
}

function commitTransaction(txId) {
  return txManager.commitTransaction(txId);
}

function rollbackTransaction(txId) {
  return txManager.rollbackTransaction(txId);
}

function insertBlog(blog, txId = null) {
  const blogId = blog.id || generateId();
  const now = new Date().toISOString();

  const record = {
    id: blogId,
    title: blog.title || 'Untitled',
    content: blog.content || '',
    author: blog.author || 'Unknown',
    createdAt: blog.createdAt || now,
    updatedAt: blog.updatedAt || now,
    views: blog.views || 0,
    version: 1,
    deleted: false,
    createdBy: blog.createdBy || blog.author,
    lastModifiedBy: blog.lastModifiedBy || blog.author,
    status: blog.status || 'draft'
  };

  if (txId) {
    // Record operation in transaction
    const result = txManager.recordOperation(txId, 'INSERT', record);
    if (!result.success) return result;

    txManager.logTransaction(txId, blogId, 'INSERT', 'recorded');
    console.log(`✅ Blog INSERT recorded in transaction: ${blogId}`);
  } else {
    // Immediate write
    try {
      const data = txManager.loadDatabase();
      data.push(record);
      fs.writeFileSync(DB_PATH, JSON.stringify(data, null, 2));

      txManager.logTransaction(null, blogId, 'INSERT', 'completed');
      console.log(`✅ Blog inserted: ${blogId}`);
    } catch (err) {
      console.error('❌ Insert failed:', err.message);
      return { success: false, error: err.message };
    }
  }

  return { success: true, id: blogId };
}

function getBlog(blogId, txId = null) {
  try {
    const data = txManager.loadDatabase();
    const blog = data.find(b => b.id === blogId && !b.deleted);

    if (blog) {
      // Increment views
      blog.views = (blog.views || 0) + 1;
      if (!txId) {
        fs.writeFileSync(DB_PATH, JSON.stringify(data, null, 2));
      }

      txManager.logTransaction(txId, blogId, 'SELECT', 'completed');
      return { success: true, data: blog };
    }

    return { success: false, error: 'Blog not found' };
  } catch (err) {
    console.error('❌ Get blog failed:', err.message);
    return { success: false, error: err.message };
  }
}

function getAllBlogs(limit = 100, offset = 0) {
  try {
    const data = txManager.loadDatabase();
    const blogs = data
      .filter(b => !b.deleted)
      .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt))
      .slice(offset, offset + limit);

    txManager.logTransaction(null, null, 'SELECT_ALL', 'completed');
    return {
      success: true,
      data: blogs,
      total: data.filter(b => !b.deleted).length
    };
  } catch (err) {
    console.error('❌ Get all blogs failed:', err.message);
    return { success: false, error: err.message };
  }
}

function updateBlog(blogId, updates, txId = null) {
  try {
    const data = txManager.loadDatabase();
    const blog = data.find(b => b.id === blogId && !b.deleted);

    if (!blog) {
      return { success: false, error: 'Blog not found' };
    }

    // Version conflict detection (optimistic locking)
    // Check if version is provided and if it's different from current
    if (updates.version !== undefined && updates.version !== null) {
      if (updates.version !== (blog.version || 1)) {
        return {
          success: false,
          error: 'Version conflict - concurrent modification detected'
        };
      }
    }

    const oldVersion = blog.version || 1;
    const newBlog = {
      ...blog,
      title: updates.title || blog.title,
      content: updates.content || blog.content,
      author: updates.author || blog.author,
      updatedAt: new Date().toISOString(),
      version: oldVersion + 1,
      lastModifiedBy: updates.lastModifiedBy || blog.author,
      status: updates.status || blog.status
    };

    if (txId) {
      txManager.recordOperation(txId, 'UPDATE', newBlog);
      txManager.logTransaction(txId, blogId, 'UPDATE', 'recorded');
      console.log(`✅ Blog UPDATE recorded in transaction: ${blogId}`);
    } else {
      const idx = data.findIndex(b => b.id === blogId);
      if (idx >= 0) {
        data[idx] = newBlog;
        fs.writeFileSync(DB_PATH, JSON.stringify(data, null, 2));
      }
      txManager.logTransaction(null, blogId, 'UPDATE', 'completed');
      console.log(`✅ Blog updated: ${blogId} (v${oldVersion} → v${newBlog.version})`);
    }

    return { success: true, version: newBlog.version };
  } catch (err) {
    console.error('❌ Update failed:', err.message);
    return { success: false, error: err.message };
  }
}

function deleteBlog(blogId, txId = null, hardDelete = false) {
  try {
    const data = txManager.loadDatabase();
    const idx = data.findIndex(b => b.id === blogId);

    if (idx < 0) {
      return { success: false, error: 'Blog not found' };
    }

    if (hardDelete) {
      if (txId) {
        txManager.recordOperation(txId, 'DELETE', { id: blogId });
        txManager.logTransaction(txId, blogId, 'DELETE', 'recorded');
      } else {
        data.splice(idx, 1);
        fs.writeFileSync(DB_PATH, JSON.stringify(data, null, 2));
        txManager.logTransaction(null, blogId, 'DELETE', 'completed');
      }
      console.log(`✅ Blog hard-deleted: ${blogId}`);
    } else {
      data[idx].deleted = true;
      data[idx].updatedAt = new Date().toISOString();

      if (!txId) {
        fs.writeFileSync(DB_PATH, JSON.stringify(data, null, 2));
      }
      txManager.logTransaction(txId, blogId, 'SOFT_DELETE', 'completed');
      console.log(`✅ Blog soft-deleted: ${blogId}`);
    }

    return { success: true };
  } catch (err) {
    console.error('❌ Delete failed:', err.message);
    return { success: false, error: err.message };
  }
}

function searchBlogs(query, filters = {}) {
  try {
    let data = txManager.loadDatabase();

    if (query) {
      const q = query.toLowerCase();
      data = data.filter(b =>
        !b.deleted && (
          b.title.toLowerCase().includes(q) ||
          b.content.toLowerCase().includes(q) ||
          b.author.toLowerCase().includes(q)
        )
      );
    } else {
      data = data.filter(b => !b.deleted);
    }

    if (filters.author) {
      data = data.filter(b => b.author === filters.author);
    }

    if (filters.status) {
      data = data.filter(b => b.status === filters.status);
    }

    if (filters.minViews !== undefined) {
      data = data.filter(b => (b.views || 0) >= filters.minViews);
    }

    txManager.logTransaction(null, null, 'SEARCH', 'completed');
    return {
      success: true,
      data: data.slice(0, 100),
      count: data.length
    };
  } catch (err) {
    console.error('❌ Search failed:', err.message);
    return { success: false, error: err.message };
  }
}

function getTransactionLog(limit = 100) {
  return txManager.getTransactionLog(limit);
}

// ──────────────────────────────────────────────────────────────────────────
// Batch Operations
// ──────────────────────────────────────────────────────────────────────────

function batchInsert(blogs) {
  const tx = beginTransaction();
  if (!tx.success) return tx;

  try {
    for (const blog of blogs) {
      const result = insertBlog(blog, tx.transactionId);
      if (!result.success) {
        rollbackTransaction(tx.transactionId);
        return result;
      }
    }

    commitTransaction(tx.transactionId);
    console.log(`✅ Batch inserted ${blogs.length} blogs`);
    return { success: true, count: blogs.length };
  } catch (err) {
    rollbackTransaction(tx.transactionId);
    console.error('❌ Batch insert failed:', err.message);
    return { success: false, error: err.message };
  }
}

// ──────────────────────────────────────────────────────────────────────────
// Utility Functions
// ──────────────────────────────────────────────────────────────────────────

function generateId() {
  return crypto.randomBytes(8).toString('hex');
}

function close() {
  console.log('✅ Database closed');
}

// Export
module.exports = {
  connectDatabase,
  close,
  batchInsert,
  _path: DB_PATH,
  _txManager: txManager
};
