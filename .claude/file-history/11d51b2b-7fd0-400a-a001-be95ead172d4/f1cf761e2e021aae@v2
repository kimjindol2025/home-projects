/**
 * FreeLang Light Parser
 * .free 파일을 파싱하여 AST (Abstract Syntax Tree) 생성
 */

class Token {
  constructor(type, value, line, col) {
    this.type = type;
    this.value = value;
    this.line = line;
    this.col = col;
  }
}

class Tokenizer {
  constructor(source) {
    this.source = source;
    this.pos = 0;
    this.line = 1;
    this.col = 1;
    this.tokens = [];
  }

  isWhitespace(ch) {
    return /\s/.test(ch);
  }

  isIdentifierStart(ch) {
    return /[a-zA-Z_]/.test(ch);
  }

  isIdentifierChar(ch) {
    return /[a-zA-Z0-9_]/.test(ch);
  }

  isDigit(ch) {
    return /\d/.test(ch);
  }

  peek(offset = 0) {
    return this.source[this.pos + offset] || null;
  }

  advance() {
    const ch = this.source[this.pos];
    if (ch === '\n') {
      this.line++;
      this.col = 1;
    } else {
      this.col++;
    }
    this.pos++;
    return ch;
  }

  skipWhitespace() {
    while (this.isWhitespace(this.peek())) {
      this.advance();
    }
  }

  skipLineComment() {
    // //로 시작하는 댓글
    if (this.peek() === '/' && this.peek(1) === '/') {
      while (this.peek() !== '\n' && this.peek() !== null) {
        this.advance();
      }
      return true;
    }
    return false;
  }

  skipBlockComment() {
    // /* ... */로 시작하는 댓글
    if (this.peek() === '/' && this.peek(1) === '*') {
      this.advance(); // /
      this.advance(); // *
      while (!(this.peek() === '*' && this.peek(1) === '/') && this.peek() !== null) {
        this.advance();
      }
      if (this.peek() === '*') {
        this.advance(); // *
        this.advance(); // /
      }
      return true;
    }
    return false;
  }

  readString(quote) {
    let value = '';
    this.advance(); // 시작 따옴표
    while (this.peek() !== quote && this.peek() !== null) {
      if (this.peek() === '\\') {
        this.advance();
        const next = this.peek();
        if (next === 'n') value += '\n';
        else if (next === 't') value += '\t';
        else if (next === '"') value += '"';
        else if (next === "'") value += "'";
        else value += next;
        this.advance();
      } else {
        value += this.advance();
      }
    }
    if (this.peek() === quote) {
      this.advance(); // 종료 따옴표
    }
    return value;
  }

  readIdentifier() {
    let value = '';
    while (this.isIdentifierChar(this.peek())) {
      value += this.advance();
    }
    return value;
  }

  readNumber() {
    let value = '';
    while (this.isDigit(this.peek())) {
      value += this.advance();
    }
    if (this.peek() === '.' && this.isDigit(this.peek(1))) {
      value += this.advance(); // .
      while (this.isDigit(this.peek())) {
        value += this.advance();
      }
    }
    return value;
  }

  tokenize() {
    while (this.pos < this.source.length) {
      this.skipWhitespace();

      if (this.skipLineComment() || this.skipBlockComment()) {
        continue;
      }

      if (this.pos >= this.source.length) break;

      const line = this.line;
      const col = this.col;
      const ch = this.peek();

      // 문자열
      if (ch === '"' || ch === "'") {
        const value = this.readString(ch);
        this.tokens.push(new Token('STRING', value, line, col));
        continue;
      }

      // 숫자
      if (this.isDigit(ch)) {
        const value = this.readNumber();
        this.tokens.push(new Token('NUMBER', value, line, col));
        continue;
      }

      // 식별자 또는 예약어
      if (this.isIdentifierStart(ch)) {
        const value = this.readIdentifier();
        const keywords = ['component', 'props', 'style', 'script', 'markup', 'fn', 'if', 'else', 'for', 'while', 'return', 'true', 'false', 'null'];
        const type = keywords.includes(value) ? value.toUpperCase() : 'IDENTIFIER';
        this.tokens.push(new Token(type, value, line, col));
        continue;
      }

      // 특수 문자
      if (ch === '{') {
        this.advance();
        this.tokens.push(new Token('LBRACE', '{', line, col));
        continue;
      }

      if (ch === '}') {
        this.advance();
        this.tokens.push(new Token('RBRACE', '}', line, col));
        continue;
      }

      if (ch === '(') {
        this.advance();
        this.tokens.push(new Token('LPAREN', '(', line, col));
        continue;
      }

      if (ch === ')') {
        this.advance();
        this.tokens.push(new Token('RPAREN', ')', line, col));
        continue;
      }

      if (ch === '[') {
        this.advance();
        this.tokens.push(new Token('LBRACKET', '[', line, col));
        continue;
      }

      if (ch === ']') {
        this.advance();
        this.tokens.push(new Token('RBRACKET', ']', line, col));
        continue;
      }

      if (ch === ':') {
        this.advance();
        this.tokens.push(new Token('COLON', ':', line, col));
        continue;
      }

      if (ch === ';') {
        this.advance();
        this.tokens.push(new Token('SEMICOLON', ';', line, col));
        continue;
      }

      if (ch === ',') {
        this.advance();
        this.tokens.push(new Token('COMMA', ',', line, col));
        continue;
      }

      if (ch === '=') {
        this.advance();
        this.tokens.push(new Token('ASSIGN', '=', line, col));
        continue;
      }

      if (ch === '<') {
        this.advance();
        this.tokens.push(new Token('LT', '<', line, col));
        continue;
      }

      if (ch === '>') {
        this.advance();
        this.tokens.push(new Token('GT', '>', line, col));
        continue;
      }

      if (ch === '.') {
        this.advance();
        this.tokens.push(new Token('DOT', '.', line, col));
        continue;
      }

      if (ch === '-' && this.isDigit(this.peek(1))) {
        this.advance(); // -
        const value = '-' + this.readNumber();
        this.tokens.push(new Token('NUMBER', value, line, col));
        continue;
      }

      // 일반 문자는 내용으로
      const value = this.advance();
      this.tokens.push(new Token('CHAR', value, line, col));
    }

    this.tokens.push(new Token('EOF', null, this.line, this.col));
    return this.tokens;
  }
}

class Parser {
  constructor(tokens) {
    this.tokens = tokens;
    this.pos = 0;
  }

  peek(offset = 0) {
    return this.tokens[this.pos + offset];
  }

  advance() {
    return this.tokens[this.pos++];
  }

  expect(type) {
    const token = this.peek();
    if (!token || token.type !== type) {
      throw new Error(`Expected ${type}, got ${token ? token.type : 'EOF'} at line ${token?.line}`);
    }
    return this.advance();
  }

  parseComponent() {
    this.expect('COMPONENT');
    const nameToken = this.expect('IDENTIFIER');
    const name = nameToken.value;

    this.expect('LBRACE');

    const blocks = {};
    while (this.peek() && this.peek().type !== 'RBRACE') {
      const blockType = this.peek().type;

      if (blockType === 'PROPS') {
        blocks.props = this.parsePropsBlock();
      } else if (blockType === 'STYLE') {
        blocks.style = this.parseStyleBlock();
      } else if (blockType === 'SCRIPT') {
        blocks.script = this.parseScriptBlock();
      } else if (blockType === 'MARKUP') {
        blocks.markup = this.parseMarkupBlock();
      } else {
        throw new Error(`Unexpected block type: ${blockType} at line ${this.peek().line}`);
      }
    }

    this.expect('RBRACE');

    return {
      type: 'component',
      name,
      props: blocks.props || { properties: [] },
      style: blocks.style || { content: '' },
      script: blocks.script || { functions: [] },
      markup: blocks.markup || { content: '' }
    };
  }

  parsePropsBlock() {
    this.expect('PROPS');
    this.expect('LBRACE');

    const properties = [];
    while (this.peek() && this.peek().type !== 'RBRACE') {
      if (this.peek().type === 'IDENTIFIER') {
        const nameToken = this.expect('IDENTIFIER');
        this.expect('COLON');
        const typeToken = this.expect('IDENTIFIER');

        // 제네릭 타입 처리 (예: array<string>)
        let type = typeToken.value;
        if (this.peek() && this.peek().type === 'LT') {
          this.advance(); // <
          const innerType = this.expect('IDENTIFIER');
          this.expect('GT');
          type = `${type}<${innerType.value}>`;
        }

        properties.push({
          name: nameToken.value,
          type: type
        });
      }

      if (this.peek() && this.peek().type === 'COMMA') {
        this.advance();
      }
    }

    this.expect('RBRACE');

    return {
      type: 'props',
      properties
    };
  }

  parseStyleBlock() {
    this.expect('STYLE');
    this.expect('LBRACE');

    let content = '';
    let braceCount = 1;

    while (braceCount > 0 && this.peek()) {
      const token = this.peek();

      if (token.type === 'LBRACE') {
        braceCount++;
        content += token.value;
      } else if (token.type === 'RBRACE') {
        braceCount--;
        if (braceCount > 0) {
          content += token.value;
        }
      } else if (token.type === 'STRING') {
        content += `"${token.value}"`;
      } else if (token.type === 'NUMBER') {
        content += token.value;
      } else {
        content += token.value;
      }

      this.advance();
    }

    return {
      type: 'style',
      content: content.trim()
    };
  }

  parseScriptBlock() {
    this.expect('SCRIPT');
    this.expect('LBRACE');

    const functions = [];
    let content = '';
    let braceCount = 1;

    while (braceCount > 0 && this.peek()) {
      const token = this.peek();

      if (token.type === 'FN') {
        // 함수 정의 파싱
        this.advance(); // fn
        const fnName = this.expect('IDENTIFIER').value;
        this.expect('LPAREN');

        const params = [];
        while (this.peek() && this.peek().type !== 'RPAREN') {
          const param = this.expect('IDENTIFIER').value;
          params.push(param);

          if (this.peek().type === 'COMMA') {
            this.advance();
          }
        }

        this.expect('RPAREN');
        this.expect('LBRACE');

        let fnBody = '';
        let fnBraceCount = 1;

        while (fnBraceCount > 0 && this.peek()) {
          const tk = this.peek();

          if (tk.type === 'LBRACE') {
            fnBraceCount++;
            fnBody += tk.value;
          } else if (tk.type === 'RBRACE') {
            fnBraceCount--;
            if (fnBraceCount > 0) {
              fnBody += tk.value;
            }
          } else if (tk.type === 'STRING') {
            fnBody += `"${tk.value}"`;
          } else if (tk.type === 'NUMBER') {
            fnBody += tk.value;
          } else {
            fnBody += tk.value;
          }

          this.advance();
        }

        functions.push({
          name: fnName,
          params,
          body: fnBody.trim()
        });

        braceCount--; // script 블록 닫음
      } else if (token.type === 'LBRACE') {
        braceCount++;
        content += token.value;
        this.advance();
      } else if (token.type === 'RBRACE') {
        braceCount--;
        if (braceCount > 0) {
          content += token.value;
        }
        this.advance();
      } else {
        content += token.value;
        this.advance();
      }
    }

    return {
      type: 'script',
      functions,
      rawContent: content.trim()
    };
  }

  parseMarkupBlock() {
    this.expect('MARKUP');
    this.expect('LBRACE');

    let content = '';
    let braceCount = 1;

    while (braceCount > 0 && this.peek()) {
      const token = this.peek();

      if (token.type === 'LBRACE') {
        braceCount++;
        content += token.value;
      } else if (token.type === 'RBRACE') {
        braceCount--;
        if (braceCount > 0) {
          content += token.value;
        }
      } else if (token.type === 'STRING') {
        content += `"${token.value}"`;
      } else if (token.type === 'NUMBER') {
        content += token.value;
      } else {
        content += token.value;
      }

      this.advance();
    }

    return {
      type: 'markup',
      content: content.trim()
    };
  }
}

function parseFreeLang(source) {
  const tokenizer = new Tokenizer(source);
  const tokens = tokenizer.tokenize();

  const parser = new Parser(tokens);
  const ast = parser.parseComponent();

  return ast;
}

module.exports = { parseFreeLang, Tokenizer, Parser };
