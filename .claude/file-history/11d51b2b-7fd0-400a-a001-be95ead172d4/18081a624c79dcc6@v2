component Card {
  props {
    title: string
    content: string
    footer: string
  }

  style {
    .card {
      background: white
      borderRadius: 8px
      boxShadow: 0 2px 8px rgba(0,0,0,0.1)
      overflow: hidden
      transition: boxShadow 0.3s ease
    }

    .card:hover {
      boxShadow: 0 4px 16px rgba(0,0,0,0.15)
    }

    .card-header {
      padding: 20px
      borderBottom: 1px solid #e0e0e0
      backgroundColor: #f8f9fa
    }

    .card-title {
      margin: 0
      fontSize: 18px
      fontWeight: bold
      color: #333
    }

    .card-body {
      padding: 20px
      color: #666
      lineHeight: 1.6
    }

    .card-footer {
      padding: 15px 20px
      borderTop: 1px solid #e0e0e0
      backgroundColor: #f8f9fa
      fontSize: 12px
      color: #999
    }
  }

  script {
    fn on_hover(element) {
      console.log("Card hovered")
    }

    fn on_leave(element) {
      console.log("Card left")
    }

    fn click_card(element) {
      console.log("Card clicked:", element.querySelector(".card-title").textContent)
    }
  }

  markup {
    <div class="card" onmouseover="on_hover(this)" onmouseout="on_leave(this)" onclick="click_card(this)">
      <div class="card-header">
        <h3 class="card-title">{title}</h3>
      </div>
      <div class="card-body">
        <p>{content}</p>
      </div>
      {footer ? '<div class="card-footer">' + footer + '</div>' : ''}
    </div>
  }
}
