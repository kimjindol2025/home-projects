/**
 * CSS Compiler for FreeLang Light
 * style 블록을 CSS로 컴파일
 */

class CSSCompiler {
  compile(ast) {
    let css = '';

    // 주석
    css += '/* FreeLang Light - Auto-generated CSS */\n';
    css += `/* Component: ${ast.name} */\n`;
    css += `/* Generated: ${new Date().toISOString()} */\n\n`;

    // style 블록 내용 변환
    let content = ast.style.content;

    // camelCase를 kebab-case로 변환
    content = this.camelToKebab(content);

    // 속성값 정리
    content = this.formatProperties(content);

    css += content;

    return css;
  }

  /**
   * camelCase를 kebab-case로 변환
   */
  camelToKebab(content) {
    // backgroundColor → background-color
    return content.replace(/([a-z])([A-Z])/g, '$1-$2').toLowerCase();
  }

  /**
   * CSS 속성 포맷팅
   */
  formatProperties(content) {
    let result = '';
    let inSelector = false;
    let currentRule = '';

    const lines = content.split('\n');

    for (let line of lines) {
      line = line.trim();

      if (!line || line.startsWith('/*')) continue;

      // 선택자 감지 (.class, #id, :hover 등)
      if (line.match(/^[\w.#:-]+/) && line.includes('{')) {
        inSelector = true;
        currentRule = line.replace(/\{/g, '') + ' {';
        result += currentRule + '\n';
      } else if (inSelector && line === '}') {
        result += '}\n\n';
        inSelector = false;
        currentRule = '';
      } else if (inSelector && line) {
        // 속성 라인: key: value 형식
        if (line.includes(':') && !line.startsWith(':')) {
          const [key, ...valueParts] = line.split(':');
          let value = valueParts.join(':').trim();

          // 끝에 ;가 없으면 추가
          if (!value.endsWith(';')) {
            value += ';';
          }

          result += `  ${key.trim()}: ${value}\n`;
        }
      }
    }

    return result;
  }
}

module.exports = { CSSCompiler };
