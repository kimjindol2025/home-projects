## 핵심 개념

### 1. FreeLang State (상태 관리)

```freelang
global AppState {
  count: number = 0
  todos: array<Todo> = []
}

func increment() {
  AppState.count += 1
}

func addTodo(text: string) {
  AppState.todos.push({ id, text, done: false })
}
```

### 2. Bridge (React ↔ FreeLang)

```javascript
// React에서 FreeLang 상태 사용
import { useFreeLang } from '@/bridge/hooks'

export function Counter() {
  const { count, increment } = useFreeLang('counter')

  return (
    <button onClick={increment}>
      Count: {count}
    </button>
  )
}
```

### 3. API (Backend)

```freelang
// Backend: REST API
func GET /api/todos() -> array<Todo> {
  return AppState.todos
}

func POST /api/todos(text: string) -> Todo {
  let todo = { id: generateId(), text, done: false }
  AppState.todos.push(todo)
  return todo
}
```

