# FreeLang Hybrid - Native Binary Build
# ================================================
# 빌드 옵션:
#   make build          - 네이티브 바이너리 컴파일 (Linux/macOS)
#   make compile        - FreeLang → JavaScript 컴파일
#   make run            - 백엔드 + 웹 서버 실행
#   make test           - 통합 테스트 실행
#   make clean          - 빌드 결과 삭제
#   make docker-build   - Docker 이미지 빌드
#   make docker-run     - Docker 컨테이너 실행
#   make docker-stop    - Docker 컨테이너 중지

.PHONY: build compile run test clean docker-build docker-run docker-stop help

# 변수
FREELANG_HOME ?= $(shell which freelang-compiler 2>/dev/null || echo "freelang-compiler")
BACKEND_SRC = freelang/backend/api.free
FRONTEND_SRC = freelang/frontend/state.free
SHARED_SRC = freelang/shared/types.free
BUILD_DIR = build
BIN_DIR = bin
BACKEND_BIN = $(BIN_DIR)/freelang-api-server
DOCKER_IMAGE = freelang-hybrid:latest
DOCKER_CONTAINER = freelang-hybrid-app

# 색상
GREEN = \033[0;32m
BLUE = \033[0;34m
YELLOW = \033[0;33m
RED = \033[0;31m
NC = \033[0m # No Color

help:
	@echo "$(BLUE)FreeLang Hybrid - 빌드 가이드$(NC)"
	@echo ""
	@echo "$(YELLOW)로컬 빌드 (Linux/macOS):$(NC)"
	@echo "  $(GREEN)make build$(NC)          - 네이티브 바이너리 컴파일"
	@echo "  $(GREEN)make compile$(NC)        - FreeLang → JavaScript 변환"
	@echo "  $(GREEN)make run$(NC)            - 서버 실행"
	@echo "  $(GREEN)make test$(NC)           - 테스트 실행"
	@echo ""
	@echo "$(YELLOW)Docker 빌드:$(NC)"
	@echo "  $(GREEN)make docker-build$(NC)   - Docker 이미지 생성"
	@echo "  $(GREEN)make docker-run$(NC)     - 컨테이너 실행 (localhost:3000-3001)"
	@echo "  $(GREEN)make docker-stop$(NC)    - 컨테이너 중지"
	@echo ""
	@echo "$(YELLOW)유틸리티:$(NC)"
	@echo "  $(GREEN)make clean$(NC)          - 빌드 파일 삭제"
	@echo "  $(GREEN)make help$(NC)           - 이 메시지 표시"

# ================== 로컬 빌드 ==================

$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR) $(BIN_DIR)

build: $(BUILD_DIR) check-freelang
	@echo "$(BLUE)[1/4] FreeLang 공유 타입 컴파일 중...$(NC)"
	@$(FREELANG_HOME) compile $(SHARED_SRC) -o $(BUILD_DIR)/types.o
	@echo "$(GREEN)✅ 공유 타입 완료$(NC)"
	@echo ""
	@echo "$(BLUE)[2/4] 백엔드 API 컴파일 중...$(NC)"
	@$(FREELANG_HOME) compile $(BACKEND_SRC) \
		--link $(BUILD_DIR)/types.o \
		-o $(BACKEND_BIN)
	@echo "$(GREEN)✅ 백엔드 API 완료: $(BACKEND_BIN)$(NC)"
	@echo ""
	@echo "$(BLUE)[3/4] 웹 서버 래퍼 생성 중...$(NC)"
	@cp backend/server.js $(BIN_DIR)/
	@echo "$(GREEN)✅ 웹 서버 래퍼 완료$(NC)"
	@echo ""
	@echo "$(BLUE)[4/4] 정적 파일 복사 중...$(NC)"
	@cp -r static $(BIN_DIR)/
	@echo "$(GREEN)✅ 정적 파일 완료$(NC)"
	@echo ""
	@echo "$(GREEN)🎉 빌드 완료!$(NC)"
	@echo "   실행: ./$(BACKEND_BIN) --static ./$(BIN_DIR)/static"

compile: $(BUILD_DIR) check-freelang
	@echo "$(BLUE)FreeLang → JavaScript 컴파일$(NC)"
	@echo ""
	@echo "$(YELLOW)1️⃣  백엔드 API 생성 중...$(NC)"
	@$(FREELANG_HOME) compile $(BACKEND_SRC) \
		--target javascript \
		-o $(BUILD_DIR)/api-compiled.js
	@echo "$(GREEN)✅ 생성: $(BUILD_DIR)/api-compiled.js$(NC)"
	@echo ""
	@echo "$(YELLOW)2️⃣  프론트엔드 상태관리 생성 중...$(NC)"
	@$(FREELANG_HOME) compile $(FRONTEND_SRC) \
		--target javascript \
		-o $(BUILD_DIR)/state-compiled.js
	@echo "$(GREEN)✅ 생성: $(BUILD_DIR)/state-compiled.js$(NC)"
	@echo ""
	@echo "$(YELLOW)3️⃣  TypeScript 선언 파일 생성 중...$(NC)"
	@$(FREELANG_HOME) generate-types $(BUILD_DIR)/*.js \
		-o $(BUILD_DIR)/types.d.ts
	@echo "$(GREEN)✅ 생성: $(BUILD_DIR)/types.d.ts$(NC)"
	@echo ""
	@echo "$(GREEN)🎉 컴파일 완료!$(NC)"

run:
	@echo "$(BLUE)FreeLang Hybrid 시작중...$(NC)"
	@echo "  - API:  http://localhost:3001"
	@echo "  - 웹:   http://localhost:3000"
	@echo ""
	@node backend/server.js

test:
	@echo "$(BLUE)통합 테스트 실행 중...$(NC)"
	@node backend/test.js

# ================== Docker 빌드 ==================

docker-build:
	@echo "$(BLUE)Docker 이미지 빌드 중: $(DOCKER_IMAGE)$(NC)"
	@docker build -t $(DOCKER_IMAGE) \
		--build-arg NODE_VERSION=25 \
		--build-arg FREELANG_VERSION=2.8.0 \
		.
	@echo "$(GREEN)✅ 이미지 빌드 완료$(NC)"

docker-run: docker-stop
	@echo "$(BLUE)Docker 컨테이너 시작 중: $(DOCKER_CONTAINER)$(NC)"
	@docker run -d \
		--name $(DOCKER_CONTAINER) \
		-p 3000:3000 \
		-p 3001:3001 \
		-v $(PWD)/data:/app/data \
		$(DOCKER_IMAGE)
	@echo "$(GREEN)✅ 컨테이너 시작됨$(NC)"
	@echo "  - 웹:  http://localhost:3000"
	@echo "  - API: http://localhost:3001"
	@echo ""
	@echo "로그 보기: docker logs -f $(DOCKER_CONTAINER)"
	@echo "중지하기: make docker-stop"

docker-stop:
	@docker rm -f $(DOCKER_CONTAINER) 2>/dev/null || true

# ================== 유틸리티 ==================

check-freelang:
	@if ! command -v $(FREELANG_HOME) &> /dev/null; then \
		echo "$(RED)❌ 오류: FreeLang 컴파일러를 찾을 수 없습니다$(NC)"; \
		echo ""; \
		echo "$(YELLOW)설치 방법:$(NC)"; \
		echo "  Linux/macOS: https://freelang.io/install"; \
		echo "  macOS (Homebrew): brew install freelang"; \
		echo ""; \
		exit 1; \
	fi
	@echo "$(GREEN)✅ FreeLang 컴파일러 found: $$($(FREELANG_HOME) --version)$(NC)"

clean:
	@echo "$(YELLOW)빌드 파일 정리 중...$(NC)"
	@rm -rf $(BUILD_DIR) $(BIN_DIR)
	@docker rm -f $(DOCKER_CONTAINER) 2>/dev/null || true
	@echo "$(GREEN)✅ 정리 완료$(NC)"

# ================== 고급 옵션 ==================

# 최적화 빌드
build-optimized: $(BUILD_DIR) check-freelang
	@echo "$(BLUE)최적화 네이티브 빌드 중...$(NC)"
	@$(FREELANG_HOME) compile $(BACKEND_SRC) \
		-O3 \
		--lto \
		--strip \
		-o $(BACKEND_BIN)
	@echo "$(GREEN)✅ 최적화 빌드 완료$(NC)"
	@du -h $(BACKEND_BIN)

# 프로파일링 빌드
build-profile: $(BUILD_DIR) check-freelang
	@echo "$(BLUE)프로파일링 빌드 중...$(NC)"
	@$(FREELANG_HOME) compile $(BACKEND_SRC) \
		--profile \
		--debuginfo=full \
		-o $(BACKEND_BIN)
	@echo "$(GREEN)✅ 프로파일링 빌드 완료$(NC)"

# 벤치마크
bench: test
	@echo ""
	@echo "$(BLUE)성능 벤치마크$(NC)"
	@time node backend/server.js &
	@sleep 2
	@time curl -s http://localhost:3001/api/counter > /dev/null
	@time curl -s -X POST http://localhost:3001/api/counter/increment -d '{}' > /dev/null
	@pkill -f "node backend/server.js"

info:
	@echo "$(BLUE)프로젝트 정보$(NC)"
	@echo ""
	@echo "FreeLang 버전:"
	@$(FREELANG_HOME) --version 2>/dev/null || echo "Not installed"
	@echo ""
	@echo "구성:"
	@echo "  - 백엔드: $(BACKEND_SRC) ($(shell wc -l < $(BACKEND_SRC)) 줄)"
	@echo "  - 프론트: $(FRONTEND_SRC) ($(shell wc -l < $(FRONTEND_SRC)) 줄)"
	@echo "  - 타입: $(SHARED_SRC) ($(shell wc -l < $(SHARED_SRC)) 줄)"
	@echo ""
	@echo "Node.js: $$(node --version)"
	@echo "npm: $$(npm --version)"
