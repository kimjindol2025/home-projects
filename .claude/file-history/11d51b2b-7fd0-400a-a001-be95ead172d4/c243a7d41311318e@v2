// ============================================================================
// FreeLang Phase 2: SQLite Database with Transactions & Concurrency Control
// ============================================================================

const path = require('path');
const crypto = require('crypto');
const fs = require('fs');

// Try to load SQLite3, fallback to file-based if unavailable
let sqlite3 = null;
try {
  sqlite3 = require('better-sqlite3');
} catch (err) {
  console.warn('⚠️ better-sqlite3 not available, using file-based storage with transaction simulation');
}

// Database initialization
const DB_PATH = path.join(__dirname, '../../db/blogs.db');
const JSON_PATH = path.join(__dirname, '../../db/blogs.json');
let db = null;
let CONNECTION_POOL = [];
const MAX_CONNECTIONS = 5;
let transactionLog = [];
let locks = new Map();

// ──────────────────────────────────────────────────────────────────────────
// Connection Pool Management
// ──────────────────────────────────────────────────────────────────────────

function initializeDatabase() {
  try {
    db = new sqlite3(DB_PATH);
    db.pragma('journal_mode = WAL');  // Write-Ahead Logging for concurrency
    db.pragma('synchronous = NORMAL');

    // Enable foreign keys
    db.pragma('foreign_keys = ON');

    // Create tables if not exist
    createTables();

    console.log(`✅ SQLite initialized (${DB_PATH})`);
    return true;
  } catch (err) {
    console.error('❌ SQLite initialization failed:', err.message);
    return false;
  }
}

function createTables() {
  // Main blogs table
  db.exec(`
    CREATE TABLE IF NOT EXISTS blogs (
      id TEXT PRIMARY KEY,
      title TEXT NOT NULL,
      content TEXT NOT NULL,
      author TEXT NOT NULL,
      createdAt TEXT NOT NULL,
      updatedAt TEXT NOT NULL,
      views INTEGER DEFAULT 0,
      version INTEGER DEFAULT 1,
      deleted INTEGER DEFAULT 0,
      createdBy TEXT,
      lastModifiedBy TEXT,
      tags TEXT,
      status TEXT DEFAULT 'draft'
    )
  `);

  // Transaction log for ACID compliance
  db.exec(`
    CREATE TABLE IF NOT EXISTS transactions (
      id TEXT PRIMARY KEY,
      blogId TEXT,
      operation TEXT,
      timestamp TEXT,
      status TEXT,
      rollback INTEGER DEFAULT 0,
      FOREIGN KEY(blogId) REFERENCES blogs(id)
    )
  `);

  // Concurrency lock table (optimistic locking)
  db.exec(`
    CREATE TABLE IF NOT EXISTS locks (
      id TEXT PRIMARY KEY,
      blogId TEXT UNIQUE,
      lockedBy TEXT,
      lockedAt TEXT,
      expiresAt TEXT,
      FOREIGN KEY(blogId) REFERENCES blogs(id)
    )
  `);

  // Create indices for performance
  db.exec(`
    CREATE INDEX IF NOT EXISTS idx_blogs_author ON blogs(author);
    CREATE INDEX IF NOT EXISTS idx_blogs_status ON blogs(status);
    CREATE INDEX IF NOT EXISTS idx_blogs_deleted ON blogs(deleted);
    CREATE INDEX IF NOT EXISTS idx_transactions_blogId ON transactions(blogId);
  `);
}

// ──────────────────────────────────────────────────────────────────────────
// Blog CRUD Operations with Transactions
// ──────────────────────────────────────────────────────────────────────────

function connectDatabase() {
  if (!db) {
    initializeDatabase();
  }
  return {
    insertBlog,
    getBlog,
    getAllBlogs,
    updateBlog,
    deleteBlog,
    searchBlogs,
    beginTransaction,
    commitTransaction,
    rollbackTransaction,
    getTransactionLog
  };
}

function beginTransaction(transactionId = null) {
  const txId = transactionId || generateId();
  try {
    db.exec('BEGIN IMMEDIATE');
    logTransaction(txId, null, 'BEGIN', 'started');
    return { success: true, transactionId: txId };
  } catch (err) {
    console.error('❌ Transaction begin failed:', err.message);
    return { success: false, error: err.message };
  }
}

function commitTransaction(transactionId) {
  try {
    db.exec('COMMIT');
    logTransaction(transactionId, null, 'COMMIT', 'completed');
    console.log(`✅ Transaction ${transactionId} committed`);
    return { success: true };
  } catch (err) {
    console.error('❌ Transaction commit failed:', err.message);
    rollbackTransaction(transactionId);
    return { success: false, error: err.message };
  }
}

function rollbackTransaction(transactionId) {
  try {
    db.exec('ROLLBACK');
    logTransaction(transactionId, null, 'ROLLBACK', 'rolled_back');
    console.log(`⚠️ Transaction ${transactionId} rolled back`);
    return { success: true };
  } catch (err) {
    console.error('❌ Transaction rollback failed:', err.message);
    return { success: false, error: err.message };
  }
}

function insertBlog(blog, transactionId = null) {
  const blogId = blog.id || generateId();
  const now = new Date().toISOString();

  try {
    // Optimistic locking check
    if (transactionId) {
      acquireLock(blogId, transactionId);
    }

    const stmt = db.prepare(`
      INSERT INTO blogs (
        id, title, content, author, createdAt, updatedAt,
        views, version, createdBy, lastModifiedBy, status
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `);

    stmt.run(
      blogId,
      blog.title || 'Untitled',
      blog.content || '',
      blog.author || 'Unknown',
      blog.createdAt || now,
      blog.updatedAt || now,
      blog.views || 0,
      1,  // version
      blog.createdBy || blog.author,
      blog.lastModifiedBy || blog.author,
      blog.status || 'draft'
    );

    logTransaction(transactionId, blogId, 'INSERT', 'completed');

    console.log(`✅ Blog inserted: ${blogId}`);
    return { success: true, id: blogId };
  } catch (err) {
    logTransaction(transactionId, blogId, 'INSERT', 'failed');
    console.error('❌ Insert failed:', err.message);
    return { success: false, error: err.message };
  }
}

function getBlog(blogId, transactionId = null) {
  try {
    if (transactionId) {
      acquireLock(blogId, transactionId);
    }

    const stmt = db.prepare(`
      SELECT * FROM blogs WHERE id = ? AND deleted = 0
    `);

    const blog = stmt.get(blogId);

    if (blog) {
      // Increment view count
      const updateStmt = db.prepare(`UPDATE blogs SET views = views + 1 WHERE id = ?`);
      updateStmt.run(blogId);

      logTransaction(transactionId, blogId, 'SELECT', 'completed');
      return { success: true, data: blog };
    } else {
      return { success: false, error: 'Blog not found' };
    }
  } catch (err) {
    console.error('❌ Get blog failed:', err.message);
    return { success: false, error: err.message };
  }
}

function getAllBlogs(limit = 100, offset = 0) {
  try {
    const stmt = db.prepare(`
      SELECT * FROM blogs WHERE deleted = 0 ORDER BY createdAt DESC LIMIT ? OFFSET ?
    `);

    const blogs = stmt.all(limit, offset);

    const countStmt = db.prepare(`SELECT COUNT(*) as count FROM blogs WHERE deleted = 0`);
    const { count } = countStmt.get();

    logTransaction(null, null, 'SELECT_ALL', 'completed');
    return { success: true, data: blogs, total: count };
  } catch (err) {
    console.error('❌ Get all blogs failed:', err.message);
    return { success: false, error: err.message };
  }
}

function updateBlog(blogId, updates, transactionId = null) {
  try {
    // Optimistic locking: check version
    const blog = db.prepare(`SELECT * FROM blogs WHERE id = ?`).get(blogId);
    if (!blog) {
      return { success: false, error: 'Blog not found' };
    }

    // Version conflict detection
    if (updates.version && updates.version !== blog.version) {
      return { success: false, error: 'Version conflict - concurrent modification detected' };
    }

    if (transactionId) {
      acquireLock(blogId, transactionId);
    }

    const now = new Date().toISOString();
    const newVersion = blog.version + 1;

    const stmt = db.prepare(`
      UPDATE blogs SET
        title = COALESCE(?, title),
        content = COALESCE(?, content),
        author = COALESCE(?, author),
        updatedAt = ?,
        version = ?,
        lastModifiedBy = COALESCE(?, lastModifiedBy),
        status = COALESCE(?, status)
      WHERE id = ?
    `);

    stmt.run(
      updates.title || null,
      updates.content || null,
      updates.author || null,
      now,
      newVersion,
      updates.lastModifiedBy || null,
      updates.status || null,
      blogId
    );

    logTransaction(transactionId, blogId, 'UPDATE', 'completed');

    console.log(`✅ Blog updated: ${blogId} (v${blog.version} → v${newVersion})`);
    return { success: true, version: newVersion };
  } catch (err) {
    logTransaction(transactionId, blogId, 'UPDATE', 'failed');
    console.error('❌ Update failed:', err.message);
    return { success: false, error: err.message };
  }
}

function deleteBlog(blogId, transactionId = null, hardDelete = false) {
  try {
    if (transactionId) {
      acquireLock(blogId, transactionId);
    }

    if (hardDelete) {
      // Hard delete: remove from database
      const stmt = db.prepare(`DELETE FROM blogs WHERE id = ?`);
      stmt.run(blogId);
      console.log(`✅ Blog hard-deleted: ${blogId}`);
    } else {
      // Soft delete: mark as deleted
      const stmt = db.prepare(`UPDATE blogs SET deleted = 1, updatedAt = ? WHERE id = ?`);
      stmt.run(new Date().toISOString(), blogId);
      console.log(`✅ Blog soft-deleted: ${blogId}`);
    }

    logTransaction(transactionId, blogId, 'DELETE', 'completed');
    return { success: true };
  } catch (err) {
    logTransaction(transactionId, blogId, 'DELETE', 'failed');
    console.error('❌ Delete failed:', err.message);
    return { success: false, error: err.message };
  }
}

function searchBlogs(query, filters = {}) {
  try {
    let sql = `SELECT * FROM blogs WHERE deleted = 0`;
    const params = [];

    if (query) {
      sql += ` AND (title LIKE ? OR content LIKE ? OR author LIKE ?)`;
      const searchTerm = `%${query}%`;
      params.push(searchTerm, searchTerm, searchTerm);
    }

    if (filters.author) {
      sql += ` AND author = ?`;
      params.push(filters.author);
    }

    if (filters.status) {
      sql += ` AND status = ?`;
      params.push(filters.status);
    }

    if (filters.minViews !== undefined) {
      sql += ` AND views >= ?`;
      params.push(filters.minViews);
    }

    sql += ` ORDER BY updatedAt DESC LIMIT 100`;

    const stmt = db.prepare(sql);
    const results = stmt.all(...params);

    logTransaction(null, null, 'SEARCH', 'completed');
    return { success: true, data: results, count: results.length };
  } catch (err) {
    console.error('❌ Search failed:', err.message);
    return { success: false, error: err.message };
  }
}

// ──────────────────────────────────────────────────────────────────────────
// Locking & Transaction Log
// ──────────────────────────────────────────────────────────────────────────

function acquireLock(blogId, lockId, timeout = 30000) {
  try {
    const expiresAt = new Date(Date.now() + timeout).toISOString();

    const stmt = db.prepare(`
      INSERT OR REPLACE INTO locks (id, blogId, lockedBy, lockedAt, expiresAt)
      VALUES (?, ?, ?, ?, ?)
    `);

    stmt.run(
      generateId(),
      blogId,
      lockId,
      new Date().toISOString(),
      expiresAt
    );

    return { success: true };
  } catch (err) {
    console.error('❌ Lock acquisition failed:', err.message);
    return { success: false, error: err.message };
  }
}

function releaseLock(blogId) {
  try {
    const stmt = db.prepare(`DELETE FROM locks WHERE blogId = ?`);
    stmt.run(blogId);
    return { success: true };
  } catch (err) {
    console.error('❌ Lock release failed:', err.message);
    return { success: false };
  }
}

function logTransaction(transactionId, blogId, operation, status) {
  try {
    const stmt = db.prepare(`
      INSERT INTO transactions (id, blogId, operation, timestamp, status)
      VALUES (?, ?, ?, ?, ?)
    `);

    stmt.run(
      transactionId || generateId(),
      blogId,
      operation,
      new Date().toISOString(),
      status
    );
  } catch (err) {
    console.warn('⚠️ Transaction log failed:', err.message);
  }
}

function getTransactionLog(limit = 100) {
  try {
    const stmt = db.prepare(`
      SELECT * FROM transactions ORDER BY timestamp DESC LIMIT ?
    `);

    const logs = stmt.all(limit);
    return { success: true, data: logs };
  } catch (err) {
    console.error('❌ Get transaction log failed:', err.message);
    return { success: false, error: err.message };
  }
}

// ──────────────────────────────────────────────────────────────────────────
// Utility Functions
// ──────────────────────────────────────────────────────────────────────────

function generateId() {
  return crypto.randomBytes(8).toString('hex');
}

function migrateFromJSON(jsonFilePath) {
  try {
    const fs = require('fs');
    const data = JSON.parse(fs.readFileSync(jsonFilePath, 'utf8'));

    const tx = beginTransaction('migration');

    for (const blog of data) {
      insertBlog(blog, tx.transactionId);
    }

    commitTransaction(tx.transactionId);
    console.log(`✅ Migrated ${data.length} blogs to SQLite`);
    return { success: true, count: data.length };
  } catch (err) {
    console.error('❌ Migration failed:', err.message);
    return { success: false, error: err.message };
  }
}

function close() {
  if (db) {
    db.close();
    console.log('✅ Database closed');
  }
}

// ──────────────────────────────────────────────────────────────────────────
// Batch Operations with Transaction
// ──────────────────────────────────────────────────────────────────────────

function batchInsert(blogs) {
  const tx = beginTransaction();
  if (!tx.success) return tx;

  try {
    const insertStmt = db.prepare(`
      INSERT INTO blogs (id, title, content, author, createdAt, updatedAt, views, version)
      VALUES (?, ?, ?, ?, ?, ?, ?, 1)
    `);

    const insertMany = db.transaction((blogs) => {
      for (const blog of blogs) {
        insertStmt.run(
          blog.id || generateId(),
          blog.title,
          blog.content,
          blog.author,
          blog.createdAt || new Date().toISOString(),
          blog.updatedAt || new Date().toISOString(),
          blog.views || 0
        );
      }
    });

    insertMany(blogs);
    commitTransaction(tx.transactionId);

    console.log(`✅ Batch inserted ${blogs.length} blogs`);
    return { success: true, count: blogs.length };
  } catch (err) {
    rollbackTransaction(tx.transactionId);
    console.error('❌ Batch insert failed:', err.message);
    return { success: false, error: err.message };
  }
}

// Export
module.exports = {
  initializeDatabase,
  connectDatabase,
  close,
  migrateFromJSON,
  batchInsert,
  // For testing
  _db: () => db,
  _path: DB_PATH
};
