name: freelang-light
version: 1.0.0
description: "FreeLang 라이트 버전 - 경량 CSS 프레임워크 + HTML 리소스"

author: "kim"
license: "MIT"

repository:
  type: "git"
  url: "https://gogs.dclub.kr/kim/freelang-light.git"

modules:
  - name: "minitailwind-css"
    path: "public/css/styles.css"
    type: "asset"
    description: "MiniTailwind CSS (500+ 유틸리티 클래스)"
    size: "6.1 KB (압축: 1.2 KB)"

  - name: "minitailwind-dark"
    path: "public/css/styles-dark.css"
    type: "asset"
    description: "다크 테마 CSS 오버라이드"
    size: "170 B"

  - name: "tailwind-runtime"
    path: "frontend/tailwind-runtime.js"
    type: "library"
    description: "순수 JavaScript Tailwind 런타임 (의존성 0)"
    size: "11 KB"
    exports:
      - "TailwindRuntime"
    features:
      - "동적 클래스 관리"
      - "테마 전환 (Light/Dark)"
      - "반응형 감지"
      - "localStorage 저장소"

  - name: "blog-page"
    path: "blog.html"
    type: "asset"
    description: "완전한 블로그 페이지 (MiniTailwind 활용)"
    size: "~5 KB"

dependencies: []

requires:
  browser: ">= ES6"
  npm: "not required"
  node: "not required"

keywords:
  - css-framework
  - minitailwind
  - utility-first-css
  - responsive-design
  - dark-mode
  - zero-dependencies
  - lightweight
  - frontend

tags:
  - production-ready
  - lightweight
  - css-only
  - no-npm

features:
  - "500+ 유틸리티 CSS 클래스"
  - "5가지 반응형 브레이크포인트 (xs, sm, md, lg, xl)"
  - "라이트/다크 테마 지원"
  - "CSS 변수 기반 설정"
  - "30KB 이하의 경량 CSS"
  - "npm 불필요 - 순수 HTML/CSS/JS"
  - "번들 크기 최적화 (gzip: 6KB)"

statistics:
  css_classes: 500+
  breakpoints: 5
  color_variants: 20+
  responsive_utilities: 30+
  javascript_lines: 300+
  total_css_size: 6.1 KB
  compressed_size: 1.2 KB
  dependencies: 0

usage_example: |
  <!-- HTML에서 직접 사용 -->
  <link rel="stylesheet" href="public/css/styles.css">
  <script src="frontend/tailwind-runtime.js"></script>

  <!-- MiniTailwind 유틸리티 클래스 -->
  <div class="flex items-center justify-between p-4 bg-white dark:bg-gray-900">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
      Hello World
    </h1>
  </div>

  <!-- 동적 테마 전환 -->
  <script>
    const runtime = new TailwindRuntime();
    runtime.switchTheme('dark'); // 또는 'light'
  </script>

utilities_included:
  display:
    - flex
    - block
    - inline-block
    - grid
    - hidden
  spacing:
    - m (margin): 0-48
    - p (padding): 0-48
    - gap: 0-48
  colors:
    - gray
    - blue
    - green
    - red
    - yellow
    - purple
  typography:
    - text-xs to text-4xl
    - font-normal to font-bold
    - text-center, text-left, text-right
  interactive:
    - hover
    - focus
    - active
    - disabled

browser_support:
  - "Chrome 90+"
  - "Firefox 88+"
  - "Safari 14+"
  - "Edge 90+"

performance:
  lighthouse_score: 95+
  accessibility_score: 95+
  best_practices_score: 90+
  first_contentful_paint: "<0.5s"
  time_to_interactive: "<1s"

file_structure: |
  freelang-light/
  ├── public/
  │   └── css/
  │       ├── styles.css           (6.1 KB, 500+ 클래스)
  │       └── styles-dark.css      (170 B, 다크 테마)
  ├── frontend/
  │   └── tailwind-runtime.js      (11 KB, 런타임)
  ├── blog.html                    (완전한 블로그 페이지)
  └── kpm.yaml                     (이 파일)

created_at: "2026-03-13"
updated_at: "2026-03-13"
