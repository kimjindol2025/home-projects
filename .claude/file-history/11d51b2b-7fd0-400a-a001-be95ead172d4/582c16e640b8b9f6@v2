/**
 * Markup Processor for FreeLang Light
 * 조건부 및 반복 렌더링 처리
 */

const { ExpressionEvaluator } = require('./expression-evaluator');

class MarkupProcessor {
  constructor(props = {}) {
    this.evaluator = new ExpressionEvaluator(props);
    this.props = props;
  }

  /**
   * 마크업 처리 (조건, 반복, 변수 치환)
   */
  process(markup, context = {}) {
    // 중첩된 조건/반복을 안쪽부터 처리
    let result = markup;

    // 1단계: 가장 안쪽의 조건 처리
    result = this.processConditions(result, context);

    // 2단계: 반복 처리
    result = this.processLoops(result, context);

    // 3단계: 변수 치환
    result = this.substituteVariables(result, context);

    return result;
  }

  /**
   * 조건부 처리
   * {if condition ? true_html : false_html}
   */
  processConditions(markup, context = {}) {
    const allContext = { ...this.props, ...context };

    // {if ...} 패턴 찾기
    const ifPattern = /\{if\s+(.+?)\s*\?\s*(.+?)\s*:\s*(.+?)\s*\}/gs;

    return markup.replace(ifPattern, (match, condition, trueHtml, falseHtml) => {
      try {
        const condResult = this.evaluator.evaluateCondition(condition.trim(), allContext);
        return condResult ? trueHtml.trim() : falseHtml.trim();
      } catch (error) {
        console.warn(`Condition evaluation failed: "${condition}"`, error.message);
        return '';
      }
    });
  }

  /**
   * 반복 처리
   * {for item in items ? <li>{item}</li>}
   */
  processLoops(markup, context = {}) {
    const allContext = { ...this.props, ...context };

    // {for ...} 패턴 찾기 (그리디하지 않게)
    const forPattern = /\{for\s+(\w+)\s+in\s+(\w+)\s*\?\s*((?:[^{}]|\{[^}]*\})*?)\s*\}/gs;

    return markup.replace(forPattern, (match, itemVar, arrayVar, template) => {
      try {
        const array = allContext[arrayVar];

        if (!Array.isArray(array)) {
          console.warn(`"${arrayVar}" is not an array`);
          return '';
        }

        // 각 아이템에 대해 템플릿 반복
        return array.map((item, index) => {
          const itemContext = {
            ...allContext,
            [itemVar]: item,
            [`${itemVar}_index`]: index,
            [`${itemVar}_first`]: index === 0,
            [`${itemVar}_last`]: index === array.length - 1
          };

          return this.substituteVariables(template.trim(), itemContext);
        }).join('');
      } catch (error) {
        console.warn(`Loop processing failed: "for ${itemVar} in ${arrayVar}"`, error.message);
        return '';
      }
    });
  }

  /**
   * 변수 치환
   * {변수명} → 값으로 대체
   */
  substituteVariables(markup, context = {}) {
    const allContext = { ...this.props, ...context };

    // {변수명} 패턴 찾기
    const varPattern = /\{([a-zA-Z_]\w*)\}/g;

    return markup.replace(varPattern, (match, varName) => {
      const value = allContext[varName];

      if (value === null || value === undefined) {
        return '';
      }

      if (typeof value === 'object') {
        return JSON.stringify(value);
      }

      return String(value);
    });
  }

  /**
   * 바인딩 표현식 처리 (onclick, onchange 등)
   * onclick="handler(this, {param})"
   */
  processBindings(html, context = {}) {
    const allContext = { ...this.props, ...context };

    // 속성값의 {변수}를 치환
    const bindPattern = /(\w+)="([^"]*)"/g;

    return html.replace(bindPattern, (match, attrName, attrValue) => {
      let newValue = attrValue;

      // 속성값 내의 {변수} 치환
      newValue = newValue.replace(/\{([a-zA-Z_]\w*)\}/g, (m, varName) => {
        const value = allContext[varName];
        return value !== undefined && value !== null ? String(value) : '';
      });

      return `${attrName}="${newValue}"`;
    });
  }

  /**
   * 전체 처리 (모든 단계)
   */
  processComplete(markup, context = {}) {
    let result = markup;

    // 조건 처리
    result = this.processConditions(result, context);

    // 반복 처리
    result = this.processLoops(result, context);

    // 바인딩 처리
    result = this.processBindings(result, context);

    // 변수 치환
    result = this.substituteVariables(result, context);

    return result;
  }
}

module.exports = { MarkupProcessor };
