component Button {
  props {
    label: string
    type: string
    disabled: boolean
  }

  style {
    .btn {
      padding: 10px 20px
      border: none
      borderRadius: 4px
      cursor: pointer
      fontWeight: bold
      fontSize: 14px
      transition: all 0.3s ease
    }

    .btn:hover {
      opacity: 0.9
      transform: translateY(-2px)
      boxShadow: 0 4px 12px rgba(0,0,0,0.15)
    }

    .btn:active {
      transform: translateY(0)
    }

    .btn.primary {
      background: #007bff
      color: white
    }

    .btn.primary:hover {
      background: #0056b3
    }

    .btn.secondary {
      background: #6c757d
      color: white
    }

    .btn.secondary:hover {
      background: #545b62
    }

    .btn:disabled {
      opacity: 0.5
      cursor: not-allowed
      transform: none
    }
  }

  script {
    fn handle_click(element) {
      console.log("Button clicked:", element.textContent)
      element.blur()
    }

    fn toggle_disabled(element) {
      element.disabled = !element.disabled
    }

    fn set_label(element, newLabel) {
      element.textContent = newLabel
    }
  }

  markup {
    <button class="btn {type}" onclick="handle_click(this)" disabled="{disabled}">
      {label}
    </button>
  }
}
