/**
 * HTML Generator for FreeLang Light
 * markup 블록을 HTML로 생성
 */

class HTMLGenerator {
  generate(ast) {
    let html = '<!DOCTYPE html>\n';
    html += '<html lang="ko">\n';
    html += '<head>\n';
    html += '  <meta charset="UTF-8">\n';
    html += '  <meta name="viewport" content="width=device-width, initial-scale=1.0">\n';
    html += `  <title>${ast.name}</title>\n`;
    html += `  <link rel="stylesheet" href="${ast.name.toLowerCase()}.css">\n`;
    html += '</head>\n';
    html += '<body>\n\n';

    // Props 주석
    if (ast.props.properties.length > 0) {
      html += '<!-- Props -->\n';
      html += '<!-- Available props:\n';
      ast.props.properties.forEach(prop => {
        html += `   - ${prop.name} (${prop.type})\n`;
      });
      html += '-->\n\n';
    }

    // Markup 내용
    html += this.transpileMarkup(ast.markup.content);

    html += '\n\n';

    // Script 태그
    html += `  <script src="${ast.name.toLowerCase()}.js"><\/script>\n`;

    html += '</body>\n';
    html += '</html>\n';

    return html;
  }

  /**
   * Markup을 HTML로 변환
   * - {variable} → ${variable}
   * - onclick="handler(this)" 유지
   */
  transpileMarkup(content) {
    let html = content;

    // {변수명} → ${변수명}
    html = html.replace(/\{([a-zA-Z_][a-zA-Z0-9_]*)\}/g, '${$1}');

    // HTML 들여쓰기
    html = html.split('\n')
      .map(line => '  ' + line)
      .join('\n');

    return html;
  }
}

module.exports = { HTMLGenerator };
