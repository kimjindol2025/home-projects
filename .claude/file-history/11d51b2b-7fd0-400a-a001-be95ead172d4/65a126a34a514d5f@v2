/**
 * Bundler Tests
 */

const fs = require('fs');
const path = require('path');
const { Bundler } = require('./bundler');

function test(name, fn) {
  try {
    fn();
    console.log(`✅ ${name}`);
  } catch (error) {
    console.error(`❌ ${name}: ${error.message}`);
  }
}

const testDir = path.join(__dirname, '..', 'test-bundles');
if (!fs.existsSync(testDir)) {
  fs.mkdirSync(testDir, { recursive: true });
}

console.log('\n📦 Bundler Tests\n');

test('번들러 생성', () => {
  const bundler = new Bundler({
    bundleName: 'test-app',
    outputDir: testDir,
    minify: false
  });
  if (!bundler.options) throw new Error('Bundler not initialized');
});

test('CSS 최소화', () => {
  const bundler = new Bundler();
  const css = `
    /* Comment */
    .button {
      padding: 10px;
      color: red;
    }
  `;
  const minified = bundler.minifyCSS(css);
  if (minified.includes('/*')) throw new Error('Comments not removed');
  if (minified.length >= css.length) throw new Error('Not minified');
});

test('JavaScript 최소화', () => {
  const bundler = new Bundler();
  const js = `
    // Comment
    function test() {
      console.log("hello");
    }
  `;
  const minified = bundler.minifyJS(js);
  if (minified.includes('//')) throw new Error('Comments not removed');
});

test('해시값 계산', () => {
  const bundler = new Bundler();
  const hash1 = bundler.calculateHash('hello');
  const hash2 = bundler.calculateHash('hello');
  if (hash1 !== hash2) throw new Error('Hash mismatch');
  if (hash1.length !== 8) throw new Error('Invalid hash length');
});

test('번들 통계', () => {
  const bundler = new Bundler();
  bundler.assets.css.push({ name: 'test', content: 'body {}' });
  bundler.assets.js.push({ name: 'test', content: 'console.log("test")' });
  bundler.manifest.components = ['test'];

  const stats = bundler.getStats();
  if (stats.components !== 1) throw new Error('Invalid component count');
  if (stats.css_files !== 1) throw new Error('Invalid CSS file count');
});

test('코드 들여쓰기', () => {
  const bundler = new Bundler();
  const code = 'line1\nline2';
  const indented = bundler.indentCode(code, 2);
  if (!indented.startsWith('  ')) throw new Error('Not indented');
});

console.log('\n✨ Bundler 테스트 완료!\n');

// 실제 번들링 테스트
console.log('🎯 실제 번들링 테스트\n');

try {
  // 예제 CSS/JS/HTML 파일 생성
  const exampleDir = path.join(testDir, 'example-components');
  if (!fs.existsSync(exampleDir)) {
    fs.mkdirSync(exampleDir, { recursive: true });
  }

  // 예제 파일 생성
  fs.writeFileSync(path.join(exampleDir, 'demo1.css'), `.demo1 { color: blue; }`);
  fs.writeFileSync(path.join(exampleDir, 'demo1.js'), `function demo1() { console.log("demo1"); }`);
  fs.writeFileSync(path.join(exampleDir, 'demo1.html'), `<div class="demo1">Demo 1</div>`);

  fs.writeFileSync(path.join(exampleDir, 'demo2.css'), `.demo2 { color: red; }`);
  fs.writeFileSync(path.join(exampleDir, 'demo2.js'), `function demo2() { console.log("demo2"); }`);
  fs.writeFileSync(path.join(exampleDir, 'demo2.html'), `<div class="demo2">Demo 2</div>`);

  // 번들링
  const bundler = new Bundler({
    bundleName: 'demo-bundle',
    outputDir: testDir,
    minify: true,
    sourcemap: true
  });

  bundler.bundleComponent(path.join(exampleDir, 'demo1.css'));
  bundler.bundleComponent(path.join(exampleDir, 'demo1.js'));
  bundler.bundleComponent(path.join(exampleDir, 'demo1.html'));

  const result = bundler.generate();

  console.log('📊 번들링 결과:');
  console.log(`   CSS: ${result.css}`);
  console.log(`   JS: ${result.js}`);
  console.log(`   HTML: ${result.html}`);
  console.log(`\n📈 통계:`);
  console.log(`   Components: ${result.stats.components}`);
  console.log(`   Total Size: ${result.stats.total_size_uncompressed} bytes`);
  console.log(`   CSS Size: ${result.stats.css_size} bytes`);
  console.log(`   JS Size: ${result.stats.js_size} bytes`);

  // 파일 존재 확인
  if (fs.existsSync(result.css)) {
    console.log(`\n✅ 번들 생성 성공!`);
  }
} catch (error) {
  console.error(`❌ 번들링 실패: ${error.message}`);
}

console.log();
