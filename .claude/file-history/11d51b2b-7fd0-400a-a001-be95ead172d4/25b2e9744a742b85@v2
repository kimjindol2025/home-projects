/**
 * FreeLang Light Phase 3 Tests
 * 조건부, 반복, 변수 치환 테스트
 */

const { ExpressionEvaluator } = require('./expression-evaluator');
const { MarkupProcessor } = require('./markup-processor');

function test(name, fn) {
  try {
    fn();
    console.log(`✅ ${name}`);
  } catch (error) {
    console.error(`❌ ${name}: ${error.message}`);
  }
}

// ExpressionEvaluator 테스트
console.log('\n📝 Expression Evaluator Tests\n');

test('기본 산술 연산', () => {
  const eval = new ExpressionEvaluator({ a: 5, b: 3 });
  const result = eval.evaluate('a + b');
  if (result !== 8) throw new Error(`Expected 8, got ${result}`);
});

test('비교 연산', () => {
  const eval = new ExpressionEvaluator({ count: 5 });
  const result = eval.evaluateCondition('count > 3');
  if (!result) throw new Error(`Expected true, got ${result}`);
});

test('문자열 연결', () => {
  const eval = new ExpressionEvaluator({ name: 'Alice' });
  const result = eval.evaluate('"Hello, " + name');
  if (result !== 'Hello, Alice') throw new Error(`Expected 'Hello, Alice', got ${result}`);
});

test('삼항 연산자', () => {
  const eval = new ExpressionEvaluator({ age: 18 });
  const result = eval.evaluateTernary('age >= 18 ? "adult" : "minor"', {});
  if (result !== 'adult') throw new Error(`Expected 'adult', got ${result}`);
});

test('배열 길이', () => {
  const eval = new ExpressionEvaluator({ items: [1, 2, 3] });
  const result = eval.evaluate('items.length');
  if (result !== 3) throw new Error(`Expected 3, got ${result}`);
});

test('Props 기본값 - 문자열', () => {
  const eval = new ExpressionEvaluator({});
  const result = eval.parseDefaultValue("string = 'hello'");
  if (result !== 'hello') throw new Error(`Expected 'hello', got ${result}`);
});

test('Props 기본값 - 숫자', () => {
  const eval = new ExpressionEvaluator({});
  const result = eval.parseDefaultValue('number = 42');
  if (result !== 42) throw new Error(`Expected 42, got ${result}`);
});

test('Props 기본값 - boolean', () => {
  const eval = new ExpressionEvaluator({});
  const result = eval.parseDefaultValue('boolean = true');
  if (result !== true) throw new Error(`Expected true, got ${result}`);
});

test('변수 추출', () => {
  const eval = new ExpressionEvaluator({});
  const vars = eval.extractVariables('count > 0 && items.length > 0');
  if (!vars.includes('count') || !vars.includes('items')) {
    throw new Error(`Expected ['count', 'items'], got ${vars}`);
  }
});

// MarkupProcessor 테스트
console.log('\n🎨 Markup Processor Tests\n');

test('변수 치환', () => {
  const processor = new MarkupProcessor({ name: 'Alice' });
  const html = '<h1>{name}</h1>';
  const result = processor.substituteVariables(html, {});
  if (!result.includes('Alice')) throw new Error(`Expected 'Alice' in result`);
});

test('조건부 렌더링 - true', () => {
  const processor = new MarkupProcessor({ show: true });
  const html = '{if show ? "<div>Visible</div>" : "<div>Hidden</div>"}';
  const result = processor.processConditions(html, {});
  if (!result.includes('Visible')) throw new Error(`Expected 'Visible' in result`);
});

test('조건부 렌더링 - false', () => {
  const processor = new MarkupProcessor({ show: false });
  const html = '{if show ? "<div>Visible</div>" : "<div>Hidden</div>"}';
  const result = processor.processConditions(html, {});
  if (!result.includes('Hidden')) throw new Error(`Expected 'Hidden' in result`);
});

test('반복 렌더링', () => {
  const processor = new MarkupProcessor({ items: ['apple', 'banana', 'cherry'] });
  const html = '<ul>{for item in items ? "<li>{item}</li>" }</ul>';
  const result = processor.processLoops(html, {});
  if (!result.includes('<li>apple</li>')) throw new Error(`Expected '<li>apple</li>' in result`);
  if (!result.includes('<li>banana</li>')) throw new Error(`Expected '<li>banana</li>' in result`);
  if (!result.includes('<li>cherry</li>')) throw new Error(`Expected '<li>cherry</li>' in result`);
});

test('반복 - index 접근', () => {
  const processor = new MarkupProcessor({ items: ['a', 'b'] });
  const html = '{for item in items ? "<span>{item_index}</span>" }';
  const result = processor.processLoops(html, {});
  if (!result.includes('<span>0</span>')) throw new Error(`Expected index 0`);
  if (!result.includes('<span>1</span>')) throw new Error(`Expected index 1`);
});

test('반복 - first/last 플래그', () => {
  const processor = new MarkupProcessor({ items: ['a', 'b', 'c'] });
  const html = '{for item in items ? "<li data-first=\"{item_first}\" data-last=\"{item_last}\">{item}</li>" }';
  const result = processor.processLoops(html, {});
  if (!result.includes('data-first="true"')) throw new Error(`Expected data-first="true"`);
  if (!result.includes('data-last="true"')) throw new Error(`Expected data-last="true"`);
});

test('중첩된 조건 + 반복', () => {
  const processor = new MarkupProcessor({
    show: true,
    items: ['x', 'y']
  });
  const html = '{if show ? "{for item in items ? <li>{item}</li> }" : ""}';
  const result = processor.processComplete(html, {});
  if (!result.includes('<li>x</li>')) throw new Error(`Expected nested result`);
});

test('바인딩 속성 처리', () => {
  const processor = new MarkupProcessor({ id: 'btn1' });
  const html = '<button id="{id}">Click</button>';
  const result = processor.processBindings(html, {});
  if (!result.includes('id="btn1"')) throw new Error(`Expected id="btn1"`);
});

console.log('\n✨ Phase 3 테스트 완료!\n');
