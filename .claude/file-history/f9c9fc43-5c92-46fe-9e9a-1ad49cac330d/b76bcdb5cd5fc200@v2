test "tokenize comparison operators" {
    const source = "a == b != c < d <= e > f >= g";
    var tokenizer = Tokenizer.init(source);

    var tokens = std.ArrayList(Token).init(std.testing.allocator);
    defer tokens.deinit();

    while (true) {
        const token = tokenizer.nextToken();
        try tokens.append(token);
        if (token.tag == .eof) break;
    }

    try std.testing.expectEqual(tokens.items[1].tag, .equal_equal);
    try std.testing.expectEqual(tokens.items[3].tag, .bang_equal);
    try std.testing.expectEqual(tokens.items[5].tag, .less);
    try std.testing.expectEqual(tokens.items[7].tag, .less_equal);
    try std.testing.expectEqual(tokens.items[9].tag, .greater);
    try std.testing.expectEqual(tokens.items[11].tag, .greater_equal);
}

test "tokenize comments" {
    const source = "a // this is a comment\nb";
    var tokenizer = Tokenizer.init(source);

    var tokens = std.ArrayList(Token).init(std.testing.allocator);
    defer tokens.deinit();

    while (true) {
        const token = tokenizer.nextToken();
        try tokens.append(token);
        if (token.tag == .eof) break;
    }

    // a, b, eof (comment is skipped)
    try std.testing.expect(tokens.items.len == 3);
    try std.testing.expectEqual(tokens.items[0].tag, .identifier);
    try std.testing.expectEqual(tokens.items[1].tag, .identifier);
}

test "token location tracking" {
    const source = "a\nb";
    var tokenizer = Tokenizer.init(source);

    const token_a = tokenizer.nextToken();
    try std.testing.expectEqual(token_a.loc.line, 1);

    const token_b = tokenizer.nextToken();
    try std.testing.expectEqual(token_b.loc.line, 2);
}
