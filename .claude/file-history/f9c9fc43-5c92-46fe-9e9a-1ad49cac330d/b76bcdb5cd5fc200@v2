// 🦎 Mini Zig Compiler - Tokenizer Tests
// test/tokenizer_test.zig: Tokenizer 단위 테스트

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Token = @import("../src/tokenizer.zig").Token;

test "tokenize simple addition" {
    const source = "1 + 2";
    var tokenizer = Tokenizer.init(source);

    var tokens = std.ArrayList(Token).init(std.testing.allocator);
    defer tokens.deinit();

    while (true) {
        const token = tokenizer.nextToken();
        try tokens.append(token);
        if (token.tag == .eof) break;
    }

    try std.testing.expect(tokens.items.len == 4); // 1, +, 2, eof
    try std.testing.expectEqual(tokens.items[0].tag, .integer);
    try std.testing.expectEqual(tokens.items[1].tag, .plus);
    try std.testing.expectEqual(tokens.items[2].tag, .integer);
    try std.testing.expectEqual(tokens.items[3].tag, .eof);
}

test "tokenize function declaration" {
    const source = "fn add(a: i32, b: i32) -> i32 { return a + b; }";
    var tokenizer = Tokenizer.init(source);

    var tokens = std.ArrayList(Token).init(std.testing.allocator);
    defer tokens.deinit();

    while (true) {
        const token = tokenizer.nextToken();
        try tokens.append(token);
        if (token.tag == .eof) break;
    }

    // fn add ( a : i32 , b : i32 ) -> i32 { return a + b ; }
    try std.testing.expect(tokens.items.len > 20);
    try std.testing.expectEqual(tokens.items[0].tag, .fn_);
    try std.testing.expectEqual(tokens.items[1].tag, .identifier);
    try std.testing.expectEqual(tokens.items[2].tag, .lparen);
}

test "tokenize string literal" {
    const source = "\"hello world\"";
    var tokenizer = Tokenizer.init(source);

    const token = tokenizer.nextToken();
    try std.testing.expectEqual(token.tag, .string);
    try std.testing.expectEqualStrings(token.lexeme(source), "\"hello world\"");
}

test "tokenize integer literal" {
    const source = "42";
    var tokenizer = Tokenizer.init(source);

    const token = tokenizer.nextToken();
    try std.testing.expectEqual(token.tag, .integer);
    try std.testing.expectEqualStrings(token.lexeme(source), "42");
}

test "tokenize keywords" {
    const source = "const x = 10";
    var tokenizer = Tokenizer.init(source);

    var tokens = std.ArrayList(Token).init(std.testing.allocator);
    defer tokens.deinit();

    while (true) {
        const token = tokenizer.nextToken();
        try tokens.append(token);
        if (token.tag == .eof) break;
    }

    try std.testing.expectEqual(tokens.items[0].tag, .const_);
    try std.testing.expectEqual(tokens.items[1].tag, .identifier);
    try std.testing.expectEqual(tokens.items[2].tag, .equal);
    try std.testing.expectEqual(tokens.items[3].tag, .integer);
