// 🦎 Zig Learning - Step 1: Functions
// functions.zig: 함수 기초 학습

const std = @import("std");

// 1️⃣ 가장 간단한 함수: 반환값 없음
fn greet() void {
    const stdout = std.io.getStdOut().writer();
    stdout.print("Hello from function!\n", .{}) catch unreachable;
}

// 2️⃣ 파라미터 있는 함수
fn add(a: i32, b: i32) i32 {
    return a + b;
}

// 3️⃣ 여러 파라미터
fn multiply(x: f64, y: f64) f64 {
    return x * y;
}

// 4️⃣ 배열을 받는 함수
fn sum_array(numbers: []const i32) i32 {
    var total: i32 = 0;
    for (numbers) |num| {
        total += num;
    }
    return total;
}

// 5️⃣ 포인터를 받는 함수
fn increment_pointer(ptr: *i32) void {
    ptr.* += 1;  // 포인터 역참조 후 1 증가
}

// 6️⃣ Optional 반환값
fn safe_divide(dividend: i32, divisor: i32) ?i32 {
    if (divisor == 0) {
        return null;
    }
    return dividend / divisor;
}

// 7️⃣ Error 처리 (에러 유니온)
fn risky_operation(value: i32) !void {
    if (value < 0) {
        return error.NegativeValue;
    }
    const stdout = std.io.getStdOut().writer();
    stdout.print("Operation succeeded with value: {}\n", .{value}) catch unreachable;
}

// 8️⃣ 제너릭 함수 (모든 타입에서 동작)
fn identity(value: anytype) @TypeOf(value) {
    return value;
}

pub fn main() void {
    const stdout = std.io.getStdOut().writer();

    // 함수 호출 테스트
    stdout.print("=== Function Calls ===\n", .{}) catch unreachable;

    // 1. void 함수
    greet();

    // 2. 정수 덧셈
    const sum = add(5, 3);
    stdout.print("add(5, 3) = {}\n", .{sum}) catch unreachable;

    // 3. 실수 곱셈
    const product = multiply(2.5, 4.0);
    stdout.print("multiply(2.5, 4.0) = {}\n", .{product}) catch unreachable;

    // 4. 배열 합계
    const arr: [4]i32 = .{10, 20, 30, 40};
    const array_sum = sum_array(&arr);
    stdout.print("sum_array([10,20,30,40]) = {}\n", .{array_sum}) catch unreachable;

    // 5. 포인터를 통한 값 수정
    var counter: i32 = 5;
    stdout.print("Before increment: counter = {}\n", .{counter}) catch unreachable;
    increment_pointer(&counter);
    stdout.print("After increment: counter = {}\n", .{counter}) catch unreachable;

    // 6. Optional 반환값
    stdout.print("\n=== Optional Returns ===\n", .{}) catch unreachable;
    if (safe_divide(10, 2)) |result| {
        stdout.print("10 / 2 = {}\n", .{result}) catch unreachable;
    }

    if (safe_divide(10, 0)) |result| {
        stdout.print("10 / 0 = {}\n", .{result}) catch unreachable;
    } else {
        stdout.print("10 / 0 = (division by zero)\n", .{}) catch unreachable;
    }

    // 7. Error 처리
    stdout.print("\n=== Error Handling ===\n", .{}) catch unreachable;
    risky_operation(42) catch |err| {
        stdout.print("Error: {}\n", .{err}) catch unreachable;
    };

    risky_operation(-5) catch |err| {
        stdout.print("Error: {}\n", .{err}) catch unreachable;
    };

    // 8. 제너릭 함수
    stdout.print("\n=== Generic Functions ===\n", .{}) catch unreachable;
    const int_result = identity(100);
    const float_result = identity(3.14);
    const string_result = identity("Zig");

    stdout.print("identity(100) = {}\n", .{int_result}) catch unreachable;
    stdout.print("identity(3.14) = {}\n", .{float_result}) catch unreachable;
    stdout.print("identity(\"Zig\") = {}\n", .{string_result}) catch unreachable;
}
