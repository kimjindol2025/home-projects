## 1.4 함수

### 기본 함수

```zig
fn add(a: i32, b: i32) i32 {
    return a + b;
}
```

### 함수의 특징

```zig
// 1. 반환값 없음
fn print_hello() void {
    // ...
}

// 2. Optional 반환값
fn safe_divide(a: i32, b: i32) ?i32 {
    if (b == 0) return null;
    return a / b;
}

// 3. Error 처리
fn risky_op() !void {
    if (something_wrong) {
        return error.SomethingWrong;
    }
}

// 4. 제너릭 (anytype)
fn identity(value: anytype) @TypeOf(value) {
    return value;
}

// 5. 포인터 수정
fn increment(ptr: *i32) void {
    ptr.* += 1;  // ptr.* = 역참조
}
```

