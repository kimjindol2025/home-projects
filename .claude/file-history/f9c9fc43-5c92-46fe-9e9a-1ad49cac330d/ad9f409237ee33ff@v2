    /// 핵심 함수들
    pub fn analyzeFnBody(self: *Sema, block: *Block) !void { ... }
    pub fn analyzeBodyInner(self: *Sema, block: *Block) !void { ... }
    pub fn resolveType(self: *Sema, zir_ref: Zir.Ref) !Type { ... }
    pub fn resolveValue(self: *Sema, zir_ref: Zir.Ref) !Value { ... }
