// 🦎 Zig Learning - Step 2: Variables & Constants
// variables.zig: 변수 선언의 10가지 패턴

const std = @import("std");

pub fn main() void {
    const stdout = std.io.getStdOut().writer();

    // 1️⃣ const: 기본 불변 바인딩
    stdout.print("=== 1. const (Immutable) ===\n", .{}) catch unreachable;
    const x: i32 = 42;
    stdout.print("const x: i32 = 42; => x = {}\n", .{x}) catch unreachable;
    // x = 100;  // ❌ 컴파일 에러: const는 변경 불가

    // 2️⃣ var: 변경 가능한 변수
    stdout.print("\n=== 2. var (Mutable) ===\n", .{}) catch unreachable;
    var counter: i32 = 0;
    stdout.print("var counter: i32 = 0; => counter = {}\n", .{counter}) catch unreachable;
    counter += 1;
    stdout.print("After counter += 1; => counter = {}\n", .{counter}) catch unreachable;

    // 3️⃣ 타입 추론 (const)
    stdout.print("\n=== 3. Type Inference (const) ===\n", .{}) catch unreachable;
    const inferred_int = 100;           // i32로 추론
    const inferred_float = 3.14;        // f64로 추론
    const inferred_bool = true;         // bool로 추론
    stdout.print("inferred_int: {}, inferred_float: {}, inferred_bool: {}\n",
        .{inferred_int, inferred_float, inferred_bool}) catch unreachable;

    // 4️⃣ 타입 추론 (var)
    stdout.print("\n=== 4. Type Inference (var) ===\n", .{}) catch unreachable;
    var mutable_int = 50;
    var mutable_float = 2.71;
    stdout.print("mutable_int: {}, mutable_float: {}\n",
        .{mutable_int, mutable_float}) catch unreachable;

    // 5️⃣ 명시적 타입 (다양한 정수 크기)
    stdout.print("\n=== 5. Explicit Sized Integers ===\n", .{}) catch unreachable;
    const a: i8 = 127;
    const b: i16 = 32767;
    const c: i32 = 2147483647;
    const d: i64 = 9223372036854775807;
    const e: u8 = 255;
    const f: u16 = 65535;
    const g: u32 = 4294967295;
    stdout.print("i8: {}, i16: {}, i32: {}, i64: {}\n", .{a, b, c, d}) catch unreachable;
    stdout.print("u8: {}, u16: {}, u32: {}\n", .{e, f, g}) catch unreachable;

    // 6️⃣ usize (포인터 크기)
    stdout.print("\n=== 6. usize (Platform-Dependent) ===\n", .{}) catch unreachable;
    const size_var: usize = 1024;
    stdout.print("usize size_var = {}; (platform-dependent)\n", .{size_var}) catch unreachable;

    // 7️⃣ 부동소수점
    stdout.print("\n=== 7. Floating Point Types ===\n", .{}) catch unreachable;
    const f32_val: f32 = 3.14159;
    const f64_val: f64 = 2.71828;
    stdout.print("f32: {}, f64: {}\n", .{f32_val, f64_val}) catch unreachable;

    // 8️⃣ 배열 변수
    stdout.print("\n=== 8. Array Variables ===\n", .{}) catch unreachable;
    const arr_const: [5]i32 = .{1, 2, 3, 4, 5};
    var arr_mutable: [3]i32 = .{10, 20, 30};
    arr_mutable[0] = 100;  // 배열 요소는 변경 가능 (var 배열)
    stdout.print("const array: ", .{}) catch unreachable;
    for (arr_const) |v| stdout.print("{} ", .{v}) catch unreachable;
    stdout.print("\nmutable array: ", .{}) catch unreachable;
    for (arr_mutable) |v| stdout.print("{} ", .{v}) catch unreachable;
    stdout.print("\n", .{}) catch unreachable;

    // 9️⃣ 포인터 변수
    stdout.print("\n=== 9. Pointer Variables ===\n", .{}) catch unreachable;
    var original: i32 = 42;
    const ptr: *i32 = &original;  // const 포인터 (가리키는 값은 변경 가능)
    stdout.print("original: {}, via pointer: {}\n", .{original, ptr.*}) catch unreachable;
    ptr.* = 100;  // 포인터를 통해 값 변경
    stdout.print("After ptr.* = 100; original: {}\n", .{original}) catch unreachable;

    // 🔟 선택적 초기화
    stdout.print("\n=== 10. Optional Initialization ===\n", .{}) catch unreachable;
    var maybe_value: ?i32 = 42;
    stdout.print("maybe_value: {}\n", .{maybe_value}) catch unreachable;
    maybe_value = null;
    if (maybe_value) |v| {
        stdout.print("Value: {}\n", .{v}) catch unreachable;
    } else {
        stdout.print("maybe_value is null\n", .{}) catch unreachable;
    }

    // 11️⃣ 언더스코어 (무시되는 변수)
    stdout.print("\n=== 11. Underscore (Ignore) ===\n", .{}) catch unreachable;
    const _ = 999;  // 사용하지 않는 값 무시 (컴파일 경고 제거)
    stdout.print("Underscore used for unused values\n", .{}) catch unreachable;

    // 1️⃣2️⃣ 변수 재할당 (shadowing)
    stdout.print("\n=== 12. Variable Shadowing ===\n", .{}) catch unreachable;
    {
        const shadowed = 10;
        stdout.print("Inner scope: shadowed = {}\n", .{shadowed}) catch unreachable;
    }
    const shadowed = 20;  // 다른 변수, 같은 이름
    stdout.print("Outer scope: shadowed = {}\n", .{shadowed}) catch unreachable;
}
