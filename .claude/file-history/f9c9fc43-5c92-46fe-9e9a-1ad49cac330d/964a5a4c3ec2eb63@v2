// 🦎 Zig Learning - Step 3: Memory Management - Pointers
// pointers.zig: 포인터 패턴 (8가지)

const std = @import("std");

pub fn main() void {
    const stdout = std.io.getStdOut().writer();

    // 1️⃣ 기본 포인터
    stdout.print("=== 1. Basic Pointer ===\n", .{}) catch unreachable;
    var x: i32 = 42;
    const ptr: *i32 = &x;
    stdout.print("x = {}, &x = {*}, *ptr = {}\n", .{x, ptr, ptr.*}) catch unreachable;

    // 2️⃣ 포인터 역참조로 값 변경
    stdout.print("\n=== 2. Dereference & Modify ===\n", .{}) catch unreachable;
    ptr.* = 100;
    stdout.print("After ptr.* = 100; x = {}\n", .{x}) catch unreachable;

    // 3️⃣ 배열 포인터
    stdout.print("\n=== 3. Array Pointer ===\n", .{}) catch unreachable;
    var arr: [5]i32 = .{1, 2, 3, 4, 5};
    const arr_ptr: *[5]i32 = &arr;
    stdout.print("arr_ptr.*[0] = {}\n", .{arr_ptr.*[0]}) catch unreachable;
    arr_ptr.*[0] = 999;
    stdout.print("After modification: arr[0] = {}\n", .{arr[0]}) catch unreachable;

    // 4️⃣ 포인터의 포인터 (이중 포인터)
    stdout.print("\n=== 4. Pointer to Pointer ===\n", .{}) catch unreachable;
    var value: i32 = 42;
    const ptr1: *i32 = &value;
    const ptr2: **i32 = &ptr1;
    stdout.print("value = {}, *ptr2 = {}, **ptr2 = {}\n", .{value, ptr2.*, ptr2.*.*}) catch unreachable;

    // 5️⃣ const 포인터 vs var 포인터
    stdout.print("\n=== 5. const vs var Pointer ===\n", .{}) catch unreachable;
    var y: i32 = 10;
    var z: i32 = 20;

    // const 포인터: 가리키는 것은 바뀔 수 없음
    const const_ptr: *i32 = &y;
    const_ptr.* = 15;  // ✅ 값 변경 가능
    // const_ptr = &z;  // ❌ 포인터 자체는 변경 불가

    // var 포인터: 가리키는 것을 바꿀 수 있음
    var var_ptr: *i32 = &y;
    var_ptr.* = 25;    // ✅ 값 변경 가능
    var_ptr = &z;      // ✅ 포인터도 변경 가능

    stdout.print("const_ptr.*: {}, var_ptr.*: {}\n", .{const_ptr.*, var_ptr.*}) catch unreachable;

    // 6️⃣ 포인터와 함수 인자
    stdout.print("\n=== 6. Pointer as Function Argument ===\n", .{}) catch unreachable;
    var counter: i32 = 0;
    increment(&counter);
    stdout.print("After increment: counter = {}\n", .{counter}) catch unreachable;

    // 7️⃣ 슬라이스 (동적 포인터)
    stdout.print("\n=== 7. Slice (Dynamic Pointer) ===\n", .{}) catch unreachable;
    var numbers: [10]i32 = undefined;
    for (0..10) |i| {
        numbers[i] = @intCast(i);
    }
    const slice: []i32 = &numbers;
    stdout.print("slice.len = {}\n", .{slice.len}) catch unreachable;
    for (slice) |num| {
        stdout.print("{} ", .{num}) catch unreachable;
    }
    stdout.print("\n", .{}) catch unreachable;

    // 8️⃣ 포인터 비교
    stdout.print("\n=== 8. Pointer Comparison ===\n", .{}) catch unreachable;
    const ptr_a: *i32 = &y;
    const ptr_b: *i32 = &y;
    const ptr_c: *i32 = &z;

    stdout.print("ptr_a == ptr_b: {}\n", .{ptr_a == ptr_b}) catch unreachable;
    stdout.print("ptr_a == ptr_c: {}\n", .{ptr_a == ptr_c}) catch unreachable;
}

fn increment(ptr: *i32) void {
    ptr.* += 1;
}
