## 통합 파이프라인 예시

```zig
// main.zig

const source =
    \\ fn add(a: i32, b: i32) i32 {
    \\     return a + b;
    \\ }
;

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    // Step 1: Tokenize
    var tokenizer = Tokenizer.init(source);
    var tokens = std.ArrayList(Token).init(allocator);
    while (true) {
        const token = tokenizer.nextToken();
        try tokens.append(token);
        if (token.tag == .eof) break;
    }

    // Step 2: Parse
    var parser = Parser.init(tokens.items);
    const ast = try parser.parse(allocator);

    // Step 3: AstGen
    var astgen = AstGen.init(allocator);
    const zir = try astgen.genProgram(ast);

    // Step 4: Sema
    var sema = Sema.init(&zir, allocator);
    try sema.analyze();

    // Step 5: Codegen
    const llvm_ir = try generateLLVM(&zir);

    // Step 6: Link (사용 LLVM)
    try std.fs.cwd().writeFile("output.ll", llvm_ir);
    _ = try std.process.run(.{
        .allocator = allocator,
        .argv = &.{ "llc", "output.ll", "-o", "output.s" },
    });

    std.debug.print("Compilation successful!\n", .{});
}
```

