## 5️⃣ CODEGEN (LLVM 또는 C)

### LLVM 백엔드 (쉬운 버전)

```zig
pub fn generateLLVM(zir: *const Zir) ![]const u8 {
    var output = std.ArrayList(u8).init(allocator);

    try output.appendSlice("define i32 @main() {\n");
    try output.appendSlice("entry:\n");

    for (zir.instructions.items, 0..) |inst, idx| {
        switch (inst) {
            .load_int => |data| {
                try output.writer().print("  %{} = add i32 0, {}\n", .{idx, data.value});
            },

            .add => |data| {
                try output.writer().print("  %{} = add i32 %{}, %{}\n", .{idx, data.lhs, data.rhs});
            },

            .return_val => |data| {
                try output.writer().print("  ret i32 %{}\n", .{data.value});
            },

            else => {},
        }
    }

    try output.appendSlice("}\n");

    return output.items;
}
```

### C 백엔드 (더 쉬운 버전)

```zig
pub fn generateC(zir: *const Zir) ![]const u8 {
    var output = std.ArrayList(u8).init(allocator);

    try output.appendSlice("#include <stdio.h>\n\n");
    try output.appendSlice("int main() {\n");

    for (zir.instructions.items, 0..) |inst, idx| {
        switch (inst) {
            .load_int => |data| {
                try output.writer().print("  int v{} = {};\n", .{idx, data.value});
            },

            .add => |data| {
                try output.writer().print("  int v{} = v{} + v{};\n", .{idx, data.lhs, data.rhs});
            },

            .return_val => |data| {
                try output.writer().print("  return v{};\n", .{data.value});
            },

            else => {},
        }
    }

    try output.appendSlice("}\n");

    return output.items;
}
