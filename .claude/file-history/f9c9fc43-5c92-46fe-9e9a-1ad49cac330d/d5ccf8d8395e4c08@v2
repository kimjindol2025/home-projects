## 2️⃣ PARSE (AST 생성)

### 공식 Zig Parser 구조

```zig
// zig-official/src/Ast.zig

pub const Node = struct {
    tag: Tag,

    pub const Tag = enum {
        // Top level
        root,

        // Declarations
        fn_decl,
        var_decl,
        const_decl,

        // Statements
        return_stmt,
        if_stmt,
        while_stmt,
        for_stmt,
        assignment,

        // Expressions
        binary_op,
        unary_op,
        call,
        member_access,
        integer_literal,
        identifier,

        // Control
        block,

        // Types
        primitive_type,
        pointer_type,
        array_type,
        function_type,
    };
};

pub const Parser = struct {
    tokens: []const Token,
    current: usize,

    pub fn init(tokens: []const Token) Parser {
        return .{ .tokens = tokens, .current = 0 };
    }

    pub fn parse(self: *Parser, allocator: std.mem.Allocator) !Ast {
        var declarations = std.ArrayList(Node).init(allocator);

        while (!self.isAtEnd()) {
            try declarations.append(try self.parseDeclaration());
        }

        return Ast{
            .nodes = declarations.items,
        };
    }

    fn parseDeclaration(self: *Parser) !Node {
        if (self.match(.fn)) {
            return self.parseFnDecl();
        } else if (self.match(.const)) {
            return self.parseConstDecl();
        } else if (self.match(.var)) {
            return self.parseVarDecl();
        } else {
            return self.parseStatement();
        }
    }

    fn parseFnDecl(self: *Parser) !Node {
        const name = try self.consume(.identifier, "Expected function name");
        try self.consume(.lparen, "Expected '(' after function name");

        var params = std.ArrayList(Param).init(self.allocator);
        if (!self.check(.rparen)) {
            while (true) {
                const param_name = try self.consume(.identifier, "Expected parameter name");
                try self.consume(.colon, "Expected ':' in parameter");
                const param_type = try self.parseType();

                try params.append(.{ .name = param_name, .type = param_type });

                if (!self.match(.comma)) break;
            }
        }

        try self.consume(.rparen, "Expected ')' after parameters");

        var return_type: ?Type = null;
        if (self.match(.arrow)) {
            return_type = try self.parseType();
        }

        try self.consume(.lbrace, "Expected '{' for function body");
        const body = try self.parseBlock();

        return Node{
            .tag = .fn_decl,
            .data = .{ .fn_decl = .{
                .name = name,
                .params = params.items,
                .return_type = return_type,
                .body = body,
            } },
        };
    }

    fn parseExpression(self: *Parser) !Node {
        return self.parseAssignment();
    }

    fn parseAssignment(self: *Parser) !Node {
        var expr = try self.parseOr();

        if (self.match(.equal)) {
            const value = try self.parseExpression();
            expr = Node{
                .tag = .assignment,
                .data = .{ .assignment = .{
                    .target = expr,
                    .value = value,
                } },
            };
        }

        return expr;
    }

    fn parseOr(self: *Parser) !Node {
        var expr = try self.parseAnd();

        while (self.match(.or)) {
            const op = self.previous().tag;
            const right = try self.parseAnd();
            expr = Node{
                .tag = .binary_op,
                .data = .{ .binary_op = .{
                    .left = expr,
                    .op = op,
                    .right = right,
                } },
            };
        }

        return expr;
    }

    // ... parseAnd, parseEquality, parseComparison, etc.

    fn parseAdditive(self: *Parser) !Node {
        var expr = try self.parseMultiplicative();

        while (self.match(.plus) or self.match(.minus)) {
            const op = self.previous().tag;
            const right = try self.parseMultiplicative();
            expr = Node{
                .tag = .binary_op,
                .data = .{ .binary_op = .{
                    .left = expr,
                    .op = op,
                    .right = right,
                } },
            };
        }

        return expr;
    }

    fn parseMultiplicative(self: *Parser) !Node {
        var expr = try self.parseUnary();

        while (self.match(.star) or self.match(.slash)) {
            const op = self.previous().tag;
            const right = try self.parseUnary();
            expr = Node{
                .tag = .binary_op,
                .data = .{ .binary_op = .{
                    .left = expr,
                    .op = op,
                    .right = right,
                } },
            };
        }

        return expr;
    }

    fn parseUnary(self: *Parser) !Node {
        if (self.match(.minus) or self.match(.bang)) {
            const op = self.previous().tag;
            const expr = try self.parseUnary();
            return Node{
                .tag = .unary_op,
                .data = .{ .unary_op = .{
                    .op = op,
                    .expr = expr,
                } },
            };
        }

        return self.parseCall();
    }

    fn parseCall(self: *Parser) !Node {
        var expr = try self.parsePrimary();

        while (self.match(.lparen)) {
            var args = std.ArrayList(Node).init(self.allocator);

            if (!self.check(.rparen)) {
                while (true) {
                    try args.append(try self.parseExpression());
                    if (!self.match(.comma)) break;
                }
            }

            try self.consume(.rparen, "Expected ')' after arguments");

            expr = Node{
                .tag = .call,
                .data = .{ .call = .{
                    .callee = expr,
                    .args = args.items,
                } },
            };
        }

        return expr;
    }

    fn parsePrimary(self: *Parser) !Node {
        if (self.match(.integer)) {
            const token = self.previous();
            const value = try std.fmt.parseInt(i64, self.source[token.start..token.end], 10);
            return Node{
                .tag = .integer_literal,
                .data = .{ .integer = value },
            };
        }

        if (self.match(.identifier)) {
            const token = self.previous();
            const name = self.source[token.start..token.end];
            return Node{
                .tag = .identifier,
                .data = .{ .identifier = name },
            };
        }

        if (self.match(.lparen)) {
            const expr = try self.parseExpression();
            try self.consume(.rparen, "Expected ')' after expression");
            return expr;
        }

        return error.UnexpectedToken;
    }
};

// Helper methods
fn match(self: *Parser, tag: Token.Tag) bool {
    if (self.check(tag)) {
        self.advance();
        return true;
    }
    return false;
}

fn check(self: *Parser, tag: Token.Tag) bool {
    if (self.isAtEnd()) return false;
    return self.peek().tag == tag;
}

fn advance(self: *Parser) Token {
    if (!self.isAtEnd()) self.current += 1;
    return self.previous();
}

fn previous(self: *Parser) Token {
    return self.tokens[self.current - 1];
}

fn peek(self: *Parser) Token {
    return self.tokens[self.current];
}

fn isAtEnd(self: *Parser) bool {
    return self.peek().tag == .eof;
}

fn consume(self: *Parser, tag: Token.Tag, msg: []const u8) !Token {
    if (self.check(tag)) {
        return self.advance();
    }
    return error.ParseError;
}
