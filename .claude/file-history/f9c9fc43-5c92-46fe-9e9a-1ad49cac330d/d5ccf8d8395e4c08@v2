# Zig 컴파일러 파이프라인 상세 분석

## 1️⃣ TOKENIZE (Lexing)

### 공식 Zig Tokenizer 구조 분석

```zig
// zig-official/src/Tokenizer.zig의 실제 구조

pub const Token = struct {
    tag: Tag,
    loc: Loc,

    pub const Tag = enum {
        // Literals
        integer,
        float,
        string,
        char_literal,

        // Keywords
        fn,
        const,
        var,
        if,
        else,
        while,
        for,
        return,
        struct,
        enum,
        union,
        error,
        try,
        catch,
        comptime,
        inline,

        // Operators
        plus,
        minus,
        star,
        slash,
        percent,
        equal,
        equal_equal,
        bang_equal,
        less,
        greater,
        less_equal,
        greater_equal,
        ampersand,
        pipe,
        caret,
        tilde,
        lshift,
        rshift,

        // Delimiters
        lparen,
        rparen,
        lbrace,
        rbrace,
        lbracket,
        rbracket,
        semicolon,
        comma,
        colon,
        dot,
        arrow,          // =>
        double_arrow,   // =>

        // Special
        eof,
        invalid,
    };
};

pub const Tokenizer = struct {
    buffer: []const u8,
    index: usize,

    pub fn init(buffer: []const u8) Tokenizer {
        return .{
            .buffer = buffer,
            .index = 0,
        };
    }

    pub fn next(self: *Tokenizer) Token {
        while (self.index < self.buffer.len) {
            const c = self.buffer[self.index];

            // Skip whitespace
            if (isWhitespace(c)) {
                self.index += 1;
                continue;
            }

            // Skip comments
            if (c == '/' and self.peek() == '/') {
                while (self.index < self.buffer.len and self.buffer[self.index] != '\n') {
                    self.index += 1;
                }
                continue;
            }

            // Numbers
            if (isDigit(c)) {
                return self.scanNumber();
            }

            // Identifiers & Keywords
            if (isIdentifierStart(c)) {
                return self.scanIdentifier();
            }

            // Strings
            if (c == '"') {
                return self.scanString();
            }

            // Operators & Delimiters
            return self.scanOperator();
        }

        return Token{ .tag = .eof, .loc = .{ .line = self.line, .column = self.column } };
    }

    fn scanNumber(self: *Tokenizer) Token {
        var start = self.index;
        while (self.index < self.buffer.len and isDigit(self.buffer[self.index])) {
            self.index += 1;
        }

        // Check for float
        if (self.buffer[self.index] == '.') {
            self.index += 1;
            while (self.index < self.buffer.len and isDigit(self.buffer[self.index])) {
                self.index += 1;
            }
            return Token{ .tag = .float, .loc = .{ .line = self.line, .column = self.column } };
        }

        return Token{ .tag = .integer, .loc = .{ .line = self.line, .column = self.column } };
    }

    fn scanIdentifier(self: *Tokenizer) Token {
        var start = self.index;
        while (self.index < self.buffer.len and isIdentifierContinue(self.buffer[self.index])) {
            self.index += 1;
        }

        const text = self.buffer[start..self.index];
        const tag = switch (hashKeyword(text)) {
            .fn => .fn,
            .const => .const,
            .var => .var,
            .if => .if,
            .else => .else,
            .while => .while,
            // ... etc
            else => .identifier,
        };

        return Token{ .tag = tag, .loc = .{ .line = self.line, .column = self.column } };
    }
};

fn isWhitespace(c: u8) bool {
    return c == ' ' or c == '\t' or c == '\n' or c == '\r';
}

fn isDigit(c: u8) bool {
    return c >= '0' and c <= '9';
}

fn isIdentifierStart(c: u8) bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_';
}

fn isIdentifierContinue(c: u8) bool {
    return isIdentifierStart(c) or isDigit(c);
}
```

### 구현 전략 (Mini Zig)

```zig
// my-compiler/src/Tokenizer.zig

pub const Token = struct {
    tag: Tag,
    start: usize,
    end: usize,

    pub const Tag = enum {
        // Basics (필수 20개)
        integer,
        identifier,
        fn,
        const,
        var,
        if,
        else,
        while,
        for,
        return,
        lparen,
        rparen,
        lbrace,
        rbrace,
        semicolon,
        equal,
        plus,
        minus,
        star,
        slash,
        eof,
    };
};

pub const Tokenizer = struct {
    source: []const u8,
    pos: usize,

    pub fn init(source: []const u8) Tokenizer {
        return .{ .source = source, .pos = 0 };
    }

    pub fn nextToken(self: *Tokenizer) Token {
        // Skip whitespace
        while (self.pos < self.source.len and isSpace(self.source[self.pos])) {
            self.pos += 1;
        }

        if (self.pos >= self.source.len) {
            return Token{ .tag = .eof, .start = self.pos, .end = self.pos };
        }

        const start = self.pos;
        const c = self.source[self.pos];

        // Number
        if (isDigit(c)) {
            while (self.pos < self.source.len and isDigit(self.source[self.pos])) {
                self.pos += 1;
            }
            return Token{ .tag = .integer, .start = start, .end = self.pos };
        }

        // Identifier/Keyword
        if (isAlpha(c)) {
            while (self.pos < self.source.len and (isAlpha(self.source[self.pos]) or isDigit(self.source[self.pos]))) {
                self.pos += 1;
            }
            const text = self.source[start..self.pos];
            const tag = getKeywordTag(text) orelse .identifier;
            return Token{ .tag = tag, .start = start, .end = self.pos };
        }

        // Operators
        self.pos += 1;
        const tag: Token.Tag = switch (c) {
            '(' => .lparen,
            ')' => .rparen,
            '{' => .lbrace,
            '}' => .rbrace,
            ';' => .semicolon,
            '=' => .equal,
            '+' => .plus,
            '-' => .minus,
            '*' => .star,
            '/' => .slash,
            else => .invalid,
        };

        return Token{ .tag = tag, .start = start, .end = self.pos };
    }
};

fn getKeywordTag(text: []const u8) ?Token.Tag {
    return switch (hashKeyword(text)) {
        0x12345 => .fn,
        0x12346 => .const,
        // ...
        else => null,
    };
}
