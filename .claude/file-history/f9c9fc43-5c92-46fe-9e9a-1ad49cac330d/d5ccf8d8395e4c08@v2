## 4️⃣ SEMA (매우 간단한 버전)

```zig
// Mini Sema (타입 체크만)

pub const Type = enum {
    i32,
    i64,
    f64,
    bool,
    void,
};

pub const Sema = struct {
    zir: *const Zir,
    types: std.ArrayList(Type),
    allocator: std.mem.Allocator,

    pub fn init(zir: *const Zir, allocator: std.mem.Allocator) Sema {
        return .{
            .zir = zir,
            .types = std.ArrayList(Type).init(allocator),
            .allocator = allocator,
        };
    }

    pub fn analyzeInstruction(self: *Sema, inst_idx: Zir.Ref) !Type {
        const inst = self.zir.instructions.items[inst_idx];

        return switch (inst) {
            .load_int => .i32,

            .add, .sub, .mul, .div => {
                const lhs_type = try self.analyzeInstruction(inst.*.lhs);
                const rhs_type = try self.analyzeInstruction(inst.*.rhs);

                if (lhs_type != rhs_type) {
                    return error.TypeMismatch;
                }

                return lhs_type;
            },

            else => .void,
        };
    }
};
