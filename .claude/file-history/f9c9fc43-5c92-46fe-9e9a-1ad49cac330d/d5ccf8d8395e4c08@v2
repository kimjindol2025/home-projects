## 3️⃣ ASTGEN (ZIR 생성)

```zig
// Simplified AstGen

pub const Zir = struct {
    instructions: std.ArrayList(Instruction),
    extra: std.ArrayList(u32),

    pub const Instruction = union(enum) {
        add: struct { lhs: Ref, rhs: Ref },
        sub: struct { lhs: Ref, rhs: Ref },
        mul: struct { lhs: Ref, rhs: Ref },
        div: struct { lhs: Ref, rhs: Ref },

        load_int: struct { value: i64 },
        load_var: struct { name: []const u8 },
        store_var: struct { name: []const u8, value: Ref },

        call: struct { callee: Ref, args: []Ref },
        return_val: struct { value: Ref },

        if_stmt: struct { cond: Ref, then_body: Ref, else_body: ?Ref },
        while_loop: struct { cond: Ref, body: Ref },

        block: struct { stmts: []Ref },

        fn_decl: struct {
            name: []const u8,
            params: [][]const u8,
            body: Ref,
        },
    };

    pub const Ref = u32; // Index into instructions
};

pub const AstGen = struct {
    zir: *Zir,
    allocator: std.mem.Allocator,

    pub fn init(allocator: std.mem.Allocator) AstGen {
        var zir = allocator.create(Zir) catch unreachable;
        zir.* = .{
            .instructions = std.ArrayList(Zir.Instruction).init(allocator),
            .extra = std.ArrayList(u32).init(allocator),
        };
        return AstGen{
            .zir = zir,
            .allocator = allocator,
        };
    }

    pub fn genNode(self: *AstGen, node: Node) !Zir.Ref {
        return switch (node.tag) {
            .integer_literal => {
                try self.zir.instructions.append(.{
                    .load_int = .{ .value = node.data.integer },
                });
                return self.zir.instructions.items.len - 1;
            },

            .binary_op => {
                const left = try self.genNode(node.data.binary_op.left);
                const right = try self.genNode(node.data.binary_op.right);

                const inst: Zir.Instruction = switch (node.data.binary_op.op) {
                    .plus => .{ .add = .{ .lhs = left, .rhs = right } },
                    .minus => .{ .sub = .{ .lhs = left, .rhs = right } },
                    .star => .{ .mul = .{ .lhs = left, .rhs = right } },
                    .slash => .{ .div = .{ .lhs = left, .rhs = right } },
                    else => return error.UnknownOp,
                };

                try self.zir.instructions.append(inst);
                return self.zir.instructions.items.len - 1;
            },

            .call => {
                const callee = try self.genNode(node.data.call.callee);
                var args = std.ArrayList(Zir.Ref).init(self.allocator);
                for (node.data.call.args) |arg| {
                    try args.append(try self.genNode(arg));
                }

                try self.zir.instructions.append(.{
                    .call = .{ .callee = callee, .args = args.items },
                });
                return self.zir.instructions.items.len - 1;
            },

            else => return error.UnhandledNode,
        };
    }
};
