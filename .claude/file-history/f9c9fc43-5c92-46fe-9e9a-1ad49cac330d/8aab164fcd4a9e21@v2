// 🦎 Mini Zig Compiler - Parser Tests
// test/parser_test.zig: Parser 단위 테스트

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const Token = @import("../src/tokenizer.zig").Token;

fn tokenize(source: []const u8, allocator: std.mem.Allocator) ![]Token {
    var tokenizer = Tokenizer.init(source);
    var tokens = std.ArrayList(Token).init(allocator);

    while (true) {
        const token = tokenizer.nextToken();
        try tokens.append(token);
        if (token.tag == .eof) break;
    }

    return tokens.items;
}

test "parse simple integer" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "42;";
    const tokens = try tokenize(source, allocator);
    defer allocator.free(tokens);

    var parser = Parser.init(tokens, source, allocator);
    const ast = try parser.parseProgram();

    try std.testing.expectEqual(ast.root.tag, .root);
}

