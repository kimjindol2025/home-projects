// 🦎 Zig Learning - Step 1: Environment Setup
// hello.zig: 첫 번째 프로그램

const std = @import("std");

pub fn main() void {
    const stdout = std.io.getStdOut().writer();
    stdout.print("Hello, Zig! 🦎\n", .{}) catch unreachable;

    // 간단한 계산
    const x: i32 = 5;
    const y: i32 = 10;
    const sum = x + y;

    stdout.print("{} + {} = {}\n", .{x, y, sum}) catch unreachable;
}
