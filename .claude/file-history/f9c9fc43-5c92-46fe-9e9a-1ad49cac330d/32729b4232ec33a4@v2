// 🦎 Zig Learning - Step 2: Operators
// operators.zig: 산술, 비교, 논리, 비트 연산

const std = @import("std");

pub fn main() void {
    const stdout = std.io.getStdOut().writer();

    // 1️⃣ 산술 연산자 (Arithmetic Operators)
    stdout.print("=== Arithmetic Operators ===\n", .{}) catch unreachable;
    const a: i32 = 10;
    const b: i32 = 3;

    const add = a + b;
    const sub = a - b;
    const mul = a * b;
    const div = a / b;        // 정수 나눗셈
    const mod = a % b;        // 나머지

    stdout.print("{} + {} = {}\n", .{a, b, add}) catch unreachable;
    stdout.print("{} - {} = {}\n", .{a, b, sub}) catch unreachable;
    stdout.print("{} * {} = {}\n", .{a, b, mul}) catch unreachable;
    stdout.print("{} / {} = {} (정수 나눗셈)\n", .{a, b, div}) catch unreachable;
    stdout.print("{} % {} = {}\n", .{a, b, mod}) catch unreachable;

    // 2️⃣ 부동소수점 연산
    stdout.print("\n=== Floating Point Arithmetic ===\n", .{}) catch unreachable;
    const x: f64 = 10.5;
    const y: f64 = 3.0;
    const f_div = x / y;      // 부동소수점 나눗셈
    stdout.print("{} / {} = {}\n", .{x, y, f_div}) catch unreachable;

    // 3️⃣ 비교 연산자 (Comparison Operators)
    stdout.print("\n=== Comparison Operators ===\n", .{}) catch unreachable;
    const eq = a == b;        // 같음
    const ne = a != b;        // 다름
    const lt = a < b;         // 작음
    const le = a <= b;        // 작거나 같음
    const gt = a > b;         // 큼
    const ge = a >= b;        // 크거나 같음

    stdout.print("{} == {} : {}\n", .{a, b, eq}) catch unreachable;
    stdout.print("{} != {} : {}\n", .{a, b, ne}) catch unreachable;
    stdout.print("{} < {} : {}\n", .{a, b, lt}) catch unreachable;
    stdout.print("{} <= {} : {}\n", .{a, b, le}) catch unreachable;
    stdout.print("{} > {} : {}\n", .{a, b, gt}) catch unreachable;
    stdout.print("{} >= {} : {}\n", .{a, b, ge}) catch unreachable;

    // 4️⃣ 논리 연산자 (Logical Operators)
    stdout.print("\n=== Logical Operators ===\n", .{}) catch unreachable;
    const true_val = true;
    const false_val = false;

    const and_result = true_val and false_val;  // false
    const or_result = true_val or false_val;    // true
    const not_result = !true_val;               // false

    stdout.print("true and false = {}\n", .{and_result}) catch unreachable;
    stdout.print("true or false = {}\n", .{or_result}) catch unreachable;
    stdout.print("!true = {}\n", .{not_result}) catch unreachable;

    // 5️⃣ 비트 연산자 (Bitwise Operators)
    stdout.print("\n=== Bitwise Operators ===\n", .{}) catch unreachable;
    const c: u8 = 0b1010;      // 10 (binary)
    const d: u8 = 0b1100;      // 12 (binary)

    const bit_and = c & d;     // AND: 0b1000 = 8
    const bit_or = c | d;      // OR:  0b1110 = 14
    const bit_xor = c ^ d;     // XOR: 0b0110 = 6
    const bit_not = ~c;        // NOT: inverts all bits

    stdout.print("0b1010 & 0b1100 = {b} ({})\n", .{bit_and, bit_and}) catch unreachable;
    stdout.print("0b1010 | 0b1100 = {b} ({})\n", .{bit_or, bit_or}) catch unreachable;
    stdout.print("0b1010 ^ 0b1100 = {b} ({})\n", .{bit_xor, bit_xor}) catch unreachable;
    stdout.print("~0b1010 = {b} ({})\n", .{bit_not, bit_not}) catch unreachable;

    // 6️⃣ 시프트 연산자 (Bit Shift)
    stdout.print("\n=== Bit Shift Operators ===\n", .{}) catch unreachable;
    const e: u8 = 5;           // 0b0101
    const left_shift = e << 1; // 왼쪽 시프트: 0b1010 = 10
    const right_shift = e >> 1; // 오른쪽 시프트: 0b0010 = 2

    stdout.print("{} << 1 = {}\n", .{e, left_shift}) catch unreachable;
    stdout.print("{} >> 1 = {}\n", .{e, right_shift}) catch unreachable;

    // 7️⃣ 할당 연산자 (Assignment Operators)
    stdout.print("\n=== Assignment Operators ===\n", .{}) catch unreachable;
    var num: i32 = 10;
    stdout.print("Initial: num = {}\n", .{num}) catch unreachable;

    num += 5;
    stdout.print("After += 5: num = {}\n", .{num}) catch unreachable;

    num -= 3;
    stdout.print("After -= 3: num = {}\n", .{num}) catch unreachable;

    num *= 2;
    stdout.print("After *= 2: num = {}\n", .{num}) catch unreachable;

    num /= 4;
    stdout.print("After /= 4: num = {}\n", .{num}) catch unreachable;

    // 8️⃣ 우선순위 (Operator Precedence)
    stdout.print("\n=== Operator Precedence ===\n", .{}) catch unreachable;
    const p1 = 2 + 3 * 4;      // 14 (곱셈 먼저)
    const p2 = (2 + 3) * 4;    // 20 (괄호 먼저)
    const p3 = 10 - 2 + 3;     // 11 (왼쪽에서 오른쪽)

    stdout.print("2 + 3 * 4 = {}\n", .{p1}) catch unreachable;
    stdout.print("(2 + 3) * 4 = {}\n", .{p2}) catch unreachable;
    stdout.print("10 - 2 + 3 = {}\n", .{p3}) catch unreachable;

    // 9️⃣ 복합 논리 연산
    stdout.print("\n=== Complex Logical Expressions ===\n", .{}) catch unreachable;
    const v1: i32 = 5;
    const v2: i32 = 10;
    const v3: i32 = 15;

    const complex = (v1 < v2) and (v2 < v3);
    stdout.print("(5 < 10) and (10 < 15) = {}\n", .{complex}) catch unreachable;

    const complex2 = (v1 > 0) and (v2 < 20) or (v3 == 15);
    stdout.print("(5 > 0) and (10 < 20) or (15 == 15) = {}\n", .{complex2}) catch unreachable;
}
