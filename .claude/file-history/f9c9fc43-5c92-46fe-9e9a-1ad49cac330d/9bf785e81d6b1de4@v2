// 🦎 Mini Zig Compiler - AstGen Tests
// test/astgen_test.zig: AST → ZIR 변환 검증

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Token = @import("../src/tokenizer.zig").Token;
const Parser = @import("../src/parser.zig").Parser;
const Ast = @import("../src/ast.zig");
const AstGen = @import("../src/astgen.zig").AstGen;
const Zir = @import("../src/zir.zig").Zir;

fn tokenize(source: []const u8, allocator: std.mem.Allocator) ![]Token {
    var tokenizer = Tokenizer.init(source);
    var tokens = std.ArrayList(Token).init(allocator);

    while (true) {
        const token = tokenizer.nextToken();
        try tokens.append(token);
        if (token.tag == .eof) break;
    }

    return tokens.items;
}

fn parseAndGenerate(source: []const u8, allocator: std.mem.Allocator) !Zir {
    const tokens = try tokenize(source, allocator);
    defer allocator.free(tokens);

    var parser = Parser.init(tokens, source, allocator);
    const ast = try parser.parseProgram();

    var astgen = try AstGen.init(allocator, source);
    try astgen.genProgram(&ast);

    return astgen.zir.*;
}

test "generate simple integer literal" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "42;";
    var zir = try parseAndGenerate(source, allocator);
    defer zir.deinit();

    // 정수 리터럴 → load_int 명령어
    try std.testing.expect(zir.instructions.items.len > 0);
    try std.testing.expectEqual(zir.instructions.items[0], .load_int);
    try std.testing.expectEqual(zir.instructions.items[0].load_int.value, 42);
}

