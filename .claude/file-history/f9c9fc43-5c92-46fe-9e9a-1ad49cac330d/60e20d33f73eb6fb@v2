// 🦎 Zig Learning - Step 1: Basic Types
// basic-types.zig: Zig의 기본 타입 소개

const std = @import("std");

pub fn main() void {
    const stdout = std.io.getStdOut().writer();

    // 1️⃣ 정수 타입 (Integer Types)
    stdout.print("=== Integer Types ===\n", .{}) catch unreachable;

    const a: i8 = 127;      // 부호있는 8비트
    const b: u8 = 255;      // 부호없는 8비트
    const c: i32 = -1000;   // 부호있는 32비트
    const d: u32 = 4000;    // 부호없는 32비트
    const e: i64 = 9223372036854775807;  // 부호있는 64비트
    const f: usize = 128;   // 플랫폼 의존적 크기

    stdout.print("i8: {}, u8: {}, i32: {}, u32: {}, i64: {}, usize: {}\n",
        .{a, b, c, d, e, f}) catch unreachable;

    // 2️⃣ 실수 타입 (Float Types)
    stdout.print("\n=== Float Types ===\n", .{}) catch unreachable;

    const pi: f32 = 3.14159;    // 32비트 부동소수점
    const e_const: f64 = 2.71828;  // 64비트 부동소수점

    stdout.print("f32 (pi): {}, f64 (e): {}\n", .{pi, e_const}) catch unreachable;

    // 3️⃣ 불린 타입 (Boolean)
    stdout.print("\n=== Boolean Type ===\n", .{}) catch unreachable;

    const is_true: bool = true;
    const is_false: bool = false;

    stdout.print("bool: true={}, false={}\n", .{is_true, is_false}) catch unreachable;

    // 4️⃣ 문자열 (String)
    stdout.print("\n=== String Type ===\n", .{}) catch unreachable;

    const greeting: []const u8 = "Hello, Zig!";
    const name: []const u8 = "Alice";

    stdout.print("String: '{}' says '{}'\n", .{greeting, name}) catch unreachable;

    // 5️⃣ 배열 (Array)
    stdout.print("\n=== Array Type ===\n", .{}) catch unreachable;

    const numbers: [5]i32 = .{1, 2, 3, 4, 5};
    const bytes: [3]u8 = .{65, 66, 67};  // ASCII: A, B, C

    stdout.print("Array: ", .{}) catch unreachable;
    for (numbers) |num| {
        stdout.print("{} ", .{num}) catch unreachable;
    }
    stdout.print("\nBytes as chars: ", .{}) catch unreachable;
    for (bytes) |b| {
        stdout.print("{c}", .{b}) catch unreachable;
    }
    stdout.print("\n", .{}) catch unreachable;

    // 6️⃣ 옵션 타입 (Optional)
    stdout.print("\n=== Optional Type ===\n", .{}) catch unreachable;

    const maybe_number: ?i32 = 42;
    const maybe_null: ?i32 = null;

    if (maybe_number) |num| {
        stdout.print("Optional has value: {}\n", .{num}) catch unreachable;
    } else {
        stdout.print("Optional is null\n", .{}) catch unreachable;
    }

    if (maybe_null) |num| {
        stdout.print("This won't print: {}\n", .{num}) catch unreachable;
    } else {
        stdout.print("Optional is null\n", .{}) catch unreachable;
    }

    // 7️⃣ 타입 추론 (Type Inference)
    stdout.print("\n=== Type Inference ===\n", .{}) catch unreachable;

    const inferred = 100;           // i32로 추론됨
    const inferred_float = 3.14;    // f64로 추론됨
    const inferred_array = .{1, 2, 3};  // [3]comptime_int

    stdout.print("Inferred int: {}, float: {}\n", .{inferred, inferred_float}) catch unreachable;
}
