// 🦎 Mini Zig Compiler - Phase 2.2: AST Definition
// src/ast.zig: Abstract Syntax Tree 노드 타입 정의

const std = @import("std");
const Token = @import("tokenizer.zig").Token;

/// 모든 AST 노드의 위치 정보
pub const Location = struct {
    line: usize,
    column: usize,
    start: usize,
    end: usize,
};

/// AST 노드 (모든 가능한 AST 노드 타입)
pub const Node = struct {
    tag: Tag,
    loc: Location,
    data: Data,

    pub const Tag = enum {
        // 프로그램
        root,

        // 선언
        fn_decl,
        var_decl,
        const_decl,

        // 문장
        block,
        if_stmt,
        while_stmt,
        for_stmt,
        return_stmt,
        expr_stmt,
        var_assign,
        defer_stmt,           // defer expr; (Phase 3.6)

        // 식 (Expression)
        binary_op,
        unary_op,
        call,
        member_access,
        index_access,
        integer_literal,
        float_literal,
        string_literal,
        identifier,
        grouped_expr,
        array_literal,

        // 타입
        type_primitive,
        type_pointer,
        type_array,
        type_slice,           // []T 슬라이스 타입 (Phase 3.5)
        type_function,
        type_param,           // Generic 타입 파라미터 (T)

        // 식 (배열/슬라이스 연산)
        slice_access,         // arr[i..j] 슬라이싱 (Phase 3.5)

        // Generic 관련
        generic_param,        // comptime 파라미터
        comptime_decl,        // comptime 블록

        // Comptime Programming (Phase 3.3)
        comptime_block_expr,  // comptime { ... } 식
        const_expr,           // const X = VALUE 식

        // Union/Enum (Phase 3.2)
        union_type,           // union Result { ok: T, err: U }
        enum_type,            // enum Animal { dog, cat }
        union_field,          // Union 필드 정의
        enum_field,           // Enum 값 정의

        // Phase 3.8: Pattern Matching
        switch_expr,          // switch expr { case ... }
        case_pattern,         // pattern => value
        tuple_pattern,        // (a, b, c)
        struct_pattern,       // Point { x, y }
        type_pattern,         // Type 패턴
        wildcard_pattern,     // _ 패턴
        variable_pattern,     // 변수 바인딩

        // 기타
        param,
        arg,
    };

    pub const Data = union {
        // root: []Node,
        // fn_decl, var_decl, const_decl, etc.
        // 일단 단순하게 구현, 나중에 확장

        // 이진 연산자
        binary_op: struct {
            op: BinaryOp,
            lhs: *Node,
            rhs: *Node,
        },

        // 단항 연산자
        unary_op: struct {
            op: UnaryOp,
            operand: *Node,
        },

        // 함수 호출
        call: struct {
            callee: *Node,
            args: []Node,
        },

        // 멤버 접근 (obj.field)
        member_access: struct {
            object: *Node,
            field: []const u8,
        },

        // 배열 인덱싱
        index_access: struct {
            array: *Node,
            index: *Node,
        },

        // 리터럴
        integer: i64,
        float: f64,
        string: []const u8,
        identifier: []const u8,

        // 배열 리터럴
        array_literal: []Node,

        // 식 문장
        expr: *Node,

        // 반환 문
        return_expr: ?*Node,

        // 블록 (복수 문장)
        block: []Node,

        // if 문
        if_stmt: struct {
            condition: *Node,
            then_branch: *Node,
            else_branch: ?*Node,
        },

        // while 루프
        while_stmt: struct {
            condition: *Node,
            body: *Node,
        },

        // for 루프
        for_stmt: struct {
            init: ?*Node,
            condition: ?*Node,
            increment: ?*Node,
            body: *Node,
        },

        // 함수 선언
        fn_decl: struct {
            name: []const u8,
            params: []Param,
            return_type: ?*Node,
            body: *Node,
        },

        // 변수 선언
        var_decl: struct {
            name: []const u8,
            type_annotation: ?*Node,
            initial_value: ?*Node,
        },

        // 상수 선언
        const_decl: struct {
            name: []const u8,
            type_annotation: ?*Node,
            value: *Node,
        },

        // 변수 할당
        var_assign: struct {
            target: *Node,
            value: *Node,
        },

        // 타입 노드
        type_name: []const u8,       // i32, f64, etc.
        pointer_type: *Node,          // *i32
        array_type: struct {
            element_type: *Node,
            size: ?*Node,
        },

        // Phase 3.5: 슬라이스 타입
        slice_type: struct {
            element_type: *Node,
            is_const: bool = false,   // []const T
        },

        // Phase 3.5: 슬라이싱 (arr[i..j])
        slice_access: struct {
            array: *Node,
            start: ?*Node,  // null이면 0부터
            end: ?*Node,    // null이면 끝까지
        },

        // Phase 3.6: Defer 문 (defer expr;)
        defer_stmt: struct {
            expr: *Node,  // defer할 식
        },

        // Phase 3.7: Error Handling
        try_expr,         // try expr
        catch_expr,       // catch |err| { ... }
        error_type,       // error Type
        error_union,      // Type!ErrorType

        // Generic 파라미터 (comptime 키워드)
        generic_param: struct {
            is_comptime: bool,
            name: []const u8,
            constraint: ?*Node,  // type, i32, etc.
        },

        // 타입 파라미터 (Generic T)
        type_param_node: []const u8,

        // Comptime 블록
        comptime_block: *Node,

        // Comptime 블록 식 (Phase 3.3) - comptime { ... }를 식으로 사용
        comptime_block_expr_data: struct {
            body: []Node,
        },

        // 상수 식 (Phase 3.3) - const X = VALUE
        const_expr_data: struct {
            name: []const u8,
            type_node: ?*Node = null,  // 타입 명시적 지정 가능
            value: *Node,               // 초기값 (반드시 상수식이어야 함)
        },

        // Union Type (Phase 3.2)
        union_type_data: struct {
            name: []const u8,
            fields: []UnionField,
            is_tagged: bool = false,  // union(enum)
        },

        // Enum Type (Phase 3.2)
        enum_type_data: struct {
            name: []const u8,
            fields: []EnumField,
            is_tagged: bool = false,  // enum with values
        },

        // Phase 3.7: Error Handling
        try_expr_data: struct {
            expr: *Node,  // try할 식
        },

        catch_expr_data: struct {
            try_expr: *Node,
            error_name: []const u8,  // |err|
            body: *Node,             // { ... }
        },

        error_type_data: struct {
            name: []const u8,
            fields: []ErrorField,
        },

        error_union_data: struct {
            base_type: *Node,
            error_type: *Node,
        },

        // Phase 3.8: Pattern Matching
        switch_expr_data: struct {
            expr: *Node,
            cases: []CasePattern,
        },

        case_pattern_data: struct {
            pattern: *Node,
            value: *Node,
        },

        tuple_pattern_data: struct {
            elements: []Node,
        },

        struct_pattern_data: struct {
            struct_name: []const u8,
            fields: []StructPatternField,
        },

        type_pattern_data: struct {
            target_type: *Node,
        },

        variable_pattern_data: struct {
            name: []const u8,
        },

        // 기본값 (사용 안 함)
        none: void,
    };
};

pub const Param = struct {
    name: []const u8,
    type_node: Node,
    is_comptime: bool = false,  // Generic 파라미터 여부 (comptime T: type)
};

// Union 필드 (Phase 3.2)
pub const UnionField = struct {
    name: []const u8,
    type_node: *Node,
    loc: Location,
};

// Enum 값 (Phase 3.2)
pub const EnumField = struct {
    name: []const u8,
    value: ?*Node = null,  // Optional value expression
    loc: Location,
};

// Error 필드 (Phase 3.7)
pub const ErrorField = struct {
    name: []const u8,
    loc: Location,
};

// Phase 3.8: Pattern Matching
pub const CasePattern = struct {
    pattern: *Node,
    value: *Node,
    loc: Location,
};

pub const StructPatternField = struct {
    name: []const u8,
    pattern: ?*Node = null,  // null이면 이름 바인딩
    loc: Location,
};

pub const BinaryOp = enum {
    add,      // +
    subtract, // -
    multiply, // *
    divide,   // /
    modulo,   // %
    equal,    // ==
    not_equal,     // !=
    less,          // <
    less_equal,    // <=
    greater,       // >
    greater_equal, // >=
    logical_and,   // and
    logical_or,    // or
    bitwise_and,   // &
    bitwise_or,    // |
    bitwise_xor,   // ^
    lshift,        // <<
    rshift,        // >>
};

pub const UnaryOp = enum {
    negate,   // -
    not,      // !
    bitwise_not, // ~
};

/// 전체 AST
pub const Ast = struct {
    root: Node,
    allocator: std.mem.Allocator,

    pub fn deinit(self: *Ast) void {
        // TODO: 재귀적으로 모든 노드 메모리 해제
        _ = self;
    }
};

/// AST 출력 (디버깅용)
pub fn printAst(node: *const Node, indent: usize) void {
    const spaces = " " ** indent;
    const stdout = std.io.getStdOut().writer();

    switch (node.tag) {
        .root => stdout.print("{s}Root\n", .{spaces}) catch {},
        .fn_decl => {
            stdout.print("{s}FnDecl: {s}\n", .{ spaces, node.data.fn_decl.name }) catch {};
            if (node.data.fn_decl.return_type) |ret_type| {
                stdout.print("{s}  ReturnType:\n", .{spaces}) catch {};
                printAst(ret_type, indent + 4);
            }
            stdout.print("{s}  Body:\n", .{spaces}) catch {};
            printAst(node.data.fn_decl.body, indent + 4);
        },
        .const_decl => {
            stdout.print("{s}ConstDecl: {s}\n", .{ spaces, node.data.const_decl.name }) catch {};
            stdout.print("{s}  Value:\n", .{spaces}) catch {};
            printAst(node.data.const_decl.value, indent + 4);
        },
        .var_decl => {
            stdout.print("{s}VarDecl: {s}\n", .{ spaces, node.data.var_decl.name }) catch {};
            if (node.data.var_decl.initial_value) |init| {
                stdout.print("{s}  Initial:\n", .{spaces}) catch {};
                printAst(init, indent + 4);
            }
        },
        .binary_op => {
            stdout.print("{s}BinaryOp: {s}\n", .{ spaces, @tagName(node.data.binary_op.op) }) catch {};
            stdout.print("{s}  LHS:\n", .{spaces}) catch {};
            printAst(node.data.binary_op.lhs, indent + 4);
            stdout.print("{s}  RHS:\n", .{spaces}) catch {};
            printAst(node.data.binary_op.rhs, indent + 4);
        },
        .integer_literal => {
            stdout.print("{s}Integer: {}\n", .{ spaces, node.data.integer }) catch {};
        },
        .identifier => {
            stdout.print("{s}Identifier: {s}\n", .{ spaces, node.data.identifier }) catch {};
        },
        .call => {
            stdout.print("{s}Call:\n", .{spaces}) catch {};
            stdout.print("{s}  Callee:\n", .{spaces}) catch {};
            printAst(node.data.call.callee, indent + 4);
            stdout.print("{s}  Args: {} items\n", .{ spaces, node.data.call.args.len }) catch {};
        },
        .return_stmt => {
            stdout.print("{s}Return\n", .{spaces}) catch {};
            if (node.data.return_expr) |expr| {
                printAst(expr, indent + 2);
            }
        },
        .block => {
            stdout.print("{s}Block: {} statements\n", .{ spaces, node.data.block.len }) catch {};
        },
        .if_stmt => {
            stdout.print("{s}IfStmt\n", .{spaces}) catch {};
            stdout.print("{s}  Condition:\n", .{spaces}) catch {};
            printAst(node.data.if_stmt.condition, indent + 4);
            stdout.print("{s}  Then:\n", .{spaces}) catch {};
            printAst(node.data.if_stmt.then_branch, indent + 4);
            if (node.data.if_stmt.else_branch) |else_br| {
                stdout.print("{s}  Else:\n", .{spaces}) catch {};
                printAst(else_br, indent + 4);
            }
        },
        .union_type => {
            const union_data = node.data.union_type_data;
            stdout.print("{s}UnionType: {s} ({} fields)\n", .{ spaces, union_data.name, union_data.fields.len }) catch {};
            if (union_data.is_tagged) {
                stdout.print("{s}  Tagged: true\n", .{spaces}) catch {};
            }
        },
        .enum_type => {
            const enum_data = node.data.enum_type_data;
            stdout.print("{s}EnumType: {s} ({} fields)\n", .{ spaces, enum_data.name, enum_data.fields.len }) catch {};
            if (enum_data.is_tagged) {
                stdout.print("{s}  Tagged: true\n", .{spaces}) catch {};
            }
        },
        else => stdout.print("{s}{s}\n", .{ spaces, @tagName(node.tag) }) catch {},
    }
}
