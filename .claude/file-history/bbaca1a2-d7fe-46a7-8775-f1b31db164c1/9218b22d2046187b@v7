// 🦎 Mini Zig Compiler - Phase 2.4: Sema
// src/sema.zig: Semantic Analysis (Type Checking & Symbol Resolution)

const std = @import("std");
const Zir = @import("zir.zig").Zir;
const Air = @import("air.zig").Air;
const AirType = @import("air.zig").Type;
const Location = @import("tokenizer.zig").Location;

/// Semantic Error Types
pub const SemanticError = union(enum) {
    undefined_variable: struct {
        name: []const u8,
        location: Location,
    },
    duplicate_declaration: struct {
        name: []const u8,
        location: Location,
    },
    type_mismatch: struct {
        expected: AirType,
        got: AirType,
        location: Location,
    },
    wrong_arg_count: struct {
        function: []const u8,
        expected: usize,
        got: usize,
        location: Location,
    },
    const_reassignment: struct {
        name: []const u8,
        location: Location,
    },
    non_bool_condition: struct {
        got: AirType,
        location: Location,
    },
    non_function_call: struct {
        got: AirType,
        location: Location,
    },
    invalid_binary_op: struct {
        op: []const u8,
        lhs_ty: AirType,
        rhs_ty: AirType,
        location: Location,
    },
    invalid_unary_op: struct {
        op: []const u8,
        operand_ty: AirType,
        location: Location,
    },
    invalid_array_index: struct {
        index_ty: AirType,
        location: Location,
    },
    not_indexable: struct {
        got: AirType,
        location: Location,
    },
    invalid_slice_bounds: struct {
        reason: []const u8,
        location: Location,
    },

    // Phase 3.6: Defer & Resource Management
    defer_expr_not_void: struct {
        got: AirType,
        location: Location,
    },
    invalid_defer_expr: struct {
        reason: []const u8,
        location: Location,
    },
};

/// Symbol Information
pub const Symbol = struct {
    name: []const u8,
    ty: AirType,
    is_mutable: bool,
    location: Location,
    is_generic: bool = false,              // Generic 함수인가?
    comptime_param_count: u32 = 0,        // Comptime 파라미터 개수
};

