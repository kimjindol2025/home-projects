/// Symbol Table (with Scope Support)
pub const SymbolTable = struct {
    symbols: std.StringHashMap(Symbol),
    parent_scope: ?*SymbolTable,
    allocator: std.mem.Allocator,

    pub fn init(allocator: std.mem.Allocator, parent_scope: ?*SymbolTable) SymbolTable {
        return .{
            .symbols = std.StringHashMap(Symbol).init(allocator),
            .parent_scope = parent_scope,
            .allocator = allocator,
        };
    }

    pub fn deinit(self: *SymbolTable) void {
        self.symbols.deinit();
    }

    /// 변수 선언
    pub fn declare(
        self: *SymbolTable,
        name: []const u8,
        ty: AirType,
        is_mutable: bool,
        location: Location,
    ) !void {
        if (self.symbols.contains(name)) {
            return error.DuplicateDeclaration;
        }
        try self.symbols.put(name, .{
            .name = name,
            .ty = ty,
            .is_mutable = is_mutable,
            .location = location,
        });
    }

    /// 변수 조회 (현재 스코프 및 부모 스코프)
    pub fn lookup(self: *SymbolTable, name: []const u8) ?Symbol {
        if (self.symbols.get(name)) |symbol| {
            return symbol;
        }

        if (self.parent_scope) |parent| {
            return parent.lookup(name);
        }

        return null;
    }

    /// 현재 스코프에서만 조회
    pub fn lookupLocal(self: *SymbolTable, name: []const u8) ?Symbol {
        return self.symbols.get(name);
    }
};

/// Type Inference Engine
pub const TypeInference = struct {
    allocator: std.mem.Allocator,
    symbol_table: *SymbolTable,

    pub fn init(allocator: std.mem.Allocator, symbol_table: *SymbolTable) TypeInference {
        return .{
            .allocator = allocator,
            .symbol_table = symbol_table,
        };
    }

    /// ZIR 명령어에서 타입 추론
    pub fn inferType(self: *TypeInference, zir_inst: Zir.Instruction) !AirType {
        return switch (zir_inst) {
            .load_int => .i32, // 기본은 i32
            .load_float => .f64, // 기본은 f64
            .load_string => .string,
            .load_var => |data| blk: {
                // 심볼 테이블에서 변수 타입 조회
                // 나중에 구현 (현재는 unknown 반환)
                break :blk .unknown;
            },
            .binary_op => |data| try self.inferBinaryOpType(data.op),
            .unary_op => |data| try self.inferUnaryOpType(data.op),
            .call => .unknown, // 함수 호출 타입은 함수 정의에서 결정
            else => .unknown,
        };
    }

    /// 이항 연산 결과 타입 추론
    fn inferBinaryOpType(self: *TypeInference, op: Zir.BinaryOp) !AirType {
        _ = self;
        return switch (op) {
            // 산술 연산: i32, i64, f32, f64 → 같은 타입
            .add, .sub, .mul, .div, .mod => .i32, // 기본은 i32
            // 비교 연산: 모든 타입 → bool
            .eq, .ne, .lt, .le, .gt, .ge => .bool,
            // 논리 연산: bool → bool
            .logical_and, .logical_or => .bool,
            // 비트 연산: i32, i64 → 같은 타입
            .bitwise_and, .bitwise_or, .bitwise_xor, .lshift, .rshift => .i32,
        };
    }

    /// 단항 연산 결과 타입 추론
    fn inferUnaryOpType(self: *TypeInference, op: Zir.UnaryOp) !AirType {
        _ = self;
        return switch (op) {
            .negate => .i32, // -x: 숫자 → 숫자
            .not => .bool, // !x: 불린 → 불린
            .bitwise_not => .i32, // ~x: 정수 → 정수
        };
    }

    /// 이항 연산 타입 검사
    pub fn checkBinaryOp(self: *TypeInference, op: Zir.BinaryOp, lhs_ty: AirType, rhs_ty: AirType) !AirType {
        _ = self;
        // 산술 연산: 양쪽 모두 i32 또는 f64
        switch (op) {
            .add, .sub, .mul, .div, .mod => {
                if (isNumericType(lhs_ty) and isNumericType(rhs_ty)) {
                    return lhs_ty; // 좌측 타입으로 통일
                }
                return error.TypeMismatch;
            },
            // 비교 연산: 양쪽 타입이 같음
            .eq, .ne, .lt, .le, .gt, .ge => {
                if (Air.typeEq(lhs_ty, rhs_ty)) {
                    return .bool;
                }
                return error.TypeMismatch;
            },
            // 논리 연산: 양쪽 모두 bool
            .logical_and, .logical_or => {
                if (lhs_ty == .bool and rhs_ty == .bool) {
                    return .bool;
                }
                return error.TypeMismatch;
            },
            // 비트 연산: 양쪽 모두 i32 또는 i64
            .bitwise_and, .bitwise_or, .bitwise_xor, .lshift, .rshift => {
                if (isIntegerType(lhs_ty) and isIntegerType(rhs_ty)) {
                    return lhs_ty;
                }
                return error.TypeMismatch;
            },
        }
    }

    /// 단항 연산 타입 검사
    pub fn checkUnaryOp(self: *TypeInference, op: Zir.UnaryOp, operand_ty: AirType) !AirType {
        _ = self;
        return switch (op) {
            .negate => blk: {
                if (isNumericType(operand_ty)) {
                    break :blk operand_ty;
                }
                return error.TypeMismatch;
            },
            .not => blk: {
                if (operand_ty == .bool) {
                    break :blk .bool;
                }
                return error.TypeMismatch;
            },
            .bitwise_not => blk: {
                if (isIntegerType(operand_ty)) {
                    break :blk operand_ty;
                }
                return error.TypeMismatch;
            },
        };
    }
};

/// 숫자 타입 확인
fn isNumericType(ty: AirType) bool {
    return switch (ty) {
        .i32, .i64, .f32, .f64 => true,
        else => false,
    };
}

/// 정수 타입 확인
fn isIntegerType(ty: AirType) bool {
    return switch (ty) {
        .i32, .i64 => true,
        else => false,
    };
}

/// Phase 3.6: Defer 정보
pub const DeferInfo = struct {
    expr_ty: AirType,
    scope_id: u32,
    defer_index: u32,
    location: Location,
};

/// Semantic Analyzer (메인 분석기)
pub const Sema = struct {
    zir: *const Zir,
    air: *Air,
    allocator: std.mem.Allocator,

    symbol_table: SymbolTable,
    type_infer: TypeInference,

    errors: std.ArrayList(SemanticError),
    current_function: ?[]const u8 = null,
    function_return_type: ?AirType = null,

    // Generic 함수 지원
    generic_functions: std.StringHashMap(GenericFunctionSignature),  // "max" → GenericFunctionSignature
    generic_instances: std.ArrayList(GenericInstance),              // 생성된 인스턴스들

    // Union/Enum 타입 지원 (Phase 3.2)
    union_types: std.StringHashMap(UnionTypeInfo),                  // "Result" → UnionTypeInfo
    enum_types: std.StringHashMap(EnumTypeInfo),                    // "Status" → EnumTypeInfo

    // Comptime 값 지원 (Phase 3.3)
    const_values: std.StringHashMap(ComptimeValue),                 // "X" → ComptimeValue
    const_types: std.StringHashMap(AirType),                        // "X" → AirType (타입 추론)

    // 오버로드 해석 지원 (Phase 3.4)
    overload_groups: std.StringHashMap([]Zir.FunctionSignature),    // "max" → signatures[]
    overload_resolution_cache: std.StringHashMap(Zir.Ref),          // "max(i32,i32)" → fn_ref

    pub fn init(allocator: std.mem.Allocator, zir: *const Zir) !Sema {
        var air = try allocator.create(Air);
        air.* = Air.init(allocator);

        var symbol_table = SymbolTable.init(allocator, null);

        var sema = Sema{
            .zir = zir,
            .air = air,
            .allocator = allocator,
            .symbol_table = symbol_table,
            .type_infer = TypeInference.init(allocator, &symbol_table),
            .errors = std.ArrayList(SemanticError).init(allocator),
            .generic_functions = std.StringHashMap(GenericFunctionSignature).init(allocator),
            .generic_instances = std.ArrayList(GenericInstance).init(allocator),
            .union_types = std.StringHashMap(UnionTypeInfo).init(allocator),
            .enum_types = std.StringHashMap(EnumTypeInfo).init(allocator),
            .const_values = std.StringHashMap(ComptimeValue).init(allocator),
            .const_types = std.StringHashMap(AirType).init(allocator),
            .overload_groups = std.StringHashMap([]Zir.FunctionSignature).init(allocator),
            .overload_resolution_cache = std.StringHashMap(Zir.Ref).init(allocator),
        };

        // ZIR의 overload_group 명령어에서 오버로드 그룹 추출
        for (zir.instructions.items) |inst| {
            if (inst == .overload_group) {
                const group = inst.overload_group;
                // 함수 이름을 string pool에서 조회
                var iter = zir.strings.iterator();
                var name_idx: u32 = 0;
                while (iter.next()) |entry| {
                    if (name_idx == group.name_index) {
                        try sema.overload_groups.put(entry.value_ptr.*, group.signatures);
                        break;
                    }
                    name_idx += 1;
                }
            }
        }

        return sema;
    }

    pub fn deinit(self: *Sema) void {
        self.symbol_table.deinit();
        self.air.deinit();
        self.allocator.destroy(self.air);
        self.errors.deinit();
        self.generic_functions.deinit();
        self.generic_instances.deinit();
        self.union_types.deinit();
        self.enum_types.deinit();
        self.const_values.deinit();
        self.const_types.deinit();
        self.overload_groups.deinit();
        self.overload_resolution_cache.deinit();
    }

    /// 전체 ZIR 분석
    pub fn analyzeProgram(self: *Sema) !void {
        // 1단계: 모든 선언 수집 (forward pass)
        // 2단계: 타입 검사 및 AIR 생성 (analysis pass)

        // 현재 간단한 구현: 순차적으로 처리
        for (self.zir.instructions.items, 0..) |zir_inst, idx| {
            _ = self.analyzeInstruction(zir_inst, idx) catch |err| {
                // 에러 계속 수집
                continue;
            };
        }
    }

    /// 개별 명령어 분석
    fn analyzeInstruction(self: *Sema, zir_inst: Zir.Instruction, idx: usize) !void {
        _ = idx;

        switch (zir_inst) {
            .load_int => |data| {
                _ = try self.air.addInstruction(.{
                    .load_int = .{
                        .value = data.value,
                        .ty = .i32,
                    },
                });
            },
            .load_float => |data| {
                _ = try self.air.addInstruction(.{
                    .load_float = .{
                        .value = data.value,
                        .ty = .f64,
                    },
                });
            },
            .load_string => |data| {
                _ = try self.air.addInstruction(.{
                    .load_string = .{
                        .index = data.index,
                        .ty = .string,
                    },
                });
            },
            .load_var => |data| {
                _ = try self.air.addInstruction(.{
                    .load_var = .{
                        .name_index = data.name_index,
                        .ty = .unknown,
                    },
                });
            },
            .store_var => |data| {
                _ = try self.air.addInstruction(.{
                    .store_var = .{
                        .name_index = data.name_index,
                        .value = data.value,
                        .ty = .unknown,
                    },
                });
            },
            .binary_op => |data| {
                // 타입 검사 수행
                const result_ty = try self.type_infer.inferBinaryOpType(data.op);
                _ = try self.air.addInstruction(.{
                    .binary_op = .{
                        .op = data.op,
                        .lhs = data.lhs,
                        .rhs = data.rhs,
                        .result_ty = result_ty,
                    },
                });
            },
            .unary_op => |data| {
                const result_ty = try self.type_infer.inferUnaryOpType(data.op);
                _ = try self.air.addInstruction(.{
                    .unary_op = .{
                        .op = data.op,
                        .operand = data.operand,
                        .result_ty = result_ty,
                    },
                });
            },
            .fn_begin => |data| {
                _ = try self.air.addInstruction(.{
                    .fn_begin = .{
                        .name_index = data.name_index,
                        .params = data.params,
                        .return_ty = .void, // 기본 반환 타입
                    },
                });
            },
            .generic_fn_begin => |data| {
                // Generic 함수 등록
                try self.registerGenericFunction(data);

                // AIR에도 함수 시작 추가
                _ = try self.air.addInstruction(.{
                    .fn_begin = .{
                        .name_index = data.name_index,
                        .params = data.params,
                        .return_ty = .void, // Generic 함수의 반환 타입은 나중에 인스턴시화 시 결정
                    },
                });
            },
            // Phase 3.2: Union 타입 분석
            .union_begin => |data| {
                try self.analyzeUnionType(data);
            },
            .union_field => |_data| {
                // Union 필드는 union_begin 처리 시 함께 처리됨
            },
            // Phase 3.2: Enum 타입 분석
            .enum_begin => |data| {
                try self.analyzeEnumType(data);
            },
            .enum_value => |_data| {
                // Enum 값은 enum_begin 처리 시 함께 처리됨
            },
            .fn_end => {
                _ = try self.air.addInstruction(.fn_end);
            },
            .call => |data| {
                _ = try self.air.addInstruction(.{
                    .call = .{
                        .callee = data.callee,
                        .args = data.args,
                        .return_ty = .unknown,
                    },
                });
            },
            .return_val => |ret| {
                _ = try self.air.addInstruction(.{ .return_val = ret });
            },
            .cond_br => |data| {
                _ = try self.air.addInstruction(.{
                    .cond_br = .{
                        .cond = data.cond,
                        .then_block = data.then_block,
                        .else_block = data.else_block,
                    },
                });
            },
            .block_begin => |data| {
                _ = try self.air.addInstruction(.{
                    .block_begin = .{ .label = data.label },
                });
            },
            .block_end => {
                _ = try self.air.addInstruction(.block_end);
            },
            .array_literal => |data| {
                _ = try self.air.addInstruction(.{
                    .array_literal = .{
                        .elements = data.elements,
                        .element_ty = .unknown,
                    },
                });
            },
            .loop_begin => |data| {
                _ = try self.air.addInstruction(.{
                    .loop_begin = .{ .label = data.label },
                });
            },
            .loop_end => {
                _ = try self.air.addInstruction(.loop_end);
            },
            else => {
                // 기타 명령어는 그대로 복사
                _ = try self.air.addInstruction(zir_inst);
            },
        }
    }

    /// 에러 보고
    pub fn reportError(self: *Sema, err: SemanticError) !void {
        try self.errors.append(err);
    }

    /// 에러 확인
    pub fn hasErrors(self: *Sema) bool {
        return self.errors.items.len > 0;
    }

    /// 에러 개수
    pub fn errorCount(self: *Sema) usize {
        return self.errors.items.len;
    }

    /// 에러 출력
    pub fn printErrors(self: *Sema) void {
        const stdout = std.io.getStdOut().writer();

        for (self.errors.items) |err| {
            switch (err) {
                .undefined_variable => |data| {
                    stdout.print("Error: undefined variable '{s}'\n  at line {}, column {}\n\n", .{
                        data.name,
                        data.location.line,
                        data.location.column,
                    }) catch {};
                },
                .duplicate_declaration => |data| {
                    stdout.print("Error: duplicate declaration '{s}'\n  at line {}, column {}\n\n", .{
                        data.name,
                        data.location.line,
                        data.location.column,
                    }) catch {};
                },
                .type_mismatch => |data| {
                    stdout.print("Error: type mismatch\n  expected: {s}\n  got: {s}\n  at line {}, column {}\n\n", .{
                        Air.typeName(data.expected),
                        Air.typeName(data.got),
                        data.location.line,
                        data.location.column,
                    }) catch {};
                },
                .wrong_arg_count => |data| {
                    stdout.print("Error: function '{s}' expects {} arguments, got {}\n  at line {}, column {}\n\n", .{
                        data.function,
                        data.expected,
                        data.got,
                        data.location.line,
                        data.location.column,
                    }) catch {};
                },
                .const_reassignment => |data| {
                    stdout.print("Error: cannot reassign constant '{s}'\n  at line {}, column {}\n\n", .{
                        data.name,
                        data.location.line,
                        data.location.column,
                    }) catch {};
                },
                .non_bool_condition => |data| {
                    stdout.print("Error: condition must be boolean, got {s}\n  at line {}, column {}\n\n", .{
                        Air.typeName(data.got),
                        data.location.line,
                        data.location.column,
                    }) catch {};
                },
                .non_function_call => |data| {
                    stdout.print("Error: cannot call non-function type {s}\n  at line {}, column {}\n\n", .{
                        Air.typeName(data.got),
                        data.location.line,
                        data.location.column,
                    }) catch {};
                },
                .invalid_binary_op => |data| {
                    stdout.print("Error: invalid binary operation '{s}' on {s} and {s}\n  at line {}, column {}\n\n", .{
                        data.op,
                        Air.typeName(data.lhs_ty),
                        Air.typeName(data.rhs_ty),
                        data.location.line,
                        data.location.column,
                    }) catch {};
                },
                .invalid_unary_op => |data| {
                    stdout.print("Error: invalid unary operation '{s}' on {s}\n  at line {}, column {}\n\n", .{
                        data.op,
                        Air.typeName(data.operand_ty),
                        data.location.line,
                        data.location.column,
                    }) catch {};
                },
            }
        }
    }

    /// Generic 함수 등록
    fn registerGenericFunction(self: *Sema, data: Zir.Instruction.GenericFnBegin) !void {
        // ZIR 문자열 풀에서 함수 이름 조회
        var func_name: []const u8 = "unknown";
        var iter = self.zir.strings.iterator();
        var str_idx: u32 = 0;
        while (iter.next()) |entry| {
            if (str_idx == data.name_index) {
                func_name = entry.value_ptr.*;
                break;
            }
            str_idx += 1;
        }

        // Comptime 파라미터 이름 수집 (간단한 구현)
        var comptime_params = std.ArrayList([]const u8).init(self.allocator);
        defer comptime_params.deinit();

        // 처음 N개 (N = comptime_param_count) 파라미터가 comptime
        for (0..data.comptime_param_count) |_| {
            // 파라미터 이름은 나중에 ZIR에서 추출
            try comptime_params.append("T"); // 간단히 "T", "U" 등으로 표기
        }

        // Generic 함수 시그니처 생성
        const sig = GenericFunctionSignature{
            .name = func_name,
            .comptime_param_names = try self.allocator.dupe([]const u8, comptime_params.items),
            .regular_param_types = &.{},  // 나중에 확장
            .return_type = .void,          // 나중에 확장
            .zir_ref = 0,                  // 나중에 설정
        };

        // Generic 함수 저장
        try self.generic_functions.put(func_name, sig);
    }

    /// Generic 함수 인스턴스 생성 (max(i32, 5, 10) → max_i32)
    fn instantiateGenericFunction(self: *Sema, func_name: []const u8, type_args: []const AirType) ![]const u8 {
        // 인스턴스 이름 생성: "max" + "_i32" = "max_i32"
        var instance_name = std.ArrayList(u8).init(self.allocator);
        defer instance_name.deinit();

        try instance_name.appendSlice(func_name);

        for (type_args) |ty| {
            try instance_name.appendSlice("_");
            try instance_name.appendSlice(Air.typeName(ty));
        }

        const name = try self.allocator.dupe(u8, instance_name.items);

        // 인스턴스 기록
        try self.generic_instances.append(.{
            .original_name = func_name,
            .instance_name = name,
            .type_args = try self.allocator.dupe(AirType, type_args),
        });

        return name;
    }

    /// Generic 함수 호출 처리
    pub fn handleGenericCall(self: *Sema, func_name: []const u8, type_args: []const AirType, args: []const Zir.Ref) !void {
        // Generic 함수인지 확인
        if (!self.generic_functions.contains(func_name)) {
            // 일반 함수 호출
            return;
        }

        // 인스턴스 생성
        const instance_name = try self.instantiateGenericFunction(func_name, type_args);

        // AIR 호출 명령어 생성 (실제 인스턴스 이름 사용)
        _ = try self.air.addInstruction(.{
            .call = .{
                .callee = 0, // TODO: 인스턴스 함수 참조
                .args = args,
                .return_ty = .unknown,
            },
        });

        std.debug.print("[Sema] Generic call: {s} → {s}\n", .{ func_name, instance_name });
    }

    /// Union 타입 분석 (Phase 3.2)
    fn analyzeUnionType(self: *Sema, data: Zir.Instruction.UnionBegin) !void {
        // ZIR 문자열 풀에서 Union 이름 조회
        var union_name: []const u8 = "unknown";
        var iter = self.zir.strings.iterator();
        var str_idx: u32 = 0;
        while (iter.next()) |entry| {
            if (str_idx == data.name_index) {
                union_name = entry.value_ptr.*;
                break;
            }
            str_idx += 1;
        }

        // Union 필드 정보 수집
        var fields = std.ArrayList(UnionFieldInfo).init(self.allocator);
        defer fields.deinit();

        // 간단한 구현: 필드 정보는 나중에 ZIR 스캔으로 수집
        // 현재는 필드 개수만 저장
        for (0..data.field_count) |_| {
            try fields.append(.{
                .name = "field",
                .type_ref = .unknown,
            });
        }

        // Union 타입 정보 등록
        const union_info = UnionTypeInfo{
            .name = union_name,
            .fields = try self.allocator.dupe(UnionFieldInfo, fields.items),
            .is_tagged = data.is_tagged,
        };

        try self.union_types.put(union_name, union_info);

        std.debug.print("[Sema] Union type registered: {s} ({} fields)\n", .{ union_name, data.field_count });
    }

    /// Enum 타입 분석 (Phase 3.2)
    fn analyzeEnumType(self: *Sema, data: Zir.Instruction.EnumBegin) !void {
        // ZIR 문자열 풀에서 Enum 이름 조회
        var enum_name: []const u8 = "unknown";
        var iter = self.zir.strings.iterator();
        var str_idx: u32 = 0;
        while (iter.next()) |entry| {
            if (str_idx == data.name_index) {
                enum_name = entry.value_ptr.*;
                break;
            }
            str_idx += 1;
        }

        // Enum 필드 정보 수집
        var fields = std.ArrayList(EnumFieldInfo).init(self.allocator);
        defer fields.deinit();

        // 간단한 구현: 필드 정보는 나중에 ZIR 스캔으로 수집
        // 현재는 필드 개수만 저장
        for (0..data.value_count) |i| {
            try fields.append(.{
                .name = "value",
                .value = @intCast(u64, i),  // 간단히 인덱스 할당
            });
        }

        // Enum 타입 정보 등록
        const enum_info = EnumTypeInfo{
            .name = enum_name,
            .fields = try self.allocator.dupe(EnumFieldInfo, fields.items),
            .is_tagged = data.is_tagged,
        };

        try self.enum_types.put(enum_name, enum_info);

        std.debug.print("[Sema] Enum type registered: {s} ({} values)\n", .{ enum_name, data.value_count });
    }

    /// Phase 3.3: Comptime 값 평가
    pub fn evaluateConstExpr(self: *Sema, ref: Zir.Ref) !ComptimeValue {
        if (ref >= self.zir.instructions.items.len) {
            return ComptimeValue.unknown;
        }

        const inst = self.zir.instructions.items[@intCast(usize, ref)];

        return switch (inst) {
            .load_int => |data| ComptimeValue{ .integer = data.value },
            .load_float => |data| ComptimeValue{ .float = data.value },
            .load_string => ComptimeValue.unknown,  // 문자열은 아직 처리 안함
            .binary_op => |data| blk: {
                const lhs = try self.evaluateConstExpr(data.lhs);
                const rhs = try self.evaluateConstExpr(data.rhs);

                if (lhs == .integer and rhs == .integer) {
                    const l = lhs.integer;
                    const r = rhs.integer;
                    const result = switch (data.op) {
                        .add => l + r,
                        .subtract => l - r,
                        .multiply => l * r,
                        .divide => if (r != 0) l / r else 0,
                        .modulo => if (r != 0) l % r else 0,
                        .equal => @intCast(i64, if (l == r) 1 else 0),
                        .not_equal => @intCast(i64, if (l != r) 1 else 0),
                        .less => @intCast(i64, if (l < r) 1 else 0),
                        .less_equal => @intCast(i64, if (l <= r) 1 else 0),
                        .greater => @intCast(i64, if (l > r) 1 else 0),
                        .greater_equal => @intCast(i64, if (l >= r) 1 else 0),
                        .logical_and => @intCast(i64, if (l != 0 and r != 0) 1 else 0),
                        .logical_or => @intCast(i64, if (l != 0 or r != 0) 1 else 0),
                        .bitwise_xor => l ^ r,
                        .bitwise_lshift => l << @intCast(u6, r),
                        .bitwise_rshift => l >> @intCast(u6, r),
                    };
                    break :blk ComptimeValue{ .integer = result };
                }
                break :blk ComptimeValue.unknown;
            },
            else => ComptimeValue.unknown,
        };
    }

    /// Phase 3.3: Const 식 분석
    pub fn analyzeConstExpr(self: *Sema, name: []const u8, ref: Zir.Ref) !void {
        const value = try self.evaluateConstExpr(ref);
        try self.const_values.put(name, value);

        std.debug.print("[Sema] Const expr registered: {s} = {:?}\n", .{ name, value });
    }

    /// Phase 3.3: Comptime 블록 분석
    pub fn analyzeComptimeBlock(self: *Sema, data: Zir.Instruction.comptime_begin) !void {
        std.debug.print("[Sema] Comptime block: body %{} - %{}\n", .{ data.body_start, data.body_end });

        // 블록 내 모든 명령어 처리
        var idx = data.body_start;
        while (idx <= data.body_end and idx < self.zir.instructions.items.len) : (idx += 1) {
            const inst = self.zir.instructions.items[@intCast(usize, idx)];
            if (inst == .const_expr) {
                _ = try self.analyzeInstruction(inst);
            }
        }
    }

    /// Phase 3.3: 상수 전파
    pub fn propagateConstants(self: *Sema) !void {
        var iter = self.const_values.iterator();
        while (iter.next()) |entry| {
            std.debug.print("[Sema] Propagating const: {s}\n", .{entry.key_ptr.*});
        }
    }

    /// Phase 3.4: 오버로드 해석 - 함수명과 인자 타입으로 최적의 오버로드 선택
    pub fn resolveOverload(
        self: *Sema,
        fn_name: []const u8,
        arg_types: []AirType,
    ) !Zir.Ref {
        // 1. 같은 이름의 모든 오버로드 찾기
        const signatures = self.overload_groups.get(fn_name) orelse {
            return error.FunctionNotFound;
        };

        // 2. 캐시 확인
        const cache_key = try self.makeOverloadCacheKey(fn_name, arg_types);
        if (self.overload_resolution_cache.get(cache_key)) |fn_ref| {
            return fn_ref;
        }

        // 3. 모든 후보에 대해 매칭 점수 계산
        var candidates = std.ArrayList(OverloadCandidate).init(self.allocator);
        defer candidates.deinit();

        for (signatures) |sig| {
            const score = try self.calculateMatchScore(&sig, arg_types);
            if (score > 0) {  // 유효한 매칭
                try candidates.append(.{
                    .signature = sig,
                    .match_score = score,
                    .conversions_needed = &[_]TypeConversion{},
                });
            }
        }

        // 4. 매칭되는 오버로드 확인
        if (candidates.items.len == 0) {
            return error.NoMatchingOverload;
        }

        // 5. 최고 점수 찾기
        var best_candidate = candidates.items[0];
        var best_count: usize = 1;

        for (candidates.items[1..]) |candidate| {
            if (candidate.match_score > best_candidate.match_score) {
                best_candidate = candidate;
                best_count = 1;
            } else if (candidate.match_score == best_candidate.match_score) {
                best_count += 1;  // 동점 발견
            }
        }

        // 6. 모호성 검사
        if (best_count > 1) {
            return error.AmbiguousOverload;
        }

        // 7. 캐시에 저장 후 반환
        try self.overload_resolution_cache.put(cache_key, best_candidate.signature.fn_ref);
        return best_candidate.signature.fn_ref;
    }

    /// Phase 3.4: 오버로드 매칭 점수 계산
    fn calculateMatchScore(
        self: *Sema,
        signature: *const Zir.FunctionSignature,
        arg_types: []AirType,
    ) !i32 {
        // 파라미터 개수 확인
        if (signature.param_types.len != arg_types.len) {
            return -1;  // 매칭 불가
        }

        var total_score: i32 = 0;

        // 각 파라미터에 대해 점수 계산
        for (signature.param_types, arg_types) |param_type_ref, arg_type| {
            _ = param_type_ref;  // TODO: ZIR 참조를 AIR 타입으로 변환
            const param_type = arg_type;  // 임시: 실제 타입 정보 필요

            if (self.typesEqual(param_type, arg_type)) {
                // 정확 매칭
                total_score += 100;
            } else if (self.canImplicitlyConvert(arg_type, param_type)) {
                // 암시적 변환 가능
                total_score += 50;
            } else {
                // 매칭 불가능
                return -1;
            }
        }

        return total_score;
    }

    /// 두 타입이 같은지 확인
    fn typesEqual(self: *Sema, t1: AirType, t2: AirType) bool {
        _ = self;
        return switch (t1) {
            .i32 => t2 == .i32,
            .i64 => t2 == .i64,
            .f32 => t2 == .f32,
            .f64 => t2 == .f64,
            .string => t2 == .string,
            .boolean => t2 == .boolean,
            .unknown => true,  // unknown은 모든 타입과 매칭
            else => false,
        };
    }

    /// 암시적 변환 가능 여부 확인
    fn canImplicitlyConvert(self: *Sema, from: AirType, to: AirType) bool {
        _ = self;
        return switch (from) {
            .i32 => to == .f64 or to == .f32,  // i32 → f64, f32
            .i64 => to == .f64 or to == .f32,  // i64 → f64, f32
            .boolean => to == .i32 or to == .i64,  // bool → i32, i64
            else => false,
        };
    }

    /// 오버로드 캐시 키 생성
    fn makeOverloadCacheKey(
        self: *Sema,
        fn_name: []const u8,
        arg_types: []AirType,
    ) ![]u8 {
        var buffer = std.ArrayList(u8).init(self.allocator);
        try buffer.appendSlice(fn_name);
        try buffer.appendSlice(":");
        for (arg_types) |t| {
            try buffer.appendSlice(@tagName(t));
            try buffer.appendSlice(",");
        }
        return buffer.toOwnedSlice();
    }

    /// Phase 3.5: 배열 인덱싱 타입 검사
    fn checkArrayAccess(
        self: *Sema,
        array_ty: AirType,
        index_ty: AirType,
    ) !AirType {
        _ = self;

        // 배열 또는 슬라이스인지 확인
        switch (array_ty) {
            .array => |arr| {
                // 배열: [N]T
                // 인덱스는 i32 또는 i64여야 함
                if (index_ty != .i32 and index_ty != .i64) {
                    return error.InvalidArrayIndex;
                }
                // 요소 타입 반환
                return arr.element_ty.*;
            },
            .slice => |sl| {
                // 슬라이스: []T
                // 인덱스는 i32 또는 i64여야 함
                if (index_ty != .i32 and index_ty != .i64) {
                    return error.InvalidArrayIndex;
                }
                // 요소 타입 반환
                return sl.element_ty.*;
            },
            else => {
                return error.NotIndexable;
            },
        }
    }

    /// Phase 3.5: 슬라이싱 타입 검사
    fn checkSliceAccess(
        self: *Sema,
        array_ty: AirType,
        start_ty: ?AirType,
        end_ty: ?AirType,
    ) !AirType {
        _ = self;

        // 배열 또는 슬라이스인지 확인
        const base_element_ty = switch (array_ty) {
            .array => |arr| arr.element_ty,
            .slice => |sl| sl.element_ty,
            else => return error.NotIndexable,
        };

        // 시작 인덱스 검사 (있으면)
        if (start_ty) |st| {
            if (st != .i32 and st != .i64) {
                return error.InvalidSliceBounds;
            }
        }

        // 끝 인덱스 검사 (있으면)
        if (end_ty) |et| {
            if (et != .i32 and et != .i64) {
                return error.InvalidSliceBounds;
            }
        }

        // 슬라이스 타입 반환
        return .{ .slice = .{
            .element_ty = base_element_ty,
            .is_const = switch (array_ty) {
                .slice => |sl| sl.is_const,
                else => false,
            },
        }};
    }

    /// Phase 3.5: 배열에서 슬라이스로 자동 변환
    fn arrayToSlice(self: *Sema, array_ty: AirType) !AirType {
        _ = self;

        switch (array_ty) {
            .array => |arr| {
                return .{ .slice = .{
                    .element_ty = arr.element_ty,
                    .is_const = false,
                }};
            },
            else => return error.NotConvertible,
        }
    }

    /// Phase 3.6: Defer 식 검사 (void 타입만 허용)
    fn checkDeferStmt(self: *Sema, expr_ty: AirType) !AirType {
        _ = self;

        // defer 식의 타입이 void여야 함
        switch (expr_ty) {
            .void => return .void,
            else => return error.DeferExprNotVoid,
        }
    }

