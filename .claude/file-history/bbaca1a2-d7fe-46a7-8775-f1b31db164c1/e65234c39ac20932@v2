// 🦎 Phase 3.4 Step 1: Function Overloading - Parser Tests
// test/phase3_overload_parser_test.zig

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const ast = @import("../src/ast.zig");

/// 소스 코드를 파싱하는 헬퍼 함수
fn parseProgram(source: []const u8, allocator: std.mem.Allocator) !ast.Node {
    var tokenizer = try Tokenizer.init(source, allocator);
    defer tokenizer.deinit();

    var tokens = std.ArrayList(Tokenizer.Token).init(allocator);
    defer tokens.deinit();

    while (try tokenizer.nextToken()) |token| {
        try tokens.append(token);
    }

    var parser = try Parser.init(tokens.items, source, allocator);
    defer parser.deinit();
    return try parser.parseProgram();
}

// ========== 1. Basic Function Overload ==========

test "parser_simple_function_overload" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\fn add(a: i32, b: i32) i32 { return a + b; }
        \\fn add(a: f64, b: f64) f64 { return a + b; }
    ;

    const ast_result = try parseProgram(source, allocator);

    // root 노드에 2개의 fn_decl이 포함되어야 함
    try std.testing.expect(ast_result.tag == .root);
}

