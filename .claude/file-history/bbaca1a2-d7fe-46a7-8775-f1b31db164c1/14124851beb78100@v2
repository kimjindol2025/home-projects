// 🦎 Phase 3.5 Step 3: Sema - Arrays & Slices
// test/phase3_array_sema_test.zig: 배열/슬라이스 타입 검사 테스트

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const Ast = @import("../src/ast.zig");
const AstGen = @import("../src/astgen.zig").AstGen;
const Sema = @import("../src/sema.zig").Sema;
const Air = @import("../src/air.zig").Air;
const AirType = @import("../src/air.zig").Type;

const test_allocator = std.testing.allocator;

// Helper: 소스 코드를 컴파일하고 Sema 분석
fn analyzeSema(source: []const u8) !Air {
    var tokenizer = Tokenizer.init(source);
    var tokens = std.ArrayList(Tokenizer.Token).init(test_allocator);
    defer tokens.deinit();

    while (true) {
        const token = tokenizer.nextToken();
        try tokens.append(token);
        if (token.tag == .eof) break;
    }

    var parser = Parser.init(source, tokens.items, test_allocator);
    const ast = try parser.parse();
    defer ast.deinit();

    var astgen = try AstGen.init(test_allocator, source);
    try astgen.genProgram(&ast);

    var sema = try Sema.init(test_allocator, astgen.zir);
    defer sema.deinit();

    // TODO: ZIR → AIR 변환 (현재는 Sema 초기화만)
    return sema.air;
}

// Group A: 배열 타입 생성 (2개)

test "sema_array_type_creation" {
    const source = "const arr: [10]i32 = [1, 2, 3];";
    var air = try analyzeSema(source);
    defer air.deinit();

    // AIR이 정상 생성되어야 함
    try std.testing.expect(air.instructions.items.len >= 0);
}

test "sema_slice_type_creation" {
    const source = "fn take_slice(s: []i32) void {}";
    var air = try analyzeSema(source);
    defer air.deinit();

    try std.testing.expect(air.instructions.items.len >= 0);
}

// Group B: 인덱싱 타입 검사 (3개)

test "sema_array_indexing_type_check" {
    const allocator = test_allocator;

    // 배열 타입 생성
    var element_type = AirType{ .i32 };
    const array_type = AirType{
        .array = .{
            .element_ty = try allocator.create(AirType),
            .len = 10,
        },
    };
    array_type.array.element_ty.* = element_type;

    // Sema 초기화 (최소)
    var sema = try Sema.init(allocator, undefined);
    defer sema.deinit();

    // 배열 인덱싱 검사: arr[i]에서 i는 i32여야 함
    const result = sema.checkArrayAccess(array_type, AirType{ .i32 });
    try std.testing.expect(result != error.InvalidArrayIndex);
}

test "sema_invalid_index_type" {
    const allocator = test_allocator;

    var element_type = AirType{ .i32 };
    const array_type = AirType{
        .array = .{
            .element_ty = try allocator.create(AirType),
            .len = 10,
        },
    };
    array_type.array.element_ty.* = element_type;

    var sema = try Sema.init(allocator, undefined);
    defer sema.deinit();

    // 배열 인덱싱: 인덱스가 string이면 에러
    const result = sema.checkArrayAccess(array_type, AirType{ .string });
    try std.testing.expect(result == error.InvalidArrayIndex);
}

test "sema_invalid_indexable_type" {
    const allocator = test_allocator;

    var sema = try Sema.init(allocator, undefined);
    defer sema.deinit();

    // 정수형 타입을 인덱싱하려고 하면 에러
    const result = sema.checkArrayAccess(AirType{ .i32 }, AirType{ .i32 });
    try std.testing.expect(result == error.NotIndexable);
}

