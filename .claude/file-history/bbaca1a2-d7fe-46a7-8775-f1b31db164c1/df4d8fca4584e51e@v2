// ========== 5. Multiple Union/Enum in Single Program ==========

test "astgen_multiple_types_in_program" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\union Result { ok: i32, err: string }
        \\enum Status { pending, running, done }
    ;

    const zir = try generateZir(source, allocator);
    defer zir.deinit();

    var union_count: u32 = 0;
    var enum_count: u32 = 0;

    for (zir.instructions.items) |inst| {
        if (inst == .union_begin) union_count += 1;
        if (inst == .enum_begin) enum_count += 1;
    }

    try std.testing.expect(union_count == 1);
    try std.testing.expect(enum_count == 1);
}

