// 🦎 Phase 3.2 Step 2: Union & Enum AstGen Tests
// test/phase3_union_enum_astgen_test.zig

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const AstGen = @import("../src/astgen.zig").AstGen;
const Zir = @import("../src/zir.zig").Zir;
const ast = @import("../src/ast.zig");

/// 소스 코드를 AstGen으로 분석하는 헬퍼 함수
fn generateZir(source: []const u8, allocator: std.mem.Allocator) !Zir {
    var tokenizer = try Tokenizer.init(source, allocator);
    defer tokenizer.deinit();

    var tokens = std.ArrayList(Tokenizer.Token).init(allocator);
    defer tokens.deinit();

    while (try tokenizer.nextToken()) |token| {
        try tokens.append(token);
    }

    var parser = try Parser.init(tokens.items, source, allocator);
    defer parser.deinit();
    const ast_result = try parser.parseProgram();

    var astgen = try AstGen.init(allocator, source);
    try astgen.genProgram(&ast_result);

    return astgen.zir;
}

// ========== 1. Simple Union ZIR Generation ==========

test "astgen_simple_union_generates_union_begin" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "union Result { ok: i32, err: string }";

    const zir = try generateZir(source, allocator);
    defer zir.deinit();

    // ZIR instructions should contain union_begin
    var found_union_begin = false;
    for (zir.instructions.items) |inst| {
        if (inst == .union_begin) {
            found_union_begin = true;
            const data = inst.union_begin;
            try std.testing.expect(data.field_count == 2);
        }
    }
    try std.testing.expect(found_union_begin);
}

test "astgen_union_field_count" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "union Value { a: i32, b: f64, c: string }";

    const zir = try generateZir(source, allocator);
    defer zir.deinit();

    var union_field_count: u32 = 0;
    for (zir.instructions.items) |inst| {
        if (inst == .union_field) {
            union_field_count += 1;
        }
    }

    try std.testing.expect(union_field_count == 3);
}

