// 🦎 Phase 3.4 Step 3: Function Overloading - Sema Tests
// test/phase3_overload_sema_test.zig

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const AstGen = @import("../src/astgen.zig").AstGen;
const Sema = @import("../src/sema.zig").Sema;
const AirType = @import("../src/air.zig").Type;
const Zir = @import("../src/zir.zig").Zir;

/// 소스 코드를 Sema 분석까지 수행하는 헬퍼 함수
fn compileToSema(source: []const u8, allocator: std.mem.Allocator) !*Sema {
    var tokenizer = try Tokenizer.init(source, allocator);
    defer tokenizer.deinit();

    var tokens = std.ArrayList(Tokenizer.Token).init(allocator);
    defer tokens.deinit();

    while (try tokenizer.nextToken()) |token| {
        try tokens.append(token);
    }

    var parser = try Parser.init(tokens.items, source, allocator);
    defer parser.deinit();
    const ast = try parser.parseProgram();

    var astgen = try AstGen.init(allocator, source);
    try astgen.genProgram(&ast);
    defer astgen.deinit();

    var sema = try allocator.create(Sema);
    sema.* = try Sema.init(allocator, astgen.zir);
    return sema;
}

// ========== 1. Basic Exact Matching ==========

test "sema_exact_match_overload" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\fn add(a: i32, b: i32) i32 { return a + b; }
        \\fn add(a: f64, b: f64) f64 { return a + b; }
    ;

    const sema = try compileToSema(source, allocator);
    defer sema.deinit();

    // overload_groups에 "add" 그룹이 있어야 함
    try std.testing.expect(sema.overload_groups.contains("add"));

    // "add" 오버로드 그룹 조회
    const signatures = sema.overload_groups.get("add").?;
    try std.testing.expect(signatures.len == 2);
}

