// ========== 4. Cache Key Generation ==========

test "sema_overload_cache_key_generation" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "fn dummy() {}";
    const sema = try compileToSema(source, allocator);
    defer sema.deinit();

    const key1 = try sema.makeOverloadCacheKey("max", &[_]AirType{ .i32, .i32 });
    const key2 = try sema.makeOverloadCacheKey("max", &[_]AirType{ .f64, .f64 });

    try std.testing.expect(!std.mem.eql(u8, key1, key2));
    try std.testing.expect(std.mem.startsWith(u8, key1, "max:"));
}

// ========== 5. Multiple Overload Groups ==========

test "sema_multiple_overload_groups" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\fn max(a: i32, b: i32) i32 { return a; }
        \\fn max(a: f64, b: f64) f64 { return a; }
        \\fn min(a: i32, b: i32) i32 { return a; }
        \\fn min(a: f64, b: f64) f64 { return a; }
    ;

    const sema = try compileToSema(source, allocator);
    defer sema.deinit();

    try std.testing.expect(sema.overload_groups.contains("max"));
    try std.testing.expect(sema.overload_groups.contains("min"));

    const max_sigs = sema.overload_groups.get("max").?;
    const min_sigs = sema.overload_groups.get("min").?;

    try std.testing.expect(max_sigs.len == 2);
    try std.testing.expect(min_sigs.len == 2);
}

