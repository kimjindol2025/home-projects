// ========== 9. Overload with Mixed Names ==========

test "sema_overload_mixed_function_names" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\fn add(a: i32, b: i32) i32 { return a + b; }
        \\fn subtract(a: i32, b: i32) i32 { return a - b; }
        \\fn add(a: f64, b: f64) f64 { return a + b; }
        \\fn multiply(a: i32, b: i32) i32 { return a * b; }
    ;

    const sema = try compileToSema(source, allocator);
    defer sema.deinit();

    // "add" 오버로드 그룹: 2개
    const add_sigs = sema.overload_groups.get("add").?;
    try std.testing.expect(add_sigs.len == 2);

    // "subtract", "multiply"는 단일 함수 (오버로드 그룹이 아님)
    try std.testing.expect(!sema.overload_groups.contains("subtract"));
    try std.testing.expect(!sema.overload_groups.contains("multiply"));
}
