test "astgen_multiple_defers_same_scope" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "fn main() { defer cleanup1(); defer cleanup2(); }";
    var astgen = try createAstGen(allocator, source);
    defer astgen.deinit();

    // 같은 스코프에서 여러 defer의 인덱스 증가 확인
    var defer_count: usize = 0;
    var last_defer_index: u32 = 0;
    for (astgen.zir.instructions.items) |inst| {
        if (inst == .defer_stmt) {
            if (defer_count > 0) {
                // 같은 scope_id에서 defer_index가 증가해야 함
                try std.testing.expect(inst.defer_stmt.defer_index > last_defer_index or inst.defer_stmt.scope_id != astgen.zir.instructions.items[@intCast(defer_count - 1)].defer_stmt.scope_id);
            }
            last_defer_index = inst.defer_stmt.defer_index;
            defer_count += 1;
        }
    }
    try std.testing.expect(defer_count >= 2);
}

test "astgen_nested_scopes_defer" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "fn test() { { defer a(); } { defer b(); } }";
    var astgen = try createAstGen(allocator, source);
    defer astgen.deinit();

    // 중첩된 스코프의 defer 명령어 확인
    var defer_count: usize = 0;
    var scope_ids = std.AutoHashMap(u32, bool).init(allocator);
    defer scope_ids.deinit();

    for (astgen.zir.instructions.items) |inst| {
        if (inst == .defer_stmt) {
            defer_count += 1;
            try scope_ids.put(inst.defer_stmt.scope_id, true);
        }
    }
    try std.testing.expect(defer_count >= 2);
}

