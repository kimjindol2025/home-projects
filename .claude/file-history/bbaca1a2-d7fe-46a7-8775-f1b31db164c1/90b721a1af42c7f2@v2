test "astgen_multiple_defer_ordering" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "fn main() { defer print(\"1\"); defer print(\"2\"); defer print(\"3\"); }";
    var astgen = try createAstGen(allocator, source);
    defer astgen.deinit();

    // 3개의 defer 명령어와 순서 확인
    var defers = std.ArrayList(u32).init(allocator);
    defer defers.deinit();

    for (astgen.zir.instructions.items) |inst| {
        if (inst == .defer_stmt) {
            try defers.append(inst.defer_stmt.defer_index);
        }
    }

    try std.testing.expect(defers.items.len == 3);
    try std.testing.expect(defers.items[0] == 0);
    try std.testing.expect(defers.items[1] == 1);
    try std.testing.expect(defers.items[2] == 2);
}

