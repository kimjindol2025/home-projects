test "astgen_defer_index_generation" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "fn main() { defer a(); defer b(); defer c(); }";
    var astgen = try createAstGen(allocator, source);
    defer astgen.deinit();

    // defer 인덱스가 순차적으로 증가하는지 확인
    var indices = std.ArrayList(u32).init(allocator);
    defer indices.deinit();

    for (astgen.zir.instructions.items) |inst| {
        if (inst == .defer_stmt) {
            try indices.append(inst.defer_stmt.defer_index);
        }
    }

    try std.testing.expect(indices.items.len >= 3);
    for (indices.items[1..], 1..) |idx, i| {
        // 같은 스코프라면 인덱스가 증가해야 함
        if (i > 0) {
            try std.testing.expect(idx >= indices.items[i - 1]);
        }
    }
}

