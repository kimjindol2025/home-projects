// ========== 10. Instance Tracking ==========

test "sema_instance_tracking" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "fn max(comptime T: type, a: T, b: T) T { return a; }";

    var sema = try analyzeSoure(source, allocator);
    defer sema.deinit();

    // 세 개의 다른 타입으로 인스턴시화
    _ = try sema.instantiateGenericFunction("max", &.{.i32});
    _ = try sema.instantiateGenericFunction("max", &.{.i64});
    _ = try sema.instantiateGenericFunction("max", &.{.f64});

    // 세 개의 인스턴스가 기록됨
    try std.testing.expect(sema.generic_instances.items.len == 3);

    // 원본 함수 이름이 모두 "max"
    for (sema.generic_instances.items) |instance| {
        try std.testing.expect(std.mem.eql(u8, instance.original_name, "max"));
    }
}
