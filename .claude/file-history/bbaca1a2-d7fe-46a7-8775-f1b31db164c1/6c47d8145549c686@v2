// ========== 3. Generic 함수 인스턴시화 ==========

test "sema_generic_function_instantiation" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "fn max(comptime T: type, a: T, b: T) T { return a; }";

    var sema = try analyzeSoure(source, allocator);
    defer sema.deinit();

    // Generic 함수 인스턴스 생성: max(i32, 5, 10)
    const instance_name = try sema.instantiateGenericFunction("max", &.{.i32});

    // 인스턴스 이름이 "max_i32"
    try std.testing.expect(std.mem.eql(u8, instance_name, "max_i32"));

    // 인스턴스가 기록됨
    try std.testing.expect(sema.generic_instances.items.len == 1);
}

