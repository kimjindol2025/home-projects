// 🦎 Mini Zig Compiler - Phase 2.3: ZIR Definition
// src/zir.zig: Zig Intermediate Representation (Untyped)

const std = @import("std");

/// Phase 3.4: 함수 시그니처 (오버로드 메타데이터)
pub const FunctionSignature = struct {
    name_index: u32,          // 함수 이름 (string pool)
    param_types: []Ref,       // 파라미터 타입들
    return_type: Ref,         // 반환 타입
    fn_ref: Ref,              // fn_begin 지시어 위치
};

/// ZIR - Untyped Intermediate Representation
///
/// 특징:
/// - Untyped: 타입 정보 제거
/// - Bytecode-like: 스택 기반 명령어
/// - Per-file: 파일 단위로 생성
/// - Basic-block-like: 기본 블록 단위의 제어 흐름
pub const Zir = struct {
    instructions: std.ArrayList(Instruction),
    extra: std.ArrayList(u32),           // 추가 데이터 (arg lists, strings, etc.)
    strings: std.StringHashMap([]const u8), // 문자열 풀
    allocator: std.mem.Allocator,

    pub const Instruction = union(enum) {
        // 리터럴
        load_int: struct { value: i64 },
        load_float: struct { value: f64 },
        load_string: struct { index: u32 },  // strings 풀의 인덱스

        // 변수
        load_var: struct { name_index: u32 },
        store_var: struct { name_index: u32, value: Ref },

        // 연산자
        binary_op: struct { op: BinaryOp, lhs: Ref, rhs: Ref },
        unary_op: struct { op: UnaryOp, operand: Ref },

        // 함수 (Phase 2)
        fn_begin: struct { name_index: u32, params: []Ref },
        fn_end,

        // Generic 함수 (Phase 3.1)
        generic_fn_begin: struct {
            name_index: u32,
            comptime_param_count: u32,  // comptime 파라미터 개수
            params: []Ref,              // 모든 파라미터 (comptime + regular)
        },

        // Union Type (Phase 3.2)
        union_begin: struct {
            name_index: u32,
            field_count: u32,
            is_tagged: bool = false,
        },
        union_field: struct {
            field_name_index: u32,
            field_type: Ref,
        },

        // Enum Type (Phase 3.2)
        enum_begin: struct {
            name_index: u32,
            value_count: u32,
            is_tagged: bool = false,
        },
        enum_value: struct {
            value_name_index: u32,
            value: ?Ref = null,
        },

        // Comptime Programming (Phase 3.3)
        comptime_begin: struct {
            body_start: Ref,  // 본체 시작 지시어
            body_end: Ref,    // 본체 끝 지시어
        },

        const_expr: struct {
            name_index: u32,   // 상수 이름 (string pool)
            type_index: ?u32,  // 타입 (없으면 추론)
            value: Ref,        // 값 지시어
        },

        eval_at_comptime: struct {
            expr: Ref,         // 평가할 식
        },

        // Function Overloading (Phase 3.4)
        overload_group: struct {
            name_index: u32,
            signatures: []FunctionSignature,
            default_fn: u32,  // 선호 오버로드 (첫번째)
        },

        // 제어 흐름
        call: struct { callee: Ref, args: []Ref },
        br: Ref,                    // 무조건 분기 (점프)
        cond_br: struct { cond: Ref, then_block: Ref, else_block: ?Ref },
        return_val: ?Ref,           // return (없으면 void)

        // 블록
        block_begin: struct { label: u32 },
        block_end,

        // 배열/메모리
        array_literal: struct { elements: []Ref },
        index_access: struct { array: Ref, index: Ref },
        member_access: struct { object: Ref, field_index: u32 },

        // Phase 3.5: 배열/슬라이스 타입과 연산
        array_type: struct {
            element_type: Ref,
            size: ?u32,            // null이면 슬라이스
            is_const: bool = false, // []const T
        },

        array_access: struct {
            array: Ref,
            index: Ref,
        },

        slice_access: struct {
            array: Ref,
            start: ?Ref,  // null이면 처음부터
            end: ?Ref,    // null이면 끝까지
        },

        array_length: struct {
            array: Ref,
        },

        // 제어 흐름 (advanced)
        loop_begin: struct { label: u32 },
        loop_end,
        break_loop: struct { label: u32 },
        continue_loop: struct { label: u32 },

        // Phase 3.6: Defer & Resource Management
        defer_stmt: struct {
            expr: Ref,              // defer할 식
            scope_id: u32,          // 스코프 ID
            defer_index: u32,       // 이 스코프 내 몇 번째 defer인가
        },

        scope_enter: struct {
            scope_id: u32,
            deferred_count: u32,    // 이 스코프의 defer 개수
        },

        scope_exit: struct {
            scope_id: u32,
        },

        // 기타
        noop,  // 아무것도 하지 않음 (placeholder)
    };

    pub const Ref = u32;  // Instruction 인덱스

    pub const BinaryOp = enum {
        add, sub, mul, div, mod,
        eq, ne, lt, le, gt, ge,
        logical_and, logical_or,
        bitwise_and, bitwise_or, bitwise_xor,
        lshift, rshift,
    };

    pub const UnaryOp = enum {
        negate, not, bitwise_not,
    };

    pub fn init(allocator: std.mem.Allocator) Zir {
        return .{
            .instructions = std.ArrayList(Instruction).init(allocator),
            .extra = std.ArrayList(u32).init(allocator),
            .strings = std.StringHashMap([]const u8).init(allocator),
            .allocator = allocator,
        };
    }

    pub fn deinit(self: *Zir) void {
        self.instructions.deinit();
        self.extra.deinit();
        self.strings.deinit();
    }

    /// 명령어 추가 및 Ref 반환
    pub fn addInstruction(self: *Zir, inst: Instruction) !Ref {
        const index: Ref = @intCast(self.instructions.items.len);
        try self.instructions.append(inst);
        return index;
    }

    /// 문자열 추가 및 인덱스 반환
    pub fn addString(self: *Zir, text: []const u8) !u32 {
        if (self.strings.get(text)) |_| {
            // 이미 있으면 현재 인덱스 반환
            return @intCast(self.strings.count() - 1);
        }

        const index: u32 = @intCast(self.strings.count());
        try self.strings.put(text, text);
        return index;
    }

    /// 추가 데이터 저장소에 값 추가
    pub fn addExtra(self: *Zir, value: u32) !u32 {
        const index: u32 = @intCast(self.extra.items.len);
        try self.extra.append(value);
        return index;
    }
};

/// ZIR 디버깅용 출력 함수
pub fn printZir(zir: *const Zir, indent: usize) void {
    const spaces = " " ** indent;
    const stdout = std.io.getStdOut().writer();

    stdout.print("{s}=== ZIR Instructions ===\n", .{spaces}) catch {};

    for (zir.instructions.items, 0..) |inst, idx| {
        stdout.print("{s}[{}] ", .{ spaces, idx }) catch {};

        switch (inst) {
            .load_int => |data| {
                stdout.print("load_int {}\n", .{data.value}) catch {};
            },
            .load_float => |data| {
                stdout.print("load_float {}\n", .{data.value}) catch {};
            },
            .load_string => |data| {
                stdout.print("load_string @{}\n", .{data.index}) catch {};
            },
            .load_var => |data| {
                stdout.print("load_var @{}\n", .{data.name_index}) catch {};
            },
            .store_var => |data| {
                stdout.print("store_var @{} = %{}\n", .{ data.name_index, data.value }) catch {};
            },
            .binary_op => |data| {
                stdout.print("binary_op {:s} %{} %{}\n", .{ @tagName(data.op), data.lhs, data.rhs }) catch {};
            },
            .unary_op => |data| {
                stdout.print("unary_op {:s} %{}\n", .{ @tagName(data.op), data.operand }) catch {};
            },
            .fn_begin => |data| {
                stdout.print("fn_begin @{} (params: {})\n", .{ data.name_index, data.params.len }) catch {};
            },
            .generic_fn_begin => |data| {
                stdout.print("generic_fn_begin @{} (comptime: {}, total: {})\n", .{ data.name_index, data.comptime_param_count, data.params.len }) catch {};
            },
            .union_begin => |data| {
                stdout.print("union_begin @{} (fields: {}, tagged: {})\n", .{ data.name_index, data.field_count, data.is_tagged }) catch {};
            },
            .union_field => |data| {
                stdout.print("union_field @{} type:%{}\n", .{ data.field_name_index, data.field_type }) catch {};
            },
            .enum_begin => |data| {
                stdout.print("enum_begin @{} (values: {}, tagged: {})\n", .{ data.name_index, data.value_count, data.is_tagged }) catch {};
            },
            .enum_value => |data| {
                if (data.value) |v| {
                    stdout.print("enum_value @{} value:%{}\n", .{ data.value_name_index, v }) catch {};
                } else {
                    stdout.print("enum_value @{}\n", .{data.value_name_index}) catch {};
                }
            },

            // Comptime Programming (Phase 3.3)
            .comptime_begin => |data| {
                stdout.print("comptime_begin (body: %{} - %{})\n", .{ data.body_start, data.body_end }) catch {};
            },
            .const_expr => |data| {
                if (data.type_index) |type_idx| {
                    stdout.print("const_expr @{} type:@{} value:%{}\n", .{ data.name_index, type_idx, data.value }) catch {};
                } else {
                    stdout.print("const_expr @{} value:%{}\n", .{ data.name_index, data.value }) catch {};
                }
            },
            .eval_at_comptime => |data| {
                stdout.print("eval_at_comptime %{}\n", .{data.expr}) catch {};
            },

            .overload_group => |data| {
                stdout.print("overload_group @{} (signatures: {}, default: {})\n", .{ data.name_index, data.signatures.len, data.default_fn }) catch {};
            },

            .fn_end => {
                stdout.print("fn_end\n", .{}) catch {};
            },
            .call => |data| {
                stdout.print("call %{} (args: {})\n", .{ data.callee, data.args.len }) catch {};
            },
            .return_val => |ret| {
                if (ret) |r| {
                    stdout.print("return %{}\n", .{r}) catch {};
                } else {
                    stdout.print("return void\n", .{}) catch {};
                }
            },
            .block_begin => |data| {
                stdout.print("block_begin @{}\n", .{data.label}) catch {};
            },
            .block_end => {
                stdout.print("block_end\n", .{}) catch {};
            },
            .array_literal => |data| {
                stdout.print("array_literal (elements: {})\n", .{data.elements.len}) catch {};
            },
            .array_type => |data| {
                if (data.size) |sz| {
                    stdout.print("array_type [{}]%{} const={}\n", .{ sz, data.element_type, data.is_const }) catch {};
                } else {
                    stdout.print("array_type []%{} const={}\n", .{ data.element_type, data.is_const }) catch {};
                }
            },
            .array_access => |data| {
                stdout.print("array_access %{}[%{}]\n", .{ data.array, data.index }) catch {};
            },
            .slice_access => |data| {
                const start_str = if (data.start) |s| std.fmt.allocPrint(std.io.getStdOut().writer(), "%{}", .{s}) else "null";
                const end_str = if (data.end) |e| std.fmt.allocPrint(std.io.getStdOut().writer(), "%{}", .{e}) else "null";
                stdout.print("slice_access %{}[{}..{}]\n", .{ data.array, if (data.start != null) "%" else "", if (data.end != null) "%" else "" }) catch {};
            },
            .array_length => |data| {
                stdout.print("array_length %{}\n", .{data.array}) catch {};
            },
            .noop => {
                stdout.print("noop\n", .{}) catch {};
            },
            else => {
                stdout.print("{s}\n", .{@tagName(inst)}) catch {};
            },
        }
    }

    stdout.print("{s}=== Strings ===\n", .{spaces}) catch {};
    var iter = zir.strings.iterator();
    var idx: u32 = 0;
    while (iter.next()) |entry| {
        stdout.print("{s}@{}: \"{s}\"\n", .{ spaces, idx, entry.value_ptr.* }) catch {};
        idx += 1;
    }
}
