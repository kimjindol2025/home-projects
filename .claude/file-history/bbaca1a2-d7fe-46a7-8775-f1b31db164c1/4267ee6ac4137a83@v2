// 🦎 Phase 3.8: Pattern Matching - Parser Tests
// test/phase3_pattern_parser_test.zig

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const Ast = @import("../src/ast.zig");
const Node = Ast.Node;

fn createParser(allocator: std.mem.Allocator, source: []const u8) !Parser {
    var tokenizer = Tokenizer.init(source);
    var tokens = std.ArrayList(Tokenizer.Token).init(allocator);
    defer tokens.deinit();

    while (true) {
        const token = tokenizer.nextToken();
        try tokens.append(token);
        if (token.tag == .eof) break;
    }

    return Parser.init(try tokens.toOwnedSlice(), source, allocator);
}

// ============================================================================
// Group A: 기본 switch (2개)
// ============================================================================

test "parser_switch_value_pattern" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "fn main() { switch (value) { 1 => print(\"one\"), } }";
    var parser = try createParser(allocator, source);
    defer parser.deinit();

    const ast = try parser.parseProgram();
    defer ast.deinit();

    try std.testing.expect(ast.root.tag == .root);
    const fn_node = ast.root.data.block[0];
    try std.testing.expect(fn_node.tag == .fn_decl);

    const body = fn_node.data.fn_decl.body;
    try std.testing.expect(body.tag == .block);
    try std.testing.expect(body.data.block.len >= 1);

    const switch_stmt = body.data.block[0];
    try std.testing.expect(switch_stmt.tag == .switch_expr);
}

