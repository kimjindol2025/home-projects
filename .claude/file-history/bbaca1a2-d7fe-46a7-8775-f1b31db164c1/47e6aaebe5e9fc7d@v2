// 🦎 Phase 3.7: Error Handling - Sema Tests
// test/phase3_error_sema_test.zig

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const Ast = @import("../src/ast.zig");
const AstGen = @import("../src/astgen.zig").AstGen;
const Sema = @import("../src/sema.zig").Sema;

fn createSema(allocator: std.mem.Allocator, source: []const u8) !Sema {
    var tokenizer = Tokenizer.init(source);
    var tokens = std.ArrayList(Tokenizer.Token).init(allocator);
    defer tokens.deinit();

    while (true) {
        const token = tokenizer.nextToken();
        try tokens.append(token);
        if (token.tag == .eof) break;
    }

    var parser = try Parser.init(try tokens.toOwnedSlice(), source, allocator);
    const ast = try parser.parseProgram();
    defer ast.deinit();

    var astgen = try AstGen.init(allocator, source);
    try astgen.genProgram(&ast);
    defer astgen.deinit();

    return try Sema.init(allocator, astgen.zir);
}

// ============================================================================
// Group A: Try 타입 검증 (2개)
// ============================================================================

test "sema_try_type_inference" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "fn getValue() -> i32 { 42 } fn main() { try getValue(); }";
    var sema = try createSema(allocator, source);
    defer sema.deinit();

    // try getValue()는 i32 타입 반환
}

