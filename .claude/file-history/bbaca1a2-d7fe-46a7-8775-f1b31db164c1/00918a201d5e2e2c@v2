// 🦎 Mini Zig Compiler - Phase 2.1: Tokenizer
// src/tokenizer.zig: 소스코드 → Token 스트림

const std = @import("std");

pub const Location = struct {
    line: usize,
    column: usize,
    start: usize,
    end: usize,
};

pub const Token = struct {
    tag: Tag,
    loc: Location,

    pub const Tag = enum {
        // Keywords
        fn_,
        const_,
        var_,
        if_,
        else_,
        while_,
        for_,
        return_,
        struct_,
        enum_,
        union_,
        error_,
        try_,
        catch_,
        pub_,
        inline_,
        comptime_,

        // Literals
        integer,
        float,
        string,
        char_literal,
        true_,
        false_,
        null_,

        // Identifiers & types
        identifier,

        // Operators
        plus,          // +
        minus,         // -
        star,          // *
        slash,         // /
        percent,       // %
        equal,         // =
        equal_equal,   // ==
        bang,          // !
        bang_equal,    // !=
        less,          // <
        less_equal,    // <=
        greater,       // >
        greater_equal, // >=
        ampersand,     // &
        pipe,          // |
        caret,         // ^
        tilde,         // ~
        lshift,        // <<
        rshift,        // >>
        and_,          // and
        or_,           // or
        not_,          // not
        dot,           // .
        dot_dot,       // ..
        arrow,         // =>
        question,      // ?
        colon,         // :
        double_colon,  // ::

        // Delimiters
        lparen,        // (
        rparen,        // )
        lbrace,        // {
        rbrace,        // }
        lbracket,      // [
        rbracket,      // ]
        semicolon,     // ;
        comma,         // ,

        // Special
        eof,
        invalid,
    };

    pub fn lexeme(self: Token, source: []const u8) []const u8 {
        return source[self.loc.start..self.loc.end];
    }
};

pub const Tokenizer = struct {
    source: []const u8,
    pos: usize,
    line: usize,
    column: usize,
    line_start: usize,

    pub fn init(source: []const u8) Tokenizer {
        return .{
            .source = source,
            .pos = 0,
            .line = 1,
            .column = 1,
            .line_start = 0,
        };
    }

    pub fn nextToken(self: *Tokenizer) Token {
        // Skip whitespace and comments
        while (self.pos < self.source.len) {
            const c = self.source[self.pos];

            if (isWhitespace(c)) {
                if (c == '\n') {
                    self.line += 1;
                    self.line_start = self.pos + 1;
                    self.column = 1;
                } else {
                    self.column += 1;
                }
                self.pos += 1;
                continue;
            }

            // Line comment
            if (c == '/' and self.peek() == '/') {
                while (self.pos < self.source.len and self.source[self.pos] != '\n') {
                    self.pos += 1;
                }
                continue;
            }

            // Block comment
            if (c == '/' and self.peek() == '*') {
                self.pos += 2;
                self.column += 2;
                while (self.pos < self.source.len - 1) {
                    if (self.source[self.pos] == '*' and self.source[self.pos + 1] == '/') {
                        self.pos += 2;
                        self.column += 2;
                        break;
                    }
                    if (self.source[self.pos] == '\n') {
                        self.line += 1;
                        self.line_start = self.pos + 1;
                        self.column = 1;
                    } else {
                        self.column += 1;
                    }
                    self.pos += 1;
                }
                continue;
            }

            break;
        }

        if (self.pos >= self.source.len) {
            return Token{
                .tag = .eof,
                .loc = .{
                    .line = self.line,
                    .column = self.column,
                    .start = self.pos,
                    .end = self.pos,
                },
            };
        }

        const start = self.pos;
        const start_column = self.column;
        const c = self.source[self.pos];

        // Number literal
        if (isDigit(c)) {
            return self.scanNumber(start, start_column);
        }

        // String literal
        if (c == '"') {
            return self.scanString(start, start_column);
        }

        // Character literal
        if (c == '\'') {
            return self.scanCharLiteral(start, start_column);
        }

        // Identifier or keyword
        if (isIdentifierStart(c)) {
            return self.scanIdentifier(start, start_column);
        }

        // Operators and delimiters
        return self.scanOperator(start, start_column);
    }

    fn scanNumber(self: *Tokenizer, start: usize, start_column: usize) Token {
        while (self.pos < self.source.len and isDigit(self.source[self.pos])) {
            self.pos += 1;
            self.column += 1;
        }

        // Float
        if (self.pos < self.source.len and self.source[self.pos] == '.') {
            self.pos += 1;
            self.column += 1;

            while (self.pos < self.source.len and isDigit(self.source[self.pos])) {
                self.pos += 1;
                self.column += 1;
            }

            return Token{
                .tag = .float,
                .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos },
            };
        }

        return Token{
            .tag = .integer,
            .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos },
        };
    }

    fn scanString(self: *Tokenizer, start: usize, start_column: usize) Token {
        self.pos += 1; // Skip opening "
        self.column += 1;

        while (self.pos < self.source.len and self.source[self.pos] != '"') {
            if (self.source[self.pos] == '\\') {
                self.pos += 2;
                self.column += 2;
            } else if (self.source[self.pos] == '\n') {
                self.line += 1;
                self.line_start = self.pos + 1;
                self.column = 1;
                self.pos += 1;
            } else {
                self.pos += 1;
                self.column += 1;
            }
        }

        if (self.pos < self.source.len) {
            self.pos += 1; // Skip closing "
            self.column += 1;
        }

        return Token{
            .tag = .string,
            .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos },
        };
    }

    fn scanCharLiteral(self: *Tokenizer, start: usize, start_column: usize) Token {
        self.pos += 1;
        self.column += 1;

        if (self.source[self.pos] == '\\') {
            self.pos += 2;
            self.column += 2;
        } else {
            self.pos += 1;
            self.column += 1;
        }

        if (self.pos < self.source.len and self.source[self.pos] == '\'') {
            self.pos += 1;
            self.column += 1;
        }

        return Token{
            .tag = .char_literal,
            .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos },
        };
    }

    fn scanIdentifier(self: *Tokenizer, start: usize, start_column: usize) Token {
        while (self.pos < self.source.len and isIdentifierContinue(self.source[self.pos])) {
            self.pos += 1;
            self.column += 1;
        }

        const text = self.source[start..self.pos];
        const tag = getKeywordTag(text) orelse .identifier;

        return Token{
            .tag = tag,
            .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos },
        };
    }

    fn scanOperator(self: *Tokenizer, start: usize, start_column: usize) Token {
        const c = self.source[self.pos];
        self.pos += 1;
        self.column += 1;

        const tag: Token.Tag = switch (c) {
            '+' => .plus,
            '-' => {
                if (self.pos < self.source.len and self.source[self.pos] == '>') {
                    self.pos += 1;
                    self.column += 1;
                    return Token{ .tag = .arrow, .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos } };
                }
                return Token{ .tag = .minus, .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos } };
            },
            '*' => .star,
            '/' => .slash,
            '%' => .percent,
            '=' => {
                if (self.pos < self.source.len and self.source[self.pos] == '=') {
                    self.pos += 1;
                    self.column += 1;
                    return Token{ .tag = .equal_equal, .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos } };
                }
                return Token{ .tag = .equal, .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos } };
            },
            '!' => {
                if (self.pos < self.source.len and self.source[self.pos] == '=') {
                    self.pos += 1;
                    self.column += 1;
                    return Token{ .tag = .bang_equal, .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos } };
                }
                return Token{ .tag = .bang, .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos } };
            },
            '<' => {
                if (self.pos < self.source.len) {
                    if (self.source[self.pos] == '=') {
                        self.pos += 1;
                        self.column += 1;
                        return Token{ .tag = .less_equal, .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos } };
                    } else if (self.source[self.pos] == '<') {
                        self.pos += 1;
                        self.column += 1;
                        return Token{ .tag = .lshift, .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos } };
                    }
                }
                return Token{ .tag = .less, .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos } };
            },
            '>' => {
                if (self.pos < self.source.len) {
                    if (self.source[self.pos] == '=') {
                        self.pos += 1;
                        self.column += 1;
                        return Token{ .tag = .greater_equal, .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos } };
                    } else if (self.source[self.pos] == '>') {
                        self.pos += 1;
                        self.column += 1;
                        return Token{ .tag = .rshift, .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos } };
                    }
                }
                return Token{ .tag = .greater, .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos } };
            },
            '&' => .ampersand,
            '|' => .pipe,
            '^' => .caret,
            '~' => .tilde,
            '.' => {
                if (self.pos < self.source.len and self.source[self.pos] == '.') {
                    self.pos += 1;
                    self.column += 1;
                    return Token{ .tag = .dot_dot, .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos } };
                }
                return Token{ .tag = .dot, .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos } };
            },
            '?' => .question,
            ':' => {
                if (self.pos < self.source.len and self.source[self.pos] == ':') {
                    self.pos += 1;
                    self.column += 1;
                    return Token{ .tag = .double_colon, .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos } };
                }
                return Token{ .tag = .colon, .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos } };
            },
            '(' => .lparen,
            ')' => .rparen,
            '{' => .lbrace,
            '}' => .rbrace,
            '[' => .lbracket,
            ']' => .rbracket,
            ';' => .semicolon,
            ',' => .comma,
            else => .invalid,
        };

        return Token{
            .tag = tag,
            .loc = .{ .line = self.line, .column = start_column, .start = start, .end = self.pos },
        };
    }

    fn peek(self: *Tokenizer) u8 {
        if (self.pos + 1 >= self.source.len) return 0;
        return self.source[self.pos + 1];
    }
};

fn isWhitespace(c: u8) bool {
    return c == ' ' or c == '\t' or c == '\n' or c == '\r';
}

fn isDigit(c: u8) bool {
    return c >= '0' and c <= '9';
}

fn isAlpha(c: u8) bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_';
}

fn isIdentifierStart(c: u8) bool {
    return isAlpha(c);
}

fn isIdentifierContinue(c: u8) bool {
    return isAlpha(c) or isDigit(c);
}

fn getKeywordTag(text: []const u8) ?Token.Tag {
    return switch (std.meta.stringToEnum(Token.Tag, text ++ "_") orelse return null) {
        inline .fn_, .const_, .var_, .if_, .else_, .while_, .for_, .return_, .struct_, .enum_, .union_, .error_, .try_, .catch_, .pub_, .inline_, .comptime_, .true_, .false_, .null_, .and_, .or_, .not_ => |tag| tag,
        else => null,
    };
}

// Test
pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "fn add(a: i32, b: i32) -> i32 { return a + b; }";

    var tokenizer = Tokenizer.init(source);
    var tokens = std.ArrayList(Token).init(allocator);
    defer tokens.deinit();

    while (true) {
        const token = tokenizer.nextToken();
        try tokens.append(token);
        std.debug.print("Token: {s:15} = \"{s}\"\n", .{ @tagName(token.tag), token.lexeme(source) });

        if (token.tag == .eof) break;
    }
}
