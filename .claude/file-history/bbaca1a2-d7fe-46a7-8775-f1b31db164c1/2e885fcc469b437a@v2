const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const AstGen = @import("../src/astgen.zig").AstGen;
const Zir = @import("../src/zir.zig").Zir;
const ast_module = @import("../src/ast.zig");

/// 소스 코드를 ZIR로 변환하는 헬퍼 함수
fn compileToZir(source: []const u8, allocator: std.mem.Allocator) !*Zir {
    var tokenizer = try Tokenizer.init(source, allocator);
    defer tokenizer.deinit();

    var tokens = std.ArrayList(Tokenizer.Token).init(allocator);
    defer tokens.deinit();

    while (try tokenizer.nextToken()) |token| {
        try tokens.append(token);
    }

    var parser = try Parser.init(tokens.items, source, allocator);
    defer parser.deinit();
    const ast = try parser.parseProgram();

    var astgen = try AstGen.init(allocator, source);
    try astgen.genProgram(&ast);
    defer astgen.deinit();

    var zir = try allocator.create(Zir);
    zir.* = astgen.zir.*;
    return zir;
}

/// 테스트 헬퍼: ZIR에서 특정 지시어 개수 확인
fn countInstruction(zir: *const Zir, tag_name: []const u8) u32 {
    var count: u32 = 0;
    for (zir.instructions.items) |inst| {
        const inst_tag = @tagName(inst);
        if (std.mem.eql(u8, inst_tag, tag_name)) {
            count += 1;
        }
    }
    return count;
}

// ========== 1. Basic Overload Group Generation ==========

test "astgen_simple_overload_group" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\fn add(a: i32, b: i32) i32 { return a + b; }
        \\fn add(a: f64, b: f64) f64 { return a + b; }
    ;

    const zir = try compileToZir(source, allocator);
    defer allocator.destroy(zir);
    defer zir.deinit();

    // overload_group 지시어가 1개 있어야 함
    try std.testing.expect(countInstruction(zir, "overload_group") == 1);
    // fn_begin 지시어는 2개 (각 오버로드마다)
    try std.testing.expect(countInstruction(zir, "fn_begin") >= 2);
}

test "astgen_three_overload_versions" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\fn process(x: i32) i32 { return x; }
        \\fn process(x: f64) f64 { return x; }
        \\fn process(x: string) string { return x; }
    ;

    const zir = try compileToZir(source, allocator);
