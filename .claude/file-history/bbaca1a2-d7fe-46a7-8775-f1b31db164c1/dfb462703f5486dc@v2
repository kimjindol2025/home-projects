// 🦎 Phase 3.1 Step 2: AstGen - Generic Function Generation Tests
// test/phase3_astgen_generic_test.zig

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const AstGen = @import("../src/astgen.zig").AstGen;
const Zir = @import("../src/zir.zig").Zir;

/// 소스 코드를 ZIR로 컴파일하는 헬퍼 함수
fn compileToZir(source: []const u8, allocator: std.mem.Allocator) !Zir {
    var tokenizer = try Tokenizer.init(source, allocator);
    defer tokenizer.deinit();

    var tokens = std.ArrayList(Tokenizer.Token).init(allocator);
    defer tokens.deinit();

    while (try tokenizer.nextToken()) |token| {
        try tokens.append(token);
    }

    var parser = try Parser.init(tokens.items, source, allocator);
    defer parser.deinit();
    const ast = try parser.parseProgram();

    var astgen = try AstGen.init(allocator, source);
    defer astgen.deinit();
    try astgen.genProgram(&ast);

    // ZIR 복사
    return astgen.zir.*;
}

// ========== 1. Generic 함수 ZIR 생성 ==========

test "astgen_generic_function_simple" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "fn max(comptime T: type, a: T, b: T) T { return a; }";

    var tokenizer = try Tokenizer.init(source, allocator);
    defer tokenizer.deinit();

    var tokens = std.ArrayList(Tokenizer.Token).init(allocator);
    defer tokens.deinit();

    while (try tokenizer.nextToken()) |token| {
        try tokens.append(token);
    }

    var parser = try Parser.init(tokens.items, source, allocator);
    defer parser.deinit();
    const ast = try parser.parseProgram();

    var astgen = try AstGen.init(allocator, source);
    defer astgen.deinit();
    try astgen.genProgram(&ast);

    const zir = astgen.zir.*;

    // ZIR에서 generic_fn_begin이 생성되었는지 확인
    try std.testing.expect(zir.instructions.items.len >= 2);

    // 첫 번째 명령어가 generic_fn_begin이어야 함
    const first_instr = zir.instructions.items[0];
    try std.testing.expect(first_instr == .generic_fn_begin);

    // Generic 파라미터 개수가 1 (T)
    try std.testing.expect(first_instr.generic_fn_begin.comptime_param_count == 1);

    // 전체 파라미터 개수가 3 (T, a, b)
    try std.testing.expect(first_instr.generic_fn_begin.params.len == 3);
}

