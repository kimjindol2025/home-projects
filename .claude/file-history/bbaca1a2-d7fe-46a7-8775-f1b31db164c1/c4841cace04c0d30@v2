// ========== 2. Comptime Block ==========

test "astgen_comptime_block_generates_comptime_begin" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "comptime {};";

    const zir = try generateZir(source, allocator);
    defer zir.deinit();

    // ZIR instructions should contain comptime_begin
    var found_comptime_begin = false;
    for (zir.instructions.items) |inst| {
        if (inst == .comptime_begin) {
            found_comptime_begin = true;
        }
    }
    try std.testing.expect(found_comptime_begin);
}

