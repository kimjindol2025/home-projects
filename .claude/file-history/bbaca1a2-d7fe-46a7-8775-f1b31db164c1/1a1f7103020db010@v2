### 5. resolveOverload() 함수 (sema.zig)

**핵심 오버로드 해석 함수**:

```zig
pub fn resolveOverload(
    self: *Sema,
    fn_name: []const u8,
    arg_types: []AirType,
) !Zir.Ref {
    // 1. 같은 이름의 모든 오버로드 찾기
    const signatures = self.overload_groups.get(fn_name) orelse {
        return error.FunctionNotFound;
    };

    // 2. 캐시 확인 (이미 해석한 경우)
    const cache_key = try self.makeOverloadCacheKey(fn_name, arg_types);
    if (self.overload_resolution_cache.get(cache_key)) |fn_ref| {
        return fn_ref;
    }

    // 3. 모든 후보에 대해 매칭 점수 계산
    var candidates = std.ArrayList(OverloadCandidate).init(self.allocator);
    defer candidates.deinit();

    for (signatures) |sig| {
        const score = try self.calculateMatchScore(&sig, arg_types);
        if (score > 0) {  // 유효한 매칭
            try candidates.append(.{
                .signature = sig,
                .match_score = score,
                .conversions_needed = &[_]TypeConversion{},
            });
        }
    }

    // 4. 매칭되는 오버로드 확인
    if (candidates.items.len == 0) {
        return error.NoMatchingOverload;
    }

    // 5. 최고 점수 찾기
    var best_candidate = candidates.items[0];
    var best_count: usize = 1;

    for (candidates.items[1..]) |candidate| {
        if (candidate.match_score > best_candidate.match_score) {
            best_candidate = candidate;
            best_count = 1;
        } else if (candidate.match_score == best_candidate.match_score) {
            best_count += 1;  // 동점 발견
        }
    }

    // 6. 모호성 검사
    if (best_count > 1) {
        return error.AmbiguousOverload;
    }

    // 7. 캐시에 저장 후 반환
    try self.overload_resolution_cache.put(cache_key, best_candidate.signature.fn_ref);
    return best_candidate.signature.fn_ref;
}
```

**논리**:
1. overload_groups에서 함수명으로 시그니처 배열 조회
2. 캐시에 있으면 바로 반환
3. 각 시그니처에 대해 calculateMatchScore() 호출
4. 유효한 점수(> 0)인 후보만 수집
5. 최고 점수의 오버로드 선택
6. 동점인 경우 모호성 오류 발생
7. 캐시에 저장 후 fn_ref 반환

**변경량**: +65줄

