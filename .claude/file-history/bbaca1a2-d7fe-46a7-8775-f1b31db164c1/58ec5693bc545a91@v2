## 🔧 기술 구현

### 1. ZIR 확장
```zig
pub const FunctionSignature = struct {
    name_index: u32,       // 함수 이름
    param_types: []Ref,    // 파라미터 타입들
    return_type: Ref,      // 반환 타입
    fn_ref: Ref,           // fn_begin 위치
};

pub const Instruction = union(enum) {
    // ... 기존 ...
    overload_group: struct {
        name_index: u32,
        signatures: []FunctionSignature,
        default_fn: u32,
    },
};
```

### 2. AstGen 오버로드 처리
```zig
pub fn genProgram(...) {
    // Pass 1: 함수 수집
    for (ast.root.data.block) |stmt| {
        if (stmt.tag == .fn_decl) {
            const fn_name = stmt.data.fn_decl.name;
            try self.function_decls.getOrPut(fn_name).append(&stmt);
        }
    }

    // Pass 2: ZIR 생성 (오버로드 감지)
    for (ast.root.data.block) |stmt| {
        if (stmt.tag == .fn_decl) {
            const decls = self.function_decls.get(fn_name).?;
            if (decls.items.len > 1) {
                _ = try self.genOverloadGroup(fn_name, decls.items);
            } else {
                _ = try self.genNode(&stmt);
            }
        }
    }
}
```

### 3. 함수 시그니처 생성
```zig
fn genOverloadGroup(...) !Zir.Ref {
    var signatures = std.ArrayList(Zir.FunctionSignature).init(...);

    for (decls) |decl| {
        const fn_ref = try self.genFnDeclBase(fn_decl);
        try signatures.append(.{
            .name_index = name_index,
            .param_types = ...,
            .return_type = ...,
            .fn_ref = fn_ref,
        });
    }

    return try self.zir.addInstruction(.{
        .overload_group = .{
            .name_index = name_index,
            .signatures = try self.allocator.dupe(..., signatures.items),
            .default_fn = 0,
        },
    });
}
```

