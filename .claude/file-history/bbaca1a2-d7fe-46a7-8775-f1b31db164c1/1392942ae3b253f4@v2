// 🦎 Phase 3.5 Step 2: AstGen - Arrays & Slices
// test/phase3_array_astgen_test.zig: 배열/슬라이스 ZIR 생성 테스트

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const Ast = @import("../src/ast.zig");
const AstGen = @import("../src/astgen.zig").AstGen;
const Zir = @import("../src/zir.zig").Zir;

const test_allocator = std.testing.allocator;

// Helper: 소스코드를 AstGen까지 처리하고 Zir 반환
fn genSource(source: []const u8) !Zir {
    var tokenizer = Tokenizer.init(source);
    var tokens = std.ArrayList(Tokenizer.Token).init(test_allocator);
    defer tokens.deinit();

    while (true) {
        const token = tokenizer.nextToken();
        try tokens.append(token);
        if (token.tag == .eof) break;
    }

    var parser = Parser.init(source, tokens.items, test_allocator);
    const ast = try parser.parse();
    defer ast.deinit();

    var astgen = try AstGen.init(test_allocator, source);

    try astgen.genProgram(&ast);
    const zir = astgen.zir.*;
    astgen.zir = undefined; // astgen에서 소유권 제거
    return zir;
}

// Group A: 배열 타입 생성 (3개)

test "astgen_array_type_fixed_size" {
    const source = "const arr: [10]i32 = [1, 2, 3];";
    var zir = try genSource(source);
    defer zir.deinit();

    // 명령어가 생성되어야 함
    try std.testing.expect(zir.instructions.items.len > 0);

    // array_type 명령어 찾기
    var found_array_type = false;
    for (zir.instructions.items) |inst| {
        if (inst == .array_type) {
            found_array_type = true;
            try std.testing.expect(inst.array_type.size != null);
            try std.testing.expect(inst.array_type.size.? == 10);
        }
    }
    try std.testing.expect(found_array_type);
}

