test "astgen_const_slice_type" {
    const source = "fn read(data: []const u8) void {}";
    var zir = try genSource(source);
    defer zir.deinit();

    var found_const_slice = false;
    for (zir.instructions.items) |inst| {
        if (inst == .array_type) {
            if (inst.array_type.size == null and inst.array_type.is_const) {
                found_const_slice = true;
            }
        }
    }
