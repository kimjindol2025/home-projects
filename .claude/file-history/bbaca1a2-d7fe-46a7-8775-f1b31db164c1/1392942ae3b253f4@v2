test "astgen_mixed_array_slice_types" {
    const source =
        \\fn process(arr: [10]i32, slice: []i32) void {
        \\}
    ;
    var zir = try genSource(source);
    defer zir.deinit();

    var array_type_count = 0;
    var slice_type_count = 0;
    for (zir.instructions.items) |inst| {
        if (inst == .array_type) {
            if (inst.array_type.size != null) {
                array_type_count += 1;
            } else {
                slice_type_count += 1;
            }
        }
    }

    try std.testing.expect(array_type_count >= 1);
    try std.testing.expect(slice_type_count >= 1);
}

