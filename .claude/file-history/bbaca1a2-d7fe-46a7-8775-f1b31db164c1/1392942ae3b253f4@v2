// Group E: 복합 (2개)

test "astgen_array_in_function_zir" {
    const source =
        \\fn process(arr: [5]i32) i32 {
        \\  const x = arr[2];
        \\  return x;
        \\}
    ;
    var zir = try genSource(source);
    defer zir.deinit();

    // array_type과 index_access이 모두 있어야 함
    var has_array_type = false;
    var has_index_access = false;

    for (zir.instructions.items) |inst| {
        if (inst == .array_type) has_array_type = true;
        if (inst == .index_access) has_index_access = true;
    }

    try std.testing.expect(has_array_type);
    try std.testing.expect(has_index_access);
}

test "astgen_string_pool_integration" {
    const source = "const arr: [10]i32 = [1, 2, 3];";
    var zir = try genSource(source);
    defer zir.deinit();

    // 문자열 풀에 "arr"이 저장되어야 함
    try std.testing.expect(zir.strings.count() > 0);

    var found_arr_name = false;
    var iter = zir.strings.iterator();
    while (iter.next()) |entry| {
        if (std.mem.eql(u8, entry.value_ptr.*, "arr")) {
            found_arr_name = true;
        }
    }
    try std.testing.expect(found_arr_name);
}
