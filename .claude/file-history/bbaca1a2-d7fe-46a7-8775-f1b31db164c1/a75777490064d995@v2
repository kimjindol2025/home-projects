// ========== 4. Mixed Union/Enum in Same Program ==========

test "parse_union_and_enum_together" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\union Result { ok: i32, err: string }
        \\enum Status { success, failure }
    ;

    var ast_result = try parseSource(source, allocator);
    defer ast_result.deinit();

    const root = &ast_result.root;
    try std.testing.expect(root.data.block.len == 2);

    const union_node = &root.data.block[0];
    const enum_node = &root.data.block[1];

    try std.testing.expect(union_node.tag == .union_type);
    try std.testing.expect(enum_node.tag == .enum_type);
}

