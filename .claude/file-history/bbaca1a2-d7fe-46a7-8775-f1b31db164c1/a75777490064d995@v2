// 🦎 Phase 3.2 Step 1: Union & Enum Parser Tests
// test/phase3_union_enum_parser_test.zig

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const ast = @import("../src/ast.zig");

/// 소스 코드를 파싱하는 헬퍼 함수
fn parseSource(source: []const u8, allocator: std.mem.Allocator) !ast.Ast {
    var tokenizer = try Tokenizer.init(source, allocator);
    defer tokenizer.deinit();

    var tokens = std.ArrayList(Tokenizer.Token).init(allocator);
    defer tokens.deinit();

    while (try tokenizer.nextToken()) |token| {
        try tokens.append(token);
    }

    var parser = try Parser.init(tokens.items, source, allocator);
    defer parser.deinit();

    return try parser.parseProgram();
}

// ========== 1. Simple Union Parsing ==========

test "parse_simple_union" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "union Result { ok: i32, err: string }";

    var ast_result = try parseSource(source, allocator);
    defer ast_result.deinit();

    const root = &ast_result.root;
    try std.testing.expect(root.data.block.len > 0);

    const first_node = &root.data.block[0];
    try std.testing.expect(first_node.tag == .union_type);
    try std.testing.expectEqualSlices(u8, first_node.data.union_type_data.name, "Result");
    try std.testing.expect(first_node.data.union_type_data.fields.len == 2);
}

