**변경량**: +15줄

#### 2. Sema 함수 추가 (sema.zig)

```zig
fn checkTryExpr(
    self: *Sema,
    expr_ty: AirType,
) !AirType {
    // Try는 any 타입을 받을 수 있음
    // 하지만 error union이면 에러 제거
    switch (expr_ty) {
        .error_union => |eu| {
            // error_union T!E → T로 변환
            return eu.base_type.*;
        },
        else => return expr_ty,  // 일반 타입은 그대로
    }
}

fn checkCatchExpr(
    self: *Sema,
    try_ty: AirType,
) !AirType {
    // catch는 error_union만 가능
    switch (try_ty) {
        .error_union => return try_ty.error_type.*,
        else => return error.CatchOnNonError,
    }
}
```

**변경량**: +130줄

