    1 => print("one"),
    2 => print("two"),
    else => print("other"),
}
```

추가할 기능:
```zig
// 1. 값 패턴
switch value {
    1 => print("one"),
    2, 3 => print("two or three"),
    else => print("other"),
}

// 2. 튜플 분해
switch tuple {
    .{ a, b } => print("{} {}", .{ a, b }),
    else => print("no match"),
}

// 3. 구조체 분해
switch point {
    Point{ .x = 0, .y = 0 } => print("origin"),
    Point{ .x = x, .y = _ } => print("x = {}", .{x}),
    else => print("other"),
}

// 4. 타입 패턴
switch value {
    i32 => print("int"),
    f64 => print("float"),
    else => print("other"),
}

// 5. 와일드카드
switch value {
    0 => print("zero"),
    1..10 => print("small"),
    _ => print("other"),
}

// 6. 변수 바인딩
switch tuple {
    .{ a, b } => {
        const x = a + b;
        print("{}", .{x});
    },
    else => print("no match"),
}
```

