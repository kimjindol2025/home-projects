#### 2. AstGen 구현 (astgen.zig)

```zig
fn genSwitchExpr(self: *AstGen, node: *const Node) !Zir.Ref {
    const switch_expr = node.data.switch_expr;
    const expr = try self.genNode(switch_expr.expr);

    var cases = std.ArrayList(Zir.CaseRef).init(self.allocator);
    for (switch_expr.cases) |case| {
        const pat = try self.genNode(case.pattern);
        const val = try self.genNode(case.value);
        try cases.append(.{ .pattern = pat, .value = val });
    }

    return try self.zir.addInstruction(.{
        .switch_expr = .{
            .expr = expr,
            .cases = try self.allocator.dupe(Zir.CaseRef, cases.items),
        },
    });
}
```

