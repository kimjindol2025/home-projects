추가할 것:
```zig
pub const Node = struct {
    pub const Tag = enum {
        // ... 기존 ...
        switch_expr,      // switch 식
        case_pattern,     // case pattern => expr
        pattern,          // 패턴 정의
        tuple_pattern,    // (a, b, c)
        struct_pattern,   // Point { x, y }
        type_pattern,     // Type 패턴
    };

    pub const Data = union {
        // ... 기존 ...
        switch_expr: struct {
            expr: *Node,
            cases: []CasePattern,
        },

        case_pattern: struct {
            pattern: *Node,
            value: *Node,
        },

        pattern: struct {
            pattern_type: PatternType,
            data: PatternData,
        },

        tuple_pattern: struct {
            elements: []Node,
            ignore_rest: bool = false,
        },

        struct_pattern: struct {
            struct_name: []const u8,
            fields: []StructPatternField,
        },

        type_pattern: struct {
            target_type: *Node,
        },
    };
};

pub const CasePattern = struct {
    pattern: *Node,
    value: *Node,
    loc: Location,
};

pub const PatternType = enum {
    literal,
    tuple,
    struct,
    type_pat,
    wildcard,
    variable,
};

pub const PatternData = union {
    literal: *Node,
    tuple: []Node,
    struct: struct {
        name: []const u8,
        fields: []StructPatternField,
    },
    type_pat: *Node,
    wildcard: void,
    variable: []const u8,
};

pub const StructPatternField = struct {
    name: []const u8,
    pattern: ?*Node = null,  // null이면 이름 바인딩
    loc: Location,
};
```

