const std = @import("std");
const Air = @import("air.zig").Air;
const AirType = @import("air.zig").Type;
const Ref = @import("air.zig").Ref;
const Instruction = @import("air.zig").Instruction;
const PatternType = @import("air.zig").PatternType;

/// C 코드 생성기 (AIR → C 코드)
pub const Codegen = struct {
    air: *const Air,
    allocator: std.mem.Allocator,
    output: std.ArrayList(u8),
    indent_level: usize,
    temp_counter: u32,
    ref_to_temp: std.AutoHashMap(Ref, []const u8),
    switch_subject_stack: std.ArrayList([]const u8),  // Phase 4.1: 중첩 switch 지원
    error_counter: u32,                               // Phase 4.2: 에러 변수 카운터
    try_ref_to_err: std.AutoHashMap(Ref, []const u8), // Phase 4.2: try ref → "_err_N"

    pub fn init(allocator: std.mem.Allocator, air: *const Air) !Codegen {
        return Codegen{
            .air = air,
            .allocator = allocator,
            .output = std.ArrayList(u8).init(allocator),
            .indent_level = 0,
            .temp_counter = 0,
            .ref_to_temp = std.AutoHashMap(Ref, []const u8).init(allocator),
            .switch_subject_stack = std.ArrayList([]const u8).init(allocator),
            .error_counter = 0,
            .try_ref_to_err = std.AutoHashMap(Ref, []const u8).init(allocator),
        };
    }

    pub fn deinit(self: *Codegen) void {
        self.output.deinit();
        self.ref_to_temp.deinit();
        self.switch_subject_stack.deinit();
        self.try_ref_to_err.deinit();
    }

    /// AIR 프로그램을 C 코드로 생성
    pub fn generate(self: *Codegen) ![]const u8 {
        try self.emitHeaders();
        try self.emitDeclarations();
        return self.output.items;
    }

    /// 생성된 C 코드를 파일로 저장
    pub fn generateToFile(self: *Codegen, path: []const u8) !void {
        const c_code = try self.generate();
        const file = try std.fs.cwd().createFile(path, .{});
        defer file.close();
        try file.writeAll(c_code);
    }

    // ========== 헤더 & 기본 구조 ==========

    fn emitHeaders(self: *Codegen) !void {
        try self.output.appendSlice("#include <stdio.h>\n");
        try self.output.appendSlice("#include <string.h>\n");
        try self.output.appendSlice("#include <stdlib.h>\n\n");
    }

    fn emitDeclarations(self: *Codegen) !void {
        for (self.air.instructions.items, 0..) |inst, idx| {
            const ref: Ref = @intCast(idx);
            try self.emitInstruction(inst, ref);
        }
    }

    // ========== 타입 변환 ==========

    fn typeToCString(self: *Codegen, ty: AirType) ![]const u8 {
        _ = self;
        return switch (ty) {
            .void => "void",
            .i32 => "int",
            .i64 => "long long",
            .f32 => "float",
            .f64 => "double",
            .bool => "int",
            .string => "const char*",
            .array => "array", // TODO: 배열 타입 처리
            .function => "function", // TODO: 함수 포인터
            .error_type => "int",         // Phase 4: 에러 코드
            .error_union => "int",        // Phase 4: 에러 유니온
            .pattern => "int",            // Phase 4: 패턴 매치 결과
            .slice => "void*",            // Phase 4: 슬라이스는 포인터
            .unknown => "int", // 기본값
        };
    }

    /// Ref를 C 코드 표현으로 변환 (변수명 또는 리터럴)
    fn refToString(self: *Codegen, ref: Ref) ![]const u8 {
        if (self.ref_to_temp.get(ref)) |temp| {
            return temp;
        }
        return try std.fmt.allocPrint(self.allocator, "_t{}", .{ref});
    }

    /// 새로운 임시 변수 생성
    fn genTempVar(self: *Codegen) ![]const u8 {
        const name = try std.fmt.allocPrint(self.allocator, "_t{}", .{self.temp_counter});
        self.temp_counter += 1;
        return name;
    }

    // ========== Instruction 코드 생성 ==========

    fn emitInstruction(self: *Codegen, inst: Instruction, ref: Ref) !void {
        switch (inst) {
            .load_int => |info| {
                try self.emitLoadInt(info, ref);
            },
            .load_float => |info| {
                try self.emitLoadFloat(info, ref);
            },
            .load_string => |info| {
                try self.emitLoadString(info, ref);
            },
            .load_var => |info| {
                try self.emitLoadVar(info, ref);
            },
            .store_var => |info| {
                try self.emitStoreVar(info);
            },
            .binary_op => |info| {
                try self.emitBinaryOp(info, ref);
            },
            .unary_op => |info| {
                try self.emitUnaryOp(info, ref);
            },
            .fn_begin => |info| {
                try self.emitFnBegin(info);
            },
            .fn_end => {
                try self.emitFnEnd();
            },
            .call => |info| {
                try self.emitCall(info, ref);
            },
            .cond_br => |info| {
                try self.emitCondBr(info);
            },
            .return_val => |info| {
                try self.emitReturnVal(info);
            },
            .block_begin => {
                try self.emitIndent();
                try self.output.appendSlice("{\n");
                self.indent_level += 1;
            },
            .block_end => {
                if (self.indent_level > 0) self.indent_level -= 1;
                try self.emitIndent();
                try self.output.appendSlice("}\n");
            },
            .array_literal => |info| {
                try self.emitArrayLiteral(info, ref);
            },
            .index_access => |info| {
                try self.emitIndexAccess(info, ref);
            },
            .member_access => |info| {
                try self.emitMemberAccess(info, ref);
            },
            .loop_begin => {
                try self.emitIndent();
                try self.output.appendSlice("while (1) {\n");
                self.indent_level += 1;
            },
            .loop_end => {
                if (self.indent_level > 0) self.indent_level -= 1;
                try self.emitIndent();
                try self.output.appendSlice("}\n");
            },
            .switch_expr => |info| {
                try self.emitSwitchExpr(info, ref);
            },
            .case_pattern => |info| {
                try self.emitCasePattern(info, ref);
            },
            .try_expr => |info| {
                try self.emitTryExpr(info, ref);
            },
            .catch_expr => |info| {
                try self.emitCatchExpr(info, ref);
            },
            .noop => {},
            else => {},
        }
    }

    fn emitLoadInt(self: *Codegen, info: struct { value: i64, ty: AirType }, ref: Ref) !void {
        try self.emitIndent();
        const type_str = try self.typeToCString(info.ty);
        try self.output.appendSlice(type_str);
        try self.output.appendSlice(" _t");
        try self.output.writer().print("{} = {};\n", .{ ref, info.value });
        try self.ref_to_temp.put(ref, try std.fmt.allocPrint(self.allocator, "_t{}", .{ref}));
    }

    fn emitLoadFloat(self: *Codegen, info: struct { value: f64, ty: AirType }, ref: Ref) !void {
        try self.emitIndent();
        const type_str = try self.typeToCString(info.ty);
        try self.output.appendSlice(type_str);
        try self.output.appendSlice(" _t");
        try self.output.writer().print("{} = {};\n", .{ ref, info.value });
        try self.ref_to_temp.put(ref, try std.fmt.allocPrint(self.allocator, "_t{}", .{ref}));
    }

    fn emitLoadString(self: *Codegen, info: struct { index: u32, ty: AirType }, ref: Ref) !void {
        try self.emitIndent();
        const type_str = try self.typeToCString(info.ty);
        const str_value = if (info.index < self.air.strings.items.len)
            self.air.strings.items[info.index]
        else
            "\"\"";
        try self.output.writer().print("{} _t{} = {};\n", .{ type_str, ref, str_value });
        try self.ref_to_temp.put(ref, try std.fmt.allocPrint(self.allocator, "_t{}", .{ref}));
    }

    fn emitLoadVar(self: *Codegen, info: struct { name_index: u32, ty: AirType }, ref: Ref) !void {
        try self.emitIndent();
        const type_str = try self.typeToCString(info.ty);
        const var_name = if (info.name_index < self.air.strings.items.len)
            self.air.strings.items[info.name_index]
        else
            "unknown";
        try self.output.writer().print("{} _t{} = {};\n", .{ type_str, ref, var_name });
        try self.ref_to_temp.put(ref, try std.fmt.allocPrint(self.allocator, "_t{}", .{ref}));
    }

    fn emitStoreVar(self: *Codegen, info: struct { name_index: u32, value: Ref, ty: AirType }) !void {
        try self.emitIndent();
        const var_name = if (info.name_index < self.air.strings.items.len)
            self.air.strings.items[info.name_index]
        else
            "unknown";
        const val_str = try self.refToString(info.value);
        try self.output.writer().print("{} = {};\n", .{ var_name, val_str });
    }

    fn emitBinaryOp(self: *Codegen, info: struct { op: u8, lhs: Ref, rhs: Ref, result_ty: AirType }, ref: Ref) !void {
        try self.emitIndent();
        const type_str = try self.typeToCString(info.result_ty);
        const op_str = switch (info.op) {
            0 => "+",    // add
            1 => "-",    // sub
            2 => "*",    // mul
            3 => "/",    // div
            4 => "%",    // mod
            5 => "==",   // eq
            6 => "!=",   // ne
            7 => "<",    // lt
            8 => "<=",   // le
            9 => ">",    // gt
            10 => ">=",  // ge
            11 => "&&",  // and
            12 => "||",  // or
            13 => "^",   // xor
            14 => "<<",  // lshift
            15 => ">>",  // rshift
            else => "+",
        };
        const lhs_str = try self.refToString(info.lhs);
        const rhs_str = try self.refToString(info.rhs);
        try self.output.writer().print("{} _t{} = {} {} {};\n", .{ type_str, ref, lhs_str, op_str, rhs_str });
        try self.ref_to_temp.put(ref, try std.fmt.allocPrint(self.allocator, "_t{}", .{ref}));
    }

    fn emitUnaryOp(self: *Codegen, info: struct { op: u8, operand: Ref, result_ty: AirType }, ref: Ref) !void {
        try self.emitIndent();
        const type_str = try self.typeToCString(info.result_ty);
        const op_str = switch (info.op) {
            0 => "-",  // negate
            1 => "!",  // not
            2 => "~",  // bitwise_not
            else => "-",
        };
        const operand_str = try self.refToString(info.operand);
        try self.output.writer().print("{} _t{} = {}{};\n", .{ type_str, ref, op_str, operand_str });
        try self.ref_to_temp.put(ref, try std.fmt.allocPrint(self.allocator, "_t{}", .{ref}));
    }

    fn emitFnBegin(self: *Codegen, info: struct { name_index: u32, params: []Ref, return_ty: AirType }) !void {
        try self.emitIndent();
        const fn_name = if (info.name_index < self.air.strings.items.len)
            self.air.strings.items[info.name_index]
        else
            "unknown";
        const return_str = try self.typeToCString(info.return_ty);
        try self.output.writer().print("{} {}(", .{ return_str, fn_name });

        // 파라미터 출력 (간단하게 int로 표현)
        for (0..info.params.len) |i| {
            if (i > 0) try self.output.appendSlice(", ");
            try self.output.writer().print("int p{}", .{i});
        }
        try self.output.appendSlice(") {\n");
        self.indent_level += 1;
    }

    fn emitFnEnd(self: *Codegen) !void {
        if (self.indent_level > 0) self.indent_level -= 1;
        try self.emitIndent();
        try self.output.appendSlice("}\n\n");
    }

    fn emitCall(self: *Codegen, info: struct { callee: Ref, args: []Ref, return_ty: AirType }, ref: Ref) !void {
        try self.emitIndent();
        const type_str = try self.typeToCString(info.return_ty);
        const callee_str = try self.refToString(info.callee);
        try self.output.writer().print("{} _t{} = {}(", .{ type_str, ref, callee_str });

        for (0..info.args.len) |i| {
            if (i > 0) try self.output.appendSlice(", ");
            const arg_str = try self.refToString(info.args[i]);
            try self.output.appendSlice(arg_str);
        }
        try self.output.appendSlice(");\n");
        try self.ref_to_temp.put(ref, try std.fmt.allocPrint(self.allocator, "_t{}", .{ref}));
    }

    fn emitCondBr(self: *Codegen, info: struct { cond: Ref, then_block: Ref, else_block: ?Ref }) !void {
        try self.emitIndent();
        const cond_str = try self.refToString(info.cond);
        _ = info.else_block; // 단순 if 처리, else는 별도 블록
        try self.output.writer().print("if ({}) ", .{cond_str});
    }

    fn emitReturnVal(self: *Codegen, value: ?Ref) !void {
        try self.emitIndent();
        try self.output.appendSlice("return");
        if (value) |v| {
            try self.output.appendSlice(" ");
            const val_str = try self.refToString(v);
            try self.output.appendSlice(val_str);
        }
        try self.output.appendSlice(";\n");
    }

    fn emitArrayLiteral(self: *Codegen, info: struct { elements: []Ref, element_ty: AirType }, ref: Ref) !void {
        try self.emitIndent();
        const type_str = try self.typeToCString(info.element_ty);
        try self.output.writer().print("{} _t{}[] = {{ ", .{ type_str, ref });
        for (0..info.elements.len) |i| {
            if (i > 0) try self.output.appendSlice(", ");
            const elem_str = try self.refToString(info.elements[i]);
            try self.output.appendSlice(elem_str);
        }
        try self.output.appendSlice(" };\n");
        try self.ref_to_temp.put(ref, try std.fmt.allocPrint(self.allocator, "_t{}", .{ref}));
    }

    fn emitIndexAccess(self: *Codegen, info: struct { array: Ref, index: Ref, element_ty: AirType }, ref: Ref) !void {
        try self.emitIndent();
        const type_str = try self.typeToCString(info.element_ty);
        const array_str = try self.refToString(info.array);
        const index_str = try self.refToString(info.index);
        try self.output.writer().print("{} _t{} = {}[{}];\n", .{ type_str, ref, array_str, index_str });
        try self.ref_to_temp.put(ref, try std.fmt.allocPrint(self.allocator, "_t{}", .{ref}));
    }

    fn emitMemberAccess(self: *Codegen, info: struct { object: Ref, field_index: u32, field_ty: AirType }, ref: Ref) !void {
        try self.emitIndent();
        const type_str = try self.typeToCString(info.field_ty);
        const object_str = try self.refToString(info.object);
        const field_name = if (info.field_index < self.air.strings.items.len)
            self.air.strings.items[info.field_index]
        else
            "field";
        try self.output.writer().print("{} _t{} = {}.{};\n", .{ type_str, ref, object_str, field_name });
        try self.ref_to_temp.put(ref, try std.fmt.allocPrint(self.allocator, "_t{}", .{ref}));
    }

    // ========== Phase 4.1: Pattern Matching Codegen ==========

    fn emitSwitchExpr(self: *Codegen, info: struct { expr: Ref, cases: []Ref, case_patterns: []AirType }, ref: Ref) !void {
        // switch 주제 표현식 가져오기
        const subject_str = try self.refToString(info.expr);

        // 중첩 switch 지원을 위해 스택에 주제 push
        try self.switch_subject_stack.append(subject_str);

        // switch 결과값 저장소 매핑
        try self.ref_to_temp.put(ref, try std.fmt.allocPrint(self.allocator, "_t{}", .{ref}));
    }

    fn emitCasePattern(self: *Codegen, info: struct { pattern: Ref, value: Ref, pattern_ty: AirType }, ref: Ref) !void {
        // 현재 switch 주제 가져오기 (스택 peek)
        if (self.switch_subject_stack.items.len == 0) {
            return; // switch가 없으면 무시
        }
        const subject_str = self.switch_subject_stack.items[self.switch_subject_stack.items.len - 1];

        // 패턴 타입에 따라 조건 생성
        const is_first = false; // 더 정교한 구현에서는 case 인덱스 추적 필요

        try self.emitIndent();

        // wildcard 패턴 (`_`) 감지
        if (std.mem.eql(u8, subject_str, "_")) {
            try self.output.appendSlice("else ");
        } else {
            if (is_first) {
                try self.output.appendSlice("if (");
            } else {
                try self.output.appendSlice("} else if (");
            }
            try self.output.appendSlice(subject_str);
            try self.output.appendSlice(" == _t");
            try self.output.writer().print("{}", .{info.pattern});
            try self.output.appendSlice(") ");
        }

        try self.output.appendSlice("{\n");
        self.indent_level += 1;

        // case body 저장 (값으로 매핑)
        try self.ref_to_temp.put(ref, try std.fmt.allocPrint(self.allocator, "_t{}", .{info.value}));
    }

    fn emitPatternBinding(self: *Codegen, name: []const u8, subject: []const u8, ty: AirType, ref: Ref) !void {
        try self.emitIndent();
        const type_str = try self.typeToCString(ty);
        try self.output.writer().print("{} {} = {};\n", .{ type_str, name, subject });
        try self.ref_to_temp.put(ref, try self.allocator.dupe(u8, name));
    }

    // ========== Phase 4.2: Error Handling Codegen ==========

    fn emitTryExpr(self: *Codegen, info: struct { expr: Ref, result_type: AirType }, ref: Ref) !void {
        // 새로운 에러 변수 생성: _err_N
        const err_var = try std.fmt.allocPrint(self.allocator, "_err_{}", .{self.error_counter});
        self.error_counter += 1;

        // 에러 변수 선언
        try self.emitIndent();
        try self.output.writer().print("int {} = 0;\n", .{err_var});

        // 내부 표현식 실행 (이미 emitted된 상태)
        // try expr의 결과를 임시 변수에 저장
        try self.emitIndent();
        const result_type = try self.typeToCString(info.result_type);
        try self.output.writer().print("{} _t{} = _t{};\n", .{ result_type, ref, info.expr });

        // 에러 전파 guard check
        try self.emitIndent();
        try self.output.writer().print("if ({} != 0) return {};\n", .{ err_var, err_var });

        // try_ref_to_err에 매핑 저장
        try self.try_ref_to_err.put(ref, err_var);

        // 결과값 매핑
        try self.ref_to_temp.put(ref, try std.fmt.allocPrint(self.allocator, "_t{}", .{ref}));
    }

    fn emitCatchExpr(self: *Codegen, info: struct { try_expr: Ref, error_var_type: AirType, body: Ref }, _: Ref) !void {
        // try_expr에서 생성한 에러 변수 조회
        if (self.try_ref_to_err.get(info.try_expr)) |err_var| {
            // catch 블록 시작
            try self.emitIndent();
            try self.output.writer().print("if ({} != 0) {{\n", .{err_var});
            self.indent_level += 1;

            // 에러 변수 바인딩 (catch |err|)
            try self.emitIndent();
            const err_type = try self.typeToCString(info.error_var_type);
            try self.output.writer().print("{} err = {};\n", .{ err_type, err_var });

            // body는 이미 emitted된 블록
            // catch 블록은 body instruction이 처리하는 동안 유지

            self.indent_level -= 1;
            try self.emitIndent();
            try self.output.appendSlice("}\n");
        }
    }

    // ========== 유틸리티 ==========

    fn emitIndent(self: *Codegen) !void {
        for (0..self.indent_level) |_| {
            try self.output.appendSlice("    ");
        }
    }
};
