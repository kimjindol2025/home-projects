## 📝 Step 2: AstGen 확장

### 2.1 ZIR Instruction 추가

**파일**: `src/zir.zig`

```zig
pub const Instruction = union(enum) {
    // ... 기존 명령어들

    // Union 관련
    union_begin: struct {
        name_index: u32,
        field_count: u32,
        is_tagged: bool,
    },
    union_field: struct {
        field_name_index: u32,
        field_type: Ref,
    },

    // Enum 관련
    enum_begin: struct {
        name_index: u32,
        value_count: u32,
        is_tagged: bool,
    },
    enum_value: struct {
        value_name_index: u32,
        value: ?Ref,
    },
};
```

### 2.2 AstGen 함수 추가

**파일**: `src/astgen.zig`

```zig
fn genUnionType(self: *AstGen, union_type: *const ast.UnionType) !Zir.Ref {
    const name_index = try self.zir.addString(union_type.name);

    var field_refs = std.ArrayList(Zir.Ref).init(self.allocator);
    defer field_refs.deinit();

    for (union_type.fields) |field| {
        const field_name_index = try self.zir.addString(field.name);
        const field_type_ref = try self.genExpression(field.type_node);

        const field_ref = try self.zir.addInstruction(.{
            .union_field = .{
                .field_name_index = field_name_index,
                .field_type = field_type_ref,
            },
        });
        try field_refs.append(field_ref);
    }

    const union_begin_ref = try self.zir.addInstruction(.{
        .union_begin = .{
            .name_index = name_index,
            .field_count = @intCast(u32, union_type.fields.len),
            .is_tagged = union_type.is_tagged,
        },
    });

    return union_begin_ref;
}

fn genEnumType(self: *AstGen, enum_type: *const ast.EnumType) !Zir.Ref {
    const name_index = try self.zir.addString(enum_type.name);

    var value_refs = std.ArrayList(Zir.Ref).init(self.allocator);
    defer value_refs.deinit();

    for (enum_type.fields) |field| {
        const value_name_index = try self.zir.addString(field.name);
        const value_ref: ?Zir.Ref = if (field.value != null)
            try self.genExpression(field.value.?)
        else null;

        const field_ref = try self.zir.addInstruction(.{
            .enum_value = .{
                .value_name_index = value_name_index,
                .value = value_ref,
            },
        });
        try value_refs.append(field_ref);
    }

    const enum_begin_ref = try self.zir.addInstruction(.{
        .enum_begin = .{
            .name_index = name_index,
            .value_count = @intCast(u32, enum_type.fields.len),
            .is_tagged = enum_type.is_tagged,
        },
    });

    return enum_begin_ref;
}
```

