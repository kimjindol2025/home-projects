### 1.2 Parser 함수 추가

**파일**: `src/parser.zig`

```zig
// parseUnionType() 함수
// 입력: "union Result(T) { ok: i32, err: string }"
// 출력: UnionType AST 노드
fn parseUnionType(self: *Parser) !*Node {
    try self.expect(.union_keyword);
    const name = try self.parseIdentifier();

    var fields = std.ArrayList(ast.UnionField).init(self.allocator);
    defer fields.deinit();

    try self.expect(.lbrace);
    while (!self.match(.rbrace)) {
        const field_name = try self.parseIdentifier();
        try self.expect(.colon);
        const field_type = try self.parseTypeExpression();

        try fields.append(.{
            .name = field_name,
            .type_node = field_type,
            .location = field_type.location,
        });

        if (!self.check(.rbrace)) {
            try self.expect(.comma);
        }
    }

    const node = try self.allocator.create(ast.Node);
    node.* = .{
        .tag = .union_type,
        .data = .{
            .union_type = .{
                .name = name,
                .fields = try self.allocator.dupe(ast.UnionField, fields.items),
                .location = /* ... */,
            },
        },
    };
    return node;
}

// parseEnumType() 함수
// 입력: "enum Animal { dog, cat, bird }"
// 출력: EnumType AST 노드
fn parseEnumType(self: *Parser) !*Node {
    try self.expect(.enum_keyword);
    const name = try self.parseIdentifier();

    var fields = std.ArrayList(ast.EnumField).init(self.allocator);
    defer fields.deinit();

    try self.expect(.lbrace);
    while (!self.match(.rbrace)) {
        const field_name = try self.parseIdentifier();
        const field_value: ?*ast.Node = if (self.match(.lparen)) {
            const expr = try self.parseExpression();
            try self.expect(.rparen);
            expr
        } else null;

        try fields.append(.{
            .name = field_name,
            .value = field_value,
            .location = /* ... */,
        });

        if (!self.check(.rbrace)) {
            try self.expect(.comma);
        }
    }

    const node = try self.allocator.create(ast.Node);
    node.* = .{
        .tag = .enum_type,
        .data = .{
            .enum_type = .{
                .name = name,
                .fields = try self.allocator.dupe(ast.EnumField, fields.items),
                .location = /* ... */,
            },
        },
    };
    return node;
}
```

