### 3.2 Sema 분석 함수

**파일**: `src/sema.zig`

```zig
fn analyzeUnionType(self: *Sema, union_ref: Zir.Ref) !Air.Type {
    const instr = self.zir.getInstruction(union_ref);

    const name = self.zir.getStringPool()[instr.union_begin.name_index];

    var fields = std.ArrayList(UnionFieldInfo).init(self.allocator);
    defer fields.deinit();

    // 각 field를 분석하고 타입 검사
    for (/* union fields */) |field_ref| {
        const field_instr = self.zir.getInstruction(field_ref);
        const field_name = self.zir.getStringPool()[field_instr.union_field.field_name_index];
        const field_type = try self.analyzeType(field_instr.union_field.field_type);

        try fields.append(.{
            .name = field_name,
            .type_ref = field_type,
        });
    }

    // Union 타입 등록
    try self.union_types.put(name, .{
        .name = name,
        .fields = try self.allocator.dupe(UnionFieldInfo, fields.items),
        .is_tagged = instr.union_begin.is_tagged,
    });

    return .union_type;  // Union 타입 반환
}

fn analyzeEnumType(self: *Sema, enum_ref: Zir.Ref) !Air.Type {
    const instr = self.zir.getInstruction(enum_ref);
    const name = self.zir.getStringPool()[instr.enum_begin.name_index];

    var fields = std.ArrayList(EnumFieldInfo).init(self.allocator);
    defer fields.deinit();

    for (/* enum fields */) |field_ref| {
        const field_instr = self.zir.getInstruction(field_ref);
        const field_name = self.zir.getStringPool()[field_instr.enum_value.value_name_index];
        const field_value: ?Air.Ref = if (field_instr.enum_value.value != null)
            try self.analyzeExpression(field_instr.enum_value.value.?)
        else null;

        try fields.append(.{
            .name = field_name,
            .value = field_value,
        });
    }

    // Enum 타입 등록
    try self.enum_types.put(name, .{
        .name = name,
        .fields = try self.allocator.dupe(EnumFieldInfo, fields.items),
        .is_tagged = instr.enum_begin.is_tagged,
    });

    return .enum_type;
}
```

