test "parser_defer_complex_expr" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "fn test() { defer allocator.free(ptr + offset); }";
    var parser = try createParser(allocator, source);
    defer parser.deinit();

    const ast = try parser.parseProgram();
    defer ast.deinit();

    const fn_node = ast.root.data.block[0];
    const body = fn_node.data.fn_decl.body;
    const defer_stmt = body.data.block[0];

    try std.testing.expect(defer_stmt.tag == .defer_stmt);
    const call = defer_stmt.data.defer_stmt.expr;
    try std.testing.expect(call.tag == .call);

    // alloc.free의 인자는 복잡한 식 (ptr + offset)
    try std.testing.expect(call.data.call.args.len >= 1);
    const arg = call.data.call.args[0];
    try std.testing.expect(arg.tag == .binary_op);
}
