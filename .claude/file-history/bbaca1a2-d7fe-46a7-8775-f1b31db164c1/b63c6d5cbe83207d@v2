#### genComptimeBlockExpr() 함수
```zig
/// Phase 3.3: Comptime 블록 식 생성
/// comptime { ... }
fn genComptimeBlockExpr(self: *AstGen, node: *const Node) !Zir.Ref {
    const body_data = node.data.comptime_block_expr_data;

    // 본체 시작 위치 기록
    const body_start = @intCast(Zir.Ref, self.zir.instructions.items.len);

    // 본체 문장들 생성
    for (body_data.body) |stmt| {
        _ = try self.genNode(&stmt);
    }

    // 본체 끝 위치 기록
    const body_end = @intCast(Zir.Ref, self.zir.instructions.items.len - 1);

    // Comptime begin 명령어 생성
    const comptime_begin_ref = try self.zir.addInstruction(.{
        .comptime_begin = .{
            .body_start = body_start,
            .body_end = body_end,
        },
    });

    return comptime_begin_ref;
}
```

#### genConstExpr() 함수
```zig
/// Phase 3.3: 상수 식 생성
/// const X = VALUE
fn genConstExpr(self: *AstGen, node: *const Node) !Zir.Ref {
    const const_data = node.data.const_expr_data;

    // 상수 이름 추가
    const name_index = try self.zir.addString(const_data.name);

    // 타입 인덱스 (있으면)
    var type_index: ?u32 = null;
    if (const_data.type_node) |type_node| {
        _ = type_node;
        // type_index = try self.zir.addType(type_node);
    }

    // 값 생성
    const value_ref = try self.genNode(const_data.value);

    // Const expr 명령어 생성
    const const_expr_ref = try self.zir.addInstruction(.{
        .const_expr = .{
            .name_index = name_index,
            .type_index = type_index,
            .value = value_ref,
        },
    });

    return const_expr_ref;
}
```

