const std = @import("std");

pub fn build(b: *std.Build) void {
    const target = b.standardTargetOptions(.{});
    const optimize = b.standardOptimizeOption(.{});

    // Executable
    const exe = b.addExecutable(.{
        .name = "zig-compiler",
        .root_source_file = b.path("src/main.zig"),
        .target = target,
        .optimize = optimize,
    });

    b.installArtifact(exe);

    // Run step
    const run_cmd = b.addRunArtifact(exe);
    if (b.args) |args| {
        run_cmd.addArgs(args);
    }

    const run_step = b.step("run", "Run the compiler");
    run_step.dependOn(&run_cmd.step);

    // Tests
    const tokenizer_tests = b.addTest(.{
        .root_source_file = b.path("test/tokenizer_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const parser_tests = b.addTest(.{
        .root_source_file = b.path("test/parser_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const astgen_tests = b.addTest(.{
        .root_source_file = b.path("test/astgen_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const sema_tests = b.addTest(.{
        .root_source_file = b.path("test/sema_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const codegen_tests = b.addTest(.{
        .root_source_file = b.path("test/codegen_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const generic_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_generic_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const astgen_generic_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_astgen_generic_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const sema_generic_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_sema_generic_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const union_enum_parser_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_union_enum_parser_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const union_enum_astgen_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_union_enum_astgen_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const union_enum_sema_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_union_enum_sema_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const comptime_parser_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_comptime_parser_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const comptime_astgen_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_comptime_astgen_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const comptime_sema_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_comptime_sema_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const overload_parser_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_overload_parser_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const overload_astgen_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_overload_astgen_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const overload_sema_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_overload_sema_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const array_parser_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_array_parser_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const array_astgen_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_array_astgen_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const array_sema_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_array_sema_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const defer_parser_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_defer_parser_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const defer_astgen_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_defer_astgen_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const defer_sema_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_defer_sema_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const run_tokenizer_tests = b.addRunArtifact(tokenizer_tests);
    const run_parser_tests = b.addRunArtifact(parser_tests);
    const run_astgen_tests = b.addRunArtifact(astgen_tests);
    const run_sema_tests = b.addRunArtifact(sema_tests);
    const run_codegen_tests = b.addRunArtifact(codegen_tests);
    const run_generic_tests = b.addRunArtifact(generic_tests);
    const run_astgen_generic_tests = b.addRunArtifact(astgen_generic_tests);
    const run_sema_generic_tests = b.addRunArtifact(sema_generic_tests);
    const run_union_enum_parser_tests = b.addRunArtifact(union_enum_parser_tests);
    const run_union_enum_astgen_tests = b.addRunArtifact(union_enum_astgen_tests);
    const run_union_enum_sema_tests = b.addRunArtifact(union_enum_sema_tests);
    const run_comptime_parser_tests = b.addRunArtifact(comptime_parser_tests);
    const run_comptime_astgen_tests = b.addRunArtifact(comptime_astgen_tests);
    const run_comptime_sema_tests = b.addRunArtifact(comptime_sema_tests);
    const run_overload_parser_tests = b.addRunArtifact(overload_parser_tests);
    const run_overload_astgen_tests = b.addRunArtifact(overload_astgen_tests);
    const run_overload_sema_tests = b.addRunArtifact(overload_sema_tests);
    const run_array_parser_tests = b.addRunArtifact(array_parser_tests);
    const run_array_astgen_tests = b.addRunArtifact(array_astgen_tests);
    const run_array_sema_tests = b.addRunArtifact(array_sema_tests);
    const run_defer_parser_tests = b.addRunArtifact(defer_parser_tests);
    const run_defer_astgen_tests = b.addRunArtifact(defer_astgen_tests);
    const run_defer_sema_tests = b.addRunArtifact(defer_sema_tests);

    const test_step = b.step("test", "Run unit tests");
    test_step.dependOn(&run_tokenizer_tests.step);
    test_step.dependOn(&run_parser_tests.step);
    test_step.dependOn(&run_astgen_tests.step);
    test_step.dependOn(&run_sema_tests.step);
    test_step.dependOn(&run_codegen_tests.step);
    test_step.dependOn(&run_generic_tests.step);
    test_step.dependOn(&run_astgen_generic_tests.step);
    test_step.dependOn(&run_sema_generic_tests.step);
    test_step.dependOn(&run_union_enum_parser_tests.step);
    test_step.dependOn(&run_union_enum_astgen_tests.step);
    test_step.dependOn(&run_union_enum_sema_tests.step);
    test_step.dependOn(&run_comptime_parser_tests.step);
    test_step.dependOn(&run_comptime_astgen_tests.step);
    test_step.dependOn(&run_comptime_sema_tests.step);
    test_step.dependOn(&run_overload_parser_tests.step);
    test_step.dependOn(&run_overload_astgen_tests.step);
    test_step.dependOn(&run_overload_sema_tests.step);
    test_step.dependOn(&run_array_parser_tests.step);
    test_step.dependOn(&run_array_astgen_tests.step);
    test_step.dependOn(&run_array_sema_tests.step);
    test_step.dependOn(&run_defer_parser_tests.step);
    test_step.dependOn(&run_defer_astgen_tests.step);
    test_step.dependOn(&run_defer_sema_tests.step);
}
