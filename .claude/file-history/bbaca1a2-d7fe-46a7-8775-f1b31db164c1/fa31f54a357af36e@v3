// 🦎 Phase 5: LLVM IR Backend
// src/llvm_ir.zig

const std = @import("std");
const Air = @import("air.zig").Air;
const AirType = @import("air.zig").Type;
const Ref = @import("air.zig").Ref;
const Instruction = @import("air.zig").Instruction;

/// Phase 5 Defer 엔트리 (Phase 4와 동일)
pub const DeferEntry = struct {
    expr_ref: Ref,
    defer_index: u32,
};

/// Phase 5: LLVM IR 백엔드 (텍스트 형식 생성)
pub const LLVMIRGen = struct {
    air: *const Air,
    allocator: std.mem.Allocator,
    output: std.ArrayList(u8),
    temp_counter: u32,                                      // _tN 자동 증가
    label_counter: u32,                                     // 기본 블록 레이블 번호
    ref_to_value: std.AutoHashMap(Ref, []const u8),         // Ref → "%_tN"
    alloca_map: std.AutoHashMap(u32, []const u8),           // name_index → alloca ptr
    current_fn: ?[]const u8,                                // 현재 함수명
    string_cache: std.StringHashMap([]const u8),            // 전역 문자열 상수 dedup
    indent_level: usize,                                    // 들여쓰기 레벨
    // Phase 5.3: Advanced Features
    switch_subject_stack: std.ArrayList([]const u8),        // 중첩 switch 지원
    error_counter: u32,                                     // _err_N 카운터
    try_ref_to_err: std.AutoHashMap(Ref, []const u8),       // try ref → "_err_N"
    deferred_by_scope: std.AutoHashMap(u32, std.ArrayList(DeferEntry)), // scope → defer list

    pub fn init(allocator: std.mem.Allocator, air: *const Air) !LLVMIRGen {
        return LLVMIRGen{
            .air = air,
            .allocator = allocator,
            .output = std.ArrayList(u8).init(allocator),
            .temp_counter = 0,
            .label_counter = 0,
            .ref_to_value = std.AutoHashMap(Ref, []const u8).init(allocator),
            .alloca_map = std.AutoHashMap(u32, []const u8).init(allocator),
            .current_fn = null,
            .string_cache = std.StringHashMap([]const u8).init(allocator),
            .indent_level = 0,
            .switch_subject_stack = std.ArrayList([]const u8).init(allocator),
            .error_counter = 0,
            .try_ref_to_err = std.AutoHashMap(Ref, []const u8).init(allocator),
            .deferred_by_scope = std.AutoHashMap(u32, std.ArrayList(DeferEntry)).init(allocator),
        };
    }

    pub fn deinit(self: *LLVMIRGen) void {
        self.output.deinit();
        self.ref_to_value.deinit();
        self.alloca_map.deinit();
        self.string_cache.deinit();
        self.switch_subject_stack.deinit();
        self.try_ref_to_err.deinit();

        var iter = self.deferred_by_scope.iterator();
        while (iter.next()) |entry| {
            entry.value_ptr.deinit();
        }
        self.deferred_by_scope.deinit();
    }

    /// LLVM IR 코드 생성 시작
    pub fn generate(self: *LLVMIRGen) ![]const u8 {
        try self.emitPreamble();
        try self.emitDeclarations();
        return self.output.items;
    }

    /// 모듈 프리앰블 (target, datalayout)
    fn emitPreamble(self: *LLVMIRGen) !void {
        try self.output.appendSlice("; Generated by Zig LLVM IR Backend\n");
        try self.output.appendSlice("target triple = \"x86_64-unknown-linux-gnu\"\n");
        try self.output.appendSlice("target datalayout = \"e-m:e-i64:64-f80:128-n8:16:32:64-S128\"\n\n");
    }

    /// 모든 선언(함수, 전역 변수 등) 출력
    fn emitDeclarations(self: *LLVMIRGen) !void {
        for (self.air.instructions.items, 0..) |inst, idx| {
            const ref: Ref = @intCast(idx);
            try self.emitInstruction(inst, ref);
        }
    }

    // ========== 타입 변환 ==========

    /// AirType → LLVM IR 타입 문자열
    fn typeToLLVM(self: *LLVMIRGen, ty: AirType) ![]const u8 {
        _ = self;
        return switch (ty) {
            .void => "void",
            .i32 => "i32",
            .i64 => "i64",
            .f32 => "float",
            .f64 => "double",
            .bool => "i1",
            .string => "i8*",
            .array => "array", // TODO: 배열 타입 처리
            .slice => "i8*", // 슬라이스는 포인터
            .function => "function", // TODO: 함수 포인터
            .error_type => "i32", // 에러 코드
            .error_union => "i32", // 에러 유니온 (단순화)
            .pattern => "i32", // 패턴 결과
            .unknown => "i32",
        };
    }

    /// Ref를 LLVM IR 값으로 변환 ("%_tN" 또는 "%{var_name}")
    fn refToValue(self: *LLVMIRGen, ref: Ref) ![]const u8 {
        if (self.ref_to_value.get(ref)) |val| {
            return val;
        }
        return try std.fmt.allocPrint(self.allocator, "%_t{}", .{ref});
    }

    /// 새 임시 변수 생성 ("%_tN")
    fn genTempVar(self: *LLVMIRGen) ![]const u8 {
        const name = try std.fmt.allocPrint(self.allocator, "%_t{}", .{self.temp_counter});
        self.temp_counter += 1;
        return name;
    }

    /// 새 레이블 생성
    fn genLabel(self: *LLVMIRGen, prefix: []const u8) ![]const u8 {
        const label = try std.fmt.allocPrint(self.allocator, "{}.{}", .{ prefix, self.label_counter });
        self.label_counter += 1;
        return label;
    }

    // ========== Instruction 코드 생성 ==========

    fn emitInstruction(self: *LLVMIRGen, inst: Instruction, ref: Ref) !void {
        switch (inst) {
            .load_int => |info| {
                try self.emitLoadInt(info, ref);
            },
            .load_float => |info| {
                try self.emitLoadFloat(info, ref);
            },
            .load_string => |info| {
                try self.emitLoadString(info, ref);
            },
            .load_var => |info| {
                try self.emitLoadVar(info, ref);
            },
            .store_var => |info| {
                try self.emitStoreVar(info);
            },
            .binary_op => |info| {
                try self.emitBinaryOp(info, ref);
            },
            .unary_op => |info| {
                try self.emitUnaryOp(info, ref);
            },
            .fn_begin => |info| {
                try self.emitFnBegin(info);
            },
            .fn_end => {
                try self.emitFnEnd();
            },
            .call => |info| {
                try self.emitCall(info, ref);
            },
            .return_val => |info| {
                try self.emitReturnVal(info);
            },
            .cond_br => |info| {
                try self.emitCondBr(info);
            },
            .block_begin => {
                try self.emitBlockBegin();
            },
            .block_end => {
                try self.emitBlockEnd();
            },
            .loop_begin => {
                try self.emitLoopBegin();
            },
            .loop_end => {
                try self.emitLoopEnd();
            },
            .array_literal => |info| {
                try self.emitArrayLiteral(info, ref);
            },
            .index_access => |info| {
                try self.emitIndexAccess(info, ref);
            },
            .member_access => |info| {
                try self.emitMemberAccess(info, ref);
            },
            .switch_expr => |info| {
                try self.emitSwitchExpr(info, ref);
            },
            .case_pattern => |info| {
                try self.emitCasePattern(info, ref);
            },
            .try_expr => |info| {
                try self.emitTryExpr(info, ref);
            },
            .catch_expr => |info| {
                try self.emitCatchExpr(info, ref);
            },
            .defer_stmt => |info| {
                try self.emitDeferStmt(info, ref);
            },
            .scope_exit => |info| {
                try self.emitScopeExit(info);
            },
            else => {},
        }
    }

    // ========== Phase 5.1: Basic Values & Functions ==========

    fn emitLoadInt(self: *LLVMIRGen, info: struct { value: i64, ty: AirType }, ref: Ref) !void {
        const temp = try self.genTempVar();
        const type_str = try self.typeToLLVM(info.ty);
        try self.output.writer().print("{} {} = add {} 0, {}\n", .{ temp, type_str, type_str, info.value });
        try self.ref_to_value.put(ref, temp);
    }

    fn emitLoadFloat(self: *LLVMIRGen, info: struct { value: f64, ty: AirType }, ref: Ref) !void {
        const temp = try self.genTempVar();
        const type_str = try self.typeToLLVM(info.ty);
        try self.output.writer().print("{} {} = fadd {} 0.0, {}\n", .{ temp, type_str, type_str, info.value });
        try self.ref_to_value.put(ref, temp);
    }

    fn emitLoadString(self: *LLVMIRGen, info: struct { index: u32, ty: AirType }, ref: Ref) !void {
        // 문자열 인덱스로 전역 상수 생성
        // 간단화: 문자열 인덱스를 기반으로 @.str{index} 레이블 생성
        const str_label = try std.fmt.allocPrint(self.allocator, "@.str{}", .{info.index});
        try self.output.writer().print("{} = private constant [6 x i8] c\"str\\00\"\n", .{str_label});

        const temp = try self.genTempVar();
        try self.output.writer().print("{} i8* = getelementptr inbounds [6 x i8], [6 x i8]* {}, i64 0, i64 0\n", .{ temp, str_label });
        try self.ref_to_value.put(ref, temp);
    }

    fn emitLoadVar(self: *LLVMIRGen, info: struct { name_index: u32, ty: AirType }, ref: Ref) !void {
        // 변수는 alloca_map에서 조회
        const var_ptr = self.alloca_map.get(info.name_index) orelse "unknown_var";
        const temp = try self.genTempVar();
        const type_str = try self.typeToLLVM(info.ty);
        try self.output.writer().print("{} {} = load {}, {}* {}\n", .{ temp, type_str, type_str, type_str, var_ptr });
        try self.ref_to_value.put(ref, temp);
    }

    fn emitStoreVar(self: *LLVMIRGen, info: struct { name_index: u32, value: Ref, ty: AirType }) !void {
        const value_ref = try self.refToValue(info.value);
        const var_ptr = self.alloca_map.get(info.name_index) orelse "unknown_var";
        const type_str = try self.typeToLLVM(info.ty);
        try self.output.writer().print("store {} {}, {}* {}\n", .{ type_str, value_ref, type_str, var_ptr });
    }

    fn emitBinaryOp(self: *LLVMIRGen, info: struct { op: u8, lhs: Ref, rhs: Ref, result_ty: AirType }, ref: Ref) !void {
        const lhs_val = try self.refToValue(info.lhs);
        const rhs_val = try self.refToValue(info.rhs);
        const result_type = try self.typeToLLVM(info.result_ty);
        const temp = try self.genTempVar();

        // op 매핑 (BinaryOp enum 기반)
        const op_name = switch (info.op) {
            0 => "add", // add
            1 => "sub", // sub
            2 => "mul", // mul
            3 => "sdiv", // div
            4 => "srem", // mod
            5 => "icmp eq", // eq
            6 => "icmp ne", // ne
            7 => "icmp slt", // lt
            8 => "icmp sle", // le
            9 => "icmp sgt", // gt
            10 => "icmp sge", // ge
            11 => "and", // logical_and
            12 => "or", // logical_or
            13 => "xor", // bitwise_xor
            14 => "shl", // lshift
            15 => "ashr", // rshift
            16 => "and", // bitwise_and (수정: 이전에 누락됨)
            17 => "or", // bitwise_or (수정: 이전에 누락됨)
            else => "add", // fallback
        };

        // 부동점 연산 타입 조정
        const actual_op = if (std.mem.eql(u8, result_type, "float") or std.mem.eql(u8, result_type, "double")) blk: {
            break :blk switch (info.op) {
                0 => "fadd",
                1 => "fsub",
                2 => "fmul",
                3 => "fdiv",
                4 => "frem",
                else => op_name,
            };
        } else op_name;

        try self.output.writer().print("{} {} = {} {} {}, {}\n", .{ temp, result_type, actual_op, result_type, lhs_val, rhs_val });
        try self.ref_to_value.put(ref, temp);
    }

    fn emitUnaryOp(self: *LLVMIRGen, info: struct { op: u8, operand: Ref, result_ty: AirType }, ref: Ref) !void {
        const operand_val = try self.refToValue(info.operand);
        const result_type = try self.typeToLLVM(info.result_ty);
        const temp = try self.genTempVar();

        const op_name = switch (info.op) {
            0 => "sub", // negate: 0 - operand
            1 => "xor", // not: XOR with 1 (or all bits if i1)
            2 => "xor", // bitwise_not: XOR with -1
            else => "sub",
        };

        if (info.op == 0) {
            // negate: 0 - operand
            try self.output.writer().print("{} {} = {} {} 0, {}\n", .{ temp, result_type, op_name, result_type, operand_val });
        } else if (info.op == 1) {
            // not: XOR with 1 (for i1 bool)
            try self.output.writer().print("{} {} = {} {} {}, 1\n", .{ temp, result_type, op_name, result_type, operand_val });
        } else {
            // bitwise_not: XOR with -1
            try self.output.writer().print("{} {} = {} {} {}, -1\n", .{ temp, result_type, op_name, result_type, operand_val });
        }

        try self.ref_to_value.put(ref, temp);
    }

    fn emitFnBegin(self: *LLVMIRGen, info: struct { name_index: u32, params: []Ref, return_ty: AirType }) !void {
        const return_type = try self.typeToLLVM(info.return_ty);
        const fn_name = try std.fmt.allocPrint(self.allocator, "fn{}", .{info.name_index});

        // 함수 서명 시작
        try self.output.writer().print("define {} @{}(", .{ return_type, fn_name });

        // 파라미터 출력 (실제 타입 사용, int 하드코딩 수정)
        for (info.params, 0..) |param_ref, i| {
            if (i > 0) try self.output.appendSlice(", ");
            // param_ref는 이전 instruction으로, 그 타입을 알아야 함
            // 간단화: 모두 i32로 처리 (TODO: 실제 타입 추적)
            try self.output.writer().print("i32 %p{}", .{i});
        }

        try self.output.appendSlice(") {\n");
        try self.output.appendSlice("entry:\n");

        self.current_fn = fn_name;
        self.indent_level = 1;
    }

    fn emitFnEnd(self: *LLVMIRGen) !void {
        // 함수 끝: fallthrough ret void 보장
        try self.output.appendSlice("  ret void\n");
        try self.output.appendSlice("}\n\n");
        self.current_fn = null;
        self.indent_level = 0;
    }

    // ========== Phase 5.2: Control Flow IR ==========

    fn emitCall(self: *LLVMIRGen, info: struct { callee: Ref, args: []Ref, return_ty: AirType }, ref: Ref) !void {
        const callee_val = try self.refToValue(info.callee);
        const return_type = try self.typeToLLVM(info.return_ty);
        const temp = try self.genTempVar();

        try self.output.writer().print("{} {} = call {} {}(", .{ temp, return_type, return_type, callee_val });

        for (info.args, 0..) |arg, i| {
            if (i > 0) try self.output.appendSlice(", ");
            const arg_val = try self.refToValue(arg);
            try self.output.writer().print("i32 {}", .{arg_val});
        }

        try self.output.appendSlice(")\n");
        try self.ref_to_value.put(ref, temp);
    }

    fn emitReturnVal(self: *LLVMIRGen, info: ?Ref) !void {
        if (info == null) {
            try self.output.appendSlice("  ret void\n");
        } else {
            const val = try self.refToValue(info.?);
            try self.output.writer().print("  ret i32 {}\n", .{val});
        }
    }

    fn emitCondBr(self: *LLVMIRGen, info: struct { cond: Ref, then_block: Ref, else_block: ?Ref }) !void {
        const cond_val = try self.refToValue(info.cond);
        const then_label = try std.fmt.allocPrint(self.allocator, "then.{}", .{info.then_block});
        const else_label = if (info.else_block) |eb|
            try std.fmt.allocPrint(self.allocator, "else.{}", .{eb})
        else
            try std.fmt.allocPrint(self.allocator, "else.{}", .{info.then_block});

        try self.output.writer().print("  br i1 {}, label %{}, label %{}\n", .{ cond_val, then_label, else_label });
    }

    fn emitBlockBegin(self: *LLVMIRGen) !void {
        // block_begin는 기본 블록 레이블만 출력
        // label은 AIR instruction의 label 필드에서 옴
        const label = try self.genLabel("block");
        try self.output.writer().print("{}:\n", .{label});
    }

    fn emitBlockEnd(self: *LLVMIRGen) !void {
        // 다음 블록으로 fallthrough
        // merge 레이블로 br 출력
        const merge_label = try self.genLabel("merge");
        try self.output.writer().print("  br label %{}\n", .{merge_label});
    }

    fn emitLoopBegin(self: *LLVMIRGen) !void {
        const loop_label = try self.genLabel("loop");
        try self.output.writer().print("  br label %{}\n", .{loop_label});
        try self.output.writer().print("{}:\n", .{loop_label});
    }

    fn emitLoopEnd(self: *LLVMIRGen) !void {
        // 루프 시작으로 back-edge
        const loop_label = try self.genLabel("loop");
        try self.output.writer().print("  br label %{}\n", .{loop_label});
    }

    fn emitArrayLiteral(self: *LLVMIRGen, info: struct { elements: []Ref, element_ty: AirType }, ref: Ref) !void {
        const elem_type = try self.typeToLLVM(info.element_ty);
        const array_size = info.elements.len;
        const array_type = try std.fmt.allocPrint(self.allocator, "[{} x {}]", .{ array_size, elem_type });
        const temp = try self.genTempVar();
        const ptr_temp = try self.genTempVar();

        // alloca 배열
        try self.output.writer().print("{} {}* = alloca {}\n", .{ ptr_temp, array_type, array_type });

        // 각 요소 저장
        for (info.elements, 0..) |elem, i| {
            const elem_val = try self.refToValue(elem);
            const elem_ptr = try std.fmt.allocPrint(self.allocator, "%_t_elem_{}", .{i});
            try self.output.writer().print("{} {}* = getelementptr inbounds {}, {}* {}, i64 0, i64 {}\n",
                .{ elem_ptr, elem_type, array_type, array_type, ptr_temp, i });
            try self.output.writer().print("store {} {}, {}* {}\n", .{ elem_type, elem_val, elem_type, elem_ptr });
        }

        try self.ref_to_value.put(ref, ptr_temp);
    }

    fn emitIndexAccess(self: *LLVMIRGen, info: struct { array: Ref, index: Ref, element_ty: AirType }, ref: Ref) !void {
        const array_val = try self.refToValue(info.array);
        const index_val = try self.refToValue(info.index);
        const elem_type = try self.typeToLLVM(info.element_ty);
        const ptr_temp = try self.genTempVar();
        const temp = try self.genTempVar();

        try self.output.writer().print("{} {}* = getelementptr inbounds {}, {}* {}, i64 {}\n",
            .{ ptr_temp, elem_type, elem_type, elem_type, array_val, index_val });
        try self.output.writer().print("{} {} = load {}, {}* {}\n",
            .{ temp, elem_type, elem_type, elem_type, ptr_temp });
        try self.ref_to_value.put(ref, temp);
    }

    fn emitMemberAccess(self: *LLVMIRGen, info: struct { object: Ref, field_index: u32, field_ty: AirType }, ref: Ref) !void {
        const object_val = try self.refToValue(info.object);
        const field_type = try self.typeToLLVM(info.field_ty);
        const ptr_temp = try self.genTempVar();
        const temp = try self.genTempVar();

        // %struct.fieldN 접근
        try self.output.writer().print("{} {}* = getelementptr inbounds %struct, %struct* {}, i64 0, i32 {}\n",
            .{ ptr_temp, field_type, object_val, info.field_index });
        try self.output.writer().print("{} {} = load {}, {}* {}\n",
            .{ temp, field_type, field_type, field_type, ptr_temp });
        try self.ref_to_value.put(ref, temp);
    }

    // ========== Phase 5.3: Advanced Features (Pattern/Error/Defer) ==========

    fn emitSwitchExpr(self: *LLVMIRGen, info: struct { expr: Ref, cases: []Ref, case_patterns: []AirType }, ref: Ref) !void {
        const expr_val = try self.refToValue(info.expr);
        const switch_label = try self.genLabel("switch.end");

        // switch 명령 시작
        try self.output.writer().print("  switch i32 {}, label %{} [\n", .{ expr_val, switch_label });

        // case들을 case_patterns 길이만큼
        for (0..info.case_patterns.len) |i| {
            const case_label = try std.fmt.allocPrint(self.allocator, "case.{}", .{i});
            try self.output.writer().print("    i32 {}, label %{}\n", .{ i, case_label });
        }

        try self.output.appendSlice("  ]\n");

        // switch subject 스택에 저장
        try self.switch_subject_stack.append(expr_val);

        // 결과값 등록
        const temp = try self.genTempVar();
        try self.ref_to_value.put(ref, temp);
    }

    fn emitCasePattern(self: *LLVMIRGen, info: struct { pattern: Ref, value: Ref, pattern_ty: AirType }, _: Ref) !void {
        // switch subject는 스택에서 팝하거나, pattern Ref를 기반으로 case 라벨 생성
        const pattern_val = try self.refToValue(info.pattern);
        const value_val = try self.refToValue(info.value);

        // case 라벨과 body 출력
        const case_label = try self.genLabel("case");
        try self.output.writer().print("{}:\n", .{case_label});
        try self.output.writer().print("  br label %switch.end\n", .{});
    }

    fn emitTryExpr(self: *LLVMIRGen, info: struct { expr: Ref, result_type: AirType }, ref: Ref) !void {
        const err_var = try std.fmt.allocPrint(self.allocator, "%_err_{}", .{self.error_counter});
        self.error_counter += 1;

        // 에러 변수 alloca
        try self.output.writer().print("{} i32* = alloca i32\n", .{err_var});
        try self.output.writer().print("  store i32 0, i32* %{s}\n", .{err_var[1..]});

        // 내부 표현식 실행
        const result_type = try self.typeToLLVM(info.result_type);
        const temp = try self.genTempVar();
        try self.output.writer().print("{} {} = call {} {}(i32* {})\n", .{ temp, result_type, result_type, "fn", err_var });

        // 에러 guard check
        const err_val_temp = try self.genTempVar();
        try self.output.writer().print("{} i32 = load i32, i32* {}\n", .{ err_val_temp, err_var });
        const is_err_temp = try self.genTempVar();
        try self.output.writer().print("{} i1 = icmp ne i32 {}, 0\n", .{ is_err_temp, err_val_temp });
        try self.output.writer().print("  br i1 %{s}, label %propagate, label %continue\n", .{is_err_temp[1..]});

        // try_ref_to_err에 매핑
        try self.try_ref_to_err.put(ref, err_var);
        try self.ref_to_value.put(ref, temp);
    }

    fn emitCatchExpr(self: *LLVMIRGen, info: struct { try_expr: Ref, error_var_type: AirType, body: Ref }, _: Ref) !void {
        if (self.try_ref_to_err.get(info.try_expr)) |err_var| {
            // catch 블록 시작
            try self.output.appendSlice("propagate:\n");
            const err_val_temp = try self.genTempVar();
            try self.output.writer().print("{} i32 = load i32, i32* {}\n", .{ err_val_temp, err_var });
            try self.output.writer().print("  ret i32 {}\n", .{err_val_temp});

            // continue 라벨
            try self.output.appendSlice("continue:\n");
        }
    }

    fn emitDeferStmt(self: *LLVMIRGen, info: struct { expr: Ref, scope_id: u32, defer_index: u32 }, _: Ref) !void {
        // defer 식을 scope별 큐에 저장 (현재는 emitting하지 않음)
        var deferred = self.deferred_by_scope.get(info.scope_id);
        if (deferred == null) {
            var new_list = std.ArrayList(DeferEntry).init(self.allocator);
            try self.deferred_by_scope.put(info.scope_id, new_list);
            deferred = self.deferred_by_scope.get(info.scope_id);
        }

        try deferred.?.append(.{
            .expr_ref = info.expr,
            .defer_index = info.defer_index,
        });
    }

    fn emitScopeExit(self: *LLVMIRGen, info: struct { scope_id: u32 }, _: Ref) !void {
        // defer들을 역순(defer_index 내림차순)으로 정렬 후 emit
        if (self.deferred_by_scope.get(info.scope_id)) |defer_list| {
            var defers = defer_list.items;
            // 내림차순 정렬
            std.mem.sort(DeferEntry, defers, {}, deferIndexDescending);

            for (defers) |defer_entry| {
                const expr_str = try self.refToValue(defer_entry.expr_ref);
                try self.output.writer().print("  call void {}()\n", .{expr_str});
            }
        }
    }

    /// defer_index 내림차순 정렬
    fn deferIndexDescending(_: void, a: DeferEntry, b: DeferEntry) bool {
        return a.defer_index > b.defer_index;
    }

    // ========== 유틸리티 ==========

    fn emitIndent(self: *LLVMIRGen) !void {
        for (0..self.indent_level) |_| {
            try self.output.appendSlice("  ");
        }
    }
};
