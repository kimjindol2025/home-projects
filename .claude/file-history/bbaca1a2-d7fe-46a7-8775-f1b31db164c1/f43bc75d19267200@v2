// 🦎 Phase 5.1: Basic Values & Functions - LLVM IR Tests
// test/phase5_basic_ir_test.zig

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const AstGen = @import("../src/astgen.zig").AstGen;
const Sema = @import("../src/sema.zig").Sema;
const LLVMIRGen = @import("../src/llvm_ir.zig").LLVMIRGen;

/// 소스 코드를 LLVM IR로 컴파일하는 헬퍼 함수
fn compileToLLVMIR(source: []const u8, allocator: std.mem.Allocator) ![]const u8 {
    var tokenizer = try Tokenizer.init(source, allocator);
    defer tokenizer.deinit();

    var tokens = std.ArrayList(Tokenizer.Token).init(allocator);
    defer tokens.deinit();

    while (try tokenizer.nextToken()) |token| {
        try tokens.append(token);
    }

    var parser = try Parser.init(tokens.items, source, allocator);
    defer parser.deinit();
    const ast = try parser.parseProgram();

    var astgen = try AstGen.init(allocator, source);
    defer astgen.deinit();
    try astgen.genProgram(&ast);

    var sema = try Sema.init(allocator, &astgen.zir);
    defer sema.deinit();
    try sema.analyzeProgram();

    var llvm_ir = try LLVMIRGen.init(allocator, &sema.air);
    defer llvm_ir.deinit();
    const ir_code = try llvm_ir.generate();

    return ir_code;
}

// ============================================================================
// Group A: Literals (3 tests) - i32, f64, string
// ============================================================================

test "llvm_load_int_literal" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};\
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "const x = 42;";
    const ir_code = try compileToLLVMIR(source, allocator);

    try std.testing.expect(std.mem.containsAtLeast(u8, ir_code, 1, "target triple"));
    try std.testing.expect(std.mem.containsAtLeast(u8, ir_code, 1, "42"));
}

