#### E. 새 헬퍼 함수: genOverloadGroup()
```zig
fn genOverloadGroup(self: *AstGen, fn_name: []const u8, decls: []*const Node) !Zir.Ref {
    const name_index = try self.zir.addString(fn_name);

    var signatures = std.ArrayList(Zir.FunctionSignature).init(self.allocator);
    defer signatures.deinit();

    for (decls) |decl| {
        if (decl.tag != .fn_decl) continue;
        const fn_decl = decl.data.fn_decl;

        // 파라미터 타입들 수집
        var param_types = std.ArrayList(Zir.Ref).init(self.allocator);
        defer param_types.deinit();

        for (fn_decl.params) |param| {
            try param_types.append(0);  // TODO: 실제 타입 정보 추출
        }

        const return_type: Zir.Ref = 0;  // TODO: 실제 반환 타입

        // fn_begin 명령어 생성하여 fn_ref 획득
        const fn_ref = try self.genFnDeclBase(fn_decl);

        try signatures.append(.{
            .name_index = name_index,
            .param_types = try self.allocator.dupe(Zir.Ref, param_types.items),
            .return_type = return_type,
            .fn_ref = fn_ref,
        });
    }

    // overload_group 지시어 생성
    return try self.zir.addInstruction(.{
        .overload_group = .{
            .name_index = name_index,
            .signatures = try self.allocator.dupe(Zir.FunctionSignature, signatures.items),
            .default_fn = 0,
        },
    });
}
```

**변경량**: +50줄

#### F. 새 헬퍼 함수: genFnDeclBase()
기존 genFnDecl()의 로직을 추출한 헬퍼:

```zig
fn genFnDeclBase(self: *AstGen, fn_decl: Node.FnDecl) !Zir.Ref {
    const name_index = try self.zir.addString(fn_decl.name);

    var params = std.ArrayList(Zir.Ref).init(self.allocator);
    defer params.deinit();

    var comptime_param_count: u32 = 0;
    for (fn_decl.params) |param| {
        if (param.is_comptime) {
            comptime_param_count += 1;
        }
        _ = try self.zir.addString(param.name);
        try params.append(0);
    }

    if (comptime_param_count > 0) {
        // Generic 함수 처리
        const fn_begin_ref = try self.zir.addInstruction(.{
            .generic_fn_begin = .{
                .name_index = name_index,
                .comptime_param_count = comptime_param_count,
                .params = try self.allocator.dupe(Zir.Ref, params.items),
            },
        });
        _ = try self.genNode(fn_decl.body);
        _ = try self.zir.addInstruction(.fn_end);
        return fn_begin_ref;
    } else {
        // 일반 함수
        const fn_begin_ref = try self.zir.addInstruction(.{
            .fn_begin = .{
                .name_index = name_index,
                .params = try self.allocator.dupe(Zir.Ref, params.items),
            },
        });
        _ = try self.genNode(fn_decl.body);
        _ = try self.zir.addInstruction(.fn_end);
        return fn_begin_ref;
    }
}
```

**변경량**: +60줄

