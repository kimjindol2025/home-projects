test "sema_defer_lifo_order" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "fn main() { defer print(\"1\"); defer print(\"2\"); defer print(\"3\"); }";
    var sema = try createSema(allocator, source);
    defer sema.air.deinit();

    // defer 순서 검증 (3개는 LIFO 순서로 실행)
    var defers = std.ArrayList(Sema.DeferInfo).init(allocator);
    defer defers.deinit();

    try defers.append(.{
        .expr_ty = .void,
        .scope_id = 0,
        .defer_index = 0,
        .location = .{ .line = 1, .column = 1, .start = 0, .end = 1 },
    });
    try defers.append(.{
        .expr_ty = .void,
        .scope_id = 0,
        .defer_index = 1,
        .location = .{ .line = 1, .column = 1, .start = 0, .end = 1 },
    });
    try defers.append(.{
        .expr_ty = .void,
        .scope_id = 0,
        .defer_index = 2,
        .location = .{ .line = 1, .column = 1, .start = 0, .end = 1 },
    });

    // LIFO 검증
    try sema.validateDeferOrdering(defers.items);
}

test "sema_defer_execution_order" {
