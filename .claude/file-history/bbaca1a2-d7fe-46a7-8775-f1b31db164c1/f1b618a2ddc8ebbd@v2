// 🦎 Phase 3.6: Defer & Resource Management - Sema Tests
// test/phase3_defer_sema_test.zig

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const AstGen = @import("../src/astgen.zig").AstGen;
const Sema = @import("../src/sema.zig").Sema;
const Air = @import("../src/air.zig").Air;
const AirType = @import("../src/air.zig").Type;
const Ast = @import("../src/ast.zig");

fn createSema(allocator: std.mem.Allocator, source: []const u8) !Sema {
    var tokenizer = Tokenizer.init(source);
    var tokens = std.ArrayList(Tokenizer.Token).init(allocator);
    defer tokens.deinit();

    while (true) {
        const token = tokenizer.nextToken();
        try tokens.append(token);
        if (token.tag == .eof) break;
    }

    var parser = Parser.init(try tokens.toOwnedSlice(), source, allocator);
    defer parser.deinit();

    const ast = try parser.parseProgram();
    defer ast.deinit();

    var astgen = try AstGen.init(allocator, source);
    defer astgen.deinit();
    try astgen.genProgram(&ast);

    const air = try allocator.create(Air);
    air.* = Air.init(allocator);

    return .{
        .zir = astgen.zir,
        .air = air,
        .allocator = allocator,
    };
}

// ============================================================================
// Group A: 타입 검증 (2개)
// ============================================================================

test "sema_defer_void_type" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "fn main() { defer cleanup(); }";
    var sema = try createSema(allocator, source);
    defer sema.air.deinit();

    // void 타입 검증
    const void_ty: AirType = .void;
    const result = try sema.checkDeferStmt(void_ty);
    try std.testing.expect(result == .void);
}

test "sema_defer_non_void_error" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "fn main() { defer x = 5; }";
    var sema = try createSema(allocator, source);
    defer sema.air.deinit();

    // i32 타입은 에러여야 함
    const i32_ty: AirType = .i32;
    const result = sema.checkDeferStmt(i32_ty);
    try std.testing.expectError(error.DeferExprNotVoid, result);
}

