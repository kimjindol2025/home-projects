// ========== 13. Union and Enum Coexistence ==========

test "sema_union_enum_independent_registration" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\union Result { ok: i32, err: string }
        \\enum Result2 { success, failure }
        \\union Result3 { a: i32, b: f64 }
        \\enum Result4 { x, y, z }
    ;

    var sema = try analyzeSema(source, allocator);
    defer sema.deinit();

    // Union과 Enum은 별도로 등록됨
    try std.testing.expect(sema.union_types.count() == 2);
    try std.testing.expect(sema.enum_types.count() == 2);
    try std.testing.expect(sema.union_types.get("Result") != null);
    try std.testing.expect(sema.enum_types.get("Result2") != null);
    try std.testing.expect(sema.union_types.get("Result3") != null);
    try std.testing.expect(sema.enum_types.get("Result4") != null);
}
