// 🦎 Phase 3.2 Step 3: Union & Enum Sema Tests
// test/phase3_union_enum_sema_test.zig

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const AstGen = @import("../src/astgen.zig").AstGen;
const Sema = @import("../src/sema.zig").Sema;
const ast = @import("../src/ast.zig");

/// 소스 코드를 Sema로 분석하는 헬퍼 함수
fn analyzeSema(source: []const u8, allocator: std.mem.Allocator) !Sema {
    var tokenizer = try Tokenizer.init(source, allocator);
    defer tokenizer.deinit();

    var tokens = std.ArrayList(Tokenizer.Token).init(allocator);
    defer tokens.deinit();

    while (try tokenizer.nextToken()) |token| {
        try tokens.append(token);
    }

    var parser = try Parser.init(tokens.items, source, allocator);
    defer parser.deinit();
    const ast_result = try parser.parseProgram();

    var astgen = try AstGen.init(allocator, source);
    defer astgen.deinit();
    try astgen.genProgram(&ast_result);

    var sema = try Sema.init(allocator, &astgen.zir);
    try sema.analyzeProgram();

    return sema;
}

// ========== 1. Union Type Registration ==========

test "sema_union_type_registration" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){}
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "union Result { ok: i32, err: string }";

    var sema = try analyzeSema(source, allocator);
    defer sema.deinit();

    // Union 타입이 등록되었는지 확인
    try std.testing.expect(sema.union_types.count() >= 1);

    // "Result" 타입이 존재하는지 확인
    const result_union = sema.union_types.get("Result");
    try std.testing.expect(result_union != null);
}

