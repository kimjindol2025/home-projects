const std = @import("std");

pub fn build(b: *std.Build) void {
    const target = b.standardTargetOptions(.{});
    const optimize = b.standardOptimizeOption(.{});

    // Executable
    const exe = b.addExecutable(.{
        .name = "zig-compiler",
        .root_source_file = b.path("src/main.zig"),
        .target = target,
        .optimize = optimize,
    });

    b.installArtifact(exe);

    // Run step
    const run_cmd = b.addRunArtifact(exe);
    if (b.args) |args| {
        run_cmd.addArgs(args);
    }

    const run_step = b.step("run", "Run the compiler");
    run_step.dependOn(&run_cmd.step);

    // Tests
    const tokenizer_tests = b.addTest(.{
        .root_source_file = b.path("test/tokenizer_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const parser_tests = b.addTest(.{
        .root_source_file = b.path("test/parser_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const astgen_tests = b.addTest(.{
        .root_source_file = b.path("test/astgen_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const sema_tests = b.addTest(.{
        .root_source_file = b.path("test/sema_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const codegen_tests = b.addTest(.{
        .root_source_file = b.path("test/codegen_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const generic_tests = b.addTest(.{
        .root_source_file = b.path("test/phase3_generic_test.zig"),
        .target = target,
        .optimize = optimize,
    });

    const run_tokenizer_tests = b.addRunArtifact(tokenizer_tests);
    const run_parser_tests = b.addRunArtifact(parser_tests);
    const run_astgen_tests = b.addRunArtifact(astgen_tests);
    const run_sema_tests = b.addRunArtifact(sema_tests);
    const run_codegen_tests = b.addRunArtifact(codegen_tests);
    const run_generic_tests = b.addRunArtifact(generic_tests);

    const test_step = b.step("test", "Run unit tests");
    test_step.dependOn(&run_tokenizer_tests.step);
    test_step.dependOn(&run_parser_tests.step);
    test_step.dependOn(&run_astgen_tests.step);
    test_step.dependOn(&run_sema_tests.step);
    test_step.dependOn(&run_codegen_tests.step);
    test_step.dependOn(&run_generic_tests.step);
}
