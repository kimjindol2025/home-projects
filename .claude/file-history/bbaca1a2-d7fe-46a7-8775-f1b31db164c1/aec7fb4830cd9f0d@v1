// 🦎 Mini Zig Compiler - Phase 2.4: AIR
// src/air.zig: Analyzed Intermediate Representation (with Type Information)

const std = @import("std");

/// Type System
pub const Type = union(enum) {
    void,
    i32,
    i64,
    f32,
    f64,
    bool,
    string,
    array: struct {
        element_ty: *Type,
        len: ?usize,
    },
    function: struct {
        params: []Type,
        return_ty: *Type,
    },
    unknown, // 아직 추론되지 않음
};

/// AIR Instruction (with Type Information)
pub const Instruction = union(enum) {
    // 리터럴 (타입 정보 포함)
    load_int: struct { value: i64, ty: Type },
    load_float: struct { value: f64, ty: Type },
    load_string: struct { index: u32, ty: Type },

    // 변수 (타입 정보 포함)
    load_var: struct { name_index: u32, ty: Type },
    store_var: struct { name_index: u32, value: Ref, ty: Type },

    // 연산자 (연산 결과 타입 포함)
    binary_op: struct { op: BinaryOp, lhs: Ref, rhs: Ref, result_ty: Type },
    unary_op: struct { op: UnaryOp, operand: Ref, result_ty: Type },

    // 함수
    fn_begin: struct { name_index: u32, params: []Ref, return_ty: Type },
    fn_end,

    // 제어 흐름
    call: struct { callee: Ref, args: []Ref, return_ty: Type },
    br: Ref,
    cond_br: struct { cond: Ref, then_block: Ref, else_block: ?Ref },
    return_val: ?Ref,

    // 블록
    block_begin: struct { label: u32 },
    block_end,

    // 배열/메모리
    array_literal: struct { elements: []Ref, element_ty: Type },
    index_access: struct { array: Ref, index: Ref, element_ty: Type },
    member_access: struct { object: Ref, field_index: u32, field_ty: Type },

    // 제어 흐름 (advanced)
    loop_begin: struct { label: u32 },
    loop_end,
    break_loop: struct { label: u32 },
    continue_loop: struct { label: u32 },

    // 기타
    noop,
};

pub const Ref = u32; // Instruction 인덱스

pub const BinaryOp = enum {
    add, sub, mul, div, mod,
    eq, ne, lt, le, gt, ge,
    logical_and, logical_or,
    bitwise_and, bitwise_or, bitwise_xor,
    lshift, rshift,
};

pub const UnaryOp = enum {
    negate, not, bitwise_not,
};

/// AIR - Analyzed Intermediate Representation
pub const Air = struct {
    instructions: std.ArrayList(Instruction),
    extra: std.ArrayList(u32),
    strings: std.StringHashMap([]const u8),
    allocator: std.mem.Allocator,

    pub fn init(allocator: std.mem.Allocator) Air {
        return .{
            .instructions = std.ArrayList(Instruction).init(allocator),
            .extra = std.ArrayList(u32).init(allocator),
            .strings = std.StringHashMap([]const u8).init(allocator),
            .allocator = allocator,
        };
    }

    pub fn deinit(self: *Air) void {
        self.instructions.deinit();
        self.extra.deinit();
        self.strings.deinit();
    }

    /// 명령어 추가 및 Ref 반환
    pub fn addInstruction(self: *Air, inst: Instruction) !Ref {
        const index: Ref = @intCast(self.instructions.items.len);
        try self.instructions.append(inst);
        return index;
    }

    /// 문자열 추가 및 인덱스 반환
    pub fn addString(self: *Air, text: []const u8) !u32 {
        if (self.strings.get(text)) |_| {
            return @intCast(self.strings.count() - 1);
        }

        const index: u32 = @intCast(self.strings.count());
        try self.strings.put(text, text);
        return index;
    }

    /// 추가 데이터 저장소에 값 추가
    pub fn addExtra(self: *Air, value: u32) !u32 {
        const index: u32 = @intCast(self.extra.items.len);
        try self.extra.append(value);
        return index;
    }
};

/// Type 유틸리티 함수들
pub fn typeEq(t1: Type, t2: Type) bool {
    switch (t1) {
        .void => return t2 == .void,
        .i32 => return t2 == .i32,
        .i64 => return t2 == .i64,
        .f32 => return t2 == .f32,
        .f64 => return t2 == .f64,
        .bool => return t2 == .bool,
        .string => return t2 == .string,
        .unknown => return t2 == .unknown,
        .array => |arr1| {
            if (t2 == .array) {
                const arr2 = t2.array;
                return typeEq(arr1.element_ty.*, arr2.element_ty.*) and
                    arr1.len == arr2.len;
            }
            return false;
        },
        .function => {
            // 함수 타입 비교는 복잡하므로 나중에 구현
            return false;
        },
    }
}

pub fn typeName(t: Type) []const u8 {
    return switch (t) {
        .void => "void",
        .i32 => "i32",
        .i64 => "i64",
        .f32 => "f32",
        .f64 => "f64",
        .bool => "bool",
        .string => "string",
        .unknown => "unknown",
        .array => "array",
        .function => "function",
    };
}

/// AIR 디버깅용 출력 함수
pub fn printAir(air: *const Air, indent: usize) void {
    const spaces = " " ** indent;
    const stdout = std.io.getStdOut().writer();

    stdout.print("{s}=== AIR Instructions ===\n", .{spaces}) catch {};

    for (air.instructions.items, 0..) |inst, idx| {
        stdout.print("{s}[{}] ", .{ spaces, idx }) catch {};

        switch (inst) {
            .load_int => |data| {
                stdout.print("load_int {} ({s})\n", .{ data.value, typeName(data.ty) }) catch {};
            },
            .load_float => |data| {
                stdout.print("load_float {} ({s})\n", .{ data.value, typeName(data.ty) }) catch {};
            },
            .load_string => |data| {
                stdout.print("load_string @{} ({s})\n", .{ data.index, typeName(data.ty) }) catch {};
            },
            .load_var => |data| {
                stdout.print("load_var @{} ({s})\n", .{ data.name_index, typeName(data.ty) }) catch {};
            },
            .store_var => |data| {
                stdout.print("store_var @{} = %{} ({s})\n", .{ data.name_index, data.value, typeName(data.ty) }) catch {};
            },
            .binary_op => |data| {
                stdout.print("binary_op {:s} %{} %{} → {s}\n", .{ @tagName(data.op), data.lhs, data.rhs, typeName(data.result_ty) }) catch {};
            },
            .unary_op => |data| {
                stdout.print("unary_op {:s} %{} → {s}\n", .{ @tagName(data.op), data.operand, typeName(data.result_ty) }) catch {};
            },
            .fn_begin => |data| {
                stdout.print("fn_begin @{} (params: {}, return: {s})\n", .{ data.name_index, data.params.len, typeName(data.return_ty) }) catch {};
            },
            .fn_end => {
                stdout.print("fn_end\n", .{}) catch {};
            },
            .call => |data| {
                stdout.print("call %{} (args: {}, return: {s})\n", .{ data.callee, data.args.len, typeName(data.return_ty) }) catch {};
            },
            .return_val => |ret| {
                if (ret) |r| {
                    stdout.print("return %{}\n", .{r}) catch {};
                } else {
                    stdout.print("return void\n", .{}) catch {};
                }
            },
            .block_begin => |data| {
                stdout.print("block_begin @{}\n", .{data.label}) catch {};
            },
            .block_end => {
                stdout.print("block_end\n", .{}) catch {};
            },
            .array_literal => |data| {
                stdout.print("array_literal (elements: {}, type: {s})\n", .{ data.elements.len, typeName(data.element_ty) }) catch {};
            },
            .noop => {
                stdout.print("noop\n", .{}) catch {};
            },
            else => {
                stdout.print("{s}\n", .{@tagName(inst)}) catch {};
            },
        }
    }

    stdout.print("{s}=== Strings ===\n", .{spaces}) catch {};
    var iter = air.strings.iterator();
    var idx: u32 = 0;
    while (iter.next()) |entry| {
        stdout.print("{s}@{}: \"{s}\"\n", .{ spaces, idx, entry.value_ptr.* }) catch {};
        idx += 1;
    }
}
