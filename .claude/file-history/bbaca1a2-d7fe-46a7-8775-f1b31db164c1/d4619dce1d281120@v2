// 🦎 Phase 3.5 Step 1: Parser - Arrays & Slices
// test/phase3_array_parser_test.zig: 배열/슬라이스 구문 파싱 테스트

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const Ast = @import("../src/ast.zig");

const test_allocator = std.testing.allocator;

// Helper: 소스코드를 파싱하고 AST 반환
fn parseSource(source: []const u8) !Ast {
    var tokenizer = Tokenizer.init(source);
    var tokens = std.ArrayList(Tokenizer.Token).init(test_allocator);
    defer tokens.deinit();

    while (true) {
        const token = tokenizer.nextToken();
        try tokens.append(token);
        if (token.tag == .eof) break;
    }

    var parser = Parser.init(source, tokens.items, test_allocator);
    return try parser.parse();
}

// Group A: 배열 타입 선언 (2개)

test "parser_array_type_fixed_size" {
    const source = "const arr: [10]i32 = [1, 2, 3];";
    const ast = try parseSource(source);
    defer ast.deinit();

    // root는 블록을 가짐
    try std.testing.expect(ast.root.tag == .root);
    try std.testing.expect(ast.root.data.block.len == 1);

    const const_decl = ast.root.data.block[0];
    try std.testing.expect(const_decl.tag == .const_decl);
    try std.testing.expectEqualSlices(u8, const_decl.data.const_decl.name, "arr");

    // 타입 annotation이 있어야 함
    try std.testing.expect(const_decl.data.const_decl.type_annotation != null);
    const type_node = const_decl.data.const_decl.type_annotation.?;

    // 배열 타입
    try std.testing.expect(type_node.tag == .type_array);
    try std.testing.expect(type_node.data.array_type.size != null);
}

test "parser_array_type_with_elements" {
    const source = "var nums: [3]f64 = [1.5, 2.5, 3.5];";
    const ast = try parseSource(source);
    defer ast.deinit();

    try std.testing.expect(ast.root.data.block.len == 1);
    const var_decl = ast.root.data.block[0];
    try std.testing.expect(var_decl.tag == .var_decl);
    try std.testing.expectEqualSlices(u8, var_decl.data.var_decl.name, "nums");

    // 타입 annotation 확인
    const type_node = var_decl.data.var_decl.type_annotation.?;
    try std.testing.expect(type_node.tag == .type_array);
}

// Group B: 슬라이스 타입 (2개)

test "parser_slice_type" {
    const source = "fn take_slice(s: []i32) void {}";
    const ast = try parseSource(source);
    defer ast.deinit();

    try std.testing.expect(ast.root.data.block.len == 1);
    const fn_decl = ast.root.data.block[0];
    try std.testing.expect(fn_decl.tag == .fn_decl);

    // 파라미터 확인
    const param = &fn_decl.data.fn_decl.params[0];
    try std.testing.expect(param.type_node.tag == .type_slice);
}

test "parser_const_slice_type" {
    const source = "fn read(data: []const u8) void {}";
    const ast = try parseSource(source);
    defer ast.deinit();

    const fn_decl = ast.root.data.block[0];
    const param = &fn_decl.data.fn_decl.params[0];

    try std.testing.expect(param.type_node.tag == .type_slice);
    try std.testing.expect(param.type_node.data.slice_type.is_const == true);
}

// Group C: 배열 리터럴 (2개)

test "parser_array_literal_simple" {
    const source = "const arr = [1, 2, 3];";
    const ast = try parseSource(source);
    defer ast.deinit();

    const const_decl = ast.root.data.block[0];
    try std.testing.expect(const_decl.tag == .const_decl);

    const array_lit = const_decl.data.const_decl.value;
    try std.testing.expect(array_lit.tag == .array_literal);
    try std.testing.expect(array_lit.data.array_literal.len == 3);
}

test "parser_array_literal_nested" {
    const source = "const matrix = [[1, 2], [3, 4]];";
    const ast = try parseSource(source);
    defer ast.deinit();

    const const_decl = ast.root.data.block[0];
    const outer_array = const_decl.data.const_decl.value;

    try std.testing.expect(outer_array.tag == .array_literal);
    try std.testing.expect(outer_array.data.array_literal.len == 2);

    // 첫 번째 요소도 배열
    const inner1 = &outer_array.data.array_literal[0];
    try std.testing.expect(inner1.tag == .array_literal);
    try std.testing.expect(inner1.data.array_literal.len == 2);
}

// Group D: 인덱싱 (2개)

test "parser_array_indexing" {
    const source = "const x = arr[0];";
    const ast = try parseSource(source);
    defer ast.deinit();

    const const_decl = ast.root.data.block[0];
    const index_access = const_decl.data.const_decl.value;

    try std.testing.expect(index_access.tag == .index_access);
    try std.testing.expect(index_access.data.index_access.array.tag == .identifier);
    try std.testing.expect(index_access.data.index_access.index.tag == .integer_literal);
}

test "parser_nested_indexing" {
    const source = "const val = matrix[0][1];";
    const ast = try parseSource(source);
    defer ast.deinit();

    const const_decl = ast.root.data.block[0];
    const outer_index = const_decl.data.const_decl.value;

    try std.testing.expect(outer_index.tag == .index_access);

    // 배열 부분이 또 다른 index_access
    const inner_index = outer_index.data.index_access.array;
    try std.testing.expect(inner_index.tag == .index_access);
}

// Group E: 슬라이싱 (2개)

test "parser_array_slicing" {
    const source = "const slice = arr[1..3];";
    const ast = try parseSource(source);
    defer ast.deinit();

    const const_decl = ast.root.data.block[0];
    const slice_access = const_decl.data.const_decl.value;

    try std.testing.expect(slice_access.tag == .slice_access);
    try std.testing.expect(slice_access.data.slice_access.array.tag == .identifier);
    try std.testing.expect(slice_access.data.slice_access.start != null);
    try std.testing.expect(slice_access.data.slice_access.end != null);
}

test "parser_slice_of_array" {
    const source = "const part = arr[0..];";
    const ast = try parseSource(source);
    defer ast.deinit();

    const const_decl = ast.root.data.block[0];
    const slice_access = const_decl.data.const_decl.value;

    try std.testing.expect(slice_access.tag == .slice_access);
    try std.testing.expect(slice_access.data.slice_access.start != null);
    try std.testing.expect(slice_access.data.slice_access.end == null);  // 끝이 없음
}

// Group F: 복합 (3개)

test "parser_array_in_function" {
    const source =
        \\fn process(arr: [5]i32) i32 {
        \\  const x = arr[2];
        \\  return x;
        \\}
    ;
    const ast = try parseSource(source);
    defer ast.deinit();

    const fn_decl = ast.root.data.block[0];
    try std.testing.expect(fn_decl.tag == .fn_decl);

    // 파라미터 타입 확인
    try std.testing.expect(fn_decl.data.fn_decl.params[0].type_node.tag == .type_array);

    // 함수 본체에서 배열 접근
    const fn_body = fn_decl.data.fn_decl.body;
    try std.testing.expect(fn_body.tag == .block);
}

test "parser_slice_parameter" {
    const source =
        \\fn sum(nums: []i32) i32 {
        \\  return 0;
        \\}
    ;
    const ast = try parseSource(source);
    defer ast.deinit();

    const fn_decl = ast.root.data.block[0];
    const param = &fn_decl.data.fn_decl.params[0];

    try std.testing.expect(param.type_node.tag == .type_slice);
    try std.testing.expectEqualSlices(u8, param.name, "nums");
}

test "parser_array_type_annotation" {
    const source = "const arr: [100]u8 = [0] ** 100;";
    const ast = try parseSource(source);
    defer ast.deinit();

    const const_decl = ast.root.data.block[0];
    try std.testing.expect(const_decl.data.const_decl.type_annotation != null);

    const type_node = const_decl.data.const_decl.type_annotation.?;
    try std.testing.expect(type_node.tag == .type_array);
}
