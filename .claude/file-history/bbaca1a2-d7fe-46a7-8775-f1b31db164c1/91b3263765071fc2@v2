### 5. 헬퍼 함수들 (sema.zig)

#### A. typesEqual()
```zig
fn typesEqual(self: *Sema, t1: AirType, t2: AirType) bool {
    return switch (t1) {
        .integer => t2 == .integer,
        .float => t2 == .float,
        .string => t2 == .string,
        .boolean => t2 == .boolean,
        .unknown => true,  // unknown은 모든 타입과 매칭
        else => false,
    };
}
```

**예상 코드**: 15줄

#### B. canImplicitlyConvert()
```zig
fn canImplicitlyConvert(self: *Sema, from: AirType, to: AirType) bool {
    return switch (from) {
        .integer => to == .float,  // i32 → f64 자동 변환
        .boolean => to == .integer,  // bool → i32
        else => false,
    };
}
```

**예상 코드**: 12줄

#### C. makeOverloadCacheKey()
```zig
fn makeOverloadCacheKey(
    self: *Sema,
    fn_name: []const u8,
    arg_types: []AirType,
) ![]u8 {
    // fn_name + arg_types의 조합으로 캐시 키 생성
    var buffer = std.ArrayList(u8).init(self.allocator);
    try buffer.appendSlice(fn_name);
    try buffer.appendSlice(":");
    for (arg_types) |t| {
        try buffer.appendSlice(@tagName(t));
        try buffer.appendSlice(",");
    }
    return buffer.toOwnedSlice();
}
```

**예상 코드**: 15줄

