### 6. 초기화 함수 수정

```zig
pub fn init(allocator: std.mem.Allocator, zir: *const Zir) !Sema {
    var sema = Sema{
        .zir = zir,
        .air = try allocator.create(Air),
        .allocator = allocator,
        .types = std.StringHashMap(AirType).init(allocator),
        .scopes = std.ArrayList(Scope).init(allocator),
        .overload_groups = std.StringHashMap([]Zir.FunctionSignature).init(allocator),
        .overload_resolution_cache = std.StringHashMap(u32).init(allocator),
    };

    // ZIR의 overload_group 명령어에서 오버로드 그룹 추출
    for (zir.instructions.items, 0..) |inst, idx| {
        if (inst == .overload_group) {
            const group = inst.overload_group;
            const name = zir.strings.get(...)?;  // TODO: 정확한 인덱스 접근
            try sema.overload_groups.put(name, group.signatures);
        }
    }

    return sema;
}
```

