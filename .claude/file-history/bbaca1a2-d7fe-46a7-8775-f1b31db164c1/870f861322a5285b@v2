test "full_pipeline_compile" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var linker = try Linker.init(allocator);
    defer linker.deinit();

    if (linker.llvm_path == null) {
        // clang 없음 - skip
        return;
    }

    const source = "fn main() i32 { return 42; }";
    const ir_text = try compileToLLVMIR(source, allocator);
    defer allocator.free(ir_text);

    const ll_file = try Linker.generateTempFileName(allocator, ".ll");
    defer allocator.free(ll_file);
    const out_file = try Linker.generateTempFileName(allocator, "");
    defer allocator.free(out_file);

    defer {
        std.fs.cwd().deleteFile(ll_file) catch {};
        std.fs.cwd().deleteFile(out_file) catch {};
    }

    try Linker.writeIRToFile(ir_text, ll_file);

    // clang이 있으면 실제 컴파일 시도
    linker.compileFromLLVMIR(ll_file, out_file) catch |err| {
        // 컴파일 실패해도 괜찮음 (clang 설치 상태에 따라 다름)
        std.debug.print("\nℹ️  Compilation skipped (clang may not be installed): {}\n", .{err});
        return;
    };

    // 컴파일 성공하면 바이너리 파일 확인
    try std.testing.expect(Linker.fileExists(out_file));
}
