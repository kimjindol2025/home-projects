// 🦎 Phase 3: Generic Type Support - Test Cases
// test/phase3_generic_test.zig: Generic 함수, 구조체 등 테스트

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const Ast = @import("../src/ast.zig");

/// 소스 코드를 파싱하는 헬퍼 함수
fn parseSource(source: []const u8, allocator: std.mem.Allocator) !Ast {
    var tokenizer = try Tokenizer.init(source, allocator);
    defer tokenizer.deinit();

    var tokens = std.ArrayList(Tokenizer.Token).init(allocator);
    defer tokens.deinit();

    while (try tokenizer.nextToken()) |token| {
        try tokens.append(token);
    }

    var parser = try Parser.init(tokens.items, source, allocator);
    defer parser.deinit();
    return try parser.parseProgram();
}

// ========== 1. Generic 함수 기본 파싱 ==========

test "parse_generic_function_simple" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    // Generic 함수: fn max(comptime T: type, a: T, b: T) T { ... }
    const source = "fn max(comptime T: type, a: T, b: T) T { return a; }";

    const ast = try parseSource(source, allocator);

    // 파싱 성공 확인
    try std.testing.expect(ast.root.tag == .root);

    // 첫 번째 자식이 함수 선언이어야 함
    const fn_node = ast.root.data.block[0];
    try std.testing.expect(fn_node.tag == .fn_decl);

    // 함수 이름 확인
    try std.testing.expect(std.mem.eql(u8, fn_node.data.fn_decl.name, "max"));

    // 파라미터 개수 확인 (3개: T, a, b)
    try std.testing.expect(fn_node.data.fn_decl.params.len == 3);

    // 첫 번째 파라미터: comptime T: type
    const param0 = fn_node.data.fn_decl.params[0];
    try std.testing.expect(std.mem.eql(u8, param0.name, "T"));
    try std.testing.expect(param0.is_comptime == true);

    // 두 번째 파라미터: a: T
    const param1 = fn_node.data.fn_decl.params[1];
    try std.testing.expect(std.mem.eql(u8, param1.name, "a"));
    try std.testing.expect(param1.is_comptime == false);

    // 세 번째 파라미터: b: T
    const param2 = fn_node.data.fn_decl.params[2];
    try std.testing.expect(std.mem.eql(u8, param2.name, "b"));
    try std.testing.expect(param2.is_comptime == false);
}

