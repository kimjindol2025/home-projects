test "parse_multiple_generic_params" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    // 여러 개의 Generic 파라미터
    const source = "fn pair(comptime T: type, comptime U: type, a: T, b: U) i32 { return 0; }";

    const ast = try parseSource(source, allocator);
    const fn_node = ast.root.data.block[0];

    try std.testing.expect(fn_node.data.fn_decl.params.len == 4);

    // 첫 번째: comptime T: type
    try std.testing.expect(fn_node.data.fn_decl.params[0].is_comptime == true);

    // 두 번째: comptime U: type
    try std.testing.expect(fn_node.data.fn_decl.params[1].is_comptime == true);

    // 세 번째: a: T
    try std.testing.expect(fn_node.data.fn_decl.params[2].is_comptime == false);

    // 네 번째: b: U
    try std.testing.expect(fn_node.data.fn_decl.params[3].is_comptime == false);
}

// ========== 2. Regular 함수 (Comptime 파라미터 없음) ==========

test "parse_regular_function_still_works" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source = "fn add(a: i32, b: i32) i32 { return a + b; }";

    const ast = try parseSource(source, allocator);
    const fn_node = ast.root.data.block[0];

    try std.testing.expect(fn_node.data.fn_decl.params.len == 2);

    // 모든 파라미터가 comptime이 아니어야 함
    for (fn_node.data.fn_decl.params) |param| {
        try std.testing.expect(param.is_comptime == false);
    }
}

// ========== 3. Generic 함수 호출 (AST 수준) ==========

test "parse_generic_function_call" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    // Generic 함수 정의 + 호출
    const source =
        \\fn max(comptime T: type, a: T, b: T) T {
        \\    return a;
        \\}
        \\fn main() i32 {
        \\    const x = max(i32, 5, 10);
        \\    return x;
        \\}
    ;

    const ast = try parseSource(source, allocator);

    // 2개의 함수가 파싱되어야 함
    try std.testing.expect(ast.root.data.block.len >= 2);
}

// ========== 4. Comptime 블록 ==========

test "parse_comptime_block" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\fn main() void {
        \\    comptime {
        \\        const x = 5;
        \\    }
        \\}
    ;

    // 현재는 comptime 블록을 완전히 지원하지 않지만,
    // 적어도 파싱이 실패하지 않아야 함 (또는 에러 처리)
    const ast = try parseSource(source, allocator);
    try std.testing.expect(ast.root.data.block.len >= 1);
}

