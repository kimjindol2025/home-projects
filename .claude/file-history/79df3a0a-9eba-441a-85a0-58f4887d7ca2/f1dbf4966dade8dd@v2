// Debug CALL instruction
const { tokenize } = require('./dist/lexer/lexer');
const { parse } = require('./dist/parser/parser');
const { IRCompiler } = require('./dist/runtime/ir');
const { VM, NativeLibrary } = require('./dist/runtime/vm');

const code = `print(42)`;

console.log('Parsing...');
const tokens = tokenize(code);
const ast = parse(tokens);

console.log('\nCompiling...');
const compiler = new IRCompiler();
const program = compiler.compile(ast);

console.log('\nGenerated Code:');
program.code.forEach((instr, i) => {
  console.log(`  ${i}: ${instr.op} args=${JSON.stringify(instr.args)}`);
});

console.log('\nConstants:');
program.constants.forEach((c, i) => {
  console.log(`  ${i}: ${JSON.stringify(c)}`);
});

console.log('\nExecuting...');
const vm = new VM(program);

// Register native library
console.log('\nRegistering functions:');
Object.entries(NativeLibrary).forEach(([name, func]) => {
  console.log(`  - ${name}`);
  vm.setGlobal(name, func);
});

try {
  vm.execute();
  console.log('\n✅ Success');
  console.log('Output:', vm.getOutput());
} catch (error) {
  console.error('\n❌ Error:', error.message);
  console.error(error.stack);
}
