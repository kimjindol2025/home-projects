#!/bin/bash
# log-agent-activity.sh: 에이전트 활동 기록 스크립트

AGENT=$1        # cmo, content-writer, social-media, community-manager, analytics
ACTIVITY=$2     # 활동 내용
RESULT=$3       # 결과 (완료, 실패, 대기 등)
KPI=$4          # KPI 수치

TIMESTAMP=$(date '+%Y-%m-%dT%H:%M:%S')
TEAM_LOG=~/ai-marketing-team/team-log.csv
MEMORY_FILE=~/.claude/agent-memory/${AGENT}-memory.md

# team-log.csv에 기록
echo "$TIMESTAMP,$AGENT,$ACTIVITY,$RESULT,$KPI" >> "$TEAM_LOG"

# 에이전트 메모리 파일에도 최근 활동 추가
if [ -f "$MEMORY_FILE" ]; then
    echo "" >> "$MEMORY_FILE"
    echo "**$TIMESTAMP**: $ACTIVITY → $RESULT" >> "$MEMORY_FILE"

    # 메모리 파일이 너무 커지지 않도록 200줄 초과시 정리
    if [ $(wc -l < "$MEMORY_FILE") -gt 200 ]; then
        tail -100 "$MEMORY_FILE" > "${MEMORY_FILE}.tmp"
        mv "${MEMORY_FILE}.tmp" "$MEMORY_FILE"
    fi
fi

echo "✅ Logged: [$AGENT] $ACTIVITY → $RESULT ($KPI)"
