#!/bin/bash
# spawn-agent.sh: 에이전트 자동 스폰 및 컨텍스트 제한 스크립트

AGENT=$1  # cmo, content-writer, social-media, community-manager, analytics
AGENT_FILE=~/.claude/agents/${AGENT}.md
MEMORY_FILE=~/.claude/agent-memory/${AGENT}-memory.md
TEAM_LOG=~/ai-marketing-team/team-log.csv

if [ ! -f "$AGENT_FILE" ]; then
    echo "❌ Agent file not found: $AGENT_FILE"
    exit 1
fi

echo "🚀 Starting $AGENT Agent..."
echo "📋 Context size: $(wc -c < $AGENT_FILE) bytes"

# 필수 읽을 파일만 표시 (에이전트가 read에서 선택)
if [ -f "$MEMORY_FILE" ]; then
    echo "📝 Agent Memory (최근 10줄):"
    tail -10 "$MEMORY_FILE"
fi

echo "📊 Recent Team Activity (최근 5줄):"
tail -5 "$TEAM_LOG" 2>/dev/null || echo "team-log.csv 아직 없음"

echo ""
echo "✅ Ready for agent execution"
echo "Agent: $AGENT"
echo "Model: $(grep 'model:' $AGENT_FILE | awk '{print $2}')"
echo "Schedule: $(grep 'schedule:' $AGENT_FILE | awk '{print $2}' | tr -d '\"')"
