# FreeLang Marketing Team Agent Schedule
# 각 라인: MIN HOUR DOM MON DOW COMMAND

# 일요일 21:00 - CMO (주간 전략 수립)
0 21 * * 0 ~/scripts/spawn-agent.sh cmo >> /tmp/cmo-$(date +\%Y\%m\%d).log 2>&1 && ~/scripts/log-agent-activity.sh cmo "주간전략수립" "완료" "KPI분석완료"

# 월/수/금 09:00 - Content Writer (블로그 작성)
0 9 * * 1,3,5 ~/scripts/spawn-agent.sh content-writer >> /tmp/content-$(date +\%Y\%m\%d).log 2>&1

# 화/목 10:00 - Community Manager (커뮤니티 참여)
0 10 * * 2,4 ~/scripts/spawn-agent.sh community-manager >> /tmp/community-$(date +\%Y\%m\%d).log 2>&1

# 매일 22:00 - Analytics (일일 성과 분석)
0 22 * * * ~/scripts/spawn-agent.sh analytics >> /tmp/analytics-$(date +\%Y\%m\%d).log 2>&1

