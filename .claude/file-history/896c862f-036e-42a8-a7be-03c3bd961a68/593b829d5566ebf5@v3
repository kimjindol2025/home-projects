name: Test & Validation

on:
  push:
    branches: [ master, main, develop ]
  pull_request:
    branches: [ master, main ]

env:
  NODE_VERSION: '20'
  NODE_ENV: test

jobs:
  test:
    runs-on: ubuntu-latest

    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_DB: freelang_test
          POSTGRES_USER: freelang
          POSTGRES_PASSWORD: test123
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432

      redis:
        image: redis:7-alpine
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 6379:6379

    steps:
    - name: 📥 Checkout code
      uses: actions/checkout@v3

    - name: 🔧 Set up Node.js ${{ env.NODE_VERSION }}
      uses: actions/setup-node@v3
      with:
        node-version: ${{ env.NODE_VERSION }}
        cache: 'npm'

    - name: 📦 Install dependencies
      run: npm ci

    - name: 🔍 Run linter
      run: npm run lint --if-present
      continue-on-error: true

    - name: ✅ Run unit tests
      run: npm test --if-present
      env:
        DATABASE_URL: postgresql://freelang:test123@localhost:5432/freelang_test
        REDIS_URL: redis://localhost:6379
        JWT_SECRET: test-jwt-secret-for-ci-do-not-use-in-production
        JWT_REFRESH_SECRET: test-refresh-secret-for-ci-do-not-use-in-production

    - name: 📊 Generate coverage report
      run: npm run coverage --if-present
      continue-on-error: true

    - name: 📈 Upload coverage to Codecov
      uses: codecov/codecov-action@v3
      if: always()
      with:
        files: ./coverage/coverage-final.json
        flags: unittests
        name: codecov-umbrella
        fail_ci_if_error: false

  build:
    runs-on: ubuntu-latest
    needs: test

    steps:
    - name: 📥 Checkout code
      uses: actions/checkout@v3

    - name: 🔧 Set up Node.js
      uses: actions/setup-node@v3
      with:
        node-version: ${{ env.NODE_VERSION }}
        cache: 'npm'

    - name: 📦 Install dependencies
      run: npm ci

    - name: 🏗️ Build project
      run: npm run build --if-present

    - name: ✨ Check build artifacts
      run: |
        if [ -d "dist" ]; then
          echo "✅ Build artifacts created:"
          ls -lh dist/ | head -20
        else
          echo "⚠️  No dist directory found"
        fi

    - name: 📤 Upload artifacts
      uses: actions/upload-artifact@v3
      if: always()
      with:
        name: build-artifacts
        path: dist/
        retention-days: 7

  deploy:
    runs-on: ubuntu-latest
    needs: build
    if: github.ref == 'refs/heads/master' && github.event_name == 'push'

    steps:
    - name: 📥 Checkout code
      uses: actions/checkout@v3

    - name: 📥 Download artifacts
      uses: actions/download-artifact@v3
      with:
        name: build-artifacts
        path: dist/

    - name: 🚀 Deploy to 253.dclub.kr
      env:
        DEPLOY_KEY: ${{ secrets.DEPLOY_KEY }}
        DEPLOY_HOST: ${{ secrets.DEPLOY_HOST }}
        DEPLOY_USER: ${{ secrets.DEPLOY_USER }}
      run: |
        echo "🚀 Deployment to 253.dclub.kr prepared"
        echo "✅ Secrets configured: ${DEPLOY_HOST:+✓} ${DEPLOY_USER:+✓}"
        # Deployment script will execute here when secrets are set
