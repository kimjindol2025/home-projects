import rateLimit from 'express-rate-limit';

app.use(helmet());
app.use('/auth', rateLimit({ windowMs: 15*60*1000, max: 10 }));
app.use('/api', rateLimit({ windowMs: 60*1000, max: 100 }));
```

**oauth-handler.ts 변경:**
```typescript
// 변경 전 (위험):
private jwtSecret = process.env.JWT_SECRET || 'your-secret-key';

// 변경 후 (안전):
