JWT_SECRET= node dist/server.js  # → FATAL 에러 즉시 crash
curl -I localhost:3001/api/health | grep X-Frame  # helmet 헤더 확인

# Phase 2 검증
curl localhost:3001/auth/google  # redirect URL에 token 없음 확인
curl -X POST localhost:3001/auth/exchange -d '{"code":"..."}' # 토큰 교환

# Phase 3 검증
curl "localhost:3001/auth/google/callback?code=ab"  # 400 Validation failed

# Phase 4 검증
npx jest --listTests | grep oauth  # src/auth/__tests__ 포함 확인
npm run coverage  # 커버리지 리포트 출력

# Phase 5 검증
curl localhost:3001/api/docs  # HTML 반환
```

