openapi: 3.0.0
info:
  title: FreeLang Light API
  version: 1.0.0
  description: |
    FreeLang Light 블로그 플랫폼 API 명세서
    
    **기본 URL**: https://253.dclub.kr/api
    **인증**: JWT Bearer Token
  contact:
    name: FreeLang Team
    url: https://freelang.kr
  license:
    name: MIT

servers:
  - url: https://253.dclub.kr/api
    description: Production
  - url: http://localhost:3001/api
    description: Development

components:
  securitySchemes:
    BearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
    CookieAuth:
      type: apiKey
      in: cookie
      name: refreshToken

  schemas:
    Post:
      type: object
      properties:
        id:
          type: integer
        title:
          type: string
        content:
          type: string
        author:
          type: string
        views:
          type: integer
        created_at:
          type: string
          format: date-time

    User:
      type: object
      properties:
        id:
          type: integer
        username:
          type: string
        email:
          type: string
        role:
          type: string
          enum: [user, admin]

    Comment:
      type: object
      properties:
        id:
          type: integer
        post_id:
          type: integer
        author:
          type: string
        content:
          type: string
        created_at:
          type: string
          format: date-time

paths:
  /posts:
    get:
      summary: 모든 글 조회
      tags: [Posts]
      responses:
        '200':
          description: 성공
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Post'

    post:
      summary: 새 글 작성
      tags: [Posts]
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                title:
                  type: string
                content:
                  type: string
      responses:
        '201':
          description: 생성됨
        '401':
          description: 인증 필요

  /posts/{id}:
    get:
      summary: 특정 글 조회
      tags: [Posts]
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: 성공
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Post'
        '404':
          description: 글을 찾을 수 없음

    put:
      summary: 글 수정
      tags: [Posts]
      security:
        - BearerAuth: []
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: 성공
        '401':
          description: 인증 필요
        '403':
          description: 권한 없음

    delete:
      summary: 글 삭제
      tags: [Posts]
      security:
        - BearerAuth: []
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '204':
          description: 성공
        '401':
          description: 인증 필요

  /auth/google/callback:
    get:
      summary: Google OAuth 콜백
      tags: [Auth]
      parameters:
        - name: code
          in: query
          required: true
          schema:
            type: string
      responses:
        '200':
          description: 인증 성공 - 리다이렉트 to /auth/callback?code=...
        '400':
          description: 인증 코드 누락
        '500':
          description: OAuth 실패

  /auth/exchange:
    post:
      summary: 인증 코드를 토큰으로 교환
      tags: [Auth]
      parameters:
        - name: code
          in: query
          required: true
          schema:
            type: string
            minLength: 10
            maxLength: 500
      responses:
        '200':
          description: 토큰 교환 성공
          content:
            application/json:
              schema:
                type: object
                properties:
                  accessToken:
                    type: string
                    description: JWT 액세스 토큰 (15분 유효)
                  user:
                    type: object
                    properties:
                      id:
                        type: string
                      email:
                        type: string
                      name:
                        type: string
                      avatar:
                        type: string
                      provider:
                        type: string
                  expiresIn:
                    type: integer
                    description: 만료 시간 (초)
          headers:
            Set-Cookie:
              schema:
                type: string
                example: refreshToken=...; HttpOnly; Secure; SameSite=Strict
        '400':
          description: 유효성 검사 실패
        '401':
          description: 잘못되거나 만료된 인증 코드

  /auth/refresh:
    post:
      summary: 리프레시 토큰으로 새 액세스 토큰 발급
      tags: [Auth]
      security:
        - CookieAuth: []
      responses:
        '200':
          description: 토큰 갱신 성공
          content:
            application/json:
              schema:
                type: object
                properties:
                  accessToken:
                    type: string
                    description: 새로운 JWT 액세스 토큰 (15분 유효)
                  expiresIn:
                    type: integer
                    description: 만료 시간 (초)
        '401':
          description: 리프레시 토큰 누락 또는 유효하지 않음

  /health:
    get:
      summary: 헬스 체크
      tags: [System]
      responses:
        '200':
          description: 시스템 정상
          content:
            application/json:
              schema:
                type: object
                properties:
                  status:
                    type: string
                  timestamp:
                    type: string
