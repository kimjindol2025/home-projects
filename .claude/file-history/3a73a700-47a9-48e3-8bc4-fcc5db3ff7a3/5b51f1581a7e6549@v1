## 🎓 주요 개념

### Error Type System
```zig
// 에러 타입 정의
const FileError = error {
    NotFound,
    PermissionDenied,
    IO,
};

// 에러 유니온 반환
fn openFile(path: []const u8) !FileError {
    // 성공: 파일 핸들
    // 실패: FileError 타입 에러
}

// 에러 처리
const file = try openFile("data.txt") catch |err| {
    print("Error: {}", .{err});
    return;
};
```

### Try-Catch Pattern
```zig
// 기본 try
try getValue();

// try-catch
try getValue() catch |err| {
    print(err);
};

// 중첩
try (try inner()) catch |e| {
    print(e);
};
```

### Error Propagation
```zig
// 자동 전파 (? 사용)
fn process(): !void {
    const data = try readFile();  // 에러 전파
    return;
}

// try 없으면 컴파일 에러
// catch 있으면 처리
```

