// 🦎 Phase 7: 바이너리 실행 E2E 테스트
// test/phase7_e2e_test.zig

const std = @import("std");
const Tokenizer = @import("../src/tokenizer.zig").Tokenizer;
const Parser = @import("../src/parser.zig").Parser;
const AstGen = @import("../src/astgen.zig").AstGen;
const Sema = @import("../src/sema.zig").Sema;
const Codegen = @import("../src/codegen.zig").Codegen;
const LLVMIRGen = @import("../src/llvm_ir.zig").LLVMIRGen;
const Linker = @import("../src/linker.zig").Linker;

/// 소스 코드 → LLVM IR → 바이너리 → 실행 결과 반환
fn compileAndRun(source: []const u8, allocator: std.mem.Allocator) !Linker.RunResult {
    // Step 1: Tokenize
    var tokenizer = try Tokenizer.init(source, allocator);
    defer tokenizer.deinit();

    var tokens = std.ArrayList(@import("../src/tokenizer.zig").Token).init(allocator);
    defer tokens.deinit();

    while (try tokenizer.nextToken()) |token| {
        try tokens.append(token);
    }

    // Step 2: Parse
    var parser = try Parser.init(tokens.items, source, allocator);
    defer parser.deinit();
    const ast = try parser.parseProgram();

    // Step 3: AstGen
    var astgen = try AstGen.init(allocator, source);
    defer astgen.deinit();
    try astgen.genProgram(&ast);

    // Step 4: Sema
    var sema = try Sema.init(allocator, &astgen.zir);
    defer sema.deinit();
    try sema.analyzeProgram();

    if (sema.hasErrors()) {
        return error.SemanticErrors;
    }

    // Step 5: LLVMIRGen
    var llvm_gen = try LLVMIRGen.init(allocator, &sema.air);
    defer llvm_gen.deinit();
    const ir_text = try llvm_gen.generate();

    // Step 6: Compile LLVM IR to binary
    var linker = try Linker.init(allocator);
    defer linker.deinit();

    if (linker.llvm_path == null) {
        return error.NoLLVMCompilerFound;
    }

    // 임시 파일 생성
    const temp_ll = try Linker.generateTempFileName(allocator, ".ll");
    defer allocator.free(temp_ll);
    const temp_bin = try Linker.generateTempFileName(allocator, "");
    defer allocator.free(temp_bin);

    // IR을 .ll 파일에 저장
    try Linker.writeIRToFile(ir_text, temp_ll);
    defer Linker.deleteFile(temp_ll) catch {};

    // .ll을 바이너리로 컴파일
    try linker.compileFromLLVMIR(temp_ll, temp_bin);
    defer Linker.deleteFile(temp_bin) catch {};

    // 바이너리 실행
    return try Linker.runBinary(temp_bin, allocator);
}

// ========== Phase 7 테스트: Exit Code (3개) ==========

test "phase7_run_return_zero" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\fn main() i32 {
        \\    return 0;
        \\}
    ;

    const result = compileAndRun(source, allocator) catch |err| {
        std.debug.print("Skip: {}\n", .{err});
        return;
    };

    try std.testing.expectEqual(@as(u8, 0), result.exit_code);
}

