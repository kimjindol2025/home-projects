const std = @import("std");
const Air = @import("../src/air.zig").Air;
const Optimizer = @import("../src/optimizer.zig").Optimizer;
const Instruction = @import("../src/air.zig").Instruction;
const BinaryOp = @import("../src/air.zig").BinaryOp;

// ========== Phase 8 테스트: 상수 폴딩 (3개) ==========

test "phase8_fold_add_constants" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    // 3 + 4 → 7
    var instructions = std.ArrayList(Instruction).init(allocator);
    defer instructions.deinit();

    try instructions.append(.{ .load_int = .{ .value = 3 } });
    try instructions.append(.{ .load_int = .{ .value = 4 } });
    try instructions.append(.{
        .binary_op = .{
            .op = .add,
            .lhs = 0,
            .rhs = 1,
            .ty = .i64,
        },
    });

    var air = Air{
        .instructions = instructions,
        .strings = std.ArrayList(u8).init(allocator),
        .source = "",
    };
    defer air.strings.deinit();

    var optimizer = Optimizer.init(allocator, &air);
    defer optimizer.deinit();

    const opt_air = try optimizer.optimize();
    _ = opt_air;

    // 결과: fold_int(7) 또는 비슷한 최적화
    // 간단한 검증: 최적화 후 명령어 수 확인
    try std.testing.expect(optimizer.optimized_instructions.items.len <= 3);
}

