    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\fn add(a: i32, b: i32) i32 {
        \\    return a + b;
        \\}
        \\fn main() i32 {
        \\    return add(20, 22);
        \\}
    ;

    const ir_text = try compileToIR(source, .aarch64_linux, allocator);
    defer allocator.free(ir_text);

    // ARM64 triple 및 data layout 확인
    try std.testing.expect(std.mem.containsAtLeast(u8, ir_text, 1, "aarch64-unknown-linux-gnu"));
    try std.testing.expect(std.mem.containsAtLeast(u8, ir_text, 1, "target datalayout"));
}

test "phase9_all_targets_ir_generation" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\fn main() i32 {
        \\    return 0;
        \\}
    ;

    const targets = [_]Target{
        .x86_64_linux,
        .aarch64_linux,
        .riscv64_linux,
        .x86_64_macos,
        .aarch64_macos,
    };

    for (targets) |target| {
        const ir_text = try compileToIR(source, target, allocator);
        defer allocator.free(ir_text);

        // 모든 타겟에 대해 IR이 생성되는지 확인
        try std.testing.expect(ir_text.len > 0);

        // target triple이 포함되어 있는지 확인
        try std.testing.expect(std.mem.containsAtLeast(u8, ir_text, 1, "target triple"));
    }
}
