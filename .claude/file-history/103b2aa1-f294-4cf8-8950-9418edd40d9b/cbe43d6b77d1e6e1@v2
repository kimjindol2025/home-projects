test "phase9_default_target_x86" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\fn main() i32 {
        \\    return 0;
        \\}
    ;

    // 기본 타겟 (initWithTarget 없이 init() 호출)
    var tokenizer = try Tokenizer.init(source, allocator);
    defer tokenizer.deinit();

    var tokens = std.ArrayList(@import("../src/tokenizer.zig").Token).init(allocator);
    defer tokens.deinit();

    while (try tokenizer.nextToken()) |token| {
        try tokens.append(token);
    }

    var parser = try Parser.init(tokens.items, source, allocator);
    defer parser.deinit();
    const ast = try parser.parseProgram();

    var astgen = try AstGen.init(allocator, source);
    defer astgen.deinit();
    try astgen.genProgram(&ast);

    var sema = try Sema.init(allocator, &astgen.zir);
    defer sema.deinit();
    try sema.analyzeProgram();

    // 기본 init() 사용 → x86_64_linux 기본값
    var llvm_gen = try LLVMIRGen.init(allocator, &sema.air);
    defer llvm_gen.deinit();

    const ir_text = try llvm_gen.generate();
    defer allocator.free(ir_text);

    // x86_64 기본 타겟 확인
    try std.testing.expect(std.mem.containsAtLeast(u8, ir_text, 1, "x86_64-unknown-linux-gnu"));
}

// ========== Phase 9 테스트: 크로스 컴파일 (2개) ==========

test "phase9_cross_compile_if_available" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\fn main() i32 {
        \\    return 7;
        \\}
    ;

    const ir_text = try compileToIR(source, .aarch64_linux, allocator);
    defer allocator.free(ir_text);

    // IR에 ARM64 triple이 포함되어 있는지 확인
    try std.testing.expect(std.mem.containsAtLeast(u8, ir_text, 1, "aarch64-unknown-linux-gnu"));

    var linker = try Linker.init(allocator);
    defer linker.deinit();

    // clang이 있으면 크로스 컴파일 시도 (선택적)
    if (linker.llvm_path != null) {
        const temp_ll = try Linker.generateTempFileName(allocator, "_test.ll");
        defer allocator.free(temp_ll);
        const temp_bin = try Linker.generateTempFileName(allocator, "_test_arm");
        defer allocator.free(temp_bin);

        try Linker.writeIRToFile(ir_text, temp_ll);
        defer Linker.deleteFile(temp_ll) catch {};

        // clang --target aarch64-unknown-linux-gnu 사용 (구현 미포함, 테스트만 검증)
        _ = temp_bin;
    }
}

test "phase9_cross_target_binary_exists" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\fn main() i32 {
        \\    return 0;
        \\}
    ;

    var linker = try Linker.init(allocator);
    defer linker.deinit();

    if (linker.llvm_path != null) {
        const ir_text = try compileToIR(source, .x86_64_linux, allocator);
        defer allocator.free(ir_text);

        const temp_ll = try Linker.generateTempFileName(allocator, "_check.ll");
        defer allocator.free(temp_ll);

        try Linker.writeIRToFile(ir_text, temp_ll);
        defer Linker.deleteFile(temp_ll) catch {};

        // IR 파일이 생성되었는지 확인
        try std.testing.expect(Linker.fileExists(temp_ll));
    }
}

