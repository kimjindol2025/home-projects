test "phase9_ir_has_correct_datalayout" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\fn main() i32 {
        \\    return 0;
        \\}
    ;

    const ir_x86 = try compileToIR(source, .x86_64_linux, allocator);
    const ir_arm = try compileToIR(source, .aarch64_linux, allocator);
    defer {
        allocator.free(ir_x86);
        allocator.free(ir_arm);
    }

    // x86_64와 aarch64의 data layout이 다른지 확인
    try std.testing.expect(!std.mem.eql(u8, ir_x86, ir_arm));
}

// ========== Phase 9 테스트: 파일 출력 (3개) ==========

test "phase9_write_arm64_ir" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\fn main() i32 {
        \\    return 42;
        \\}
    ;

    const ir_text = try compileToIR(source, .aarch64_linux, allocator);
    defer allocator.free(ir_text);

    // 임시 파일에 저장
    const temp_file = try Linker.generateTempFileName(allocator, "_arm64.ll");
    defer allocator.free(temp_file);

    try Linker.writeIRToFile(ir_text, temp_file);
    defer Linker.deleteFile(temp_file) catch {};

    // 파일이 존재하는지 확인
    try std.testing.expect(Linker.fileExists(temp_file));
}

