// ========== Phase 9 테스트: IR 생성 (3개) ==========

test "phase9_ir_has_correct_triple_x86" {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    const source =
        \\fn main() i32 {
        \\    return 0;
        \\}
    ;

    const ir_text = try compileToIR(source, .x86_64_linux, allocator);
    defer allocator.free(ir_text);

    // x86_64 triple 확인
    try std.testing.expect(std.mem.containsAtLeast(u8, ir_text, 1, "x86_64-unknown-linux-gnu"));
}

