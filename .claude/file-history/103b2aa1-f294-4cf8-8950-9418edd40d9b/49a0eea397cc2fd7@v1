// 🦎 Mini Zig Compiler - Main Entry Point
// src/main.zig: Tokenizer → Parser → AST → AstGen → ZIR → Sema → AIR → Codegen → Linker

const std = @import("std");
const Tokenizer = @import("tokenizer.zig").Tokenizer;
const Token = @import("tokenizer.zig").Token;
const Parser = @import("parser.zig").Parser;
const Ast = @import("ast.zig");
const printAst = @import("ast.zig").printAst;
const AstGen = @import("astgen.zig").AstGen;
const printZir = @import("zir.zig").printZir;
const Sema = @import("sema.zig").Sema;
const printAir = @import("air.zig").printAir;
const Codegen = @import("codegen.zig").Codegen;
const LLVMIRGen = @import("llvm_ir.zig").LLVMIRGen;
const Linker = @import("linker.zig").Linker;

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    // CLI 인수 처리
    const args = try std.process.argsAlloc(allocator);
    defer std.process.argsFree(allocator, args);

    var emit_c_only = false;
    var emit_llvm_only = false;
    var use_llvm_backend = false;
    var input_file: ?[]const u8 = null;
    var output_file: []const u8 = "output";

    // 인수 파싱
    var i: usize = 1;
    while (i < args.len) : (i += 1) {
        if (std.mem.eql(u8, args[i], "--emit-c")) {
            emit_c_only = true;
        } else if (std.mem.eql(u8, args[i], "--emit-llvm")) {
            emit_llvm_only = true;
        } else if (std.mem.eql(u8, args[i], "--llvm")) {
            use_llvm_backend = true;
        } else if (std.mem.eql(u8, args[i], "-o")) {
            i += 1;
            if (i < args.len) {
                output_file = args[i];
            }
        } else if (!std.mem.startsWith(u8, args[i], "-")) {
            input_file = args[i];
        }
    }

    // 입력 파일이 없으면 테스트 코드 사용
    const source = if (input_file) |file| blk: {
        const file_handle = try std.fs.cwd().openFile(file, .{});
        defer file_handle.close();
        const file_size = try file_handle.getEndPos();
        const buffer = try allocator.alloc(u8, file_size);
        const bytes_read = try file_handle.readAll(buffer);
        if (bytes_read != file_size) {
            return error.IncompleteRead;
        }
        break :blk buffer;
    } else blk: {
        // 테스트 소스 코드
        const test_source =
            \\fn add(a: i32, b: i32) i32 {
            \\    return a + b;
            \\}
            \\
            \\fn main() i32 {
            \\    const x = add(1, 2);
            \\    const y = x + 3;
            \\    return y;
            \\}
        ;
        break :blk test_source;
    };
    defer if (input_file != null) allocator.free(source);

    std.debug.print("========== Mini Zig Compiler (Phase 2.7) ==========\n\n", .{});

    // Step 1: Tokenize
    std.debug.print("[Step 1] TOKENIZE\n", .{});
    std.debug.print("─────────────────────────\n", .{});

    var tokenizer = try Tokenizer.init(source, allocator);
    defer tokenizer.deinit();

    var tokens = std.ArrayList(Token).init(allocator);
    defer tokens.deinit();

    while (try tokenizer.nextToken()) |token| {
        try tokens.append(token);
    }

    std.debug.print("✅ Tokenized {} tokens\n\n", .{tokens.items.len});

    // Step 2: Parse
    std.debug.print("[Step 2] PARSE\n", .{});
    std.debug.print("─────────────────────────\n", .{});

    var parser = try Parser.init(tokens.items, source, allocator);
    defer parser.deinit();
    const ast = try parser.parseProgram();

    std.debug.print("✅ Parsed successfully\n\n", .{});

    // Step 3: AstGen (AST → ZIR)
    std.debug.print("[Step 3] ASTGEN (AST → ZIR)\n", .{});
    std.debug.print("─────────────────────────\n", .{});

    var astgen = try AstGen.init(allocator, source);
    defer astgen.deinit();
    try astgen.genProgram(&ast);

    std.debug.print("✅ Generated ZIR with {} instructions\n\n", .{astgen.zir.instructions.items.len});

    // Step 4: Sema (ZIR → AIR with Type Information)
    std.debug.print("[Step 4] SEMA (ZIR → AIR)\n", .{});
    std.debug.print("─────────────────────────\n", .{});

    var sema = try Sema.init(allocator, &astgen.zir);
    defer sema.deinit();
    try sema.analyzeProgram();

    if (sema.hasErrors()) {
        std.debug.print("\n⚠️  Semantic errors found:\n", .{});
        sema.printErrors();
        return;
    }

    std.debug.print("✅ Semantic analysis complete, {} AIR instructions\n\n", .{sema.air.instructions.items.len});

    // LLVM IR 경로 (--llvm 또는 --emit-llvm 플래그)
    if (use_llvm_backend or emit_llvm_only) {
        // Step 5b: LLVMIRGen (AIR → LLVM IR 텍스트)
        std.debug.print("[Step 5b] LLVM IRGEN (AIR → LLVM IR)\n", .{});
        std.debug.print("─────────────────────────────────────\n", .{});

        var llvm_gen = try LLVMIRGen.init(allocator, &sema.air);
        defer llvm_gen.deinit();

        const ir_text = try llvm_gen.generate();
        const ll_filename = try std.fmt.allocPrint(allocator, "{s}.ll", .{output_file});
        defer allocator.free(ll_filename);

        try Linker.writeIRToFile(ir_text, ll_filename);
        std.debug.print("✅ Generated LLVM IR: {} bytes written to {s}\n\n", .{ ir_text.len, ll_filename });

        // --emit-llvm 플래그가 있으면 여기서 종료
        if (emit_llvm_only) {
            std.debug.print("[Summary] LLVM IR generation complete\n", .{});
            std.debug.print("LLVM IR file: {s}\n", .{ll_filename});
            return;
        }

        // Step 6b: Linker (LLVM IR → Binary)
        std.debug.print("[Step 6b] LINKER (LLVM IR → Binary)\n", .{});
        std.debug.print("───────────────────────────────────\n", .{});

        var linker = try Linker.init(allocator);
        defer linker.deinit();

        const binary_filename = output_file;
        linker.compileFromLLVMIR(ll_filename, binary_filename) catch |err| {
            std.debug.print("❌ Compilation failed: {}\n", .{err});
            std.debug.print("💾 LLVM IR source retained: {s}\n", .{ll_filename});
            return;
        };

        std.debug.print("✅ Compiled to binary: {s}\n\n", .{binary_filename});

        // 정리 및 요약
        std.debug.print("========== Compilation Complete (LLVM IR Path) ==========\n", .{});
        std.debug.print("📊 Summary:\n", .{});
        std.debug.print("  Tokens:           {}\n", .{tokens.items.len});
        std.debug.print("  ZIR Inst:         {}\n", .{astgen.zir.instructions.items.len});
        std.debug.print("  AIR Inst:         {}\n", .{sema.air.instructions.items.len});
        std.debug.print("  LLVM IR Size:     {} bytes\n", .{ir_text.len});
        std.debug.print("  Output:           {s}\n", .{binary_filename});
        std.debug.print("  LLVM IR Source:   {s}\n", .{ll_filename});
        return;
    }

    // C 경로 (기본값)
    // Step 5: Codegen (AIR → C Code)
    std.debug.print("[Step 5] CODEGEN (AIR → C)\n", .{});
    std.debug.print("─────────────────────────\n", .{});

    var codegen = try Codegen.init(allocator, &sema.air);
    defer codegen.deinit();

    const c_code = try codegen.generate();
    const c_filename = try std.fmt.allocPrint(allocator, "{s}.c", .{output_file});
    defer allocator.free(c_filename);

    try codegen.generateToFile(c_filename);
    std.debug.print("✅ Generated C code: {} bytes written to {s}\n\n", .{ c_code.len, c_filename });

    // --emit-c 플래그가 있으면 여기서 종료
    if (emit_c_only) {
        std.debug.print("[Summary] C code generation complete\n", .{});
        std.debug.print("C file: {s}\n", .{c_filename});
        return;
    }

    // Step 6: Linker (C → Binary)
    std.debug.print("[Step 6] LINKER (C → Binary)\n", .{});
    std.debug.print("─────────────────────────\n", .{});

    var linker = try Linker.init(allocator);
    defer linker.deinit();

    const binary_filename = output_file;
    linker.compile(c_filename, binary_filename) catch |err| {
        std.debug.print("❌ Compilation failed: {}\n", .{err});
        // C 파일은 유지하고 에러만 출력
        std.debug.print("💾 C source retained: {s}\n", .{c_filename});
        return;
    };

    std.debug.print("✅ Compiled to binary: {s}\n\n", .{binary_filename});

    // 정리 및 요약
    std.debug.print("========== Compilation Complete ==========\n", .{});
    std.debug.print("📊 Summary:\n", .{});
    std.debug.print("  Tokens:       {}\n", .{tokens.items.len});
    std.debug.print("  ZIR Inst:     {}\n", .{astgen.zir.instructions.items.len});
    std.debug.print("  AIR Inst:     {}\n", .{sema.air.instructions.items.len});
    std.debug.print("  C Code Size:  {} bytes\n", .{c_code.len});
    std.debug.print("  Output:       {s}\n", .{binary_filename});
    std.debug.print("  C Source:     {s}\n", .{c_filename});
}
