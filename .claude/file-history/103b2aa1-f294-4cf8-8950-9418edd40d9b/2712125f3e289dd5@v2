// 🦎 Phase 8: AIR 최적화 패스
// src/optimizer.zig: 상수 폴딩, DCE, 강도 축소

const std = @import("std");
const Air = @import("air.zig").Air;
const AirType = @import("air.zig").Type;
const Ref = @import("air.zig").Ref;
const Instruction = @import("air.zig").Instruction;

/// AIR 최적화 엔진
pub const Optimizer = struct {
    allocator: std.mem.Allocator,
    air: *const Air,
    optimized_instructions: std.ArrayList(Instruction),
    ref_map: std.AutoHashMap(Ref, ?Ref), // 최적화된 참조 매핑
    used_refs: std.AutoHashMap(Ref, bool), // 사용된 ref 추적

    pub fn init(allocator: std.mem.Allocator, air: *const Air) Optimizer {
        return Optimizer{
            .allocator = allocator,
            .air = air,
            .optimized_instructions = std.ArrayList(Instruction).init(allocator),
            .ref_map = std.AutoHashMap(Ref, ?Ref).init(allocator),
            .used_refs = std.AutoHashMap(Ref, bool).init(allocator),
        };
    }

    pub fn deinit(self: *Optimizer) void {
        self.optimized_instructions.deinit();
        self.ref_map.deinit();
        self.used_refs.deinit();
    }

    /// 최적화 수행 및 새로운 Air 반환
    pub fn optimize(self: *Optimizer) !Air {
        // 1단계: 사용된 ref 마크 (역방향 분석)
        try self.markUsedRefs();

        // 2단계: 최적화된 명령어 생성
        try self.optimizeInstructions();

        // 3단계: 최적화된 Air 생성
        return Air{
            .instructions = self.optimized_instructions,
            .strings = self.air.strings,
            .source = self.air.source,
        };
    }

    /// 사용된 ref 역추적 (DCE 기초)
    fn markUsedRefs(self: *Optimizer) !void {
        // main 함수 마지막 반환값 추적
        if (self.air.instructions.items.len > 0) {
            const last_idx = self.air.instructions.items.len - 1;
            try self.markRefAsUsed(last_idx);
        }

        // 각 함수의 반환 명령어 추적
        for (self.air.instructions.items, 0..) |inst, idx| {
            if (inst == .ret) {
                try self.markRefAsUsed(idx);
            }
        }
    }

    /// ref와 그 의존성을 사용된 것으로 마크
    fn markRefAsUsed(self: *Optimizer, idx: usize) !void {
        if (idx >= self.air.instructions.items.len) return;

        const key: Ref = @intCast(idx);
        if (self.used_refs.contains(key)) return; // 이미 마크됨

        try self.used_refs.put(key, true);

        const inst = self.air.instructions.items[idx];
        // 의존 ref들도 마크
        try self.markDependencies(inst);
    }

    /// 명령어의 의존 ref들 마크
    fn markDependencies(self: *Optimizer, inst: Instruction) !void {
        switch (inst) {
            .binary_op => |op| {
                if (op.lhs < self.air.instructions.items.len) {
                    try self.markRefAsUsed(@intCast(op.lhs));
                }
                if (op.rhs < self.air.instructions.items.len) {
                    try self.markRefAsUsed(@intCast(op.rhs));
                }
            },
            .unary_op => |op| {
                if (op.operand < self.air.instructions.items.len) {
                    try self.markRefAsUsed(@intCast(op.operand));
                }
            },
            .call => |call| {
                for (call.args) |arg| {
                    if (arg < self.air.instructions.items.len) {
                        try self.markRefAsUsed(@intCast(arg));
                    }
                }
            },
            .load_var => |name_idx| {
                _ = name_idx;
            },
            .store_var => |sv| {
                if (sv.value < self.air.instructions.items.len) {
                    try self.markRefAsUsed(@intCast(sv.value));
                }
            },
            .@"if" => |if_inst| {
                if (if_inst.condition < self.air.instructions.items.len) {
                    try self.markRefAsUsed(@intCast(if_inst.condition));
                }
            },
            .ret => |ret_ref| {
                if (ret_ref < self.air.instructions.items.len) {
                    try self.markRefAsUsed(@intCast(ret_ref));
                }
            },
            else => {},
        }
    }

    /// 최적화된 명령어 생성
    fn optimizeInstructions(self: *Optimizer) !void {
        for (self.air.instructions.items, 0..) |inst, idx| {
            const key: Ref = @intCast(idx);

            // DCE: 사용되지 않는 store_var는 noop으로 교체
            if (inst == .store_var and !self.used_refs.contains(key)) {
                try self.optimized_instructions.append(.noop);
                try self.ref_map.put(key, null);
                continue;
            }

            // 상수 폴딩
            if (inst == .binary_op) {
                if (try self.foldBinaryOp(inst.binary_op)) |folded| {
                    try self.optimized_instructions.append(folded);
                    try self.ref_map.put(key, @intCast(self.optimized_instructions.items.len - 1));
                    continue;
                }
            }

            // 최적화되지 않은 명령어는 그대로 복사
            try self.optimized_instructions.append(inst);
            try self.ref_map.put(key, @intCast(self.optimized_instructions.items.len - 1));
        }
    }

    /// 상수 폴딩 수행
    fn foldBinaryOp(self: *Optimizer, op: struct {
        op: @import("air.zig").BinaryOp,
        lhs: Ref,
        rhs: Ref,
        ty: AirType,
    }) !?Instruction {
        // lhs가 load_int 인지 확인
        if (op.lhs >= self.air.instructions.items.len or op.rhs >= self.air.instructions.items.len) {
            return null;
        }

        const lhs_inst = self.air.instructions.items[op.lhs];
        const rhs_inst = self.air.instructions.items[op.rhs];

        if (lhs_inst != .load_int or rhs_inst != .load_int) {
            // 항등원 최적화 (X + 0 → X, X * 1 → X, 0 * X → 0)
            return try self.optimizeIdentity(op);
        }

        const lhs_val = lhs_inst.load_int.value;
        const rhs_val = rhs_inst.load_int.value;

        const result = switch (op.op) {
            .add => lhs_val +% rhs_val,
            .sub => lhs_val -% rhs_val,
            .mul => lhs_val *% rhs_val,
            .div => if (rhs_val != 0) lhs_val / rhs_val else return null,
            .mod => if (rhs_val != 0) lhs_val % rhs_val else return null,
            .eq => if (lhs_val == rhs_val) @as(i64, 1) else @as(i64, 0),
            .ne => if (lhs_val != rhs_val) @as(i64, 1) else @as(i64, 0),
            .lt => if (lhs_val < rhs_val) @as(i64, 1) else @as(i64, 0),
            .le => if (lhs_val <= rhs_val) @as(i64, 1) else @as(i64, 0),
            .gt => if (lhs_val > rhs_val) @as(i64, 1) else @as(i64, 0),
            .ge => if (lhs_val >= rhs_val) @as(i64, 1) else @as(i64, 0),
            else => return null,
        };

        return Instruction{ .load_int = .{ .value = result } };
    }

    /// 항등원 최적화
    fn optimizeIdentity(self: *Optimizer, op: struct {
        op: @import("air.zig").BinaryOp,
        lhs: Ref,
        rhs: Ref,
        ty: AirType,
    }) !?Instruction {
        _ = self;
        if (op.rhs >= self.air.instructions.items.len or op.lhs >= self.air.instructions.items.len) {
            return null;
        }

        const rhs_inst = self.air.instructions.items[op.rhs];

        // X + 0 → X
        if (op.op == .add and rhs_inst == .load_int and rhs_inst.load_int.value == 0) {
            return Instruction{ .noop = {} };
        }

        // X * 1 → X
        if (op.op == .mul and rhs_inst == .load_int and rhs_inst.load_int.value == 1) {
            return Instruction{ .noop = {} };
        }

        // X * 0 → 0
        if (op.op == .mul and rhs_inst == .load_int and rhs_inst.load_int.value == 0) {
            return Instruction{ .load_int = .{ .value = 0 } };
        }

        // X - X → 0
        if (op.op == .sub and op.lhs == op.rhs) {
            return Instruction{ .load_int = .{ .value = 0 } };
        }

        return null;
    }
};

// ========== 헬퍼 함수 ==========

/// 두 Air가 의미론상 동일한지 확인 (테스트용)
pub fn airEquivalent(a1: *const Air, a2: *const Air) bool {
    if (a1.instructions.items.len != a2.instructions.items.len) {
        return false;
    }

    for (a1.instructions.items, a2.instructions.items) |inst1, inst2| {
        if (!instructionEquivalent(inst1, inst2)) {
            return false;
        }
    }

    return true;
}

fn instructionEquivalent(i1: Instruction, i2: Instruction) bool {
    return std.mem.eql(u8, &std.mem.asBytes(&i1), &std.mem.asBytes(&i2));
}
