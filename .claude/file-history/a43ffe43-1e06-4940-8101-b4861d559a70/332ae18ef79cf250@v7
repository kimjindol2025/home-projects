// freelang-compiler-tiny.fl - Stage 6: struct instantiation & field access
// v1이 struct를 생성하고 필드에 접근

struct Point {
  x: i32;
  y: i32;
}

fn getX(p) {
  return p.x;
}

fn getY(p) {
  return p.y;
}

fn main() {
  println("FreeLang Stage 6: struct Instantiation & Field Access");
  println("====================================================");

  // struct 생성
  let p = Point { x: 10, y: 20 };

  // 필드 접근
  println("1. direct field access:");
  println(p.x);
  println(p.y);

  println("");
  println("2. field access via function:");
  println(getX(p));
  println(getY(p));

  println("");
  println("Stage 6 objective:");
  println("✓ struct 생성 (struct literal syntax)");
  println("✓ 필드 접근 (member access)");
  println("✓ 함수 호출과 struct 전달");
  println("→ 다음 단계: v1 self-hosting with struct support");

  return 0;
}

main()
