#!/usr/bin/env node

/**
 * FreeLang Self-Hosting Bootstrap HTTP Server
 *
 * Provides REST API for:
 * - Stage verification
 * - Bootstrap proof inspection
 * - Live compilation & verification
 * - Source code viewing
 */

const express = require('express');
const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');
const cors = require('cors');

const app = express();
const PORT = process.env.PORT || 3000;

// Middleware
app.use(cors());
app.use(express.json());
app.use(express.static('public'));

// ===== UTILITIES =====
function getProofFile(stage) {
  const proofPath = path.join(__dirname, `STAGE${stage}_PROOF.json`);
  if (!fs.existsSync(proofPath)) {
    return null;
  }
  return JSON.parse(fs.readFileSync(proofPath, 'utf8'));
}

function getSourceFile() {
  return fs.readFileSync(path.join(__dirname, 'freelang-compiler-tiny.fl'), 'utf8');
}

function runTest(stage) {
  try {
    const testScript = path.join(__dirname, `test-stage${stage}.sh`);
    if (!fs.existsSync(testScript)) {
      return { error: `test-stage${stage}.sh not found` };
    }

    const result = execSync(`bash ${testScript} 2>&1`, {
      timeout: 30000,
      encoding: 'utf8'
    });

    return {
      success: true,
      output: result,
      timestamp: new Date().toISOString()
    };
  } catch (e) {
    return {
      error: e.message,
      output: e.stdout || '',
      timestamp: new Date().toISOString()
    };
  }
}

// ===== API ENDPOINTS =====

/**
 * GET /api/health
 * Server health check
 */
app.get('/api/health', (req, res) => {
  res.json({
    status: 'healthy',
    service: 'FreeLang Self-Hosting Bootstrap Server',
    timestamp: new Date().toISOString()
  });
});

/**
 * GET /api/stages
 * Get list of all completed stages
 */
app.get('/api/stages', (req, res) => {
  const stages = [];
  for (let i = 1; i <= 8; i++) {
    const proof = getProofFile(i);
    stages.push({
      stage: i,
      exists: proof !== null,
      status: proof ? 'completed' : 'missing'
    });
  }
  res.json({ stages, count: stages.filter(s => s.exists).length });
});

/**
 * GET /api/stage/:num
 * Get proof for specific stage
 */
app.get('/api/stage/:num', (req, res) => {
  const stage = parseInt(req.params.num);
  if (stage < 1 || stage > 8) {
    return res.status(400).json({ error: 'Invalid stage number (1-8)' });
  }

  const proof = getProofFile(stage);
  if (!proof) {
    return res.status(404).json({ error: `STAGE${stage}_PROOF.json not found` });
  }

  res.json(proof);
});

/**
 * GET /api/stage/:num/run
 * Run test for specific stage
 */
app.get('/api/stage/:num/run', (req, res) => {
  const stage = parseInt(req.params.num);
  if (stage < 1 || stage > 8) {
    return res.status(400).json({ error: 'Invalid stage number (1-8)' });
  }

  const result = runTest(stage);
  res.json(result);
});

/**
 * GET /api/bootstrap
 * Get complete bootstrap verification (Stage 8)
 */
app.get('/api/bootstrap', (req, res) => {
  const proof = getProofFile(8);
  if (!proof) {
    return res.status(404).json({ error: 'Bootstrap proof not found' });
  }

  const isVerified =
    proof.verification.v1_equals_v2 &&
    proof.verification.v2_equals_v3 &&
    proof.verification.all_equal;

  res.json({
    stage: 8,
    verified: isVerified,
    chain: {
      v1: proof.bootstrap_chain.v1,
      v2: proof.bootstrap_chain.v2,
      v3: proof.bootstrap_chain.v3
    },
    result: isVerified ? 'BOOTSTRAP COMPLETE' : 'VERIFICATION FAILED',
    timestamp: proof.timestamp
  });
});

/**
 * GET /api/source
 * Get FreeLang source code
 */
app.get('/api/source', (req, res) => {
  const source = getSourceFile();
  res.json({
    filename: 'freelang-compiler-tiny.fl',
    size: source.length,
    lines: source.split('\n').length,
    content: source,
    timestamp: new Date().toISOString()
  });
});

/**
 * POST /api/compile
 * Compile FreeLang source code
 */
app.post('/api/compile', (req, res) => {
  const { source } = req.body;

  if (!source || typeof source !== 'string') {
    return res.status(400).json({ error: 'source code required' });
  }

  try {
    // Write temporary file
    const tmpFile = `/tmp/compile_${Date.now()}.fl`;
    fs.writeFileSync(tmpFile, source);

    // Compile
    const result = execSync(
      `node ${path.join(__dirname, 'full-e2e-compiler.js')} ${tmpFile}`,
      { encoding: 'utf8', timeout: 10000 }
    );

    // Read result
    const elfPath = path.join(__dirname, 'a.elf');
    let elfContent = null;
    let elfSize = 0;
    if (fs.existsSync(elfPath)) {
      const elfBuffer = fs.readFileSync(elfPath);
      elfContent = elfBuffer.toString('hex');
      elfSize = elfBuffer.length;
    }

    // Cleanup
    fs.unlinkSync(tmpFile);
    if (fs.existsSync(elfPath)) {
      fs.unlinkSync(elfPath);
    }

    res.json({
      success: true,
      source: {
        size: source.length,
        lines: source.split('\n').length
      },
      output: {
        elf: {
          hex: elfContent,
          size: elfSize
        }
      },
      compiler_output: result,
      timestamp: new Date().toISOString()
    });
  } catch (e) {
    res.status(500).json({
      error: e.message,
      compiler_output: e.stdout || ''
    });
  }
});

/**
 * GET /api/summary
 * Get complete project summary
