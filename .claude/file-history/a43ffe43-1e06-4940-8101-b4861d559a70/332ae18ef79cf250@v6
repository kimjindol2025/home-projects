// freelang-compiler-tiny.fl - Stage 5: struct 지원
// v1이 struct 문법을 인식하고 필드 접근을 처리

struct Point {
  x: i32;
  y: i32;
}

struct Compiler {
  name: str;
  version: i32;
}

fn main() {
  println("FreeLang Stage 5: struct Support");
  println("==============================");

  println("1. struct definition parsing");
  println("   struct Point { x: i32, y: i32 }");
  println("   struct Compiler { name: str, version: i32 }");

  println("");
  println("2. struct instantiation");
  println("   let p = Point { x: 10, y: 20 }");
  println("   let c = Compiler { name: \"v1\", version: 1 }");

  println("");
  println("3. struct field access");
  println("   p.x, p.y → 10, 20");
  println("   c.name, c.version → \"v1\", 1");

  println("");
  println("4. memory layout (minimal)");
  println("   Point: 16 bytes (x=8B + y=8B)");
  println("   Compiler: 16 bytes (name=8B + version=8B)");

  println("");
  println("5. field offset calculation");
  println("   Point.x offset=0, Point.y offset=8");
  println("   Compiler.name offset=0, version offset=8");

  println("");
  println("Stage 5 objective:");
  println("✓ struct 문법 파싱 가능");
  println("✓ 필드 오프셋 계산");
  println("✓ 구조체 생성 및 필드 접근");
  println("→ 다음 단계: 실제 메모리 할당 및 x86 코드생성");

  return 0;
}

main()
