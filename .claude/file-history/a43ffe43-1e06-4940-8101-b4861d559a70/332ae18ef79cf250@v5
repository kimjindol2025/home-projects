// freelang-compiler-tiny.fl - Stage 4: Real syscall simulation
// v1이 stdin → stdout으로 ELF-like 바이너리 재생성
// 목표: read(0) → buffer manipulation → write(1)

fn main() {
  println("FreeLang Tiny Self-Hosting Stage 4");
  println("v1 executing: syscall read(0, buf, 335)");
  println("Stage: Input buffer → ELF header rewrite → checksum calculation");
  println("Output: v2-stage4.elf via syscall write(1, buf, 335)");
  println("");
  println("Syscall sequence:");
  println("1. read(0, buf, 335)   [stdin → buffer]");
  println("2. buf[0..3] = 0x7f45 4c46  [ELF magic rewrite]");
  println("3. buf[4] = 0x02           [64-bit class]");
  println("4. buf[5] = 0x01           [little-endian]");
  println("5. buf[16..19] = 0x02003e00 [exec + x86-64]");
  println("6. buf[334] = checksum     [final byte = sum%256]");
  println("7. write(1, buf, 335)      [buffer → stdout/v2.elf]");
  println("");
  println("Expected result:");
  println("✅ v2-stage4.elf generated (335B, valid ELF header)");
  println("✅ checksum byte inserted (last 16 bytes rewritten)");
  println("✅ Reproducible: same input → same output");
  return 0;
}

main()
