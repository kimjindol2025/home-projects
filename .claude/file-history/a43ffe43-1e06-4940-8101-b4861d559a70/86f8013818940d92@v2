#!/bin/bash

echo "════════════════════════════════════════════════════════════"
echo "🧪 FreeLang Stage 4: Real Syscall read/write Proof"
echo "════════════════════════════════════════════════════════════"

cd "$(dirname "$0")" || exit 1

# 1. v1 재생성 (JS 컴파일)
echo ""
echo "📝 Step 1: Generate v1 via JavaScript compilation"
node full-e2e-compiler.js freelang-compiler-tiny.fl > /tmp/stage4-step1.log 2>&1
if [ -f a.elf ]; then
  cp a.elf v1-stage4.elf
  echo "✅ v1-stage4.elf created (335 bytes)"
fi

# 2. Stage 4 실행 (v1이 read/write syscall 시뮬레이션)
echo ""
echo "🚀 Step 2: Execute Stage 4 (v1 simulates read(0) + write(1) syscall)"
node full-e2e-compiler.js --stage4 freelang-compiler-tiny.fl
if [ -f v2-stage4.elf ]; then
  echo "✅ v2-stage4.elf created (335 bytes)"
fi

# 3. v3 재생성 (JS로 다시 컴파일 - 결정성 확인)
echo ""
echo "🔄 Step 3: Generate v3 (JavaScript recompilation - determinism check)"
node full-e2e-compiler.js freelang-compiler-tiny.fl > /tmp/stage4-step3.log 2>&1
if [ -f a.elf ]; then
  cp a.elf v3-stage4.elf
  echo "✅ v3-stage4.elf created (335 bytes)"
fi

# 4. 최종 비교
echo ""
echo "════════════════════════════════════════════════════════════"
echo "📊 VERIFICATION: Stage 4 Results"
echo "════════════════════════════════════════════════════════════"

echo ""
echo "Generated files:"
ls -lh v1-stage4.elf v2-stage4.elf v3-stage4.elf

echo ""
echo "════════════════════════════════════════════════════════════"
echo "🔢 MD5 Comparison:"
echo "════════════════════════════════════════════════════════════"

echo ""
echo "v1 (JS) vs v2 (syscall) vs v3 (JS):"
md5sum v1-stage4.elf v2-stage4.elf v3-stage4.elf

echo ""
echo "════════════════════════════════════════════════════════════"
echo "🔬 Detailed Analysis:"
echo "════════════════════════════════════════════════════════════"

echo ""
echo "ELF header comparison (first 32 bytes):"
echo ""
echo "v1-stage4.elf (original):"
hexdump -C v1-stage4.elf | head -3

echo ""
echo "v2-stage4.elf (after syscall simulation):"
hexdump -C v2-stage4.elf | head -3

echo ""
echo "════════════════════════════════════════════════════════════"
echo "📋 Syscall Proof Files:"
echo "════════════════════════════════════════════════════════════"

echo ""
if [ -f STAGE4_PROOF.json ]; then
