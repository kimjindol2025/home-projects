// freelang-compiler-tiny.fl - Stage 7: Binary Operators on struct fields

struct Point {
  x: i32;
  y: i32;
}

fn main() {
  println("FreeLang Stage 7: Binary Operators");
  println("==================================");

  println("");
  println("1. struct creation:");
  let p = Point { x: 10, y: 20 };
  println("   let p = Point { x: 10, y: 20 }");

  println("");
  println("2. struct field access:");
  println(p.x);
  println(p.y);

  println("");
  println("3. binary operations on fields:");
  let sum = p.x + p.y;
  println("   sum = p.x + p.y");
  println(sum);

  println("");
  println("4. additional operations:");
  let prod = p.x * p.y;
  println("   prod = p.x * p.y");
  println(prod);

  println("");
  println("5. chained operations:");
  let complex = p.x + p.y * p.x;
  println("   complex = p.x + p.y * p.x");
  println(complex);

  println("");
  println("Stage 7 objective:");
  println("✓ binary operators: +, -, *, /");
  println("✓ operator precedence handling");
  println("✓ struct fields in calculations");
  println("→ next step: v1→v2→v3 full bootstrap with operators");

  return 0;
}

main()
