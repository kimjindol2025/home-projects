// ============ LEXER ============

fn is_alpha(ch) {
  if (ch >= "a" && ch <= "z") { return 1; }
  if (ch >= "A" && ch <= "Z") { return 1; }
  if (ch == "_") { return 1; }
  return 0;
}

fn is_digit(ch) {
  return ch >= "0" && ch <= "9";
}

fn is_alphanum(ch) {
  return is_alpha(ch) || is_digit(ch);
}

fn is_whitespace(ch) {
  return ch == " " || ch == "\n" || ch == "\t" || ch == "\r";
}

