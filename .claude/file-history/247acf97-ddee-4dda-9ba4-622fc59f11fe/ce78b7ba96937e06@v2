use std::collections::{HashMap, HashSet};

// ========== Module Visibility ==========

#[derive(Clone, Debug, PartialEq)]
pub enum Visibility {
    Public,     // 공개
    Private,    // 비공개
    Internal,   // 내부용
}

// ========== Export Declaration ==========

#[derive(Clone, Debug)]
pub struct ExportItem {
    pub item_id: u32,
    pub name: String,
    pub item_type: String,  // function, struct, enum, const, etc.
    pub visibility: Visibility,
}

impl ExportItem {
    pub fn new(item_id: u32, name: String, item_type: String) -> Self {
        Self {
            item_id,
            name,
            item_type,
            visibility: Visibility::Public,
        }
    }

    pub fn set_visibility(&mut self, visibility: Visibility) {
        self.visibility = visibility;
    }

    pub fn is_public(&self) -> bool {
        self.visibility == Visibility::Public
    }
}

pub struct ExportList {
    exports: Vec<ExportItem>,
    export_map: HashMap<String, u32>,
}

impl ExportList {
    pub fn new() -> Self {
        Self {
            exports: Vec::new(),
            export_map: HashMap::new(),
        }
    }

    pub fn add_export(&mut self, export: ExportItem) -> bool {
        if self.export_map.contains_key(&export.name) {
            return false;  // 중복 체크
        }
        let item_id = export.item_id;
        self.export_map.insert(export.name.clone(), item_id);
        self.exports.push(export);
        true
    }

    pub fn get_export(&self, name: &str) -> Option<&ExportItem> {
        if let Some(item_id) = self.export_map.get(name) {
            self.exports.iter().find(|e| e.item_id == *item_id)
        } else {
            None
        }
    }

    pub fn export_count(&self) -> usize {
        self.exports.len()
    }

    pub fn list_exports(&self) -> Vec<&ExportItem> {
        self.exports.iter().collect()
    }

    pub fn public_exports(&self) -> Vec<&ExportItem> {
        self.exports
            .iter()
            .filter(|e| e.is_public())
            .collect()
    }
}

// ========== Import Declaration ==========

#[derive(Clone, Debug)]
pub struct ImportItem {
    pub import_id: u32,
    pub local_name: String,
    pub remote_name: String,
    pub module_name: String,
    pub is_aliased: bool,
}

impl ImportItem {
    pub fn new(import_id: u32, module_name: String, remote_name: String) -> Self {
        Self {
            import_id,
            local_name: remote_name.clone(),
            remote_name,
            module_name,
            is_aliased: false,
        }
    }

    pub fn with_alias(mut self, alias: String) -> Self {
        self.local_name = alias;
        self.is_aliased = true;
        self
    }
}

pub struct ImportList {
    imports: Vec<ImportItem>,
    import_map: HashMap<String, u32>,  // local_name -> import_id
}

impl ImportList {
    pub fn new() -> Self {
        Self {
            imports: Vec::new(),
            import_map: HashMap::new(),
        }
    }

    pub fn add_import(&mut self, import: ImportItem) -> bool {
        if self.import_map.contains_key(&import.local_name) {
            return false;  // 중복 체크
        }
        let import_id = import.import_id;
        self.import_map.insert(import.local_name.clone(), import_id);
        self.imports.push(import);
        true
    }

    pub fn resolve_import(&self, local_name: &str) -> Option<&ImportItem> {
        if let Some(import_id) = self.import_map.get(local_name) {
            self.imports.iter().find(|i| i.import_id == *import_id)
        } else {
            None
        }
    }

    pub fn import_count(&self) -> usize {
        self.imports.len()
    }

    pub fn list_imports(&self) -> Vec<&ImportItem> {
        self.imports.iter().collect()
    }

    pub fn imports_from_module(&self, module_name: &str) -> Vec<&ImportItem> {
        self.imports
            .iter()
            .filter(|i| i.module_name == module_name)
            .collect()
    }
}

// ========== Module Metadata ==========

#[derive(Clone, Debug)]
pub struct ModuleMetadata {
    pub module_id: u32,
    pub name: String,
    pub version: String,
    pub author: String,
    pub description: String,
}

impl ModuleMetadata {
    pub fn new(module_id: u32, name: String, version: String) -> Self {
        Self {
            module_id,
            name,
            version,
            author: String::new(),
            description: String::new(),
        }
    }

    pub fn set_author(&mut self, author: String) {
        self.author = author;
    }

    pub fn set_description(&mut self, description: String) {
        self.description = description;
    }

    pub fn signature(&self) -> String {
        format!("{}@{}", self.name, self.version)
    }
}

// ========== Module Definition ==========

pub struct Module {
    pub module_id: u32,
    pub metadata: ModuleMetadata,
    pub exports: ExportList,
    pub imports: ImportList,
    pub created_at: u64,
    pub modified_at: u64,
}

impl Module {
    pub fn new(module_id: u32, name: String, version: String) -> Self {
        Self {
            module_id,
            metadata: ModuleMetadata::new(module_id, name, version),
            exports: ExportList::new(),
            imports: ImportList::new(),
            created_at: 0,
            modified_at: 0,
        }
    }

    pub fn add_export(&mut self, export: ExportItem) -> bool {
        self.exports.add_export(export)
    }

    pub fn add_import(&mut self, import: ImportItem) -> bool {
        self.imports.add_import(import)
    }

    pub fn get_export(&self, name: &str) -> Option<&ExportItem> {
        self.exports.get_export(name)
    }

    pub fn resolve_import(&self, name: &str) -> Option<&ImportItem> {
        self.imports.resolve_import(name)
    }

    pub fn total_exports(&self) -> usize {
        self.exports.export_count()
    }

    pub fn total_imports(&self) -> usize {
        self.imports.import_count()
    }

    pub fn get_public_api(&self) -> Vec<&ExportItem> {
        self.exports.public_exports()
    }

    pub fn get_dependencies(&self) -> HashSet<String> {
        self.imports
            .list_imports()
            .iter()
            .map(|i| i.module_name.clone())
            .collect()
    }
}

// ========== Module Pool ==========

pub struct ModulePool {
    modules: HashMap<u32, Module>,
    module_map: HashMap<String, u32>,  // module_name -> module_id
    next_module_id: u32,
    next_export_id: u32,
    next_import_id: u32,
}

impl ModulePool {
    pub fn new() -> Self {
        Self {
            modules: HashMap::new(),
            module_map: HashMap::new(),
            next_module_id: 0,
            next_export_id: 0,
            next_import_id: 0,
        }
    }

    pub fn create_module(&mut self, name: String, version: String) -> u32 {
        if self.module_map.contains_key(&name) {
            return u32::MAX;  // 중복 모듈
        }

        let module_id = self.next_module_id;
        self.next_module_id += 1;

        let module = Module::new(module_id, name.clone(), version);
        self.module_map.insert(name, module_id);
        self.modules.insert(module_id, module);

        module_id
    }

    pub fn get_module(&self, module_id: u32) -> Option<&Module> {
        self.modules.get(&module_id)
    }

    pub fn get_module_mut(&mut self, module_id: u32) -> Option<&mut Module> {
        self.modules.get_mut(&module_id)
    }

    pub fn find_module(&self, name: &str) -> Option<u32> {
        self.module_map.get(name).copied()
    }

    pub fn add_export_to_module(&mut self, module_id: u32, name: String, item_type: String) -> bool {
        if let Some(module) = self.modules.get_mut(&module_id) {
            let export = ExportItem::new(self.next_export_id, name, item_type);
            self.next_export_id += 1;
            module.add_export(export)
        } else {
            false
        }
    }

    pub fn add_import_to_module(
        &mut self,
        module_id: u32,
        source_module: String,
        item_name: String,
    ) -> bool {
        if let Some(module) = self.modules.get_mut(&module_id) {
            let import = ImportItem::new(self.next_import_id, source_module, item_name);
            self.next_import_id += 1;
            module.add_import(import)
        } else {
            false
        }
    }

    pub fn module_count(&self) -> usize {
        self.modules.len()
    }

    pub fn list_modules(&self) -> Vec<&Module> {
        self.modules.values().collect()
    }
}

// ========== Tests (A1-A6) ==========

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_a1_export_item_creation() {
        let export = ExportItem::new(0, "foo".to_string(), "function".to_string());

        assert_eq!(export.name, "foo");
        assert_eq!(export.item_type, "function");
        assert!(export.is_public());
    }

    #[test]
    fn test_a2_export_list_management() {
        let mut exports = ExportList::new();

        let exp1 = ExportItem::new(0, "func1".to_string(), "function".to_string());
        let exp2 = ExportItem::new(1, "struct1".to_string(), "struct".to_string());

        assert!(exports.add_export(exp1));
        assert!(exports.add_export(exp2));
        assert_eq!(exports.export_count(), 2);
    }

    #[test]
    fn test_a3_import_item_creation() {
        let import = ImportItem::new(0, "math".to_string(), "sqrt".to_string());

        assert_eq!(import.module_name, "math");
        assert_eq!(import.remote_name, "sqrt");
        assert!(!import.is_aliased);
    }

    #[test]
    fn test_a4_import_list_resolution() {
        let mut imports = ImportList::new();

        let imp = ImportItem::new(0, "math".to_string(), "sqrt".to_string());
        assert!(imports.add_import(imp));

        let resolved = imports.resolve_import("sqrt");
        assert!(resolved.is_some());
    }

    #[test]
    fn test_a5_module_creation() {
        let module = Module::new(0, "mymodule".to_string(), "1.0.0".to_string());

        assert_eq!(module.metadata.name, "mymodule");
        assert_eq!(module.total_exports(), 0);
    }

    #[test]
    fn test_a6_module_pool() {
        let mut pool = ModulePool::new();

        let mod1 = pool.create_module("mod1".to_string(), "1.0.0".to_string());
        let mod2 = pool.create_module("mod2".to_string(), "1.0.0".to_string());

        assert_eq!(pool.module_count(), 2);
        assert_eq!(pool.find_module("mod1"), Some(mod1));
    }
}

