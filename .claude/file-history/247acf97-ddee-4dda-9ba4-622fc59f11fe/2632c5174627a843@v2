pub use namespace_manager::{Namespace, NamespaceHierarchy, ScopeManager, ScopeLevel};
pub use dependency_resolver::{DependencyResolver, DependencyGraph, CircularDependencyDetector};

// ========== Module System Integration ==========

pub struct ModuleSystem {
    module_pool: ModulePool,
    scope_manager: ScopeManager,
    dependency_resolver: DependencyResolver,
    loaded_modules: std::collections::HashSet<u32>,
    total_operations: u64,
}

impl ModuleSystem {
    pub fn new() -> Self {
        Self {
            module_pool: ModulePool::new(),
            scope_manager: ScopeManager::new(),
            dependency_resolver: DependencyResolver::new(),
            loaded_modules: std::collections::HashSet::new(),
            total_operations: 0,
        }
    }

    pub fn register_module(&mut self, name: String, version: String) -> u32 {
        let module_id = self.module_pool.create_module(name.clone(), version.clone());

        if module_id != u32::MAX {
            self.dependency_resolver.add_module(module_id, name, version);
            self.total_operations += 1;
        }

        module_id
    }

    pub fn add_export(&mut self, module_id: u32, name: String, item_type: String) -> bool {
        if self.module_pool.add_export_to_module(module_id, name, item_type) {
            self.total_operations += 1;
            true
        } else {
            false
        }
    }

    pub fn add_import(
        &mut self,
        module_id: u32,
        source_module: String,
        item_name: String,
    ) -> bool {
        if self.module_pool.add_import_to_module(module_id, source_module, item_name) {
            self.total_operations += 1;
            true
        } else {
            false
        }
    }

    pub fn create_module_namespace(&mut self, module_name: String) -> u32 {
        self.scope_manager.create_module_namespace(module_name)
    }

    pub fn add_module_dependency(&mut self, from_module: u32, to_module: u32) -> bool {
        if self.dependency_resolver.add_dependency(from_module, to_module) {
            self.total_operations += 1;
            true
        } else {
            false
        }
    }

    pub fn resolve_dependencies(&mut self) -> bool {
        if self.dependency_resolver.resolve() {
            self.total_operations += 1;
            true
        } else {
            false
        }
    }

    pub fn load_modules(&mut self) -> bool {
        if !self.resolve_dependencies() {
            return false;
        }

        let load_order = self.dependency_resolver.get_load_order();
        for module_id in load_order {
            self.loaded_modules.insert(module_id);
        }

        self.total_operations += 1;
        true
    }

    pub fn is_module_loaded(&self, module_id: u32) -> bool {
        self.loaded_modules.contains(&module_id)
    }

    pub fn has_circular_dependency(&self) -> bool {
        self.dependency_resolver.has_circular_dependency()
    }

    pub fn get_module_info(&self, module_id: u32) -> Option<ModuleInfo> {
        if let Some(module) = self.module_pool.get_module(module_id) {
            Some(ModuleInfo {
                module_id,
                name: module.metadata.name.clone(),
                version: module.metadata.version.clone(),
                total_exports: module.total_exports(),
                total_imports: module.total_imports(),
                dependency_count: self.dependency_resolver.get_dependency_count(module_id),
                is_loaded: self.is_module_loaded(module_id),
            })
        } else {
            None
        }
    }

    pub fn get_system_stats(&self) -> ModuleSystemStats {
        ModuleSystemStats {
            total_modules: self.module_pool.module_count() as u32,
            loaded_modules: self.loaded_modules.len() as u32,
            total_exports: self
                .module_pool
                .list_modules()
                .iter()
                .map(|m| m.total_exports())
                .sum::<usize>() as u32,
            total_imports: self
                .module_pool
                .list_modules()
                .iter()
                .map(|m| m.total_imports())
                .sum::<usize>() as u32,
            total_namespaces: 1,  // Root namespace
            has_circular_dependency: self.has_circular_dependency(),
            total_operations: self.total_operations,
        }
    }

    pub fn reset(&mut self) {
        self.module_pool = ModulePool::new();
        self.scope_manager = ScopeManager::new();
        self.dependency_resolver = DependencyResolver::new();
        self.loaded_modules.clear();
        self.total_operations = 0;
    }
}

pub struct ModuleInfo {
    pub module_id: u32,
    pub name: String,
    pub version: String,
    pub total_exports: usize,
    pub total_imports: usize,
    pub dependency_count: usize,
    pub is_loaded: bool,
}

pub struct ModuleSystemStats {
    pub total_modules: u32,
    pub loaded_modules: u32,
    pub total_exports: u32,
    pub total_imports: u32,
    pub total_namespaces: u32,
    pub has_circular_dependency: bool,
    pub total_operations: u64,
}

// ========== Tests (E1-E6) ==========

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_e1_system_initialization() {
        let system = ModuleSystem::new();
        let stats = system.get_system_stats();

        assert_eq!(stats.total_modules, 0);
        assert_eq!(stats.loaded_modules, 0);
    }

    #[test]
    fn test_e2_module_registration() {
        let mut system = ModuleSystem::new();

        let mod1 = system.register_module("app".to_string(), "1.0.0".to_string());
        let mod2 = system.register_module("lib".to_string(), "1.0.0".to_string());

        let stats = system.get_system_stats();
        assert_eq!(stats.total_modules, 2);
    }

    #[test]
    fn test_e3_export_and_import() {
        let mut system = ModuleSystem::new();

        let mod1 = system.register_module("app".to_string(), "1.0.0".to_string());
        let mod2 = system.register_module("lib".to_string(), "1.0.0".to_string());

        assert!(system.add_export(mod2, "helper".to_string(), "function".to_string()));
        assert!(system.add_import(mod1, "lib".to_string(), "helper".to_string()));

        let stats = system.get_system_stats();
        assert!(stats.total_exports > 0);
        assert!(stats.total_imports > 0);
    }

    #[test]
    fn test_e4_dependency_resolution() {
        let mut system = ModuleSystem::new();

        let mod1 = system.register_module("main".to_string(), "1.0.0".to_string());
        let mod2 = system.register_module("utils".to_string(), "1.0.0".to_string());

        assert!(system.add_module_dependency(mod1, mod2));
        assert!(system.resolve_dependencies());
        assert!(!system.has_circular_dependency());
    }

    #[test]
    fn test_e5_circular_dependency_detection() {
        let mut system = ModuleSystem::new();

        let mod1 = system.register_module("x".to_string(), "1.0.0".to_string());
        let mod2 = system.register_module("y".to_string(), "1.0.0".to_string());

        system.add_module_dependency(mod1, mod2);
        system.add_module_dependency(mod2, mod1);

        assert!(!system.resolve_dependencies());
        assert!(system.has_circular_dependency());
    }

    #[test]
    fn test_e6_module_loading() {
        let mut system = ModuleSystem::new();

        let mod1 = system.register_module("base".to_string(), "1.0.0".to_string());
        let mod2 = system.register_module("app".to_string(), "1.0.0".to_string());

        system.add_module_dependency(mod2, mod1);

        assert!(system.load_modules());
        assert!(system.is_module_loaded(mod1));
        assert!(system.is_module_loaded(mod2));

        let stats = system.get_system_stats();
        assert_eq!(stats.loaded_modules, 2);
    }
}

