use std::collections::{HashMap, HashSet, VecDeque};

pub use super::module_definition::{Module, ModulePool};

// ========== Dependency Node ==========

#[derive(Clone, Debug)]
pub struct DependencyNode {
    pub node_id: u32,
    pub module_id: u32,
    pub module_name: String,
    pub version: String,
    pub dependencies: Vec<u32>,  // module_ids
    pub dependents: Vec<u32>,    // modules that depend on this
}

impl DependencyNode {
    pub fn new(node_id: u32, module_id: u32, module_name: String, version: String) -> Self {
        Self {
            node_id,
            module_id,
            module_name,
            version,
            dependencies: Vec::new(),
            dependents: Vec::new(),
        }
    }

    pub fn add_dependency(&mut self, module_id: u32) -> bool {
        if !self.dependencies.contains(&module_id) {
            self.dependencies.push(module_id);
            return true;
        }
        false
    }

    pub fn add_dependent(&mut self, module_id: u32) -> bool {
        if !self.dependents.contains(&module_id) {
            self.dependents.push(module_id);
            return true;
        }
        false
    }

    pub fn dependency_count(&self) -> usize {
        self.dependencies.len()
    }

    pub fn dependent_count(&self) -> usize {
        self.dependents.len()
    }
}

// ========== Dependency Graph ==========

pub struct DependencyGraph {
    nodes: HashMap<u32, DependencyNode>,
    module_to_node: HashMap<u32, u32>,  // module_id -> node_id
    next_node_id: u32,
}

impl DependencyGraph {
    pub fn new() -> Self {
        Self {
            nodes: HashMap::new(),
            module_to_node: HashMap::new(),
            next_node_id: 0,
        }
    }

    pub fn add_module(&mut self, module_id: u32, module_name: String, version: String) -> u32 {
        let node_id = self.next_node_id;
        self.next_node_id += 1;

        let node = DependencyNode::new(node_id, module_id, module_name, version);
        self.nodes.insert(node_id, node);
        self.module_to_node.insert(module_id, node_id);

        node_id
    }

    pub fn add_dependency(&mut self, from_module: u32, to_module: u32) -> bool {
        let from_node_id = self.module_to_node.get(&from_module).copied();
        let to_node_id = self.module_to_node.get(&to_module).copied();

        if let (Some(from_id), Some(to_id)) = (from_node_id, to_node_id) {
            if let Some(from_node) = self.nodes.get_mut(&from_id) {
                from_node.add_dependency(to_module);
            }
            if let Some(to_node) = self.nodes.get_mut(&to_id) {
                to_node.add_dependent(from_module);
            }
            return true;
        }
        false
    }

    pub fn get_node(&self, node_id: u32) -> Option<&DependencyNode> {
        self.nodes.get(&node_id)
    }

    pub fn find_node_by_module(&self, module_id: u32) -> Option<&DependencyNode> {
        if let Some(node_id) = self.module_to_node.get(&module_id) {
            self.nodes.get(node_id)
        } else {
            None
        }
    }

    pub fn node_count(&self) -> usize {
        self.nodes.len()
    }

    pub fn list_nodes(&self) -> Vec<&DependencyNode> {
        self.nodes.values().collect()
    }
}

// ========== Circular Dependency Detector ==========

pub struct CircularDependencyDetector;

impl CircularDependencyDetector {
    pub fn has_cycle(graph: &DependencyGraph) -> bool {
        let mut visited: HashSet<u32> = HashSet::new();
        let mut rec_stack: HashSet<u32> = HashSet::new();

        for node in graph.list_nodes() {
            if !visited.contains(&node.node_id) {
                if Self::dfs(graph, node.node_id, &mut visited, &mut rec_stack) {
                    return true;
                }
            }
        }
        false
    }

    fn dfs(
        graph: &DependencyGraph,
        node_id: u32,
        visited: &mut HashSet<u32>,
        rec_stack: &mut HashSet<u32>,
    ) -> bool {
        visited.insert(node_id);
        rec_stack.insert(node_id);

        if let Some(node) = graph.get_node(node_id) {
            for dep_module in &node.dependencies {
                if let Some(dep_node) = graph.find_node_by_module(*dep_module) {
                    if !visited.contains(&dep_node.node_id) {
                        if Self::dfs(graph, dep_node.node_id, visited, rec_stack) {
                            return true;
                        }
                    } else if rec_stack.contains(&dep_node.node_id) {
                        return true;
                    }
                }
            }
        }

        rec_stack.remove(&node_id);
        false
    }

    pub fn find_cycle(graph: &DependencyGraph) -> Vec<u32> {
        let mut path = Vec::new();
        let mut visited: HashSet<u32> = HashSet::new();

        for node in graph.list_nodes() {
            if !visited.contains(&node.node_id) {
                Self::find_cycle_dfs(graph, node.node_id, &mut visited, &mut path);
                if !path.is_empty() {
                    return path;
                }
            }
        }
        Vec::new()
    }

    fn find_cycle_dfs(
        graph: &DependencyGraph,
        node_id: u32,
        visited: &mut HashSet<u32>,
        path: &mut Vec<u32>,
    ) -> bool {
        if let Some(pos) = path.iter().position(|&id| id == node_id) {
            path.drain(0..pos);
            return true;
        }

        if visited.contains(&node_id) {
            return false;
        }

        visited.insert(node_id);
        path.push(node_id);

        if let Some(node) = graph.get_node(node_id) {
            for dep_module in &node.dependencies {
                if let Some(dep_node) = graph.find_node_by_module(*dep_module) {
                    if Self::find_cycle_dfs(graph, dep_node.node_id, visited, path) {
                        return true;
                    }
                }
            }
        }

        path.pop();
        false
    }
}

// ========== Topological Sort ==========

pub struct TopologicalSorter;

impl TopologicalSorter {
    pub fn sort(graph: &DependencyGraph) -> Vec<u32> {
        let mut result = Vec::new();
        let mut visited: HashSet<u32> = HashSet::new();
        let mut stack = Vec::new();

        for node in graph.list_nodes() {
            if !visited.contains(&node.node_id) {
                Self::dfs_visit(graph, node.node_id, &mut visited, &mut stack);
            }
        }

        while let Some(node_id) = stack.pop() {
            result.push(node_id);
        }

        result
    }

    fn dfs_visit(
        graph: &DependencyGraph,
        node_id: u32,
        visited: &mut HashSet<u32>,
        stack: &mut Vec<u32>,
    ) {
        visited.insert(node_id);

        if let Some(node) = graph.get_node(node_id) {
            for dep_module in &node.dependencies {
                if let Some(dep_node) = graph.find_node_by_module(*dep_module) {
                    if !visited.contains(&dep_node.node_id) {
                        Self::dfs_visit(graph, dep_node.node_id, visited, stack);
                    }
                }
            }
        }

        stack.push(node_id);
    }
}

// ========== Dependency Resolver ==========

pub struct DependencyResolver {
    graph: DependencyGraph,
    resolved_order: Vec<u32>,
    unresolved_modules: HashSet<u32>,
}

impl DependencyResolver {
    pub fn new() -> Self {
        Self {
            graph: DependencyGraph::new(),
            resolved_order: Vec::new(),
            unresolved_modules: HashSet::new(),
        }
    }

    pub fn add_module(&mut self, module_id: u32, module_name: String, version: String) {
        self.graph.add_module(module_id, module_name, version);
        self.unresolved_modules.insert(module_id);
    }

    pub fn add_dependency(&mut self, from: u32, to: u32) -> bool {
        self.graph.add_dependency(from, to)
    }

    pub fn resolve(&mut self) -> bool {
        // Check for circular dependencies
        if CircularDependencyDetector::has_cycle(&self.graph) {
            return false;
        }

        // Get topological order
        let order = TopologicalSorter::sort(&self.graph);
        self.resolved_order = order;
        self.unresolved_modules.clear();

        true
    }

    pub fn get_load_order(&self) -> Vec<u32> {
        self.resolved_order.clone()
    }

    pub fn is_resolved(&self) -> bool {
        self.unresolved_modules.is_empty()
    }

    pub fn has_circular_dependency(&self) -> bool {
        CircularDependencyDetector::has_cycle(&self.graph)
    }

    pub fn module_count(&self) -> usize {
        self.graph.node_count()
    }

    pub fn get_dependency_count(&self, module_id: u32) -> usize {
        if let Some(node) = self.graph.find_node_by_module(module_id) {
            node.dependency_count()
        } else {
            0
        }
    }
}

// ========== Tests (C1-C6) ==========

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_c1_dependency_node_creation() {
        let node = DependencyNode::new(0, 1, "math".to_string(), "1.0.0".to_string());

        assert_eq!(node.module_name, "math");
        assert_eq!(node.dependency_count(), 0);
    }

    #[test]
    fn test_c2_dependency_graph_construction() {
        let mut graph = DependencyGraph::new();

        graph.add_module(1, "app".to_string(), "1.0.0".to_string());
        graph.add_module(2, "utils".to_string(), "1.0.0".to_string());

        assert!(graph.add_dependency(1, 2));
        assert_eq!(graph.node_count(), 2);
    }

    #[test]
    fn test_c3_circular_dependency_detection() {
        let mut graph = DependencyGraph::new();

        graph.add_module(1, "a".to_string(), "1.0.0".to_string());
        graph.add_module(2, "b".to_string(), "1.0.0".to_string());

        graph.add_dependency(1, 2);
        graph.add_dependency(2, 1);

        assert!(CircularDependencyDetector::has_cycle(&graph));
    }

    #[test]
    fn test_c4_topological_sort() {
        let mut graph = DependencyGraph::new();

        graph.add_module(1, "base".to_string(), "1.0.0".to_string());
        graph.add_module(2, "middle".to_string(), "1.0.0".to_string());
        graph.add_module(3, "top".to_string(), "1.0.0".to_string());

        graph.add_dependency(2, 1);
        graph.add_dependency(3, 2);

        let order = TopologicalSorter::sort(&graph);
        assert_eq!(order.len(), 3);
    }

    #[test]
    fn test_c5_dependency_resolver_simple() {
        let mut resolver = DependencyResolver::new();

        resolver.add_module(1, "app".to_string(), "1.0.0".to_string());
        resolver.add_module(2, "lib".to_string(), "1.0.0".to_string());

        resolver.add_dependency(1, 2);
        assert!(resolver.resolve());
        assert!(resolver.is_resolved());
    }

    #[test]
    fn test_c6_dependency_resolver_with_cycle() {
        let mut resolver = DependencyResolver::new();

        resolver.add_module(1, "x".to_string(), "1.0.0".to_string());
        resolver.add_module(2, "y".to_string(), "1.0.0".to_string());

        resolver.add_dependency(1, 2);
        resolver.add_dependency(2, 1);

        assert!(!resolver.resolve());
        assert!(resolver.has_circular_dependency());
    }
}

