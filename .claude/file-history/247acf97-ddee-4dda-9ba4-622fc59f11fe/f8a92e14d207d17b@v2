use std::collections::HashMap;

pub use super::module_definition::{Module, ModulePool, ExportItem};

// ========== Scope Level ==========

#[derive(Clone, Debug, PartialEq)]
pub enum ScopeLevel {
    Global,     // 전역 스코프
    Module,     // 모듈 스코프
    Function,   // 함수 스코프
    Block,      // 블록 스코프
}

// ========== Namespace Entry ==========

#[derive(Clone, Debug)]
pub struct NamespaceEntry {
    pub entry_id: u32,
    pub name: String,
    pub symbol_type: String,
    pub module_id: u32,
    pub scope_level: ScopeLevel,
    pub is_resolved: bool,
}

impl NamespaceEntry {
    pub fn new(entry_id: u32, name: String, symbol_type: String, module_id: u32) -> Self {
        Self {
            entry_id,
            name,
            symbol_type,
            module_id,
            scope_level: ScopeLevel::Module,
            is_resolved: false,
        }
    }

    pub fn set_scope_level(&mut self, level: ScopeLevel) {
        self.scope_level = level;
    }

    pub fn mark_resolved(&mut self) {
        self.is_resolved = true;
    }
}

// ========== Namespace ==========

pub struct Namespace {
    pub namespace_id: u32,
    pub name: String,
    pub parent_namespace_id: Option<u32>,
    pub entries: HashMap<String, u32>,  // name -> entry_id
    pub all_entries: Vec<NamespaceEntry>,
    pub next_entry_id: u32,
    pub depth: u32,
}

impl Namespace {
    pub fn new(namespace_id: u32, name: String) -> Self {
        Self {
            namespace_id,
            name,
            parent_namespace_id: None,
            entries: HashMap::new(),
            all_entries: Vec::new(),
            next_entry_id: 0,
            depth: 0,
        }
    }

    pub fn with_parent(mut self, parent_id: u32) -> Self {
        self.parent_namespace_id = Some(parent_id);
        self.depth += 1;
        self
    }

    pub fn add_entry(&mut self, name: String, symbol_type: String, module_id: u32) -> u32 {
        let entry_id = self.next_entry_id;
        self.next_entry_id += 1;

        let entry = NamespaceEntry::new(entry_id, name.clone(), symbol_type, module_id);
        self.entries.insert(name, entry_id);
        self.all_entries.push(entry);

        entry_id
    }

    pub fn resolve_symbol(&self, name: &str) -> Option<&NamespaceEntry> {
        if let Some(entry_id) = self.entries.get(name) {
            self.all_entries.iter().find(|e| e.entry_id == *entry_id)
        } else {
            None
        }
    }

    pub fn list_symbols(&self) -> Vec<&NamespaceEntry> {
        self.all_entries.iter().collect()
    }

    pub fn symbol_count(&self) -> usize {
        self.all_entries.len()
    }

    pub fn is_nested(&self) -> bool {
        self.parent_namespace_id.is_some()
    }
}

// ========== Namespace Hierarchy ==========

pub struct NamespaceHierarchy {
    namespaces: HashMap<u32, Namespace>,
    namespace_map: HashMap<String, u32>,  // full_path -> namespace_id
    next_namespace_id: u32,
    root_namespace_id: u32,
}

impl NamespaceHierarchy {
    pub fn new() -> Self {
        let mut hierarchy = Self {
            namespaces: HashMap::new(),
            namespace_map: HashMap::new(),
            next_namespace_id: 0,
            root_namespace_id: 0,
        };

        // Create root namespace
        let root = Namespace::new(0, "::".to_string());
        hierarchy.namespaces.insert(0, root);
        hierarchy.namespace_map.insert("::".to_string(), 0);
        hierarchy.next_namespace_id = 1;
        hierarchy.root_namespace_id = 0;

        hierarchy
    }

    pub fn create_namespace(&mut self, path: String, parent_id: Option<u32>) -> u32 {
        if self.namespace_map.contains_key(&path) {
            return u32::MAX;  // 중복 체크
        }

        let namespace_id = self.next_namespace_id;
        self.next_namespace_id += 1;

        let namespace = if let Some(parent) = parent_id {
            Namespace::new(namespace_id, path.clone()).with_parent(parent)
        } else {
            Namespace::new(namespace_id, path.clone())
        };

        self.namespace_map.insert(path, namespace_id);
        self.namespaces.insert(namespace_id, namespace);

        namespace_id
    }

    pub fn get_namespace(&self, namespace_id: u32) -> Option<&Namespace> {
        self.namespaces.get(&namespace_id)
    }

    pub fn get_namespace_mut(&mut self, namespace_id: u32) -> Option<&mut Namespace> {
        self.namespaces.get_mut(&namespace_id)
    }

    pub fn find_namespace(&self, path: &str) -> Option<u32> {
        self.namespace_map.get(path).copied()
    }

    pub fn add_symbol_to_namespace(
        &mut self,
        namespace_id: u32,
        name: String,
        symbol_type: String,
        module_id: u32,
    ) -> bool {
        if let Some(ns) = self.namespaces.get_mut(&namespace_id) {
            ns.add_entry(name, symbol_type, module_id);
            true
        } else {
            false
        }
    }

    pub fn resolve_symbol(&self, namespace_id: u32, name: &str) -> Option<&NamespaceEntry> {
        if let Some(ns) = self.namespaces.get(&namespace_id) {
            ns.resolve_symbol(name)
        } else {
            None
        }
    }

    pub fn get_full_path(&self, namespace_id: u32) -> String {
        if let Some(ns) = self.namespaces.get(&namespace_id) {
            format!("::{}", ns.name)
        } else {
            "::unknown".to_string()
        }
    }

    pub fn namespace_count(&self) -> usize {
        self.namespaces.len()
    }

    pub fn max_depth(&self) -> u32 {
        self.namespaces
            .values()
            .map(|ns| ns.depth)
            .max()
            .unwrap_or(0)
    }

    pub fn list_namespaces(&self) -> Vec<&Namespace> {
        self.namespaces.values().collect()
    }
}

// ========== Scope Manager ==========

pub struct ScopeManager {
    namespace_hierarchy: NamespaceHierarchy,
    current_namespace_id: u32,
    scope_stack: Vec<ScopeLevel>,
}

impl ScopeManager {
    pub fn new() -> Self {
        let mut mgr = Self {
            namespace_hierarchy: NamespaceHierarchy::new(),
            current_namespace_id: 0,
            scope_stack: vec![ScopeLevel::Global],
        };
        mgr
    }

    pub fn create_module_namespace(&mut self, module_name: String) -> u32 {
        let path = format!("modules::{}", module_name);
        self.namespace_hierarchy
            .create_namespace(path, Some(self.namespace_hierarchy.root_namespace_id))
    }

    pub fn push_scope(&mut self, level: ScopeLevel) {
        self.scope_stack.push(level);
    }

    pub fn pop_scope(&mut self) -> Option<ScopeLevel> {
        if self.scope_stack.len() > 1 {
            self.scope_stack.pop()
        } else {
            None
        }
    }

    pub fn current_scope(&self) -> ScopeLevel {
        self.scope_stack.last().cloned().unwrap_or(ScopeLevel::Global)
    }

    pub fn scope_depth(&self) -> usize {
        self.scope_stack.len()
    }

    pub fn add_symbol(
        &mut self,
        name: String,
        symbol_type: String,
        module_id: u32,
    ) -> bool {
        self.namespace_hierarchy.add_symbol_to_namespace(
            self.current_namespace_id,
            name,
            symbol_type,
            module_id,
        )
    }

    pub fn resolve_symbol(&self, name: &str) -> Option<&NamespaceEntry> {
        self.namespace_hierarchy
            .resolve_symbol(self.current_namespace_id, name)
    }

    pub fn set_current_namespace(&mut self, namespace_id: u32) -> bool {
        if self.namespace_hierarchy.get_namespace(namespace_id).is_some() {
            self.current_namespace_id = namespace_id;
            true
        } else {
            false
        }
    }

    pub fn total_symbols(&self) -> usize {
        self.namespace_hierarchy
            .list_namespaces()
            .iter()
            .map(|ns| ns.symbol_count())
            .sum()
    }
}

// ========== Tests (B1-B6) ==========

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_b1_namespace_creation() {
        let namespace = Namespace::new(0, "math".to_string());

        assert_eq!(namespace.name, "math");
        assert_eq!(namespace.symbol_count(), 0);
    }

    #[test]
    fn test_b2_namespace_entry_addition() {
        let mut namespace = Namespace::new(0, "utils".to_string());

        namespace.add_entry("sqrt".to_string(), "function".to_string(), 1);
        namespace.add_entry("abs".to_string(), "function".to_string(), 1);

        assert_eq!(namespace.symbol_count(), 2);
    }

    #[test]
    fn test_b3_namespace_symbol_resolution() {
        let mut namespace = Namespace::new(0, "io".to_string());

        namespace.add_entry("println".to_string(), "function".to_string(), 1);

        let resolved = namespace.resolve_symbol("println");
        assert!(resolved.is_some());
    }

    #[test]
    fn test_b4_namespace_hierarchy() {
        let mut hierarchy = NamespaceHierarchy::new();

        let ns_id = hierarchy.create_namespace("std".to_string(), None);
        assert!(hierarchy.find_namespace("std").is_some());

        let child_id = hierarchy.create_namespace("::std::io".to_string(), Some(ns_id));
        assert!(hierarchy.find_namespace("::std::io").is_some());
    }

    #[test]
    fn test_b5_scope_manager_creation() {
        let scope_mgr = ScopeManager::new();

        assert_eq!(scope_mgr.scope_depth(), 1);
        assert_eq!(scope_mgr.current_scope(), ScopeLevel::Global);
    }

    #[test]
    fn test_b6_scope_manager_nesting() {
        let mut scope_mgr = ScopeManager::new();

        scope_mgr.push_scope(ScopeLevel::Function);
        assert_eq!(scope_mgr.scope_depth(), 2);

        scope_mgr.push_scope(ScopeLevel::Block);
        assert_eq!(scope_mgr.scope_depth(), 3);

        scope_mgr.pop_scope();
        assert_eq!(scope_mgr.scope_depth(), 2);
    }
}

