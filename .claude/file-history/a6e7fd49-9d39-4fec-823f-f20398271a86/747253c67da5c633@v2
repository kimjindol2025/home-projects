│  ├─ utils/         # 유틸리티
│  └─ main.ts        # 진입점
│
├─ tests/            # 테스트
│  ├─ unit/          # 유닛 테스트
│  └─ e2e/           # 통합 테스트
│
├─ docs/             # 문서
│  ├─ README.md      # 개요
│  ├─ USAGE.md       # 사용 가이드
│  └─ API.md         # API 문서
│
├─ examples/         # 예제
│  └─ quick-start/   # 빠른 시작
│
├─ .claude/          # Claude 메모리
│  └─ projects/
│     └─ tool-cli/
│        └─ memory/
│           └─ MEMORY.md
│
├─ CLAUDE.md         # 이 파일 (프로젝트 규칙)
├─ README.md         # 프로젝트 소개
├─ package.json      # 메타데이터
├─ .gitignore        # Git 설정
└─ MEMORY.md         # 진행 상황 기록
```

