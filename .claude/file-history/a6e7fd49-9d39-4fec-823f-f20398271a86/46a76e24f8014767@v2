{
  "name": "@kim/tool-cli",
  "version": "0.1.0-alpha",
  "description": "FreeLang 개발자용 커맨드라인 도구 모음",
  "main": "dist/main.js",
  "type": "module",
  "bin": {
    "tool-cli": "dist/main.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "freelang",
    "cli",
    "tool",
    "build",
    "deploy"
  ],
  "author": "kim",
  "license": "MIT",
  "homepage": "https://gogs.dclub.kr/kim/tool-cli",
  "repository": {
    "type": "git",
    "url": "https://gogs.dclub.kr/kim/tool-cli.git"
  },
  "bugs": {
    "url": "https://gogs.dclub.kr/kim/tool-cli/issues"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build:dev": "esbuild src/main.ts --bundle --platform=node --target=es2020 --outfile=dist/main.js",
    "build:prod": "esbuild src/main.ts --bundle --platform=node --target=es2020 --minify --outfile=dist/main.js",
    "build:analyze": "esbuild src/main.ts --bundle --platform=node --target=es2020 --analyze --outfile=dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "precommit": "lint-staged",
    "prepare": "npm run build:prod"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "fs-extra": "^11.2.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "esbuild": "^0.20.1",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "lint-staged": "^15.2.2",
    "husky": "^8.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
