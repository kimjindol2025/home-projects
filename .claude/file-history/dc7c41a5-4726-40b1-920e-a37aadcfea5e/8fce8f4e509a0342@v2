#[test]
fn benchmark_ttf_parser_creation() {
    // TTFParser 생성 시간
    let ttf_data = vec![0x00; 5000];
    let parser = TTFParser::new(ttf_data);
    assert_eq!(parser.data.len(), 5000);
    // 예상: < 1µs
}

#[test]
fn benchmark_header_parsing() {
    // Header 파싱 시간
    let mut ttf_data = vec![0x00; 500];
    ttf_data[50] = 0x03;
    ttf_data[51] = 0xE8;

    let mut parser = TTFParser::new(ttf_data);
    parser.parse_header();
    // 예상: < 1µs
    assert!(parser.header.units_per_em > 0);
}

#[test]
fn benchmark_glyph_count_parsing() {
