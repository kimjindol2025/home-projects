module cluster_manager

// ============ Node Identity ============

struct NodeId {
    id: u32,
    hostname: string,
    address: string,
    port: u16,
}

impl NodeId {
    fn new(id: u32, hostname: string, address: string, port: u16) -> NodeId {
        return NodeId {
            id: id,
            hostname: hostname,
            address: address,
            port: port,
        }
    }

    fn to_string(&self) -> string {
        let mut s = ""
        s = s + "Node-" + self.id.to_string()
        s = s + " (" + self.hostname + ":" + self.port.to_string() + ")"
        return s
    }
}

// ============ Node Health ============

enum HealthStatus {
    Healthy,
    Degraded,
    Unhealthy,
    Dead,
}

struct NodeHealth {
    node_id: u32,
    status: HealthStatus,
    last_heartbeat: u32,
    consecutive_failures: u32,
    cpu_usage: u32,
    memory_usage: u32,
}

impl NodeHealth {
    fn new(node_id: u32) -> NodeHealth {
        return NodeHealth {
            node_id: node_id,
            status: HealthStatus::Healthy,
            last_heartbeat: 0,
            consecutive_failures: 0,
            cpu_usage: 0,
            memory_usage: 0,
        }
    }

    fn record_heartbeat(&mut self, cpu: u32, mem: u32) -> bool {
        self.status = HealthStatus::Healthy
        self.last_heartbeat = 1000
        self.consecutive_failures = 0
        self.cpu_usage = cpu
        self.memory_usage = mem
        return true
    }

    fn record_failure(&mut self) -> bool {
        self.consecutive_failures += 1
        if self.consecutive_failures > 3 {
            self.status = HealthStatus::Dead
        } else if self.consecutive_failures > 1 {
            self.status = HealthStatus::Unhealthy
        }
        return true
    }

    fn is_healthy(&self) -> bool {
        return match self.status {
            HealthStatus::Healthy => true,
            _ => false,
        }
    }

    fn is_alive(&self) -> bool {
        return match self.status {
            HealthStatus::Dead => false,
            _ => true,
        }
    }
}

// ============ Cluster Configuration ============

struct ClusterConfig {
    node_count: u32,
    heartbeat_interval: u32,
    heartbeat_timeout: u32,
    replication_factor: u32,
}

impl ClusterConfig {
    fn new(node_count: u32) -> ClusterConfig {
        return ClusterConfig {
            node_count: node_count,
            heartbeat_interval: 1000,
            heartbeat_timeout: 5000,
            replication_factor: 3,
        }
    }

    fn set_heartbeat_interval(&mut self, interval: u32) -> bool {
        self.heartbeat_interval = interval
        return true
    }

    fn validate(&self) -> bool {
        return self.node_count >= 3 && self.node_count <= 5
    }
}

// ============ Cluster State ============

struct ClusterState {
    leader_id: u32,
    term: u32,
    committed_index: u32,
    log_entries: u32,
}

impl ClusterState {
    fn new() -> ClusterState {
        return ClusterState {
            leader_id: 0,
            term: 0,
            committed_index: 0,
            log_entries: 0,
        }
    }

    fn update_leader(&mut self, leader_id: u32) -> bool {
        if leader_id > 0 {
            self.leader_id = leader_id
            self.term += 1
            return true
        }
        return false
    }

    fn add_log_entry(&mut self) -> bool {
        self.log_entries += 1
        self.committed_index += 1
        return true
    }

    fn consistency_check(&self) -> bool {
        return self.log_entries >= self.committed_index
    }
}

// ============ Cluster Manager ============

struct ClusterManager {
    config: ClusterConfig,
    nodes: NodeId[],
    health_status: NodeHealth[],
    state: ClusterState,
    leader_id: u32,
}

impl ClusterManager {
    fn new(node_count: u32) -> ClusterManager {
        return ClusterManager {
            config: ClusterConfig::new(node_count),
            nodes: [],
            health_status: [],
            state: ClusterState::new(),
            leader_id: 0,
        }
    }

    fn register_node(&mut self, node: NodeId) -> bool {
        self.nodes.push(node)
        self.health_status.push(NodeHealth::new(node.id))
        return true
    }

    fn node_count(&self) -> u32 {
        return self.nodes.len() as u32
    }

    fn record_heartbeat(&mut self, node_id: u32, cpu: u32, mem: u32) -> bool {
        for i in 0..(self.health_status.len() as u32) {
            if self.health_status[i as usize].node_id == node_id {
                self.health_status[i as usize].record_heartbeat(cpu, mem)
                return true
            }
        }
        return false
    }

    fn detect_failures(&mut self) -> u32 {
        let mut dead_count = 0 as u32
        for i in 0..(self.health_status.len() as u32) {
            if !self.health_status[i as usize].is_alive() {
                dead_count += 1
            }
        }
        return dead_count
    }

    fn healthy_node_count(&self) -> u32 {
        let mut count = 0 as u32
        for health in self.health_status {
            if health.is_healthy() {
                count += 1
            }
        }
        return count
    }

    fn has_quorum(&self) -> bool {
        let total = self.node_count()
        let healthy = self.healthy_node_count()
        return healthy > (total / 2)
    }

    fn elect_leader(&mut self) -> u32 {
        let mut best_node = 0 as u32
        let mut best_cpu = 100 as u32

        for i in 0..(self.health_status.len() as u32) {
            let health = self.health_status[i as usize]
            if health.is_healthy() && health.cpu_usage < best_cpu {
                best_node = health.node_id
                best_cpu = health.cpu_usage
            }
        }

        if best_node > 0 {
            self.leader_id = best_node
            self.state.update_leader(best_node)
            return best_node
        }
        return 0
    }

    fn stats(&self) -> string {
        let mut s = ""
        s = s + "Cluster Stats:\n"
        s = s + "Total nodes: " + self.node_count().to_string() + "\n"
        s = s + "Healthy nodes: " + self.healthy_node_count().to_string() + "\n"
        s = s + "Leader: Node-" + self.leader_id.to_string() + "\n"
        s = s + "Has quorum: "
        if self.has_quorum() {
            s = s + "YES"
        } else {
            s = s + "NO"
        }
        s = s + "\n"
        s = s + "Cluster term: " + self.state.term.to_string()
        return s
    }
}

// ============ Message Broker ============

struct MessageBroker {
    message_count: u32,
    delivered: u32,
    dropped: u32,
}

impl MessageBroker {
    fn new() -> MessageBroker {
        return MessageBroker {
            message_count: 0,
            delivered: 0,
            dropped: 0,
        }
    }

    fn send_message(&mut self) -> bool {
        self.message_count += 1
        return true
    }

    fn deliver_all(&mut self) -> bool {
        self.delivered += self.message_count
        self.message_count = 0
        return true
    }

    fn delivery_rate(&self) -> u32 {
        if self.delivered + self.dropped > 0 {
            return (self.delivered * 100) / (self.delivered + self.dropped)
        }
        return 100
    }
}

// ============ Cluster Context ============

struct ClusterContext {
    manager: ClusterManager,
    broker: MessageBroker,
    consistency_violations: u32,
}

impl ClusterContext {
    fn new(node_count: u32) -> ClusterContext {
        return ClusterContext {
            manager: ClusterManager::new(node_count),
            broker: MessageBroker::new(),
            consistency_violations: 0,
        }
    }

    fn initialize(&mut self) -> bool {
        for i in 1..(self.manager.config.node_count + 1) {
            let node = NodeId::new(
                i,
                "node",
                "192.168.1.1",
                5000 + i as u16
            )
            self.manager.register_node(node)
        }
        self.manager.elect_leader()
        return true
    }

    fn sync_cluster(&mut self) -> bool {
        for _i in 1..(self.manager.node_count() + 1) {
            self.broker.send_message()
        }
        self.broker.deliver_all()
        return true
    }

    fn validate_consistency(&mut self) -> bool {
        if !self.manager.state.consistency_check() {
            self.consistency_violations += 1
            return false
        }
        return true
    }

    fn consistency_rate(&self) -> u32 {
        if self.consistency_violations > 0 {
            return 0
        }
        return 100
    }

    fn stats(&self) -> string {
        let mut s = ""
        s = s + self.manager.stats() + "\n"
        s = s + "Message delivery rate: " + self.broker.delivery_rate().to_string() + "%"
        return s
    }
}
