// Phase 5.2 Day 5: Tracing 모듈 통합 (120줄)
// OpenTelemetry 분산 추적 레이어 (L-Tracing)

pub mod tracer;
pub mod spans;
pub mod metrics;
pub mod distributed_propagation;

pub use tracer::{Tracer, TraceId, SpanId, Span, get_timestamp_us};
pub use spans::{L1Spans, L2Spans, L3Spans, L4Spans, L5Spans};
pub use metrics::{Metric, MetricsCollector, MetricsSummary};
pub use distributed_propagation::{TraceContext, DistributedPropagator, DistributedTracingMetrics};

pub struct DistributedTracingLayer {
    pub tracer: Tracer,
    pub metrics_collector: MetricsCollector,
    pub distributed_metrics: DistributedTracingMetrics,
    pub enabled: bool,
    pub sampling_rate: f64,
}

impl DistributedTracingLayer {
    pub fn new() -> Self {
        DistributedTracingLayer {
            tracer: Tracer::new(),
            metrics_collector: MetricsCollector::new(),
            distributed_metrics: DistributedTracingMetrics::new(),
            enabled: true,
            sampling_rate: 1.0,  // 100% sampling
        }
    }

    pub fn with_sampling_rate(mut self, rate: f64) -> Self {
        self.sampling_rate = rate.max(0.0).min(1.0);
        self
    }

    pub fn should_trace(&self) -> bool {
        if !self.enabled {
            return false;
        }

        // Simple sampling decision
        (self.tracer.current_trace_id.low % 100) as f64 <= (self.sampling_rate * 100.0)
    }

    pub fn get_trace_id(&self) -> TraceId {
        self.tracer.current_trace_id
    }

    pub fn get_spans_count(&self) -> usize {
        self.tracer.get_trace_spans_count()
    }

    pub fn get_metrics_count(&self) -> usize {
        self.metrics_collector.get_metric_count()
    }

    pub fn get_summary(&self) -> DistributedTracingReport {
        DistributedTracingReport {
            trace_id: self.tracer.current_trace_id.to_string(),
            total_spans: self.tracer.get_trace_spans_count(),
            total_metrics: self.metrics_collector.get_metric_count(),
            total_duration_us: self.tracer.get_total_duration_us(),
            enabled: self.enabled,
            sampling_rate: self.sampling_rate,
            propagation_success_rate: self.distributed_metrics.get_propagation_success_rate(),
        }
    }
}

pub struct DistributedTracingReport {
    pub trace_id: String,
    pub total_spans: usize,
    pub total_metrics: usize,
    pub total_duration_us: u64,
    pub enabled: bool,
    pub sampling_rate: f64,
    pub propagation_success_rate: f64,
}

impl DistributedTracingReport {
    pub fn display(&self) {
        println!("Distributed Tracing Report:");
        println!("  Trace ID: {}", self.trace_id);
        println!("  Total Spans: {}", self.total_spans);
        println!("  Total Metrics: {}", self.total_metrics);
        println!("  Total Duration: {} us", self.total_duration_us);
        println!("  Enabled: {}", self.enabled);
        println!("  Sampling Rate: {:.1}%", self.sampling_rate * 100.0);
        println!("  Propagation Success Rate: {:.1}%", self.propagation_success_rate);
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_tracing_layer_creation() {
        let layer = DistributedTracingLayer::new();
        assert!(layer.enabled);
        assert_eq!(layer.sampling_rate, 1.0);
    }

    #[test]
    fn test_tracing_layer_with_sampling() {
        let layer = DistributedTracingLayer::new()
            .with_sampling_rate(0.5);

        assert_eq!(layer.sampling_rate, 0.5);
    }

    #[test]
    fn test_should_trace_sampling() {
        let layer = DistributedTracingLayer::new()
            .with_sampling_rate(1.0);

        assert!(layer.should_trace());
    }

    #[test]
    fn test_tracing_layer_span_tracking() {
        let mut layer = DistributedTracingLayer::new();

        let mut span = L1Spans::measure_power(&mut layer.tracer);
        span.end();
        layer.tracer.end_span(&mut span);

        assert_eq!(layer.get_spans_count(), 1);
    }
}
