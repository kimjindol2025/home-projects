mod tests {
    use super::*;

    #[test]
    fn test_layer_performance_creation() {
        let perf = LayerPerformance::new(Layer::L1PowerSensing);
        assert_eq!(perf.total_latency_us, 0);
    }

    #[test]
    fn test_l1_optimization() {
        let mut l1 = L1OptimizationStrategy::new();
        let optimized_interval = l1.optimize_sampling_frequency();
        assert_eq!(optimized_interval, 5);  // Should optimize to 5ms
    }

    #[test]
    fn test_l2_dvfs_optimization() {
        let mut l2 = L2SchedulerOptimization::new();
        let success = l2.optimize_dvfs_transition();
        assert!(success);
        assert!(l2.dvfs_transition_latency_us <= l2.dvfs_target_latency_us);
    }

    #[test]
    fn test_l3_predictor_optimization() {
        let mut l3 = L3PredictorOptimization::new();
        l3.optimize_prediction_model();
        assert!(l3.accuracy_percent > 95.0);
        assert_eq!(l3.model_complexity, 3);
    }

    #[test]
    fn test_layer_analysis() {
        let mut analysis = LayerAnalysis::new();

        let mut perf1 = LayerPerformance::new(Layer::L1PowerSensing);
        perf1.total_latency_us = 5000;
        perf1.sampling_latency_us = 5000;

        let mut perf2 = LayerPerformance::new(Layer::L2GreenScheduler);
        perf2.total_latency_us = 3000;
        perf2.processing_latency_us = 3000;

        analysis.add_layer(perf1);
        analysis.add_layer(perf2);
        analysis.analyze();

        assert!(analysis.critical_path_latency_us > 0);
    }
}
