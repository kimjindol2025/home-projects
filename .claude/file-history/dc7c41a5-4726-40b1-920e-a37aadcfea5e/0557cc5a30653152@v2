// ============================================================================
// Part 4: Comprehensive Layer Analysis (220 lines)
// ============================================================================

pub struct LayerAnalysis {
    pub layers: Vec<LayerPerformance>,
    pub critical_path_latency_us: u64,
    pub total_overhead_us: u64,
    pub optimization_potential_percent: f64,
}

impl LayerAnalysis {
    pub fn new() -> Self {
        LayerAnalysis {
            layers: Vec::new(),
            critical_path_latency_us: 0,
            total_overhead_us: 0,
            optimization_potential_percent: 0.0,
        }
    }

    pub fn add_layer(&mut self, layer: LayerPerformance) {
        self.layers.push(layer);
    }

    pub fn analyze(&mut self) {
        if self.layers.is_empty() {
            return;
        }

        // Critical path = sum of sequential latencies
        self.critical_path_latency_us = self.layers.iter()
            .map(|l| l.total_latency_us)
            .sum();

        // Total overhead = bottlenecks
        self.total_overhead_us = self.layers.iter()
            .filter(|l| l.is_optimizable())
            .map(|l| l.total_latency_us)
            .sum();

        // Optimization potential = overhead / critical path
        if self.critical_path_latency_us > 0 {
            self.optimization_potential_percent =
                (self.total_overhead_us as f64 / self.critical_path_latency_us as f64) * 100.0;
        }
    }

    pub fn get_bottleneck_layers(&self) -> Vec<&LayerPerformance> {
        let mut bottlenecks: Vec<_> = self.layers.iter()
            .filter(|l| l.is_optimizable())
            .collect();

        // Sort by priority (highest first)
        bottlenecks.sort_by_key(|l| std::cmp::Reverse(l.optimization_priority()));
        bottlenecks
    }

    pub fn summary(&self) -> String {
        format!(
            "Layer Analysis: critical_path={}µs, overhead={}µs, \
            optimization_potential={:.1}%, bottlenecks={}",
            self.critical_path_latency_us, self.total_overhead_us,
            self.optimization_potential_percent,
            self.get_bottleneck_layers().len()
        )
    }
}

