// Part 1: Layer Performance Metrics (280 lines)
// ============================================================================

pub enum Layer {
    L1PowerSensing,
    L2GreenScheduler,
    L3PredictivePM,
    L4GreenConsensus,
    L5EnergyHistory,
}

pub struct LayerPerformance {
    pub layer: Layer,
    pub total_latency_us: u64,
    pub sampling_latency_us: u64,
    pub processing_latency_us: u64,
    pub communication_latency_us: u64,
    pub throughput_ops_per_sec: f64,
    pub cpu_utilization_percent: f64,
    pub memory_usage_mb: u32,
}

impl LayerPerformance {
    pub fn new(layer: Layer) -> Self {
        LayerPerformance {
            layer,
            total_latency_us: 0,
            sampling_latency_us: 0,
            processing_latency_us: 0,
            communication_latency_us: 0,
            throughput_ops_per_sec: 0.0,
            cpu_utilization_percent: 0.0,
            memory_usage_mb: 0,
        }
    }

    pub fn calculate_total_latency(&mut self) {
        self.total_latency_us = self.sampling_latency_us +
            self.processing_latency_us +
            self.communication_latency_us;
    }

    pub fn is_optimizable(&self) -> bool {
        // Layer is optimizable if latency > 100us (target: <100us)
        self.total_latency_us > 100
    }

    pub fn optimization_priority(&self) -> u32 {
        // Priority based on latency (higher = more critical)
        if self.total_latency_us > 1000 {
            10  // Critical
        } else if self.total_latency_us > 500 {
            8   // High
        } else if self.total_latency_us > 200 {
            5   // Medium
        } else {
            2   // Low
        }
    }

    pub fn describe(&self) -> String {
        format!(
            "Layer {:?}: total={:.0}µs (sampling={:.0}µs, processing={:.0}µs, comm={:.0}µs), \
            throughput={:.0}ops/s, cpu={:.0}%, mem={}MB",
            self.layer, self.total_latency_us as f64, self.sampling_latency_us as f64,
            self.processing_latency_us as f64, self.communication_latency_us as f64,
            self.throughput_ops_per_sec, self.cpu_utilization_percent, self.memory_usage_mb
        )
    }
}

