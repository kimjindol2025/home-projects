// Part 3: Sleep Optimization Engine (240 lines)
// ============================================================================

pub struct SleepOptimizer {
    pub current_state: SleepState,
    pub target_state: SleepState,
    pub idle_duration_ms: u32,
    pub latency_budget_ms: u32,        // Acceptable wakeup latency
    pub energy_saved_uj: u32,
    pub total_sleep_time_ms: u64,
}

impl SleepOptimizer {
    pub fn new() -> Self {
        SleepOptimizer {
            current_state: SleepState::C0,
            target_state: SleepState::C0,
            idle_duration_ms: 0,
            latency_budget_ms: 10,  // Default: can tolerate 10ms wakeup
            energy_saved_uj: 0,
            total_sleep_time_ms: 0,
        }
    }

    pub fn select_optimal_sleep_state(&mut self, idle_ms: u32, latency_budget_ms: u32) -> SleepState {
        self.idle_duration_ms = idle_ms;
        self.latency_budget_ms = latency_budget_ms;

        // Decision matrix based on idle duration and latency budget
        self.target_state = match (idle_ms, latency_budget_ms) {
            // Too short to sleep
            (0..=5, _) => SleepState::C0,

            // Short idle, tight latency budget
            (6..=100, 0..=1) => SleepState::C1Light,

            // Medium idle, medium latency
            (101..=500, 2..=10) => SleepState::C2Medium,

            // Long idle, loose latency budget
            (501..=2000, 11..=100) => SleepState::C3Deep,

            // Very long idle, very loose latency
            (2001..=u32::MAX, 101..=u32::MAX) => SleepState::C6PowerGate,

            _ => SleepState::C0,
        };

        self.target_state
    }

    pub fn apply_sleep_transition(&mut self) {
        // Create transition
        let transition = SleepStateTransition::new(
            match &self.current_state {
                SleepState::C0 => SleepState::C0,
                SleepState::C1Light => SleepState::C1Light,
                SleepState::C2Medium => SleepState::C2Medium,
                SleepState::C3Deep => SleepState::C3Deep,
                SleepState::C6PowerGate => SleepState::C6PowerGate,
            },
            match &self.target_state {
                SleepState::C0 => SleepState::C0,
                SleepState::C1Light => SleepState::C1Light,
                SleepState::C2Medium => SleepState::C2Medium,
                SleepState::C3Deep => SleepState::C3Deep,
                SleepState::C6PowerGate => SleepState::C6PowerGate,
            }
        );

        // Check if transition is worthwhile
        if transition.is_worth_transition(self.idle_duration_ms) {
            self.current_state = self.target_state;
            self.energy_saved_uj = transition.power_cost_uj;
            self.total_sleep_time_ms += self.idle_duration_ms as u64;
        }
    }

    pub fn power_consumption_mw(&self) -> f64 {
        match self.current_state {
            SleepState::C0 => 200.0,           // Full power
            SleepState::C1Light => 10.0,       // Light sleep
            SleepState::C2Medium => 5.0,       // Medium sleep
            SleepState::C3Deep => 1.0,         // Deep sleep
            SleepState::C6PowerGate => 0.1,    // Power gate (minimal)
        }
    }

    pub fn describe(&self) -> String {
        let current_name = match self.current_state {
            SleepState::C0 => "C0",
            SleepState::C1Light => "C1",
            SleepState::C2Medium => "C2",
            SleepState::C3Deep => "C3",
            SleepState::C6PowerGate => "C6",
        };

        let target_name = match self.target_state {
            SleepState::C0 => "C0",
            SleepState::C1Light => "C1",
            SleepState::C2Medium => "C2",
            SleepState::C3Deep => "C3",
            SleepState::C6PowerGate => "C6",
        };

        format!(
            "Sleep Optimizer: current={}, target={}, idle={}ms, \
            latency_budget={}ms, power={:.1}mW, total_sleep={}ms",
            current_name, target_name, self.idle_duration_ms,
            self.latency_budget_ms, self.power_consumption_mw(), self.total_sleep_time_ms
        )
    }
}

// ============================================================================
// Tests (120 lines)
// ============================================================================

mod tests {
    use super::*;

    #[test]
    fn test_sleep_state_transition_creation() {
        let trans = SleepStateTransition::new(SleepState::C0, SleepState::C3Deep);
        assert!(trans.transition_latency_us > 0);
        assert!(trans.exit_latency_us > 0);
    }

    #[test]
    fn test_transition_worth_check() {
        let trans = SleepStateTransition::new(SleepState::C0, SleepState::C3Deep);
        let exit_latency_ms = trans.exit_latency_us / 1000;

        // Worth it if idle > exit_latency + 2ms
        let worth = trans.is_worth_transition(exit_latency_ms + 3);
        assert!(worth);

        let not_worth = trans.is_worth_transition(exit_latency_ms);
        assert!(!not_worth);
    }

    #[test]
    fn test_sleep_duration_predictor() {
        let mut predictor = SleepDurationPredictor::new();

        for i in 0..10 {
            predictor.record_idle_period(50 + (i as u32 * 5));
        }

        let predicted = predictor.predict_next_duration();
        assert!(predicted > 0);
    }

    #[test]
    fn test_periodicity_detection() {
        let mut predictor = SleepDurationPredictor::new();

        // Create periodic pattern: 50, 60, 70, 50, 60, 70, ...
        for _ in 0..3 {
            predictor.record_idle_period(50);
            predictor.record_idle_period(60);
            predictor.record_idle_period(70);
        }

        predictor.predict_next_duration();
        // Should detect period, increase confidence
        assert!(predictor.confidence > 0.5);
    }

    #[test]
    fn test_sleep_optimizer_state_selection() {
        let mut optimizer = SleepOptimizer::new();

        // Short idle, tight latency
        let state = optimizer.select_optimal_sleep_state(50, 1);
        assert!(matches!(state, SleepState::C1Light));

        // Long idle, loose latency
        let state = optimizer.select_optimal_sleep_state(1000, 50);
        assert!(matches!(state, SleepState::C3Deep | SleepState::C6PowerGate));
    }

    #[test]
    fn test_power_consumption_by_state() {
        let mut optimizer = SleepOptimizer::new();

        optimizer.current_state = SleepState::C0;
        assert_eq!(optimizer.power_consumption_mw() as u32, 200);

        optimizer.current_state = SleepState::C3Deep;
        assert!(optimizer.power_consumption_mw() < 2.0);

        optimizer.current_state = SleepState::C6PowerGate;
        assert!(optimizer.power_consumption_mw() < 1.0);
    }

    #[test]
    fn test_sleep_time_accumulation() {
        let mut optimizer = SleepOptimizer::new();
        optimizer.current_state = SleepState::C0;

        // Simulate multiple sleep periods
        for _ in 0..5 {
            optimizer.idle_duration_ms = 100;
            optimizer.apply_sleep_transition();
        }

        assert!(optimizer.total_sleep_time_ms > 0);
    }
}
