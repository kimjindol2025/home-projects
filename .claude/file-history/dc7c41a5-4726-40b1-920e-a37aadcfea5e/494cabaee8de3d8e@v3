// Week 3: Extended Power Patterns - 7-12가지 실제 전력 패턴 (600줄)

module power_pattern

// ============ Pattern Type ============

enum PatternType {
    Thermal,
    Compute,
    IO,
    DutyCycle,
    Memory,
    Network,
    Mixed,
    Idle,
    Burst,
    Continuous,
    Interrupt,
    Sleep,
}

// ============ Power Pattern ============

struct PowerPattern {
    pattern_type: PatternType,
    name: string,
    average_power: u32,      // mW
    peak_power: u32,         // mW
    idle_power: u32,         // mW
    duration: u32,           // seconds
    frequency: u32,          // Hz
    duty_cycle: u32,         // percent
    temperature_impact: u32, // mW per °C
    thermal_coefficient: u32,
}

impl PowerPattern {
    fn new(ptype: PatternType, name: string) -> PowerPattern {
        return PowerPattern {
            pattern_type: ptype,
            name: name,
            average_power: 100,
            peak_power: 500,
            idle_power: 10,
            duration: 3600,
            frequency: 1000,
            duty_cycle: 50,
            temperature_impact: 5,
            thermal_coefficient: 10,
        }
    }

    fn set_power(&mut self, avg: u32, peak: u32, idle: u32) -> bool {
        self.average_power = avg
        self.peak_power = peak
        self.idle_power = idle
        return true
    }

    fn set_duty_cycle(&mut self, cycle: u32) -> bool {
        if cycle > 100 {
            return false
        }
        self.duty_cycle = cycle
        return true
    }

    fn calculate_energy(&self, seconds: u32) -> u32 {
        // Energy = average_power * time (mWh)
        return (self.average_power * seconds) / 3600
    }

    fn calculate_thermal_power(&self, temp_delta: u32) -> u32 {
        return self.temperature_impact * temp_delta
    }

    fn get_dynamic_power(&self, frequency: u32) -> u32 {
        // Power ≈ frequency * voltage²
        return (frequency * self.average_power) / 1000
    }

    fn get_leakage_power(&self) -> u32 {
        return self.idle_power
    }
}

// ============ Thermal Pattern (가열 부하) ============

struct ThermalPattern {
    base_power: u32,
    heat_dissipation_rate: u32,  // W/s
    throttling_threshold: u32,    // °C
    thermal_resistance: u32,      // °C/W
}

impl ThermalPattern {
    fn new() -> ThermalPattern {
        return ThermalPattern {
            base_power: 300,
            heat_dissipation_rate: 50,
            throttling_threshold: 85,
            thermal_resistance: 2,
        }
    }

    fn get_temperature_rise(&self, time: u32) -> u32 {
        // ΔT = Power * Rth * (1 - e^(-t/τ))
        return (self.base_power * self.thermal_resistance) / 100
    }

    fn apply_throttling(&self, current_temp: u32) -> u32 {
        if current_temp > self.throttling_threshold {
            return 50  // 50% throttling at threshold
        }
        return 100
    }
}

// ============ Compute Pattern (CPU 집약적) ============

struct ComputePattern {
    cpu_utilization: u32,  // percent
    cache_miss_rate: u32,  // percent
    frequency_scaling: u32, // MHz
    power_per_mip: u32,    // mW per million instructions/sec
}

impl ComputePattern {
    fn new() -> ComputePattern {
        return ComputePattern {
            cpu_utilization: 80,
            cache_miss_rate: 3,
            frequency_scaling: 2000,
            power_per_mip: 2,
        }
    }

    fn get_power_consumption(&self) -> u32 {
        let util_power = (self.cpu_utilization * 50) / 100  // 0-50mW from util
        let freq_power = (self.frequency_scaling * 2) / 100   // 0-40mW from freq
        let cache_power = (self.cache_miss_rate * 10) / 100   // 0-10mW from cache
        return util_power + freq_power + cache_power + 10     // +10mW baseline
    }

    fn get_instructions_per_sec(&self, frequency: u32) -> u32 {
        return (frequency * self.cpu_utilization) / 100
    }
}

// ============ I/O Pattern (메모리/스토리지 접근) ============

struct IOPattern {
    bandwidth: u32,         // MB/s
    access_latency: u32,    // ns
    memory_access_power: u32,  // mW per 1MB/s
    idle_time: u32,         // percent
}

impl IOPattern {
    fn new() -> IOPattern {
        return IOPattern {
            bandwidth: 100,
            access_latency: 50,
            memory_access_power: 5,
            idle_time: 40,
        }
    }

    fn get_power_consumption(&self) -> u32 {
        let access_power = (self.bandwidth * self.memory_access_power) / 100
        let active_percent = 100 - self.idle_time
        return (access_power * active_percent) / 100 + 5
    }

    fn get_bandwidth_power(&self, mb_per_sec: u32) -> u32 {
        return (mb_per_sec * self.memory_access_power) / 100
    }
}

// ============ Duty Cycle Pattern (간헐적 작업) ============

struct DutyCyclePattern {
    active_power: u32,      // mW
    idle_power: u32,        // mW
    cycle_period: u32,      // ms
    duty_cycle: u32,        // percent (0-100)
}

impl DutyCyclePattern {
    fn new(duty: u32) -> DutyCyclePattern {
        return DutyCyclePattern {
            active_power: 200,
            idle_power: 5,
            cycle_period: 1000,
            duty_cycle: duty,
        }
    }

    fn get_average_power(&self) -> u32 {
        let active = (self.active_power * self.duty_cycle) / 100
        let idle = (self.idle_power * (100 - self.duty_cycle)) / 100
        return active + idle
    }

    fn get_active_time(&self) -> u32 {
        return (self.cycle_period * self.duty_cycle) / 100
    }

    fn get_idle_time(&self) -> u32 {
        return (self.cycle_period * (100 - self.duty_cycle)) / 100
    }
}

// ============ Memory Pattern (메모리 대역폭 최적화) ============

struct MemoryPattern {
    data_width: u32,        // bits
    access_rate: u32,       // accesses/sec
    cache_level: u32,       // L1/L2/L3 (1/2/3)
    prefetch_enabled: bool,
}

impl MemoryPattern {
    fn new() -> MemoryPattern {
        return MemoryPattern {
            data_width: 64,
            access_rate: 1000000,
            cache_level: 1,
            prefetch_enabled: true,
        }
    }

    fn get_power_consumption(&self) -> u32 {
        let base = 20 as u32
        let access_power = (self.access_rate / 100000) * 2
        let cache_level_power = if self.cache_level == 1 { 5 } else if self.cache_level == 2 { 10 } else { 20 }
        let prefetch_power = if self.prefetch_enabled { 2 } else { 0 }
        return base + access_power + cache_level_power + prefetch_power
    }
}

// ============ Network Pattern (네트워크 통신) ============

struct NetworkPattern {
    throughput: u32,        // Mbps
    latency: u32,           // ms
    power_per_mbps: u32,    // mW per Mbps
    radio_type: u32,        // 0=WiFi, 1=BLE, 2=LTE
}

impl NetworkPattern {
    fn new(radio: u32) -> NetworkPattern {
        return NetworkPattern {
            throughput: 10,
            latency: 100,
            power_per_mbps: match radio { 0 => 10, 1 => 2, 2 => 20, _ => 10 },
            radio_type: radio,
        }
    }

    fn get_power_consumption(&self) -> u32 {
        let tx_power = (self.throughput * self.power_per_mbps) / 100
        let idle = if self.radio_type == 1 { 1 } else if self.radio_type == 2 { 30 } else { 5 }
        return tx_power + idle
    }
}

// ============ Mixed Pattern (복합 작업) ============

struct MixedPattern {
    compute_ratio: u32,     // percent
    io_ratio: u32,          // percent
    network_ratio: u32,     // percent
    thermal_ratio: u32,     // percent
}

impl MixedPattern {
    fn new() -> MixedPattern {
        return MixedPattern {
            compute_ratio: 40,
            io_ratio: 30,
            network_ratio: 20,
            thermal_ratio: 10,
        }
    }

    fn get_total_power(&self) -> u32 {
        let compute = (60 * self.compute_ratio) / 100
        let io = (30 * self.io_ratio) / 100
        let network = (20 * self.network_ratio) / 100
        let thermal = (30 * self.thermal_ratio) / 100
        return compute + io + network + thermal + 10
    }
}

// ============ Power Pattern Library ============

struct PowerPatternLibrary {
    patterns: PowerPattern[],
    thermal: ThermalPattern,
    compute: ComputePattern,
    io: IOPattern,
    network: NetworkPattern,
    mixed: MixedPattern,
}

impl PowerPatternLibrary {
    fn new() -> PowerPatternLibrary {
        return PowerPatternLibrary {
            patterns: [],
            thermal: ThermalPattern::new(),
            compute: ComputePattern::new(),
            io: IOPattern::new(),
            network: NetworkPattern::new(0),
            mixed: MixedPattern::new(),
        }
    }

    fn add_thermal_pattern(&mut self) -> bool {
        let mut p = PowerPattern::new(PatternType::Thermal, "Thermal-Heavy")
        p.set_power(400, 800, 20)
        self.patterns.push(p)
        return true
    }

    fn add_compute_pattern(&mut self) -> bool {
        let mut p = PowerPattern::new(PatternType::Compute, "CPU-Intensive")
        p.set_power(self.compute.get_power_consumption(), 150, 10)
        self.patterns.push(p)
        return true
    }

    fn add_io_pattern(&mut self) -> bool {
        let mut p = PowerPattern::new(PatternType::IO, "Memory-Bound")
        p.set_power(self.io.get_power_consumption(), 80, 5)
        self.patterns.push(p)
        return true
    }

    fn add_duty_cycle_pattern(&mut self, cycle: u32) -> bool {
        let mut p = PowerPattern::new(PatternType::DutyCycle, "DutyCycle")
        let duty = DutyCyclePattern::new(cycle)
        p.set_power(duty.get_average_power(), 200, 5)
        p.duty_cycle = cycle
        self.patterns.push(p)
        return true
    }

    fn add_memory_pattern(&mut self) -> bool {
        let mut p = PowerPattern::new(PatternType::Memory, "Memory-Access")
        let mem = MemoryPattern::new()
        p.set_power(mem.get_power_consumption(), 50, 2)
        self.patterns.push(p)
        return true
    }

    fn add_network_pattern(&mut self, radio_type: u32) -> bool {
        let mut p = PowerPattern::new(PatternType::Network, "Network-TX")
        let net = NetworkPattern::new(radio_type)
        p.set_power(net.get_power_consumption(), 100, 5)
        self.patterns.push(p)
        return true
    }

    fn add_mixed_pattern(&mut self) -> bool {
        let mut p = PowerPattern::new(PatternType::Mixed, "Mixed-Workload")
        p.set_power(self.mixed.get_total_power(), 200, 15)
        self.patterns.push(p)
        return true
    }

    fn add_burst_pattern(&mut self) -> bool {
        let mut p = PowerPattern::new(PatternType::Burst, "Burst-Short")
        p.set_power(100, 500, 5)
        p.duration = 100
        self.patterns.push(p)
        return true
    }

    fn add_continuous_pattern(&mut self) -> bool {
        let mut p = PowerPattern::new(PatternType::Continuous, "Continuous")
        p.set_power(150, 200, 50)
        p.duration = 3600
        self.patterns.push(p)
        return true
    }

    fn add_interrupt_pattern(&mut self) -> bool {
        let mut p = PowerPattern::new(PatternType::Interrupt, "Interrupt-Handler")
        p.set_power(50, 300, 2)
        p.duration = 10
        self.patterns.push(p)
        return true
    }

    fn add_sleep_pattern(&mut self) -> bool {
        let mut p = PowerPattern::new(PatternType::Sleep, "Sleep-Mode")
        p.set_power(1, 10, 1)
        p.duration = 1800
        self.patterns.push(p)
        return true
    }

    fn pattern_count(&self) -> u32 {
        return self.patterns.len() as u32
    }

    fn get_pattern(&self, index: u32) -> PowerPattern {
        if (index as usize) < self.patterns.len() {
            return self.patterns[index as usize]
        }
        return PowerPattern::new(PatternType::Idle, "none")
    }

    fn has_pattern_type(&self, ptype: PatternType) -> bool {
        for pattern in self.patterns {
            if pattern.pattern_type == ptype {
                return true
            }
        }
        return false
    }

    fn get_all_patterns(&self) -> PowerPattern[] {
        return self.patterns
    }

    fn get_total_energy(&self, seconds: u32) -> u32 {
        let mut total = 0 as u32
        for pattern in self.patterns {
            total += pattern.calculate_energy(seconds)
        }
        return total
    }

    fn stats(&self) -> string {
        let mut s = ""
        s = s + "Power Pattern Library:\n"
        s = s + "Total patterns: " + self.pattern_count().to_string() + "\n"
        s = s + "Thermal: " + (if self.thermal.base_power > 0 { "enabled" } else { "disabled" }) + "\n"
        s = s + "Compute: " + self.compute.get_power_consumption().to_string() + "mW\n"
        s = s + "I/O: " + self.io.get_power_consumption().to_string() + "mW"
        return s
    }
}

