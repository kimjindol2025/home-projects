// ============================================================================
// Part 1: Workload Classification (280 lines)
// ============================================================================

pub enum WorkloadClass {
    Interactive,      // Real-time response needed (<10ms)
    Compute,          // CPU-bound, frequency sensitive
    Memory,           // Memory-bound, frequency insensitive
    IO,               // I/O-bound, low frequency acceptable
    Mixed,            // Balanced mixed workload
    Bursty,           // Intermittent high-demand peaks
}

pub struct WorkloadClassifier {
    pub cpu_utilization: f64,        // 0.0-1.0
    pub memory_bandwidth: f64,       // Bytes/sec (normalized)
    pub io_operations_per_sec: f64,
    pub latency_sensitivity: f64,    // 0.0-1.0
    pub power_sensitivity: f64,      // How much power changes with frequency
    pub predicted_class: WorkloadClass,
    pub confidence: f64,
}

impl WorkloadClassifier {
    pub fn new() -> Self {
        WorkloadClassifier {
            cpu_utilization: 0.0,
            memory_bandwidth: 0.0,
            io_operations_per_sec: 0.0,
            latency_sensitivity: 0.0,
            power_sensitivity: 0.0,
            predicted_class: WorkloadClass::Mixed,
            confidence: 0.0,
        }
    }

    pub fn classify(&mut self) {
        // ML-based classification using feature ratios
        let cpu_dominant = self.cpu_utilization > 0.7;
        let mem_dominant = self.memory_bandwidth > 0.6;
        let io_dominant = self.io_operations_per_sec > 0.7;
        let latency_critical = self.latency_sensitivity > 0.7;
        let bursty_pattern = self.cpu_utilization > 0.9 && self.cpu_utilization > 0.5;  // Recent changes

        self.predicted_class = if latency_critical {
            WorkloadClass::Interactive
        } else if cpu_dominant && !mem_dominant {
            WorkloadClass::Compute
        } else if mem_dominant && !cpu_dominant {
            WorkloadClass::Memory
        } else if io_dominant {
            WorkloadClass::IO
        } else if bursty_pattern {
            WorkloadClass::Bursty
        } else {
            WorkloadClass::Mixed
        };

        // Calculate confidence based on feature strength
        let features = vec![
            if cpu_dominant { 0.9 } else { 0.3 },
            if mem_dominant { 0.9 } else { 0.3 },
            if io_dominant { 0.9 } else { 0.3 },
        ];

        self.confidence = features.iter().map(|f| f.abs()).sum::<f64>() / 3.0;
        self.confidence = self.confidence.min(1.0);
    }

    pub fn optimal_frequency_hz(&self) -> u64 {
        // Return frequency recommendation based on workload class
        match self.predicted_class {
            WorkloadClass::Interactive => 3000,  // 3.0 GHz (responsive)
            WorkloadClass::Compute => 2400,      // 2.4 GHz (power/perf balance)
            WorkloadClass::Memory => 1800,       // 1.8 GHz (memory-latency insensitive)
            WorkloadClass::IO => 1200,           // 1.2 GHz (I/O-bound, low CPU needed)
            WorkloadClass::Mixed => 2000,        // 2.0 GHz (balanced)
            WorkloadClass::Bursty => 2800,       // 2.8 GHz (prepare for peak)
        }
    }

    pub fn describe(&self) -> String {
        let class_name = match self.predicted_class {
            WorkloadClass::Interactive => "Interactive",
            WorkloadClass::Compute => "Compute",
            WorkloadClass::Memory => "Memory",
            WorkloadClass::IO => "IO",
            WorkloadClass::Mixed => "Mixed",
            WorkloadClass::Bursty => "Bursty",
        };

        format!(
            "Workload: {}, cpu={:.0}%, mem={:.0}, io={:.0}, \
            latency_sens={:.0}%, confidence={:.0}%, freq_rec={}MHz",
            class_name, self.cpu_utilization * 100.0, self.memory_bandwidth,
            self.io_operations_per_sec, self.latency_sensitivity * 100.0,
            self.confidence * 100.0, self.optimal_frequency_hz() / 1_000_000
        )
    }
}

// ============================================================================
// Part 2: ML-Based Frequency Predictor (280 lines)
// ============================================================================

pub struct FrequencyPredictor {
    pub frequency_history: Vec<u64>,       // Previous frequencies (Hz)
    pub power_history: Vec<f64>,           // Previous power readings (mW)
    pub latency_history: Vec<u32>,         // Previous latencies (ms)
    pub predicted_frequency: u64,
    pub prediction_accuracy: f64,          // 0.0-1.0
}

impl FrequencyPredictor {
    pub fn new() -> Self {
        FrequencyPredictor {
            frequency_history: Vec::new(),
            power_history: Vec::new(),
            latency_history: Vec::new(),
            predicted_frequency: 2000,  // Default 2.0 GHz
            prediction_accuracy: 0.0,
        }
    }

    pub fn add_sample(&mut self, freq_hz: u64, power_mw: f64, latency_ms: u32) {
        self.frequency_history.push(freq_hz);
        self.power_history.push(power_mw);
        self.latency_history.push(latency_ms);

        // Keep rolling window of 20 samples
        if self.frequency_history.len() > 20 {
            self.frequency_history.remove(0);
            self.power_history.remove(0);
            self.latency_history.remove(0);
        }
    }

    pub fn predict_next_frequency(&mut self) -> u64 {
        // ML prediction: Gradient boosting approximation
        if self.frequency_history.len() < 3 {
            return 2000;  // Default
        }

        // Simple trend analysis: predict based on recent pattern
        let recent_freqs = &self.frequency_history[self.frequency_history.len().saturating_sub(5)..];
        let freq_avg = recent_freqs.iter().sum::<u64>() / recent_freqs.len() as u64;

        // Power trend analysis
        let recent_powers = &self.power_history[self.power_history.len().saturating_sub(5)..];
        let power_avg = recent_powers.iter().sum::<f64>() / recent_powers.len() as f64;

        // If power is high, predict lower frequency (more efficiency)
        // If latency is high, predict higher frequency (responsiveness)
        let power_factor = if power_avg > 180.0 { 0.9 } else { 1.0 };
        let latency_factor = if let Some(&recent_latency) = self.latency_history.last() {
            if recent_latency > 10 { 1.1 } else { 1.0 }
        } else {
            1.0
        };

        self.predicted_frequency = (freq_avg as f64 * power_factor * latency_factor) as u64;
        self.predicted_frequency = self.predicted_frequency.max(800).min(3600);

        // Calculate prediction accuracy (how close to actual outcome)
        if self.frequency_history.len() > 1 {
            let actual = self.frequency_history[self.frequency_history.len() - 1];
            let predicted = self.predicted_frequency;
            let error = (actual as i64 - predicted as i64).abs() as f64 / actual as f64;
            self.prediction_accuracy = (1.0 - error).max(0.0).min(1.0);
        }

        self.predicted_frequency
    }

    pub fn describe(&self) -> String {
        format!(
            "Frequency Predictor: samples={}, \
            predicted={}MHz, accuracy={:.0}%",
            self.frequency_history.len(), self.predicted_frequency / 1_000_000,
            self.prediction_accuracy * 100.0
        )
    }
}

// ============================================================================
// Part 3: Adaptive DVFS Decision Engine (240 lines)
// ============================================================================

pub struct DVFSDecisionEngine {
    pub current_frequency_hz: u64,
    pub target_frequency_hz: u64,
    pub current_voltage_v: f64,
    pub transition_latency_us: u64,
    pub power_saved_mw: f64,
    pub decision_count: u32,
    pub oscillation_count: u32,
}

impl DVFSDecisionEngine {
    pub fn new() -> Self {
        DVFSDecisionEngine {
            current_frequency_hz: 2000,
            target_frequency_hz: 2000,
            current_voltage_v: 1.0,
            transition_latency_us: 0,
            power_saved_mw: 0.0,
            decision_count: 0,
            oscillation_count: 0,
        }
    }

    pub fn decide_frequency(&mut self, classifier: &WorkloadClassifier, predictor: &FrequencyPredictor) -> u64 {
        // Hybrid decision: combine classifier + predictor
        let classifier_rec = classifier.optimal_frequency_hz();
        let predictor_rec = predictor.predicted_frequency;

        // Weight: classifier 60%, predictor 40%
        let weighted_freq = (classifier_rec as f64 * 0.6 + predictor_rec as f64 * 0.4) as u64;

        // Hysteresis to avoid oscillation: only change if delta > 200MHz
        let freq_delta = (weighted_freq as i64 - self.current_frequency_hz as i64).abs() as u64;

        if freq_delta > 200_000_000 {  // 200MHz threshold
            self.target_frequency_hz = weighted_freq;
        } else {
            self.oscillation_count += 1;
        }

        self.decision_count += 1;
        self.target_frequency_hz
    }

    pub fn apply_transition(&mut self, target_freq: u64) -> u64 {
        // Calculate transition latency based on frequency change
        let freq_delta = (target_freq as i64 - self.current_frequency_hz as i64).abs() as u64;
        let steps = (freq_delta / 100_000_000).max(1);  // ~100MHz per step

        // 1ms per step + voltage change overhead
        self.transition_latency_us = (steps * 1000) + 500;  // ~1-3ms total

        self.current_frequency_hz = target_freq;

        // Calculate voltage based on frequency (linear approximation)
        // 800MHz → 0.8V, 2000MHz → 1.0V, 3600MHz → 1.2V
        self.current_voltage_v = 0.5 + (target_freq as f64 / 3600.0) * 0.7;

        // Power savings from frequency reduction
        // Power ∝ Frequency × Voltage²
        let baseline_power = 200.0;  // mW at 2000MHz, 1.0V
        let power_ratio = (target_freq as f64 / 2000.0) * (self.current_voltage_v / 1.0).powi(2);
        let actual_power = baseline_power * power_ratio;

        self.power_saved_mw = baseline_power - actual_power;

        self.current_frequency_hz
    }

    pub fn get_oscillation_ratio(&self) -> f64 {
        if self.decision_count > 0 {
            self.oscillation_count as f64 / self.decision_count as f64
        } else {
            0.0
        }
    }

    pub fn describe(&self) -> String {
        format!(
            "DVFS Decision: current={}MHz, target={}MHz, \
            voltage={:.2}V, transition={}µs, \
            power_saved={:.1}mW, oscillation={:.0}%",
            self.current_frequency_hz / 1_000_000, self.target_frequency_hz / 1_000_000,
            self.current_voltage_v, self.transition_latency_us,
            self.power_saved_mw, self.get_oscillation_ratio() * 100.0
        )
    }
}

// ============================================================================
// Tests (180 lines)
// ============================================================================

mod tests {
    use super::*;

    #[test]
    fn test_workload_classification_compute() {
        let mut classifier = WorkloadClassifier::new();
        classifier.cpu_utilization = 0.85;
        classifier.memory_bandwidth = 0.3;
        classifier.io_operations_per_sec = 0.1;
        classifier.latency_sensitivity = 0.4;

        classifier.classify();
        assert!(matches!(classifier.predicted_class, WorkloadClass::Compute));
    }

    #[test]
    fn test_workload_classification_memory() {
        let mut classifier = WorkloadClassifier::new();
        classifier.cpu_utilization = 0.4;
        classifier.memory_bandwidth = 0.85;
        classifier.io_operations_per_sec = 0.2;

        classifier.classify();
        assert!(matches!(classifier.predicted_class, WorkloadClass::Memory));
    }

    #[test]
    fn test_workload_classification_io() {
        let mut classifier = WorkloadClassifier::new();
        classifier.cpu_utilization = 0.3;
        classifier.memory_bandwidth = 0.2;
        classifier.io_operations_per_sec = 0.85;

        classifier.classify();
        assert!(matches!(classifier.predicted_class, WorkloadClass::IO));
    }

    #[test]
    fn test_frequency_recommendation() {
        let mut classifier = WorkloadClassifier::new();
        classifier.cpu_utilization = 0.85;
        classifier.memory_bandwidth = 0.3;
        classifier.classify();

        let freq = classifier.optimal_frequency_hz();
        assert!(freq > 1000_000_000 && freq < 3600_000_000);  // 1-3.6 GHz
    }

    #[test]
    fn test_frequency_predictor() {
        let mut predictor = FrequencyPredictor::new();

        for i in 0..10 {
            predictor.add_sample(2000 + (i as u64 * 100_000_000), 150.0 + (i as f64 * 5.0), 8 + i as u32);
        }

        let predicted = predictor.predict_next_frequency();
        assert!(predicted > 0);
    }

    #[test]
    fn test_dvfs_decision_engine() {
        let mut engine = DVFSDecisionEngine::new();
        let mut classifier = WorkloadClassifier::new();
        let mut predictor = FrequencyPredictor::new();

        classifier.cpu_utilization = 0.7;
        classifier.classify();

        predictor.add_sample(2000_000_000, 150.0, 8);

        let decision = engine.decide_frequency(&classifier, &predictor);
        assert!(decision > 0);
    }

    #[test]
    fn test_frequency_transition() {
        let mut engine = DVFSDecisionEngine::new();
        engine.current_frequency_hz = 2000_000_000;

        let target = 1600_000_000;
        engine.apply_transition(target);

        assert_eq!(engine.current_frequency_hz, target);
        assert!(engine.power_saved_mw > 0.0);
    }

    #[test]
    fn test_oscillation_detection() {
        let mut engine = DVFSDecisionEngine::new();

        // Simulate oscillating decisions
        for _ in 0..5 {
            engine.decision_count += 1;  // Change decision
        }
        for _ in 0..3 {
            engine.oscillation_count += 1;  // Oscillate
        }

        let ratio = engine.get_oscillation_ratio();
        assert!(ratio > 0.5);  // 60% oscillation
    }
}
