// Layer 5: Energy Pattern Database (축약)
use std::collections::VecDeque;

pub struct EnergyHistoryEntry {
    pub id: u64,
    pub pattern_type: String,
    pub power_before_mw: f64,
    pub power_after_mw: f64,
    pub success: bool,
}

pub struct EnergyPatternDB {
    pub entries: VecDeque<EnergyHistoryEntry>,
    pub max_size: usize,
}

impl EnergyPatternDB {
    pub fn new() -> Self {
        EnergyPatternDB {
            entries: VecDeque::new(),
            max_size: 1000,
        }
    }

    pub fn record(&mut self, entry: EnergyHistoryEntry) {
        self.entries.push_back(entry);
        if self.entries.len() > self.max_size {
            self.entries.pop_front();
        }
    }

    pub fn total_savings_mw(&self) -> f64 {
        self.entries.iter()
            .map(|e| if e.success { e.power_before_mw - e.power_after_mw } else { 0.0 })
            .sum()
    }
}

mod tests {
    use super::*;
    #[test]
    fn test_db() {
        let mut db = EnergyPatternDB::new();
        let e = EnergyHistoryEntry {
            id: 1,
            pattern_type: "PowerSpike".to_string(),
            power_before_mw: 200.0,
            power_after_mw: 150.0,
            success: true,
        };
        db.record(e);
        assert!(db.total_savings_mw() > 0.0);
    }
}
