// Phase 5: Wearable Integration Module

pub mod wearable_sensor;
pub mod hw_secure_storage;
pub mod pqc_crypto;
pub mod wearable_authenticator;

pub use wearable_sensor::{
    WearableDeviceType, WearableDevice, SensorReading, WearableSensorHub,
};
pub use hw_secure_storage::{
    SecureEnclaveType, AttestedKey, HwSecureStorage,
};
pub use pqc_crypto::{
    LatticeParams, LatticeKey, PqcPublicKey, PqcPrivateKey, PqcCrypto,
};
pub use wearable_authenticator::{
    WearableAuthConfig, WearableAuthResult, WearableAuthenticator,
};

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_wearable_module_integration() {
        let device = WearableDevice {
            device_id: "test_device".to_string(),
            device_type: WearableDeviceType::SmartWatch,
            connection: "BLE".to_string(),
            battery_level: 80,
            firmware_version: "1.0.0".to_string(),
            is_connected: false,
        };

        assert_eq!(device.device_id, "test_device");
        assert_eq!(device.device_type, WearableDeviceType::SmartWatch);
    }

    #[test]
    fn test_pqc_integration() {
        let pqc = PqcCrypto::new();
        let (pk, sk) = pqc.generate_keypair();
        let (ct, ss) = pqc.encapsulate(&pk);
        let recovered_ss = pqc.decapsulate(&sk, &ct).unwrap();

        assert_eq!(ss, recovered_ss);
    }

    #[test]
    fn test_hw_secure_storage_integration() {
        let mut storage = HwSecureStorage::new(SecureEnclaveType::SoftwareSim);
        let secret = [42u8; 32].to_vec();

        storage.store_master_secret("user001", &secret).ok();
        let token = storage.generate_auth_token("user001");
        let recovered = storage.retrieve_master_secret("user001", &token).unwrap();

        assert_eq!(recovered, secret);
    }
}
