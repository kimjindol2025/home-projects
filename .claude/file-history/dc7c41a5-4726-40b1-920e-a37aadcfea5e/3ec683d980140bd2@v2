// Purpose: Identify power consumption bottlenecks and critical paths
// Strategy: Temporal analysis, cross-layer correlation, anomaly detection

// ============================================================================
// Part 1: Bottleneck Detection (250 lines)
// ============================================================================

pub enum BottleneckType {
    CPUIntensive,
    MemoryBound,
    IOBound,
    ThermalLimited,
    NetworkBound,
    ConsensusBlocked,
    PatternMisclassified,
}

pub struct Bottleneck {
    pub bottleneck_type: BottleneckType,
    pub layer: String,
    pub start_time_ms: u64,
    pub duration_ms: u64,
    pub power_impact_mw: f64,
    pub frequency_hz: f64,           // How often this bottleneck occurs
    pub severity_score: f64,         // 0.0-1.0
}

impl Bottleneck {
    pub fn new(btype: BottleneckType, layer: String) -> Self {
        Bottleneck {
            bottleneck_type: btype,
            layer,
            start_time_ms: 0,
            duration_ms: 0,
            power_impact_mw: 0.0,
            frequency_hz: 0.0,
            severity_score: 0.0,
        }
    }

    pub fn calculate_severity(&mut self) {
        // Severity = (power_impact / total_power) × frequency × duration_factor
        let power_factor = (self.power_impact_mw / 200.0).min(1.0);  // Normalized to 200mW max
        let frequency_factor = (self.frequency_hz / 5.0).min(1.0);    // Normalized to 5Hz
        let duration_factor = if self.duration_ms > 1000 { 1.0 } else {
            self.duration_ms as f64 / 1000.0
        };

        self.severity_score = power_factor * frequency_factor * duration_factor;
    }

    pub fn is_critical(&self) -> bool {
        self.severity_score > 0.7  // >70% severity = critical
    }

    pub fn describe(&self) -> String {
        let type_name = match self.bottleneck_type {
            BottleneckType::CPUIntensive => "CPUIntensive",
            BottleneckType::MemoryBound => "MemoryBound",
            BottleneckType::IOBound => "IOBound",
            BottleneckType::ThermalLimited => "ThermalLimited",
            BottleneckType::NetworkBound => "NetworkBound",
            BottleneckType::ConsensusBlocked => "ConsensusBlocked",
            BottleneckType::PatternMisclassified => "PatternMisclassified",
        };

        format!(
            "{}: {} (layer={}, power_impact={:.0}mW, frequency={:.1}Hz, \
            duration={}ms, severity={:.2}, critical={})",
            type_name, self.layer, self.layer, self.power_impact_mw,
            self.frequency_hz, self.duration_ms, self.severity_score,
            if self.is_critical() { "YES" } else { "NO" }
        )
    }
}

// ============================================================================
// Part 2: Bottleneck Detection Engine (280 lines)
// ============================================================================

pub struct BottleneckDetector {
    pub power_readings: Vec<f64>,
    pub timestamps_ms: Vec<u64>,
    pub cpu_utilization: Vec<f64>,
    pub memory_pressure: Vec<f64>,
    pub network_traffic: Vec<f64>,
    pub thermal_levels: Vec<f64>,
    pub detected_bottlenecks: Vec<Bottleneck>,
}

impl BottleneckDetector {
    pub fn new() -> Self {
        BottleneckDetector {
            power_readings: Vec::new(),
            timestamps_ms: Vec::new(),
            cpu_utilization: Vec::new(),
            memory_pressure: Vec::new(),
            network_traffic: Vec::new(),
            thermal_levels: Vec::new(),
            detected_bottlenecks: Vec::new(),
        }
    }

    pub fn add_sample(&mut self, power_mw: f64, timestamp_ms: u64,
                     cpu_util: f64, mem_pressure: f64,
                     network: f64, thermal: f64) {
        self.power_readings.push(power_mw);
        self.timestamps_ms.push(timestamp_ms);
        self.cpu_utilization.push(cpu_util);
        self.memory_pressure.push(mem_pressure);
        self.network_traffic.push(network);
        self.thermal_levels.push(thermal);
    }

    pub fn detect_cpu_bottleneck(&mut self) {
        // CPU-intensive: high power + high CPU utilization, low memory
        for i in 1..self.power_readings.len() {
            if self.power_readings[i] > 150.0 &&
               self.cpu_utilization[i] > 0.8 &&
               self.memory_pressure[i] < 0.5 {

                let mut bottleneck = Bottleneck::new(
                    BottleneckType::CPUIntensive,
                    "L2_GreenScheduler".to_string()
                );
                bottleneck.power_impact_mw = self.power_readings[i];
                bottleneck.start_time_ms = self.timestamps_ms[i];
                bottleneck.duration_ms = 100;  // Assume 100ms duration
                bottleneck.frequency_hz = 1.0;
                bottleneck.calculate_severity();

                self.detected_bottlenecks.push(bottleneck);
            }
        }
    }

    pub fn detect_memory_bottleneck(&mut self) {
        // Memory-bound: moderate power + high memory pressure
        for i in 1..self.power_readings.len() {
            if self.memory_pressure[i] > 0.8 &&
               self.power_readings[i] > 120.0 {

                let mut bottleneck = Bottleneck::new(
                    BottleneckType::MemoryBound,
                    "L1_PowerSensing".to_string()
                );
                bottleneck.power_impact_mw = self.power_readings[i] * 0.3;
                bottleneck.start_time_ms = self.timestamps_ms[i];
                bottleneck.duration_ms = 50;
                bottleneck.frequency_hz = 2.0;
                bottleneck.calculate_severity();

                self.detected_bottlenecks.push(bottleneck);
            }
        }
    }

    pub fn detect_io_bottleneck(&mut self) {
        // I/O-bound: high network traffic + moderate power increase
        for i in 1..self.power_readings.len() {
            if self.network_traffic[i] > 0.7 &&
               self.power_readings[i] > 130.0 {

                let mut bottleneck = Bottleneck::new(
                    BottleneckType::IOBound,
                    "L4_GreenConsensus".to_string()
                );
                bottleneck.power_impact_mw = self.power_readings[i] * 0.4;
                bottleneck.start_time_ms = self.timestamps_ms[i];
                bottleneck.duration_ms = 200;
                bottleneck.frequency_hz = 0.5;
                bottleneck.calculate_severity();

                self.detected_bottlenecks.push(bottleneck);
            }
        }
    }

    pub fn detect_thermal_bottleneck(&mut self) {
        // Thermal-limited: high temperature + power reduction
        for i in 1..self.power_readings.len() {
            if self.thermal_levels[i] > 0.85 {
                let power_reduction = if i > 0 {
                    (self.power_readings[i-1] - self.power_readings[i]).max(0.0)
                } else {
                    0.0
                };

                if power_reduction > 20.0 {
                    let mut bottleneck = Bottleneck::new(
                        BottleneckType::ThermalLimited,
                        "L2_GreenScheduler".to_string()
                    );
                    bottleneck.power_impact_mw = power_reduction;
                    bottleneck.start_time_ms = self.timestamps_ms[i];
                    bottleneck.duration_ms = 500;
                    bottleneck.frequency_hz = 0.2;
                    bottleneck.calculate_severity();

                    self.detected_bottlenecks.push(bottleneck);
                }
            }
        }
    }

    pub fn detect_network_bottleneck(&mut self) {
        // Network-bound: high network traffic + consensus latency
        for i in 1..self.power_readings.len() {
            if self.network_traffic[i] > 0.9 {
                let mut bottleneck = Bottleneck::new(
                    BottleneckType::NetworkBound,
                    "L4_GreenConsensus".to_string()
                );
                bottleneck.power_impact_mw = self.power_readings[i] * 0.5;
                bottleneck.start_time_ms = self.timestamps_ms[i];
                bottleneck.duration_ms = 150;
                bottleneck.frequency_hz = 1.0;
                bottleneck.calculate_severity();

                self.detected_bottlenecks.push(bottleneck);
            }
        }
    }

    pub fn detect_all_bottlenecks(&mut self) {
        self.detect_cpu_bottleneck();
        self.detect_memory_bottleneck();
        self.detect_io_bottleneck();
        self.detect_thermal_bottleneck();
        self.detect_network_bottleneck();

        // Sort by severity
        self.detected_bottlenecks.sort_by(|a, b| {
            b.severity_score.partial_cmp(&a.severity_score).unwrap()
        });
    }

    pub fn get_critical_bottlenecks(&self) -> Vec<&Bottleneck> {
        self.detected_bottlenecks.iter()
            .filter(|b| b.is_critical())
            .collect()
    }

    pub fn bottleneck_count(&self) -> usize {
        self.detected_bottlenecks.len()
    }

    pub fn average_severity(&self) -> f64 {
        if self.detected_bottlenecks.is_empty() {
            return 0.0;
        }

        self.detected_bottlenecks.iter()
            .map(|b| b.severity_score)
            .sum::<f64>() / self.detected_bottlenecks.len() as f64
    }

    pub fn summary(&self) -> String {
        format!(
            "Bottleneck Detection: {} bottlenecks found, {} critical, \
            avg_severity={:.2}",
            self.bottleneck_count(),
            self.get_critical_bottlenecks().len(),
            self.average_severity()
        )
    }
}

// ============================================================================
// Part 3: Critical Path Analysis (180 lines)
// ============================================================================

pub struct CriticalPath {
    pub path_components: Vec<String>,
    pub total_latency_us: u64,
    pub bottleneck_latency_us: u64,
    pub slack_us: u64,
}

impl CriticalPath {
    pub fn new() -> Self {
        CriticalPath {
            path_components: Vec::new(),
            total_latency_us: 0,
            bottleneck_latency_us: 0,
            slack_us: 0,
        }
    }

    pub fn add_component(&mut self, name: String, latency_us: u64) {
        self.path_components.push(name);
        self.total_latency_us += latency_us;

        // Bottleneck component is the one with highest latency
        if latency_us > self.bottleneck_latency_us {
            self.bottleneck_latency_us = latency_us;
        }
    }

    pub fn calculate_slack(&mut self, deadline_us: u64) {
        if self.total_latency_us < deadline_us {
            self.slack_us = deadline_us - self.total_latency_us;
        } else {
            self.slack_us = 0;
        }
    }

    pub fn bottleneck_percentage(&self) -> f64 {
        if self.total_latency_us > 0 {
            (self.bottleneck_latency_us as f64 / self.total_latency_us as f64) * 100.0
        } else {
            0.0
        }
    }

    pub fn is_on_critical_path(&self) -> bool {
        self.slack_us == 0  // No slack means on critical path
    }

    pub fn describe(&self) -> String {
        format!(
            "Critical Path: total={}µs, bottleneck={}µs ({:.0}%), \
            slack={}µs, components={}",
            self.total_latency_us, self.bottleneck_latency_us,
            self.bottleneck_percentage(), self.slack_us,
            self.path_components.len()
        )
    }
}

// ============================================================================
// Tests (100 lines)
// ============================================================================

mod tests {
    use super::*;

    #[test]
    fn test_bottleneck_creation() {
        let bn = Bottleneck::new(BottleneckType::CPUIntensive, "L2".to_string());
        assert_eq!(bn.severity_score, 0.0);
    }

    #[test]
    fn test_bottleneck_severity_calculation() {
        let mut bn = Bottleneck::new(BottleneckType::CPUIntensive, "L2".to_string());
        bn.power_impact_mw = 100.0;
        bn.frequency_hz = 2.0;
        bn.duration_ms = 1000;
        bn.calculate_severity();

        assert!(bn.severity_score > 0.0);
    }

    #[test]
    fn test_detector_cpu_bottleneck() {
        let mut detector = BottleneckDetector::new();

        for i in 0..10 {
            detector.add_sample(
                150.0 + (i as f64),  // power
                (i as u64) * 100,     // timestamp
                0.9,                   // cpu_util
                0.3,                   // mem_pressure
                0.5,                   // network
                0.5                    // thermal
            );
        }

        detector.detect_cpu_bottleneck();
        assert!(detector.bottleneck_count() > 0);
    }

    #[test]
    fn test_detector_thermal_bottleneck() {
        let mut detector = BottleneckDetector::new();

        for i in 0..10 {
            detector.add_sample(
                200.0 - (i as f64 * 5.0),  // power decreasing
                (i as u64) * 100,
                0.5,
                0.5,
                0.5,
                0.9 + (i as f64 * 0.01)     // thermal increasing
            );
        }

        detector.detect_thermal_bottleneck();
        assert!(detector.bottleneck_count() >= 0);
    }

    #[test]
    fn test_critical_path_analysis() {
        let mut path = CriticalPath::new();
        path.add_component("L1".to_string(), 5000);
        path.add_component("L2".to_string(), 3000);
        path.add_component("L3".to_string(), 2000);

        assert_eq!(path.total_latency_us, 10000);
        assert_eq!(path.bottleneck_latency_us, 5000);
    }

    #[test]
    fn test_critical_path_slack() {
        let mut path = CriticalPath::new();
        path.add_component("A".to_string(), 1000);
        path.add_component("B".to_string(), 1000);
        path.calculate_slack(2500);

        assert_eq!(path.slack_us, 500);
    }
}
