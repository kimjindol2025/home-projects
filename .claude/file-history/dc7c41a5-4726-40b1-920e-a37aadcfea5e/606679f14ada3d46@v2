#[cfg(test)]
mod unforgiving_rules {
    use super::*;

    #[test]
    fn rule_1_far_requirement() {
        // Rule 1: FAR < 0.0001% (1 in 1,000,000)
        let mut engine = AuthenticationEngine::new("user_far_001".to_string());

        let genuine = vec![KeystrokeSignal {
            key: 'a',
            timestamp: 0,
            press_duration: 50,
            flight_time: 100,
            pressure: 0.7,
        }];

        engine.enroll(&genuine, &[], &[]);

        // 본인 인증
        for _ in 0..10 {
            engine.authenticate(&genuine, &[], &[], true);
        }

        // 타인 거부 (0 오류 = FAR 0%)
        let impostor = vec![KeystrokeSignal {
            key: 'z',
            timestamp: 0,
            press_duration: 80,
            flight_time: 200,
            pressure: 0.3,
        }];

        for _ in 0..100 {
            engine.authenticate(&impostor, &[], &[], false);
        }

        assert!(engine.far_compliance());

        println!(
            "✅ RULE 1 PASS: FAR < 0.0001% (actual: {:.6}%)",
            engine.get_metrics().false_acceptance_rate * 100.0
        );
    }

    #[test]
    fn rule_2_frr_requirement() {
        // Rule 2: FRR < 1% (본인 중 99% 이상 인증)
        let mut engine = AuthenticationEngine::new("user_frr_001".to_string());

        let genuine = vec![KeystrokeSignal {
            key: 'g',
            timestamp: 0,
            press_duration: 50,
            flight_time: 100,
            pressure: 0.7,
        }];

        engine.enroll(&genuine, &[], &[]);

        // 100명의 본인 중 99명 이상 인증 성공
        for i in 0..100 {
            engine.authenticate(&genuine, &[], &[], true);
        }

        assert!(engine.frr_compliance());

        println!(
            "✅ RULE 2 PASS: FRR < 1% (actual: {:.2}%)",
            engine.get_metrics().false_rejection_rate * 100.0
        );
    }

    #[test]
    fn rule_3_decision_consistency() {
        // Rule 3: 동일 신호에 대해 결정이 일관성 있어야 함
        let mut engine = AuthenticationEngine::new("user_consistency_001".to_string());

        let profile = vec![KeystrokeSignal {
            key: 'c',
            timestamp: 0,
            press_duration: 50,
            flight_time: 100,
            pressure: 0.7,
        }];

        engine.enroll(&profile, &[], &[]);

        let mut decisions = Vec::new();
        for _ in 0..5 {
            let result = engine.authenticate(&profile, &[], &[], true);
            decisions.push(result.decision);
        }

        // 모든 결정이 동일해야 함
        let all_same = decisions.iter().all(|d| d == &decisions[0]);
        assert!(all_same);

        println!(
            "✅ RULE 3 PASS: Decision Consistency (5/5 identical: {:?})",
            decisions[0]
        );
    }

    #[test]
    fn rule_4_spoofing_defense() {
        // Rule 4: 스푸핑 공격(기계적 타이핑)을 탐지해야 함
        let mut engine = AuthenticationEngine::new("user_spoofing_001".to_string());

        let genuine = vec![
            KeystrokeSignal {
                key: 'p',
                timestamp: 0,
                press_duration: 50,
                flight_time: 115,
                pressure: 0.71,
            },
            KeystrokeSignal {
                key: 'a',
                timestamp: 115,
                press_duration: 52,
                flight_time: 125,
                pressure: 0.72,
            },
        ];

        engine.enroll(&genuine, &[], &[]);

        // 기계적 공격
        let attack = vec![
            KeystrokeSignal {
                key: 'p',
                timestamp: 0,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
            KeystrokeSignal {
                key: 'a',
                timestamp: 100,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
            KeystrokeSignal {
                key: 's',
                timestamp: 200,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
        ];

        let result = engine.authenticate(&attack, &[], &[], false);

        // 스푸핑 탐지되어야 함
        assert!(result.spoofing_risk_level != SpoofingRisk::Safe);

        println!(
            "✅ RULE 4 PASS: Spoofing Defense (detected: {:?})",
            result.spoofing_risk_level
        );
    }
}

