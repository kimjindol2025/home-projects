#[test]
fn test_natural_vs_mechanical_typing() {
    let detector = SpoofingDetector::new();

    // 자연스러운 타이핑
    let natural = vec![
        KeystrokeSignal {
            key: 'h',
            timestamp: 0,
            press_duration: 50,
            flight_time: 120,
            pressure: 0.7,
        },
        KeystrokeSignal {
            key: 'e',
            timestamp: 120,
            press_duration: 55,
            flight_time: 135,
            pressure: 0.72,
        },
        KeystrokeSignal {
            key: 'l',
            timestamp: 255,
            press_duration: 48,
            flight_time: 110,
            pressure: 0.68,
        },
    ];

    let natural_result = detector.detect_spoofing(&natural, &[], &[]);

    // 기계적 타이핑
    let mechanical = vec![
        KeystrokeSignal {
            key: 'a',
            timestamp: 0,
            press_duration: 50,
            flight_time: 100,
            pressure: 0.7,
        },
        KeystrokeSignal {
            key: 'a',
            timestamp: 100,
            press_duration: 50,
            flight_time: 100,
            pressure: 0.7,
        },
        KeystrokeSignal {
            key: 'a',
            timestamp: 200,
            press_duration: 50,
            flight_time: 100,
            pressure: 0.7,
        },
    ];

    let mechanical_result = detector.detect_spoofing(&mechanical, &[], &[]);

    assert!(natural_result.liveness_score > mechanical_result.liveness_score);

    println!(
        "✅ Natural Typing: liveness={:.2}%, Risk={:?}",
        natural_result.liveness_score * 100.0, natural_result.risk_level
    );
    println!(
        "✅ Mechanical Typing: liveness={:.2}%, Risk={:?}",
        mechanical_result.liveness_score * 100.0, mechanical_result.risk_level
    );
}

#[test]
fn test_heart_rate_plausibility() {
    let detector = SpoofingDetector::new();

    // 타당한 심박수
    let plausible = vec![
        HeartRateSignal {
            bpm: 72.0,
            timestamp: 0,
            variability: 0.5,
            confidence: 0.95,
        },
        HeartRateSignal {
            bpm: 73.0,
            timestamp: 1000,
            variability: 0.51,
            confidence: 0.95,
        },
    ];

    let plausible_result = detector.detect_spoofing(&[], &[], &plausible);

    // 불가능한 심박수 (60 → 150 BPM 점프)
    let implausible = vec![
        HeartRateSignal {
            bpm: 60.0,
            timestamp: 0,
            variability: 0.5,
            confidence: 0.95,
        },
        HeartRateSignal {
            bpm: 150.0,
            timestamp: 1000,
            variability: 0.5,
            confidence: 0.95,
        },
    ];

    let implausible_result = detector.detect_spoofing(&[], &[], &implausible);

    assert!(plausible_result.plausibility_score > implausible_result.plausibility_score);

    println!(
        "✅ Plausible HR: {:.2}%, Risk={:?}",
        plausible_result.plausibility_score * 100.0, plausible_result.risk_level
    );
    println!(
        "✅ Implausible HR: {:.2}%, Risk={:?}",
        implausible_result.plausibility_score * 100.0,
        implausible_result.risk_level
    );
}

