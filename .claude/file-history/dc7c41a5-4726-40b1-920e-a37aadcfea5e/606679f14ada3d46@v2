#[test]
fn test_metrics_from_perfect_authentication() {
    // Rule: 완벽한 인증 (100% 정확도)
    let attempts = vec![
        // 100명의 본인 모두 인증 성공
        AuthenticationAttempt {
            is_genuine: true,
            predicted_result: AuthenticationResult::Accept,
            confidence_score: 0.95,
            timestamp: 0,
        },
        AuthenticationAttempt {
            is_genuine: true,
            predicted_result: AuthenticationResult::Accept,
            confidence_score: 0.92,
            timestamp: 1,
        },
        AuthenticationAttempt {
            is_genuine: true,
            predicted_result: AuthenticationResult::Accept,
            confidence_score: 0.98,
            timestamp: 2,
        },
        // 100명의 타인 모두 거부
        AuthenticationAttempt {
            is_genuine: false,
            predicted_result: AuthenticationResult::Reject,
            confidence_score: 0.15,
            timestamp: 100,
        },
        AuthenticationAttempt {
            is_genuine: false,
            predicted_result: AuthenticationResult::Reject,
            confidence_score: 0.22,
            timestamp: 101,
        },
        AuthenticationAttempt {
            is_genuine: false,
            predicted_result: AuthenticationResult::Reject,
            confidence_score: 0.18,
            timestamp: 102,
        },
    ];

    let metrics = AuthenticationMetrics::from_attempts(&attempts);

    assert_eq!(metrics.false_acceptance_rate, 0.0);
    assert_eq!(metrics.false_rejection_rate, 0.0);
    assert_eq!(metrics.accuracy(), 1.0);

    println!(
        "✅ Perfect Authentication: FAR={:.6}%, FRR={:.2}%, Accuracy={:.2}%",
        metrics.false_acceptance_rate * 100.0,
        metrics.false_rejection_rate * 100.0,
        metrics.accuracy() * 100.0
    );
}

#[test]
fn test_far_in_ppm() {
    // FAR을 PPM (parts per million)으로 변환
    let attempts = vec![
        AuthenticationAttempt {
            is_genuine: false,
            predicted_result: AuthenticationResult::Accept,  // 1개 거짓 긍정
            confidence_score: 0.8,
            timestamp: 0,
        },
    ];

    for i in 1..1_000_000 {
        attempts.push(AuthenticationAttempt {
            is_genuine: false,
            predicted_result: AuthenticationResult::Reject,
            confidence_score: 0.2,
            timestamp: i as u64,
        });
    }

    let metrics = AuthenticationMetrics::from_attempts(&attempts);
    let far_ppm = metrics.far_in_ppm();

    println!("FAR: {:.2} PPM (parts per million)", far_ppm);
    assert!(far_ppm > 0.99 && far_ppm < 1.01);
}

#[test]
fn test_requirements_met() {
    // 무관용 규칙 검증
    // FAR < 0.0001% (1 in 1,000,000)
    // FRR < 1% (10 in 1,000)

    let mut attempts = vec![];

    // 1,000명의 본인 중 999명 인증 성공 (FRR = 0.1%)
    for i in 0..1000 {
        let accepted = i < 999;
        attempts.push(AuthenticationAttempt {
            is_genuine: true,
            predicted_result: if accepted {
                AuthenticationResult::Accept
            } else {
                AuthenticationResult::Reject
            },
            confidence_score: if accepted { 0.9 } else { 0.3 },
            timestamp: i as u64,
        });
    }

    // 1,000,000명의 타인 모두 거부 (FAR = 0%)
    for i in 1000..1001000 {
        attempts.push(AuthenticationAttempt {
            is_genuine: false,
            predicted_result: AuthenticationResult::Reject,
            confidence_score: 0.2,
            timestamp: i as u64,
        });
    }

    let metrics = AuthenticationMetrics::from_attempts(&attempts);

    assert!(metrics.meets_far_requirement());  // FAR < 0.0001% ✓
    assert!(metrics.meets_frr_requirement());  // FRR < 1% ✓
    assert!(metrics.meets_all_requirements());

    println!(
        "✅ Rules Met: FAR={:.6}% (target <0.0001%), FRR={:.2}% (target <1%)",
        metrics.false_acceptance_rate * 100.0,
        metrics.false_rejection_rate * 100.0
    );
}

