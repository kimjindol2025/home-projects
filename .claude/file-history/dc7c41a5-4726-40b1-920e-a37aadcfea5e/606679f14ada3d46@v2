#[test]
fn test_impostor_rejection() {
    let mut engine = AuthenticationEngine::new("user001".to_string());

    // 본인 패턴으로 등록
    let genuine = vec![KeystrokeSignal {
        key: 't',
        timestamp: 0,
        press_duration: 50,
        flight_time: 110,
        pressure: 0.7,
    }];

    engine.enroll(&genuine, &[], &[]);

    // 타인 패턴으로 인증 시도
    let impostor = vec![KeystrokeSignal {
        key: 'x',
        timestamp: 0,
        press_duration: 80,
        flight_time: 200,
        pressure: 0.3,
    }];

    let result = engine.authenticate(&impostor, &[], &[], false);

    // 타인은 거부되어야 함
    assert!(result.decision != AuthenticationDecision::Accept);

    println!(
        "✅ Impostor Rejection: Decision={:?}, Confidence={:.2}%",
        result.decision,
        result.confidence_score * 100.0
    );
}

