// Phase 3.1.5 파서 모듈

pub mod ttf_parser;
pub mod glyph_extractor;

pub use ttf_parser::{TTFParser, GlyphOutline, FontHeader};
pub use glyph_extractor::{Glyph, GlyphBounds, GlyphExtractor};

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_parser_module_integration() {
        let data = vec![0x00; 200];
        let mut parser = TTFParser::new(data);
        parser.parse_header();
        assert!(parser.header.units_per_em > 0);
    }

    #[test]
    fn test_glyph_extraction_workflow() {
        let outline = GlyphOutline::new();
        let glyph = GlyphExtractor::create_glyph('G', &outline, 1000);
        assert_eq!(glyph.codepoint, 'G');
        assert_eq!(glyph.beziers.len(), 0);  // 빈 글리프
    }
}
