// Layer 4: Green Consensus - GreenRaftNode (축약 구현)
pub struct GreenRaftNode {
    pub id: u32,
    pub peers: Vec<u32>,
    pub state: String,
    pub power_state: String,
    pub battery_level: f64,
    pub current_term: u32,
    pub log_entries: u32,
}

impl GreenRaftNode {
    pub fn new(id: u32, peers: Vec<u32>) -> GreenRaftNode {
        GreenRaftNode {
            id, peers,
            state: "Follower".to_string(),
            power_state: "FullPower".to_string(),
            battery_level: 1.0,
            current_term: 0,
            log_entries: 0,
        }
    }

    pub fn update_power_state(&mut self, battery: f64) {
        self.battery_level = battery;
        self.power_state = if battery < 0.05 { "Emergency".to_string() }
                          else if battery < 0.20 { "LowPower".to_string() }
                          else { "FullPower".to_string() };
    }

    pub fn compute_power_score(&self) -> f64 {
        self.battery_level
    }

    pub fn can_accept_writes(&self) -> bool {
        self.power_state != "Emergency"
    }
}

mod tests {
    use super::*;
    #[test]
    fn test_creation() {
        let n = GreenRaftNode::new(1, vec![2, 3]);
        assert_eq!(n.id, 1);
    }
}
