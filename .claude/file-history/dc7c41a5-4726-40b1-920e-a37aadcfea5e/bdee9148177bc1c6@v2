#[test]
fn test_bottleneck_severity_scoring() {
    // Test: Severity score reflects impact
    // Expected: Critical bottleneck severity > 0.7
    let power_impact = 100.0;
    let frequency_hz = 2.0;
    let duration_ms = 1000u64;

    // Simulate severity calculation
    let power_factor = (power_impact / 200.0).min(1.0);      // = 0.5
    let frequency_factor = (frequency_hz / 5.0).min(1.0);    // = 0.4
    let duration_factor = (duration_ms as f64 / 1000.0).min(1.0);  // = 1.0

    let severity = power_factor * frequency_factor * duration_factor;

    assert!(severity > 0.0);
}

