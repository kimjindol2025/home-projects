// Green-Distributed-Fabric Phase 2: Global Metrics Collector
// Purpose: Aggregate and analyze cluster-wide power metrics
// Strategy: Collect per-node data, calculate global statistics, detect anomalies

// ============================================================================
// Part 1: Per-Node Metrics (180 lines)
// ============================================================================

pub struct NodeMetrics {
    pub node_id: u32,
    pub power_readings_mw: Vec<f64>,
    pub cpu_utilizations: Vec<f64>,
    pub memory_usages_mb: Vec<u32>,
    pub latencies_ms: Vec<u32>,
    pub timestamp_ms: u64,
}

impl NodeMetrics {
    pub fn new(node_id: u32) -> Self {
        NodeMetrics {
            node_id,
            power_readings_mw: Vec::new(),
            cpu_utilizations: Vec::new(),
            memory_usages_mb: Vec::new(),
            latencies_ms: Vec::new(),
            timestamp_ms: 0,
        }
    }

    pub fn add_power_reading(&mut self, power_mw: f64) {
        self.power_readings_mw.push(power_mw);
    }

    pub fn add_cpu_utilization(&mut self, util: f64) {
        self.cpu_utilizations.push(util.min(1.0).max(0.0));
    }

    pub fn add_memory_usage(&mut self, mb: u32) {
        self.memory_usages_mb.push(mb);
    }

    pub fn add_latency(&mut self, ms: u32) {
        self.latencies_ms.push(ms);
    }

    pub fn average_power(&self) -> f64 {
        if self.power_readings_mw.is_empty() {
            return 0.0;
        }
        self.power_readings_mw.iter().sum::<f64>() / self.power_readings_mw.len() as f64
    }

    pub fn peak_power(&self) -> f64 {
        self.power_readings_mw.iter().copied().fold(0.0, f64::max)
    }

    pub fn average_cpu(&self) -> f64 {
        if self.cpu_utilizations.is_empty() {
            return 0.0;
        }
        self.cpu_utilizations.iter().sum::<f64>() / self.cpu_utilizations.len() as f64
    }

    pub fn average_memory(&self) -> u32 {
        if self.memory_usages_mb.is_empty() {
            return 0;
        }
        self.memory_usages_mb.iter().sum::<u32>() / self.memory_usages_mb.len() as u32
    }

    pub fn average_latency(&self) -> u32 {
        if self.latencies_ms.is_empty() {
            return 0;
        }
        self.latencies_ms.iter().sum::<u32>() / self.latencies_ms.len() as u32
    }
}

// ============================================================================
// Part 2: Cluster-Wide Aggregation (220 lines)
// ============================================================================

pub struct ClusterMetricsSnapshot {
    pub timestamp_ms: u64,
    pub node_count: u32,
    pub total_power_mw: f64,
    pub average_power_mw: f64,
    pub min_power_mw: f64,
    pub max_power_mw: f64,
    pub stddev_power_mw: f64,
    pub average_cpu_all: f64,
    pub average_memory_all_mb: u32,
    pub average_latency_all_ms: u32,
}

impl ClusterMetricsSnapshot {
    pub fn new(timestamp_ms: u64) -> Self {
        ClusterMetricsSnapshot {
            timestamp_ms,
            node_count: 0,
            total_power_mw: 0.0,
            average_power_mw: 0.0,
            min_power_mw: f64::INFINITY,
            max_power_mw: 0.0,
            stddev_power_mw: 0.0,
            average_cpu_all: 0.0,
            average_memory_all_mb: 0,
            average_latency_all_ms: 0,
        }
    }

    pub fn calculate_from_nodes(&mut self, nodes: &[NodeMetrics]) {
        if nodes.is_empty() {
            return;
        }

        self.node_count = nodes.len() as u32;

        // Power aggregation
        let mut power_sum = 0.0;
        let mut power_readings = Vec::new();

        for node in nodes {
            let node_avg = node.average_power();
            power_sum += node_avg;
            power_readings.push(node_avg);
            self.min_power_mw = self.min_power_mw.min(node_avg);
            self.max_power_mw = self.max_power_mw.max(node_avg);
        }

        self.total_power_mw = power_sum;
        self.average_power_mw = power_sum / nodes.len() as f64;

        // Standard deviation
        let variance = power_readings.iter()
            .map(|&p| (p - self.average_power_mw).powi(2))
            .sum::<f64>() / power_readings.len() as f64;
        self.stddev_power_mw = variance.sqrt();

        // CPU aggregation
        let cpu_sum: f64 = nodes.iter().map(|n| n.average_cpu()).sum();
        self.average_cpu_all = cpu_sum / nodes.len() as f64;

        // Memory aggregation
        let mem_sum: u32 = nodes.iter().map(|n| n.average_memory()).sum();
        self.average_memory_all_mb = mem_sum / nodes.len() as u32;

        // Latency aggregation
        let lat_sum: u32 = nodes.iter().map(|n| n.average_latency()).sum();
        self.average_latency_all_ms = lat_sum / nodes.len() as u32;
    }

    pub fn power_imbalance_ratio(&self) -> f64 {
        if self.min_power_mw > 0.0 {
            self.max_power_mw / self.min_power_mw
        } else {
            1.0
        }
    }

    pub fn fairness_jain_index(&self) -> f64 {
        // Simplified Jain fairness index (placeholder)
        // Real calculation would use individual readings
        if self.stddev_power_mw > 0.0 && self.average_power_mw > 0.0 {
            let coefficient_of_variation = self.stddev_power_mw / self.average_power_mw;
            1.0 / (1.0 + coefficient_of_variation)
        } else {
            1.0
        }
    }
}

// ============================================================================
// Part 3: Power Efficiency Analysis (200 lines)
// ============================================================================

pub struct EfficiencyAnalysis {
    pub baseline_power_mw: f64,      // Linux reference (250mW)
    pub measured_power_mw: f64,      // Green measured
    pub reduction_percent: f64,      // Goal: >= 40%
    pub efficiency_score: f64,       // 0.0-1.0, 1.0 = perfect
    pub measurements_collected: u32,
    pub confidence_level: f64,       // 0.0-1.0
}

impl EfficiencyAnalysis {
    pub fn new(baseline: f64) -> Self {
        EfficiencyAnalysis {
            baseline_power_mw: baseline,
            measured_power_mw: 0.0,
            reduction_percent: 0.0,
            efficiency_score: 0.0,
            measurements_collected: 0,
            confidence_level: 0.0,
        }
    }

    pub fn add_measurement(&mut self, power_mw: f64) {
        self.measured_power_mw =
            (self.measured_power_mw * self.measurements_collected as f64 + power_mw) /
            (self.measurements_collected as f64 + 1.0);
        self.measurements_collected += 1;

        // Update confidence (need 10+ samples for reasonable confidence)
        self.confidence_level = ((self.measurements_collected as f64) / 10.0).min(1.0);

        // Recalculate reduction
        if self.baseline_power_mw > 0.0 {
            self.reduction_percent =
                ((self.baseline_power_mw - self.measured_power_mw) / self.baseline_power_mw) * 100.0;
        }

        // Efficiency score (1.0 if target achieved)
        if self.reduction_percent >= 40.0 {
            self.efficiency_score = 1.0;
        } else if self.reduction_percent > 0.0 {
            self.efficiency_score = self.reduction_percent / 40.0;
        } else {
            self.efficiency_score = 0.0;
        }
    }

    pub fn verify_40_percent_reduction(&self) -> bool {
        self.reduction_percent >= 40.0 && self.confidence_level >= 0.9
    }

    pub fn is_measurement_valid(&self) -> bool {
        self.measurements_collected >= 10 && self.confidence_level >= 0.8
    }

    pub fn summary(&self) -> String {
        format!(
            "Efficiency: baseline={:.0}mW, measured={:.0}mW, reduction={:.1}% (target: 40%), score={:.2}, confidence={:.0}%",
            self.baseline_power_mw, self.measured_power_mw, self.reduction_percent,
            self.efficiency_score, self.confidence_level * 100.0
        )
    }
}

// ============================================================================
// Part 4: Battery Lifetime Prediction (150 lines)
// ============================================================================

pub struct BatteryProjection {
    pub capacity_mah: u32,          // Battery capacity
    pub nominal_voltage_v: f64,     // Nominal voltage
    pub average_power_mw: f64,
    pub estimated_lifetime_hours: f64,
    pub vs_baseline_improvement: f64,  // Goal: >= 2.0
}

impl BatteryProjection {
    pub fn new(capacity_mah: u32, avg_power_mw: f64) -> Self {
        let capacity_mwh = (capacity_mah as f64) * 3.7 / 1000.0;  // Convert to Wh
        let estimated_hours = if avg_power_mw > 0.0 {
            capacity_mwh / avg_power_mw
        } else {
            0.0
        };

        // Baseline: Linux 250mW, ~4.8 hours runtime
        let baseline_hours = 4.8;
        let improvement = estimated_hours / baseline_hours;

        BatteryProjection {
            capacity_mah,
            nominal_voltage_v: 3.7,
            average_power_mw: avg_power_mw,
            estimated_lifetime_hours: estimated_hours,
            vs_baseline_improvement: improvement,
        }
    }

    pub fn verify_2x_improvement(&self) -> bool {
        self.vs_baseline_improvement >= 2.0
    }

    pub fn summary(&self) -> String {
        format!(
            "Battery: capacity={}mAh, avg_power={:.0}mW, lifetime={:.1}h, vs_baseline={:.1}x",
            self.capacity_mah, self.average_power_mw, self.estimated_lifetime_hours,
            self.vs_baseline_improvement
        )
    }
}

// ============================================================================
// Tests (50 lines)
// ============================================================================

mod tests {
    use super::*;

    #[test]
    fn test_node_metrics_creation() {
        let metrics = NodeMetrics::new(0);
        assert_eq!(metrics.node_id, 0);
    }

    #[test]
    fn test_node_metrics_average() {
        let mut metrics = NodeMetrics::new(0);
        metrics.add_power_reading(100.0);
        metrics.add_power_reading(150.0);
        metrics.add_power_reading(200.0);

        let avg = metrics.average_power();
        assert!(avg > 140.0 && avg < 160.0);
    }

    #[test]
    fn test_cluster_snapshot_calculation() {
        let mut node1 = NodeMetrics::new(0);
        node1.add_power_reading(150.0);
        let mut node2 = NodeMetrics::new(1);
        node2.add_power_reading(160.0);

        let mut snapshot = ClusterMetricsSnapshot::new(0);
        snapshot.calculate_from_nodes(&[node1, node2]);

        assert_eq!(snapshot.node_count, 2);
        assert!(snapshot.average_power_mw > 0.0);
    }

    #[test]
    fn test_efficiency_analysis() {
        let mut analysis = EfficiencyAnalysis::new(250.0);  // Linux baseline

        // Add measurements simulating 40% reduction (150mW average)
        for _ in 0..10 {
            analysis.add_measurement(150.0);
        }

        assert!(analysis.verify_40_percent_reduction());
    }

    #[test]
    fn test_battery_projection() {
        let projection = BatteryProjection::new(5000, 150.0);  // 5000mAh, 150mW
        assert!(projection.vs_baseline_improvement >= 2.0);
    }
}
