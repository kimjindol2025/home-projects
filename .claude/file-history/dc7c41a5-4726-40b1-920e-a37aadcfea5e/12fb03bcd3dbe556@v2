// Phase 4: Key Derivation Function
// PBKDF2-like key derivation from biometric data

use super::crypto_module::*;

/// 키 유도 파라미터
#[derive(Clone, Debug)]
pub struct KeyDerivationParams {
    pub iterations: usize,    // PBKDF2 반복 횟수 (기본: 2000)
    pub salt_length: usize,   // 솔트 길이 (기본: 16)
    pub output_length: usize, // 출력 키 길이 (기본: 32 = 256비트)
}

impl KeyDerivationParams {
    pub fn new() -> Self {
        KeyDerivationParams {
            iterations: 2000,     // NIST 권장: 최소 1000-2000
            salt_length: 16,      // 16바이트 = 128비트
            output_length: 32,    // 32바이트 = 256비트
        }
    }

    pub fn with_iterations(mut self, iterations: usize) -> Self {
        self.iterations = iterations;
        self
    }

    pub fn with_output_length(mut self, length: usize) -> Self {
        self.output_length = length;
        self
    }
}

/// 키 유도 결과
#[derive(Clone, Debug)]
pub struct DerivedKey {
    pub key: Vec<u8>,
    pub salt: Vec<u8>,
    pub iterations: usize,
}

impl DerivedKey {
    /// 키를 16진수 문자열로 표현
    pub fn to_hex(&self) -> String {
        bytes_to_hex(&self.key)
    }

    /// 검증용 정보
    pub fn metadata(&self) -> String {
        format!(
            "key_len={}, salt_len={}, iterations={}",
            self.key.len(),
            self.salt.len(),
            self.iterations
        )
    }
}

/// PBKDF2-like 키 유도 함수
/// 생체 신호 + 임계값을 이용한 결정적 키 생성
pub fn derive_key_from_biometric(
    user_id: &str,
    confidence_score: f64,
    fingerprint: &str,  // 신경망 모델의 해시
    params: &KeyDerivationParams,
) -> DerivedKey {
    // Step 1: 솔트 생성 (user_id 기반)
    let salt_base = format!("{}:{}", user_id, fingerprint);
    let salt_hash = sha256(salt_base.as_bytes());
    let salt = salt_hash.bytes[..params.salt_length].to_vec();

    // Step 2: 비밀 입력값 생성
    // password = user_id + confidence_score + fingerprint
    let password = format!(
        "{}:{}:{}",
        user_id,
        (confidence_score * 1_000_000.0) as u64,
        fingerprint
    );

    // Step 3: PBKDF2-like 반복
    let mut derived = hmac_sha256(password.as_bytes(), &salt);

    for _i in 1..params.iterations {
        let combined = [derived.bytes.to_vec(), salt.clone()].concat();
        derived = hmac_sha256(password.as_bytes(), &combined);
    }

    // Step 4: 요청된 길이로 트리밍
    let key = derived.bytes[..params.output_length.min(32)].to_vec();

    DerivedKey {
        key,
        salt,
        iterations: params.iterations,
    }
}

/// 결정적 키 생성 (동일한 입력 → 동일한 출력)
pub fn derive_key_deterministic(
    master_key: &[u8],
    context: &str,  // "authentication" or "encryption"
    index: u32,
) -> Vec<u8> {
    let input = format!("{}:key_derivation:{}:{}", context, index, bytes_to_hex(master_key));
    let hash = sha256(input.as_bytes());
    hash.bytes.to_vec()
}

/// 키 강화 (Key Stretching)
/// 약한 패스워드를 강한 키로 변환
pub fn stretch_key(weak_key: &[u8], stretching_factor: usize) -> Vec<u8> {
    let mut result = weak_key.to_vec();

    for _round in 0..stretching_factor {
        let hash = sha256(&result);
        result = hash.bytes.to_vec();
    }

    result
}

/// 다중 키 생성 (하나의 마스터 키에서 여러 서브 키)
pub fn derive_multiple_keys(
    master_key: &[u8],
    count: usize,
    key_length: usize,
) -> Vec<Vec<u8>> {
    (0..count)
        .map(|i| {
            let derived = derive_key_deterministic(master_key, &format!("subkey_{}", i), i as u32);
            derived[..key_length.min(derived.len())].to_vec()
        })
        .collect()
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_params_creation() {
        let params = KeyDerivationParams::new();
        assert_eq!(params.iterations, 2000);
        assert_eq!(params.salt_length, 16);
        assert_eq!(params.output_length, 32);
    }

    #[test]
    fn test_derive_key_deterministic() {
        let params = KeyDerivationParams::new();

        let key1 = derive_key_from_biometric("user001", 0.95, "model_hash_001", &params);
        let key2 = derive_key_from_biometric("user001", 0.95, "model_hash_001", &params);

        assert_eq!(key1.key, key2.key);
        assert_eq!(key1.salt, key2.salt);
    }

    #[test]
    fn test_derive_key_different_users() {
        let params = KeyDerivationParams::new();

        let key1 = derive_key_from_biometric("user001", 0.95, "model_hash", &params);
        let key2 = derive_key_from_biometric("user002", 0.95, "model_hash", &params);

        assert_ne!(key1.key, key2.key);
    }

    #[test]
    fn test_derive_key_different_confidence() {
        let params = KeyDerivationParams::new();

        let key1 = derive_key_from_biometric("user001", 0.95, "model_hash", &params);
        let key2 = derive_key_from_biometric("user001", 0.90, "model_hash", &params);

        assert_ne!(key1.key, key2.key);
    }

    #[test]
    fn test_derive_key_length() {
        let params = KeyDerivationParams::new().with_output_length(32);
        let key = derive_key_from_biometric("user", 0.8, "hash", &params);

        assert_eq!(key.key.len(), 32);
    }

    #[test]
    fn test_derive_key_salt_uniqueness() {
        let params = KeyDerivationParams::new();

        let key1 = derive_key_from_biometric("user", 0.8, "hash1", &params);
        let key2 = derive_key_from_biometric("user", 0.8, "hash2", &params);

        assert_ne!(key1.salt, key2.salt);
    }

    #[test]
    fn test_key_stretching() {
        let weak = b"weak_password";
        let strong1 = stretch_key(weak, 100);
        let strong2 = stretch_key(weak, 100);

        // 반복 횟수가 같으면 결과도 같아야 함
        assert_eq!(strong1, strong2);

        // 반복 횟수가 다르면 결과도 달라야 함
        let strong3 = stretch_key(weak, 101);
        assert_ne!(strong1, strong3);
    }

    #[test]
    fn test_deterministic_key_derivation() {
        let master = b"master_secret";

        let key1 = derive_key_deterministic(master, "auth", 0);
        let key2 = derive_key_deterministic(master, "auth", 0);

        assert_eq!(key1, key2);
    }

    #[test]
    fn test_deterministic_different_context() {
        let master = b"master_secret";

        let key1 = derive_key_deterministic(master, "auth", 0);
        let key2 = derive_key_deterministic(master, "encrypt", 0);

        assert_ne!(key1, key2);
    }

    #[test]
    fn test_multiple_keys_generation() {
        let master = b"master_key";
        let keys = derive_multiple_keys(master, 5, 32);

        assert_eq!(keys.len(), 5);

        // 모든 키가 다를 것
        for i in 0..keys.len() {
            for j in i + 1..keys.len() {
                assert_ne!(keys[i], keys[j]);
            }
        }
    }

    #[test]
    fn test_key_to_hex() {
        let params = KeyDerivationParams::new();
        let key = derive_key_from_biometric("user", 0.8, "hash", &params);
        let hex = key.to_hex();

        assert_eq!(hex.len(), 64);  // 32 bytes = 64 hex chars
        assert!(hex.chars().all(|c| c.is_ascii_hexdigit()));
    }

    #[test]
    fn test_metadata() {
        let params = KeyDerivationParams::new();
        let key = derive_key_from_biometric("user", 0.8, "hash", &params);
        let metadata = key.metadata();

        assert!(metadata.contains("key_len=32"));
        assert!(metadata.contains("salt_len=16"));
        assert!(metadata.contains("iterations=2000"));
    }

    #[test]
    fn test_high_iteration_count() {
        // NIST 권장: 최소 1000-2000 iterations
        let params = KeyDerivationParams::new().with_iterations(10000);
        let key = derive_key_from_biometric("user", 0.8, "hash", &params);

        assert_eq!(key.iterations, 10000);
    }
}
