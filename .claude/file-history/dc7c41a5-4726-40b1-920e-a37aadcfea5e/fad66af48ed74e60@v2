// Phase 5.2 Day 4-5: 분산 Trace 전파 (240줄)
// Trace context propagation across distributed nodes

use crate::tracing::tracer::{TraceId, SpanId, get_timestamp_us};
use std::collections::HashMap;

#[derive(Clone, Debug)]
pub struct TraceContext {
    pub trace_id: TraceId,
    pub parent_span_id: SpanId,
    pub baggage: HashMap<String, String>,
    pub trace_state: String,
}

impl TraceContext {
    pub fn new(trace_id: TraceId, parent_span_id: SpanId) -> Self {
        TraceContext {
            trace_id,
            parent_span_id,
            baggage: HashMap::new(),
            trace_state: String::new(),
        }
    }

    pub fn with_baggage(mut self, key: &str, value: &str) -> Self {
        self.baggage.insert(key.to_string(), value.to_string());
        self
    }

    pub fn to_header_format(&self) -> String {
        // W3C Trace Context format: traceparent
        let trace_str = self.trace_id.to_string();
        let span_str = self.parent_span_id.to_string();
        format!("00-{}-{}-01", trace_str, span_str)
    }

    pub fn from_header_format(header: &str) -> Option<Self> {
        let parts: Vec<&str> = header.split('-').collect();
        if parts.len() != 4 {
            return None;
        }

        if parts[0] != "00" {
            return None;
        }

        // Parse trace ID (32 hex chars)
        if parts[1].len() != 32 {
            return None;
        }

        // Parse span ID (16 hex chars)
        if parts[2].len() != 16 {
            return None;
        }

        Some(TraceContext {
            trace_id: TraceId {
                high: u64::from_str_radix(&parts[1][0..16], 16).unwrap_or(0),
                low: u64::from_str_radix(&parts[1][16..32], 16).unwrap_or(0),
            },
            parent_span_id: SpanId {
                id: u64::from_str_radix(parts[2], 16).unwrap_or(0),
            },
            baggage: HashMap::new(),
            trace_state: String::new(),
        })
    }
}

pub struct DistributedPropagator;

impl DistributedPropagator {
    pub fn inject(context: &TraceContext) -> HashMap<String, String> {
        let mut headers = HashMap::new();

        // W3C Trace Context header
        headers.insert(
            "traceparent".to_string(),
            context.to_header_format(),
        );

        // Baggage items
        let baggage_str = context.baggage.iter()
            .map(|(k, v)| format!("{}={}", k, v))
            .collect::<Vec<_>>()
            .join(",");

        if !baggage_str.is_empty() {
            headers.insert("baggage".to_string(), baggage_str);
        }

        // Trace state (vendor-specific)
        if !context.trace_state.is_empty() {
            headers.insert("tracestate".to_string(), context.trace_state.clone());
        }

        headers
    }

    pub fn extract(headers: &HashMap<String, String>) -> Option<TraceContext> {
        let traceparent = headers.get("traceparent")?;
        let mut context = TraceContext::from_header_format(traceparent)?;

        // Parse baggage
        if let Some(baggage_str) = headers.get("baggage") {
            for item in baggage_str.split(',') {
                if let Some((key, value)) = item.split_once('=') {
                    context.baggage.insert(key.to_string(), value.to_string());
                }
            }
        }

        // Parse tracestate
        if let Some(trace_state) = headers.get("tracestate") {
            context.trace_state = trace_state.clone();
        }

        Some(context)
    }
}

pub struct DistributedTracingMetrics {
    pub total_traces_initiated: u64,
    pub total_spans_collected: u64,
    pub trace_propagations: u64,
    pub propagation_errors: u64,
    pub inter_node_latency_us: Vec<u64>,
    pub average_hops: f64,
}

impl DistributedTracingMetrics {
    pub fn new() -> Self {
        DistributedTracingMetrics {
            total_traces_initiated: 0,
            total_spans_collected: 0,
            trace_propagations: 0,
            propagation_errors: 0,
            inter_node_latency_us: Vec::new(),
            average_hops: 0.0,
        }
    }

    pub fn record_propagation(&mut self, latency_us: u64) {
        self.trace_propagations += 1;
        self.inter_node_latency_us.push(latency_us);
    }

    pub fn record_error(&mut self) {
        self.propagation_errors += 1;
    }

    pub fn get_average_propagation_latency(&self) -> u64 {
        if self.inter_node_latency_us.is_empty() {
            return 0;
        }

        let sum: u64 = self.inter_node_latency_us.iter().sum();
        sum / self.inter_node_latency_us.len() as u64
    }

    pub fn get_propagation_success_rate(&self) -> f64 {
        if self.trace_propagations == 0 {
            return 100.0;
        }

        ((self.trace_propagations - self.propagation_errors) as f64 / self.trace_propagations as f64) * 100.0
    }
}

pub struct RollupAggregator {
    pub span_counts_by_level: HashMap<String, u32>,
    pub latency_by_span: HashMap<String, Vec<u64>>,
}

impl RollupAggregator {
    pub fn new() -> Self {
        RollupAggregator {
            span_counts_by_level: HashMap::new(),
            latency_by_span: HashMap::new(),
        }
    }

    pub fn record_span_latency(&mut self, span_name: &str, latency_us: u64) {
        let level = span_name.split('.').next().unwrap_or("unknown");

        *self.span_counts_by_level.entry(level.to_string()).or_insert(0) += 1;

        self.latency_by_span
            .entry(span_name.to_string())
            .or_insert_with(Vec::new)
            .push(latency_us);
    }

    pub fn get_p50_latency(&self, span_name: &str) -> u64 {
        if let Some(latencies) = self.latency_by_span.get(span_name) {
            if latencies.is_empty() {
                return 0;
            }

            let mut sorted = latencies.clone();
            sorted.sort();

            let idx = latencies.len() / 2;
            sorted[idx]
        } else {
            0
        }
    }

    pub fn get_p99_latency(&self, span_name: &str) -> u64 {
        if let Some(latencies) = self.latency_by_span.get(span_name) {
            if latencies.is_empty() {
                return 0;
            }

            let mut sorted = latencies.clone();
            sorted.sort();

            let idx = (latencies.len() * 99) / 100;
            sorted[idx.min(sorted.len() - 1)]
        } else {
            0
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_trace_context_creation() {
        let trace_id = TraceId::new();
        let span_id = SpanId::new();

        let context = TraceContext::new(trace_id, span_id);
        assert_eq!(context.trace_id.high, trace_id.high);
    }

    #[test]
    fn test_trace_context_header_format() {
        let trace_id = TraceId::new();
        let span_id = SpanId::new();

        let context = TraceContext::new(trace_id, span_id);
        let header = context.to_header_format();

        assert!(header.starts_with("00-"));
        let parts: Vec<&str> = header.split('-').collect();
        assert_eq!(parts.len(), 4);
    }

    #[test]
    fn test_trace_propagation_inject() {
        let trace_id = TraceId::new();
        let span_id = SpanId::new();

        let mut context = TraceContext::new(trace_id, span_id);
        context = context.with_baggage("user_id", "12345");

        let headers = DistributedPropagator::inject(&context);

        assert!(headers.contains_key("traceparent"));
        assert!(headers.contains_key("baggage"));
    }

    #[test]
    fn test_trace_propagation_extract() {
        let trace_id = TraceId::new();
        let span_id = SpanId::new();

        let mut context = TraceContext::new(trace_id, span_id);
        context = context.with_baggage("service", "l3_predictor");

        let headers = DistributedPropagator::inject(&context);
        let extracted = DistributedPropagator::extract(&headers);

        assert!(extracted.is_some());
        let extracted_ctx = extracted.unwrap();
        assert_eq!(extracted_ctx.baggage.get("service"), Some(&"l3_predictor".to_string()));
    }

    #[test]
    fn test_distributed_tracing_metrics() {
        let mut metrics = DistributedTracingMetrics::new();

        metrics.record_propagation(1200);
        metrics.record_propagation(1150);
        metrics.record_propagation(1300);

        let avg_latency = metrics.get_average_propagation_latency();
        assert!(avg_latency > 1000 && avg_latency < 1500);

        let success_rate = metrics.get_propagation_success_rate();
        assert_eq!(success_rate, 100.0);
    }

    #[test]
    fn test_rollup_aggregator() {
        let mut aggregator = RollupAggregator::new();

        aggregator.record_span_latency("l1.measure_power", 1000);
        aggregator.record_span_latency("l1.measure_power", 1200);
        aggregator.record_span_latency("l1.measure_power", 1100);

        let p50 = aggregator.get_p50_latency("l1.measure_power");
        assert!(p50 > 0);
    }
}
