mod tests {
    use super::*;

    #[test]
    fn test_optimization_mode_selection() {
        let mut metrics = SystemMetrics::new();

        // Thermal critical
        metrics.thermal_headroom_percent = 10.0;
        assert!(matches!(metrics.select_mode(), OptimizationMode::ThermalCritical));

        // Performance first
        metrics.thermal_headroom_percent = 50.0;
        metrics.workload_class = "Interactive".to_string();
        assert!(matches!(metrics.select_mode(), OptimizationMode::PerformanceFirst));

        // Power first
        metrics.workload_class = "Mixed".to_string();
        metrics.battery_remaining_percent = 5.0;
        assert!(matches!(metrics.select_mode(), OptimizationMode::PowerFirst));
    }

    #[test]
    fn test_decision_coordination() {
        let metrics = SystemMetrics::new();
        let mut decision = OptimizationDecision::new();
        decision.dvfs_frequency_mhz = 2400;
        decision.thermal_scaling_factor = 0.8;

        decision.coordinate(&metrics);

        assert!(decision.synergy_score > 0.0);
        assert!(!decision.final_decision.is_empty());
    }

    #[test]
    fn test_conflict_resolution_thermal() {
        let mut metrics = SystemMetrics::new();
        metrics.thermal_headroom_percent = 15.0;

        let mut decision = OptimizationDecision::new();
        decision.dvfs_frequency_mhz = 2800;
        decision.thermal_scaling_factor = 0.5;

        decision.resolve_conflicts(&metrics);

        // Should reduce frequency due to thermal constraint
        assert!(decision.conflict_count > 0 || decision.dvfs_frequency_mhz < 2800);
    }

    #[test]
    fn test_conflict_resolution_latency_sensitivity() {
        let mut metrics = SystemMetrics::new();
        metrics.workload_class = "Interactive".to_string();

        let mut decision = OptimizationDecision::new();
        decision.sleep_state = "C3".to_string();

        decision.resolve_conflicts(&metrics);

        // Should prefer lighter sleep for interactive
        assert!(decision.sleep_state == "C1" || decision.conflict_count > 0);
    }

    #[test]
    fn test_synergy_computation() {
        let metrics = SystemMetrics::new();
        let decision = OptimizationDecision::new();
        let mut synergy = SynergyMaximizer::new();

        synergy.compute_synergies(&decision, &metrics);

        assert!(synergy.combined_power_benefit >= 30.0);
        assert!(synergy.combined_latency_benefit > 0.0);
    }

    #[test]
    fn test_unified_orchestrator() {
        let mut orchestrator = UnifiedOptimizationOrchestrator::new();
        let action = orchestrator.orchestrate_optimization();

        assert!(!action.is_empty());
        assert!(orchestrator.total_coordination_calls > 0);
    }

    #[test]
    fn test_orchestrator_success_rate() {
        let mut orchestrator = UnifiedOptimizationOrchestrator::new();

        for _ in 0..10 {
            orchestrator.orchestrate_optimization();
        }

        let success_rate = orchestrator.get_coordination_success_rate();
        assert!(success_rate >= 0.0 && success_rate <= 1.0);
    }

    #[test]
    fn test_synergy_improves_with_agreement() {
        let metrics = SystemMetrics::new();
        let mut decision = OptimizationDecision::new();
        decision.synergy_score = 0.95;  // High agreement

        let mut synergy = SynergyMaximizer::new();
        synergy.compute_synergies(&decision, &metrics);

        // With high synergy, power benefit should be significant
        assert!(synergy.combined_power_benefit > 40.0);
    }
}
