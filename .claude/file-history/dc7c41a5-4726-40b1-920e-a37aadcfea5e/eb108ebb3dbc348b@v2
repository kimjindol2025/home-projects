    // ===== Unforgiving Rules (4개) =====

    #[test]
    fn test_rule_1_pqc_key_size_1024_bits() {
        let pqc = PqcCrypto::new();
        let key_bits = pqc.key_size_bits();

        assert!(key_bits >= 1024);
        println!("✅ RULE 1 PASS: PQC Key Size >= 1024 bits (actual: {} bits)", key_bits);
    }

    #[test]
    fn test_rule_2_hw_master_secret_protection() {
        let mut storage = HwSecureStorage::new(SecureEnclaveType::SoftwareSim);
        let secret = [42u8; 32].to_vec();

        storage.store_master_secret("user001", &secret).unwrap();

        // 마스터 시크릿이 암호화되어 저장되는지 확인
        let encrypted = storage.master_secrets.get("user001").unwrap();
        assert_ne!(encrypted, &secret);  // 암호화됨 (원문 !== 암호문)

        // 올바른 토큰으로만 복구 가능
        let valid_token = storage.generate_auth_token("user001");
        let recovered = storage.retrieve_master_secret("user001", &valid_token).unwrap();
        assert_eq!(recovered, secret);

        println!("✅ RULE 2 PASS: HW Master Secret Protected (encrypted != plaintext)");
    }

