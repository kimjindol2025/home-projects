    #[test]
    fn test_rule_4_e2e_wearable_pipeline() {
        let config = WearableAuthConfig::default();
        let mut auth = WearableAuthenticator::new(config);

        // 1. Wearable 기기 등록
        let device = WearableDevice {
            device_id: "watch001".to_string(),
            device_type: WearableDeviceType::SmartWatch,
            connection: "BLE".to_string(),
            battery_level: 85,
            firmware_version: "1.0.0".to_string(),
            is_connected: false,
        };

        auth.enroll_with_wearable("user001", &[device]).unwrap();

        // 2. Wearable 인증
        let auth_result = auth.authenticate_with_wearable("user001", &["watch001"]).unwrap();
        assert!(auth_result.sensor_count > 0);

        // 3. PQC 키 검증
        assert!(auth.verify_pqc_key_size());

        // 4. HW 보안 검증
        assert!(auth.verify_hw_security("user001"));

        // 5. 모든 무관용 규칙 검증
        let (all_passed, msg) = auth.verify_all_unforgiving_rules("user001");
        assert!(all_passed);

        println!("✅ RULE 4 PASS: Complete E2E Pipeline - {}", msg);
    }

    // ===== Integration Test =====

    #[test]
    fn test_integration_phase_1_to_5_complete() {
        let config = WearableAuthConfig::default();
        let mut auth = WearableAuthenticator::new(config);

        // Phase 1: Signal Collection (Wearable sensors)
        let device = WearableDevice {
            device_id: "watch001".to_string(),
            device_type: WearableDeviceType::SmartWatch,
            connection: "BLE".to_string(),
            battery_level: 85,
            firmware_version: "1.0.0".to_string(),
            is_connected: false,
        };

        // Phase 2: Learning (via AuthenticationEngine)
        auth.enroll_with_wearable("user001", &[device]).ok();

        // Phase 3: Authentication
        let auth_result = auth.authenticate_with_wearable("user001", &["watch001"]).ok();

        // Phase 4: Cryptography (DynamicKeyGenerator)
        let has_dynamic_key = auth_result
            .as_ref()
            .map(|r| r.dynamic_key.is_some())
            .unwrap_or(false);

        // Phase 5: Wearable Integration
        let has_pqc_key = auth_result
            .as_ref()
            .map(|r| r.pqc_key.is_some())
            .unwrap_or(false);

        assert!(has_pqc_key || has_dynamic_key);
        println!("✅ INTEGRATION TEST: Phase 1-5 Complete Pipeline");
    }
