    // ===== Group C: PQC Cryptography (5개) =====

    #[test]
    fn test_c1_keypair_generation() {
        let pqc = PqcCrypto::new();
        let (pk, sk) = pqc.generate_keypair();

        assert_eq!(pk.key.dimension, 256);
        assert_eq!(sk.key.dimension, 256);
        assert_ne!(pk.key.polynomial, sk.key.polynomial);
    }

    #[test]
    fn test_c2_encapsulate_decapsulate_roundtrip() {
        let pqc = PqcCrypto::new();
        let (pk, sk) = pqc.generate_keypair();

        let (ciphertext, original_secret) = pqc.encapsulate(&pk);
        let recovered_secret = pqc.decapsulate(&sk, &ciphertext).unwrap();

        assert_eq!(original_secret, recovered_secret);
    }

    #[test]
    fn test_c3_key_size_requirement() {
        let pqc = PqcCrypto::new();
        let key_bits = pqc.key_size_bits();

        // Phase 5 무관용 규칙 #1: >= 1024 bits
        assert!(key_bits >= 1024);
        println!("✅ PQC Key Size: {} bits (>= 1024 bits)", key_bits);
    }

    #[test]
    fn test_c4_public_private_key_independence() {
        let pqc = PqcCrypto::new();
        let (pk1, sk1) = pqc.generate_keypair();
        let (pk2, sk2) = pqc.generate_keypair();

        // 다른 키 쌍
        assert_ne!(pk1.key.polynomial, pk2.key.polynomial);
        assert_ne!(sk1.key.polynomial, sk2.key.polynomial);

        // 같은 쌍 내에서도 다름
        assert_ne!(pk1.key.polynomial, sk1.key.polynomial);
    }

    #[test]
    fn test_c5_nist_security_level() {
        let pqc = PqcCrypto::new();
        let level = pqc.security_level();

        assert!(level >= 1 && level <= 5);
        println!("✅ NIST Security Level: {}", level);
    }

