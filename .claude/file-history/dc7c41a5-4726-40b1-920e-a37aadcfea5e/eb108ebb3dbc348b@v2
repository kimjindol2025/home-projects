    #[test]
    fn test_b5_tamper_detection() {
        let mut storage = HwSecureStorage::new(SecureEnclaveType::SoftwareSim);
        let secret = [42u8; 32].to_vec();

        storage.store_master_secret("user001", &secret).unwrap();
        let encrypted = storage.master_secrets.get("user001").unwrap().clone();

