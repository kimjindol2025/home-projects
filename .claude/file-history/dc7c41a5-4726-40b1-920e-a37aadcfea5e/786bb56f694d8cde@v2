// ─────────────────────────────────────────────────────────────────
// PowerAction: 전력 관리 조치 6가지
// ─────────────────────────────────────────────────────────────────

#[derive(Clone, Debug, PartialEq)]
pub enum PowerAction {
    ReduceDVFS { target_freq_mhz: u32 },    // DVFS 다운클럭
    EnterDeepSleep { target_state: String }, // 슬립 진입 (C6)
    DeferWorkload { defer_ms: u32 },         // 태스크 지연
    ConsolidateTasks,                        // 태스크 통합
    ActivateEmergencyMode,                   // 배터리 위기 모드
    ResumeNormal,                            // 정상 복귀
}

impl PowerAction {
    pub fn estimated_savings_mw(&self) -> f64 {
        // 조치별 예상 절감량
        match self {
            PowerAction::ReduceDVFS { .. } => 50.0,      // 50mW 절감
            PowerAction::EnterDeepSleep { .. } => 80.0,  // 80mW 절감 (유휴 시)
            PowerAction::DeferWorkload { .. } => 30.0,   // 30mW 절감 (일부)
            PowerAction::ConsolidateTasks => 40.0,       // 40mW 절감
            PowerAction::ActivateEmergencyMode => 20.0,  // 최소 20mW (비상용)
            PowerAction::ResumeNormal => 0.0,            // 회복
        }
    }

    pub fn execution_cost_ms(&self) -> u32 {
        // 조치 실행 비용 (ms)
        match self {
            PowerAction::ReduceDVFS { .. } => 5,
            PowerAction::EnterDeepSleep { .. } => 3,
            PowerAction::DeferWorkload { .. } => 1,
            PowerAction::ConsolidateTasks => 10,
            PowerAction::ActivateEmergencyMode => 2,
            PowerAction::ResumeNormal => 10,
        }
    }

    pub fn reversible(&self) -> bool {
        // 되돌릴 수 있는 조치인가?
        match self {
            PowerAction::ActivateEmergencyMode => false, // 비상모드는 수동 복구 필요
            _ => true,
        }
    }

    pub fn to_string(&self) -> String {
        match self {
            PowerAction::ReduceDVFS { target_freq_mhz } => {
                format!("ReduceDVFS({}MHz)", target_freq_mhz)
            }
            PowerAction::EnterDeepSleep { target_state } => {
                format!("EnterDeepSleep({})", target_state)
            }
            PowerAction::DeferWorkload { defer_ms } => {
                format!("DeferWorkload({}ms)", defer_ms)
            }
            PowerAction::ConsolidateTasks => "ConsolidateTasks".to_string(),
            PowerAction::ActivateEmergencyMode => "ActivateEmergencyMode".to_string(),
            PowerAction::ResumeNormal => "ResumeNormal".to_string(),
        }
    }
}

// ─────────────────────────────────────────────────────────────────
// DemandPlan: 수요 대응 계획
// ─────────────────────────────────────────────────────────────────

#[derive(Clone, Debug)]
pub struct DemandPlan {
    pub scheduled_actions: Vec<(u64, PowerAction)>, // (실행 시각_ms, 조치)
    pub expected_budget_compliance: bool,
    pub expected_savings_mw: f64,
    pub horizon_sec: u32,
}

impl DemandPlan {
    pub fn total_savings_mw(&self) -> f64 {
        self.scheduled_actions.iter()
            .map(|(_, action)| action.estimated_savings_mw())
            .sum()
    }
}

// ─────────────────────────────────────────────────────────────────
// PowerAdaptationDecision: 조치 결정 (Phase 6 AdaptationDecision 변환)
// ─────────────────────────────────────────────────────────────────

#[derive(Clone, Debug)]
pub struct PowerAdaptationDecision {
    pub recommended_action: PowerAction,
    pub priority: u32,              // 1-5 (5=즉시)
    pub estimated_savings_mw: f64,
    pub confidence: f64,            // Phase 6 신뢰도 체계 (0.0-1.0)
    pub reason: String,
}

impl PowerAdaptationDecision {
    pub fn is_urgent(&self) -> bool {
        self.priority >= 4
    }
}

// ─────────────────────────────────────────────────────────────────
// DemandResponsePlanner: 수요 대응 플래너
// ─────────────────────────────────────────────────────────────────

pub struct DemandResponsePlanner {
    pub budget_mw: f64,
    pub current_forecast: Option<EnergyForecast>,
    pub planned_actions: Vec<(u64, PowerAction)>,
    pub intervention_threshold: f64,  // urgency_score 임계값 (기본 0.6)
    pub battery_level: f64,           // 0.0-1.0
}

impl DemandResponsePlanner {
    pub fn new(budget_mw: f64) -> DemandResponsePlanner {
        DemandResponsePlanner {
            budget_mw,
            current_forecast: None,
            planned_actions: Vec::new(),
            intervention_threshold: 0.6,
            battery_level: 1.0,
        }
    }

    pub fn update_forecast(&mut self, forecast: EnergyForecast) {
        self.current_forecast = Some(forecast);
    }

    pub fn update_battery_level(&mut self, level: f64) {
        self.battery_level = level;
    }

    pub fn evaluate_intervention(&self) -> Option<PowerAdaptationDecision> {
        let forecast = self.current_forecast.as_ref()?;

        let urgency = forecast.drain_urgency_score();

        if urgency > self.intervention_threshold {
            let (priority, action) = match self.battery_level {
                b if b < 0.05 => {
                    // Emergency: 배터리 <5%
                    (5, PowerAction::ActivateEmergencyMode)
                }
                b if b < 0.20 => {
                    // Low power: 배터리 <20%
                    (4, PowerAction::ReduceDVFS { target_freq_mhz: 800 })
                }
                _ if forecast.predicted_peak_mw > self.budget_mw => {
                    // 예산 초과 위험
                    (3, PowerAction::ConsolidateTasks)
                }
                _ => {
                    // 온순 최적화
                    (2, PowerAction::DeferWorkload { defer_ms: 100 })
                }
            };

            return Some(PowerAdaptationDecision {
                recommended_action: action,
                priority,
                estimated_savings_mw: forecast.estimated_savings_mw,
                confidence: forecast.confidence,
                reason: format!(
                    "Urgency: {:.2}, Forecast: {:.1}mW, Budget: {:.1}mW",
                    urgency, forecast.predicted_peak_mw, self.budget_mw
                ),
            });
        }

        None
    }

    pub fn build_plan(&self, decision: &PowerAdaptationDecision) -> DemandPlan {
        let mut actions = vec![(0u64, decision.recommended_action.clone())];

        // 추가 조치 계획 (조건부)
        if decision.priority >= 4 {
            // 긴급: 즉시 조치 + 복구 계획
            actions.push((5000, PowerAction::ResumeNormal));
        }

        let total_savings = actions.iter()
            .map(|(_, a)| a.estimated_savings_mw())
            .sum();

        let compliance = if let Some(forecast) = &self.current_forecast {
            forecast.predicted_peak_mw - total_savings <= self.budget_mw
        } else {
            false
        };

        DemandPlan {
            scheduled_actions: actions,
            expected_budget_compliance: compliance,
            expected_savings_mw: total_savings,
            horizon_sec: 60,
        }
    }

    pub fn execute_action(
        &mut self,
        action: PowerAction,
        _dvfs: Option<&mut crate::scheduler::DVFSController>,
        _sleep: Option<&mut crate::scheduler::SleepManager>,
    ) -> bool {
        // 조치 실행 시뮬레이션
        let cost_ms = action.execution_cost_ms();
        let savings_mw = action.estimated_savings_mw();

        self.planned_actions.push((0, action.clone()));

        println!("Executing action: {} ({}ms, {}mW savings)",
                 action.to_string(), cost_ms, savings_mw);

        true
    }

    pub fn failover_on_battery_critical(&mut self) -> bool {
        // 무관용 규칙 8: Failover < 50ms
        // 배터리 소진 시 리더 변경 (Raft 레벨에서 호출됨)
        if self.battery_level < 0.02 {
            println!("[FAILOVER] Battery critical: {:.1}%", self.battery_level * 100.0);
            return true;
        }

        false
    }
}

// ─────────────────────────────────────────────────────────────────
