// ─────────────────────────────────────────────────────────────────

mod tests {
    use super::*;

    #[test]
    fn test_power_action_savings() {
        assert_eq!(PowerAction::ReduceDVFS { target_freq_mhz: 800 }.estimated_savings_mw(), 50.0);
        assert_eq!(PowerAction::ConsolidateTasks.estimated_savings_mw(), 40.0);
    }

    #[test]
    fn test_power_action_execution_cost() {
        assert_eq!(PowerAction::ReduceDVFS { target_freq_mhz: 800 }.execution_cost_ms(), 5);
        assert_eq!(PowerAction::ConsolidateTasks.execution_cost_ms(), 10);
    }

    #[test]
    fn test_power_action_reversible() {
        assert!(PowerAction::ReduceDVFS { target_freq_mhz: 800 }.reversible());
        assert!(!PowerAction::ActivateEmergencyMode.reversible());
    }

    #[test]
    fn test_demand_plan_total_savings() {
        let plan = DemandPlan {
            scheduled_actions: vec![
                (0, PowerAction::ReduceDVFS { target_freq_mhz: 800 }),
                (5000, PowerAction::ResumeNormal),
            ],
            expected_budget_compliance: true,
            expected_savings_mw: 50.0,
            horizon_sec: 60,
        };

        assert!(plan.total_savings_mw() > 0.0);
    }

    #[test]
    fn test_adaptation_decision_is_urgent() {
        let decision = PowerAdaptationDecision {
            recommended_action: PowerAction::ActivateEmergencyMode,
            priority: 5,
            estimated_savings_mw: 20.0,
            confidence: 0.90,
            reason: "Emergency".to_string(),
        };

        assert!(decision.is_urgent());
    }

    #[test]
    fn test_planner_creation() {
        let planner = DemandResponsePlanner::new(150.0);
        assert_eq!(planner.budget_mw, 150.0);
        assert_eq!(planner.battery_level, 1.0);
    }

    #[test]
    fn test_planner_failover_on_critical() {
        let mut planner = DemandResponsePlanner::new(150.0);
        planner.battery_level = 0.01;

        assert!(planner.failover_on_battery_critical());
    }
}
