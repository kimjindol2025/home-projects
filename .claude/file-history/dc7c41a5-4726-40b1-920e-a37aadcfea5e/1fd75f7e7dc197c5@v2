use std::collections::HashMap;

#[derive(Clone, Debug)]
pub struct Metric {
    pub name: String,
    pub value: f64,
    pub unit: String,
    pub timestamp_us: u64,
    pub labels: HashMap<String, String>,
}

impl Metric {
    pub fn new(name: &str, value: f64, unit: &str) -> Self {
        Metric {
            name: name.to_string(),
            value,
            unit: unit.to_string(),
            timestamp_us: crate::tracing::tracer::get_timestamp_us(),
            labels: HashMap::new(),
        }
    }

    pub fn with_label(mut self, key: &str, value: &str) -> Self {
        self.labels.insert(key.to_string(), value.to_string());
        self
    }
}

pub struct MetricsCollector {
    pub metrics: Vec<Metric>,
}

impl MetricsCollector {
    pub fn new() -> Self {
        MetricsCollector {
            metrics: Vec::new(),
        }
    }

    pub fn collect(&mut self, metric: Metric) {
        self.metrics.push(metric);
    }

    pub fn get_metric_count(&self) -> usize {
        self.metrics.len()
    }

    pub fn get_average_value(&self, metric_name: &str) -> f64 {
        let matching: Vec<f64> = self.metrics.iter()
            .filter(|m| m.name == metric_name)
            .map(|m| m.value)
            .collect();

        if matching.is_empty() {
            return 0.0;
        }

        matching.iter().sum::<f64>() / matching.len() as f64
    }

    pub fn get_max_value(&self, metric_name: &str) -> f64 {
        self.metrics.iter()
            .filter(|m| m.name == metric_name)
            .map(|m| m.value)
            .fold(f64::NEG_INFINITY, f64::max)
    }

    pub fn get_min_value(&self, metric_name: &str) -> f64 {
        self.metrics.iter()
            .filter(|m| m.name == metric_name)
            .map(|m| m.value)
            .fold(f64::INFINITY, f64::min)
    }
}

