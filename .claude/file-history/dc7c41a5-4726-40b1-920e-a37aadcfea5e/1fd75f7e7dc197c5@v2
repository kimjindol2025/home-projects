pub struct MetricsSummary {
    pub total_metrics_collected: usize,
    pub power_metrics: usize,
    pub latency_metrics: usize,
    pub accuracy_metrics: usize,
}

impl MetricsSummary {
    pub fn from_collector(collector: &MetricsCollector) -> Self {
        use metrics_def::*;

        let power_metrics = collector.metrics.iter()
            .filter(|m| {
                m.name.contains("power") || m.name.contains("energy")
            })
            .count();

        let latency_metrics = collector.metrics.iter()
            .filter(|m| {
                m.name.contains("latency") || m.name.contains("duration") || m.name.contains("response_time")
            })
            .count();

        let accuracy_metrics = collector.metrics.iter()
            .filter(|m| {
                m.name.contains("accuracy") || m.name.contains("effectiveness") || m.name.contains("confidence")
            })
            .count();

        MetricsSummary {
            total_metrics_collected: collector.metrics.len(),
            power_metrics,
            latency_metrics,
            accuracy_metrics,
        }
    }

    pub fn display(&self) {
        println!("Metrics Summary:");
        println!("  Total Metrics: {}", self.total_metrics_collected);
        println!("  Power Metrics: {}", self.power_metrics);
        println!("  Latency Metrics: {}", self.latency_metrics);
        println!("  Accuracy Metrics: {}", self.accuracy_metrics);
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_metric_creation() {
        let metric = Metric::new("test_metric", 42.5, "units")
            .with_label("host", "localhost");

        assert_eq!(metric.name, "test_metric");
        assert_eq!(metric.value, 42.5);
        assert_eq!(metric.unit, "units");
    }

    #[test]
    fn test_metrics_collector() {
        let mut collector = MetricsCollector::new();

        let m1 = Metric::new("power", 150.0, "mW");
        let m2 = Metric::new("power", 160.0, "mW");
        let m3 = Metric::new("latency", 8.5, "ms");

        collector.collect(m1);
        collector.collect(m2);
        collector.collect(m3);

        assert_eq!(collector.get_metric_count(), 3);
    }

    #[test]
    fn test_metrics_aggregation() {
        let mut collector = MetricsCollector::new();

        for i in 0..10 {
            let metric = Metric::new("power", (100 + i * 5) as f64, "mW");
            collector.collect(metric);
        }

        let avg = collector.get_average_value("power");
        let max = collector.get_max_value("power");
        let min = collector.get_min_value("power");

        assert!(avg > 100.0 && avg < 150.0);
        assert_eq!(max, 145.0);
        assert_eq!(min, 100.0);
    }

    #[test]
    fn test_metrics_summary() {
        let mut collector = MetricsCollector::new();

        collector.collect(Metric::new("l1.instantaneous_power_mw", 150.0, "mW"));
        collector.collect(Metric::new("l2.dvfs_transition_latency_us", 8000.0, "us"));
        collector.collect(Metric::new("l5.pattern_accuracy_percent", 87.0, "%"));

        let summary = MetricsSummary::from_collector(&collector);
        assert_eq!(summary.total_metrics_collected, 3);
    }
}
