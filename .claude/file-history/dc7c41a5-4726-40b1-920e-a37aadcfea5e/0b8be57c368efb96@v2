// Phase 1: Biometric Signal Collection
// 타이핑 습관, 터치 압력, 심박수 수집

use std::collections::VecDeque;

/// 키스트로크 다이나믹스 (Keystroke Dynamics)
/// 타이핑 속도, 키 간 시간차, 누르기 시간을 추적
#[derive(Clone, Debug)]
pub struct KeystrokeSignal {
    pub key: char,
    pub timestamp: u64,
    pub press_duration: u64,  // 키를 누르고 있던 시간 (ms)
    pub flight_time: u64,      // 이전 키와의 시간차 (ms)
    pub pressure: f64,         // 누른 강도 (0.0~1.0)
}

/// 터치 압력 신호
#[derive(Clone, Debug)]
pub struct TouchSignal {
    pub x: f64,               // X 좌표
    pub y: f64,               // Y 좌표
    pub pressure: f64,        // 터치 압력 (0.0~1.0)
    pub timestamp: u64,
    pub duration: u64,        // 터치 지속 시간 (ms)
}

/// 심박수 신호 (웨어러블)
#[derive(Clone, Debug)]
pub struct HeartRateSignal {
    pub bpm: f64,             // 분당 박동수
    pub timestamp: u64,
    pub variability: f64,     // HRV (Heart Rate Variability) 0.0~1.0
    pub confidence: f64,      // 측정 신뢰도 (0.0~1.0)
}

/// 통합 생체 신호
#[derive(Clone, Debug)]
pub enum BiometricSignal {
    Keystroke(KeystrokeSignal),
    Touch(TouchSignal),
    HeartRate(HeartRateSignal),
}

/// 생체 신호 수집기
#[derive(Clone, Debug)]
pub struct BiometricCollector {
    pub keystroke_buffer: VecDeque<KeystrokeSignal>,
    pub touch_buffer: VecDeque<TouchSignal>,
    pub heartrate_buffer: VecDeque<HeartRateSignal>,
    pub max_buffer_size: usize,
    pub total_signals_collected: usize,
}

impl BiometricCollector {
    pub fn new(max_buffer_size: usize) -> Self {
        BiometricCollector {
            keystroke_buffer: VecDeque::with_capacity(max_buffer_size),
            touch_buffer: VecDeque::with_capacity(max_buffer_size),
            heartrate_buffer: VecDeque::with_capacity(max_buffer_size),
            max_buffer_size,
            total_signals_collected: 0,
        }
    }

    /// 키스트로크 신호 기록
    pub fn record_keystroke(
        &mut self,
        key: char,
        timestamp: u64,
        press_duration: u64,
        flight_time: u64,
        pressure: f64,
    ) -> bool {
        let signal = KeystrokeSignal {
            key,
            timestamp,
            press_duration,
            flight_time,
            pressure: pressure.clamp(0.0, 1.0),
        };

        if self.keystroke_buffer.len() >= self.max_buffer_size {
            self.keystroke_buffer.pop_front();
        }

        self.keystroke_buffer.push_back(signal);
        self.total_signals_collected += 1;
        true
    }

    /// 터치 신호 기록
    pub fn record_touch(
        &mut self,
        x: f64,
        y: f64,
        pressure: f64,
        timestamp: u64,
        duration: u64,
    ) -> bool {
        let signal = TouchSignal {
            x,
            y,
            pressure: pressure.clamp(0.0, 1.0),
            timestamp,
            duration,
        };

        if self.touch_buffer.len() >= self.max_buffer_size {
            self.touch_buffer.pop_front();
        }

        self.touch_buffer.push_back(signal);
        self.total_signals_collected += 1;
        true
    }

    /// 심박수 신호 기록 (웨어러블)
    pub fn record_heartrate(
        &mut self,
        bpm: f64,
        timestamp: u64,
        variability: f64,
        confidence: f64,
    ) -> bool {
        // 생리적 범위 검증 (40~200 BPM)
        if bpm < 40.0 || bpm > 200.0 {
            return false;
        }

        let signal = HeartRateSignal {
            bpm,
            timestamp,
            variability: variability.clamp(0.0, 1.0),
            confidence: confidence.clamp(0.0, 1.0),
        };

        if self.heartrate_buffer.len() >= self.max_buffer_size {
            self.heartrate_buffer.pop_front();
        }

        self.heartrate_buffer.push_back(signal);
        self.total_signals_collected += 1;
        true
    }

    /// 타이핑 속도 분석 (WPM - Words Per Minute)
    pub fn typing_speed(&self) -> f64 {
        if self.keystroke_buffer.len() < 2 {
            return 0.0;
        }

        let total_chars = self.keystroke_buffer.len();
        let total_time_ms = self.keystroke_buffer
            .back()
            .map(|last| last.timestamp)
            .unwrap_or(0)
            - self.keystroke_buffer
                .front()
                .map(|first| first.timestamp)
                .unwrap_or(0);

        if total_time_ms == 0 {
            return 0.0;
        }

        // WPM = (characters / 5) / (time in minutes)
        let total_time_minutes = total_time_ms as f64 / 60000.0;
        (total_chars as f64 / 5.0) / total_time_minutes
    }

    /// 평균 키 간 시간차 (Dwell Time)
    pub fn average_dwell_time(&self) -> f64 {
        if self.keystroke_buffer.is_empty() {
            return 0.0;
        }

        let sum: u64 = self.keystroke_buffer
            .iter()
            .map(|s| s.press_duration)
            .sum();

        sum as f64 / self.keystroke_buffer.len() as f64
    }

    /// 평균 비행 시간 (Flight Time)
    pub fn average_flight_time(&self) -> f64 {
        if self.keystroke_buffer.len() < 2 {
            return 0.0;
        }

        let sum: u64 = self.keystroke_buffer
            .iter()
            .map(|s| s.flight_time)
            .sum();

        sum as f64 / (self.keystroke_buffer.len() - 1) as f64
    }

    /// 평균 터치 압력
    pub fn average_touch_pressure(&self) -> f64 {
        if self.touch_buffer.is_empty() {
            return 0.0;
        }

        let sum: f64 = self.touch_buffer
            .iter()
            .map(|s| s.pressure)
            .sum();

        sum / self.touch_buffer.len() as f64
    }

    /// 평균 심박수
    pub fn average_heart_rate(&self) -> f64 {
        if self.heartrate_buffer.is_empty() {
            return 0.0;
        }

        let sum: f64 = self.heartrate_buffer
            .iter()
            .map(|s| s.bpm)
            .sum();

        sum / self.heartrate_buffer.len() as f64
    }

    /// 심박수 변이도 (Heart Rate Variability)
    pub fn average_hrv(&self) -> f64 {
        if self.heartrate_buffer.is_empty() {
            return 0.0;
        }

        let sum: f64 = self.heartrate_buffer
            .iter()
            .map(|s| s.variability)
            .sum();

        sum / self.heartrate_buffer.len() as f64
    }

    /// 생체 신호 프로필 (특징 벡터)
    pub fn biometric_profile(&self) -> BiometricProfile {
        BiometricProfile {
            typing_speed: self.typing_speed(),
            dwell_time: self.average_dwell_time(),
            flight_time: self.average_flight_time(),
            touch_pressure: self.average_touch_pressure(),
            heart_rate: self.average_heart_rate(),
            heart_rate_variability: self.average_hrv(),
            keystroke_count: self.keystroke_buffer.len(),
            touch_count: self.touch_buffer.len(),
            heartrate_count: self.heartrate_buffer.len(),
        }
    }

    /// 버퍼 초기화
    pub fn clear(&mut self) {
        self.keystroke_buffer.clear();
        self.touch_buffer.clear();
        self.heartrate_buffer.clear();
    }

    /// 통계
    pub fn statistics(&self) -> CollectorStatistics {
        CollectorStatistics {
            total_signals: self.total_signals_collected,
            keystroke_buffer_size: self.keystroke_buffer.len(),
            touch_buffer_size: self.touch_buffer.len(),
            heartrate_buffer_size: self.heartrate_buffer.len(),
            avg_keystroke_pressure: self.keystroke_buffer
                .iter()
                .map(|s| s.pressure)
                .fold(0.0, |a, b| a + b)
                / self.keystroke_buffer.len().max(1) as f64,
        }
    }
}

/// 생체 신호 프로필 (특징 벡터)
#[derive(Clone, Debug)]
pub struct BiometricProfile {
    pub typing_speed: f64,           // WPM
    pub dwell_time: f64,             // ms
    pub flight_time: f64,            // ms
    pub touch_pressure: f64,         // 0.0~1.0
    pub heart_rate: f64,             // BPM
    pub heart_rate_variability: f64, // 0.0~1.0
    pub keystroke_count: usize,
    pub touch_count: usize,
    pub heartrate_count: usize,
}

/// 수집기 통계
#[derive(Clone, Debug)]
pub struct CollectorStatistics {
    pub total_signals: usize,
    pub keystroke_buffer_size: usize,
    pub touch_buffer_size: usize,
    pub heartrate_buffer_size: usize,
    pub avg_keystroke_pressure: f64,
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_collector_creation() {
        let collector = BiometricCollector::new(100);
        assert_eq!(collector.keystroke_buffer.len(), 0);
        assert_eq!(collector.max_buffer_size, 100);
    }

    #[test]
    fn test_keystroke_recording() {
        let mut collector = BiometricCollector::new(100);

        for i in 0..10 {
            collector.record_keystroke(
                'a',
                i as u64 * 100,
                50,
                100,
                0.8,
            );
        }

        assert_eq!(collector.keystroke_buffer.len(), 10);
        assert_eq!(collector.total_signals_collected, 10);
    }

    #[test]
    fn test_touch_recording() {
        let mut collector = BiometricCollector::new(100);

        for i in 0..5 {
            collector.record_touch(
                100.0 + i as f64,
                200.0,
                0.7,
                i as u64 * 200,
                50,
            );
        }

        assert_eq!(collector.touch_buffer.len(), 5);
    }

    #[test]
    fn test_heartrate_recording() {
        let mut collector = BiometricCollector::new(100);

        for i in 0..15 {
            let valid = collector.record_heartrate(
                72.0 + i as f64,
                i as u64 * 1000,
                0.5,
                0.95,
            );
            assert!(valid);
        }

        assert_eq!(collector.heartrate_buffer.len(), 15);
    }

    #[test]
    fn test_invalid_heartrate() {
        let mut collector = BiometricCollector::new(100);

        // 범위 외의 심박수는 거부
        let valid_low = collector.record_heartrate(30.0, 0, 0.5, 0.9);
        let valid_high = collector.record_heartrate(250.0, 0, 0.5, 0.9);

        assert!(!valid_low);
        assert!(!valid_high);
    }

    #[test]
    fn test_biometric_profile() {
        let mut collector = BiometricCollector::new(100);

        for i in 0..10 {
            collector.record_keystroke('a', i as u64 * 100, 50, 100, 0.8);
        }

        let profile = collector.biometric_profile();
        assert!(profile.typing_speed > 0.0);
        assert!(profile.dwell_time > 0.0);
        assert_eq!(profile.keystroke_count, 10);
    }

    #[test]
    fn test_statistics() {
        let mut collector = BiometricCollector::new(100);

        for i in 0..5 {
            collector.record_keystroke('a', i as u64 * 100, 50, 100, 0.8);
            collector.record_touch(100.0, 200.0, 0.7, i as u64 * 100, 50);
            collector.record_heartrate(72.0 + i as f64, i as u64 * 100, 0.5, 0.9);
        }

        let stats = collector.statistics();
        assert_eq!(stats.total_signals, 15);
        assert_eq!(stats.keystroke_buffer_size, 5);
        assert_eq!(stats.touch_buffer_size, 5);
        assert_eq!(stats.heartrate_buffer_size, 5);
    }
}
