// Phase 3.1.5 E2E 통합 테스트
// TTF 파싱 → 글리프 추출 → SDF 생성 → 렌더링

use crate::*;

#[test]
fn test_e2e_ttf_parsing_to_sdf() {
    // 빈 TTF 데이터로 시작
    let ttf_data = vec![0x00; 500];
    let mut font_engine = FontEngineIntegration::new(ttf_data);

    // FontEngine 생성 확인
    assert_eq!(font_engine.loaded_glyph_count(), 0);
    assert_eq!(font_engine.metrics.size_pt, 12);
}

#[test]
fn test_e2e_glyph_rendering() {
    let ttf_data = vec![0x00; 500];
    let engine = FontEngineIntegration::new(ttf_data);

    // 글리프 렌더링 (로드되지 않은 글리프는 None)
    let result = engine.render_glyph('G');
    assert!(result.is_none());
}

#[test]
fn test_e2e_text_rendering() {
    let ttf_data = vec![0x00; 500];
    let engine = FontEngineIntegration::new(ttf_data);

    // 텍스트 렌더링 (글리프가 없으면 빈 벡터)
    let sdfs = engine.render_text("GOGS", 100);
    assert_eq!(sdfs.len(), 0);
}

#[test]
fn test_e2e_font_metrics() {
    let ttf_data = vec![0x00; 500];
    let engine = FontEngineIntegration::new(ttf_data);

    // 폰트 메트릭 확인
    assert!(engine.metrics.scale > 0);
    assert!(engine.metrics.line_height > 0);
}

#[test]
fn test_e2e_bold_thin_workflow() {
    let ttf_data = vec![0x00; 500];
    let mut engine = FontEngineIntegration::new(ttf_data);

    // Normal (기본)
    assert_eq!(engine.shader.threshold, 0);

    // Bold로 변경
    engine.set_bold();
    assert!(engine.shader.threshold < 0);

    // Thin으로 변경
    engine.set_thin();
    assert!(engine.shader.threshold > 0);

    // Normal로 복원
    engine.set_normal();
    assert_eq!(engine.shader.threshold, 0);
}

#[test]
fn test_parser_ttf_header_parsing() {
    let mut ttf_data = vec![0x00; 100];

    // units_per_em at offset 50-51: 0x03E8 (1000)
    ttf_data[50] = 0x03;
    ttf_data[51] = 0xE8;

    let mut parser = TTFParser::new(ttf_data);
    parser.parse_header();
    assert_eq!(parser.header.units_per_em, 1000);
}

