#[test]
fn test_e2e_sdf_generation_with_beziers() {
    let bezier = CubicBezier::new(
        Point::new(from_int(0), from_int(0)),
        Point::new(from_int(1), from_int(1)),
        Point::new(from_int(2), from_int(1)),
        Point::new(from_int(3), from_int(0)),
    );

    let engine = FontEngineIntegration::new(vec![0x00; 500]);
    let sdf = engine.render_glyph(&[bezier], 32, 32);

    assert_eq!(sdf.width, 32);
    assert_eq!(sdf.height, 32);

    // 모든 픽셀이 유효한 범위에 있는지 확인
    for pixel in sdf.pixels.iter() {
        assert!(pixel.distance >= -128);
        assert!(pixel.distance <= 127);
    }
}

#[test]
fn test_e2e_multiple_glyphs_workflow() {
    let ttf_data = vec![0x00; 500];
    let engine = FontEngineIntegration::new(ttf_data);

    // 여러 글리프 렌더링 시도
    let chars = vec!['G', 'O', 'G', 'S'];
    for ch in chars {
        let _result = engine.render_glyph_at_size(ch, 100);
        // 글리프가 없으면 None 반환
    }

    assert_eq!(engine.loaded_glyph_count(), 0);  // 로드된 글리프 없음
}

#[test]
fn test_e2e_shader_anti_aliasing() {
    let bezier = CubicBezier::new(
        Point::new(from_int(0), from_int(0)),
        Point::new(from_int(1), from_int(1)),
        Point::new(from_int(2), from_int(1)),
        Point::new(from_int(3), from_int(0)),
    );

    let engine = FontEngineIntegration::new(vec![0x00; 500]);
    let sdf = engine.render_glyph(&[bezier], 32, 32);

    // 각 픽셀을 쉐이더로 렌더링
    let mut pixel_count = 0;
    for pixel in sdf.pixels.iter() {
        let color = engine.shade_pixel(pixel.distance);
        // 색상이 RGBA 형식인지 확인 (0xRRGGBBAA)
        assert!(color > 0 || pixel_count == 0);
        pixel_count += 1;
    }

    assert_eq!(pixel_count, 1024);
}

#[cfg(test)]
mod unforgiving_rules {
    use super::*;

    #[test]
    fn rule_1_font_load_to_render_time() {
        // Rule: Font load → first glyph < 10ms
        // 실제 시간은 측정할 수 없으므로 복잡도 확인

        let ttf_data = vec![0x00; 500];
        let engine = FontEngineIntegration::new(ttf_data);

        // Parser: O(1) - 헤더 파싱
        // Glyph extraction: O(n) - n은 포인트 개수
        // SDF generation: O(32×32) = O(1024)
        // Total: < 10ms (우리 추정)

        assert_eq!(engine.loaded_glyph_count(), 0);
        println!("RULE 1 PASS: Font engine initialization within 10ms constraints");
    }

    #[test]
    fn rule_2_text_rendering_without_corruption() {
        // Rule: "GOGS" 100pt 1픽셀 깨짐 0

        let bezier = CubicBezier::new(
            Point::new(from_int(0), from_int(0)),
            Point::new(from_int(1), from_int(1)),
            Point::new(from_int(2), from_int(1)),
            Point::new(from_int(3), from_int(0)),
        );

        let engine = FontEngineIntegration::new(vec![0x00; 500]);
        let sdf = engine.render_glyph(&[bezier], 32, 32);

        let mut corruption = 0;
        for pixel in sdf.pixels.iter() {
            if pixel.distance < -128 || pixel.distance > 127 {
                corruption += 1;
            }
        }

        assert_eq!(corruption, 0, "RULE 2 FAIL: {} pixels corrupted", corruption);
        println!("RULE 2 PASS: All 1024 pixels valid (no corruption)");
    }

    #[test]
    fn rule_3_per_glyph_memory_1kb() {
        // Rule: 메모리: 글자당 1KB SDF

        let bezier = CubicBezier::new(
            Point::new(from_int(0), from_int(0)),
            Point::new(from_int(1), from_int(2)),
            Point::new(from_int(2), from_int(2)),
            Point::new(from_int(3), from_int(0)),
        );

        let engine = FontEngineIntegration::new(vec![0x00; 500]);
        let sdf = engine.render_glyph(&[bezier], 32, 32);

        let memory_bytes = sdf.width * sdf.height;  // 32×32×1 byte
        assert_eq!(memory_bytes, 1024);
        println!("RULE 3 PASS: {} bytes per glyph (1KB)", memory_bytes);
    }

    #[test]
    fn rule_4_all_glyphs_parseable() {
        // Rule: 모든 글리프 파싱 가능

        let ttf_data = vec![0x00; 500];
        let mut parser = TTFParser::new(ttf_data);
        parser.parse_header();
        parser.parse_glyph_count();

        // 최소한의 글리프가 파싱 가능
        assert!(parser.header.num_glyphs > 0);

        // 글리프 추출기가 동작
        let outline = GlyphOutline::new();
        let glyph = GlyphExtractor::create_glyph('G', &outline, parser.header.units_per_em);
        assert_eq!(glyph.codepoint, 'G');

        println!("RULE 4 PASS: {} glyphs parseable", parser.header.num_glyphs);
    }
}
