// Green-Distributed-Fabric Layer 2: Green Scheduler
// workload_consolidator.fl - 태스크 통합 및 배치 스케줄러
// 재사용: Phase 9 classifyWorkload()

// ─────────────────────────────────────────────────────────────────
// MicroTask: 마이크로 태스크
// ─────────────────────────────────────────────────────────────────

#[derive(Clone, Debug)]
pub struct MicroTask {
    pub task_id: u32,
    pub name: String,
    pub cpu_load: f64,              // 0.0-1.0
    pub deadline_ms: u32,           // 실행 deadline
    pub power_budget_mw: f64,       // 허용 전력 예산
    pub is_deferrable: bool,        // 지연 가능 여부
    pub consolidation_group: u32,   // 통합 그룹 ID
}

// ─────────────────────────────────────────────────────────────────
// ConsolidationStrategy: 통합 전략
// ─────────────────────────────────────────────────────────────────

#[derive(Clone, Debug, PartialEq)]
pub enum ConsolidationStrategy {
    TimeSlice,      // 시간 슬라이스 기반
    LoadBased,      // 부하 기반
    DeadlineAware,  // deadline 순
}

// ─────────────────────────────────────────────────────────────────
// ConsolidationPlan: 통합 계획
// ─────────────────────────────────────────────────────────────────

#[derive(Clone, Debug)]
pub struct ConsolidationPlan {
    pub groups: Vec<Vec<MicroTask>>,        // 통합 그룹
    pub inter_group_sleep_ms: Vec<u32>,     // 그룹 간 슬립
    pub expected_c6_ratio: f64,             // 예상 DeepSleep 비율
    pub power_saving_mw: f64,               // 예상 절감
}

impl ConsolidationPlan {
    pub fn total_active_time_ms(&self) -> u32 {
        self.groups.iter()
            .flat_map(|g| g.iter().map(|t| t.deadline_ms))
            .sum()
    }

    pub fn total_idle_time_ms(&self) -> u32 {
        self.inter_group_sleep_ms.iter().sum()
    }
}

// ─────────────────────────────────────────────────────────────────
// WorkloadConsolidator: 워크로드 통합기
// ─────────────────────────────────────────────────────────────────

pub struct WorkloadConsolidator {
    pub pending_tasks: Vec<MicroTask>,
    pub active_groups: Vec<Vec<MicroTask>>,
    strategy: ConsolidationStrategy,
    consolidation_window_ms: u32,   // 기본 100ms
    group_counter: u32,
}

impl WorkloadConsolidator {
    pub fn new(strategy: ConsolidationStrategy) -> WorkloadConsolidator {
        WorkloadConsolidator {
            pending_tasks: Vec::new(),
            active_groups: Vec::new(),
            strategy,
            consolidation_window_ms: 100,
            group_counter: 0,
        }
    }

    pub fn submit_task(&mut self, task: MicroTask) {
        self.pending_tasks.push(task);
    }

    pub fn classify_power_profile(&self, task: &MicroTask) -> String {
        // Phase 9 classifyWorkload() 구조 동일 (4분류)
        if task.cpu_load > 0.7 {
            "compute_intensive".to_string()
        } else if task.deadline_ms < 10 {
            "latency_critical".to_string()
        } else if task.is_deferrable {
            "deferrable".to_string()
        } else {
            "background".to_string()
        }
    }

    pub fn build_consolidation_plan(&mut self) -> ConsolidationPlan {
        // 1. deferrable 태스크 식별
        let deferrable: Vec<_> = self.pending_tasks.iter()
            .filter(|t| t.is_deferrable)
            .cloned()
            .collect();

        let critical: Vec<_> = self.pending_tasks.iter()
            .filter(|t| !t.is_deferrable)
            .cloned()
            .collect();

        // 2. deadline 순 정렬
        let mut all_sorted = critical.clone();
        all_sorted.extend(deferrable);
        all_sorted.sort_by_key(|t| t.deadline_ms);

        // 3. 100ms 윈도우 내 배치 그룹핑
        let mut groups = Vec::new();
        let mut current_group = Vec::new();
        let mut current_time = 0u32;

        for task in all_sorted {
            if current_time + task.deadline_ms > self.consolidation_window_ms
                && !current_group.is_empty()
            {
                groups.push(current_group.clone());
                current_group.clear();
                current_time = 0;
            }
            current_group.push(task);
            current_time += task.deadline_ms;
        }

        if !current_group.is_empty() {
            groups.push(current_group);
        }

        // 4. 그룹 간 C6 슬립 삽입 (50ms)
        let mut sleep_times = vec![50u32; groups.len()];
        if !sleep_times.is_empty() {
            sleep_times[sleep_times.len() - 1] = 0; // 마지막은 슬립 없음
        }

        // 5. 예상 효과 계산
        let active_time: u32 = groups.iter()
            .flat_map(|g| g.iter().map(|t| t.deadline_ms))
            .sum();

        let total_time = active_time + sleep_times.iter().sum::<u32>();
        let idle_ratio = (sleep_times.iter().sum::<u32>() as f64) / (total_time as f64).max(1.0);

        ConsolidationPlan {
            groups,
            inter_group_sleep_ms: sleep_times,
            expected_c6_ratio: idle_ratio,
            power_saving_mw: idle_ratio * 100.0, // 근사
        }
    }

    pub fn execute_plan(&mut self, _plan: &ConsolidationPlan) {
        // 실제 스케줄 실행 (시뮬레이션)
        self.pending_tasks.clear();
    }

    pub fn consolidation_efficiency(&self) -> f64 {
        // 절감된 wake-up 횟수 비율
        if self.active_groups.is_empty() {
            return 0.0;
        }

        let original_wakeups = self.pending_tasks.len() as f64;
        let consolidated_wakeups = self.active_groups.len() as f64;

        if original_wakeups > 0.0 {
            1.0 - (consolidated_wakeups / original_wakeups)
        } else {
            0.0
        }
    }
}

// ─────────────────────────────────────────────────────────────────
// 테스트
// ─────────────────────────────────────────────────────────────────

mod tests {
    use super::*;

    #[test]
    fn test_micro_task_creation() {
        let task = MicroTask {
            task_id: 1,
            name: "Task1".to_string(),
            cpu_load: 0.5,
            deadline_ms: 50,
            power_budget_mw: 100.0,
            is_deferrable: true,
            consolidation_group: 0,
        };
        assert_eq!(task.task_id, 1);
    }

    #[test]
    fn test_consolidation_plan_active_time() {
        let plan = ConsolidationPlan {
            groups: vec![
                vec![MicroTask {
                    task_id: 1,
                    name: "T1".to_string(),
                    cpu_load: 0.5,
                    deadline_ms: 50,
                    power_budget_mw: 100.0,
                    is_deferrable: false,
                    consolidation_group: 0,
                }],
            ],
            inter_group_sleep_ms: vec![50],
            expected_c6_ratio: 0.5,
            power_saving_mw: 50.0,
        };
        assert_eq!(plan.total_active_time_ms(), 50);
    }

    #[test]
    fn test_workload_consolidator_creation() {
        let consolidator = WorkloadConsolidator::new(ConsolidationStrategy::DeadlineAware);
        assert_eq!(consolidator.pending_tasks.len(), 0);
    }

    #[test]
    fn test_submit_task() {
        let mut consolidator = WorkloadConsolidator::new(ConsolidationStrategy::TimeSlice);

        let task = MicroTask {
            task_id: 1,
            name: "Task1".to_string(),
            cpu_load: 0.5,
            deadline_ms: 50,
            power_budget_mw: 100.0,
            is_deferrable: true,
            consolidation_group: 0,
        };

        consolidator.submit_task(task);
        assert_eq!(consolidator.pending_tasks.len(), 1);
    }

    #[test]
    fn test_classify_power_profile() {
        let consolidator = WorkloadConsolidator::new(ConsolidationStrategy::LoadBased);

        let task = MicroTask {
            task_id: 1,
            name: "Compute".to_string(),
            cpu_load: 0.9,
            deadline_ms: 100,
            power_budget_mw: 100.0,
            is_deferrable: false,
            consolidation_group: 0,
        };

        let profile = consolidator.classify_power_profile(&task);
        assert_eq!(profile, "compute_intensive");
    }

    #[test]
    fn test_build_consolidation_plan() {
        let mut consolidator = WorkloadConsolidator::new(ConsolidationStrategy::DeadlineAware);

        for i in 0..5 {
            let task = MicroTask {
                task_id: i,
                name: format!("Task{}", i),
                cpu_load: 0.5,
                deadline_ms: 20,
                power_budget_mw: 100.0,
                is_deferrable: i % 2 == 0,
                consolidation_group: 0,
            };
            consolidator.submit_task(task);
        }

        let plan = consolidator.build_consolidation_plan();
        assert!(plan.groups.len() > 0);
    }
}
