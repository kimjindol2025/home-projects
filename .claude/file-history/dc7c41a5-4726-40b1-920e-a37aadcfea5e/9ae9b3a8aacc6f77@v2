        let layer = DashboardLayer::new();
        assert!(
            layer.get_metrics_count() >= 12,
            "RULE 2: Must expose at least 12 metrics (target: 49)"
        );
    }

    #[test]
    fn rule_3_alert_rule_configuration() {
        // Rule: 10가지 무관용 알림 규칙 모두 구성됨
        let rules = UnforgivingAlertRules::create_all();
        assert_eq!(
            rules.len(),
