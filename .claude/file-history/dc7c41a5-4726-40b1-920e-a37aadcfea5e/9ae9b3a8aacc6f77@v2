#[test]
fn test_e2e_dashboard_setup() {
    // 완전한 대시보드 시스템 설정 및 초기화
    let dashboard = DashboardLayer::new();

    assert!(dashboard.enabled);
    assert_eq!(dashboard.get_panel_count(), 4);
    assert_eq!(dashboard.get_alert_rules_count(), 10);
    assert!(dashboard.get_metrics_count() > 0);
}

#[test]
fn test_4_panel_grafana_dashboard() {
    // 4가지 Grafana 패널 검증
    let dashboard = DefaultPanels::create_default_dashboard();

    assert_eq!(dashboard.get_panels_count(), 4);

    // Panel 1: Energy Metrics
    let panel1 = &dashboard.panels[0];
    assert_eq!(panel1.title, "Energy Metrics");
    assert!(panel1.targets.len() >= 3);

    // Panel 2: Performance Metrics
    let panel2 = &dashboard.panels[1];
    assert_eq!(panel2.title, "Performance Metrics");
    assert!(panel2.targets.len() >= 3);

    // Panel 3: Cluster Status
    let panel3 = &dashboard.panels[2];
    assert_eq!(panel3.title, "Cluster Status");
    assert!(panel3.targets.len() >= 5);

    // Panel 4: Learning Progress
    let panel4 = &dashboard.panels[3];
    assert_eq!(panel4.title, "Learning Progress");
    assert!(panel4.targets.len() >= 4);
}

#[test]
fn test_49_metrics_prometheus_export() {
    // 49개 메트릭 Prometheus 형식 내보내기
    let metrics = GrafanaPanelMetrics::new();
    let registry = metrics.to_registry();

    let prometheus_export = registry.export();

    assert!(!prometheus_export.is_empty());
    assert!(prometheus_export.contains("green_fabric_power"));
    assert!(prometheus_export.contains("green_fabric_battery"));
    assert!(prometheus_export.contains("green_fabric_dvfs"));
    assert!(prometheus_export.contains("green_fabric_consensus"));
    assert!(prometheus_export.contains("green_fabric_learning"));

    let metric_count = prometheus_export.matches("# HELP").count();
    assert!(metric_count >= 12);  // 최소 12개 메트릭
}

#[test]
fn test_10_unforgiving_alert_rules() {
    // 10가지 무관용 알림 규칙 검증
    let rules = UnforgivingAlertRules::create_all();

    assert_eq!(rules.len(), 10);

    // 각 규칙이 정상적으로 구성되었는지 확인
    for rule in &rules {
        assert!(!rule.name.is_empty());
        assert!(!rule.metric.is_empty());
        assert!(!rule.description.is_empty());
    }

    // 규칙별 검증
    let rule_names: Vec<&str> = rules.iter().map(|r| r.name.as_str()).collect();

    assert!(rule_names.contains(&"HighPowerConsumption"));
    assert!(rule_names.contains(&"LowBattery"));
    assert!(rule_names.contains(&"HighDVFSLatency"));
    assert!(rule_names.contains(&"HighConsensusLatency"));
    assert!(rule_names.contains(&"LowPatternAccuracy"));
}

#[test]
fn test_alert_triggers() {
    // 알림 조건 트리거 검증
    let rule_high_power = AlertRule::new(
        "HighPower",
        "power",
        AlertCondition::GreaterThan(250.0),
    );

    // 경고 발생 테스트
    assert!(!rule_high_power.evaluate(150.0));  // 정상
    assert!(rule_high_power.evaluate(300.0));   // 경고 발생

    let rule_low_battery = AlertRule::new(
        "LowBattery",
        "battery",
        AlertCondition::LessThan(20.0),
    );

    assert!(rule_low_battery.evaluate(10.0));   // 경고 발생
    assert!(!rule_low_battery.evaluate(50.0));  // 정상
}

#[test]
fn test_alert_manager_evaluation() {
    // AlertManager 평가 엔진
    let mut manager = crate::dashboard::AlertManager::new();

    let rule = AlertRule::new(
        "TestAlert",
        "test_metric",
        AlertCondition::GreaterThan(100.0),
    );

    manager.register_rule(rule);

    // 메트릭 평가
    let alerts1 = manager.evaluate("test_metric", 50.0);
    assert_eq!(alerts1.len(), 0);  // 경고 안 함

    let alerts2 = manager.evaluate("test_metric", 150.0);
    assert_eq!(alerts2.len(), 1);  // 경고 발생
}

#[test]
fn test_dashboard_json_export() {
    // 대시보드 JSON 형식 내보내기
    let mut dashboard = GrafanaDashboard::new("Test Dashboard", "test-uid");

    dashboard.add_panel(DefaultPanels::panel_1_energy_metrics());
    dashboard.add_panel(DefaultPanels::panel_2_performance_metrics());

    let json = dashboard.export_json();

    assert!(json.contains("Test Dashboard"));
    assert!(json.contains("test-uid"));
    assert!(json.contains("Energy Metrics"));
    assert!(json.contains("Performance Metrics"));
}

