#[test]
fn test_multi_metric_alert_evaluation() {
    // 다중 메트릭 동시 평가
    let mut manager = crate::dashboard::AlertManager::new();

    UnforgivingAlertRules::register_all(&mut manager);

    // 여러 메트릭 동시 평가
    let alerts1 = manager.evaluate("green_fabric_power_instantaneous_mw", 300.0);
    let alerts2 = manager.evaluate("green_fabric_battery_level_percent", 10.0);
    let alerts3 = manager.evaluate("green_fabric_consensus_latency_ms", 250.0);

    assert!(alerts1.len() > 0 || alerts2.len() > 0 || alerts3.len() > 0);
}

