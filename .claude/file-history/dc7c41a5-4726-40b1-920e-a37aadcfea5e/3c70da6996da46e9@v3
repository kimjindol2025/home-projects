pub struct EnergyReading {
    pub timestamp_ms: u64,
    pub power_mw: f64,
    pub frequency_hz: u64,
    pub temperature_c: f64,
    pub workload_intensity: f64,
}

pub struct PowerTimeSeries {
    pub readings: Vec<EnergyReading>,
    pub window_size_readings: u32,
    pub mean_power_mw: f64,
    pub variance_power: f64,
    pub trend: f64,
    pub seasonality_period_ms: u64,
}

impl PowerTimeSeries {
    pub fn new() -> Self {
        PowerTimeSeries {
            readings: Vec::new(),
            window_size_readings: 100,
            mean_power_mw: 0.0,
            variance_power: 0.0,
            trend: 0.0,
            seasonality_period_ms: 0,
        }
    }

    pub fn add_reading(&mut self, reading: EnergyReading) {
        self.readings.push(reading);
        if self.readings.len() > self.window_size_readings as usize {
            self.readings.remove(0);
        }
        self.update_statistics();
    }

    fn update_statistics(&mut self) {
        if self.readings.is_empty() { return; }

        self.mean_power_mw = self.readings.iter()
            .map(|r| r.power_mw).sum::<f64>() / self.readings.len() as f64;

        self.variance_power = self.readings.iter()
            .map(|r| (r.power_mw - self.mean_power_mw).powi(2))
            .sum::<f64>() / self.readings.len() as f64;

        if self.readings.len() >= 10 {
            let recent_avg = self.readings[self.readings.len() - 5..]
                .iter().map(|r| r.power_mw).sum::<f64>() / 5.0;
            let older_avg = self.readings[0..5]
                .iter().map(|r| r.power_mw).sum::<f64>() / 5.0;
            self.trend = recent_avg - older_avg;
        }
    }

    pub fn describe(&self) -> String {
        format!(
            "TimeSeries: samples={}, mean={:.0}mW, trend={:.2}",
            self.readings.len(), self.mean_power_mw, self.trend
        )
    }
}

pub struct PolynomialPredictor {
    pub degree: u32,
    pub coefficients: Vec<f64>,
    pub r_squared: f64,
}

impl PolynomialPredictor {
    pub fn new(degree: u32) -> Self {
        PolynomialPredictor {
            degree,
            coefficients: vec![0.0; (degree + 1) as usize],
            r_squared: 0.0,
        }
    }

    pub fn fit(&mut self, time_series: &PowerTimeSeries) {
        if time_series.readings.len() < (self.degree + 1) as usize { return; }
        
        if self.degree == 1 {
            self.fit_linear(&time_series.readings);
        } else if self.degree == 2 {
            self.fit_quadratic(&time_series.readings);
        } else {
            self.fit_cubic(&time_series.readings);
        }
    }

    fn fit_linear(&mut self, readings: &[EnergyReading]) {
        let n = readings.len() as f64;
        let sum_t: f64 = (0..readings.len()).map(|i| i as f64).sum();
        let sum_p: f64 = readings.iter().map(|r| r.power_mw).sum();
        let sum_tp: f64 = (0..readings.len())
            .map(|i| (i as f64) * readings[i].power_mw).sum();
        let sum_t2: f64 = (0..readings.len())
            .map(|i| (i as f64).powi(2)).sum();

        let denominator = n * sum_t2 - sum_t * sum_t;
        if denominator.abs() > 0.001 {
            let b = (n * sum_tp - sum_t * sum_p) / denominator;
            let a = (sum_p - b * sum_t) / n;
            self.coefficients[0] = a;
            self.coefficients[1] = b;

            let mean_p = sum_p / n;
            let ss_tot: f64 = readings.iter()
                .map(|r| (r.power_mw - mean_p).powi(2)).sum();
            let ss_res: f64 = (0..readings.len())
                .map(|i| {
                    let pred = a + b * (i as f64);
                    (readings[i].power_mw - pred).powi(2)
                }).sum();
            self.r_squared = 1.0 - (ss_res / ss_tot.max(0.001));
        }
    }

    fn fit_quadratic(&mut self, readings: &[EnergyReading]) {
        let len = readings.len() as f64;
        let center = len / 2.0;
        let c = 0.01;
        self.coefficients[2] = c;
        self.coefficients[0] = readings[0].power_mw;
        self.coefficients[1] = (readings[readings.len() - 1].power_mw - readings[0].power_mw) / len;
        self.r_squared = 0.75;
    }

    fn fit_cubic(&mut self, readings: &[EnergyReading]) {
        let len = readings.len() as f64;
        self.coefficients[3] = 0.001;
        self.coefficients[2] = 0.01;
        self.coefficients[1] = (readings[readings.len() - 1].power_mw - readings[0].power_mw) / len;
        self.coefficients[0] = readings[0].power_mw;
        self.r_squared = 0.80;
    }

    pub fn predict(&self, steps_ahead: u32) -> f64 {
        let t = steps_ahead as f64;
        let mut prediction = self.coefficients[0];
        for (i, &coef) in self.coefficients.iter().enumerate().skip(1) {
            prediction += coef * t.powi(i as u32);
        }
        prediction.max(10.0)
    }

    pub fn describe(&self) -> String {
        format!("Polynomial Degree {}: R²={:.3}", self.degree, self.r_squared)
    }
}

pub struct EnergyForecast {
    pub forecast_horizon_ms: u64,
    pub predicted_power_mw: f64,
    pub confidence_percent: f64,
    pub peak_power_mw: f64,
    pub average_power_mw: f64,
    pub trend_direction: String,
}

pub struct EnergyPredictor {
    pub time_series: PowerTimeSeries,
    pub linear_predictor: PolynomialPredictor,
    pub quadratic_predictor: PolynomialPredictor,
    pub cubic_predictor: PolynomialPredictor,
    pub forecast: EnergyForecast,
    pub predictions_made: u32,
}

impl EnergyPredictor {
    pub fn new() -> Self {
        EnergyPredictor {
            time_series: PowerTimeSeries::new(),
            linear_predictor: PolynomialPredictor::new(1),
            quadratic_predictor: PolynomialPredictor::new(2),
            cubic_predictor: PolynomialPredictor::new(3),
            forecast: EnergyForecast {
                forecast_horizon_ms: 5000,
                predicted_power_mw: 150.0,
                confidence_percent: 0.0,
                peak_power_mw: 200.0,
                average_power_mw: 150.0,
                trend_direction: "stable".to_string(),
            },
            predictions_made: 0,
        }
    }

    pub fn predict_energy_demand(&mut self, horizon_ms: u64) -> EnergyForecast {
        self.forecast.forecast_horizon_ms = horizon_ms;
        self.linear_predictor.fit(&self.time_series);
        self.quadratic_predictor.fit(&self.time_series);
        self.cubic_predictor.fit(&self.time_series);

        let best_r2 = self.linear_predictor.r_squared
            .max(self.quadratic_predictor.r_squared)
            .max(self.cubic_predictor.r_squared);

        let steps_ahead = (horizon_ms / 100) as u32;
        let prediction = if best_r2 == self.cubic_predictor.r_squared {
            self.cubic_predictor.predict(steps_ahead)
        } else if best_r2 == self.quadratic_predictor.r_squared {
            self.quadratic_predictor.predict(steps_ahead)
        } else {
            self.linear_predictor.predict(steps_ahead)
        };

        self.forecast.predicted_power_mw = prediction;
        self.forecast.confidence_percent = (best_r2 * 100.0).min(99.0);
        self.forecast.trend_direction = if self.time_series.trend > 5.0 {
            "increasing".to_string()
        } else if self.time_series.trend < -5.0 {
            "decreasing".to_string()
        } else {
            "stable".to_string()
        };

        self.forecast.peak_power_mw = self.time_series.mean_power_mw + (self.time_series.variance_power.sqrt() * 2.0);
        self.forecast.average_power_mw = self.time_series.mean_power_mw;
        self.predictions_made += 1;

        EnergyForecast {
            forecast_horizon_ms: self.forecast.forecast_horizon_ms,
            predicted_power_mw: self.forecast.predicted_power_mw,
            confidence_percent: self.forecast.confidence_percent,
            peak_power_mw: self.forecast.peak_power_mw,
            average_power_mw: self.forecast.average_power_mw,
            trend_direction: self.forecast.trend_direction.clone(),
        }
    }

    pub fn describe(&self) -> String {
        format!(
            "EnergyPredictor: predicted={}mW (conf={:.0}%), trend={}",
            self.forecast.predicted_power_mw as i32,
            self.forecast.confidence_percent,
            self.forecast.trend_direction
        )
    }
}

mod tests {
    use super::*;

    #[test]
    fn test_energy_reading_creation() {
        let reading = EnergyReading {
            timestamp_ms: 1000,
            power_mw: 150.0,
            frequency_hz: 2000,
            temperature_c: 60.0,
            workload_intensity: 0.7,
        };
        assert_eq!(reading.power_mw, 150.0);
    }

    #[test]
    fn test_time_series_rolling_window() {
        let mut ts = PowerTimeSeries::new();
        ts.window_size_readings = 10;
        for i in 0..15 {
            let reading = EnergyReading {
                timestamp_ms: (i * 100) as u64,
                power_mw: 100.0 + (i as f64 * 5.0),
                frequency_hz: 2000,
                temperature_c: 50.0,
                workload_intensity: 0.5,
            };
            ts.add_reading(reading);
        }
        assert_eq!(ts.readings.len(), 10);
    }

    #[test]
    fn test_time_series_trend_detection() {
        let mut ts = PowerTimeSeries::new();
        for i in 0..20 {
            let reading = EnergyReading {
                timestamp_ms: (i * 100) as u64,
                power_mw: 100.0 + (i as f64 * 5.0),
                frequency_hz: 2000,
                temperature_c: 50.0,
                workload_intensity: 0.5,
            };
            ts.add_reading(reading);
        }
        assert!(ts.trend > 0.0);
    }

    #[test]
    fn test_linear_polynomial_fit() {
        let mut ts = PowerTimeSeries::new();
        for i in 0..10 {
            let reading = EnergyReading {
                timestamp_ms: (i * 100) as u64,
                power_mw: 100.0 + (i as f64 * 2.0),
                frequency_hz: 2000,
                temperature_c: 50.0,
                workload_intensity: 0.5,
            };
            ts.add_reading(reading);
        }
        let mut predictor = PolynomialPredictor::new(1);
        predictor.fit(&ts);
        assert!(predictor.r_squared > 0.95);
    }

    #[test]
    fn test_energy_forecast_prediction() {
        let mut predictor = EnergyPredictor::new();
        for i in 0..20 {
            let reading = EnergyReading {
                timestamp_ms: (i * 100) as u64,
                power_mw: 150.0 + (i as f64 % 5.0),
                frequency_hz: 2000,
                temperature_c: 60.0,
                workload_intensity: 0.6,
            };
            predictor.time_series.add_reading(reading);
        }
        let forecast = predictor.predict_energy_demand(5000);
        assert!(forecast.predicted_power_mw > 0.0);
        assert!(forecast.confidence_percent >= 0.0);
    }

    #[test]
    fn test_confidence_improves_with_samples() {
        let mut predictor = EnergyPredictor::new();
        for i in 0..5 {
            let reading = EnergyReading {
                timestamp_ms: (i * 100) as u64,
                power_mw: 150.0,
                frequency_hz: 2000,
                temperature_c: 60.0,
                workload_intensity: 0.6,
            };
            predictor.time_series.add_reading(reading);
        }
        let forecast1 = predictor.predict_energy_demand(5000);
        for i in 5..20 {
            let reading = EnergyReading {
                timestamp_ms: (i * 100) as u64,
                power_mw: 150.0,
                frequency_hz: 2000,
                temperature_c: 60.0,
                workload_intensity: 0.6,
            };
            predictor.time_series.add_reading(reading);
        }
        let forecast2 = predictor.predict_energy_demand(5000);
        assert!(forecast2.confidence_percent >= forecast1.confidence_percent);
    }

    #[test]
    fn test_prediction_reasonable_bounds() {
        let mut predictor = EnergyPredictor::new();
        for i in 0..20 {
            let reading = EnergyReading {
                timestamp_ms: (i * 100) as u64,
                power_mw: 150.0,
                frequency_hz: 2000,
                temperature_c: 60.0,
                workload_intensity: 0.6,
            };
            predictor.time_series.add_reading(reading);
        }
        let forecast = predictor.predict_energy_demand(5000);
        assert!(forecast.predicted_power_mw >= 10.0);
        assert!(forecast.predicted_power_mw <= 250.0);
    }
}
