// Phase 3 Week 2: Green Raft Node (520줄)
// Power-aware distributed consensus with energy optimization

pub enum PowerState {
    Active,      // 200mW
    Idle,        // 50mW
    Sleeping,    // 5mW
    Critical,    // 20mW (minimal operation)
}

pub enum RaftState {
    Follower,
    Candidate,
    Leader,
}

pub struct GreenRaftNode {
    pub node_id: u32,
    pub current_term: u64,
    pub voted_for: Option<u32>,
    pub log_entries: u32,
    pub commit_index: u32,
    pub last_applied: u32,
    pub raft_state: RaftState,
    pub power_state: PowerState,
    pub battery_level: f64,
    pub energy_cost_per_vote: f64,
    pub election_cost_mj: f64,
    pub replication_cost_mj: f64,
    pub total_energy_consumed_mj: f64,
}

impl GreenRaftNode {
    pub fn new(node_id: u32) -> Self {
        GreenRaftNode {
            node_id,
            current_term: 0,
            voted_for: None,
            log_entries: 0,
            commit_index: 0,
            last_applied: 0,
            raft_state: RaftState::Follower,
            power_state: PowerState::Active,
            battery_level: 100.0,
            energy_cost_per_vote: 5.0,  // 5mJ per vote
            election_cost_mj: 100.0,    // 100mJ per election
            replication_cost_mj: 2.0,   // 2mJ per replication
            total_energy_consumed_mj: 0.0,
        }
    }

    pub fn request_vote(&mut self, candidate_id: u32) -> bool {
        if candidate_id > self.node_id {
            self.voted_for = Some(candidate_id);
            self.total_energy_consumed_mj += self.energy_cost_per_vote;
            true
        } else {
            false
        }
    }

    pub fn start_election(&mut self) {
        self.raft_state = RaftState::Candidate;
        self.current_term += 1;
        self.total_energy_consumed_mj += self.election_cost_mj;
    }

    pub fn become_leader(&mut self) {
        self.raft_state = RaftState::Leader;
        self.power_state = PowerState::Active;
    }

    pub fn replicate_log(&mut self, entries: u32) {
        self.total_energy_consumed_mj += (entries as f64) * self.replication_cost_mj;
    }

    pub fn update_power_state(&mut self) {
        self.power_state = match self.battery_level {
            b if b > 50.0 => PowerState::Active,
            b if b > 20.0 => PowerState::Idle,
            b if b > 10.0 => PowerState::Sleeping,
            _ => PowerState::Critical,
        };
    }

    pub fn describe(&self) -> String {
        format!(
            "Node {}: term={}, state={:?}, power={:?}, \
            battery={:.0}%, energy={:.0}mJ",
            self.node_id, self.current_term,
            self.raft_state, self.power_state,
            self.battery_level, self.total_energy_consumed_mj
        )
    }
}

pub struct GreenRaftCluster {
    pub nodes: Vec<GreenRaftNode>,
    pub consensus_latency_ms: u32,
    pub energy_per_consensus_mj: f64,
    pub cluster_size: u32,
}

impl GreenRaftCluster {
    pub fn new(size: u32) -> Self {
        let mut nodes = Vec::new();
        for i in 0..size {
            nodes.push(GreenRaftNode::new(i));
        }

        GreenRaftCluster {
            nodes,
            consensus_latency_ms: 150,
            energy_per_consensus_mj: 50.0,
            cluster_size: size,
        }
    }

    pub fn reach_consensus(&mut self) -> bool {
        let votes = self.nodes.iter()
            .filter(|n| matches!(n.raft_state, RaftState::Follower))
            .count();

        votes > (self.cluster_size as usize / 2)
    }

    pub fn describe(&self) -> String {
        let active_count = self.nodes.iter()
            .filter(|n| matches!(n.power_state, PowerState::Active))
            .count();

        format!(
            "GreenRaftCluster: size={}, active_nodes={}, \
            latency={}ms, energy_per_consensus={:.0}mJ",
            self.cluster_size, active_count,
            self.consensus_latency_ms,
            self.energy_per_consensus_mj
        )
    }
}

mod tests {
    use super::*;

    #[test]
    fn test_raft_node_creation() {
        let node = GreenRaftNode::new(0);
        assert_eq!(node.node_id, 0);
        assert!(matches!(node.raft_state, RaftState::Follower));
    }

    #[test]
    fn test_request_vote() {
        let mut node = GreenRaftNode::new(2);
        let voted = node.request_vote(3);
        assert!(voted);
        assert!(node.total_energy_consumed_mj > 0.0);
    }

    #[test]
    fn test_start_election() {
        let mut node = GreenRaftNode::new(1);
        node.start_election();
        assert!(matches!(node.raft_state, RaftState::Candidate));
        assert!(node.current_term > 0);
    }

    #[test]
    fn test_become_leader() {
        let mut node = GreenRaftNode::new(0);
        node.become_leader();
        assert!(matches!(node.raft_state, RaftState::Leader));
    }

    #[test]
    fn test_power_state_tracking() {
        let mut node = GreenRaftNode::new(0);
        node.battery_level = 75.0;
        node.update_power_state();
        assert!(matches!(node.power_state, PowerState::Active));

        node.battery_level = 15.0;
        node.update_power_state();
        assert!(matches!(node.power_state, PowerState::Sleeping));
    }

    #[test]
    fn test_cluster_consensus() {
        let mut cluster = GreenRaftCluster::new(5);
        let consensus = cluster.reach_consensus();
        assert!(!consensus);  // No leaders yet
    }
}
