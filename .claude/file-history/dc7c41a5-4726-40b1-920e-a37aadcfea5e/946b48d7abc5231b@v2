use std::collections::HashMap;

#[derive(Clone, Debug)]
pub enum MetricType {
    Counter,      // 누적값 (증가만 가능)
    Gauge,        // 현재값 (증감 모두)
    Histogram,    // 분포 (버킷)
    Summary,      // 요약 (분위수)
}

#[derive(Clone, Debug)]
pub struct PrometheusMetric {
    pub name: String,
    pub metric_type: MetricType,
    pub help_text: String,
    pub labels: HashMap<String, String>,
    pub value: f64,
    pub timestamp_ms: u64,
}

impl PrometheusMetric {
    pub fn new(name: &str, metric_type: MetricType, help: &str) -> Self {
        PrometheusMetric {
            name: name.to_string(),
            metric_type,
            help_text: help.to_string(),
            labels: HashMap::new(),
            value: 0.0,
            timestamp_ms: get_timestamp_ms(),
        }
    }

    pub fn with_label(mut self, key: &str, value: &str) -> Self {
        self.labels.insert(key.to_string(), value.to_string());
        self
    }

    pub fn with_value(mut self, value: f64) -> Self {
        self.value = value;
        self
    }

    pub fn to_prometheus_format(&self) -> String {
        let mut labels_str = String::new();

        if !self.labels.is_empty() {
            labels_str.push('{');
            let label_pairs: Vec<String> = self.labels.iter()
                .map(|(k, v)| format!("{}=\"{}\"", k, v))
                .collect();
            labels_str.push_str(&label_pairs.join(","));
            labels_str.push('}');
        }

        format!(
            "{}{} {} {}",
            self.name,
            labels_str,
            self.value,
            self.timestamp_ms
        )
    }
}

pub struct PrometheusRegistry {
    pub metrics: HashMap<String, PrometheusMetric>,
}

impl PrometheusRegistry {
    pub fn new() -> Self {
        PrometheusRegistry {
            metrics: HashMap::new(),
        }
    }

    pub fn register(&mut self, metric: PrometheusMetric) {
        self.metrics.insert(metric.name.clone(), metric);
    }

    pub fn update_metric(&mut self, name: &str, value: f64) {
        if let Some(metric) = self.metrics.get_mut(name) {
            metric.value = value;
            metric.timestamp_ms = get_timestamp_ms();
        }
    }

    pub fn increment_counter(&mut self, name: &str, delta: f64) {
        if let Some(metric) = self.metrics.get_mut(name) {
            metric.value += delta;
            metric.timestamp_ms = get_timestamp_ms();
        }
    }

    pub fn get_metrics_count(&self) -> usize {
        self.metrics.len()
    }

    pub fn export(&self) -> String {
        let mut output = String::new();

        for (_, metric) in self.metrics.iter() {
            output.push_str(&format!("# HELP {} {}\n", metric.name, metric.help_text));
            output.push_str(&format!(
                "# TYPE {} {}\n",
                metric.name,
                match metric.metric_type {
                    MetricType::Counter => "counter",
                    MetricType::Gauge => "gauge",
                    MetricType::Histogram => "histogram",
                    MetricType::Summary => "summary",
                }
            ));
            output.push_str(&metric.to_prometheus_format());
            output.push('\n');
        }

        output
    }
}

// 4가지 Grafana 패널용 메트릭 세트
pub struct GrafanaPanelMetrics {
    // Panel 1: Energy Metrics (에너지 메트릭)
    pub power_instantaneous_mw: f64,
    pub power_average_mw: f64,
    pub power_peak_mw: f64,
    pub battery_level_percent: f64,

    // Panel 2: Performance Metrics (성능 메트릭)
    pub dvfs_frequency_mhz: f64,
    pub dvfs_transition_latency_us: f64,
    pub cstate_active: u8,
    pub sleep_entry_latency_us: f64,

    // Panel 3: Cluster Status (클러스터 상태)
    pub node_id: u32,
    pub leader_id: u32,
    pub consensus_latency_ms: u32,
    pub failover_latency_ms: u32,
    pub replicas_in_sync: u8,

    // Panel 4: Learning Progress (학습 진행도)
    pub pattern_accuracy_percent: f64,
    pub prediction_error_percent: f64,
    pub learning_state: u8,
    pub improvement_trend_percent: f64,
}

impl GrafanaPanelMetrics {
    pub fn new() -> Self {
        GrafanaPanelMetrics {
            power_instantaneous_mw: 0.0,
            power_average_mw: 0.0,
            power_peak_mw: 0.0,
            battery_level_percent: 100.0,
            dvfs_frequency_mhz: 2400.0,
            dvfs_transition_latency_us: 8000.0,
            cstate_active: 0,
            sleep_entry_latency_us: 4500.0,
            node_id: 1,
            leader_id: 1,
            consensus_latency_ms: 120,
            failover_latency_ms: 38,
            replicas_in_sync: 3,
            pattern_accuracy_percent: 87.0,
            prediction_error_percent: 8.5,
            learning_state: 4,
            improvement_trend_percent: 5.2,
        }
    }

    pub fn to_registry(&self) -> PrometheusRegistry {
        let mut registry = PrometheusRegistry::new();

        // Panel 1: Energy
        registry.register(
            PrometheusMetric::new(
                "green_fabric_power_instantaneous_mw",
                MetricType::Gauge,
                "Instantaneous power consumption in mW"
            )
            .with_value(self.power_instantaneous_mw)
        );

        registry.register(
            PrometheusMetric::new(
                "green_fabric_power_average_mw",
                MetricType::Gauge,
                "Average power consumption in mW"
            )
            .with_value(self.power_average_mw)
        );

        registry.register(
            PrometheusMetric::new(
                "green_fabric_power_peak_mw",
                MetricType::Gauge,
                "Peak power consumption in mW"
            )
            .with_value(self.power_peak_mw)
        );

        registry.register(
            PrometheusMetric::new(
                "green_fabric_battery_level_percent",
                MetricType::Gauge,
                "Battery level percentage"
            )
            .with_value(self.battery_level_percent)
        );

        // Panel 2: Performance
        registry.register(
            PrometheusMetric::new(
                "green_fabric_dvfs_frequency_mhz",
                MetricType::Gauge,
                "Current DVFS frequency in MHz"
            )
            .with_value(self.dvfs_frequency_mhz)
        );

        registry.register(
            PrometheusMetric::new(
                "green_fabric_dvfs_transition_latency_us",
                MetricType::Gauge,
                "DVFS transition latency in microseconds"
            )
            .with_value(self.dvfs_transition_latency_us)
        );

        registry.register(
            PrometheusMetric::new(
                "green_fabric_cstate_active",
                MetricType::Gauge,
                "Currently active C-state"
            )
            .with_value(self.cstate_active as f64)
        );

        // Panel 3: Cluster
        registry.register(
            PrometheusMetric::new(
                "green_fabric_node_id",
                MetricType::Gauge,
                "Node ID"
            )
            .with_value(self.node_id as f64)
        );

        registry.register(
            PrometheusMetric::new(
                "green_fabric_leader_id",
                MetricType::Gauge,
                "Current leader node ID"
            )
            .with_value(self.leader_id as f64)
        );

        registry.register(
            PrometheusMetric::new(
                "green_fabric_consensus_latency_ms",
                MetricType::Gauge,
                "Consensus latency in milliseconds"
            )
            .with_value(self.consensus_latency_ms as f64)
        );

        registry.register(
            PrometheusMetric::new(
                "green_fabric_failover_latency_ms",
                MetricType::Gauge,
                "Failover latency in milliseconds"
            )
            .with_value(self.failover_latency_ms as f64)
        );

        // Panel 4: Learning
        registry.register(
            PrometheusMetric::new(
                "green_fabric_pattern_accuracy_percent",
                MetricType::Gauge,
                "Pattern recognition accuracy percentage"
            )
            .with_value(self.pattern_accuracy_percent)
        );

        registry.register(
            PrometheusMetric::new(
                "green_fabric_prediction_error_percent",
                MetricType::Gauge,
                "Energy prediction error percentage"
            )
            .with_value(self.prediction_error_percent)
        );

        registry.register(
            PrometheusMetric::new(
                "green_fabric_learning_state",
                MetricType::Gauge,
                "Current learning state (0-4)"
            )
            .with_value(self.learning_state as f64)
        );

        registry.register(
            PrometheusMetric::new(
                "green_fabric_improvement_trend_percent",
                MetricType::Gauge,
                "System improvement trend percentage"
            )
            .with_value(self.improvement_trend_percent)
        );

        registry
    }
}

pub fn get_timestamp_ms() -> u64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_default()
        .as_millis() as u64
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_prometheus_metric_creation() {
        let metric = PrometheusMetric::new(
            "test_metric",
            MetricType::Gauge,
            "Test metric"
        )
        .with_value(42.5)
        .with_label("instance", "localhost");

        assert_eq!(metric.name, "test_metric");
        assert_eq!(metric.value, 42.5);
    }

    #[test]
    fn test_prometheus_format() {
        let metric = PrometheusMetric::new(
            "power_mw",
            MetricType::Gauge,
            "Power in mW"
        )
        .with_value(150.0)
        .with_label("host", "node1");

        let formatted = metric.to_prometheus_format();
        assert!(formatted.contains("power_mw"));
        assert!(formatted.contains("150"));
    }

    #[test]
    fn test_prometheus_registry() {
        let mut registry = PrometheusRegistry::new();

        let m1 = PrometheusMetric::new("m1", MetricType::Counter, "M1")
            .with_value(10.0);
        let m2 = PrometheusMetric::new("m2", MetricType::Gauge, "M2")
            .with_value(20.0);

        registry.register(m1);
        registry.register(m2);

        assert_eq!(registry.get_metrics_count(), 2);
    }

    #[test]
    fn test_registry_update() {
        let mut registry = PrometheusRegistry::new();

        let metric = PrometheusMetric::new("power", MetricType::Gauge, "Power")
            .with_value(100.0);
        registry.register(metric);

        registry.update_metric("power", 150.0);
        assert_eq!(registry.metrics.get("power").unwrap().value, 150.0);
    }

    #[test]
    fn test_grafana_panel_metrics() {
        let panel_metrics = GrafanaPanelMetrics::new();
        let registry = panel_metrics.to_registry();

        assert!(registry.get_metrics_count() >= 12);
    }
}
