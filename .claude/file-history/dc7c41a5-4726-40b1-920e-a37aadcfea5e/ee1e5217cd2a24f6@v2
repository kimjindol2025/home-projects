fn sha256_update(state: map, data: string): map {
    state["message"] = state["message"] + data
    state["length"] = state["length"] + len(data)
    return state
}

fn sha256_rotr(x: i32, n: i32): i32 {
    return (x >> n) | (x << (32 - n))
}

fn sha256_ch(x: i32, y: i32, z: i32): i32 {
    return (x & y) ^ (~x & z)
}

fn sha256_maj(x: i32, y: i32, z: i32): i32 {
    return (x & y) ^ (x & z) ^ (y & z)
}

fn sha256_sigma0(x: i32): i32 {
    return sha256_rotr(x, 2) ^ sha256_rotr(x, 13) ^ sha256_rotr(x, 22)
}

fn sha256_sigma1(x: i32): i32 {
    return sha256_rotr(x, 6) ^ sha256_rotr(x, 11) ^ sha256_rotr(x, 25)
}

fn sha256_gamma0(x: i32): i32 {
    return sha256_rotr(x, 7) ^ sha256_rotr(x, 18) ^ (x >> 3)
}

fn sha256_gamma1(x: i32): i32 {
    return sha256_rotr(x, 17) ^ sha256_rotr(x, 19) ^ (x >> 10)
}

fn sha256_finalize(state: map): string {
    let msg = state["message"]
    let original_length = state["length"]

    # Padding
    let padding_length = (55 - (original_length % 64)) % 64
    let padding = ""
    let i = 0
