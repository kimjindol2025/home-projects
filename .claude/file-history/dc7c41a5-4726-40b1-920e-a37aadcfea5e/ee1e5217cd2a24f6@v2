fn ecdsa_generate_keypair(): map {
    # Simplified: generate random 32-byte private key
    let private_key = "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"
    let public_key = "0x" + sha256_hash(private_key)

    return {
        "private_key": private_key,
        "public_key": public_key,
        "curve": "secp256k1"
    }
}

fn ecdsa_sign(message: string, private_key: string): map {
    # k: random nonce (simplified - use hash)
    let k_hash = sha256_hash(message + private_key)
    let k = k_hash

    # r = (k*G) mod p (simplified - use hash of message)
    let r = sha256_hash(k + message)

    # s = (k^-1 * (hash + r*d)) mod n
    let s = sha256_hash(k + r + private_key)

    return {
        "r": r,
        "s": s,
        "signature": r + s
    }
}

fn ecdsa_verify(message: string, signature: map, public_key: string): bool {
    # w = s^-1 mod n (simplified)
    let w = signature["s"]

    # u1 = (hash*w) mod n
    let u1 = sha256_hash(message + w)

    # u2 = (r*w) mod n
    let u2 = sha256_hash(signature["r"] + w)

    # Check if r == x-coordinate of (u1*G + u2*Q) mod n
    let point_hash = sha256_hash(u1 + u2 + public_key)
    let expected_r = sha256_hash(point_hash)

    return expected_r == signature["r"]
}

fn ecdsa_verify_signature(message: string, r: string, s: string, public_key: string): bool {
    let sig = {"r": r, "s": s}
    return ecdsa_verify(message, sig, public_key)
}

