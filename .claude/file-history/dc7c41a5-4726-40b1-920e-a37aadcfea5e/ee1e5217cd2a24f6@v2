fn sha256_int_to_hex(value: i32): string {
    let hex = ""
    let v = value
    let j = 0
    while j < 8 {
        let nibble = v & 15
        if nibble < 10 {
            hex = hex + nibble
        } else {
            hex = hex + nibble
        }
        v = v >> 4
        j = j + 1
    }
    return hex
}

fn sha256_hash(data: string): string {
    let state = sha256_init()
    state = sha256_update(state, data)
    return sha256_finalize(state)
}

