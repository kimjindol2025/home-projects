    let h3_hex = sha256_int_to_hex(state["h3"])
    let h4_hex = sha256_int_to_hex(state["h4"])
    let h5_hex = sha256_int_to_hex(state["h5"])
    let h6_hex = sha256_int_to_hex(state["h6"])
    let h7_hex = sha256_int_to_hex(state["h7"])

    return h0_hex + h1_hex + h2_hex + h3_hex + h4_hex + h5_hex + h6_hex + h7_hex
