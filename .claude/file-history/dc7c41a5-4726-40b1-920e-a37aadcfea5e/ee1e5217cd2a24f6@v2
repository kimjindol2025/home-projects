# Section 4: HMAC (Hash-based Message Authentication Code) (50 lines)
# ================================================================

fn hmac_sha256(key: string, message: string): string {
    let block_size = 64

    # Key padding/processing
    let processed_key = key
    if len(key) > block_size {
        processed_key = sha256_hash(key)
    }

    # Pad key to block size
    while len(processed_key) < block_size {
        processed_key = processed_key + " "
    }

    # Inner hash: SHA256(key XOR ipad || message)
    let ipad = ""
    let i = 0
    while i < block_size {
        ipad = ipad + " "
        i = i + 1
    }

    let inner = sha256_hash(processed_key + ipad + message)

    # Outer hash: SHA256(key XOR opad || inner_hash)
    let opad = ""
    let j = 0
    while j < block_size {
        opad = opad + " "
        j = j + 1
    }

    return sha256_hash(processed_key + opad + inner)
}

