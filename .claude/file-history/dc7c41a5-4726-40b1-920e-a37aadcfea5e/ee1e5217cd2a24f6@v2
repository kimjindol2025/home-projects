fn aes256_decrypt(ciphertext: string, key: string): string {
    # Split into 128-bit blocks and decrypt each
    let plaintext = ""
    let block_size = 16
    let i = 0

    while i < len(ciphertext) {
        let end = i + block_size
        if end > len(ciphertext) {
            end = len(ciphertext)
        }

        let block = ciphertext
        let decrypted_block = aes256_decrypt_block(block, key)
        plaintext = plaintext + decrypted_block

        i = i + block_size
    }

    return plaintext
