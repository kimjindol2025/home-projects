// Layer 4: Power-Weighted Leader Election (축약)
use super::green_raft_node::GreenRaftNode;

pub fn power_weighted_election(candidates: &[GreenRaftNode]) -> Option<u32> {
    // 무관용 규칙 4: <150ms
    candidates.iter()
        .max_by(|a, b| a.compute_power_score().partial_cmp(&b.compute_power_score()).unwrap_or(std::cmp::Ordering::Equal))
        .map(|n| n.id)
}

mod tests {
    use super::*;
    #[test]
    fn test_election() {
        let candidates = vec![
            GreenRaftNode::new(1, vec![2, 3]),
            GreenRaftNode::new(2, vec![1, 3]),
        ];
        let leader = power_weighted_election(&candidates);
        assert!(leader.is_some());
    }
}
