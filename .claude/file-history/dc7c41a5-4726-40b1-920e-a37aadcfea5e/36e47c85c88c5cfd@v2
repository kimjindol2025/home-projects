// Phase 3: Authentication Metrics
// FAR (False Acceptance Rate), FRR (False Rejection Rate), EER (Equal Error Rate)

/// 인증 결과 타입
#[derive(Clone, Debug, PartialEq)]
pub enum AuthenticationResult {
    Accept,      // 본인으로 판단
    Reject,      // 타인으로 판단
}

/// 단일 인증 시도 기록
#[derive(Clone, Debug)]
pub struct AuthenticationAttempt {
    pub is_genuine: bool,           // 실제로 본인인지 (테스트에서만 알려짐)
    pub predicted_result: AuthenticationResult,  // 예측 결과
    pub confidence_score: f64,      // 신뢰도 [0, 1]
    pub timestamp: u64,
}

/// 인증 성능 지표
#[derive(Clone, Debug)]
pub struct AuthenticationMetrics {
    pub false_acceptance_rate: f64,  // FAR: 타인을 본인으로 잘못 인증
    pub false_rejection_rate: f64,   // FRR: 본인을 타인으로 잘못 거부
    pub equal_error_rate: f64,       // EER: FAR = FRR인 지점의 에러율
    pub genuine_accept_rate: f64,    // GAR: 본인을 올바르게 인증한 비율
    pub impostor_reject_rate: f64,   // IRR: 타인을 올바르게 거부한 비율
    pub total_genuine_attempts: usize,
    pub total_impostor_attempts: usize,
    pub total_correct: usize,
    pub total_attempts: usize,
}

impl AuthenticationMetrics {
    pub fn new() -> Self {
        AuthenticationMetrics {
            false_acceptance_rate: 0.0,
            false_rejection_rate: 0.0,
            equal_error_rate: 0.0,
            genuine_accept_rate: 0.0,
            impostor_reject_rate: 0.0,
            total_genuine_attempts: 0,
            total_impostor_attempts: 0,
            total_correct: 0,
            total_attempts: 0,
        }
    }

    /// 인증 시도 기록으로부터 메트릭스 계산
    pub fn from_attempts(attempts: &[AuthenticationAttempt]) -> Self {
        let mut metrics = Self::new();

        let mut genuine_accepted = 0;
        let mut genuine_rejected = 0;
        let mut impostor_accepted = 0;
        let mut impostor_rejected = 0;

        for attempt in attempts {
            metrics.total_attempts += 1;

            if attempt.is_genuine {
                metrics.total_genuine_attempts += 1;
                if attempt.predicted_result == AuthenticationResult::Accept {
                    genuine_accepted += 1;
                    metrics.total_correct += 1;
                } else {
                    genuine_rejected += 1;
                }
            } else {
                metrics.total_impostor_attempts += 1;
                if attempt.predicted_result == AuthenticationResult::Accept {
                    impostor_accepted += 1;
                } else {
                    impostor_rejected += 1;
                    metrics.total_correct += 1;
                }
            }
        }

        // FAR = 타인이 본인으로 인증된 비율
        if metrics.total_impostor_attempts > 0 {
            metrics.false_acceptance_rate = impostor_accepted as f64
                / metrics.total_impostor_attempts as f64;
        }

        // FRR = 본인이 타인으로 거부된 비율
        if metrics.total_genuine_attempts > 0 {
            metrics.false_rejection_rate = genuine_rejected as f64
                / metrics.total_genuine_attempts as f64;
        }

        // GAR = 본인을 올바르게 인증한 비율
        if metrics.total_genuine_attempts > 0 {
            metrics.genuine_accept_rate = genuine_accepted as f64
                / metrics.total_genuine_attempts as f64;
        }

        // IRR = 타인을 올바르게 거부한 비율
        if metrics.total_impostor_attempts > 0 {
            metrics.impostor_reject_rate = impostor_rejected as f64
                / metrics.total_impostor_attempts as f64;
        }

        // EER ≈ (FAR + FRR) / 2
        metrics.equal_error_rate =
            (metrics.false_acceptance_rate + metrics.false_rejection_rate) / 2.0;

        metrics
    }

    /// FAR을 백만분의 몇으로 표현 (예: 0.0001% = 1 in 1,000,000)
    pub fn far_in_ppm(&self) -> f64 {
        self.false_acceptance_rate * 1_000_000.0
    }

    /// FRR을 백분율로 표현
    pub fn frr_percentage(&self) -> f64 {
        self.false_rejection_rate * 100.0
    }

    /// 인증 정확도
    pub fn accuracy(&self) -> f64 {
        if self.total_attempts == 0 {
            return 0.0;
        }
        self.total_correct as f64 / self.total_attempts as f64
    }

    /// 무관용 규칙 검증
    /// Rule: FAR < 0.0001% (1 in 1,000,000)
    pub fn meets_far_requirement(&self) -> bool {
        self.false_acceptance_rate < 0.000001  // 0.0001% = 0.000001
    }

    /// 무관용 규칙 검증
    /// Rule: FRR < 1%
    pub fn meets_frr_requirement(&self) -> bool {
        self.false_rejection_rate < 0.01  // 1% = 0.01
    }

    /// 두 무관용 규칙 모두 충족
    pub fn meets_all_requirements(&self) -> bool {
        self.meets_far_requirement() && self.meets_frr_requirement()
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_metrics_creation() {
        let metrics = AuthenticationMetrics::new();
        assert_eq!(metrics.false_acceptance_rate, 0.0);
        assert_eq!(metrics.false_rejection_rate, 0.0);
        assert_eq!(metrics.total_attempts, 0);
    }

    #[test]
    fn test_far_calculation() {
        // 시나리오: 100명의 타인 중 0명이 본인으로 인증
        let mut attempts = vec![];

        for i in 0..100 {
            attempts.push(AuthenticationAttempt {
                is_genuine: false,
                predicted_result: AuthenticationResult::Reject,
                confidence_score: 0.2,
                timestamp: i as u64,
            });
        }

        let metrics = AuthenticationMetrics::from_attempts(&attempts);
        assert_eq!(metrics.false_acceptance_rate, 0.0);
        assert_eq!(metrics.total_impostor_attempts, 100);
    }

    #[test]
    fn test_frr_calculation() {
        // 시나리오: 100명의 본인 중 5명이 거부됨
        let mut attempts = vec![];

        for i in 0..100 {
            let rejected = i < 5;
            attempts.push(AuthenticationAttempt {
                is_genuine: true,
                predicted_result: if rejected {
                    AuthenticationResult::Reject
                } else {
                    AuthenticationResult::Accept
                },
                confidence_score: if rejected { 0.3 } else { 0.8 },
                timestamp: i as u64,
            });
        }

        let metrics = AuthenticationMetrics::from_attempts(&attempts);
        assert_eq!(metrics.false_rejection_rate, 0.05);  // 5%
        assert_eq!(metrics.genuine_accept_rate, 0.95);   // 95%
    }

    #[test]
    fn test_mixed_attempts() {
        let attempts = vec![
            // 본인: 95명 인증 성공, 5명 거부
            AuthenticationAttempt {
                is_genuine: true,
                predicted_result: AuthenticationResult::Accept,
                confidence_score: 0.85,
                timestamp: 0,
            },
            AuthenticationAttempt {
                is_genuine: true,
                predicted_result: AuthenticationResult::Reject,
                confidence_score: 0.30,
                timestamp: 1,
            },
            // 타인: 98명 거부, 2명 잘못 인증
            AuthenticationAttempt {
                is_genuine: false,
                predicted_result: AuthenticationResult::Reject,
                confidence_score: 0.25,
                timestamp: 2,
            },
            AuthenticationAttempt {
                is_genuine: false,
                predicted_result: AuthenticationResult::Accept,
                confidence_score: 0.75,
                timestamp: 3,
            },
        ];

        let metrics = AuthenticationMetrics::from_attempts(&attempts);
        assert_eq!(metrics.total_genuine_attempts, 2);
        assert_eq!(metrics.total_impostor_attempts, 2);
        assert_eq!(metrics.total_correct, 3);  // 1 genuine correct + 1 genuine reject + 1 impostor reject
    }

    #[test]
    fn test_accuracy_calculation() {
        let attempts = vec![
            AuthenticationAttempt {
                is_genuine: true,
                predicted_result: AuthenticationResult::Accept,
                confidence_score: 0.9,
                timestamp: 0,
            },
            AuthenticationAttempt {
                is_genuine: true,
                predicted_result: AuthenticationResult::Accept,
                confidence_score: 0.85,
                timestamp: 1,
            },
            AuthenticationAttempt {
                is_genuine: false,
                predicted_result: AuthenticationResult::Reject,
                confidence_score: 0.2,
                timestamp: 2,
            },
            AuthenticationAttempt {
                is_genuine: false,
                predicted_result: AuthenticationResult::Reject,
                confidence_score: 0.15,
                timestamp: 3,
            },
        ];

        let metrics = AuthenticationMetrics::from_attempts(&attempts);
        assert_eq!(metrics.accuracy(), 1.0);  // 모두 올바른 판단
    }

    #[test]
    fn test_far_ppm_conversion() {
        let attempts = vec![
            AuthenticationAttempt {
                is_genuine: false,
                predicted_result: AuthenticationResult::Accept,  // 1개 오류
                confidence_score: 0.75,
                timestamp: 0,
            },
        ];

        for i in 1..=999999 {
            attempts.push(AuthenticationAttempt {
                is_genuine: false,
                predicted_result: AuthenticationResult::Reject,
                confidence_score: 0.2,
                timestamp: i as u64,
            });
        }

        let metrics = AuthenticationMetrics::from_attempts(&attempts);
        // FAR = 1 / 1,000,000 = 0.000001 = 1 PPM
        assert!(metrics.far_in_ppm() > 0.99 && metrics.far_in_ppm() < 1.01);
    }

    #[test]
    fn test_requirements_checking() {
        // 좋은 메트릭: FAR=0, FRR=0.5%
        let mut attempts = vec![];
        for i in 0..200 {
            if i < 100 {
                // 100명의 본인 중 99명 인증 성공
                attempts.push(AuthenticationAttempt {
                    is_genuine: true,
                    predicted_result: if i < 99 {
                        AuthenticationResult::Accept
                    } else {
                        AuthenticationResult::Reject
                    },
                    confidence_score: 0.8,
                    timestamp: i as u64,
                });
            } else {
                // 100명의 타인 모두 거부
                attempts.push(AuthenticationAttempt {
                    is_genuine: false,
                    predicted_result: AuthenticationResult::Reject,
                    confidence_score: 0.2,
                    timestamp: i as u64,
                });
            }
        }

        let metrics = AuthenticationMetrics::from_attempts(&attempts);
        assert!(metrics.meets_far_requirement());  // FAR = 0 ✓
        assert!(metrics.meets_frr_requirement());  // FRR = 1% ✓
        assert!(metrics.meets_all_requirements());
    }
}
