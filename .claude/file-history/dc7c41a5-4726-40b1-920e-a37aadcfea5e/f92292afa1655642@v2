// Phase 2: L0NN Biometric Pattern Learning
// 생체 신호 패턴을 신경망으로 학습

use crate::signals::*;

/// 신경망 활성화 함수
#[derive(Clone, Debug, PartialEq)]
pub enum Activation {
    Linear,
    ReLU,
    Sigmoid,
    Tanh,
}

impl Activation {
    pub fn apply(&self, x: f64) -> f64 {
        match self {
            Activation::Linear => x,
            Activation::ReLU => x.max(0.0),
            Activation::Sigmoid => 1.0 / (1.0 + (-x).exp()),
            Activation::Tanh => x.tanh(),
        }
    }
}

/// 신경망 뉴런
#[derive(Clone, Debug)]
pub struct BiometricNeuron {
    pub weights: Vec<f64>,
    pub bias: f64,
    pub activation: Activation,
    pub learning_rate: f64,
}

impl BiometricNeuron {
    pub fn new(input_size: usize, activation: Activation, learning_rate: f64) -> Self {
        let mut weights = vec![0.1; input_size];
        // Xavier initialization
        for w in &mut weights {
            *w = (2.0 / (input_size as f64)).sqrt() * (rand::random::<f64>() - 0.5);
        }

        BiometricNeuron {
            weights,
            bias: 0.0,
            activation,
            learning_rate,
        }
    }

    pub fn forward(&self, inputs: &[f64]) -> f64 {
        let mut z = self.bias;
        for (i, &input) in inputs.iter().enumerate() {
            if i < self.weights.len() {
                z += self.weights[i] * input;
            }
        }
        self.activation.apply(z)
    }

    pub fn backward(&mut self, inputs: &[f64], error: f64) {
        for (i, &input) in inputs.iter().enumerate() {
            if i < self.weights.len() {
                self.weights[i] += self.learning_rate * error * input;
            }
        }
        self.bias += self.learning_rate * error;
    }
}

/// L0NN 신경망 (경량)
#[derive(Clone, Debug)]
pub struct L0NNBiometricLearner {
    pub hidden_neurons: Vec<BiometricNeuron>,  // 8개
    pub output_neuron: BiometricNeuron,        // 1개 (신뢰도)
    pub user_id: String,
    pub training_count: usize,
    pub average_loss: f64,
}

impl L0NNBiometricLearner {
    pub fn new(user_id: String) -> Self {
        let mut hidden_neurons = Vec::new();

        // 8개 은닉층 뉴런 (6개 입력: 타이핑 속도, dwell, flight, 터치압, HR, HRV)
        for i in 0..8 {
            let activation = if i % 2 == 0 {
                Activation::ReLU
            } else {
                Activation::Sigmoid
            };
            hidden_neurons.push(BiometricNeuron::new(6, activation, 0.01));
        }

        // 출력층 뉴런 (8개 입력 → 1개 신뢰도)
        let output_neuron = BiometricNeuron::new(8, Activation::Sigmoid, 0.01);

        L0NNBiometricLearner {
            hidden_neurons,
            output_neuron,
            user_id,
            training_count: 0,
            average_loss: 0.0,
        }
    }

    /// 생체 프로필을 신경망 입력으로 변환
    fn profile_to_vector(&self, profile: &BiometricProfile) -> Vec<f64> {
        vec![
            profile.typing_speed / 100.0,          // 정규화
            profile.dwell_time / 100.0,
            profile.flight_time / 200.0,
            profile.touch_pressure,                 // 이미 0.0~1.0
            profile.heart_rate / 200.0,             // 정규화
            profile.heart_rate_variability,         // 이미 0.0~1.0
        ]
    }

    /// Forward pass
    pub fn forward(&self, profile: &BiometricProfile) -> f64 {
        let inputs = self.profile_to_vector(profile);

        // Hidden layer
        let mut hidden_outputs = Vec::new();
        for neuron in &self.hidden_neurons {
            hidden_outputs.push(neuron.forward(&inputs));
        }

        // Output layer
        self.output_neuron.forward(&hidden_outputs)
    }

    /// 사용자 검증 (학습)
    pub fn learn_user_pattern(&mut self, profile: &BiometricProfile, target: f64) -> f64 {
        let inputs = self.profile_to_vector(profile);

        // Forward pass
        let mut hidden_outputs = Vec::new();
        for neuron in &self.hidden_neurons {
            hidden_outputs.push(neuron.forward(&inputs));
        }

        let prediction = self.output_neuron.forward(&hidden_outputs);

        // Loss 계산 (Mean Squared Error)
        let loss = (target - prediction).powi(2);

        // Backward pass
        let output_error = (prediction - target) * prediction * (1.0 - prediction);
        self.output_neuron.backward(&hidden_outputs, output_error);

        // Hidden layer backward
        for (i, neuron) in self.hidden_neurons.iter_mut().enumerate() {
            let hidden_error = output_error * self.output_neuron.weights[i];
            neuron.backward(&inputs, hidden_error);
        }

        // 통계 업데이트
        self.training_count += 1;
        self.average_loss = (self.average_loss * (self.training_count - 1) as f64 + loss)
            / self.training_count as f64;

        loss
    }

    /// 사용자 프로필 학습 (여러 샘플)
    pub fn train_on_profiles(&mut self, profiles: &[BiometricProfile], epochs: usize) {
        for _ in 0..epochs {
            for profile in profiles {
                // 사용자 자신의 패턴이므로 target = 1.0 (본인)
                self.learn_user_pattern(profile, 1.0);
            }
        }
    }

    /// 신뢰도 점수 계산 (0.0~1.0)
    pub fn confidence_score(&self, profile: &BiometricProfile) -> f64 {
        self.forward(profile)
    }

    /// 사용자 인증 (임계값 기반)
    pub fn authenticate(&self, profile: &BiometricProfile, threshold: f64) -> bool {
        self.confidence_score(profile) >= threshold
    }

    /// 모델 정확도 평가
    pub fn evaluate(&self, test_profiles: &[BiometricProfile], labels: &[f64]) -> ModelMetrics {
        let mut correct = 0;
        let mut total_error = 0.0;

        for (profile, &label) in test_profiles.iter().zip(labels.iter()) {
            let score = self.confidence_score(profile);
            let error = (score - label).abs();
            total_error += error;

            // 임계값 0.5로 판단
            let prediction = if score >= 0.5 { 1.0 } else { 0.0 };
            if (prediction - label).abs() < 0.01 {
                correct += 1;
            }
        }

        let accuracy = correct as f64 / test_profiles.len() as f64;
        let avg_error = total_error / test_profiles.len() as f64;

        ModelMetrics {
            accuracy,
            avg_error,
            total_correct: correct,
            total_samples: test_profiles.len(),
        }
    }

    /// 사용자 모델 저장 (직렬화)
    pub fn serialize(&self) -> UserBiometricModel {
        UserBiometricModel {
            user_id: self.user_id.clone(),
            hidden_weights: self.hidden_neurons
                .iter()
                .map(|n| n.weights.clone())
                .collect(),
            output_weights: self.output_neuron.weights.clone(),
            training_count: self.training_count,
            average_loss: self.average_loss,
        }
    }
}

/// 사용자 생체 모델 (저장용)
#[derive(Clone, Debug)]
pub struct UserBiometricModel {
    pub user_id: String,
    pub hidden_weights: Vec<Vec<f64>>,
    pub output_weights: Vec<f64>,
    pub training_count: usize,
    pub average_loss: f64,
}

/// 모델 평가 지표
#[derive(Clone, Debug)]
pub struct ModelMetrics {
    pub accuracy: f64,
    pub avg_error: f64,
    pub total_correct: usize,
    pub total_samples: usize,
}

/// 더미 rand 함수 (프로덕션에서는 실제 난수 생성기 사용)
mod rand {
    pub fn random<T>() -> T
    where
        T: Default + PartialOrd,
    {
        T::default()
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_learner_creation() {
        let learner = L0NNBiometricLearner::new("user001".to_string());
        assert_eq!(learner.user_id, "user001");
        assert_eq!(learner.hidden_neurons.len(), 8);
        assert_eq!(learner.training_count, 0);
    }

    #[test]
    fn test_activation_functions() {
        assert_eq!(Activation::Linear.apply(2.0), 2.0);
        assert_eq!(Activation::ReLU.apply(-1.0), 0.0);
        assert!(Activation::Sigmoid.apply(0.0) > 0.4 && Activation::Sigmoid.apply(0.0) < 0.6);
    }

    #[test]
    fn test_neuron_forward() {
        let neuron = BiometricNeuron::new(3, Activation::Sigmoid, 0.01);
        let output = neuron.forward(&[0.5, 0.5, 0.5]);
        assert!(output >= 0.0 && output <= 1.0);
    }

    #[test]
    fn test_forward_pass() {
        let learner = L0NNBiometricLearner::new("user001".to_string());
        let profile = BiometricProfile {
            typing_speed: 50.0,
            dwell_time: 50.0,
            flight_time: 100.0,
            touch_pressure: 0.7,
            heart_rate: 72.0,
            heart_rate_variability: 0.5,
            keystroke_count: 10,
            touch_count: 5,
            heartrate_count: 5,
        };

        let score = learner.confidence_score(&profile);
        assert!(score >= 0.0 && score <= 1.0);
    }

    #[test]
    fn test_learning() {
        let mut learner = L0NNBiometricLearner::new("user001".to_string());
        let profile = BiometricProfile {
            typing_speed: 50.0,
            dwell_time: 50.0,
            flight_time: 100.0,
            touch_pressure: 0.7,
            heart_rate: 72.0,
            heart_rate_variability: 0.5,
            keystroke_count: 10,
            touch_count: 5,
            heartrate_count: 5,
        };

        let loss_before = (learner.forward(&profile) - 1.0).powi(2);
        learner.learn_user_pattern(&profile, 1.0);
        let loss_after = (learner.forward(&profile) - 1.0).powi(2);

        // 손실이 감소해야 함
        assert!(loss_after <= loss_before || learner.training_count > 0);
    }

    #[test]
    fn test_authentication() {
        let mut learner = L0NNBiometricLearner::new("user001".to_string());
        let profile = BiometricProfile {
            typing_speed: 50.0,
            dwell_time: 50.0,
            flight_time: 100.0,
            touch_pressure: 0.7,
            heart_rate: 72.0,
            heart_rate_variability: 0.5,
            keystroke_count: 10,
            touch_count: 5,
            heartrate_count: 5,
        };

        // 학습
        for _ in 0..10 {
            learner.learn_user_pattern(&profile, 1.0);
        }

        // 인증
        let is_authenticated = learner.authenticate(&profile, 0.5);
        assert!(is_authenticated);
    }

    #[test]
    fn test_model_serialization() {
        let learner = L0NNBiometricLearner::new("user001".to_string());
        let model = learner.serialize();
        assert_eq!(model.user_id, "user001");
        assert_eq!(model.hidden_weights.len(), 8);
    }
}
