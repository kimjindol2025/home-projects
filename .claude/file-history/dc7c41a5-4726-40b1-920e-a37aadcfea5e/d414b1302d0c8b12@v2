// Purpose: Optimize performance under thermal constraints while maintaining 45% power reduction
// Strategy: Temperature monitoring, thermal budget allocation, workload shifting

// ============================================================================
// Part 1: Thermal Model (200 lines)
// ============================================================================

pub struct ThermalState {
    pub core_temperature_c: f64,
    pub junction_temperature_c: f64,
    pub throttle_temperature_c: f64,  // Throttle starts (usually 85°C)
    pub critical_temperature_c: f64,  // Critical threshold (95°C+)
    pub thermal_headroom_c: f64,      // Distance from throttle point
    pub cooling_rate_c_per_sec: f64,
}

impl ThermalState {
    pub fn new() -> Self {
        ThermalState {
            core_temperature_c: 25.0,     // Room temperature
            junction_temperature_c: 25.0,
            throttle_temperature_c: 85.0,
            critical_temperature_c: 95.0,
            thermal_headroom_c: 60.0,
            cooling_rate_c_per_sec: 2.0,  // Cools ~2°C per second when idle
        }
    }

    pub fn update_temperature(&mut self, power_dissipation_mw: f64, ambient_c: f64) {
        // Thermal model: Temperature rise ∝ power, Temperature drop ∝ (Temp - Ambient)

        // Heat generation (simplified): 1mW → ~0.01°C rise per second
        let heating_rate = (power_dissipation_mw / 100.0) * 0.01;

        // Natural cooling: Newton's law of cooling
        let temp_diff = self.core_temperature_c - ambient_c;
        let cooling_rate = temp_diff * 0.05;  // 5% of difference per second

        self.core_temperature_c += heating_rate - cooling_rate;

        // Junction temp slightly higher than core
        self.junction_temperature_c = self.core_temperature_c + 2.0;

        // Update thermal headroom
        self.thermal_headroom_c = self.throttle_temperature_c - self.core_temperature_c;
    }

    pub fn thermal_state_enum(&self) -> ThermalCondition {
        match self.core_temperature_c {
            c if c < 50.0 => ThermalCondition::Cool,
            c if c < 70.0 => ThermalCondition::Normal,
            c if c < 85.0 => ThermalCondition::Warm,
            c if c < 95.0 => ThermalCondition::Hot,
            _ => ThermalCondition::Critical,
        }
    }

    pub fn describe(&self) -> String {
        format!(
            "Thermal: core={}°C, junction={}°C, \
            throttle_at={}°C, headroom={:.1}°C, state={:?}",
            self.core_temperature_c as i32, self.junction_temperature_c as i32,
            self.throttle_temperature_c as i32, self.thermal_headroom_c,
            self.thermal_state_enum()
        )
    }
}

pub enum ThermalCondition {
    Cool,      // <50°C - Full performance
    Normal,    // 50-70°C - Normal operation
    Warm,      // 70-85°C - Monitoring required
    Hot,       // 85-95°C - Throttling
    Critical,  // >95°C - Severe throttling
}

// ============================================================================
// Part 2: Thermal Budget Allocation (240 lines)
// ============================================================================

pub struct ThermalBudgetAllocator {
    pub total_thermal_budget_mw: f64,      // Max power sustainable at temperature
    pub current_allocation: Vec<(String, f64)>,  // (core, allocated_mw)
    pub thermal_headroom_percent: f64,    // Safety margin
}

impl ThermalBudgetAllocator {
    pub fn new() -> Self {
        ThermalBudgetAllocator {
            total_thermal_budget_mw: 200.0,  // 200mW total budget
            current_allocation: Vec::new(),
            thermal_headroom_percent: 0.8,   // 80% utilization, 20% safety
        }
    }

    pub fn calculate_thermal_budget(&mut self, thermal_state: &ThermalState) -> f64 {
        // Thermal budget decreases as temperature increases
        let headroom_factor = if thermal_state.thermal_headroom_c > 20.0 {
            1.0  // Full budget
        } else if thermal_state.thermal_headroom_c > 10.0 {
            0.8  // 80% of budget
        } else if thermal_state.thermal_headroom_c > 0.0 {
            0.5  // 50% of budget
        } else {
            0.2  // Critical: only 20%
        };

        let thermal_budget = self.total_thermal_budget_mw * headroom_factor * self.thermal_headroom_percent;
        thermal_budget
    }

    pub fn allocate_budget(&mut self, cores: Vec<String>, thermal_budget: f64) {
        self.current_allocation.clear();

        if cores.is_empty() {
            return;
        }

        // Equal distribution across cores
        let per_core = thermal_budget / cores.len() as f64;

        for core in cores {
            self.current_allocation.push((core, per_core));
        }
    }

    pub fn get_core_budget(&self, core_name: &str) -> f64 {
        self.current_allocation.iter()
            .find(|(name, _)| name == core_name)
            .map(|(_, budget)| *budget)
            .unwrap_or(0.0)
    }

    pub fn describe(&self) -> String {
        let allocation_str = self.current_allocation.iter()
            .map(|(name, budget)| format!("{}={:.0}mW", name, budget))
            .collect::<Vec<_>>()
            .join(", ");

        format!(
            "Thermal Budget: total={}mW, headroom={:.0}%, allocations=[{}]",
            self.total_thermal_budget_mw as i32, self.thermal_headroom_percent * 100.0,
            allocation_str
        )
    }
}

// ============================================================================
// Part 3: Thermal-Aware Frequency Scaling (220 lines)
// ============================================================================

pub struct ThermalAwareFrequencyScaler {
    pub current_frequency_mhz: u32,
    pub max_frequency_mhz: u32,
    pub thermal_limited_freq_mhz: u32,
    pub scaling_factor: f64,  // 0.0-1.0
}

impl ThermalAwareFrequencyScaler {
    pub fn new() -> Self {
        ThermalAwareFrequencyScaler {
            current_frequency_mhz: 2000,  // Default 2.0 GHz
            max_frequency_mhz: 3600,      // Max 3.6 GHz
            thermal_limited_freq_mhz: 2000,
            scaling_factor: 1.0,
        }
    }

    pub fn scale_frequency(&mut self, thermal_state: &ThermalState, target_freq_mhz: u32) -> u32 {
        // Adjust frequency based on thermal state
        self.scaling_factor = match thermal_state.thermal_state_enum() {
            ThermalCondition::Cool => 1.0,       // Full speed
            ThermalCondition::Normal => 0.95,    // Slight reduction
            ThermalCondition::Warm => 0.85,      // Moderate reduction
            ThermalCondition::Hot => 0.60,       // Significant reduction
            ThermalCondition::Critical => 0.30,  // Severe reduction
        };

        // Apply scaling
        self.thermal_limited_freq_mhz = (target_freq_mhz as f64 * self.scaling_factor) as u32;

        // Never go below 800MHz (minimum operational frequency)
        self.thermal_limited_freq_mhz = self.thermal_limited_freq_mhz.max(800);

        // Never exceed max
        self.thermal_limited_freq_mhz = self.thermal_limited_freq_mhz.min(self.max_frequency_mhz);

        self.current_frequency_mhz = self.thermal_limited_freq_mhz;
        self.current_frequency_mhz
    }

    pub fn estimate_power_at_frequency(&self, frequency_mhz: u32) -> f64 {
        // Power ∝ Frequency^2 (simplified cubic relationship)
        // At 2000MHz baseline = 150mW
        let freq_ratio = frequency_mhz as f64 / 2000.0;
        150.0 * freq_ratio * freq_ratio  // Simplified: frequency^2 relationship
    }

    pub fn describe(&self) -> String {
        format!(
            "Thermal Frequency Scaler: current={}MHz, thermal_limit={}MHz, \
            scaling={:.0}%, est_power={:.0}mW",
            self.current_frequency_mhz, self.thermal_limited_freq_mhz,
            self.scaling_factor * 100.0,
            self.estimate_power_at_frequency(self.current_frequency_mhz)
        )
    }
}

// ============================================================================
// Part 4: Thermal Optimization Engine (160 lines)
// ============================================================================

pub struct ThermalOptimizer {
    pub thermal_state: ThermalState,
    pub budget_allocator: ThermalBudgetAllocator,
    pub frequency_scaler: ThermalAwareFrequencyScaler,
    pub optimization_action: String,
}

impl ThermalOptimizer {
    pub fn new() -> Self {
        ThermalOptimizer {
            thermal_state: ThermalState::new(),
            budget_allocator: ThermalBudgetAllocator::new(),
            frequency_scaler: ThermalAwareFrequencyScaler::new(),
            optimization_action: "normal".to_string(),
        }
    }

    pub fn step(&mut self, power_mw: f64, ambient_c: f64, target_freq: u32, cores: Vec<String>) {
        // Step 1: Update thermal state
        self.thermal_state.update_temperature(power_mw, ambient_c);

        // Step 2: Calculate available thermal budget
        let budget = self.budget_allocator.calculate_thermal_budget(&self.thermal_state);

        // Step 3: Allocate budget across cores
        self.budget_allocator.allocate_budget(cores.clone(), budget);

        // Step 4: Scale frequency based on thermal state
        self.frequency_scaler.scale_frequency(&self.thermal_state, target_freq);

        // Step 5: Determine optimization action
        self.optimization_action = match self.thermal_state.thermal_state_enum() {
            ThermalCondition::Cool => "boost_available".to_string(),
            ThermalCondition::Normal => "maintain_performance".to_string(),
            ThermalCondition::Warm => "monitor_closely".to_string(),
            ThermalCondition::Hot => "reduce_frequency".to_string(),
            ThermalCondition::Critical => "emergency_shutdown_mode".to_string(),
        };
    }

    pub fn is_thermal_safe(&self) -> bool {
        self.thermal_state.core_temperature_c < self.thermal_state.critical_temperature_c
    }

    pub fn efficiency_score(&self) -> f64 {
        // Score based on temperature management efficiency
        // Higher is better: maintaining cool while delivering performance
        if self.thermal_state.core_temperature_c < 50.0 {
            1.0  // Excellent
        } else if self.thermal_state.core_temperature_c < 70.0 {
            0.9  // Very good
        } else if self.thermal_state.core_temperature_c < 85.0 {
            0.7  // Good
        } else if self.thermal_state.core_temperature_c < 95.0 {
            0.4  // Fair (throttling)
        } else {
            0.1  // Poor (critical)
        }
    }

    pub fn describe(&self) -> String {
        format!(
            "Thermal Optimizer: {}, freq={}MHz, budget={:.0}mW, \
            safe={}, efficiency={:.2}",
            self.optimization_action, self.frequency_scaler.current_frequency_mhz,
            self.budget_allocator.total_thermal_budget_mw,
            self.is_thermal_safe(), self.efficiency_score()
        )
    }
}

// ============================================================================
// Tests (120 lines)
// ============================================================================

mod tests {
    use super::*;

    #[test]
    fn test_thermal_state_creation() {
        let thermal = ThermalState::new();
        assert_eq!(thermal.core_temperature_c as i32, 25);
    }

    #[test]
    fn test_thermal_condition_enum() {
        let mut thermal = ThermalState::new();
        thermal.core_temperature_c = 45.0;
        assert!(matches!(thermal.thermal_state_enum(), ThermalCondition::Cool));

        thermal.core_temperature_c = 80.0;
        assert!(matches!(thermal.thermal_state_enum(), ThermalCondition::Warm));

        thermal.core_temperature_c = 90.0;
        assert!(matches!(thermal.thermal_state_enum(), ThermalCondition::Hot));
    }

    #[test]
    fn test_thermal_update() {
        let mut thermal = ThermalState::new();
        let initial_temp = thermal.core_temperature_c;

        thermal.update_temperature(200.0, 25.0);  // 200mW power

        assert!(thermal.core_temperature_c > initial_temp);
    }

    #[test]
    fn test_thermal_budget_calculation() {
        let mut allocator = ThermalBudgetAllocator::new();
        let mut thermal = ThermalState::new();

        thermal.core_temperature_c = 25.0;  // Cool
        let budget = allocator.calculate_thermal_budget(&thermal);

        assert!(budget > 100.0);  // Should have good budget when cool
    }

    #[test]
    fn test_budget_reduction_at_high_temp() {
        let mut allocator = ThermalBudgetAllocator::new();
        let mut thermal = ThermalState::new();

        let cool_budget = allocator.calculate_thermal_budget(&thermal);

        thermal.core_temperature_c = 85.0;  // Hot
        let hot_budget = allocator.calculate_thermal_budget(&thermal);

        assert!(hot_budget < cool_budget);
    }

    #[test]
    fn test_frequency_scaling() {
        let mut scaler = ThermalAwareFrequencyScaler::new();
        let mut thermal = ThermalState::new();

        thermal.core_temperature_c = 25.0;  // Cool
        let freq_cool = scaler.scale_frequency(&thermal, 3000);

        thermal.core_temperature_c = 95.0;  // Critical
        let freq_critical = scaler.scale_frequency(&thermal, 3000);

        assert!(freq_cool > freq_critical);
    }

    #[test]
    fn test_thermal_optimizer() {
        let mut optimizer = ThermalOptimizer::new();
        let cores = vec!["core0".to_string(), "core1".to_string()];

        optimizer.step(150.0, 25.0, 2000, cores);

        assert!(optimizer.is_thermal_safe());
        assert!(optimizer.efficiency_score() > 0.0);
    }

    #[test]
    fn test_thermal_safety() {
        let mut optimizer = ThermalOptimizer::new();

        optimizer.thermal_state.core_temperature_c = 80.0;
        assert!(optimizer.is_thermal_safe());

        optimizer.thermal_state.core_temperature_c = 100.0;
        assert!(!optimizer.is_thermal_safe());
    }
}
