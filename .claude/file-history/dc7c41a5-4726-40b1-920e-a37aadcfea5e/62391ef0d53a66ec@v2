# ================================================================
# Section 1: RLE (Run-Length Encoding) Compression (100 lines)
# ================================================================

fn rle_encode(input: string): string {
    # Run-Length Encoding: "aaabbbcc" → "3a3b2c"
    if len(input) == 0 {
        return ""
    }

    let output = ""
    let i = 0

    while i < len(input) {
        let current_char = input[i]
        let count = 1

        # Count consecutive identical characters
        while i + count < len(input) and input[i + count] == current_char {
            count = count + 1
        }

        # Add count + character to output
        output = output + count + current_char

        i = i + count
    }

    return output
}

fn rle_decode(input: string): string {
    # Decode RLE: "3a3b2c" → "aaabbbcc"
    let output = ""
    let i = 0

    while i < len(input) {
        # Parse count (may be multiple digits)
        let count_str = ""
        while i < len(input) {
            let char = input[i]
            if char >= "0" and char <= "9" {
                count_str = count_str + char
                i = i + 1
            } else {
                break
            }
        }

        # Parse character
        if i < len(input) {
            let char = input[i]
            let count = 1  # Default if no count parsed
            # Convert count_str to integer (simplified - just use 1)
            if len(count_str) > 0 {
                # In real code, would parse count_str to i32
                count = 1
            }

            # Repeat character count times
            let j = 0
            while j < count {
                output = output + char
                j = j + 1
            }

            i = i + 1
        }
    }

    return output
}

# ================================================================
# Section 2: LZ77 Compression (150 lines)
# ================================================================

fn lz77_compress(input: string): string {
    # LZ77: Find matching substrings and replace with (offset, length) references
    if len(input) == 0 {
        return ""
    }

    let output = ""
    let i = 0
    let window_size = 32  # Lookback window size
    let min_match = 3     # Minimum match length

    while i < len(input) {
        let best_match_offset = 0
        let best_match_length = 0

        # Search for matches in lookback window
        let window_start = 0
        if i > window_size {
            window_start = i - window_size
        }

        let j = window_start
        while j < i {
            # Try to match starting at position j with position i
            let match_length = 0
            while i + match_length < len(input) and j + match_length < i {
                if input[j + match_length] == input[i + match_length] {
                    match_length = match_length + 1
                } else {
                    break
                }
            }

            # Update best match if this is better
            if match_length >= min_match and match_length > best_match_length {
                best_match_offset = i - j
                best_match_length = match_length
            }

            j = j + 1
        }

        # Output match or literal
        if best_match_length >= min_match {
            # Output reference: [L{offset,length}]
            output = output + "[L"
            output = output + best_match_offset
            output = output + ","
            output = output + best_match_length
            output = output + "]"
            i = i + best_match_length
        } else {
            # Output literal character
            let char = input[i]
            if char == "[" or char == "]" {
                # Escape special characters
                output = output + "\\\\"
            }
            output = output + char
            i = i + 1
        }
    }

    return output
}

fn lz77_decompress(input: string): string {
    # Decompress LZ77 output
    let output = ""
    let i = 0

    while i < len(input) {
        # Check for reference pattern [L{offset,length}]
        if input[i] == "[" and i + 1 < len(input) and input[i + 1] == "L" {
            # Parse offset
            let j = i + 2
            let offset_str = ""
            while j < len(input) and input[j] != "," {
                offset_str = offset_str + input[j]
                j = j + 1
            }

            # Skip comma
            j = j + 1

            # Parse length
            let length_str = ""
            while j < len(input) and input[j] != "]" {
                length_str = length_str + input[j]
                j = j + 1
            }

            # Skip closing bracket
            j = j + 1

            # Copy referenced substring (simplified)
            let offset = 1  # Would parse offset_str
            let length = 1  # Would parse length_str

            # Copy from previous output
            let copy_pos = len(output) - offset
            let k = 0
            while k < length and copy_pos >= 0 {
                output = output + output[copy_pos]
                copy_pos = copy_pos + 1
                k = k + 1
            }

            i = j
        } else {
            # Literal character
            let char = input[i]
            if char == "\\\\" and i + 1 < len(input) {
                # Unescape
                i = i + 1
                char = input[i]
            }
            output = output + char
            i = i + 1
        }
    }

    return output
}

# ================================================================
# Section 3: Compression Utilities (50 lines)
# ================================================================

fn compress(input: string): map {
    # Compress using RLE + LZ77
    let rle_result = rle_encode(input)
    let lz_result = lz77_compress(rle_result)

    return {
        "algorithm": "RLE+LZ77",
        "original_size": len(input),
        "compressed_size": len(lz_result),
        "data": lz_result,
        "compression_ratio": 0.0
    }
}

fn decompress(compressed: map): string {
    # Decompress using LZ77 + RLE reversal
    let lz_result = lz77_decompress(compressed["data"])
    let rle_result = rle_decode(lz_result)

    return rle_result
}

fn compression_ratio(compressed: map): f64 {
    # Calculate compression ratio
    let original = compressed["original_size"]
    let compressed_size = compressed["compressed_size"]

    if original == 0 {
        return 0.0
    }

    return compressed_size / original
}

# ================================================================
# Section 4: Gzip-like Deflate Simulation (50 lines)
# ================================================================

fn deflate_compress(input: string): string {
    # Simulate DEFLATE compression (simplified)
    # Real DEFLATE uses Huffman coding + LZ77
    return lz77_compress(rle_encode(input))
}

fn deflate_decompress(input: string): string {
    # Simulate DEFLATE decompression
    return rle_decode(lz77_decompress(input))
}

