// Green-Distributed-Fabric Phase 2 Week 3: Fairness Metrics
// Purpose: Measure power distribution fairness across cluster nodes
// Strategy: Jain's fairness index, coefficient of variation, max-min ratio

// ============================================================================
// Part 1: Fairness Index Calculation (220 lines)
// ============================================================================

pub struct FairnessMetrics {
    pub node_powers_mw: Vec<f64>,
    pub jain_fairness_index: f64,
    pub coefficient_of_variation: f64,
    pub max_min_ratio: f64,
    pub standard_deviation: f64,
    pub mean_power: f64,
}

impl FairnessMetrics {
    pub fn new(powers: Vec<f64>) -> Self {
        FairnessMetrics {
            node_powers_mw: powers,
            jain_fairness_index: 0.0,
            coefficient_of_variation: 0.0,
            max_min_ratio: 0.0,
            standard_deviation: 0.0,
            mean_power: 0.0,
        }
    }

    pub fn calculate(&mut self) {
        if self.node_powers_mw.is_empty() {
            return;
        }

        // Calculate mean
        let sum: f64 = self.node_powers_mw.iter().sum();
        self.mean_power = sum / self.node_powers_mw.len() as f64;

        // Calculate standard deviation
        let variance = self.node_powers_mw.iter()
            .map(|p| (p - self.mean_power).powi(2))
            .sum::<f64>() / self.node_powers_mw.len() as f64;
        self.standard_deviation = variance.sqrt();

        // Calculate coefficient of variation (stddev / mean)
        if self.mean_power > 0.0 {
            self.coefficient_of_variation = self.standard_deviation / self.mean_power;
        }

        // Calculate Jain's fairness index
        // J = (sum xi)^2 / (n * sum xi^2)
        let sum_powers = self.node_powers_mw.iter().sum::<f64>();
        let sum_squares = self.node_powers_mw.iter()
            .map(|p| p.powi(2))
            .sum::<f64>();
        let n = self.node_powers_mw.len() as f64;

        if sum_squares > 0.0 {
            self.jain_fairness_index = (sum_powers * sum_powers) / (n * sum_squares);
        }

        // Calculate max/min ratio
        let max = self.node_powers_mw.iter().copied().fold(f64::NEG_INFINITY, f64::max);
        let min = self.node_powers_mw.iter().copied().fold(f64::INFINITY, f64::min);

        if min > 0.0 {
            self.max_min_ratio = max / min;
        } else {
            self.max_min_ratio = f64::INFINITY;
        }
    }

    pub fn is_fair(&self) -> bool {
        // Fair if Jain index >= 0.9 (90%)
        self.jain_fairness_index >= 0.9
    }

    pub fn is_balanced(&self) -> bool {
        // Balanced if CoV < 0.15 (15% variation)
        self.coefficient_of_variation < 0.15
    }

    pub fn describe(&self) -> String {
        format!(
            "Fairness: jain={:.2}, cov={:.2}, max/min={:.2}, stddev={:.1}mW, mean={:.1}mW, fair={}",
            self.jain_fairness_index, self.coefficient_of_variation, self.max_min_ratio,
            self.standard_deviation, self.mean_power,
            if self.is_fair() { "YES" } else { "NO" }
        )
    }
}

// ============================================================================
// Part 2: Temporal Fairness Tracking (200 lines)
// ============================================================================

pub struct TemporalFairnessTracker {
    pub measurements: Vec<FairnessMetrics>,
    pub measurement_count: u32,
    pub average_jain: f64,
    pub min_jain: f64,
    pub fairness_trend: String,  // "improving", "stable", "degrading"
}

impl TemporalFairnessTracker {
    pub fn new() -> Self {
        TemporalFairnessTracker {
            measurements: Vec::new(),
            measurement_count: 0,
            average_jain: 0.0,
            min_jain: 1.0,
            fairness_trend: "stable".to_string(),
        }
    }

    pub fn add_measurement(&mut self, metric: FairnessMetrics) {
        self.measurements.push(metric);
        self.measurement_count += 1;
    }

    pub fn aggregate(&mut self) {
        if self.measurements.is_empty() {
            return;
        }

        // Calculate average Jain index
        let total_jain: f64 = self.measurements.iter()
            .map(|m| m.jain_fairness_index)
            .sum();
        self.average_jain = total_jain / self.measurements.len() as f64;

        // Find minimum Jain index
        self.min_jain = self.measurements.iter()
            .map(|m| m.jain_fairness_index)
            .fold(f64::INFINITY, f64::min);

        // Determine trend
        if self.measurements.len() >= 2 {
            let first_half_avg = self.measurements[..self.measurements.len() / 2].iter()
                .map(|m| m.jain_fairness_index)
                .sum::<f64>() / (self.measurements.len() / 2) as f64;

            let second_half_avg = self.measurements[self.measurements.len() / 2..].iter()
                .map(|m| m.jain_fairness_index)
                .sum::<f64>() / (self.measurements.len() / 2) as f64;

            let improvement = second_half_avg - first_half_avg;

            self.fairness_trend = if improvement > 0.01 {
                "improving".to_string()
            } else if improvement < -0.01 {
                "degrading".to_string()
            } else {
                "stable".to_string()
            };
        }
    }

    pub fn fairness_stability(&self) -> f64 {
        if self.measurements.len() < 2 {
            return 1.0;
        }

        // Calculate how consistent Jain index is
        let variance = self.measurements.iter()
            .map(|m| (m.jain_fairness_index - self.average_jain).powi(2))
            .sum::<f64>() / self.measurements.len() as f64;

        let stddev = variance.sqrt();
        // Return stability as 1 - (stddev / average), clamped to 0-1
        (1.0 - (stddev / self.average_jain)).max(0.0).min(1.0)
    }

    pub fn summary(&self) -> String {
        format!(
            "Temporal Fairness: {} measurements, avg_jain={:.2}, min_jain={:.2}, stability={:.2}, trend={}",
            self.measurement_count, self.average_jain, self.min_jain,
            self.fairness_stability(), self.fairness_trend
        )
    }
}

// ============================================================================
// Part 3: Per-Node Power Distribution (180 lines)
// ============================================================================

pub struct NodePowerDistribution {
    pub node_id: u32,
    pub power_samples: Vec<f64>,
    pub average_power: f64,
    pub min_power: f64,
    pub max_power: f64,
    pub percentile_95: f64,
    pub percentile_5: f64,
}

impl NodePowerDistribution {
    pub fn new(node_id: u32) -> Self {
        NodePowerDistribution {
            node_id,
            power_samples: Vec::new(),
            average_power: 0.0,
            min_power: 0.0,
            max_power: 0.0,
            percentile_95: 0.0,
            percentile_5: 0.0,
        }
    }

    pub fn add_sample(&mut self, power_mw: f64) {
        self.power_samples.push(power_mw);
    }

    pub fn calculate_statistics(&mut self) {
        if self.power_samples.is_empty() {
            return;
        }

        // Average
        self.average_power = self.power_samples.iter().sum::<f64>() / self.power_samples.len() as f64;

        // Min/Max
        self.min_power = self.power_samples.iter().copied().fold(f64::INFINITY, f64::min);
        self.max_power = self.power_samples.iter().copied().fold(f64::NEG_INFINITY, f64::max);

        // Percentiles (simplified)
        let mut sorted = self.power_samples.clone();
        sorted.sort_by(|a, b| a.partial_cmp(b).unwrap());

        let idx_95 = ((sorted.len() as f64) * 0.95) as usize;
        let idx_5 = ((sorted.len() as f64) * 0.05) as usize;

        self.percentile_95 = sorted.get(idx_95).copied().unwrap_or(self.max_power);
        self.percentile_5 = sorted.get(idx_5).copied().unwrap_or(self.min_power);
    }

    pub fn power_stability(&self) -> f64 {
        if self.average_power == 0.0 || self.power_samples.len() < 2 {
            return 1.0;
        }

        let variance = self.power_samples.iter()
            .map(|p| (p - self.average_power).powi(2))
            .sum::<f64>() / self.power_samples.len() as f64;

        let stddev = variance.sqrt();
        // Stability = 1 - (stddev / average)
        (1.0 - (stddev / self.average_power)).max(0.0).min(1.0)
    }

    pub fn describe(&self) -> String {
        format!(
            "Node {}: avg={:.1}mW, range={:.1}-{:.1}mW, p95={:.1}mW, stability={:.2}",
            self.node_id, self.average_power, self.min_power, self.max_power,
            self.percentile_95, self.power_stability()
        )
    }
}

// ============================================================================
// Tests (120 lines)
// ============================================================================

mod tests {
    use super::*;

    #[test]
    fn test_fairness_metrics_creation() {
        let powers = vec![150.0, 150.0, 150.0];
        let metrics = FairnessMetrics::new(powers);
        assert_eq!(metrics.node_powers_mw.len(), 3);
    }

    #[test]
    fn test_perfect_fairness() {
        let powers = vec![150.0, 150.0, 150.0];
        let mut metrics = FairnessMetrics::new(powers);
        metrics.calculate();

        assert!(metrics.jain_fairness_index >= 0.99);  // Perfect = 1.0
        assert!(metrics.is_fair());
    }

    #[test]
    fn test_unequal_fairness() {
        let powers = vec![100.0, 150.0, 200.0];
        let mut metrics = FairnessMetrics::new(powers);
        metrics.calculate();

        assert!(metrics.jain_fairness_index < 1.0);
        assert!(metrics.max_min_ratio > 1.0);
    }

    #[test]
    fn test_temporal_fairness_tracking() {
        let mut tracker = TemporalFairnessTracker::new();

        for i in 0..5 {
            let powers = vec![150.0 + (i as f64), 150.0, 150.0];
            let mut m = FairnessMetrics::new(powers);
            m.calculate();
            tracker.add_measurement(m);
        }

        tracker.aggregate();
        assert!(tracker.average_jain > 0.0);
        assert!(tracker.fairness_stability() > 0.0);
    }

    #[test]
    fn test_node_power_distribution() {
        let mut dist = NodePowerDistribution::new(1);
        for p in [140.0, 150.0, 160.0, 155.0, 145.0] {
            dist.add_sample(p);
        }

        dist.calculate_statistics();
        assert!(dist.average_power > 0.0);
        assert!(dist.min_power < dist.max_power);
        assert!(dist.percentile_5 <= dist.percentile_95);
    }

    #[test]
    fn test_fairness_summary() {
        let powers = vec![150.0, 155.0, 145.0];
        let mut metrics = FairnessMetrics::new(powers);
        metrics.calculate();

        let summary = metrics.describe();
        assert!(!summary.is_empty());
    }
}
