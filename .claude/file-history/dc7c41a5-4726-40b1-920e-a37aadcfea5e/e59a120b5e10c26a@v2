// Green-Distributed-Fabric Layer 2: Green Scheduler
// sleep_manager.fl - C-State 수면 상태 관리

use std::collections::VecDeque;

// ─────────────────────────────────────────────────────────────────
// CState: CPU 수면 상태 (Linux ACPI C-state 모델)
// ─────────────────────────────────────────────────────────────────

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum CState {
    C0,        // Active: 정상 실행
    C1,        // Halt: CPU 중지, 클럭 유지
    C3,        // Sleep: 캐시 flush, PLL 중지
    C6,        // DeepSleep: 코어 전원 차단
}

impl CState {
    pub fn power_ratio(&self) -> f64 {
        match self {
            CState::C0 => 1.0,
            CState::C1 => 0.70,
            CState::C3 => 0.20,
            CState::C6 => 0.02,
        }
    }

    pub fn exit_latency_us(&self) -> u32 {
        match self {
            CState::C0 => 0,
            CState::C1 => 1,
            CState::C3 => 50,
            CState::C6 => 200,
        }
    }

    pub fn entry_latency_us(&self) -> u32 {
        match self {
            CState::C0 => 0,
            CState::C1 => 1,
            CState::C3 => 20,
            CState::C6 => 100,
        }
    }

    pub fn min_residency_us(&self) -> u32 {
        // 최소 체류 시간: entry_cost + exit_cost < savings인 경우만 진입
        match self {
            CState::C0 => 0,
            CState::C1 => 10,
            CState::C3 => 100,
            CState::C6 => 1000,
        }
    }

    pub fn to_string(&self) -> String {
        match self {
            CState::C0 => "C0(Active)".to_string(),
            CState::C1 => "C1(Halt)".to_string(),
            CState::C3 => "C3(Sleep)".to_string(),
            CState::C6 => "C6(DeepSleep)".to_string(),
        }
    }
}

// ─────────────────────────────────────────────────────────────────
// SleepDecision: 수면 상태 진입 결정
// ─────────────────────────────────────────────────────────────────

#[derive(Clone, Debug)]
pub struct SleepDecision {
    pub target_state: CState,
    pub expected_idle_duration_us: u32,
    pub energy_saving_mj: f64,
    pub wake_latency_ok: bool,
}

impl SleepDecision {
    pub fn is_worth_entering(&self) -> bool {
        // energy_saving > entry_cost && wake_latency_ok
        self.energy_saving_mj > 0.1 && self.wake_latency_ok
    }
}

// ─────────────────────────────────────────────────────────────────
// IdleTimePredictor: 유휴 시간 예측
// ─────────────────────────────────────────────────────────────────

struct IdleTimePredictor {
    history: VecDeque<u32>,  // 최근 유휴 시간 샘플 (us)
    ewma_idle_us: f64,       // 지수 가중 이동 평균
    window_size: usize,
}

impl IdleTimePredictor {
    fn new(window_size: usize) -> IdleTimePredictor {
        IdleTimePredictor {
            history: VecDeque::new(),
            ewma_idle_us: 1000.0, // 기본값: 1ms
            window_size,
        }
    }

    fn predict_next_idle_us(&self) -> u32 {
        self.ewma_idle_us as u32
    }

    fn update(&mut self, actual_idle_us: u32) {
        // 지수 가중 이동 평균: alpha = 0.3
        self.ewma_idle_us = 0.7 * self.ewma_idle_us + 0.3 * (actual_idle_us as f64);

        self.history.push_back(actual_idle_us);
        if self.history.len() > self.window_size {
            self.history.pop_front();
        }
    }
}

// ─────────────────────────────────────────────────────────────────
// SleepManager: 수면 상태 관리자
// ─────────────────────────────────────────────────────────────────

pub struct SleepManager {
    current_state: CState,
    state_durations_us: [u64; 4], // C0/C1/C3/C6 누적 체류 시간
    idle_predictor: IdleTimePredictor,
    wakeup_deadline_us: u32,
}

impl SleepManager {
    pub fn new() -> SleepManager {
        SleepManager {
            current_state: CState::C0,
            state_durations_us: [0, 0, 0, 0],
            idle_predictor: IdleTimePredictor::new(20),
            wakeup_deadline_us: 0,
        }
    }

    pub fn decide_sleep_state(&self, _workload_idle: bool) -> SleepDecision {
        let predicted_idle = self.idle_predictor.predict_next_idle_us();

        let target = if predicted_idle > CState::C6.min_residency_us() {
            CState::C6
        } else if predicted_idle > CState::C3.min_residency_us() {
            CState::C3
        } else if predicted_idle > CState::C1.min_residency_us() {
            CState::C1
        } else {
            CState::C0
        };

        let energy_saving = 100.0 * (1.0 - target.power_ratio()); // mJ (근사)
        let wake_latency_ok = target.exit_latency_us() < self.wakeup_deadline_us;

        SleepDecision {
            target_state: target,
            expected_idle_duration_us: predicted_idle,
            energy_saving_mj: energy_saving,
            wake_latency_ok,
        }
    }

    pub fn enter_state(&mut self, state: CState) -> Result<u64, String> {
        // 무관용 규칙 5: sleep 진입 < 5ms = 5_000us
        let entry_time_us = state.entry_latency_us() as u64;

        if entry_time_us > 5_000 {
            return Err(format!("Entry time {}us exceeds 5ms limit", entry_time_us));
        }

        self.current_state = state;
        Ok(entry_time_us)
    }

    pub fn exit_to_active(&mut self) -> u64 {
        let exit_time_us = self.current_state.exit_latency_us() as u64;
        self.current_state = CState::C0;
        exit_time_us
    }

    pub fn record_duration(&mut self, duration_us: u64) {
        let idx = match self.current_state {
            CState::C0 => 0,
            CState::C1 => 1,
            CState::C3 => 2,
            CState::C6 => 3,
        };
        self.state_durations_us[idx] += duration_us;
    }

    pub fn update_idle_history(&mut self, actual_idle_us: u32) {
        self.idle_predictor.update(actual_idle_us);
    }

    pub fn efficiency_report(&self) -> SleepEfficiencyReport {
        let total: u64 = self.state_durations_us.iter().sum();

        let c0_ratio = if total > 0 {
            (self.state_durations_us[0] as f64) / (total as f64)
        } else {
            1.0
        };

        let c6_ratio = if total > 0 {
            (self.state_durations_us[3] as f64) / (total as f64)
        } else {
            0.0
        };

        // 평균 전력 절감 = C0 비율 - (C1×0.3 + C3×0.8 + C6×0.98) 비율의 합
        let avg_saving = c0_ratio - (
            (self.state_durations_us[1] as f64) / (total as f64) * 0.30
            + (self.state_durations_us[2] as f64) / (total as f64) * 0.80
            + (self.state_durations_us[3] as f64) / (total as f64) * 0.98
        );

        SleepEfficiencyReport {
            c0_ratio,
            c6_ratio,
            avg_power_saving_percent: (avg_saving * 100.0).max(0.0),
        }
    }

    pub fn current_state(&self) -> CState {
        self.current_state
    }

    pub fn set_wakeup_deadline(&mut self, deadline_us: u32) {
        self.wakeup_deadline_us = deadline_us;
    }
}

#[derive(Clone, Debug)]
pub struct SleepEfficiencyReport {
    pub c0_ratio: f64,           // Active 비율
    pub c6_ratio: f64,           // DeepSleep 비율
    pub avg_power_saving_percent: f64,
}

// ─────────────────────────────────────────────────────────────────
// 테스트
// ─────────────────────────────────────────────────────────────────

mod tests {
    use super::*;

    #[test]
    fn test_cstate_power_ratio() {
        assert_eq!(CState::C0.power_ratio(), 1.0);
        assert_eq!(CState::C6.power_ratio(), 0.02);
    }

    #[test]
    fn test_cstate_latencies() {
        assert_eq!(CState::C6.entry_latency_us(), 100);
        assert_eq!(CState::C6.exit_latency_us(), 200);
    }

    #[test]
    fn test_sleep_decision_worth_entering() {
        let decision = SleepDecision {
            target_state: CState::C6,
            expected_idle_duration_us: 2000,
            energy_saving_mj: 1.0,
            wake_latency_ok: true,
        };
        assert!(decision.is_worth_entering());
    }

    #[test]
    fn test_sleep_manager_creation() {
        let manager = SleepManager::new();
        assert_eq!(manager.current_state(), CState::C0);
    }

    #[test]
    fn test_decide_sleep_state() {
        let manager = SleepManager::new();
        let decision = manager.decide_sleep_state(true);
        assert!(decision.target_state != CState::C0);
    }

    #[test]
    fn test_enter_state() {
        let mut manager = SleepManager::new();
        let result = manager.enter_state(CState::C6);
        assert!(result.is_ok());
        let time_us = result.unwrap();
        assert!(time_us <= 5_000);
    }

    #[test]
    fn test_efficiency_report() {
        let mut manager = SleepManager::new();
        manager.record_duration(1000);
        let report = manager.efficiency_report();
        assert!(report.c0_ratio >= 0.0 && report.c0_ratio <= 1.0);
    }
}
