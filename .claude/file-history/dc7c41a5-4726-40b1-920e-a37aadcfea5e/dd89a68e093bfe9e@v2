// Phase 3.1.5 TrueType 파서
// TTF 바이너리 파일에서 글리프 좌표와 베지어 곡선 추출

#[derive(Clone, Copy, Debug)]
pub struct FontHeader {
    pub version: u32,
    pub num_glyphs: u16,
    pub units_per_em: u16,
    pub bounds_xmin: i16,
    pub bounds_ymin: i16,
    pub bounds_xmax: i16,
    pub bounds_ymax: i16,
}

#[derive(Clone, Debug)]
pub struct GlyphOutline {
    pub num_contours: i16,
    pub flags: Vec<u8>,
    pub x_coords: Vec<i16>,
    pub y_coords: Vec<i16>,
    pub end_pts: Vec<u16>,
}

impl GlyphOutline {
    pub fn new() -> Self {
        GlyphOutline {
            num_contours: 0,
            flags: Vec::new(),
            x_coords: Vec::new(),
            y_coords: Vec::new(),
            end_pts: Vec::new(),
        }
    }
}

// TrueType 글리프 플래그
pub const FLAG_ON_CURVE: u8 = 0x01;         // 점이 곡선 위에 있음
pub const FLAG_X_SHORT: u8 = 0x02;          // x 좌표가 1 byte
pub const FLAG_Y_SHORT: u8 = 0x04;          // y 좌표가 1 byte
pub const FLAG_REPEAT: u8 = 0x08;           // 플래그 반복
pub const FLAG_X_SAME: u8 = 0x10;           // x 좌표 동일
pub const FLAG_Y_SAME: u8 = 0x20;           // y 좌표 동일

pub struct TTFParser {
    pub data: Vec<u8>,
    pub header: FontHeader,
}

impl TTFParser {
    pub fn new(data: Vec<u8>) -> Self {
        TTFParser {
            data,
            header: FontHeader {
                version: 0,
                num_glyphs: 0,
                units_per_em: 1000,
                bounds_xmin: 0,
                bounds_ymin: 0,
                bounds_xmax: 0,
                bounds_ymax: 0,
            },
        }
    }

    // 파일 오프셋에서 big-endian u32 읽기
    fn read_u32(&self, offset: usize) -> u32 {
        if offset + 4 > self.data.len() {
            return 0;
        }
        ((self.data[offset] as u32) << 24)
            | ((self.data[offset + 1] as u32) << 16)
            | ((self.data[offset + 2] as u32) << 8)
            | (self.data[offset + 3] as u32)
    }

    // 오프셋에서 big-endian u16 읽기
    fn read_u16(&self, offset: usize) -> u16 {
        if offset + 2 > self.data.len() {
            return 0;
        }
        ((self.data[offset] as u16) << 8) | (self.data[offset + 1] as u16)
    }

    // 오프셋에서 big-endian i16 읽기 (signed)
    fn read_i16(&self, offset: usize) -> i16 {
        let u = self.read_u16(offset);
        if u & 0x8000 != 0 {
            (u as i16) - 0x10000 as i16  // 2의 보수
        } else {
            u as i16
        }
    }

    // 오프셋에서 u8 읽기
    fn read_u8(&self, offset: usize) -> u8 {
        if offset >= self.data.len() {
            0
        } else {
            self.data[offset]
        }
    }

    // 파일 시작에서 head 테이블 파싱 (간단화)
    pub fn parse_header(&mut self) {
        // 오프셋 16-18: Font revision (version)
        self.header.version = self.read_u32(16);

        // 오프셋 50-51: Units per EM
        self.header.units_per_em = self.read_u16(50);
        if self.header.units_per_em == 0 {
            self.header.units_per_em = 1000;
        }

        // 오프셋 36-37: xMin
        self.header.bounds_xmin = self.read_i16(36);
        // 오프셋 38-39: yMin
        self.header.bounds_ymin = self.read_i16(38);
        // 오프셋 40-41: xMax
        self.header.bounds_xmax = self.read_i16(40);
        // 오프셋 42-43: yMax
        self.header.bounds_ymax = self.read_i16(42);
    }

    // maxp 테이블에서 글리프 개수 읽기
    pub fn parse_glyph_count(&mut self) {
        // 일반적으로 오프셋 4-5에서 numGlyphs
        self.header.num_glyphs = self.read_u16(4);
        if self.header.num_glyphs == 0 {
            self.header.num_glyphs = 256;  // 기본값
        }
    }

    // 글리프 인덱스에 대해 윤곽선 파싱 (간단화)
    pub fn parse_glyph_outline(&self, glyph_index: u16, glyph_offset: usize) -> GlyphOutline {
        let mut outline = GlyphOutline::new();

        if glyph_offset >= self.data.len() {
            return outline;
        }

        // 오프셋 0-1: numberOfContours (-1 = 합성 글리프)
        outline.num_contours = self.read_i16(glyph_offset);

        if outline.num_contours < 0 {
            // 합성 글리프: 여기서는 처리하지 않음
            return outline;
        }

        if outline.num_contours == 0 {
            // 빈 글리프
            return outline;
        }

        let num_contours = outline.num_contours as usize;
        let mut offset = glyph_offset + 10;  // 헤더 크기

        // 끝점 읽기
        for _ in 0..num_contours {
            let end_pt = self.read_u16(offset);
            outline.end_pts.push(end_pt);
            offset += 2;
        }

        // 가장 큰 끝점이 점의 개수 - 1
        let num_points = if outline.end_pts.is_empty() {
            0
        } else {
            outline.end_pts[outline.end_pts.len() - 1] as usize + 1
        };

        // 지시사항 길이 읽기 (instruction length)
        let instr_len = self.read_u16(offset) as usize;
        offset += 2 + instr_len;  // 지시사항 건너뛰기

        // 플래그 읽기 (실행 압축 해제)
        for _ in 0..num_points {
            let flag = self.read_u8(offset);
            offset += 1;

            outline.flags.push(flag);

            if flag & FLAG_REPEAT != 0 {
                let repeat_count = self.read_u8(offset) as usize;
                offset += 1;
                for _ in 0..repeat_count {
                    outline.flags.push(flag);
                }
            }
        }

        // X 좌표 읽기
        let mut x = 0i16;
        for flag in &outline.flags {
            if flag & FLAG_X_SHORT != 0 {
                let delta = self.read_u8(offset) as i16;
                offset += 1;
                x += if flag & FLAG_X_SAME != 0 { delta } else { -delta };
            } else if flag & FLAG_X_SAME == 0 {
                x += self.read_i16(offset);
                offset += 2;
            }
            outline.x_coords.push(x);
        }

        // Y 좌표 읽기
        let mut y = 0i16;
        for flag in &outline.flags {
            if flag & FLAG_Y_SHORT != 0 {
                let delta = self.read_u8(offset) as i16;
                offset += 1;
                y += if flag & FLAG_Y_SAME != 0 { delta } else { -delta };
            } else if flag & FLAG_Y_SAME == 0 {
                y += self.read_i16(offset);
                offset += 2;
            }
            outline.y_coords.push(y);
        }

        outline
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_ttf_parser_creation() {
        let data = vec![0x00; 1000];
        let parser = TTFParser::new(data);
        assert_eq!(parser.data.len(), 1000);
    }

    #[test]
    fn test_read_u16() {
        let data = vec![0x12, 0x34, 0x56, 0x78];
        let parser = TTFParser::new(data);
        assert_eq!(parser.read_u16(0), 0x1234);
        assert_eq!(parser.read_u16(2), 0x5678);
    }

    #[test]
    fn test_read_i16_positive() {
        let data = vec![0x00, 0x10];  // +16
        let parser = TTFParser::new(data);
        assert_eq!(parser.read_i16(0), 16);
    }

    #[test]
    fn test_read_i16_negative() {
        let data = vec![0xFF, 0xFF];  // -1
        let parser = TTFParser::new(data);
        assert_eq!(parser.read_i16(0), -1);
    }

    #[test]
    fn test_glyph_outline_creation() {
        let outline = GlyphOutline::new();
        assert_eq!(outline.num_contours, 0);
        assert!(outline.flags.is_empty());
    }

    #[test]
    fn test_parse_header() {
        let mut data = vec![0x00; 100];
        // units_per_em at offset 50-51: 0x03E8 (1000)
        data[50] = 0x03;
        data[51] = 0xE8;

        let mut parser = TTFParser::new(data);
        parser.parse_header();
        assert_eq!(parser.header.units_per_em, 1000);
    }

    #[test]
    fn test_parse_glyph_count() {
        let mut data = vec![0x00; 10];
        // numGlyphs at offset 4-5: 256
        data[4] = 0x01;
        data[5] = 0x00;

        let mut parser = TTFParser::new(data);
        parser.parse_glyph_count();
        assert_eq!(parser.header.num_glyphs, 256);
    }
}
