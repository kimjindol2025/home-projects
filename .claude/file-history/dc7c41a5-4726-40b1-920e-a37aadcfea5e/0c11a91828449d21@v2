// Phase 4: Key Entropy Validation
// NIST 표준 엔트로피 검증

/// 엔트로피 분석 결과
#[derive(Clone, Debug)]
pub struct EntropyAnalysis {
    pub entropy_bits: f64,              // 추정 엔트로피 (비트)
    pub min_entropy: f64,               // 최소 엔트로피
    pub is_sufficient: bool,            // NIST 128-bit 충족
    pub byte_distribution: Vec<u32>,    // 각 바이트 값의 빈도
    pub unique_bytes: usize,            // 고유 바이트 개수 (0-256)
    pub collision_count: usize,         // 중복 바이트 개수
}

impl EntropyAnalysis {
    pub fn meets_nist_requirement(&self) -> bool {
        self.entropy_bits >= 128.0
    }
}

/// Shannon 엔트로피 계산
/// H(X) = -Σ(p_i * log2(p_i))
pub fn calculate_shannon_entropy(data: &[u8]) -> f64 {
    if data.is_empty() {
        return 0.0;
    }

    let mut frequency = [0u32; 256];
    for &byte in data {
        frequency[byte as usize] += 1;
    }

    let len = data.len() as f64;
    let mut entropy = 0.0;

    for &count in &frequency {
        if count > 0 {
            let probability = count as f64 / len;
            entropy -= probability * probability.log2();
        }
    }

    entropy * data.len() as f64  // 전체 엔트로피 (비트)
}

/// 최소 엔트로피 (Minimum Entropy)
/// -log2(max probability)
pub fn calculate_min_entropy(data: &[u8]) -> f64 {
    if data.is_empty() {
        return 0.0;
    }

    let mut frequency = [0u32; 256];
    for &byte in data {
        frequency[byte as usize] += 1;
    }

    let max_count = *frequency.iter().max().unwrap() as f64;
    let len = data.len() as f64;

    -((max_count / len).log2()) * data.len() as f64
}

/// 전체 엔트로피 분석
pub fn analyze_entropy(data: &[u8]) -> EntropyAnalysis {
    let shannon = calculate_shannon_entropy(data);
    let min_entropy = calculate_min_entropy(data);

    let mut frequency = [0u32; 256];
    let mut unique_bytes = 0;
    let mut collision_count = 0;

    for &byte in data {
        frequency[byte as usize] += 1;
    }

    for &count in &frequency {
        if count > 0 {
            unique_bytes += 1;
            if count > 1 {
                collision_count += count - 1;
            }
        }
    }

    EntropyAnalysis {
        entropy_bits: shannon,
        min_entropy,
        is_sufficient: shannon >= 128.0,
        byte_distribution: frequency.to_vec(),
        unique_bytes,
        collision_count: collision_count as usize,
    }
}

/// 바이트 분포 검증 (카이제곱 테스트 근사)
pub fn validate_byte_distribution(data: &[u8]) -> f64 {
    if data.len() < 256 {
        return 0.0;  // 샘플이 너무 작음
    }

    let mut frequency = [0u32; 256];
    for &byte in data {
        frequency[byte as usize] += 1;
    }

    let expected = data.len() as f64 / 256.0;
    let mut chi_square = 0.0;

    for &count in &frequency {
        let diff = count as f64 - expected;
        chi_square += (diff * diff) / expected;
    }

    // χ² → p-value (근사)
    // 낮은 값 = 균등 분포, 높은 값 = 불균등 분포
    1.0 / (1.0 + (chi_square / 256.0))
}

/// Runs Test (연속성 테스트)
/// 연속된 같은 바이트가 몇 개인지 확인
pub fn runs_test(data: &[u8]) -> f64 {
    if data.len() < 2 {
        return 0.0;
    }

    let mut runs = 1;
    for i in 1..data.len() {
        if data[i] != data[i - 1] {
            runs += 1;
        }
    }

    // 이상적: runs ≈ data.len() / 2
    let expected_runs = data.len() / 2;
    let run_quality = (runs as f64) / (expected_runs as f64).max(1.0);

    // 0.5 ~ 2.0 범위를 0.0 ~ 1.0으로 정규화
    (run_quality.min(2.0) / 2.0).max(0.0)
}

/// 종합 엔트로피 평가
pub fn comprehensive_entropy_evaluation(data: &[u8]) -> EntropyAnalysis {
    let mut analysis = analyze_entropy(data);

    // 추가 검증: 분포 균등성
    let distribution_score = validate_byte_distribution(data);
    let runs_score = runs_test(data);

    // 최종 엔트로피 = Shannon × (분포 점수 + runs 점수) / 2
    let adjustment_factor = (distribution_score + runs_score) / 2.0;
    analysis.entropy_bits *= adjustment_factor.max(0.8);  // 최소 80%

    analysis
}

/// 무관용 규칙: 엔트로피 >= 128 비트
pub fn meets_nist_requirement(key: &[u8]) -> bool {
    let analysis = analyze_entropy(key);
    analysis.meets_nist_requirement()
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_shannon_entropy_uniform() {
        // 균등한 분포: 최대 엔트로피
        let data: Vec<u8> = (0..=255).collect();
        let entropy = calculate_shannon_entropy(&data);
        assert!(entropy > 2000.0);  // 256 bytes * 8 bits = 2048 theoretical max
    }

    #[test]
    fn test_shannon_entropy_biased() {
        // 편향된 분포: 낮은 엔트로피
        let data: Vec<u8> = vec![0; 256];  // 모두 0
        let entropy = calculate_shannon_entropy(&data);
        assert_eq!(entropy, 0.0);  // 엔트로피 없음
    }

    #[test]
    fn test_min_entropy_uniform() {
        let data: Vec<u8> = (0..=255).collect();
        let min_entropy = calculate_min_entropy(&data);
        assert!(min_entropy > 1000.0);  // 각 바이트 1개씩 = -log2(1/256) * 256 ≈ 2048
    }

    #[test]
    fn test_min_entropy_biased() {
        let data: Vec<u8> = vec![0; 256];
        let min_entropy = calculate_min_entropy(&data);
        assert_eq!(min_entropy, 0.0);  // 모두 0 = -log2(1) * 256 = 0
    }

    #[test]
    fn test_entropy_analysis() {
        let data = vec![1u8, 2, 3, 4, 5, 1, 2, 3, 4, 5];
        let analysis = analyze_entropy(&data);

        assert!(analysis.entropy_bits > 0.0);
        assert!(analysis.min_entropy > 0.0);
        assert_eq!(analysis.unique_bytes, 5);
        assert!(analysis.collision_count > 0);
    }

    #[test]
    fn test_byte_distribution_uniform() {
        // 균등 분포 생성
        let mut data = Vec::new();
        for _ in 0..4 {
            for i in 0..256 {
                data.push(i as u8);
            }
        }

        let uniformity = validate_byte_distribution(&data);
        assert!(uniformity > 0.8);  // 대부분 균등함
    }

    #[test]
    fn test_byte_distribution_biased() {
        // 편향된 분포
        let mut data = vec![0u8; 256];
        data.extend_from_slice(&(0..=255).collect::<Vec<u8>>());

        let uniformity = validate_byte_distribution(&data);
        assert!(uniformity < 0.9);  // 약간 편향됨
    }

    #[test]
    fn test_runs_test() {
        // 많은 변화: 높은 runs
        let alternating: Vec<u8> = (0..100).map(|i| (i % 2) as u8).collect();
        let runs_score1 = runs_test(&alternating);

        // 적은 변화: 낮은 runs
        let static_data = vec![0u8; 100];
        let runs_score2 = runs_test(&static_data);

        assert!(runs_score1 > runs_score2);
    }

    #[test]
    fn test_nist_requirement_good_key() {
        // 좋은 키: 충분한 엔트로피
        let mut key = Vec::new();
        for i in 0..256 {
            key.push((i % 256) as u8);
        }

        assert!(meets_nist_requirement(&key));
    }

    #[test]
    fn test_nist_requirement_bad_key() {
        // 나쁜 키: 엔트로피 부족
        let bad_key = vec![0u8; 100];
        assert!(!meets_nist_requirement(&bad_key));
    }

    #[test]
    fn test_comprehensive_evaluation() {
        let mut data = Vec::new();
        for i in 0..512 {
            data.push((i % 256) as u8);
        }

        let analysis = comprehensive_entropy_evaluation(&data);

        println!("Entropy: {:.1} bits", analysis.entropy_bits);
        println!("Min Entropy: {:.1} bits", analysis.min_entropy);
        println!("Unique Bytes: {}/256", analysis.unique_bytes);
        println!("NIST Compliant: {}", analysis.is_sufficient);

        assert!(analysis.entropy_bits > 0.0);
    }

    #[test]
    fn test_entropy_of_deterministic_key() {
        // 결정적 키 생성 후 엔트로피 검증
        let mut key = vec![0u8; 32];
        for i in 0..32 {
            key[i] = ((i * 17 + 5) % 256) as u8;  // 결정적 생성
        }

        let analysis = analyze_entropy(&key);
        println!(
            "Key entropy: {:.1} bits (need >= 128)",
            analysis.entropy_bits
        );

        // 32바이트의 이상적 엔트로피 = 256 bits (8 * 32)
        assert!(analysis.entropy_bits > 0.0);
    }

    #[test]
    fn test_32byte_key_entropy() {
        // 32바이트 (256비트) 키의 이론적 최대 엔트로피
        let key: Vec<u8> = (0..32).collect();  // 32개의 다른 바이트
        let analysis = analyze_entropy(&key);

        println!("32-byte key entropy: {:.1} bits", analysis.entropy_bits);

        // 최소: 32 * 8 = 256 비트 (모두 다른 값)
        assert!(analysis.entropy_bits > 0.0);
    }
}
