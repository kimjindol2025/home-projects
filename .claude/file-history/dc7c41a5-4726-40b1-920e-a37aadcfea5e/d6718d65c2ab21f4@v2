// Phase 4: Template Encryption
// 신경망 모델(template) 암호화 및 복호화

use super::crypto_module::*;

/// 암호화된 템플릿
#[derive(Clone, Debug)]
pub struct EncryptedTemplate {
    pub ciphertext: Vec<u8>,         // 암호화된 데이터
    pub iv: Vec<u8>,                 // Initialization Vector (16 bytes)
    pub tag: Vec<u8>,                // 인증 태그 (16 bytes)
    pub encrypted_key: Vec<u8>,      // 암호화된 마스터 키 (32 bytes)
}

impl EncryptedTemplate {
    pub fn size_bytes(&self) -> usize {
        self.ciphertext.len() + self.iv.len() + self.tag.len() + self.encrypted_key.len()
    }
}

/// 평문 템플릿
#[derive(Clone, Debug)]
pub struct PlaintextTemplate {
    pub data: Vec<u8>,
}

impl PlaintextTemplate {
    pub fn new(data: Vec<u8>) -> Self {
        PlaintextTemplate { data }
    }

    pub fn size_bytes(&self) -> usize {
        self.data.len()
    }
}

/// 단순 AES-like 블록 암호 (시뮬레이션)
fn encrypt_block(plaintext: &[u8], key: &[u8], iv: &[u8]) -> (Vec<u8>, Vec<u8>, Vec<u8>) {
    // IV 생성 (고정: 실제로는 난수)
    let iv_used = if iv.is_empty() {
        sha256(b"initialization_vector").bytes[..16].to_vec()
    } else {
        iv[..16.min(iv.len())].to_vec()
    };

    // 키 확장
    let expanded_key = extend_key(key);

    // CBC 모드 암호화
    let mut ciphertext = Vec::new();
    let mut prev_block = iv_used.clone();

    for chunk in plaintext.chunks(16) {
        let mut block = vec![0u8; 16];
        for (i, &byte) in chunk.iter().enumerate() {
            block[i] = byte ^ prev_block[i % 16];
        }

        // 단순 암호화 라운드 (16 라운드)
        for _round in 0..16 {
            block = encrypt_round(&block, &expanded_key);
        }

        ciphertext.extend_from_slice(&block);
        prev_block = block;
    }

    // 인증 태그 생성 (GMAC-like)
    let tag = generate_auth_tag(&ciphertext, &expanded_key, &iv_used);

    (ciphertext, iv_used, tag)
}

/// 블록 암호화 라운드
fn encrypt_round(block: &[u8], key: &[u8]) -> Vec<u8> {
    let mut result = block.to_vec();

    // SubBytes (대체)
    for i in 0..16 {
        result[i] = (result[i] ^ key[i % key.len()]).wrapping_mul(0x1B);
    }

    // ShiftRows (순환)
    let temp = result.clone();
    result[0] = temp[0];
    result[1] = temp[5];
    result[2] = temp[10];
    result[3] = temp[15];
    result[4] = temp[4];
    result[5] = temp[9];
    result[6] = temp[14];
    result[7] = temp[3];
    result[8] = temp[8];
    result[9] = temp[13];
    result[10] = temp[2];
    result[11] = temp[7];
    result[12] = temp[12];
    result[13] = temp[1];
    result[14] = temp[6];
    result[15] = temp[11];

    // MixColumns (섞기)
    for i in (0..16).step_by(4) {
        let a0 = result[i];
        let a1 = result[i + 1];
        let a2 = result[i + 2];
        let a3 = result[i + 3];

        result[i] = a0 ^ a1 ^ a2 ^ a3;
        result[i + 1] = a0 ^ a1 ^ a2 ^ a3;
        result[i + 2] = a0 ^ a1 ^ a2 ^ a3;
        result[i + 3] = a0 ^ a1 ^ a2 ^ a3;
    }

    result
}

/// 키 확장
fn extend_key(key: &[u8]) -> Vec<u8> {
    let mut extended = key.to_vec();
    while extended.len() < 256 {
        let hash = sha256(&extended);
        extended.extend_from_slice(&hash.bytes[..32.min(256 - extended.len())]);
    }
    extended[..256].to_vec()
}

/// 인증 태그 생성 (GMAC-like)
fn generate_auth_tag(ciphertext: &[u8], key: &[u8], iv: &[u8]) -> Vec<u8> {
    let mut input = Vec::new();
    input.extend_from_slice(ciphertext);
    input.extend_from_slice(iv);
    input.extend_from_slice(key);

    let hash = sha256(&input);
    hash.bytes[..16].to_vec()
}

/// 단순 AES-like 블록 복호화
fn decrypt_block(
    ciphertext: &[u8],
    key: &[u8],
    iv: &[u8],
    expected_tag: &[u8],
) -> Result<Vec<u8>, String> {
    // 인증 태그 검증
    let expanded_key = extend_key(key);
    let computed_tag = generate_auth_tag(ciphertext, key, iv);

    if computed_tag != expected_tag {
        return Err("Authentication tag mismatch - data may be tampered".to_string());
    }

    // CBC 모드 복호화
    let mut plaintext = Vec::new();
    let mut prev_block = iv.to_vec();

    for chunk in ciphertext.chunks(16) {
        let mut block = chunk.to_vec();

        // 역 암호화 라운드
        for _round in 0..16 {
            block = decrypt_round(&block, &expanded_key);
        }

        // XOR with previous ciphertext block
        for (i, &byte) in block.iter().enumerate() {
            plaintext.push(byte ^ prev_block[i % prev_block.len()]);
        }

        prev_block = chunk.to_vec();
    }

    Ok(plaintext)
}

/// 블록 복호화 라운드
fn decrypt_round(block: &[u8], key: &[u8]) -> Vec<u8> {
    let mut result = block.to_vec();

    // Inverse MixColumns
    for i in (0..16).step_by(4) {
        let a0 = result[i];
        let a1 = result[i + 1];
        let a2 = result[i + 2];
        let a3 = result[i + 3];

        result[i] = a0 ^ a1;
        result[i + 1] = a1 ^ a2;
        result[i + 2] = a2 ^ a3;
        result[i + 3] = a3 ^ a0;
    }

    // Inverse ShiftRows
    let temp = result.clone();
    result[0] = temp[0];
    result[1] = temp[13];
    result[2] = temp[10];
    result[3] = temp[7];
    result[4] = temp[4];
    result[5] = temp[1];
    result[6] = temp[14];
    result[7] = temp[11];
    result[8] = temp[8];
    result[9] = temp[5];
    result[10] = temp[2];
    result[11] = temp[15];
    result[12] = temp[12];
    result[13] = temp[9];
    result[14] = temp[6];
    result[15] = temp[3];

    // Inverse SubBytes
    for i in 0..16 {
        result[i] = (result[i] ^ key[i % key.len()]).wrapping_div(0x1B);
    }

    result
}

/// 템플릿 암호화
pub fn encrypt_template(
    template: &PlaintextTemplate,
    encryption_key: &[u8],
) -> EncryptedTemplate {
    let (ciphertext, iv, tag) = encrypt_block(&template.data, encryption_key, &[]);

    // 마스터 키 암호화 (XOR cipher with tag)
    let encrypted_key = xor_cipher(encryption_key, &tag);

    EncryptedTemplate {
        ciphertext,
        iv,
        tag,
        encrypted_key,
    }
}

/// 템플릿 복호화
pub fn decrypt_template(
    encrypted: &EncryptedTemplate,
    decryption_key: &[u8],
) -> Result<PlaintextTemplate, String> {
    let plaintext = decrypt_block(
        &encrypted.ciphertext,
        decryption_key,
        &encrypted.iv,
        &encrypted.tag,
    )?;

    Ok(PlaintextTemplate { data: plaintext })
}

/// 라운드트립 검증 (암호화 → 복호화)
pub fn verify_encryption_roundtrip(
    template: &PlaintextTemplate,
    key: &[u8],
) -> Result<bool, String> {
    let encrypted = encrypt_template(template, key);
    let decrypted = decrypt_template(&encrypted, key)?;

    Ok(decrypted.data == template.data)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_plaintext_template_creation() {
        let data = vec![1, 2, 3, 4, 5];
        let template = PlaintextTemplate::new(data);
        assert_eq!(template.size_bytes(), 5);
    }

    #[test]
    fn test_encrypt_template() {
        let plaintext = PlaintextTemplate::new(b"secret_model_weights".to_vec());
        let key = b"encryption_key_32_bytes_long!!";

        let encrypted = encrypt_template(&plaintext, key);

        assert!(!encrypted.ciphertext.is_empty());
        assert_eq!(encrypted.iv.len(), 16);
        assert_eq!(encrypted.tag.len(), 16);
        assert_eq!(encrypted.encrypted_key.len(), 32);
    }

    #[test]
    fn test_decrypt_template() {
        let plaintext = PlaintextTemplate::new(b"model".to_vec());
        let key = b"key";

        let encrypted = encrypt_template(&plaintext, key);
        let decrypted = decrypt_template(&encrypted, key);

        assert!(decrypted.is_ok());
    }

    #[test]
    fn test_roundtrip_encryption() {
        let plaintext = PlaintextTemplate::new(b"neural_network_weights".to_vec());
        let key = b"encryption_secret_key";

        let result = verify_encryption_roundtrip(&plaintext, key);

        assert!(result.is_ok());
        assert!(result.unwrap());
    }

    #[test]
    fn test_encrypt_different_keys() {
        let plaintext = PlaintextTemplate::new(b"data".to_vec());
        let key1 = b"key1";
        let key2 = b"key2";

        let enc1 = encrypt_template(&plaintext, key1);
        let enc2 = encrypt_template(&plaintext, key2);

        assert_ne!(enc1.ciphertext, enc2.ciphertext);
    }

    #[test]
    fn test_authentication_tag_validation() {
        let plaintext = PlaintextTemplate::new(b"data".to_vec());
        let key = b"key";

        let mut encrypted = encrypt_template(&plaintext, key);

        // 태그를 변조
        encrypted.tag[0] ^= 0xFF;

        let result = decrypt_template(&encrypted, key);
        assert!(result.is_err());
        assert!(result.unwrap_err().contains("Authentication tag"));
    }

    #[test]
    fn test_ciphertext_tamper_detection() {
        let plaintext = PlaintextTemplate::new(b"secret".to_vec());
        let key = b"key";

        let mut encrypted = encrypt_template(&plaintext, key);

        // 암호문을 변조
        if !encrypted.ciphertext.is_empty() {
            encrypted.ciphertext[0] ^= 0xFF;
        }

        let result = decrypt_template(&encrypted, key);
        assert!(result.is_err());
    }

    #[test]
    fn test_large_template_encryption() {
        let mut large_data = Vec::new();
        for i in 0..10000 {
            large_data.push((i % 256) as u8);
        }

        let plaintext = PlaintextTemplate::new(large_data.clone());
        let key = b"encryption_key";

        let encrypted = encrypt_template(&plaintext, key);
        assert!(encrypted.size_bytes() > large_data.len());

        let decrypted = decrypt_template(&encrypted, key).unwrap();
        assert_eq!(decrypted.data, large_data);
    }

    #[test]
    fn test_encrypted_template_size() {
        let plaintext = PlaintextTemplate::new(vec![0u8; 100]);
        let key = b"key";

        let encrypted = encrypt_template(&plaintext, key);

        println!("Plaintext size: {} bytes", plaintext.size_bytes());
        println!("Encrypted size: {} bytes", encrypted.size_bytes());
        assert!(encrypted.size_bytes() > plaintext.size_bytes());
    }

    #[test]
    fn test_deterministic_iv_and_tag() {
        let plaintext = PlaintextTemplate::new(b"test".to_vec());
        let key = b"key";

        let enc1 = encrypt_template(&plaintext, key);
        let enc2 = encrypt_template(&plaintext, key);

        // 동일한 입력 = 동일한 암호화
        assert_eq!(enc1.iv, enc2.iv);
        assert_eq!(enc1.ciphertext, enc2.ciphertext);
        assert_eq!(enc1.tag, enc2.tag);
    }
}
