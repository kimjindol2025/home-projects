#[cfg(test)]
mod unforgiving_rules {
    use super::*;

    #[test]
    fn rule_1_output_validity_100_percent() {
        // Rule 1: 신경망 출력이 항상 [0, 1] 범위여야 함 = 100%
        let learner = L0NNBiometricLearner::new("user001".to_string());

        let test_cases = vec![
            BiometricProfile {
                typing_speed: 30.0, dwell_time: 30.0, flight_time: 60.0,
                touch_pressure: 0.3, heart_rate: 60.0, heart_rate_variability: 0.3,
                keystroke_count: 5, touch_count: 2, heartrate_count: 2,
            },
            BiometricProfile {
                typing_speed: 100.0, dwell_time: 100.0, flight_time: 200.0,
                touch_pressure: 0.99, heart_rate: 120.0, heart_rate_variability: 0.95,
                keystroke_count: 50, touch_count: 30, heartrate_count: 30,
            },
            BiometricProfile {
                typing_speed: 65.0, dwell_time: 65.0, flight_time: 130.0,
                touch_pressure: 0.65, heart_rate: 75.0, heart_rate_variability: 0.5,
                keystroke_count: 20, touch_count: 10, heartrate_count: 10,
            },
        ];

        let mut all_valid = true;
        for profile in &test_cases {
            let score = learner.confidence_score(profile);
            if score < 0.0 || score > 1.0 {
                all_valid = false;
                break;
            }
        }

        assert!(all_valid);
        println!("✅ RULE 1 PASS: Output Validity 100% (3/3 valid)");
    }

    #[test]
    fn rule_2_training_convergence_tracking() {
        // Rule 2: 학습이 반복될수록 평균 손실이 추적되어야 함
        let mut learner = L0NNBiometricLearner::new("user001".to_string());

        let profile = BiometricProfile {
            typing_speed: 50.0, dwell_time: 50.0, flight_time: 100.0,
            touch_pressure: 0.7, heart_rate: 72.0, heart_rate_variability: 0.5,
            keystroke_count: 10, touch_count: 5, heartrate_count: 5,
        };

        let initial_loss = learner.average_loss;

        for _ in 0..50 {
            learner.learn_user_pattern(&profile, 1.0);
        }

        // 학습 횟수가 증가했는지 확인
        assert_eq!(learner.training_count, 50);
        // 평균 손실이 추적되는지 확인
        assert!(learner.average_loss >= 0.0);

        println!("✅ RULE 2 PASS: Training Convergence (iterations={}, avg_loss={:.4})",
            learner.training_count, learner.average_loss);
    }

    #[test]
    fn rule_3_prediction_consistency() {
        // Rule 3: 동일 입력에 대해 예측이 일관성 있어야 함
        let learner = L0NNBiometricLearner::new("user001".to_string());

        let profile = BiometricProfile {
            typing_speed: 50.0, dwell_time: 50.0, flight_time: 100.0,
            touch_pressure: 0.7, heart_rate: 72.0, heart_rate_variability: 0.5,
            keystroke_count: 10, touch_count: 5, heartrate_count: 5,
        };

        let predictions: Vec<f64> = (0..10)
            .map(|_| learner.confidence_score(&profile))
            .collect();

        // 모든 예측이 동일해야 함
        let first = predictions[0];
        let all_same = predictions.iter().all(|&p| (p - first).abs() < 0.0001);

        assert!(all_same);
        println!("✅ RULE 3 PASS: Prediction Consistency (10/10 identical)");
    }

    #[test]
    fn rule_4_authentication_decision_boundary() {
        // Rule 4: 인증 판단이 명확한 경계를 가져야 함
        let mut learner = L0NNBiometricLearner::new("user001".to_string());

        let genuine_profile = BiometricProfile {
            typing_speed: 50.0, dwell_time: 50.0, flight_time: 100.0,
            touch_pressure: 0.7, heart_rate: 72.0, heart_rate_variability: 0.5,
            keystroke_count: 10, touch_count: 5, heartrate_count: 5,
        };

        // 본인 패턴으로 20회 학습
        for _ in 0..20 {
            learner.learn_user_pattern(&genuine_profile, 1.0);
        }

        let score = learner.confidence_score(&genuine_profile);
        let threshold = 0.5;

        let auth_result = learner.authenticate(&genuine_profile, threshold);
        let expected_result = score >= threshold;

        assert_eq!(auth_result, expected_result);
        println!("✅ RULE 4 PASS: Authentication Decision Boundary (score={:.4}, threshold={}, result={})",
            score, threshold, auth_result);
    }
}

