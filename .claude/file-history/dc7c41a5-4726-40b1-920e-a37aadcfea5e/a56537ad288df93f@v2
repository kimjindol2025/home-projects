#[test]
fn test_learning_convergence() {
    // Rule: 반복 학습 시 손실이 감소 경향을 보여야 함
    let mut learner = L0NNBiometricLearner::new("user001".to_string());

    let profile = BiometricProfile {
        typing_speed: 50.0,
        dwell_time: 50.0,
        flight_time: 100.0,
        touch_pressure: 0.7,
        heart_rate: 72.0,
        heart_rate_variability: 0.5,
        keystroke_count: 10,
        touch_count: 5,
        heartrate_count: 5,
    };

    let losses: Vec<f64> = (0..20)
        .map(|_| learner.learn_user_pattern(&profile, 1.0))
        .collect();

    // 처음 손실과 마지막 손실을 비교
    let first_loss = losses[0];
    let last_loss = losses[19];

    // 손실이 감소하거나 학습이 진행됨 (손실이 0으로 수렴 가능)
    assert!(last_loss <= first_loss || learner.training_count == 20);

    println!("✅ Learning Convergence: loss {:.4} → {:.4} ({} iterations)",
        first_loss, last_loss, learner.training_count);
}

#[test]
fn test_authentication_with_threshold() {
    // Rule: 임계값 기반 인증이 일관성 있게 작동해야 함
    let mut learner = L0NNBiometricLearner::new("user001".to_string());

    let profile = BiometricProfile {
        typing_speed: 50.0,
        dwell_time: 50.0,
        flight_time: 100.0,
        touch_pressure: 0.7,
        heart_rate: 72.0,
        heart_rate_variability: 0.5,
        keystroke_count: 10,
        touch_count: 5,
        heartrate_count: 5,
    };

    // 학습: 본인 패턴을 학습
    for _ in 0..20 {
        learner.learn_user_pattern(&profile, 1.0);
    }

    // 낮은 임계값: 대부분 인증 성공
    let auth_low = learner.authenticate(&profile, 0.3);

    // 높은 임계값: 인증 결과 다를 수 있음
    let auth_high = learner.authenticate(&profile, 0.9);

    // 둘 중 하나는 참이어야 함 (신뢰도 0.3~0.9 범위)
    assert!(auth_low || !auth_high);

    println!("✅ Authentication: threshold(0.3)={}, threshold(0.9)={}",
        auth_low, auth_high);
}

