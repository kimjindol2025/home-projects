#[test]
fn test_neuron_creation_and_weights() {
    // Rule: 뉴런 초기화 후 가중치가 정확히 설정되어야 함
    let neuron = BiometricNeuron::new(6, Activation::ReLU, 0.01);

    assert_eq!(neuron.weights.len(), 6);
    assert_eq!(neuron.learning_rate, 0.01);
    assert!(neuron.bias >= -1.0 && neuron.bias <= 1.0);

    println!("✅ Neuron Creation: weights={} dimensions, bias={:.4}",
        neuron.weights.len(), neuron.bias);
}

#[test]
fn test_activation_functions_all_types() {
    // Rule: 모든 활성화 함수가 올바른 범위의 출력을 생성해야 함

    // Linear: 입력 그대로 반환
    assert_eq!(Activation::Linear.apply(5.0), 5.0);
    assert_eq!(Activation::Linear.apply(-3.0), -3.0);

    // ReLU: x >= 0이면 x, 아니면 0
    assert_eq!(Activation::ReLU.apply(5.0), 5.0);
    assert_eq!(Activation::ReLU.apply(-5.0), 0.0);

    // Sigmoid: [0, 1] 범위
    let sigmoid_output = Activation::Sigmoid.apply(0.0);
    assert!(sigmoid_output > 0.4 && sigmoid_output < 0.6);  // 약 0.5

    let sigmoid_pos = Activation::Sigmoid.apply(10.0);
    assert!(sigmoid_pos > 0.99 && sigmoid_pos <= 1.0);

    let sigmoid_neg = Activation::Sigmoid.apply(-10.0);
    assert!(sigmoid_neg >= 0.0 && sigmoid_neg < 0.01);

    // Tanh: [-1, 1] 범위
    let tanh_output = Activation::Tanh.apply(0.0);
    assert!(tanh_output > -0.1 && tanh_output < 0.1);

    let tanh_pos = Activation::Tanh.apply(10.0);
    assert!(tanh_pos > 0.99 && tanh_pos <= 1.0);

    println!("✅ Activation Functions: all ranges verified");
}

#[test]
fn test_neuron_forward_pass() {
    // Rule: Forward pass가 deterministic해야 함
    let neuron = BiometricNeuron::new(3, Activation::Sigmoid, 0.01);

    let inputs = vec![0.5, 0.5, 0.5];
    let output1 = neuron.forward(&inputs);
    let output2 = neuron.forward(&inputs);

    assert_eq!(output1, output2);  // 동일 입력 = 동일 출력
    assert!(output1 >= 0.0 && output1 <= 1.0);  // Sigmoid 범위

    println!("✅ Neuron Forward Pass: deterministic (output={:.4})", output1);
}

#[test]
fn test_neuron_backward_pass() {
    // Rule: Backward pass가 가중치를 올바르게 업데이트해야 함
    let mut neuron = BiometricNeuron::new(2, Activation::Linear, 0.1);

    let inputs = vec![1.0, 1.0];
    let initial_weight_sum: f64 = neuron.weights.iter().sum();

    neuron.backward(&inputs, 0.5);  // 에러 0.5

    let updated_weight_sum: f64 = neuron.weights.iter().sum();

    // 가중치가 업데이트되어야 함
    assert_ne!(initial_weight_sum, updated_weight_sum);

    // 가중치 변화가 learning_rate에 비례
    let expected_change = 0.1 * 0.5 * 1.0;  // learning_rate * error * input
    let actual_change = (updated_weight_sum - initial_weight_sum).abs();
    assert!(actual_change > 0.0);

    println!("✅ Neuron Backward Pass: weights updated (delta={:.4})", actual_change);
}

