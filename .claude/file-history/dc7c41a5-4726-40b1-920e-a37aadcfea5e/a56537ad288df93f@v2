#[test]
fn test_model_evaluation() {
    // Rule: 평가 함수가 정확도를 올바르게 계산해야 함
    let mut learner = L0NNBiometricLearner::new("user001".to_string());

    // 학습 데이터
    let train_profiles = vec![
        BiometricProfile {
            typing_speed: 50.0, dwell_time: 50.0, flight_time: 100.0,
            touch_pressure: 0.7, heart_rate: 72.0, heart_rate_variability: 0.5,
            keystroke_count: 10, touch_count: 5, heartrate_count: 5,
        },
        BiometricProfile {
            typing_speed: 55.0, dwell_time: 48.0, flight_time: 98.0,
            touch_pressure: 0.72, heart_rate: 73.0, heart_rate_variability: 0.51,
            keystroke_count: 10, touch_count: 5, heartrate_count: 5,
        },
    ];

    for profile in &train_profiles {
        for _ in 0..10 {
            learner.learn_user_pattern(profile, 1.0);
        }
    }

    // 평가 데이터
    let test_profiles = vec![
        BiometricProfile {
            typing_speed: 52.0, dwell_time: 49.0, flight_time: 99.0,
            touch_pressure: 0.71, heart_rate: 72.5, heart_rate_variability: 0.5,
            keystroke_count: 10, touch_count: 5, heartrate_count: 5,
        },
    ];
    let labels = vec![1.0];  // 본인

    let metrics = learner.evaluate(&test_profiles, &labels);

    assert!(metrics.accuracy >= 0.0 && metrics.accuracy <= 1.0);
    assert!(metrics.avg_error >= 0.0);
    assert_eq!(metrics.total_samples, 1);

    println!("✅ Model Evaluation: accuracy={:.2}%, avg_error={:.4}",
        metrics.accuracy * 100.0, metrics.avg_error);
}

