```rust
pub enum ExtendedPattern {
    // Existing 6 from Phase 1
    MemoryLeak,
    IOBottleneck,
    ThreadContention,
    PeriodicLoad,
    CacheThreshing,
    CombinedPressure,

    // Phase 2 new (7-12)
