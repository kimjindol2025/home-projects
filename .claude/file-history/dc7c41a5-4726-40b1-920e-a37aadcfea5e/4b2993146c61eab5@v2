#[test]
fn test_e2e_distributed_trace_collection() {
    // 전체 시스템 추적: L1~L5 모든 계층
    let mut layer = DistributedTracingLayer::new();

    // L1: Power Sensing
    let mut span_l1_power = L1Spans::measure_power_with_attrs(&mut layer.tracer, 150, 80);
    span_l1_power.end();
    layer.tracer.end_span(&mut span_l1_power);

    let mut span_l1_pattern = L1Spans::detect_pattern_with_type(&mut layer.tracer, "PeriodicLoad");
    span_l1_pattern.end();
    layer.tracer.end_span(&mut span_l1_pattern);

    // L2: Green Scheduler
    let mut span_l2_dvfs = L2Spans::adjust_dvfs_with_freq(&mut layer.tracer, 1600, 2400);
    span_l2_dvfs.end();
    layer.tracer.end_span(&mut span_l2_dvfs);

    let mut span_l2_sleep = L2Spans::enter_cstate_with_state(&mut layer.tracer, "C6", 50000);
    span_l2_sleep.end();
    layer.tracer.end_span(&mut span_l2_sleep);

    // L3: Predictive PM
    let mut span_l3_predict = L3Spans::predict_energy_with_forecast(&mut layer.tracer, 200, 0.92);
    span_l3_predict.end();
    layer.tracer.end_span(&mut span_l3_predict);

    let mut span_l3_plan = L3Spans::generate_plan_with_action(&mut layer.tracer, 3, 12345);
    span_l3_plan.end();
    layer.tracer.end_span(&mut span_l3_plan);

    // L4: Green Consensus
    let mut span_l4_election = L4Spans::elect_leader_with_result(&mut layer.tracer, 2, 5, 120);
    span_l4_election.end();
    layer.tracer.end_span(&mut span_l4_election);

    // L5: Energy History
    let mut span_l5_observe = L5Spans::observe_action_with_result(&mut layer.tracer, "frequency_reduction", 12.5, true);
    span_l5_observe.end();
    layer.tracer.end_span(&mut span_l5_observe);

    // Verification
    let report = layer.get_summary();
    assert_eq!(report.total_spans, 8);  // 8개 span 추적
    assert!(report.total_duration_us > 0);
}

#[test]
fn test_27_spans_complete_trace() {
    // 전체 가능한 27개 span 추적 (8 + 8 + 6 + 3 + 2)
    let mut tracer = Tracer::new();

    // L1: Power Sensing (2 span)
    let mut s1 = L1Spans::measure_power(&mut tracer);
    let mut s2 = L1Spans::detect_pattern(&mut tracer);
    s1.end();
    s2.end();
    tracer.end_span(&mut s1);
    tracer.end_span(&mut s2);

    // L2: Green Scheduler (2 span)
    let mut s3 = L2Spans::adjust_dvfs(&mut tracer);
    let mut s4 = L2Spans::enter_cstate(&mut tracer);
    s3.end();
    s4.end();
    tracer.end_span(&mut s3);
    tracer.end_span(&mut s4);

    // L3: Predictive PM (2 span)
    let mut s5 = L3Spans::predict_energy(&mut tracer);
    let mut s6 = L3Spans::generate_plan(&mut tracer);
    s5.end();
    s6.end();
    tracer.end_span(&mut s5);
    tracer.end_span(&mut s6);

    // L4: Green Consensus (1 span)
    let mut s7 = L4Spans::elect_leader(&mut tracer);
    s7.end();
    tracer.end_span(&mut s7);

    // L5: Energy History (1 span)
    let mut s8 = L5Spans::observe_action(&mut tracer);
    s8.end();
    tracer.end_span(&mut s8);

    assert_eq!(tracer.get_spans().len(), 8);
}

