#[test]
fn test_trace_context_propagation_w3c() {
    // W3C Trace Context 표준 기반 전파
    let trace_id = TraceId::new();
    let parent_span_id = SpanId::new();

    let context = TraceContext::new(trace_id, parent_span_id)
        .with_baggage("service", "l3_predictor")
        .with_baggage("user_id", "12345");

    // Inject into headers
    let headers = DistributedPropagator::inject(&context);
    assert!(headers.contains_key("traceparent"));
    assert!(headers.contains_key("baggage"));

    // Extract from headers
    let extracted = DistributedPropagator::extract(&headers);
    assert!(extracted.is_some());

    let extracted_ctx = extracted.unwrap();
    assert_eq!(extracted_ctx.baggage.get("service"), Some(&"l3_predictor".to_string()));
    assert_eq!(extracted_ctx.baggage.get("user_id"), Some(&"12345".to_string()));
}

#[test]
fn test_multi_node_trace_propagation() {
    // 다중 노드 간 trace 전파 시뮬레이션
    let trace_id = TraceId::new();

    // Node 1: Initiate trace
    let mut tracer_node1 = Tracer::with_trace_id(trace_id);
    let mut span_node1 = tracer_node1.start_span("l1.measure_power");
    span_node1.end();
    tracer_node1.end_span(&mut span_node1);

    // Propagate to Node 2
    let context = TraceContext::new(trace_id, span_node1.span_id);
    let headers = DistributedPropagator::inject(&context);

    // Node 2: Continue trace
    let extracted_ctx = DistributedPropagator::extract(&headers).unwrap();
    let mut tracer_node2 = Tracer::with_trace_id(extracted_ctx.trace_id);
    let mut span_node2 = tracer_node2.start_span("l3.predict_energy");
    span_node2.end();
    tracer_node2.end_span(&mut span_node2);

    // Both nodes have same trace ID
    assert_eq!(tracer_node1.current_trace_id.high, tracer_node2.current_trace_id.high);
    assert_eq!(tracer_node1.current_trace_id.low, tracer_node2.current_trace_id.low);
}

#[test]
fn test_sampling_decision() {
    // Sampling rate 적용
    let layer_100 = DistributedTracingLayer::new()
        .with_sampling_rate(1.0);
    assert!(layer_100.should_trace());

    let layer_50 = DistributedTracingLayer::new()
        .with_sampling_rate(0.5);
    // 50% 샘플링은 확률적 - 여러 번 호출하면 일부는 true, 일부는 false

    let layer_0 = DistributedTracingLayer::new()
        .with_sampling_rate(0.0);
    // 0% 샘플링: trace 안 함 (disabled는 false이므로 sampling_rate 체크)
}

#[test]
fn test_latency_percentile_analysis() {
    // P50, P99 지연시간 분석
    use crate::tracing::distributed_propagation::RollupAggregator;

    let mut aggregator = RollupAggregator::new();

    // L1 span latencies (시뮬레이션된 지연)
    for i in 0..100 {
        let latency = 900 + (i % 200) as u64;  // 900-1099 us
        aggregator.record_span_latency("l1.measure_power", latency);
    }

    let p50 = aggregator.get_p50_latency("l1.measure_power");
    let p99 = aggregator.get_p99_latency("l1.measure_power");

    assert!(p50 > 900);
    assert!(p99 > p50);
}

#[cfg(test)]
mod unforgiving_rules {
    use super::*;

    #[test]
    fn rule_1_span_collection_completeness() {
        // Rule: 모든 8가지 핵심 span 추적 가능
        let trace_id = TraceId::new();
        let mut tracer = Tracer::with_trace_id(trace_id);

        let span_names = vec![
            "l1.measure_power",
            "l1.detect_pattern",
            "l2.adjust_dvfs",
            "l2.enter_cstate",
            "l3.predict_energy",
            "l3.generate_plan",
            "l4.elect_leader",
            "l5.observe_action",
        ];

        for name in span_names {
            let mut span = tracer.start_span(name);
            span.end();
            tracer.end_span(&mut span);
        }

        assert_eq!(tracer.get_spans().len(), 8, "RULE 1: Must track all 8 core spans");
    }

    #[test]
    fn rule_2_metrics_collection_capability() {
        // Rule: 최소 40개 이상 메트릭 수집 가능
        let mut collector = MetricsCollector::new();

        for i in 0..50 {
            let metric = Metric::new(&format!("metric_{}", i), i as f64, "unit");
            collector.collect(metric);
        }

        assert!(collector.get_metric_count() >= 40, "RULE 2: Must collect at least 40 metrics");
    }

    #[test]
    fn rule_3_trace_propagation_success() {
        // Rule: Trace propagation success rate >= 95%
        let trace_id = TraceId::new();
        let parent_span = SpanId::new();

        let context = TraceContext::new(trace_id, parent_span);
        let headers = DistributedPropagator::inject(&context);

        let result = DistributedPropagator::extract(&headers);
        assert!(result.is_some(), "RULE 3: Trace propagation must succeed");

        let extracted = result.unwrap();
        assert_eq!(
            extracted.trace_id.high, trace_id.high,
            "RULE 3: Trace ID must be preserved during propagation"
        );
    }
}
