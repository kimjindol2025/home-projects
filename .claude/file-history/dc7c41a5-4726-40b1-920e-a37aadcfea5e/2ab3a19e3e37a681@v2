// Phase 5: Wearable Sensor Integration
// 웨어러블 기기 센서 추상화 (BLE/NFC 연결)

#[derive(Clone, Debug, PartialEq)]
pub enum WearableDeviceType {
    SmartWatch,
    FitnessBand,
    MedicalPatch,
}

#[derive(Clone, Debug)]
pub struct WearableDevice {
    pub device_id: String,
    pub device_type: WearableDeviceType,
    pub connection: String,               // "BLE" / "NFC" / "USB"
    pub battery_level: u8,                // 0-100
    pub firmware_version: String,
    pub is_connected: bool,
}

#[derive(Clone, Debug)]
pub struct SensorReading {
    pub device_id: String,
    pub heart_rate_bpm: f64,
    pub heart_rate_variability: f64,     // 0.0-1.0
    pub accelerometer_x: f64,
    pub accelerometer_y: f64,
    pub accelerometer_z: f64,
    pub skin_conductance: f64,           // 피부 전기 반응
    pub confidence: f64,                  // 센서 신뢰도 0.0-1.0
    pub timestamp: u64,
}

#[derive(Clone, Debug)]
pub struct WearableSensorHub {
    devices: Vec<WearableDevice>,
    readings_buffer: Vec<SensorReading>,
}

impl WearableSensorHub {
    pub fn new() -> Self {
        WearableSensorHub {
            devices: Vec::new(),
            readings_buffer: Vec::new(),
        }
    }

    /// 웨어러블 기기 연결
    pub fn connect_device(&mut self, device: WearableDevice) -> Result<(), String> {
        if device.device_id.is_empty() {
            return Err("Device ID cannot be empty".to_string());
        }

        // 중복 확인
        if self.devices.iter().any(|d| d.device_id == device.device_id) {
            return Err("Device already connected".to_string());
        }

        let mut new_device = device;
        new_device.is_connected = true;
        self.devices.push(new_device);

        Ok(())
    }

    /// 기기 목록 조회
    pub fn list_devices(&self) -> Vec<WearableDevice> {
        self.devices.clone()
    }

    /// 특정 기기에서 센서 데이터 읽기
    pub fn read_sensor(&mut self, device_id: &str) -> Result<SensorReading, String> {
        let device = self
            .devices
            .iter_mut()
            .find(|d| d.device_id == device_id)
            .ok_or("Device not found".to_string())?;

        if !device.is_connected {
            return Err("Device not connected".to_string());
        }

        // 센서 데이터 시뮬레이션
        let reading = SensorReading {
            device_id: device_id.to_string(),
            heart_rate_bpm: 72.0 + (device_id.len() as f64 * 0.5),
            heart_rate_variability: 0.5,
            accelerometer_x: 0.1,
            accelerometer_y: 0.05,
            accelerometer_z: 0.02,
            skin_conductance: 0.3,
            confidence: 0.95,
            timestamp: 1704067200,
        };

        self.readings_buffer.push(reading.clone());
        if self.readings_buffer.len() > 100 {
            self.readings_buffer.remove(0);
        }

        Ok(reading)
    }

    /// 다중 기기 센서 데이터 융합
    pub fn multi_device_fuse(&mut self, device_ids: &[&str]) -> Result<SensorReading, String> {
        if device_ids.is_empty() {
            return Err("No devices specified for fusion".to_string());
        }

        let mut readings = Vec::new();
        for device_id in device_ids {
            let reading = self.read_sensor(device_id)?;
            readings.push(reading);
        }

        // 가중 평균 계산 (신뢰도 기반)
        let total_confidence: f64 = readings.iter().map(|r| r.confidence).sum();
        let weights: Vec<f64> = readings
            .iter()
            .map(|r| r.confidence / total_confidence)
            .collect();

        let fused_bpm: f64 = readings
            .iter()
            .zip(&weights)
            .map(|(r, w)| r.heart_rate_bpm * w)
            .sum();

        let fused_hrv: f64 = readings
            .iter()
            .zip(&weights)
            .map(|(r, w)| r.heart_rate_variability * w)
            .sum();

        let fused_confidence = total_confidence / device_ids.len() as f64;

        Ok(SensorReading {
            device_id: format!("fused_{}", device_ids.join("_")),
            heart_rate_bpm: fused_bpm,
            heart_rate_variability: fused_hrv,
            accelerometer_x: 0.1,
            accelerometer_y: 0.05,
            accelerometer_z: 0.02,
            skin_conductance: 0.3,
            confidence: fused_confidence,
            timestamp: 1704067200,
        })
    }

    /// Phase 1 HeartRateSignal로 변환
    pub fn to_heart_rate_signal(&self, reading: &SensorReading) -> crate::signals::HeartRateSignal {
        crate::signals::HeartRateSignal {
            bpm: reading.heart_rate_bpm,
            timestamp: reading.timestamp,
            variability: reading.heart_rate_variability,
            confidence: reading.confidence,
        }
    }

    /// 기기 연결 해제
    pub fn disconnect_device(&mut self, device_id: &str) -> Result<(), String> {
        let device = self
            .devices
            .iter_mut()
            .find(|d| d.device_id == device_id)
            .ok_or("Device not found".to_string())?;

        device.is_connected = false;
        Ok(())
    }

    /// 배터리 잔량 경고
    pub fn check_battery_status(&self) -> Vec<(String, u8)> {
        self.devices
            .iter()
            .filter(|d| d.battery_level < 20 && d.is_connected)
            .map(|d| (d.device_id.clone(), d.battery_level))
            .collect()
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_wearable_device_creation() {
        let device = WearableDevice {
            device_id: "watch001".to_string(),
            device_type: WearableDeviceType::SmartWatch,
            connection: "BLE".to_string(),
            battery_level: 85,
            firmware_version: "1.0.0".to_string(),
            is_connected: false,
        };
        assert_eq!(device.device_id, "watch001");
        assert_eq!(device.battery_level, 85);
    }

    #[test]
    fn test_sensor_hub_connect_device() {
        let mut hub = WearableSensorHub::new();
        let device = WearableDevice {
            device_id: "watch001".to_string(),
            device_type: WearableDeviceType::SmartWatch,
            connection: "BLE".to_string(),
            battery_level: 85,
            firmware_version: "1.0.0".to_string(),
            is_connected: false,
        };

        let result = hub.connect_device(device);
        assert!(result.is_ok());
        assert_eq!(hub.list_devices().len(), 1);
    }

    #[test]
    fn test_sensor_hub_connect_duplicate() {
        let mut hub = WearableSensorHub::new();
        let device1 = WearableDevice {
            device_id: "watch001".to_string(),
            device_type: WearableDeviceType::SmartWatch,
            connection: "BLE".to_string(),
            battery_level: 85,
            firmware_version: "1.0.0".to_string(),
            is_connected: false,
        };
        let device2 = WearableDevice {
            device_id: "watch001".to_string(),
            device_type: WearableDeviceType::FitnessBand,
            connection: "NFC".to_string(),
            battery_level: 50,
            firmware_version: "1.1.0".to_string(),
            is_connected: false,
        };

        hub.connect_device(device1).unwrap();
        let result = hub.connect_device(device2);
        assert!(result.is_err());
    }

    #[test]
    fn test_read_sensor_data() {
        let mut hub = WearableSensorHub::new();
        let device = WearableDevice {
            device_id: "watch001".to_string(),
            device_type: WearableDeviceType::SmartWatch,
            connection: "BLE".to_string(),
            battery_level: 85,
            firmware_version: "1.0.0".to_string(),
            is_connected: false,
        };

        hub.connect_device(device).unwrap();
        let reading = hub.read_sensor("watch001").unwrap();

        assert!(reading.heart_rate_bpm > 0.0);
        assert!(reading.confidence > 0.0 && reading.confidence <= 1.0);
    }

    #[test]
    fn test_multi_device_fusion() {
        let mut hub = WearableSensorHub::new();

        let device1 = WearableDevice {
            device_id: "watch001".to_string(),
            device_type: WearableDeviceType::SmartWatch,
            connection: "BLE".to_string(),
            battery_level: 85,
            firmware_version: "1.0.0".to_string(),
            is_connected: false,
        };
        let device2 = WearableDevice {
            device_id: "band001".to_string(),
            device_type: WearableDeviceType::FitnessBand,
            connection: "NFC".to_string(),
            battery_level: 70,
            firmware_version: "1.0.0".to_string(),
            is_connected: false,
        };

        hub.connect_device(device1).unwrap();
        hub.connect_device(device2).unwrap();

        let fused = hub.multi_device_fuse(&["watch001", "band001"]).unwrap();
        assert!(fused.confidence >= 0.0 && fused.confidence <= 1.0);
        assert!(fused.heart_rate_bpm > 0.0);
    }

    #[test]
    fn test_battery_status_check() {
        let mut hub = WearableSensorHub::new();
        let device = WearableDevice {
            device_id: "watch001".to_string(),
            device_type: WearableDeviceType::SmartWatch,
            connection: "BLE".to_string(),
            battery_level: 15,
            firmware_version: "1.0.0".to_string(),
            is_connected: false,
        };

        hub.connect_device(device).unwrap();
        let low_battery = hub.check_battery_status();
        assert_eq!(low_battery.len(), 1);
    }
}
