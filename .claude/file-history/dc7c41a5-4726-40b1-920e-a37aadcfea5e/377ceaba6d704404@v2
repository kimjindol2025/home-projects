// Green-Distributed-Fabric Phase 2 Week 2: Battery Lifetime Simulator
// Purpose: Model battery discharge and verify 2× lifetime improvement
// Strategy: Discharge curve modeling, energy calculation, runtime projection

// ============================================================================
// Part 1: Battery Model (180 lines)
// ============================================================================

pub struct BatteryState {
    pub capacity_mah: u32,
    pub nominal_voltage_v: f64,
    pub current_charge_percent: f64,   // 0.0-100.0
    pub current_voltage_v: f64,
    pub temperature_celsius: f64,
    pub health_percent: f64,           // Battery degradation
}

impl BatteryState {
    pub fn new(capacity_mah: u32) -> Self {
        BatteryState {
            capacity_mah,
            nominal_voltage_v: 3.7,
            current_charge_percent: 100.0,  // Start fully charged
            current_voltage_v: 4.2,         // Charged voltage
            temperature_celsius: 25.0,      // Room temp
            health_percent: 100.0,
        }
    }

    pub fn get_energy_mwh(&self) -> f64 {
        // Total energy in milliwatt-hours
        (self.capacity_mah as f64) * self.nominal_voltage_v / 1000.0 *
        (self.current_charge_percent / 100.0) *
        (self.health_percent / 100.0)
    }

    pub fn get_voltage(&self) -> f64 {
        // Model voltage as function of charge
        let charge_ratio = self.current_charge_percent / 100.0;

        // Discharge curve: starts at 4.2V, drops to 3.0V at ~10%, then drops faster
        if charge_ratio > 0.15 {
            4.2 - (1.2 * (1.0 - charge_ratio))
        } else {
            3.0 - (1.0 * (0.15 - charge_ratio) / 0.15)
        }
    }

    pub fn is_usable(&self) -> bool {
        // Battery is usable if above 2.8V (under-voltage threshold)
        self.get_voltage() >= 2.8
    }

    pub fn is_fully_charged(&self) -> bool {
        self.current_charge_percent >= 99.0
    }

    pub fn is_depleted(&self) -> bool {
        self.current_charge_percent <= 0.1
    }
}

// ============================================================================
// Part 2: Discharge Simulator (200 lines)
// ============================================================================

pub struct DischargeSimulation {
    pub battery: BatteryState,
    pub power_draw_mw: f64,
    pub elapsed_ms: u64,
    pub discharge_curve: Vec<(u64, f64)>,  // (time_ms, charge_percent)
}

impl DischargeSimulation {
    pub fn new(battery: BatteryState, power_mw: f64) -> Self {
        DischargeSimulation {
            battery,
            power_draw_mw: power_mw,
            elapsed_ms: 0,
            discharge_curve: vec![(0, 100.0)],  // Start at 100%
        }
    }

    pub fn simulate_step(&mut self, step_ms: u32) -> Result<(), String> {
        if self.battery.is_depleted() || !self.battery.is_usable() {
            return Err("Battery depleted or unusable".to_string());
        }

        // Energy consumption in this step
        let energy_consumed_mwh = (self.power_draw_mw * step_ms as f64) / (1000.0 * 3600.0);
        let total_energy_mwh = self.battery.get_energy_mwh();

        if total_energy_mwh > 0.0 {
            let charge_consumed_percent = (energy_consumed_mwh / total_energy_mwh) * 100.0;
            self.battery.current_charge_percent -= charge_consumed_percent;

            // Clamp to 0
            self.battery.current_charge_percent = self.battery.current_charge_percent.max(0.0);

            // Update voltage based on new charge
            self.battery.current_voltage_v = self.battery.get_voltage();
        }

        self.elapsed_ms += step_ms as u64;
        self.discharge_curve.push((self.elapsed_ms, self.battery.current_charge_percent));

        Ok(())
    }

    pub fn run_until_depleted(&mut self, step_ms: u32) -> u64 {
        while self.battery.is_usable() && !self.battery.is_depleted() {
            let _ = self.simulate_step(step_ms);
        }

        self.elapsed_ms
    }

    pub fn get_runtime_hours(&self) -> f64 {
        (self.elapsed_ms as f64) / (1000.0 * 3600.0)
    }

    pub fn get_avg_discharge_rate(&self) -> f64 {
        // Percent per second
        if self.elapsed_ms > 0 {
            100.0 / (self.elapsed_ms as f64 / 1000.0)
        } else {
            0.0
        }
    }
}

// ============================================================================
// Part 3: Battery Lifetime Comparison (180 lines)
// ============================================================================

pub struct BatteryComparison {
    pub capacity_mah: u32,
    pub baseline_power_mw: f64,       // Linux: 250mW
    pub green_power_mw: f64,          // Green: 150mW
    pub baseline_runtime_hours: f64,
    pub green_runtime_hours: f64,
    pub improvement_factor: f64,
}

impl BatteryComparison {
    pub fn new(capacity_mah: u32, baseline_mw: f64, green_mw: f64) -> Self {
        // Calculate runtime based on energy
        let capacity_mwh = (capacity_mah as f64) * 3.7 / 1000.0;

        let baseline_hours = if baseline_mw > 0.0 {
            capacity_mwh / baseline_mw
        } else {
            0.0
        };

        let green_hours = if green_mw > 0.0 {
            capacity_mwh / green_mw
        } else {
            0.0
        };

        let improvement = if baseline_hours > 0.0 {
            green_hours / baseline_hours
        } else {
            0.0
        };

        BatteryComparison {
            capacity_mah,
            baseline_power_mw: baseline_mw,
            green_power_mw: green_mw,
            baseline_runtime_hours: baseline_hours,
            green_runtime_hours: green_hours,
            improvement_factor: improvement,
        }
    }

    pub fn verify_2x_improvement(&self) -> bool {
        self.improvement_factor >= 2.0
    }

    pub fn verify_40_percent_reduction(&self) -> bool {
        let reduction = ((self.baseline_power_mw - self.green_power_mw) / self.baseline_power_mw) * 100.0;
        reduction >= 40.0
    }

    pub fn summary(&self) -> String {
        format!(
            "Battery Comparison ({} mAh):\n\
            Baseline (Linux 250mW): {:.1}h\n\
            Green ({}mW): {:.1}h\n\
            Improvement: {:.1}× (target: 2.0×)\n\
            Power reduction: {:.0}% (target: 40%)",
            self.capacity_mah,
            self.baseline_runtime_hours,
            self.green_power_mw,
            self.green_runtime_hours,
            self.improvement_factor,
            ((self.baseline_power_mw - self.green_power_mw) / self.baseline_power_mw) * 100.0
        )
    }
}

// ============================================================================
// Part 4: Battery Stress Testing (140 lines)
// ============================================================================

pub struct BatteryStressTest {
    pub capacity_mah: u32,
    pub charge_cycles: u32,
    pub health_degradation: f64,       // Health after N cycles
    pub runtime_loss_percent: f64,
}

impl BatteryStressTest {
    pub fn new(capacity_mah: u32) -> Self {
        BatteryStressTest {
            capacity_mah,
            charge_cycles: 0,
            health_degradation: 100.0,
            runtime_loss_percent: 0.0,
        }
    }

    pub fn simulate_cycles(&mut self, cycles: u32) {
        self.charge_cycles = cycles;

        // Typical Li-ion degradation: ~2% per 100 cycles
        let degradation_rate = 0.02;  // 2% per 100 cycles
        let health_loss = ((cycles as f64) / 100.0) * degradation_rate * 100.0;

        self.health_degradation = (100.0 - health_loss).max(60.0);  // Min 60% health

        // Runtime loss scales with health loss
        self.runtime_loss_percent = 100.0 - self.health_degradation;
    }

    pub fn verify_warranty_health(&self) -> bool {
        // After 500 cycles, battery should still be >80% health
        if self.charge_cycles >= 500 {
            self.health_degradation >= 80.0
        } else {
            true
        }
    }

    pub fn summary(&self) -> String {
        format!(
            "Battery Stress: {} cycles, health={:.0}%, runtime_loss={:.0}%, warranty_ok={}",
            self.charge_cycles, self.health_degradation, self.runtime_loss_percent,
            if self.verify_warranty_health() { "YES" } else { "NO" }
        )
    }
}

// ============================================================================
// Tests (60 lines)
// ============================================================================

mod tests {
    use super::*;

    #[test]
    fn test_battery_state_creation() {
        let battery = BatteryState::new(5000);
        assert_eq!(battery.capacity_mah, 5000);
        assert!(battery.is_fully_charged());
    }

    #[test]
    fn test_battery_voltage() {
        let battery = BatteryState::new(5000);
        let voltage = battery.get_voltage();
        assert!(voltage >= 4.0 && voltage <= 4.3);
    }

    #[test]
    fn test_discharge_simulation() {
        let battery = BatteryState::new(5000);
        let mut sim = DischargeSimulation::new(battery, 150.0);  // 150mW

        let runtime = sim.run_until_depleted(1000);
        let hours = sim.get_runtime_hours();

        assert!(hours > 0.0);
        assert!(hours < 100.0);  // Reasonable range
    }

    #[test]
    fn test_battery_comparison() {
        let comparison = BatteryComparison::new(5000, 250.0, 150.0);

        assert!(comparison.verify_40_percent_reduction());
        assert!(comparison.verify_2x_improvement());
    }

    #[test]
    fn test_baseline_vs_green() {
        // Simulate both scenarios
        let baseline_battery = BatteryState::new(5000);
        let mut baseline_sim = DischargeSimulation::new(baseline_battery, 250.0);
        let baseline_runtime = baseline_sim.run_until_depleted(1000);

        let green_battery = BatteryState::new(5000);
        let mut green_sim = DischargeSimulation::new(green_battery, 150.0);
        let green_runtime = green_sim.run_until_depleted(1000);

        // Green should run significantly longer
        assert!(green_runtime > baseline_runtime);
    }

    #[test]
    fn test_stress_test() {
        let mut stress = BatteryStressTest::new(5000);
        stress.simulate_cycles(500);

        assert!(stress.verify_warranty_health());
    }
}
