// Green-Distributed-Fabric Phase 2+ Week 1: Cache Efficiency Optimizer
// Purpose: Optimize cache utilization and reduce memory access latency
// Strategy: Cache hierarchy analysis, prefetch optimization, access pattern optimization

// ============================================================================
// Part 1: Cache Hierarchy Model (220 lines)
// ============================================================================

pub struct CacheLevel {
    pub level: u32,              // 1, 2, 3
    pub size_kb: u32,
    pub line_size_bytes: u32,
    pub associativity: u32,
    pub hit_rate: f64,           // 0.0-1.0
    pub miss_rate: f64,
    pub latency_ns: u32,
}

impl CacheLevel {
    pub fn new(level: u32, size_kb: u32, latency_ns: u32) -> Self {
        let line_size = 64;  // 64-byte cache line
        let assoc = match level {
            1 => 8,    // L1: 8-way associative
            2 => 16,   // L2: 16-way
            3 => 20,   // L3: 20-way
            _ => 1,
        };

        CacheLevel {
            level,
            size_kb,
            line_size_bytes: line_size,
            associativity: assoc,
            hit_rate: 0.0,
            miss_rate: 1.0,
            latency_ns,
        }
    }

    pub fn calculate_entries(&self) -> u32 {
        // Cache entries = (size_kb × 1024) / line_size
        (self.size_kb * 1024) / self.line_size_bytes
    }

    pub fn calculate_miss_rate(&mut self) -> f64 {
        self.miss_rate = 1.0 - self.hit_rate;
        self.miss_rate
    }

    pub fn average_access_latency_ns(&self) -> u32 {
        // Weighted by hit rate
        ((self.hit_rate * self.latency_ns as f64) as u32).max(1)
    }

    pub fn describe(&self) -> String {
        format!(
            "L{} Cache: {}KB, line_size={}B, assoc={}, \
            hit_rate={:.1}%, latency={}ns",
            self.level, self.size_kb, self.line_size_bytes,
            self.associativity, self.hit_rate * 100.0, self.latency_ns
        )
    }
}

// ============================================================================
// Part 2: Access Pattern Analyzer (240 lines)
// ============================================================================

pub enum AccessPattern {
    Sequential,    // 0→1→2→3... (prefetchable)
    Strided,       // 0→N→2N→3N... (predictable stride)
    Random,        // Unpredictable access
    Spatial,       // Nearby accesses (cache line benefit)
    Temporal,      // Same address reused (cache locality)
}

pub struct MemoryAccessTracer {
    pub access_sequence: Vec<u64>,  // Memory addresses accessed
    pub access_count: u32,
    pub unique_addresses: u32,
    pub pattern_type: AccessPattern,
    pub stride_distance: u64,
}

impl MemoryAccessTracer {
    pub fn new() -> Self {
        MemoryAccessTracer {
            access_sequence: Vec::new(),
            access_count: 0,
            unique_addresses: 0,
            pattern_type: AccessPattern::Random,
            stride_distance: 0,
        }
    }

    pub fn record_access(&mut self, address: u64) {
        self.access_sequence.push(address);
        self.access_count += 1;
    }

    pub fn analyze_pattern(&mut self) {
        if self.access_sequence.len() < 2 {
            return;
        }

        // Count unique addresses
        let mut unique = std::collections::HashSet::new();
        for addr in &self.access_sequence {
            unique.insert(*addr);
        }
        self.unique_addresses = unique.len() as u32;

        // Check for patterns
        let is_sequential = self.check_sequential();
        let is_strided = self.check_strided();
        let is_temporal = self.check_temporal();
        let is_spatial = self.check_spatial();

        self.pattern_type = if is_sequential {
            AccessPattern::Sequential
        } else if is_strided {
            AccessPattern::Strided
        } else if is_temporal {
            AccessPattern::Temporal
        } else if is_spatial {
            AccessPattern::Spatial
        } else {
            AccessPattern::Random
        };
    }

    fn check_sequential(&self) -> bool {
        if self.access_sequence.len() < 3 {
            return false;
        }

        // Check if addresses increase by constant amount
        let stride = self.access_sequence[1] as i64 - self.access_sequence[0] as i64;
        self.access_sequence.windows(2).all(|w| {
            (w[1] as i64 - w[0] as i64) == stride && stride > 0
        })
    }

    fn check_strided(&mut self) -> bool {
        if self.access_sequence.len() < 3 {
            return false;
        }

        let stride = self.access_sequence[1] as i64 - self.access_sequence[0] as i64;
        self.stride_distance = stride.abs() as u64;

        let is_strided = self.access_sequence.windows(2)
            .all(|w| (w[1] as i64 - w[0] as i64).abs() == stride.abs());

        if is_strided && stride.abs() > 64 {  // More than one cache line
            return true;
        }

        false
    }

    fn check_temporal(&self) -> bool {
        // Temporal: same addresses reused (working set small)
        if self.access_count > 0 {
            let reuse_ratio = self.unique_addresses as f64 / self.access_count as f64;
            reuse_ratio < 0.5  // <50% unique = high reuse
        } else {
            false
        }
    }

    fn check_spatial(&self) -> bool {
        // Spatial: nearby addresses (within cache line)
        if self.access_sequence.len() < 2 {
            return false;
        }

        let nearby_pairs = self.access_sequence.windows(2)
            .filter(|w| (w[1] as i64 - w[0] as i64).abs() < 64)
            .count();

        (nearby_pairs as f64 / self.access_sequence.len() as f64) > 0.7
    }

    pub fn prefetch_potential(&self) -> f64 {
        // How much prefetching can help (based on pattern)
        match self.pattern_type {
            AccessPattern::Sequential => 0.95,   // 95% prefetchable
            AccessPattern::Strided => 0.80,      // 80% prefetchable
            AccessPattern::Temporal => 0.10,     // Low prefetch value
            AccessPattern::Spatial => 0.50,      // Moderate
            AccessPattern::Random => 0.05,       // Nearly unprefetchable
        }
    }

    pub fn describe(&self) -> String {
        format!(
            "Access Pattern: type={:?}, accesses={}, unique={}, \
            stride={}, prefetch_potential={:.0}%",
            self.pattern_type, self.access_count, self.unique_addresses,
            self.stride_distance, self.prefetch_potential() * 100.0
        )
    }
}

// ============================================================================
// Part 3: Cache Efficiency Calculation (200 lines)
// ============================================================================

pub struct CacheEfficiencyMetrics {
    pub l1_hit_rate: f64,
    pub l2_hit_rate: f64,
    pub l3_hit_rate: f64,
    pub overall_hit_rate: f64,
    pub memory_access_time_ns: f64,
    pub cache_efficiency_percent: f64,
    pub optimization_opportunities: Vec<String>,
}

impl CacheEfficiencyMetrics {
    pub fn new() -> Self {
        CacheEfficiencyMetrics {
            l1_hit_rate: 0.85,      // Target: 85-90%
            l2_hit_rate: 0.70,      // Target: 70-75%
            l3_hit_rate: 0.50,      // Target: 50-60%
            overall_hit_rate: 0.0,
            memory_access_time_ns: 0.0,
            cache_efficiency_percent: 0.0,
            optimization_opportunities: Vec::new(),
        }
    }

    pub fn calculate_overall_hit_rate(&mut self) {
        // Combined hit rate (miss = miss at all levels)
        let l1_miss = 1.0 - self.l1_hit_rate;
        let l2_miss = 1.0 - self.l2_hit_rate;
        let l3_miss = 1.0 - self.l3_hit_rate;

        let overall_miss = l1_miss * l2_miss * l3_miss;
        self.overall_hit_rate = 1.0 - overall_miss;
    }

    pub fn calculate_average_access_time(&mut self) {
        // AAT = L1_hit_rate × L1_latency +
        //       L1_miss_rate × (L2_hit_rate × L2_latency +
        //                       L2_miss_rate × (L3_hit_rate × L3_latency +
        //                                       L3_miss_rate × DRAM_latency))
        let l1_latency = 4.0;      // ns (4ns for L1)
        let l2_latency = 10.0;     // ns (10ns for L2)
        let l3_latency = 40.0;     // ns (40ns for L3)
        let dram_latency = 100.0;  // ns (100ns for DRAM)

        let l3_term = (self.l3_hit_rate * l3_latency) +
            ((1.0 - self.l3_hit_rate) * dram_latency);

        let l2_term = (self.l2_hit_rate * l2_latency) +
            ((1.0 - self.l2_hit_rate) * l3_term);

        let aat = (self.l1_hit_rate * l1_latency) +
            ((1.0 - self.l1_hit_rate) * l2_term);

        self.memory_access_time_ns = aat;
    }

    pub fn calculate_efficiency(&mut self) {
        // Efficiency = (1 - (AAT / DRAM_latency)) × 100%
        let dram_latency = 100.0;
        self.cache_efficiency_percent =
            ((1.0 - (self.memory_access_time_ns / dram_latency)) * 100.0).max(0.0);
    }

    pub fn identify_opportunities(&mut self) {
        self.optimization_opportunities.clear();

        if self.l1_hit_rate < 0.85 {
            self.optimization_opportunities.push(
                "Increase L1 hit rate (currently < 85%)".to_string()
            );
        }

        if self.l2_hit_rate < 0.70 {
            self.optimization_opportunities.push(
                "Improve L2 hit rate (currently < 70%)".to_string()
            );
        }

        if self.l3_hit_rate < 0.50 {
            self.optimization_opportunities.push(
                "Enhance L3 hit rate / prefetching".to_string()
            );
        }

        if self.memory_access_time_ns > 20.0 {
            self.optimization_opportunities.push(
                "Average access time too high, need better locality".to_string()
            );
        }

        if self.cache_efficiency_percent < 80.0 {
            self.optimization_opportunities.push(
                "Cache efficiency < 80%, potential for improvement".to_string()
            );
        }
    }

    pub fn summary(&self) -> String {
        format!(
            "Cache Efficiency: L1={:.0}%, L2={:.0}%, L3={:.0}%, \
            overall={:.0}%, AAT={:.1}ns, efficiency={:.0}%, \
            opportunities={}",
            self.l1_hit_rate * 100.0, self.l2_hit_rate * 100.0, self.l3_hit_rate * 100.0,
            self.overall_hit_rate * 100.0, self.memory_access_time_ns, self.cache_efficiency_percent,
            self.optimization_opportunities.len()
        )
    }
}

// ============================================================================
// Tests (140 lines)
// ============================================================================

mod tests {
    use super::*;

    #[test]
    fn test_cache_level_creation() {
        let l1 = CacheLevel::new(1, 32, 4);
        assert_eq!(l1.level, 1);
        assert_eq!(l1.size_kb, 32);
    }

    #[test]
    fn test_cache_entries_calculation() {
        let l1 = CacheLevel::new(1, 32, 4);  // 32KB
        let entries = l1.calculate_entries();
        assert_eq!(entries, 512);  // 32*1024 / 64 = 512
    }

    #[test]
    fn test_sequential_pattern_detection() {
        let mut tracer = MemoryAccessTracer::new();

        // Sequential access: 0, 64, 128, 192, ...
        for i in 0..10 {
            tracer.record_access((i as u64) * 64);
        }

        tracer.analyze_pattern();
        assert!(matches!(tracer.pattern_type, AccessPattern::Sequential | AccessPattern::Strided));
    }

    #[test]
    fn test_temporal_pattern_detection() {
        let mut tracer = MemoryAccessTracer::new();

        // Temporal access: reuse same addresses
        tracer.record_access(1000);
        tracer.record_access(2000);
        tracer.record_access(1000);  // Reuse
        tracer.record_access(2000);  // Reuse
        tracer.record_access(1000);

        tracer.analyze_pattern();
        // High reuse ratio should be detected
        assert!(tracer.unique_addresses < tracer.access_count);
    }

    #[test]
    fn test_cache_efficiency_calculation() {
        let mut metrics = CacheEfficiencyMetrics::new();
        metrics.l1_hit_rate = 0.90;
        metrics.l2_hit_rate = 0.75;
        metrics.l3_hit_rate = 0.60;

        metrics.calculate_overall_hit_rate();
        metrics.calculate_average_access_time();
        metrics.calculate_efficiency();

        assert!(metrics.overall_hit_rate > 0.5);
        assert!(metrics.memory_access_time_ns < 100.0);
        assert!(metrics.cache_efficiency_percent > 0.0);
    }

    #[test]
    fn test_optimization_opportunities() {
        let mut metrics = CacheEfficiencyMetrics::new();
        metrics.l1_hit_rate = 0.70;  // Below target
        metrics.l2_hit_rate = 0.50;  // Below target
        metrics.memory_access_time_ns = 30.0;

        metrics.identify_opportunities();
        assert!(!metrics.optimization_opportunities.is_empty());
    }

    #[test]
    fn test_prefetch_potential() {
        let mut sequential = MemoryAccessTracer::new();
        for i in 0..10 {
            sequential.record_access((i as u64) * 64);
        }
        sequential.analyze_pattern();

        assert!(sequential.prefetch_potential() > 0.8);
    }

    #[test]
    fn test_cache_efficiency_summary() {
        let metrics = CacheEfficiencyMetrics::new();
        let summary = metrics.summary();
        assert!(!summary.is_empty());
    }
}
