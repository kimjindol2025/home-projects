// 4가지 패널 대시보드, 자동 업데이트, 실시간 모니터링

#[derive(Clone, Debug)]
pub enum PanelType {
    Graph,      // 시계열 그래프
    Gauge,      // 게이지 (원형 메터)
    Table,      // 테이블
    Stat,       // 통계 (큰 숫자)
}

#[derive(Clone, Debug)]
pub enum RefreshInterval {
    FiveSeconds,
    TenSeconds,
    ThirtySeconds,
    OneMinute,
    FiveMinutes,
}

impl RefreshInterval {
    pub fn to_string(&self) -> String {
        match self {
            RefreshInterval::FiveSeconds => "5s".to_string(),
            RefreshInterval::TenSeconds => "10s".to_string(),
            RefreshInterval::ThirtySeconds => "30s".to_string(),
            RefreshInterval::OneMinute => "1m".to_string(),
            RefreshInterval::FiveMinutes => "5m".to_string(),
        }
    }
}

#[derive(Clone, Debug)]
pub struct DashboardPanel {
    pub id: u32,
    pub title: String,
    pub description: String,
    pub panel_type: PanelType,
    pub targets: Vec<String>,  // Prometheus PromQL queries
    pub grid_pos: GridPosition,
    pub unit: String,
    pub min: f64,
    pub max: f64,
    pub alert_threshold: Option<f64>,
}

#[derive(Clone, Debug)]
pub struct GridPosition {
    pub x: u32,
    pub y: u32,
    pub w: u32,
    pub h: u32,
}

impl DashboardPanel {
    pub fn new(id: u32, title: &str, panel_type: PanelType) -> Self {
        DashboardPanel {
            id,
            title: title.to_string(),
            description: String::new(),
            panel_type,
            targets: Vec::new(),
            grid_pos: GridPosition { x: 0, y: 0, w: 12, h: 8 },
            unit: String::new(),
            min: 0.0,
            max: 100.0,
            alert_threshold: None,
        }
    }

    pub fn with_target(mut self, query: &str) -> Self {
        self.targets.push(query.to_string());
        self
    }

    pub fn with_description(mut self, desc: &str) -> Self {
        self.description = desc.to_string();
        self
    }

    pub fn with_unit(mut self, unit: &str) -> Self {
        self.unit = unit.to_string();
        self
    }

    pub fn with_grid_pos(mut self, x: u32, y: u32, w: u32, h: u32) -> Self {
        self.grid_pos = GridPosition { x, y, w, h };
        self
    }

    pub fn with_range(mut self, min: f64, max: f64) -> Self {
        self.min = min;
        self.max = max;
        self
    }

    pub fn with_alert_threshold(mut self, threshold: f64) -> Self {
        self.alert_threshold = Some(threshold);
        self
    }
}

pub struct GrafanaDashboard {
    pub title: String,
    pub description: String,
    pub uid: String,
    pub version: u32,
    pub panels: Vec<DashboardPanel>,
    pub refresh_interval: RefreshInterval,
    pub time_range_from: String,  // "now-6h"
    pub time_range_to: String,    // "now"
}

impl GrafanaDashboard {
    pub fn new(title: &str, uid: &str) -> Self {
        GrafanaDashboard {
            title: title.to_string(),
            description: String::new(),
            uid: uid.to_string(),
            version: 1,
            panels: Vec::new(),
            refresh_interval: RefreshInterval::ThirtySeconds,
            time_range_from: "now-6h".to_string(),
            time_range_to: "now".to_string(),
        }
    }

    pub fn add_panel(&mut self, panel: DashboardPanel) {
        self.panels.push(panel);
    }

    pub fn set_refresh_interval(&mut self, interval: RefreshInterval) {
        self.refresh_interval = interval;
    }

    pub fn get_panels_count(&self) -> usize {
        self.panels.len()
    }

    pub fn export_json(&self) -> String {
        format!(
            r#"{{
  "dashboard": {{
    "title": "{}",
    "description": "{}",
    "uid": "{}",
    "version": {},
    "refresh": "{}",
    "time": {{
      "from": "{}",
      "to": "{}"
    }},
    "panels": [
      {}
    ]
  }}
}}"#,
            self.title,
            self.description,
            self.uid,
            self.version,
            self.refresh_interval.to_string(),
            self.time_range_from,
            self.time_range_to,
            self.panels.iter()
                .map(|p| format!(
                    r#"{{"id": {}, "title": "{}", "type": "{}", "targets": [{}]}}"#,
                    p.id,
                    p.title,
                    match p.panel_type {
                        PanelType::Graph => "graph",
                        PanelType::Gauge => "gauge",
                        PanelType::Table => "table",
                        PanelType::Stat => "stat",
                    },
                    p.targets.iter()
                        .map(|t| format!(r#""{}""#, t))
                        .collect::<Vec<_>>()
                        .join(",")
                ))
                .collect::<Vec<_>>()
                .join(",")
        )
    }
}

// 4가지 기본 패널 설정
pub struct DefaultPanels;

impl DefaultPanels {
    pub fn panel_1_energy_metrics() -> DashboardPanel {
        DashboardPanel::new(1, "Energy Metrics", PanelType::Graph)
            .with_description("Real-time power consumption and battery status")
            .with_target("green_fabric_power_instantaneous_mw")
            .with_target("green_fabric_power_average_mw")
            .with_target("green_fabric_battery_level_percent")
            .with_unit("mW")
            .with_grid_pos(0, 0, 12, 8)
            .with_range(0.0, 300.0)
    }

    pub fn panel_2_performance_metrics() -> DashboardPanel {
        DashboardPanel::new(2, "Performance Metrics", PanelType::Gauge)
            .with_description("DVFS frequency and transition latency")
            .with_target("green_fabric_dvfs_frequency_mhz")
            .with_target("green_fabric_dvfs_transition_latency_us")
            .with_target("green_fabric_cstate_active")
            .with_unit("MHz")
            .with_grid_pos(12, 0, 12, 8)
            .with_range(800.0, 3600.0)
    }

    pub fn panel_3_cluster_status() -> DashboardPanel {
        DashboardPanel::new(3, "Cluster Status", PanelType::Table)
            .with_description("Raft consensus and node synchronization")
            .with_target("green_fabric_node_id")
            .with_target("green_fabric_leader_id")
            .with_target("green_fabric_consensus_latency_ms")
            .with_target("green_fabric_failover_latency_ms")
            .with_target("green_fabric_replicas_in_sync_count")
            .with_unit("ms")
            .with_grid_pos(0, 8, 12, 8)
            .with_range(0.0, 500.0)
            .with_alert_threshold(150.0)
    }

    pub fn panel_4_learning_progress() -> DashboardPanel {
        DashboardPanel::new(4, "Learning Progress", PanelType::Stat)
            .with_description("ML model accuracy and improvement trend")
            .with_target("green_fabric_pattern_accuracy_percent")
            .with_target("green_fabric_prediction_error_percent")
            .with_target("green_fabric_learning_state")
            .with_target("green_fabric_improvement_trend_percent")
            .with_unit("%")
            .with_grid_pos(12, 8, 12, 8)
            .with_range(0.0, 100.0)
            .with_alert_threshold(85.0)
    }

    pub fn create_default_dashboard() -> GrafanaDashboard {
        let mut dashboard = GrafanaDashboard::new(
            "Green-Distributed-Fabric",
            "green-fabric"
        );

        dashboard.set_refresh_interval(RefreshInterval::ThirtySeconds);

        dashboard.add_panel(Self::panel_1_energy_metrics());
        dashboard.add_panel(Self::panel_2_performance_metrics());
        dashboard.add_panel(Self::panel_3_cluster_status());
        dashboard.add_panel(Self::panel_4_learning_progress());

        dashboard
    }
}

pub struct DashboardMetrics {
    pub total_panels: usize,
    pub active_queries: usize,
    pub average_load_time_ms: u32,
    pub uptime_hours: u32,
}

impl DashboardMetrics {
    pub fn from_dashboard(dashboard: &GrafanaDashboard) -> Self {
        let mut active_queries = 0;
        for panel in &dashboard.panels {
            active_queries += panel.targets.len();
        }

        DashboardMetrics {
            total_panels: dashboard.get_panels_count(),
            active_queries,
            average_load_time_ms: 500,
            uptime_hours: 24,
        }
    }

    pub fn display(&self) {
        println!("Dashboard Metrics:");
        println!("  Total Panels: {}", self.total_panels);
        println!("  Active Queries: {}", self.active_queries);
        println!("  Average Load Time: {} ms", self.average_load_time_ms);
        println!("  Uptime: {} hours", self.uptime_hours);
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_panel_creation() {
        let panel = DashboardPanel::new(1, "Test Panel", PanelType::Graph)
            .with_unit("mW")
            .with_range(0.0, 300.0);

        assert_eq!(panel.id, 1);
        assert_eq!(panel.title, "Test Panel");
        assert_eq!(panel.unit, "mW");
    }

    #[test]
    fn test_panel_with_targets() {
        let panel = DashboardPanel::new(1, "Test", PanelType::Graph)
            .with_target("query1")
            .with_target("query2");

        assert_eq!(panel.targets.len(), 2);
    }

    #[test]
    fn test_dashboard_creation() {
        let mut dashboard = GrafanaDashboard::new("Test Dashboard", "test-uid");

        let panel1 = DashboardPanel::new(1, "Panel 1", PanelType::Graph);
        let panel2 = DashboardPanel::new(2, "Panel 2", PanelType::Gauge);

        dashboard.add_panel(panel1);
        dashboard.add_panel(panel2);

        assert_eq!(dashboard.get_panels_count(), 2);
    }

    #[test]
    fn test_default_dashboard() {
        let dashboard = DefaultPanels::create_default_dashboard();

        assert_eq!(dashboard.get_panels_count(), 4);
        assert_eq!(dashboard.title, "Green-Distributed-Fabric");
    }

    #[test]
    fn test_dashboard_json_export() {
        let dashboard = GrafanaDashboard::new("Test", "test-uid");
        let json = dashboard.export_json();

        assert!(json.contains("Test"));
        assert!(json.contains("test-uid"));
    }

    #[test]
    fn test_dashboard_metrics() {
        let dashboard = DefaultPanels::create_default_dashboard();
        let metrics = DashboardMetrics::from_dashboard(&dashboard);

        assert_eq!(metrics.total_panels, 4);
    }
}
