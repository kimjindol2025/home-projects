mod tests {
    use super::*;

    #[test]
    fn test_cluster_config_creation() {
        let config = ClusterConfig::new(3).unwrap();
        assert_eq!(config.node_count, 3);
        assert!(config.validate().is_ok());
    }

    #[test]
    fn test_cluster_config_invalid_nodes() {
        assert!(ClusterConfig::new(2).is_err());
        assert!(ClusterConfig::new(6).is_err());
    }

    #[test]
    fn test_cluster_manager_creation() {
        let config = ClusterConfig::new(3).unwrap();
        let manager = ClusterManager::new(config).unwrap();
        assert_eq!(manager.nodes.len(), 3);
        assert_eq!(manager.leader_id, 0);
    }

    #[test]
    fn test_add_power_reading() {
        let config = ClusterConfig::new(3).unwrap();
        let mut manager = ClusterManager::new(config).unwrap();
        assert!(manager.add_power_reading(0, 150.0).is_ok());
        assert_eq!(manager.nodes[0].power_reading, 150.0);
    }

    #[test]
    fn test_global_metrics_calculation() {
        let config = ClusterConfig::new(3).unwrap();
        let mut manager = ClusterManager::new(config).unwrap();
        let _ = manager.add_power_reading(0, 150.0);
        let _ = manager.add_power_reading(1, 160.0);
        let _ = manager.add_power_reading(2, 140.0);

        manager.global_metrics.calculate_from_nodes(&manager.nodes);
        assert!(manager.global_metrics.average_power_per_node > 0.0);
    }

    #[test]
    fn test_simulate_step() {
        let config = ClusterConfig::new(3).unwrap();
        let mut manager = ClusterManager::new(config).unwrap();
        let _ = manager.add_power_reading(0, 150.0);
        let _ = manager.add_power_reading(1, 160.0);
        let _ = manager.add_power_reading(2, 140.0);

        let result = manager.simulate_step();
        assert!(result.is_ok());
    }
}
