mod tests {
    use super::*;

    #[test]
    fn test_predictive_pm_layer_creation() {
        let layer = PredictivePMLayer::new(150.0);
        assert_eq!(layer.predictor.power_budget_mw, 150.0);
    }

    #[test]
    fn test_prediction_accuracy() {
        let layer = PredictivePMLayer::new(150.0);
        let accuracy = layer.prediction_accuracy();
        assert!(accuracy >= 0.0 && accuracy <= 1.0);
    }
}
