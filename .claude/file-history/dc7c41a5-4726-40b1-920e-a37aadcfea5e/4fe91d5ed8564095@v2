pub mod demand_response_planner;

pub use energy_predictor::{EnergyForecast, PowerTimeSeries, EnergyPredictor};
pub use demand_response_planner::{
    PowerAction, DemandPlan, PowerAdaptationDecision, DemandResponsePlanner,
};

// ─────────────────────────────────────────────────────────────────
// PredictivePMLayer: L3 공개 API Facade
// ─────────────────────────────────────────────────────────────────

pub struct PredictivePMLayer {
    pub predictor: EnergyPredictor,
    pub planner: DemandResponsePlanner,
    tick_count: u64,
}

impl PredictivePMLayer {
    pub fn new(budget_mw: f64) -> PredictivePMLayer {
        PredictivePMLayer {
            predictor: EnergyPredictor::new(budget_mw),
            planner: DemandResponsePlanner::new(budget_mw),
            tick_count: 0,
        }
    }

    pub fn tick(
        &mut self,
        reading: &crate::power::PowerReading,
        patterns: &[crate::power::PowerPattern],
    ) -> Option<DemandPlan> {
        // 1. 예측 업데이트
        self.predictor.observe(reading, patterns);

        // 2. 예측 생성
        let forecast = self.predictor.best_forecast(10);
        self.planner.update_forecast(forecast.clone());
        self.planner.update_battery_level(reading.battery_voltage_mv as f64 / 4200.0);

        // 3. 중재 평가
        if let Some(decision) = self.planner.evaluate_intervention() {
            let plan = self.planner.build_plan(&decision);
            self.tick_count += 1;
            return Some(plan);
        }

        self.tick_count += 1;
        None
    }

    pub fn prediction_accuracy(&self) -> f64 {
        // 무관용 규칙 7: 예측 오차 ≤ 10%
        self.predictor.prediction_error_rate()
    }

    pub fn current_forecast(&self) -> Option<&EnergyForecast> {
        self.planner.current_forecast.as_ref()
    }
}

