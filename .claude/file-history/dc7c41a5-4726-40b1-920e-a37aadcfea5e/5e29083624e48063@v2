// Phase 3: Authentication Engine
// L0NN 신경망 + 스푸핑 탐지를 통합한 인증 시스템

use crate::learning::*;
use crate::signals::*;
use super::metrics::*;
use super::spoofing_detector::*;

/// 인증 결정
#[derive(Clone, Debug, PartialEq)]
pub enum AuthenticationDecision {
    Accept,                    // 본인으로 인증
    Reject,                    // 타인으로 거부
    RejectHighRisk,           // 스푸핑 의심으로 거부
}

/// 인증 상세 결과
#[derive(Clone, Debug)]
pub struct AuthenticationDetails {
    pub decision: AuthenticationDecision,
    pub confidence_score: f64,        // 신경망 신뢰도 [0, 1]
    pub spoofing_risk_level: SpoofingRisk,  // 스푸핑 위험
    pub liveness_score: f64,          // 신호 생생함 [0, 1]
    pub final_score: f64,             // 최종 인증 점수 [0, 1]
    pub reasoning: String,            // 판정 이유
}

/// 인증 엔진
#[derive(Clone, Debug)]
pub struct AuthenticationEngine {
    pub learner: L0NNBiometricLearner,
    pub spoofing_detector: SpoofingDetector,
    pub confidence_threshold: f64,     // 신경망 임계값
    pub spoofing_threshold: f64,       // 스푸핑 거부 임계값
    pub authentication_attempts: Vec<AuthenticationAttempt>,
    pub total_authentications: usize,
}

impl AuthenticationEngine {
    pub fn new(user_id: String) -> Self {
        AuthenticationEngine {
            learner: L0NNBiometricLearner::new(user_id),
            spoofing_detector: SpoofingDetector::new(),
            confidence_threshold: 0.5,
            spoofing_threshold: 0.5,  // 신뢰도 < 0.5 = 의심
            authentication_attempts: Vec::new(),
            total_authentications: 0,
        }
    }

    /// 사용자 등록: 본인의 생체 신호로 신경망 학습
    pub fn enroll(
        &mut self,
        keystroke_signals: &[KeystrokeSignal],
        touch_signals: &[TouchSignal],
        hr_signals: &[HeartRateSignal],
    ) {
        let profile = self.create_biometric_profile(keystroke_signals, touch_signals, hr_signals);

        // 여러 번 학습하여 패턴 정착
        for _ in 0..10 {
            self.learner.learn_user_pattern(&profile, 1.0);
        }
    }

    /// 인증 시도
    pub fn authenticate(
        &mut self,
        keystroke_signals: &[KeystrokeSignal],
        touch_signals: &[TouchSignal],
        hr_signals: &[HeartRateSignal],
        is_genuine: bool,  // 테스트용: 실제로 본인인지
    ) -> AuthenticationDetails {
        self.total_authentications += 1;

        let profile = self.create_biometric_profile(keystroke_signals, touch_signals, hr_signals);

        // 1. 신경망 신뢰도 계산
        let confidence_score = self.learner.confidence_score(&profile);

        // 2. 스푸핑 탐지
        let spoofing_result = self.spoofing_detector.detect_spoofing(
            keystroke_signals,
            touch_signals,
            hr_signals,
        );

        // 3. 최종 점수 계산
        // final_score = confidence * (1 - spoofing_risk)
        let spoofing_confidence = spoofing_result.overall_confidence;
        let final_score = confidence_score * spoofing_confidence;

        // 4. 인증 결정
        let decision = if spoofing_result.risk_level == SpoofingRisk::High
            || spoofing_result.risk_level == SpoofingRisk::Critical
        {
            AuthenticationDecision::RejectHighRisk
        } else if final_score >= self.confidence_threshold {
            AuthenticationDecision::Accept
        } else {
            AuthenticationDecision::Reject
        };

        // 5. 판정 이유 작성
        let reasoning = match decision {
            AuthenticationDecision::Accept => format!(
                "Biometric confidence {:.1}% + liveness {:.1}% = ACCEPT",
                confidence_score * 100.0,
                spoofing_confidence * 100.0
            ),
            AuthenticationDecision::Reject => format!(
                "Biometric confidence {:.1}% below threshold {:.1}% = REJECT",
                confidence_score * 100.0,
                self.confidence_threshold * 100.0
            ),
            AuthenticationDecision::RejectHighRisk => format!(
                "High spoofing risk: {:?} (liveness {:.1}%) = REJECT",
                spoofing_result.risk_level,
                spoofing_confidence * 100.0
            ),
        };

        // 6. 인증 시도 기록
        let predicted_result = match decision {
            AuthenticationDecision::Accept => AuthenticationResult::Accept,
            _ => AuthenticationResult::Reject,
        };

        self.authentication_attempts.push(AuthenticationAttempt {
            is_genuine,
            predicted_result,
            confidence_score,
            timestamp: 0,
        });

        AuthenticationDetails {
            decision,
            confidence_score,
            spoofing_risk_level: spoofing_result.risk_level,
            liveness_score: spoofing_result.overall_confidence,
            final_score,
            reasoning,
        }
    }

    /// 생체 신호로부터 프로필 생성
    fn create_biometric_profile(
        &self,
        keystroke_signals: &[KeystrokeSignal],
        touch_signals: &[TouchSignal],
        hr_signals: &[HeartRateSignal],
    ) -> BiometricProfile {
        // 임시 collector를 만들어 프로필 생성
        let mut collector = BiometricCollector::new(1000);

        for ks in keystroke_signals {
            collector.record_keystroke(
                ks.key,
                ks.timestamp,
                ks.press_duration,
                ks.flight_time,
                ks.pressure,
            );
        }

        for ts in touch_signals {
            collector.record_touch(ts.x, ts.y, ts.pressure, ts.timestamp, ts.duration);
        }

        for hrs in hr_signals {
            collector.record_heartrate(hrs.bpm, hrs.timestamp, hrs.variability, hrs.confidence);
        }

        collector.biometric_profile()
    }

    /// 현재까지의 인증 성능 메트릭
    pub fn get_metrics(&self) -> AuthenticationMetrics {
        AuthenticationMetrics::from_attempts(&self.authentication_attempts)
    }

    /// FAR 달성 상황 (Rule: FAR < 0.0001%)
    pub fn far_compliance(&self) -> bool {
        let metrics = self.get_metrics();
        metrics.meets_far_requirement()
    }

    /// FRR 달성 상황 (Rule: FRR < 1%)
    pub fn frr_compliance(&self) -> bool {
        let metrics = self.get_metrics();
        metrics.meets_frr_requirement()
    }

    /// 모든 무관용 규칙 준수
    pub fn all_rules_passed(&self) -> bool {
        let metrics = self.get_metrics();
        metrics.meets_all_requirements()
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_engine_creation() {
        let engine = AuthenticationEngine::new("user001".to_string());
        assert_eq!(engine.learner.user_id, "user001");
        assert_eq!(engine.confidence_threshold, 0.5);
    }

    #[test]
    fn test_enrollment() {
        let mut engine = AuthenticationEngine::new("user001".to_string());

        let keystrokes = vec![
            KeystrokeSignal {
                key: 'p',
                timestamp: 0,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
            KeystrokeSignal {
                key: 'a',
                timestamp: 100,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
        ];

        engine.enroll(&keystrokes, &[], &[]);
        assert_eq!(engine.learner.training_count, 20);  // 10 에포크 × 2 신호
    }

    #[test]
    fn test_genuine_authentication() {
        let mut engine = AuthenticationEngine::new("user001".to_string());

        let keystrokes = vec![
            KeystrokeSignal {
                key: 'p',
                timestamp: 0,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
            KeystrokeSignal {
                key: 'a',
                timestamp: 100,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
        ];

        // 등록
        engine.enroll(&keystrokes, &[], &[]);

        // 인증 시도 (본인)
        let details = engine.authenticate(&keystrokes, &[], &[], true);

        println!("Decision: {:?}", details.decision);
        println!("Confidence: {:.2}%", details.confidence_score * 100.0);
        println!("Reasoning: {}", details.reasoning);
    }

    #[test]
    fn test_impostor_rejection() {
        let mut engine = AuthenticationEngine::new("user001".to_string());

        let genuine_keystrokes = vec![
            KeystrokeSignal {
                key: 'p',
                timestamp: 0,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
            KeystrokeSignal {
                key: 'a',
                timestamp: 100,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
        ];

        // 본인 패턴으로 등록
        engine.enroll(&genuine_keystrokes, &[], &[]);

        // 타인의 다른 패턴으로 인증 시도
        let impostor_keystrokes = vec![
            KeystrokeSignal {
                key: 't',
                timestamp: 0,
                press_duration: 80,
                flight_time: 200,
                pressure: 0.3,
            },
            KeystrokeSignal {
                key: 'e',
                timestamp: 200,
                press_duration: 40,
                flight_time: 80,
                pressure: 0.9,
            },
        ];

        let details = engine.authenticate(&impostor_keystrokes, &[], &[], false);

        println!("Impostor Decision: {:?}", details.decision);
        println!("Confidence: {:.2}%", details.confidence_score * 100.0);
    }

    #[test]
    fn test_spoofing_detection_in_auth() {
        let mut engine = AuthenticationEngine::new("user001".to_string());

        let genuine_keystrokes = vec![
            KeystrokeSignal {
                key: 's',
                timestamp: 0,
                press_duration: 50,
                flight_time: 120,
                pressure: 0.7,
            },
            KeystrokeSignal {
                key: 'e',
                timestamp: 120,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
        ];

        engine.enroll(&genuine_keystrokes, &[], &[]);

        // 기계적인 타이핑 (스푸핑 의심)
        let mechanical_keystrokes = vec![
            KeystrokeSignal {
                key: 's',
                timestamp: 0,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
            KeystrokeSignal {
                key: 'e',
                timestamp: 100,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
            KeystrokeSignal {
                key: 'c',
                timestamp: 200,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
        ];

        let details = engine.authenticate(&mechanical_keystrokes, &[], &[], false);
        println!("Risk Level: {:?}", details.spoofing_risk_level);
        println!("Reasoning: {}", details.reasoning);
    }

    #[test]
    fn test_metrics_tracking() {
        let mut engine = AuthenticationEngine::new("user001".to_string());

        let genuine = vec![KeystrokeSignal {
            key: 't',
            timestamp: 0,
            press_duration: 50,
            flight_time: 100,
            pressure: 0.7,
        }];

        engine.enroll(&genuine, &[], &[]);

        // 10번의 본인 인증 (모두 성공 가정)
        for _ in 0..10 {
            engine.authenticate(&genuine, &[], &[], true);
        }

        // 10번의 타인 거부 시도 (모두 거부 성공 가정)
        let impostor = vec![KeystrokeSignal {
            key: 'x',
            timestamp: 0,
            press_duration: 80,
            flight_time: 200,
            pressure: 0.3,
        }];

        for _ in 0..10 {
            engine.authenticate(&impostor, &[], &[], false);
        }

        let metrics = engine.get_metrics();
        println!("Total Attempts: {}", metrics.total_attempts);
        println!("FAR: {:.2}%", metrics.false_acceptance_rate * 100.0);
        println!("FRR: {:.2}%", metrics.false_rejection_rate * 100.0);
        println!("Accuracy: {:.2}%", metrics.accuracy() * 100.0);
    }

    #[test]
    fn test_rules_compliance() {
        let mut engine = AuthenticationEngine::new("user001".to_string());

        // 완벽한 인증: 100명 본인 모두 인증, 1,000,000명 타인 모두 거부
        let genuine = vec![KeystrokeSignal {
            key: 'g',
            timestamp: 0,
            press_duration: 50,
            flight_time: 100,
            pressure: 0.7,
        }];

        engine.enroll(&genuine, &[], &[]);

        // 본인: 100명 모두 인증 성공
        for _ in 0..100 {
            engine.authenticate(&genuine, &[], &[], true);
        }

        // FAR 확인
        let metrics = engine.get_metrics();
        println!("FAR Requirement (<0.0001%): {}", engine.far_compliance());
        println!("FRR Requirement (<1%): {}", engine.frr_compliance());
        println!("FAR (current): {:.6}%", metrics.far_in_ppm() / 10000.0);
        println!("FRR (current): {:.2}%", metrics.frr_percentage());
    }
}
