/// Phase 3.1: FL-Ghost-Writer 통합 파이프라인
pub struct FontEngine {
    pub sdf_generator: SDFGenerator,
    pub shader: SDFShader,
}

impl FontEngine {
    pub fn new() -> Self {
        FontEngine {
            sdf_generator: SDFGenerator,
            shader: SDFShader::new(),
        }
    }

    /// 글리프 렌더링 파이프라인 (전체)
    /// 1. TTF 파싱 (parser.fl에서 제공)
    /// 2. 베지어 곡선 추출
    /// 3. SDF 생성 (< 800µs)
    /// 4. 쉐이더 적용
    pub fn render_glyph(
        &self,
        beziers: &[CubicBezier],
        width: usize,
        height: usize,
    ) -> SDFTexture {
        SDFGenerator::rasterize(beziers, width, height)
    }

    /// Bold 폰트로 설정
    pub fn set_bold(&mut self) {
        self.shader.set_bold(15);
    }

    /// Thin 폰트로 설정
    pub fn set_thin(&mut self) {
        self.shader.set_thin(10);
    }

    /// 정상 폰트로 복원
    pub fn set_normal(&mut self) {
        self.shader.set_normal();
    }

    /// SDF 픽셀을 렌더링 가능한 형태로 변환
    pub fn shade_pixel(&self, sdf_value: i8) -> u32 {
        self.shader.render_pixel(sdf_value)
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_font_engine_creation() {
        let engine = FontEngine::new();
        assert_eq!(engine.shader.threshold, 0);  // 기본값
    }

    #[test]
    fn test_glyph_rendering() {
        let engine = FontEngine::new();

        // 간단한 선형 곡선 (2개)
        let bezier1 = CubicBezier::new(
            Point::new(from_int(0), from_int(0)),
            Point::new(from_int(1), from_int(1)),
            Point::new(from_int(2), from_int(1)),
            Point::new(from_int(3), from_int(0)),
        );

        let beziers = vec![bezier1];

        let sdf = engine.render_glyph(&beziers, 32, 32);
        assert_eq!(sdf.width, 32);
        assert_eq!(sdf.height, 32);
    }

    #[test]
    fn test_bold_setting() {
        let mut engine = FontEngine::new();
        engine.set_bold();
        assert!(engine.shader.threshold < 0);
    }

    #[test]
    fn test_thin_setting() {
        let mut engine = FontEngine::new();
        engine.set_thin();
        assert!(engine.shader.threshold > 0);
    }

    #[test]
    fn test_shader_pixel_color() {
        let engine = FontEngine::new();
        let color = engine.shade_pixel(127);  // 외부 (흰색)
        assert!(color & 0xFF > 200);  // 알파값 높음
    }
}
