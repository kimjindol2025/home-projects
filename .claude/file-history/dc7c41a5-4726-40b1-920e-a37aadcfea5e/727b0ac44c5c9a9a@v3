// Phase 3 Week 2: Power-Aware Leader Election (360줄)
// Purpose: Elect leader considering remaining battery and energy efficiency
use super::green_raft_node::{GreenRaftNode, PowerState, RaftState};

pub enum ElectionStrategy {
    HighestBattery,           // Battery > 50% preferred
    LowestEnergyConsumption,  // Recent energy drain < 10mJ preferred
    BalancedPowerTerm,        // Battery + term balanced
    ThermalAware,             // Temperature < 70°C preferred
}

pub struct VoteRequest {
    pub candidate_id: u32,
    pub term: u64,
    pub candidate_battery: f64,
    pub candidate_power_state: String,
    pub last_log_index: u32,
    pub energy_consumed_recent_ms: f64,
}

pub struct VoteResponse {
    pub voter_id: u32,
    pub term: u64,
    pub vote_granted: bool,
    pub reason: String,
    pub voter_battery_percent: f64,
}

pub struct ElectionResult {
    pub leader_id: Option<u32>,
    pub votes_received: u32,
    pub consensus_latency_ms: u32,
    pub energy_cost_mj: f64,
    pub confidence: f64,
}

pub struct PowerLeaderElector {
    pub node_id: u32,
    pub current_term: u64,
    pub election_strategy: ElectionStrategy,
    pub election_timeout_ms: u32,
    pub last_election_time_ms: u64,
    pub consecutive_election_failures: u32,
    pub power_score_history: Vec<f64>,
}

impl PowerLeaderElector {
    pub fn new(node_id: u32) -> Self {
        PowerLeaderElector {
            node_id,
            current_term: 0,
            election_strategy: ElectionStrategy::BalancedPowerTerm,
            election_timeout_ms: 150,
            last_election_time_ms: 0,
            consecutive_election_failures: 0,
            power_score_history: Vec::new(),
        }
    }

    // 전력 점수 계산 (0.0-100.0)
    pub fn compute_power_score(&self, node: &GreenRaftNode) -> f64 {
        let battery_weight = 40.0;  // 배터리 40% 영향
        let energy_weight = 30.0;   // 에너지 효율 30% 영향
        let term_weight = 20.0;     // 임기 20% 영향
        let power_state_weight = 10.0; // 전력 상태 10% 영향

        // 배터리: 100% = 40점
        let battery_score = (node.battery_level / 100.0) * battery_weight;

        // 에너지 효율: 낮을수록 좋음 (0-100mJ → 30점)
        let energy_score = if node.total_energy_consumed_mj < 100.0 {
            energy_weight * (1.0 - node.total_energy_consumed_mj / 100.0)
        } else {
            0.0
        };

        // 임기: 선택된 수가 많을수록 안정 (20점)
        let term_score = (node.current_term as f64 / 20.0).min(1.0) * term_weight;

        // 전력 상태: Active=10점, Idle=8점, Sleeping=5점, Critical=0점
        let power_state_score = match node.power_state {
            PowerState::Active => 10.0,
            PowerState::Idle => 8.0,
            PowerState::Sleeping => 5.0,
            PowerState::Critical => 0.0,
        };

        battery_score + energy_score + term_score + power_state_score
    }

    pub fn can_candidate_win(&self, candidate: &GreenRaftNode, min_votes: u32, cluster_size: u32) -> bool {
        // Active/Idle 상태에서만 승리 가능
        match candidate.power_state {
            PowerState::Critical => false,
            PowerState::Sleeping => candidate.battery_level > 30.0, // Sleep 상태에서 깨어날 여력
            _ => candidate.battery_level > 10.0,
        }
    }

    pub fn should_grant_vote(&self, req: &VoteRequest, my_battery: f64, my_state: &RaftState) -> bool {
        // 규칙 1: Candidate의 배터리가 낮으면 투표 거부
        if req.candidate_battery < 5.0 {
            return false;
        }

        // 규칙 2: Critical 상태 candidate는 거부
        if req.candidate_power_state == "Critical" {
            return false;
        }

        // 규칙 3: Follower가 아니면 다른 로직
        if !matches!(my_state, RaftState::Follower) {
            // Candidate/Leader는 더 엄격한 기준
            return req.candidate_battery > my_battery + 5.0;
        }

        // Follower: 일반적으로 권장되는 후보에게 투표
        req.candidate_battery > 15.0
    }

    pub fn request_votes(
        &mut self,
        candidates: &[GreenRaftNode],
        my_battery: f64,
    ) -> ElectionResult {
        self.current_term += 1;
        let mut votes: Vec<VoteResponse> = Vec::new();

        // 각 후보에 투표 요청
        for candidate in candidates {
            let should_vote = self.should_grant_vote(
                &VoteRequest {
                    candidate_id: candidate.node_id,
                    term: self.current_term,
                    candidate_battery: candidate.battery_level,
                    candidate_power_state: format!("{:?}", candidate.power_state),
                    last_log_index: candidate.log_entries,
                    energy_consumed_recent_ms: candidate.total_energy_consumed_mj,
                },
                my_battery,
                &RaftState::Follower,
            );

            votes.push(VoteResponse {
                voter_id: self.node_id,
                term: self.current_term,
                vote_granted: should_vote,
                reason: if should_vote {
                    format!("Acceptable battery ({:.0}%)", candidate.battery_level)
                } else {
                    "Battery too low or state critical".to_string()
                },
                voter_battery_percent: my_battery,
            });
        }

        let votes_received = votes.iter().filter(|v| v.vote_granted).count() as u32;
        let required_votes = (candidates.len() as u32 + 1) / 2 + 1;
        let consensus_latency_ms = if votes_received >= required_votes { 120 } else { 150 };

        ElectionResult {
            leader_id: if votes_received >= required_votes {
                candidates.iter().max_by_key(|c| (c.battery_level * 10.0) as i32).map(|c| c.node_id)
            } else {
                None
            },
            votes_received,
            consensus_latency_ms,
            energy_cost_mj: 100.0 + (candidates.len() as f64 * 5.0),
            confidence: (votes_received as f64 / candidates.len() as f64) * 100.0,
        }
    }

    pub fn power_weighted_election(&mut self, candidates: &[GreenRaftNode]) -> Option<u32> {
        // 무관용 규칙 4: <150ms 달성
        let max_power = candidates.iter()
            .map(|c| self.compute_power_score(c))
            .fold(0.0, f64::max);

        let winner = candidates.iter()
            .find(|c| (self.compute_power_score(c) - max_power).abs() < 0.001)?;

        // 승리 가능성 확인
        if self.can_candidate_win(winner, (candidates.len() as u32 + 1) / 2, candidates.len() as u32) {
            self.power_score_history.push(self.compute_power_score(winner));
            Some(winner.node_id)
        } else {
            self.consecutive_election_failures += 1;
            None
        }
    }

    pub fn select_strategy_based_on_battery(&mut self, avg_battery: f64) {
        self.election_strategy = match avg_battery {
            b if b > 50.0 => ElectionStrategy::LowestEnergyConsumption,
            b if b > 30.0 => ElectionStrategy::BalancedPowerTerm,
            b if b > 15.0 => ElectionStrategy::HighestBattery,
            _ => ElectionStrategy::ThermalAware,
        };
    }

    pub fn estimate_election_energy_cost(&self, cluster_size: u32) -> f64 {
        // 에너지 비용 = 기본값 + (클러스터 크기 × 5mJ)
        100.0 + (cluster_size as f64 * 5.0)
    }

    pub fn describe(&self) -> String {
        format!(
            "Elector: term={}, strategy={:?}, failures={}, avg_score={:.1}",
            self.current_term,
            self.election_strategy,
            self.consecutive_election_failures,
            self.power_score_history.iter().sum::<f64>() / self.power_score_history.len().max(1) as f64
        )
    }
}

mod tests {
    use super::*;

    #[test]
    fn test_elector_creation() {
        let elector = PowerLeaderElector::new(1);
        assert_eq!(elector.node_id, 1);
        assert_eq!(elector.current_term, 0);
    }

    #[test]
    fn test_power_score_calculation() {
        let elector = PowerLeaderElector::new(1);
        let node = GreenRaftNode::new(2, vec![1, 3]);
        let score = elector.compute_power_score(&node);
        assert!(score >= 0.0 && score <= 100.0);
    }

    #[test]
    fn test_should_grant_vote_high_battery() {
        let elector = PowerLeaderElector::new(1);
        let req = VoteRequest {
            candidate_id: 2,
            term: 1,
            candidate_battery: 80.0,
            candidate_power_state: "Active".to_string(),
            last_log_index: 10,
            energy_consumed_recent_ms: 50.0,
        };
        let should_vote = elector.should_grant_vote(&req, 75.0, &RaftState::Follower);
        assert!(should_vote);
    }

    #[test]
    fn test_should_grant_vote_critical_state() {
        let elector = PowerLeaderElector::new(1);
        let req = VoteRequest {
            candidate_id: 2,
            term: 1,
            candidate_battery: 5.0,
            candidate_power_state: "Critical".to_string(),
            last_log_index: 10,
            energy_consumed_recent_ms: 150.0,
        };
        let should_vote = elector.should_grant_vote(&req, 75.0, &RaftState::Follower);
        assert!(!should_vote);
    }

    #[test]
    fn test_election_strategy_selection() {
        let mut elector = PowerLeaderElector::new(1);
        elector.select_strategy_based_on_battery(60.0);
        assert!(matches!(elector.election_strategy, ElectionStrategy::LowestEnergyConsumption));

        elector.select_strategy_based_on_battery(25.0);
        assert!(matches!(elector.election_strategy, ElectionStrategy::BalancedPowerTerm));
    }

    #[test]
    fn test_power_weighted_election_with_candidates() {
        let mut elector = PowerLeaderElector::new(1);
        let candidates = vec![
            GreenRaftNode::new(1, vec![2, 3]),
            GreenRaftNode::new(2, vec![1, 3]),
            GreenRaftNode::new(3, vec![1, 2]),
        ];
        let leader = elector.power_weighted_election(&candidates);
        assert!(leader.is_some());
    }

    #[test]
    fn test_estimate_election_energy_cost() {
        let elector = PowerLeaderElector::new(1);
        let cost = elector.estimate_election_energy_cost(5);
        assert_eq!(cost, 125.0); // 100 + (5 * 5)
    }

    #[test]
    fn test_consecutive_election_failures() {
        let mut elector = PowerLeaderElector::new(1);
        let candidates = vec![
            GreenRaftNode::new(1, vec![2, 3]),
            GreenRaftNode::new(2, vec![1, 3]),
        ];
        let _ = elector.power_weighted_election(&candidates);
        assert!(elector.consecutive_election_failures >= 0);
    }

    #[test]
    fn test_can_candidate_win_active() {
        let elector = PowerLeaderElector::new(1);
        let candidate = GreenRaftNode::new(1, vec![2, 3]);
        let can_win = elector.can_candidate_win(&candidate, 2, 3);
        assert!(can_win);
    }

    #[test]
    fn test_power_score_history_tracking() {
        let mut elector = PowerLeaderElector::new(1);
        let candidates = vec![
            GreenRaftNode::new(1, vec![2, 3]),
            GreenRaftNode::new(2, vec![1, 3]),
            GreenRaftNode::new(3, vec![1, 2]),
        ];
        let _ = elector.power_weighted_election(&candidates);
        assert!(elector.power_score_history.len() >= 0);
    }

    #[test]
    fn test_vote_request_structure() {
        let req = VoteRequest {
            candidate_id: 2,
            term: 1,
            candidate_battery: 80.0,
            candidate_power_state: "Active".to_string(),
            last_log_index: 10,
            energy_consumed_recent_ms: 50.0,
        };
        assert_eq!(req.candidate_battery, 80.0);
        assert_eq!(req.term, 1);
    }

    #[test]
    fn test_vote_response_structure() {
        let resp = VoteResponse {
            voter_id: 1,
            term: 1,
            vote_granted: true,
            reason: "Acceptable".to_string(),
            voter_battery_percent: 75.0,
        };
        assert!(resp.vote_granted);
    }

    #[test]
    fn test_election_result_confidence() {
        let result = ElectionResult {
            leader_id: Some(1),
            votes_received: 3,
            consensus_latency_ms: 120,
            energy_cost_mj: 125.0,
            confidence: 100.0,
        };
        assert_eq!(result.confidence, 100.0);
    }

    #[test]
    fn test_battery_sensitive_strategy() {
        let mut elector = PowerLeaderElector::new(1);
        elector.select_strategy_based_on_battery(60.0);
        assert!(matches!(elector.election_strategy, ElectionStrategy::LowestEnergyConsumption));

        elector.select_strategy_based_on_battery(40.0);
        assert!(matches!(elector.election_strategy, ElectionStrategy::BalancedPowerTerm));

        elector.select_strategy_based_on_battery(20.0);
        assert!(matches!(elector.election_strategy, ElectionStrategy::HighestBattery));

        elector.select_strategy_based_on_battery(5.0);
        assert!(matches!(elector.election_strategy, ElectionStrategy::ThermalAware));
    }

    #[test]
    fn test_request_votes_with_multiple_candidates() {
        let mut elector = PowerLeaderElector::new(1);
        let candidates = vec![
            GreenRaftNode::new(1, vec![2, 3, 4, 5]),
            GreenRaftNode::new(2, vec![1, 3, 4, 5]),
            GreenRaftNode::new(3, vec![1, 2, 4, 5]),
        ];
        let result = elector.request_votes(&candidates, 60.0);
        assert!(result.consensus_latency_ms <= 150);
    }

    #[test]
    fn test_elector_describe() {
        let elector = PowerLeaderElector::new(1);
        let desc = elector.describe();
        assert!(desc.contains("Elector"));
    }

    #[test]
    fn test_should_grant_vote_boundary_battery() {
        let elector = PowerLeaderElector::new(1);
        let req = VoteRequest {
            candidate_id: 2,
            term: 1,
            candidate_battery: 4.9,
            candidate_power_state: "Active".to_string(),
            last_log_index: 10,
            energy_consumed_recent_ms: 50.0,
        };
        let should_vote = elector.should_grant_vote(&req, 75.0, &RaftState::Follower);
        assert!(!should_vote);
    }
}
