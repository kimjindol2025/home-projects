// 실시간 대시보드 레이어 (L-Dashboard)

pub mod prometheus_exporter;
pub mod alert_rules;
pub mod grafana_dashboard;

pub use prometheus_exporter::{
    PrometheusMetric, PrometheusRegistry, GrafanaPanelMetrics, MetricType
};
pub use alert_rules::{
    AlertRule, AlertManager, AlertSeverity, UnforgivingAlertRules
};
pub use grafana_dashboard::{
    GrafanaDashboard, DashboardPanel, DefaultPanels, RefreshInterval
};

pub struct DashboardLayer {
    pub prometheus_registry: PrometheusRegistry,
    pub alert_manager: AlertManager,
    pub grafana_dashboard: GrafanaDashboard,
    pub enabled: bool,
    pub auto_refresh: bool,
}

impl DashboardLayer {
    pub fn new() -> Self {
        let mut dashboard = DefaultPanels::create_default_dashboard();
        dashboard.set_refresh_interval(RefreshInterval::ThirtySeconds);

        let mut alert_manager = AlertManager::new();
        UnforgivingAlertRules::register_all(&mut alert_manager);

        let panel_metrics = GrafanaPanelMetrics::new();
        let registry = panel_metrics.to_registry();

        DashboardLayer {
            prometheus_registry: registry,
            alert_manager,
            grafana_dashboard: dashboard,
            enabled: true,
            auto_refresh: true,
        }
    }

    pub fn update_metrics(&mut self, metrics: &GrafanaPanelMetrics) {
        let registry = metrics.to_registry();
        self.prometheus_registry = registry;
    }

    pub fn check_alerts(&mut self, metric_name: &str, value: f64) -> Vec<prometheus_exporter::PrometheusMetric> {
        self.alert_manager.evaluate(metric_name, value);
        Vec::new()
    }

    pub fn export_prometheus(&self) -> String {
        self.prometheus_registry.export()
    }

    pub fn export_dashboard_json(&self) -> String {
        self.grafana_dashboard.export_json()
    }

    pub fn get_active_alerts(&self) -> usize {
        self.alert_manager.get_active_alerts().len()
    }

    pub fn get_panel_count(&self) -> usize {
        self.grafana_dashboard.get_panels_count()
    }

    pub fn get_metrics_count(&self) -> usize {
        self.prometheus_registry.get_metrics_count()
    }

    pub fn get_alert_rules_count(&self) -> usize {
        self.alert_manager.rules.len()
    }

    pub fn get_summary(&self) -> DashboardReport {
        DashboardReport {
            dashboard_name: self.grafana_dashboard.title.clone(),
            total_panels: self.grafana_dashboard.get_panels_count(),
            total_metrics: self.prometheus_registry.get_metrics_count(),
            alert_rules: self.alert_manager.rules.len(),
            active_alerts: self.alert_manager.get_active_alerts().len(),
            enabled: self.enabled,
            auto_refresh: self.auto_refresh,
        }
    }
}

pub struct DashboardReport {
    pub dashboard_name: String,
    pub total_panels: usize,
    pub total_metrics: usize,
    pub alert_rules: usize,
    pub active_alerts: usize,
    pub enabled: bool,
    pub auto_refresh: bool,
}

impl DashboardReport {
    pub fn display(&self) {
        println!("Dashboard Report:");
        println!("  Dashboard: {}", self.dashboard_name);
        println!("  Panels: {}", self.total_panels);
        println!("  Metrics: {}", self.total_metrics);
        println!("  Alert Rules: {}", self.alert_rules);
        println!("  Active Alerts: {}", self.active_alerts);
        println!("  Enabled: {}", self.enabled);
        println!("  Auto Refresh: {}", self.auto_refresh);
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_dashboard_layer_creation() {
        let layer = DashboardLayer::new();
        assert!(layer.enabled);
        assert!(layer.auto_refresh);
    }

    #[test]
    fn test_dashboard_metrics_export() {
        let layer = DashboardLayer::new();
        let prometheus_export = layer.export_prometheus();

        assert!(!prometheus_export.is_empty());
        assert!(prometheus_export.contains("green_fabric"));
    }

    #[test]
    fn test_dashboard_panel_count() {
        let layer = DashboardLayer::new();
        assert_eq!(layer.get_panel_count(), 4);
    }

    #[test]
    fn test_dashboard_alert_rules() {
        let layer = DashboardLayer::new();
        assert_eq!(layer.get_alert_rules_count(), 10);
    }

    #[test]
    fn test_dashboard_report() {
        let layer = DashboardLayer::new();
        let report = layer.get_summary();

        assert_eq!(report.total_panels, 4);
        assert_eq!(report.alert_rules, 10);
    }
}
