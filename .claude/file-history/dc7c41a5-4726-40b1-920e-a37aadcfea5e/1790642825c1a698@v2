// Phase 3.1.5 글리프 추출기
// TrueType 좌표 → 베지어 곡선 변환

use crate::core::fixed_point::*;
use crate::core::solver::{Point, CubicBezier};
use crate::parser::ttf_parser::{GlyphOutline, FLAG_ON_CURVE};

#[derive(Clone, Debug)]
pub struct Glyph {
    pub codepoint: char,
    pub beziers: Vec<CubicBezier>,
    pub bounds: GlyphBounds,
}

#[derive(Clone, Debug)]
pub struct GlyphBounds {
    pub xmin: Fixed16,
    pub ymin: Fixed16,
    pub xmax: Fixed16,
    pub ymax: Fixed16,
}

impl GlyphBounds {
    pub fn new() -> Self {
        GlyphBounds {
            xmin: from_int(0),
            ymin: from_int(0),
            xmax: from_int(0),
            ymax: from_int(0),
        }
    }

    pub fn width(&self) -> Fixed16 {
        self.xmax - self.xmin
    }

    pub fn height(&self) -> Fixed16 {
        self.ymax - self.ymin
    }
}

pub struct GlyphExtractor;

impl GlyphExtractor {
    // TrueType 윤곽선 → 베지어 곡선 변환
    pub fn outline_to_beziers(outline: &GlyphOutline, units_per_em: u16) -> Vec<CubicBezier> {
        let mut beziers = Vec::new();

        if outline.num_contours <= 0 {
            return beziers;
        }

        let scale = div(FIXED_ONE, from_int(units_per_em as i32));
        let mut point_idx = 0;

        for contour_end_idx in &outline.end_pts {
            let contour_end = *contour_end_idx as usize;

            // 현재 윤곽선의 점 추출
            let contour_points: Vec<(i16, i16, bool)> = (point_idx..=contour_end)
                .map(|i| {
                    let x = outline.x_coords.get(i).copied().unwrap_or(0);
                    let y = outline.y_coords.get(i).copied().unwrap_or(0);
                    let on_curve = outline.flags.get(i).copied().unwrap_or(0) & FLAG_ON_CURVE != 0;
                    (x, y, on_curve)
                })
                .collect();

            // 곡선 세그먼트 생성
            let segments = Self::points_to_segments(&contour_points, scale);
            beziers.extend(segments);

            point_idx = contour_end + 1;
        }

        beziers
    }

    // TrueType 점 → 베지어 곡선 세그먼트 변환
    fn points_to_segments(
        points: &[(i16, i16, bool)],
        scale: Fixed16,
    ) -> Vec<CubicBezier> {
        let mut segments = Vec::new();

        if points.len() < 2 {
            return segments;
        }

        let mut i = 0;
        while i < points.len() {
            let (x0, y0, on0) = points[i];
            let idx_next = (i + 1) % points.len();
            let (x1, y1, on1) = points[idx_next];

            if on0 && on1 {
                // 직선: P0 → P1
                // 베지어로 표현: 제어점이 P0, P1과 동일
                let p0 = Self::scale_point(x0, y0, scale);
                let p1 = Self::scale_point(x1, y1, scale);

                let bezier = CubicBezier::new(p0, p0, p1, p1);
                segments.push(bezier);
                i += 1;
            } else if on0 && !on1 {
                // P0은 곡선 위, P1은 제어점 (off-curve)
                // 다음 점 확인
                let idx_after = (i + 2) % points.len();
                let (x2, y2, on2) = if idx_after < points.len() {
                    points[idx_after]
                } else {
                    points[0]
                };

                if on2 {
                    // 이차 베지어: P0 → (P1) → P2
                    // 3차로 변환: P0, P0 + 2/3(P1-P0), P2 + 2/3(P1-P2), P2
                    let p0 = Self::scale_point(x0, y0, scale);
                    let p1_off = Self::scale_point(x1, y1, scale);
                    let p2 = Self::scale_point(x2, y2, scale);

                    let cp1 = p0.add(&p1_off.sub(&p0).scale(mul(from_int(2), div(FIXED_ONE, from_int(3)))));
                    let cp2 = p2.add(&p1_off.sub(&p2).scale(mul(from_int(2), div(FIXED_ONE, from_int(3)))));

                    let bezier = CubicBezier::new(p0, cp1, cp2, p2);
                    segments.push(bezier);
                    i += 2;
                } else {
                    i += 1;
                }
            } else {
                // !on0: 시작이 off-curve (일반적이지 않음)
                i += 1;
            }
        }

        segments
    }

    // i16 좌표를 Fixed16으로 스케일
    fn scale_point(x: i16, y: i16, scale: Fixed16) -> Point {
        Point::new(
            mul(from_int(x as i32), scale),
            mul(from_int(y as i32), scale),
        )
    }

    // 글리프 생성 (U+0047 = 'G', U+004F = 'O', U+0053 = 'S')
    pub fn create_glyph(
        codepoint: char,
        outline: &GlyphOutline,
        units_per_em: u16,
    ) -> Glyph {
        let beziers = Self::outline_to_beziers(outline, units_per_em);

        // 경계 계산
        let bounds = Self::calculate_bounds(&outline, units_per_em);

        Glyph {
            codepoint,
            beziers,
            bounds,
        }
    }

    // 글리프 경계 계산
    fn calculate_bounds(outline: &GlyphOutline, units_per_em: u16) -> GlyphBounds {
        let scale = div(FIXED_ONE, from_int(units_per_em as i32));

        let mut bounds = GlyphBounds::new();

        if outline.x_coords.is_empty() {
            return bounds;
        }

        let xmin = *outline.x_coords.iter().min().unwrap_or(&0) as i32;
        let xmax = *outline.x_coords.iter().max().unwrap_or(&0) as i32;
        let ymin = *outline.y_coords.iter().min().unwrap_or(&0) as i32;
        let ymax = *outline.y_coords.iter().max().unwrap_or(&0) as i32;

        bounds.xmin = mul(from_int(xmin), scale);
        bounds.ymin = mul(from_int(ymin), scale);
        bounds.xmax = mul(from_int(xmax), scale);
        bounds.ymax = mul(from_int(ymax), scale);

        bounds
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_glyph_creation() {
        let outline = GlyphOutline::new();
        let glyph = GlyphExtractor::create_glyph('A', &outline, 1000);
        assert_eq!(glyph.codepoint, 'A');
    }

    #[test]
    fn test_bounds_calculation() {
        let mut outline = GlyphOutline::new();
        outline.x_coords = vec![0, 100, 50];
        outline.y_coords = vec![0, 200, 100];

        let bounds = GlyphExtractor::calculate_bounds(&outline, 1000);
        assert!(bounds.xmin <= bounds.xmax);
        assert!(bounds.ymin <= bounds.ymax);
    }

    #[test]
    fn test_scale_point() {
        let p = GlyphExtractor::scale_point(1000, 1000, FIXED_ONE);
        assert_eq!(p.x, FIXED_ONE);
        assert_eq!(p.y, FIXED_ONE);
    }

    #[test]
    fn test_glyph_bounds_dimensions() {
        let mut bounds = GlyphBounds::new();
        bounds.xmin = from_int(0);
        bounds.ymin = from_int(0);
        bounds.xmax = from_int(100);
        bounds.ymax = from_int(100);

        assert_eq!(bounds.width(), from_int(100));
        assert_eq!(bounds.height(), from_int(100));
    }

    #[test]
    fn test_outline_to_beziers_empty() {
        let outline = GlyphOutline::new();
        let beziers = GlyphExtractor::outline_to_beziers(&outline, 1000);
        assert!(beziers.is_empty());
    }
}
