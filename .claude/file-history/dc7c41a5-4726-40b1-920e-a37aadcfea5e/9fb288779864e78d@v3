// Phase 3 Week 3: Energy History Layer Facade (70줄)
// Unified interface for L5 energy learning and pattern storage

pub mod energy_pattern_db;
pub mod efficiency_learner;

pub use energy_pattern_db::{EnergyPatternDB, EnergyHistoryEntry, PatternStatistics};
pub use efficiency_learner::{EfficiencyLearner, ActionEffectiveness, PowerLearningState};

pub struct EnergyHistoryLayer {
    pub pattern_db: EnergyPatternDB,
    pub learner: EfficiencyLearner,
    pub insights_generated: u32,
}

impl EnergyHistoryLayer {
    pub fn new() -> Self {
        EnergyHistoryLayer {
            pattern_db: EnergyPatternDB::new(1000),
            learner: EfficiencyLearner::new(),
            insights_generated: 0,
        }
    }

    pub fn record_pattern_with_action(
        &mut self,
        timestamp_ms: u64,
        pattern_type: String,
        power_mw: f64,
        battery_percent: f64,
        action: String,
        success: bool,
        reduction_mw: f64,
        latency_ms: u32,
    ) {
        let mut entry = EnergyHistoryEntry::new(timestamp_ms, pattern_type.clone(), power_mw, battery_percent, action.clone());
        
        if success {
            entry.mark_success(reduction_mw, latency_ms, 85.0);
            self.learner.observe_action(&action, true, reduction_mw, latency_ms);
        } else {
            self.learner.observe_action(&action, false, reduction_mw, latency_ms);
        }
        
        self.pattern_db.record(entry);
        self.learner.observe_pattern(&pattern_type);
    }

    pub fn generate_insights(&mut self) -> Vec<String> {
        let mut insights = Vec::new();
        
        if let Some(best_pattern) = self.pattern_db.get_best_pattern() {
            insights.push(format!("Best pattern: {}", best_pattern));
        }
        
        if let Some(best_action) = self.learner.get_best_action() {
            insights.push(format!("Recommended action: {}", best_action));
        }
        
        insights.push(format!("Learning state: {:?}", self.learner.state));
        insights.push(format!("Hit rate: {:.1}%", self.learner.hit_rate));
        
        self.insights_generated += insights.len() as u32;
        insights
    }

    pub fn is_learning_complete(&self) -> bool {
        self.learner.is_ready_for_production()
    }

    pub fn describe(&self) -> String {
        format!(
            "EnergyHistory: db_entries={}, actions={}, insights={}, complete={}",
            self.pattern_db.entries.len(),
            self.learner.action_history.len(),
            self.insights_generated,
            self.is_learning_complete()
        )
    }
}

mod tests {
    use super::*;

    #[test]
    fn test_layer_creation() {
        let layer = EnergyHistoryLayer::new();
        assert_eq!(layer.insights_generated, 0);
    }

    #[test]
    fn test_layer_record_pattern() {
        let mut layer = EnergyHistoryLayer::new();
        layer.record_pattern_with_action(
            1000, "MemoryLeak".to_string(), 150.0, 75.0,
            "ReduceFrequency".to_string(), true, 20.0, 50
        );
        assert_eq!(layer.pattern_db.entries.len(), 1);
    }

    #[test]
    fn test_layer_generate_insights() {
        let mut layer = EnergyHistoryLayer::new();
        for i in 0..4 {
            layer.record_pattern_with_action(
                (1000 + i * 1000) as u64, "MemoryLeak".to_string(), 150.0, 75.0,
                "ReduceFrequency".to_string(), true, 20.0 + i as f64, 50
            );
        }
        let insights = layer.generate_insights();
        assert!(!insights.is_empty());
    }

    #[test]
    fn test_layer_is_learning_complete() {
        let mut layer = EnergyHistoryLayer::new();
        assert!(!layer.is_learning_complete());
        for i in 0..35 {
            layer.record_pattern_with_action(
                (1000 + i * 1000) as u64, "MemoryLeak".to_string(), 150.0, 75.0,
                "ReduceFrequency".to_string(), i % 3 == 0, 20.0, 50
            );
        }
        layer.learner.update_hit_rate(30, 35);
        assert!(layer.is_learning_complete());
    }
}

