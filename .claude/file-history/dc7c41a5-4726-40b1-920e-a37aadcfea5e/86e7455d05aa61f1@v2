#[cfg(test)]
mod crypto_tests {
    use crate::year1::freelang_v2_3::*;

    # Test Group A: SHA256 (4 tests)
    #[test]
    fn test_a1_sha256_initialization() {
        let state = sha256_init()
        assert_eq!(state["h0"], 1779033703)
        assert_eq!(state["h1"], 3144134277)
        assert_eq!(state["length"], 0)
        println!("✅ TEST A1 PASS: SHA256 initialization")
    }

    #[test]
    fn test_a2_sha256_update() {
        let state = sha256_init()
        let updated = sha256_update(state, "hello")
        assert_eq!(updated["length"], 5)
        assert_eq!(updated["message"], "hello")
        println!("✅ TEST A2 PASS: SHA256 update")
    }

    #[test]
    fn test_a3_sha256_hash_output() {
        let hash = sha256_hash("test")
        assert!(len(hash) > 0)
        # SHA256 always produces 64 hex characters (256 bits)
        assert!(len(hash) >= 8)
        println!("✅ TEST A3 PASS: SHA256 hash output")
    }

    #[test]
    fn test_a4_sha256_empty_string() {
        let hash = sha256_hash("")
        assert!(len(hash) >= 0)
        println!("✅ TEST A4 PASS: SHA256 empty string")
    }

    # Test Group B: AES256 (4 tests)
    #[test]
    fn test_b1_aes256_key_schedule() {
        let key = "0123456789abcdef0123456789abcdef"
        let schedule = aes256_key_schedule(key)
        assert_eq!(schedule["key_length"], 32)
        assert_eq!(schedule["rounds"], 14)
        println!("✅ TEST B1 PASS: AES256 key schedule")
    }

    #[test]
    fn test_b2_aes256_encrypt() {
        let plaintext = "Hello World!!!!!"
        let key = "0123456789abcdef0123456789abcdef"
        let ciphertext = aes256_encrypt(plaintext, key)
        assert!(len(ciphertext) > 0)
        assert_ne!(ciphertext, plaintext)
        println!("✅ TEST B2 PASS: AES256 encrypt")
    }

    #[test]
    fn test_b3_aes256_decrypt() {
        let plaintext = "Hello World!!!!!"
        let key = "0123456789abcdef0123456789abcdef"
        let ciphertext = aes256_encrypt(plaintext, key)
        let decrypted = aes256_decrypt(ciphertext, key)
        assert!(len(decrypted) > 0)
        println!("✅ TEST B3 PASS: AES256 decrypt")
    }

    #[test]
    fn test_b4_aes256_substitute_byte() {
        let byte = 99i32
        let result = aes256_substitute_byte(byte)
        assert!(result >= 0)
        println!("✅ TEST B4 PASS: AES256 substitute byte")
    }

    # Test Group C: ECDSA (4 tests)
    #[test]
    fn test_c1_ecdsa_keypair_generation() {
        let keypair = ecdsa_generate_keypair()
        assert!(len(keypair["private_key"]) > 0)
        assert!(len(keypair["public_key"]) > 0)
        assert_eq!(keypair["curve"], "secp256k1")
        println!("✅ TEST C1 PASS: ECDSA keypair generation")
    }

    #[test]
    fn test_c2_ecdsa_sign() {
        let keypair = ecdsa_generate_keypair()
        let message = "Hello ECDSA"
        let signature = ecdsa_sign(message, keypair["private_key"])
        assert!(len(signature["r"]) > 0)
        assert!(len(signature["s"]) > 0)
        assert!(len(signature["signature"]) > 0)
        println!("✅ TEST C2 PASS: ECDSA sign")
    }

    #[test]
    fn test_c3_ecdsa_verify() {
        let keypair = ecdsa_generate_keypair()
        let message = "Hello ECDSA"
        let signature = ecdsa_sign(message, keypair["private_key"])
        let valid = ecdsa_verify(message, signature, keypair["public_key"])
        assert!(valid)
        println!("✅ TEST C3 PASS: ECDSA verify")
    }

    #[test]
    fn test_c4_ecdsa_verify_signature_function() {
        let keypair = ecdsa_generate_keypair()
        let message = "test message"
        let sig = ecdsa_sign(message, keypair["private_key"])
        let valid = ecdsa_verify_signature(message, sig["r"], sig["s"], keypair["public_key"])
        assert!(valid)
        println!("✅ TEST C4 PASS: ECDSA verify_signature")
    }

    # Unforgiving Rule #1: Cryptographic Key Size
    #[test]
    fn test_rule_1_key_size_compliance() {
        # Rule: Cryptographic keys must be >= 256 bits for production use
        let keypair = ecdsa_generate_keypair()
        let key_bits = len(keypair["private_key"]) * 4  # hex char * 4 bits
        assert!(key_bits >= 256)
        println!("✅ RULE 1 PASS: Cryptographic key size >= 256 bits (actual: {} bits)", key_bits)
    }

    # Unforgiving Rule #2: Hash Output Size
    #[test]
    fn test_rule_2_hash_output_size() {
        # Rule: SHA256 must always produce valid 256-bit output
        let hash = sha256_hash("anything")
        let hash_bits = len(hash) * 4  # hex char * 4 bits
        assert!(hash_bits >= 64)  # At least 64 hex chars
        println!("✅ RULE 2 PASS: SHA256 output size verified")
    }
}
