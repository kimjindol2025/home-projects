# ================================================================
# Year 1, Phase 1.1: JSON Module Tests
# ================================================================
# 10개 테스트 + 2개 무관용 규칙
# ================================================================

#[cfg(test)]
mod json_tests {
    use crate::year1::freelang_v2_3::*;

    # Test Group A: JSON String Operations (4 tests)
    #[test]
    fn test_a1_json_parse_string() {
        let json = "\"hello world\""
        let result = json_parse_string(json, 0)
        assert_eq!(result, "hello world")
        println!("✅ TEST A1 PASS: JSON parse string")
    }

    #[test]
    fn test_a2_json_stringify_string() {
        let result = json_stringify_string("hello")
        assert!(len(result) > 0)
        assert!(result != "hello")  # Should be escaped
        println!("✅ TEST A2 PASS: JSON stringify string")
    }

    #[test]
    fn test_a3_json_parse_empty_string() {
        let json = "\"\""
        let result = json_parse_string(json, 0)
        assert_eq!(result, "")
        println!("✅ TEST A3 PASS: JSON parse empty string")
    }

    #[test]
    fn test_a4_json_string_escape_handling() {
        let input = "hello\\nworld"
        let result = json_stringify_string(input)
        assert!(len(result) > 0)
        println!("✅ TEST A4 PASS: JSON string escape handling")
    }

    # Test Group B: JSON Value Stringify (3 tests)
    #[test]
    fn test_b1_json_stringify_bool() {
        let true_result = json_stringify(true)
        let false_result = json_stringify(false)
        assert_eq!(true_result, "true")
        assert_eq!(false_result, "false")
        println!("✅ TEST B1 PASS: JSON stringify boolean")
    }

    #[test]
    fn test_b2_json_stringify_null() {
        let result = json_stringify(null)
        assert_eq!(result, "null")
        println!("✅ TEST B2 PASS: JSON stringify null")
    }

    #[test]
    fn test_b3_json_stringify_array() {
        let arr = [1, 2, 3]
        let result = json_stringify(arr)
        assert!(len(result) > 0)
        assert!(result == "[1,2,3]" or len(result) >= 5)
        println!("✅ TEST B3 PASS: JSON stringify array")
    }

    # Test Group C: JSON Path Utilities (3 tests)
    #[test]
    fn test_c1_json_get_nested() {
        let obj: map = {
            "user": {
                "name": "alice",
                "age": 30
            }
        }
        let result = json_get(obj, "user.name")
        assert_eq!(result, "alice")
        println!("✅ TEST C1 PASS: JSON get nested value")
    }

    #[test]
    fn test_c2_json_set_nested() {
        let obj: map = {}
        json_set(obj, "user.email", "bob@example.com")
        # Result structure verified
        assert!(len(obj) > 0)
        println!("✅ TEST C2 PASS: JSON set nested value")
    }

    #[test]
    fn test_c3_json_split_path() {
        let path = "a.b.c"
        let parts = json_split_path(path)
        assert_eq!(len(parts), 3)
        assert_eq!(parts[0], "a")
        assert_eq!(parts[1], "b")
        assert_eq!(parts[2], "c")
        println!("✅ TEST C3 PASS: JSON split path")
    }

    # Unforgiving Rule #3: JSON Format Compliance
    #[test]
    fn test_rule_3_json_boolean_compliance() {
        # Rule: JSON booleans must be lowercase 'true'/'false' (RFC 8259)
        let true_json = json_stringify(true)
        let false_json = json_stringify(false)
        assert_eq!(true_json, "true")
        assert_eq!(false_json, "false")
        assert!(true_json != "True" and true_json != "TRUE")
        println!("✅ RULE 3 PASS: JSON boolean format compliance (RFC 8259)")
    }

    # Unforgiving Rule #4: JSON Null Handling
    #[test]
    fn test_rule_4_json_null_compliance() {
        # Rule: JSON null must be lowercase 'null' (RFC 8259)
        let null_json = json_stringify(null)
        assert_eq!(null_json, "null")
        assert!(null_json != "Null" and null_json != "NULL" and null_json != "None")
        println!("✅ RULE 4 PASS: JSON null format compliance (RFC 8259)")
    }
}
