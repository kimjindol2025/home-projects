// Phase 3.2 텍스트 렌더러
// String layout + Glyph positioning + 화면 출력

use crate::core::fixed_point::*;
use crate::integration::FontEngine;
use crate::console::frame_buffer::{FrameBuffer, Color};

#[derive(Clone, Debug)]
pub struct TextLayout {
    pub x: i32,
    pub y: i32,
    pub size_pt: u16,
    pub color: Color,
    pub line_height: i32,
}

impl TextLayout {
    pub fn new(x: i32, y: i32, size_pt: u16) -> Self {
        TextLayout {
            x,
            y,
            size_pt,
            color: Color::white(),
            line_height: (size_pt as i32) * 6 / 5,  // 1.2x 줄 높이
        }
    }

    pub fn with_color(mut self, color: Color) -> Self {
        self.color = color;
        self
    }
}

#[derive(Clone, Debug)]
pub struct GlyphMetrics {
    pub advance_width: i32,
    pub advance_height: i32,
    pub offset_x: i32,
    pub offset_y: i32,
}

impl GlyphMetrics {
    pub fn default() -> Self {
        GlyphMetrics {
            advance_width: 50,     // 기본값 (픽셀)
            advance_height: 0,
            offset_x: 0,
            offset_y: 0,
        }
    }
}

pub struct TextRenderer {
    pub font: FontEngine,
    pub glyphs_cache: std::collections::HashMap<char, crate::parser::Glyph>,
}

impl TextRenderer {
    pub fn new(font: FontEngine) -> Self {
        TextRenderer {
            font,
            glyphs_cache: std::collections::HashMap::new(),
        }
    }

    // 텍스트를 프레임버퍼에 렌더링
    pub fn render_text(
        &mut self,
        fb: &mut FrameBuffer,
        text: &str,
        layout: TextLayout,
    ) -> i32 {
        let mut cursor_x = layout.x;
        let mut cursor_y = layout.y;
        let mut max_x = layout.x;

        for ch in text.chars() {
            if ch == '\n' {
                cursor_y += layout.line_height;
                cursor_x = layout.x;
                continue;
            }

            // 글리프 렌더링
            self.render_glyph(fb, ch, cursor_x, cursor_y, layout.size_pt, layout.color);

            // 메트릭: 대략 폰트 크기의 절반만큼 advance
            let metrics = self.get_glyph_metrics(ch, layout.size_pt);
            cursor_x += metrics.advance_width;
            max_x = max_x.max(cursor_x);
        }

        max_x
    }

    // 단일 글리프 렌더링
    fn render_glyph(
        &mut self,
        fb: &mut FrameBuffer,
        ch: char,
        x: i32,
        y: i32,
        size_pt: u16,
        color: Color,
    ) {
        // SDF 생성
        if let Some(sdf) = self.font.render_glyph_at_size(ch, size_pt) {
            // SDF의 각 픽셀을 프레임버퍼에 복사 (스케일)
            let scale = div(from_int(size_pt as i32), from_int(12));  // 기본값 12pt
            let glyph_width = to_int(mul(from_int(32), scale));
            let glyph_height = to_int(mul(from_int(32), scale));

            for gy in 0..32 {
                for gx in 0..32 {
                    let pixel = sdf.get(gx, gy);

                    // SDF 값을 알파로 변환 (shader)
                    let alpha = self.font.shade_pixel(pixel.distance) & 0xFF;

                    if alpha > 0 {
                        let screen_x = x + ((gx as i32 * glyph_width) / 32);
                        let screen_y = y + ((gy as i32 * glyph_height) / 32);

                        if screen_x >= 0 && screen_y >= 0 {
                            // 알파값을 색상에 적용
                            let color_with_alpha = Color {
                                r: color.r,
                                g: color.g,
                                b: color.b,
                                a: ((color.a as u32 * alpha) >> 8) as u8,
                            };

                            fb.blend_pixel(screen_x as usize, screen_y as usize, color_with_alpha);
                        }
                    }
                }
            }
        }
    }

    // 글리프 메트릭 조회 (간단화)
    fn get_glyph_metrics(&self, _ch: char, size_pt: u16) -> GlyphMetrics {
        GlyphMetrics {
            advance_width: (size_pt as i32) * 6 / 10,  // 대략 0.6 × size
            advance_height: 0,
            offset_x: 0,
            offset_y: 0,
        }
    }

    // 텍스트 width 계산 (레이아웃)
    pub fn measure_text(&self, text: &str, size_pt: u16) -> i32 {
        let mut width = 0i32;

        for ch in text.chars() {
            if ch == '\n' {
                break;  // 한 줄만 측정
            }

            let metrics = self.get_glyph_metrics(ch, size_pt);
            width += metrics.advance_width;
        }

        width
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_text_layout_creation() {
        let layout = TextLayout::new(0, 0, 12);
        assert_eq!(layout.x, 0);
        assert_eq!(layout.y, 0);
        assert_eq!(layout.size_pt, 12);
    }

    #[test]
    fn test_text_layout_with_color() {
        let layout = TextLayout::new(0, 0, 12)
            .with_color(Color::white());

        assert_eq!(layout.color.r, 255);
    }

    #[test]
    fn test_glyph_metrics() {
        let metrics = GlyphMetrics::default();
        assert!(metrics.advance_width > 0);
    }

    #[test]
    fn test_measure_text() {
        let ttf_data = vec![0x00; 500];
        let font = FontEngine::new(ttf_data);
        let renderer = TextRenderer::new(font);

        let width = renderer.measure_text("GOGS", 100);
        assert!(width > 0);
    }

    #[test]
    fn test_measure_text_with_newline() {
        let ttf_data = vec![0x00; 500];
        let font = FontEngine::new(ttf_data);
        let renderer = TextRenderer::new(font);

        let width = renderer.measure_text("GO\nGS", 100);
        // 뉴라인 이후는 무시됨
        assert!(width > 0);
    }
}
