#[test]
fn test_intermittent_computing_detection() {
    // Verify intermittent computing pattern detection (0-50-0mW)
    // Expected: Confidence >50% when pattern present
    let power_readings = vec![5.0, 50.0, 5.0, 5.0, 45.0, 5.0];
    let mut spike_count = 0;

    for i in 0..power_readings.len() - 1 {
        if power_readings[i] < 10.0 && power_readings[i+1] > 40.0 {
            spike_count += 1;
        }
    }

    let confidence = spike_count as f64 / power_readings.len() as f64;
    assert!(confidence > 0.2, "Intermittent detection confidence {} < 20%",
        confidence * 100.0);
}

#[test]
fn test_deep_sleep_pattern_recognition() {
    // Verify deep sleep pattern (mostly <5mW)
    // Expected: Confidence >80% when 80%+ readings <5mW
    let power_readings = vec![3.0, 4.0, 3.5, 2.0, 4.5, 3.0, 4.0, 3.5];
    let low_count = power_readings.iter().filter(|&&p| p < 5.0).count();
    let confidence = low_count as f64 / power_readings.len() as f64;

    assert!(confidence > 0.8, "Deep sleep detection {} < 80%",
        confidence * 100.0);
}

#[test]
fn test_thermal_throttling_detection() {
    // Verify thermal throttling pattern (power drop)
    // Expected: Detect >20% power reduction in second half
    let readings = vec![
        150.0, 150.0, 150.0, 150.0, 150.0,  // first half avg = 150
        100.0, 110.0, 105.0, 100.0, 105.0,  // second half avg = 104 (30% drop)
    ];

    let first_half_avg = readings[..5].iter().sum::<f64>() / 5.0;
    let second_half_avg = readings[5..].iter().sum::<f64>() / 5.0;
    let reduction = (first_half_avg - second_half_avg) / first_half_avg;

    assert!(reduction > 0.2, "Thermal throttle detection {} < 20%",
        reduction * 100.0);
}

#[test]
fn test_network_wakeup_spike_detection() {
    // Verify network wakeup spike detection
    // Expected: Max/avg ratio >3.0
    let readings = vec![50.0, 50.0, 50.0, 50.0, 180.0, 50.0, 50.0];
    let avg = readings.iter().sum::<f64>() / readings.len() as f64;
    let max = readings.iter().copied().fold(0.0, f64::max);
    let spike_ratio = max / avg;

    assert!(spike_ratio > 3.0, "Wakeup spike ratio {} < 3.0", spike_ratio);
}

#[test]
fn test_cache_contention_detection() {
    // Verify cache contention pattern (high power + high variance)
    // Expected: avg >80mW, CoV >0.3
    let readings = vec![
        100.0, 120.0, 95.0, 105.0, 115.0, 90.0, 110.0, 100.0
    ];
    let avg = readings.iter().sum::<f64>() / readings.len() as f64;
    let variance = readings.iter().map(|p| (p - avg).powi(2))
        .sum::<f64>() / readings.len() as f64;
    let stddev = variance.sqrt();
    let cov = stddev / avg;

    assert!(avg > 80.0 && cov > 0.3, "Cache contention: avg={}, CoV={}",
        avg, cov);
}

