#[test]
fn test_consensus_latency_sublinear_growth() {
    // Verify consensus latency grows sublinearly with nodes
    // Expected: 3N→80ms, 5N→90ms, 10N→110ms (O(log N) not O(N))
    let measurements = vec![
        (3, 80.0),
        (5, 90.0),
        (10, 110.0),
    ];

    for i in 1..measurements.len() {
        let (nodes_prev, lat_prev) = measurements[i - 1];
        let (nodes_curr, lat_curr) = measurements[i];

        let node_growth = nodes_curr as f64 / nodes_prev as f64;
        let latency_growth = lat_curr / lat_prev;

        assert!(latency_growth < node_growth,
            "Latency growth {} >= node growth {}", latency_growth, node_growth);
    }
}

