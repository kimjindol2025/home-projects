#[test]
fn test_battery_discharge_monotonic() {
    // Verify battery charge decreases monotonically
    // Expected: No charge increase, only decrease or stable
    let discharge_curve = vec![100.0, 99.5, 99.0, 98.0, 97.5, 97.0];
    let mut is_monotonic = true;

    for i in 1..discharge_curve.len() {
        if discharge_curve[i] > discharge_curve[i-1] {
            is_monotonic = false;
            break;
        }
    }

    assert!(is_monotonic, "Battery discharge not monotonic");
}

