#[test]
fn test_measurement_confidence_95_percent() {
    // Verify measurement confidence reaches 95%
    // Expected: >=30 samples → 95%+ confidence
    let sample_count = 30;
    let confidence = (sample_count as f64 / 30.0).min(1.0);

