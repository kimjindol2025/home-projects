#[test]
fn test_multi_node_power_uniformity() {
    // Verify power distribution uniformity across nodes
    // Expected: Jain fairness index >0.9 (ideal = 1.0)
    let node_powers = vec![150.0, 151.0, 149.0, 150.5];
    let sum = node_powers.iter().sum::<f64>();
    let sum_sq = node_powers.iter().map(|p| p.powi(2)).sum::<f64>();
    let n = node_powers.len() as f64;

    let jain = (sum * sum) / (n * sum_sq);
    assert!(jain >= 0.9, "Fairness index {} < 0.9", jain);
}

#[test]
fn test_power_measurement_sampling() {
    // Verify power measurement samples at correct intervals
    // Expected: 100ms intervals, 10 samples = 1 second duration
    let sample_interval_ms = 100;
    let sample_count = 10;
    let expected_duration_ms = sample_interval_ms * sample_count;

    assert_eq!(expected_duration_ms, 1000, "Duration mismatch");
}

