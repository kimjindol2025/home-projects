// Phase 5.3 Day 2-3: Grafana 자동 알림 규칙 (200줄)
// 10가지 무관용 알림 규칙, 조건 기반 알림

use std::collections::HashMap;

#[derive(Clone, Debug)]
pub enum AlertSeverity {
    Info = 0,
    Warning = 1,
    Critical = 2,
}

#[derive(Clone, Debug)]
pub enum AlertCondition {
    GreaterThan(f64),
    LessThan(f64),
    BetweenRange(f64, f64),
    Equals(f64),
}

#[derive(Clone, Debug)]
pub struct AlertRule {
    pub name: String,
    pub description: String,
    pub metric: String,
    pub condition: AlertCondition,
    pub severity: AlertSeverity,
    pub enabled: bool,
    pub evaluation_period_sec: u32,
    pub for_duration_sec: u32,
    pub message: String,
}

impl AlertRule {
    pub fn new(name: &str, metric: &str, condition: AlertCondition) -> Self {
        AlertRule {
            name: name.to_string(),
            description: String::new(),
            metric: metric.to_string(),
            condition,
            severity: AlertSeverity::Warning,
            enabled: true,
            evaluation_period_sec: 60,
            for_duration_sec: 300,
            message: String::new(),
        }
    }

    pub fn with_severity(mut self, severity: AlertSeverity) -> Self {
        self.severity = severity;
        self
    }

    pub fn with_description(mut self, desc: &str) -> Self {
        self.description = desc.to_string();
        self
    }

    pub fn with_message(mut self, msg: &str) -> Self {
        self.message = msg.to_string();
        self
    }

    pub fn evaluate(&self, current_value: f64) -> bool {
        match self.condition {
            AlertCondition::GreaterThan(threshold) => current_value > threshold,
            AlertCondition::LessThan(threshold) => current_value < threshold,
            AlertCondition::BetweenRange(min, max) => current_value >= min && current_value <= max,
            AlertCondition::Equals(target) => (current_value - target).abs() < 0.01,
        }
    }
}

pub struct AlertManager {
    pub rules: HashMap<String, AlertRule>,
    pub active_alerts: Vec<AlertEvent>,
}

#[derive(Clone, Debug)]
pub struct AlertEvent {
    pub rule_name: String,
    pub metric_value: f64,
    pub triggered_at_ms: u64,
    pub severity: AlertSeverity,
}

impl AlertManager {
    pub fn new() -> Self {
        AlertManager {
            rules: HashMap::new(),
            active_alerts: Vec::new(),
        }
    }

    pub fn register_rule(&mut self, rule: AlertRule) {
        self.rules.insert(rule.name.clone(), rule);
    }

    pub fn evaluate(&mut self, metric: &str, value: f64) -> Vec<AlertEvent> {
        let mut triggered = Vec::new();

        for (_, rule) in self.rules.iter() {
            if !rule.enabled || rule.metric != metric {
                continue;
            }

            if rule.evaluate(value) {
                let alert = AlertEvent {
                    rule_name: rule.name.clone(),
                    metric_value: value,
                    triggered_at_ms: get_timestamp_ms(),
                    severity: rule.severity.clone(),
                };

                triggered.push(alert.clone());
                self.active_alerts.push(alert);
            }
        }

        triggered
    }

    pub fn get_active_alerts(&self) -> &Vec<AlertEvent> {
        &self.active_alerts
    }

    pub fn clear_alerts(&mut self) {
        self.active_alerts.clear();
    }
}

// 10가지 무관용 알림 규칙
pub struct UnforgivingAlertRules;

impl UnforgivingAlertRules {
    pub fn create_all() -> Vec<AlertRule> {
        vec![
            // Rule 1: 전력 초과 (Rule: > 250mW는 경고, > 300mW는 위험)
            AlertRule::new(
                "HighPowerConsumption",
                "green_fabric_power_instantaneous_mw",
                AlertCondition::GreaterThan(250.0),
            )
            .with_severity(AlertSeverity::Warning)
            .with_description("Power consumption exceeds normal operating range")
            .with_message("Instantaneous power consumption is {value}mW, exceeding threshold of 250mW"),

            // Rule 2: 배터리 부족 (< 20%)
            AlertRule::new(
                "LowBattery",
                "green_fabric_battery_level_percent",
                AlertCondition::LessThan(20.0),
            )
            .with_severity(AlertSeverity::Critical)
            .with_description("Battery level critically low")
            .with_message("Battery level is {value}%, below safe threshold of 20%"),

            // Rule 3: DVFS 지연 초과 (> 15ms)
            AlertRule::new(
                "HighDVFSLatency",
                "green_fabric_dvfs_transition_latency_us",
                AlertCondition::GreaterThan(15000.0),
            )
            .with_severity(AlertSeverity::Warning)
            .with_description("DVFS transition latency exceeds requirement")
            .with_message("DVFS transition took {value}us, exceeding 10ms requirement"),

            // Rule 4: 합의 지연 초과 (> 200ms)
            AlertRule::new(
                "HighConsensusLatency",
                "green_fabric_consensus_latency_ms",
                AlertCondition::GreaterThan(200.0),
            )
            .with_severity(AlertSeverity::Warning)
            .with_description("Consensus latency exceeds target")
            .with_message("Consensus latency is {value}ms, exceeding 150ms target"),

            // Rule 5: 패턴 인식 정확도 저하 (< 80%)
            AlertRule::new(
                "LowPatternAccuracy",
                "green_fabric_pattern_accuracy_percent",
                AlertCondition::LessThan(80.0),
            )
            .with_severity(AlertSeverity::Warning)
            .with_description("Pattern recognition accuracy below threshold")
            .with_message("Pattern accuracy is {value}%, below 85% target"),

            // Rule 6: 예측 오차 증가 (> 15%)
            AlertRule::new(
                "HighPredictionError",
                "green_fabric_prediction_error_percent",
                AlertCondition::GreaterThan(15.0),
            )
            .with_severity(AlertSeverity::Warning)
            .with_description("Energy prediction error exceeds tolerance")
            .with_message("Prediction error is {value}%, exceeding 10% tolerance"),

            // Rule 7: 클러스터 동기화 문제 (replicas < 2)
            AlertRule::new(
                "ClusterSyncIssue",
                "green_fabric_replicas_in_sync_count",
                AlertCondition::LessThan(2.0),
            )
            .with_severity(AlertSeverity::Critical)
            .with_description("Insufficient replicas in sync")
            .with_message("Only {value} replicas in sync, quorum compromised"),

            // Rule 8: 페일오버 지연 (> 100ms)
            AlertRule::new(
                "SlowFailover",
                "green_fabric_failover_latency_ms",
                AlertCondition::GreaterThan(100.0),
            )
            .with_severity(AlertSeverity::Warning)
            .with_description("Failover response time exceeds target")
            .with_message("Failover took {value}ms, exceeding 50ms target"),

            // Rule 9: Sleep 진입 지연 (> 10ms)
            AlertRule::new(
                "HighSleepLatency",
                "green_fabric_sleep_entry_latency_us",
                AlertCondition::GreaterThan(10000.0),
            )
            .with_severity(AlertSeverity::Info)
            .with_description("Sleep entry latency higher than optimal")
            .with_message("Sleep entry took {value}us, exceeding 5ms target"),

            // Rule 10: 학습 상태 정체 (state = 0 지속)
            AlertRule::new(
                "LearningStalled",
                "green_fabric_learning_state",
                AlertCondition::Equals(0.0),
            )
            .with_severity(AlertSeverity::Warning)
            .with_description("System learning not progressing")
            .with_message("Learning state is {value}, no progress from initialization"),
        ]
    }

    pub fn register_all(manager: &mut AlertManager) {
        for rule in Self::create_all() {
            manager.register_rule(rule);
        }
    }
}

pub fn get_timestamp_ms() -> u64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_default()
        .as_millis() as u64
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_alert_rule_creation() {
        let rule = AlertRule::new(
            "TestAlert",
            "test_metric",
            AlertCondition::GreaterThan(100.0),
        );

        assert_eq!(rule.name, "TestAlert");
        assert!(rule.enabled);
    }

    #[test]
    fn test_alert_condition_evaluation() {
        let rule = AlertRule::new(
            "HighValue",
            "metric",
            AlertCondition::GreaterThan(100.0),
        );

        assert!(rule.evaluate(150.0));
        assert!(!rule.evaluate(50.0));
    }

    #[test]
    fn test_alert_range_condition() {
        let rule = AlertRule::new(
            "InRange",
            "metric",
            AlertCondition::BetweenRange(50.0, 150.0),
        );

        assert!(rule.evaluate(100.0));
        assert!(!rule.evaluate(30.0));
        assert!(!rule.evaluate(200.0));
    }

    #[test]
    fn test_alert_manager() {
        let mut manager = AlertManager::new();

        let rule = AlertRule::new(
            "HighPower",
            "power",
            AlertCondition::GreaterThan(250.0),
        );

        manager.register_rule(rule);

        let triggered = manager.evaluate("power", 300.0);
        assert_eq!(triggered.len(), 1);
    }

    #[test]
    fn test_unforgiving_alert_rules() {
        let rules = UnforgivingAlertRules::create_all();
        assert_eq!(rules.len(), 10);

        for rule in rules {
            assert!(rule.enabled);
            assert!(!rule.name.is_empty());
        }
    }

    #[test]
    fn test_alert_manager_with_all_rules() {
        let mut manager = AlertManager::new();
        UnforgivingAlertRules::register_all(&mut manager);

        assert_eq!(manager.rules.len(), 10);
    }
}
