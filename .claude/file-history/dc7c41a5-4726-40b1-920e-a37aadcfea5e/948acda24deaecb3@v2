#[test]
fn test_workload_distribution_in_dataset() {
    // 데이터셋의 워크로드 분포 균형 검증
    let mut generator = TrainingDataGenerator::new();
    generator.generate(600);

    // verify_distribution 확인
    let is_balanced = generator.verify_distribution();
    assert!(is_balanced, "Workload distribution should be balanced");

    // 각 워크로드 타입별 샘플 수 확인
    let mut workload_counts = vec![0; 6];
    for sample in &generator.samples {
        let workload_idx = sample.features[0] as usize;
        if workload_idx < 6 {
            workload_counts[workload_idx] += 1;
        }
    }

    // 모든 타입이 충분히 대표되어야 함
    for count in &workload_counts {
        assert!(*count > 0, "All workload types should be represented");
    }
}

#[test]
fn test_convergence_with_different_learning_rates() {
    // 다양한 학습률에서의 수렴 검증
    let learning_rates = [0.001, 0.01, 0.1];

    for &lr in &learning_rates {
        let mut model = MLDVFSModel::new();
        let mut generator = TrainingDataGenerator::new();
        generator.generate(100);
        let (train_data, _) = generator.split(0.8);

        for sample in &train_data {
            model.add_training_example(sample.features, sample.target_frequency_mhz);
        }

        model.train(50, lr);

        let accuracy = model.get_accuracy();
        // 모든 학습률에서 일정 수준의 정확도 달성
        assert!(accuracy > 0.5, "Should achieve reasonable accuracy with lr={}", lr);
    }
}

