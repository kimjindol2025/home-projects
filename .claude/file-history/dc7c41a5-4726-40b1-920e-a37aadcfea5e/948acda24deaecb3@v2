#[test]
fn test_e2e_training_pipeline() {
    // 데이터 생성 → 모델 학습 → 정확도 검증
    let mut generator = TrainingDataGenerator::new();
    generator.generate(500);  // 500개 샘플 생성

    let (train_data, test_data) = generator.split(0.8);
    assert_eq!(train_data.len(), 400);
    assert_eq!(test_data.len(), 100);

    // 모델 학습
    let mut model = MLDVFSModel::new();
    for sample in &train_data {
        model.add_training_example(sample.features, sample.target_frequency_mhz);
    }

    model.train(50, 0.01);  // 50 epochs

    // 정확도 > 85% 확인
    let accuracy = model.get_accuracy();
    assert!(accuracy > 0.85, "Training accuracy should be > 85%, got {:.2}%", accuracy * 100.0);
}

#[test]
fn test_prediction_accuracy_on_test_set() {
    // 테스트 세트에서 예측 정확도 검증
    let mut generator = TrainingDataGenerator::new();
    generator.generate(300);

    let (train_data, test_data) = generator.split(0.8);

    let mut model = MLDVFSModel::new();
    for sample in &train_data {
        model.add_training_example(sample.features, sample.target_frequency_mhz);
    }

    model.train(100, 0.01);

    // 테스트 세트에서 예측
    let mut correct = 0;
    for sample in &test_data {
        let (predicted_freq, _confidence) = model.predict(&sample.features);
        let predicted_class = model.frequency_to_class(predicted_freq);
        let target_class = model.frequency_to_class(sample.target_frequency_mhz);

        if predicted_class == target_class {
            correct += 1;
        }
    }

    let test_accuracy = correct as f64 / test_data.len() as f64;
    assert!(test_accuracy > 0.80, "Test accuracy should be > 80%, got {:.2}%", test_accuracy * 100.0);
}

#[test]
fn test_inference_latency_requirement() {
    // DVFS Rule 3: 추론 지연 < 1ms (모델 크기 < 10KB)
    let model = MLDVFSModel::new();

    let latency = model.get_inference_latency();
    assert!(latency < 1000, "Inference latency must be < 1ms, got {} us", latency);

    let size = model.get_model_size();
    assert!(size < 10240, "Model size must be < 10KB, got {} bytes", size);
}

#[test]
fn test_feature_normalization_correctness() {
    // 특성 정규화가 올바르게 0-1 범위로 변환되는지 확인
    let normalizer = FeatureNormalizer::new();

    // 극단값 테스트
    let features_min = [0.0, 20.0, 40.0, -50.0, 1.0, 0.0];
    let normalized_min = normalizer.normalize(&features_min);

    for &val in &normalized_min {
        assert!(val >= 0.0 && val <= 1.0, "Normalized value must be in [0, 1], got {}", val);
    }

    // 극대값 테스트
    let features_max = [5.0, 100.0, 100.0, 50.0, 10000.0, 1.0];
    let normalized_max = normalizer.normalize(&features_max);

    for &val in &normalized_max {
        assert!(val >= 0.0 && val <= 1.0, "Normalized value must be in [0, 1], got {}", val);
    }
}

#[test]
fn test_frequency_mapping_coverage() {
    // 모든 주파수 레벨이 올바르게 매핑되는지 확인
    let model = MLDVFSModel::new();

    let frequencies = [800, 1200, 1600, 2000, 2400, 2800, 3200, 3600];
    for (idx, &freq) in frequencies.iter().enumerate() {
        let class = model.frequency_to_class(freq);
        assert_eq!(class, idx, "Frequency {} should map to class {}", freq, idx);

        let mapped_back = model.frequency_map[idx];
        assert_eq!(mapped_back, freq, "Frequency mapping should be reversible");
    }
}

