#[test]
fn test_fallback_policy_confidence_based() {
    // FallbackPolicy::UseMLIfConfident - 신뢰도 기반 폴백
    let mut dvfs = MLEnhancedDVFS::new();
    dvfs.fallback_policy = FallbackPolicy::UseMLIfConfident;
    dvfs.ml_confidence_threshold = 0.8;

    let mut generator = TrainingDataGenerator::new();
    generator.generate(100);
    let (train_data, _) = generator.split(0.8);

    for sample in &train_data {
        dvfs.ml_model.add_training_example(sample.features, sample.target_frequency_mhz);
    }

    dvfs.train(50);

    // 여러 입력으로 테스트하면 일부는 폴백될 수 있음
    for i in 0..10 {
        let features = [
            (i as f64) % 6.0,
            30.0 + ((i * 13) % 70) as f64,
            50.0 + ((i * 17) % 50) as f64,
            -30.0 + ((i * 19) % 60) as f64,
            100.0 + ((i * 23) % 9900) as f64,
            if i % 2 == 0 { 1.0 } else { 0.0 },
        ];

        let freq = dvfs.predict_frequency(&features);
        assert!(freq >= 800 && freq <= 3600);
    }
}

#[test]
fn test_battery_aware_training() {
    // 배터리 상태에 따른 주파수 조정 검증
    let mut generator = TrainingDataGenerator::new();
    generator.generate(200);

    // 배터리 낮은 샘플 추출 (< 30%)
    let low_battery_samples: Vec<_> = generator.samples.iter()
        .filter(|s| s.features[1] < 30.0)
        .collect();

    // 배터리 높은 샘플 추출 (> 80%)
    let high_battery_samples: Vec<_> = generator.samples.iter()
        .filter(|s| s.features[1] > 80.0)
        .collect();

    // 배터리 낮을 때 주파수가 더 낮아야 함
    if !low_battery_samples.is_empty() && !high_battery_samples.is_empty() {
        let avg_low_freq: f64 = low_battery_samples.iter()
            .map(|s| s.target_frequency_mhz as f64)
            .sum::<f64>() / low_battery_samples.len() as f64;

        let avg_high_freq: f64 = high_battery_samples.iter()
            .map(|s| s.target_frequency_mhz as f64)
            .sum::<f64>() / high_battery_samples.len() as f64;

        assert!(avg_low_freq <= avg_high_freq,
            "Low battery frequency ({}) should be <= high battery frequency ({})",
            avg_low_freq, avg_high_freq);
    }
}

#[test]
fn test_thermal_throttling_effect() {
    // 온도 높을 때 주파수 제한 검증
    let mut generator = TrainingDataGenerator::new();
    generator.generate(200);

    // 온도 낮은 샘플 (< 60°C)
    let cool_samples: Vec<_> = generator.samples.iter()
        .filter(|s| s.features[2] < 60.0)
        .collect();

    // 온도 높은 샘플 (> 85°C)
    let hot_samples: Vec<_> = generator.samples.iter()
        .filter(|s| s.features[2] > 85.0)
        .collect();

    // 온도 높을 때 주파수가 더 낮아야 함 (thermal throttling)
    if !cool_samples.is_empty() && !hot_samples.is_empty() {
        let max_cool_freq: u32 = cool_samples.iter()
            .map(|s| s.target_frequency_mhz)
            .max()
            .unwrap_or(0);

        let max_hot_freq: u32 = hot_samples.iter()
            .map(|s| s.target_frequency_mhz)
            .max()
            .unwrap_or(0);

        assert!(max_hot_freq <= max_cool_freq,
            "Hot temperature max frequency ({}) should be <= cool temperature ({})",
            max_hot_freq, max_cool_freq);
    }
}

#[test]
fn test_confidence_distribution() {
    // 모델 예측 신뢰도 분포 검증
    let mut model = MLDVFSModel::new();

    let mut generator = TrainingDataGenerator::new();
    generator.generate(100);
    let (train_data, test_data) = generator.split(0.8);

    for sample in &train_data {
        model.add_training_example(sample.features, sample.target_frequency_mhz);
    }

    model.train(50, 0.01);

    // 테스트 세트에서 신뢰도 수집
    let mut confidences = Vec::new();
    for sample in &test_data {
        let (_, confidence) = model.predict(&sample.features);
        confidences.push(confidence);
    }

    let avg_confidence: f64 = confidences.iter().sum::<f64>() / confidences.len() as f64;
    let max_confidence = confidences.iter().cloned().fold(0.0, f64::max);

    // 평균 신뢰도는 0.5 이상이어야 함
    assert!(avg_confidence >= 0.5, "Average confidence should be >= 0.5, got {:.2}", avg_confidence);
    // 최대 신뢰도는 1.0 이하
    assert!(max_confidence <= 1.0, "Max confidence should be <= 1.0, got {:.2}", max_confidence);
}

