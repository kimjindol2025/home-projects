// Phase 3: Spoofing Detection
// 타인의 공격을 탐지하는 생체 신호 무결성 검사

use crate::signals::*;

/// 스푸핑 위험 수준
#[derive(Clone, Debug, PartialEq)]
pub enum SpoofingRisk {
    Safe,       // 안전 (정상 신호)
    Low,        // 낮음 (약간의 이상)
    Medium,     // 중간 (의심 신호)
    High,       // 높음 (강한 의심)
    Critical,   // 위험 (공격 가능성 높음)
}

/// 스푸핑 탐지 결과
#[derive(Clone, Debug)]
pub struct SpoofingDetectionResult {
    pub risk_level: SpoofingRisk,
    pub liveness_score: f64,        // [0, 1]: 1 = 실시간 신호, 0 = 녹음/복제
    pub plausibility_score: f64,    // [0, 1]: 1 = 생리적으로 타당함
    pub overall_confidence: f64,    // [0, 1]: 공격 아닐 확률
    pub reasons: Vec<String>,       // 의심 이유 설명
}

/// 스푸핑 탐지기
#[derive(Clone, Debug)]
pub struct SpoofingDetector {
    pub liveness_threshold: f64,     // 기본값: 0.3 (0.3 이하 = 의심)
    pub plausibility_threshold: f64, // 기본값: 0.4 (0.4 이하 = 의심)
}

impl SpoofingDetector {
    pub fn new() -> Self {
        SpoofingDetector {
            liveness_threshold: 0.3,
            plausibility_threshold: 0.4,
        }
    }

    /// 키스트로크 동역학의 실시간성 검사
    /// 타이핑이 자연스럽게 변하는지 확인
    fn keystroke_liveness_check(&self, keystroke_signals: &[KeystrokeSignal]) -> f64 {
        if keystroke_signals.len() < 3 {
            return 0.5;  // 데이터 부족
        }

        // 시간차 변화율 분석 (flight_time의 표준편차)
        let flight_times: Vec<u64> = keystroke_signals
            .iter()
            .map(|k| k.flight_time)
            .collect();

        if flight_times.is_empty() {
            return 0.5;
        }

        let mean: f64 = flight_times.iter().map(|&t| t as f64).sum::<f64>()
            / flight_times.len() as f64;

        let variance: f64 = flight_times
            .iter()
            .map(|&t| {
                let diff = t as f64 - mean;
                diff * diff
            })
            .sum::<f64>()
            / flight_times.len() as f64;

        let std_dev = variance.sqrt();

        // 표준편차가 크면 = 자연스러운 타이핑 = 높은 생생함
        // 표준편차가 작으면 = 기계적 타이핑 = 의심 신호
        let liveness = (std_dev / (mean + 1.0)).min(1.0);  // [0, 1]

        // 압력의 변화도 확인
        let pressures: Vec<f64> = keystroke_signals
            .iter()
            .map(|k| k.pressure)
            .collect();

        if !pressures.is_empty() {
            let pressure_mean = pressures.iter().sum::<f64>() / pressures.len() as f64;
            let pressure_variance: f64 = pressures
                .iter()
                .map(|&p| {
                    let diff = p - pressure_mean;
                    diff * diff
                })
                .sum::<f64>()
                / pressures.len() as f64;

            let pressure_std_dev = pressure_variance.sqrt();
            let pressure_liveness = (pressure_std_dev * 2.0).min(1.0);

            return (liveness + pressure_liveness) / 2.0;
        }

        liveness
    }

    /// 심박수의 생리적 타당성 검사
    fn heart_rate_plausibility(&self, hr_signals: &[HeartRateSignal]) -> f64 {
        if hr_signals.is_empty() {
            return 0.5;
        }

        let mut plausibility = 1.0;

        // 1. 심박수가 생리적 범위인지 확인 (40~200 BPM)
        for signal in hr_signals {
            if signal.bpm < 40.0 || signal.bpm > 200.0 {
                plausibility -= 0.3;
            }
        }

        // 2. 심박수가 급격히 변하지 않는지 확인
        if hr_signals.len() >= 2 {
            for i in 1..hr_signals.len() {
                let bpm_change = (hr_signals[i].bpm - hr_signals[i - 1].bpm).abs();
                // 100ms 단위로 BPM이 10 이상 변하면 의심 (실제로 불가능)
                if bpm_change > 10.0 {
                    plausibility -= 0.1;
                }
            }
        }

        // 3. HRV (심박수 변이도)가 합리적인 범위인지 확인
        let avg_hrv: f64 = hr_signals.iter().map(|s| s.variability).sum::<f64>()
            / hr_signals.len() as f64;
        if avg_hrv < 0.2 || avg_hrv > 0.9 {
            plausibility -= 0.2;  // HRV가 너무 작거나 크면 의심
        }

        plausibility.max(0.0).min(1.0)
    }

    /// 터치 압력의 일관성 검사
    fn touch_pressure_consistency(&self, touch_signals: &[TouchSignal]) -> f64 {
        if touch_signals.len() < 2 {
            return 0.5;
        }

        let pressures: Vec<f64> = touch_signals.iter().map(|t| t.pressure).collect();
        let mean: f64 = pressures.iter().sum::<f64>() / pressures.len() as f64;

        // 표준편차가 너무 크면 = 일관성 없음 = 의심
        let variance: f64 = pressures
            .iter()
            .map(|&p| {
                let diff = p - mean;
                diff * diff
            })
            .sum::<f64>()
            / pressures.len() as f64;

        let std_dev = variance.sqrt();

        // CV (Coefficient of Variation) = std_dev / mean
        let cv = if mean > 0.0 { std_dev / mean } else { 0.5 };

        // CV가 작을수록 일관성 있음
        (1.0 - cv).max(0.0).min(1.0)
    }

    /// 전체 스푸핑 탐지 분석
    pub fn detect_spoofing(
        &self,
        keystroke_signals: &[KeystrokeSignal],
        touch_signals: &[TouchSignal],
        hr_signals: &[HeartRateSignal],
    ) -> SpoofingDetectionResult {
        let liveness_score = self.keystroke_liveness_check(keystroke_signals);
        let plausibility_score = self.heart_rate_plausibility(hr_signals);
        let consistency_score = self.touch_pressure_consistency(touch_signals);

        // 종합 신뢰도 = (생생함 + 타당성 + 일관성) / 3
        let overall_confidence = (liveness_score + plausibility_score + consistency_score) / 3.0;

        let mut reasons = Vec::new();

        // 위험 수준 결정
        let risk_level = if liveness_score < self.liveness_threshold {
            reasons.push(format!(
                "Low keystroke liveness ({})",
                (liveness_score * 100.0) as i32
            ));
            SpoofingRisk::High
        } else if plausibility_score < self.plausibility_threshold {
            reasons.push(format!(
                "Implausible heart rate pattern ({})",
                (plausibility_score * 100.0) as i32
            ));
            SpoofingRisk::High
        } else if consistency_score < 0.3 {
            reasons.push(format!(
                "Inconsistent touch pressure ({})",
                (consistency_score * 100.0) as i32
            ));
            SpoofingRisk::Medium
        } else if overall_confidence < 0.5 {
            reasons.push("Multiple minor anomalies detected".to_string());
            SpoofingRisk::Medium
        } else if overall_confidence < 0.7 {
            reasons.push("Slightly unusual biometric pattern".to_string());
            SpoofingRisk::Low
        } else {
            reasons.push("Biometric signals appear natural".to_string());
            SpoofingRisk::Safe
        };

        SpoofingDetectionResult {
            risk_level,
            liveness_score,
            plausibility_score: (plausibility_score + consistency_score) / 2.0,
            overall_confidence,
            reasons,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_detector_creation() {
        let detector = SpoofingDetector::new();
        assert_eq!(detector.liveness_threshold, 0.3);
        assert_eq!(detector.plausibility_threshold, 0.4);
    }

    #[test]
    fn test_natural_keystroke_liveness() {
        let detector = SpoofingDetector::new();

        // 자연스러운 타이핑: 비행 시간이 변함
        let keystrokes = vec![
            KeystrokeSignal {
                key: 'h',
                timestamp: 0,
                press_duration: 50,
                flight_time: 120,
                pressure: 0.7,
            },
            KeystrokeSignal {
                key: 'e',
                timestamp: 120,
                press_duration: 55,
                flight_time: 135,
                pressure: 0.72,
            },
            KeystrokeSignal {
                key: 'l',
                timestamp: 255,
                press_duration: 48,
                flight_time: 110,
                pressure: 0.68,
            },
            KeystrokeSignal {
                key: 'l',
                timestamp: 365,
                press_duration: 52,
                flight_time: 125,
                pressure: 0.71,
            },
        ];

        let liveness = detector.keystroke_liveness_check(&keystrokes);
        assert!(liveness > 0.4);  // 자연스러운 신호 = 높은 생생함
    }

    #[test]
    fn test_mechanical_keystroke_detection() {
        let detector = SpoofingDetector::new();

        // 기계적 타이핑: 모든 키 간격이 정확히 100ms
        let keystrokes = vec![
            KeystrokeSignal {
                key: 'a',
                timestamp: 0,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
            KeystrokeSignal {
                key: 'a',
                timestamp: 100,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
            KeystrokeSignal {
                key: 'a',
                timestamp: 200,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
        ];

        let liveness = detector.keystroke_liveness_check(&keystrokes);
        assert!(liveness < 0.3);  // 기계적 신호 = 낮은 생생함 = 의심
    }

    #[test]
    fn test_plausible_heart_rate() {
        let detector = SpoofingDetector::new();

        // 타당한 심박수: 70-75 BPM 범위
        let hr_signals = vec![
            HeartRateSignal {
                bpm: 72.0,
                timestamp: 0,
                variability: 0.5,
                confidence: 0.95,
            },
            HeartRateSignal {
                bpm: 73.0,
                timestamp: 1000,
                variability: 0.51,
                confidence: 0.95,
            },
            HeartRateSignal {
                bpm: 71.0,
                timestamp: 2000,
                variability: 0.49,
                confidence: 0.95,
            },
        ];

        let plausibility = detector.heart_rate_plausibility(&hr_signals);
        assert!(plausibility > 0.7);  // 생리적으로 타당함
    }

    #[test]
    fn test_implausible_heart_rate_jump() {
        let detector = SpoofingDetector::new();

        // 불가능한 심박수 변화: 60 → 150 BPM (90 증가)
        let hr_signals = vec![
            HeartRateSignal {
                bpm: 60.0,
                timestamp: 0,
                variability: 0.5,
                confidence: 0.95,
            },
            HeartRateSignal {
                bpm: 150.0,  // 너무 큰 변화
                timestamp: 1000,
                variability: 0.5,
                confidence: 0.95,
            },
        ];

        let plausibility = detector.heart_rate_plausibility(&hr_signals);
        assert!(plausibility < 0.6);  // 비타당함 = 의심
    }

    #[test]
    fn test_full_spoofing_detection_genuine() {
        let detector = SpoofingDetector::new();

        let keystrokes = vec![
            KeystrokeSignal {
                key: 'p',
                timestamp: 0,
                press_duration: 50,
                flight_time: 115,
                pressure: 0.71,
            },
            KeystrokeSignal {
                key: 'a',
                timestamp: 115,
                press_duration: 52,
                flight_time: 125,
                pressure: 0.72,
            },
            KeystrokeSignal {
                key: 's',
                timestamp: 240,
                press_duration: 51,
                flight_time: 120,
                pressure: 0.70,
            },
            KeystrokeSignal {
                key: 's',
                timestamp: 360,
                press_duration: 50,
                flight_time: 110,
                pressure: 0.71,
            },
        ];

        let touches = vec![
            TouchSignal {
                x: 100.0,
                y: 200.0,
                pressure: 0.65,
                timestamp: 0,
                duration: 80,
            },
            TouchSignal {
                x: 150.0,
                y: 220.0,
                pressure: 0.68,
                timestamp: 200,
                duration: 75,
            },
        ];

        let hr_signals = vec![
            HeartRateSignal {
                bpm: 72.0,
                timestamp: 0,
                variability: 0.5,
                confidence: 0.95,
            },
            HeartRateSignal {
                bpm: 73.0,
                timestamp: 1000,
                variability: 0.51,
                confidence: 0.95,
            },
        ];

        let result = detector.detect_spoofing(&keystrokes, &touches, &hr_signals);
        assert!(result.risk_level == SpoofingRisk::Safe || result.risk_level == SpoofingRisk::Low);
        assert!(result.overall_confidence > 0.6);
    }

    #[test]
    fn test_spoofing_risk_levels() {
        // 각 위험 수준이 올바르게 판정되는지 테스트
        let detector = SpoofingDetector::new();

        // 기계적 신호 (High Risk)
        let mechanical_keystrokes = vec![
            KeystrokeSignal {
                key: 'x',
                timestamp: 0,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
            KeystrokeSignal {
                key: 'x',
                timestamp: 100,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
            KeystrokeSignal {
                key: 'x',
                timestamp: 200,
                press_duration: 50,
                flight_time: 100,
                pressure: 0.7,
            },
        ];

        let result = detector.detect_spoofing(&mechanical_keystrokes, &[], &[]);
        println!("Spoofing Risk: {:?}", result.risk_level);
        println!("Confidence: {:.2}%", result.overall_confidence * 100.0);
        println!("Reasons: {:?}", result.reasons);
    }
}
