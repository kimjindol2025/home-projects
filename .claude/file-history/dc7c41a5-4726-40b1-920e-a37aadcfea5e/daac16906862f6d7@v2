#[test]
fn test_integration_all_rules_pass() {
    // Set all metrics to pass their rules
    let mut fabric = GreenDistributedFabric::new(3);

    // Rule 1: 40% savings
    fabric.metrics.baseline_power_mw = 250.0;
    fabric.metrics.current_avg_power_mw = 150.0;

    // Rule 2: 2× battery
    fabric.metrics.linux_battery_life_minutes = 288.0;
    fabric.metrics.current_estimated_life_minutes = 576.0;

    // Rule 3: DVFS < 10ms
    fabric.metrics.dvfs_response_time_us = 9_500;

    // Rule 4: Consensus < 150ms
    fabric.metrics.consensus_latency_ms = 100;

    // Rule 5: Sleep < 5ms
    fabric.metrics.sleep_entry_time_us = 4_500;

    // Rule 6: Accuracy >= 85%
    fabric.metrics.pattern_recognition_accuracy = 0.90;

    // Rule 7: Prediction error <= 10%
    fabric.metrics.energy_prediction_error_rate = 8.0;

    // Rule 8: Failover < 50ms
    fabric.metrics.failover_latency_ms = 40;

    assert!(fabric.metrics.all_rules_passed());
    assert_eq!(fabric.metrics.get_passed_rules_count(), 8);
}

#[test]
fn test_integration_rule_1_fails() {
    // All pass except Rule 1
    let mut fabric = GreenDistributedFabric::new(3);

    // Rule 1: Only 30% savings (below 40%)
    fabric.metrics.baseline_power_mw = 250.0;
    fabric.metrics.current_avg_power_mw = 175.0;

    // Others pass
    fabric.metrics.linux_battery_life_minutes = 288.0;
    fabric.metrics.current_estimated_life_minutes = 576.0;
    fabric.metrics.dvfs_response_time_us = 9_500;
    fabric.metrics.consensus_latency_ms = 100;
    fabric.metrics.sleep_entry_time_us = 4_500;
    fabric.metrics.pattern_recognition_accuracy = 0.90;
    fabric.metrics.energy_prediction_error_rate = 8.0;
    fabric.metrics.failover_latency_ms = 40;

    assert!(!fabric.metrics.all_rules_passed());
    assert_eq!(fabric.metrics.get_passed_rules_count(), 7);
}

#[test]
fn test_integration_multiple_failures() {
    // Multiple rules fail
    let mut fabric = GreenDistributedFabric::new(3);

    // Rule 1: Fails (30% savings)
    fabric.metrics.baseline_power_mw = 250.0;
    fabric.metrics.current_avg_power_mw = 175.0;

    // Rule 2: Fails (1.5× instead of 2×)
    fabric.metrics.linux_battery_life_minutes = 288.0;
    fabric.metrics.current_estimated_life_minutes = 432.0;

    // Rule 3: Passes
    fabric.metrics.dvfs_response_time_us = 9_500;

    // Rule 4: Fails (200ms > 150ms)
    fabric.metrics.consensus_latency_ms = 200;

    // Rule 5: Passes
    fabric.metrics.sleep_entry_time_us = 4_500;

    // Rule 6: Passes
    fabric.metrics.pattern_recognition_accuracy = 0.90;

    // Rule 7: Fails (15% error)
    fabric.metrics.energy_prediction_error_rate = 15.0;

    // Rule 8: Passes
    fabric.metrics.failover_latency_ms = 40;

    assert!(!fabric.metrics.all_rules_passed());
    assert_eq!(fabric.metrics.get_passed_rules_count(), 4);
}

#[test]
fn test_integration_fabric_tick_updates_metrics() {
    // Verify that a fabric tick updates metrics
    let mut fabric = GreenDistributedFabric::new(3);
    let initial_ticks = fabric.metrics.total_ticks;

    // Set reasonable values for tick to succeed
    fabric.metrics.baseline_power_mw = 250.0;
    fabric.metrics.current_avg_power_mw = 150.0;
    fabric.metrics.linux_battery_life_minutes = 288.0;
    fabric.metrics.current_estimated_life_minutes = 576.0;
    fabric.metrics.dvfs_response_time_us = 9_500;
    fabric.metrics.consensus_latency_ms = 100;
    fabric.metrics.sleep_entry_time_us = 4_500;
    fabric.metrics.energy_prediction_error_rate = 8.0;
    fabric.metrics.failover_latency_ms = 40;

    let _result = fabric.tick();

    assert!(fabric.metrics.total_ticks > initial_ticks);
    assert!(fabric.metrics.samples_collected > 0);
}

