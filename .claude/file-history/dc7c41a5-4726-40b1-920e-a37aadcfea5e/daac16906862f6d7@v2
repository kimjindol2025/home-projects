#[test]
fn test_rule_1_power_savings_baseline_detection() {
    // Verify baseline power is correctly recorded at 250mW
    let mut fabric = GreenDistributedFabric::new(3);
    fabric.metrics.baseline_power_mw = 250.0;
    fabric.metrics.current_avg_power_mw = 250.0;

    // Should be 0% savings at baseline
    assert_eq!(fabric.metrics.verify_rule_1_power_savings(), false);
}

#[test]
fn test_rule_1_power_savings_target_met() {
    // Verify 40% savings: 250mW * (1 - 0.4) = 150mW
    let mut fabric = GreenDistributedFabric::new(3);
    fabric.metrics.baseline_power_mw = 250.0;
    fabric.metrics.current_avg_power_mw = 150.0;

    assert!(fabric.metrics.verify_rule_1_power_savings());
    let savings = ((250.0 - 150.0) / 250.0) * 100.0;
    assert!(savings >= 40.0);
}

#[test]
fn test_rule_1_power_savings_exceeds_target() {
    // Verify >40% savings: 250mW -> 100mW = 60%
    let mut fabric = GreenDistributedFabric::new(3);
    fabric.metrics.baseline_power_mw = 250.0;
    fabric.metrics.current_avg_power_mw = 100.0;

    assert!(fabric.metrics.verify_rule_1_power_savings());
}

#[test]
fn test_rule_2_battery_life_baseline() {
    // Baseline: 4.8 hours = 288 minutes (no improvement)
    let mut fabric = GreenDistributedFabric::new(3);
    fabric.metrics.linux_battery_life_minutes = 288.0;
    fabric.metrics.current_estimated_life_minutes = 288.0;

    // Should fail: needs 2x improvement
    assert_eq!(fabric.metrics.verify_rule_2_battery_life(), false);
}

#[test]
fn test_rule_2_battery_life_2x_improvement() {
    // Target: 2x battery life (4.8h -> 9.6h)
    let mut fabric = GreenDistributedFabric::new(3);
    fabric.metrics.linux_battery_life_minutes = 288.0;  // 4.8h
    fabric.metrics.current_estimated_life_minutes = 576.0;  // 9.6h

    assert!(fabric.metrics.verify_rule_2_battery_life());
    assert_eq!(576.0 / 288.0, 2.0);
}

