// Phase 5: Hardware Secure Storage
// HSM/TEE 기반 마스터 시크릿 보호 저장소

use crate::crypto::*;

#[derive(Clone, Debug, PartialEq)]
pub enum SecureEnclaveType {
    SoftwareSim,      // 테스트용 소프트웨어 시뮬레이션
    TrustZone,        // ARM TrustZone
    SecureElement,    // NFC 보안 요소
    HSM,              // Hardware Security Module
}

#[derive(Clone, Debug)]
pub struct AttestedKey {
    pub key_bytes: Vec<u8>,
    pub attestation: Vec<u8>,  // HW 서명
    pub created_at: u64,
    pub device_id: String,
}

#[derive(Clone, Debug)]
pub struct HwSecureStorage {
    enclave_type: SecureEnclaveType,
    enclave_id: String,
    master_secrets: std::collections::HashMap<String, Vec<u8>>,  // user_id -> encrypted_secret
    attestations: std::collections::HashMap<String, Vec<u8>>,     // user_id -> hw_signature
    tamper_counters: std::collections::HashMap<String, u32>,      // user_id -> access_count
}

impl HwSecureStorage {
    pub fn new(enclave_type: SecureEnclaveType) -> Self {
        HwSecureStorage {
            enclave_type,
            enclave_id: format!("enclave_{}", sha256(b"hw_secure_storage").to_hex()[..16].to_string()),
            master_secrets: std::collections::HashMap::new(),
            attestations: std::collections::HashMap::new(),
            tamper_counters: std::collections::HashMap::new(),
        }
    }

    /// 마스터 시크릿을 보안 저장소에 저장 (암호화됨)
    pub fn store_master_secret(&mut self, user_id: &str, secret: &[u8]) -> Result<String, String> {
        if user_id.is_empty() || secret.is_empty() {
            return Err("Invalid user_id or secret".to_string());
        }

        if secret.len() != 32 {
            return Err("Secret must be 32 bytes".to_string());
        }

        // 저장소 암호화 키 생성 (HW 시드 기반)
        let storage_key =
            hmac_sha256(self.enclave_id.as_bytes(), b"storage_key_material").bytes.to_vec();

        // 시크릿 암호화 (XOR 기반 간단 암호화)
        let encrypted = xor_cipher(secret, &storage_key);

        // HW 서명 생성 (시뮬레이션)
        let attestation_input = format!("{}{:?}", user_id, encrypted);
        let hw_signature = sha256(attestation_input.as_bytes()).bytes.to_vec();

        self.master_secrets.insert(user_id.to_string(), encrypted);
        self.attestations.insert(user_id.to_string(), hw_signature);
        self.tamper_counters.insert(user_id.to_string(), 0);

        let storage_id = sha256(format!("{}{}", user_id, self.enclave_id).as_bytes()).to_hex()[..16].to_string();
        Ok(storage_id)
    }

    /// 마스터 시크릿 복구 (올바른 토큰 필요)
    pub fn retrieve_master_secret(
        &mut self,
        user_id: &str,
        auth_token: &[u8],
    ) -> Result<Vec<u8>, String> {
        let encrypted = self
            .master_secrets
            .get(user_id)
            .ok_or("Secret not found".to_string())?;

        // 인증 토큰 검증 (user_id + enclave_id 기반)
        let expected_token = hmac_sha256(
            format!("{}{}", user_id, self.enclave_id).as_bytes(),
            b"retrieve_token",
        );

        let token_match = hmac_sha256(auth_token, b"token_verify").bytes
            == expected_token.bytes;

        if !token_match {
            // 실패 카운트 증가
            let counter = self.tamper_counters.get_mut(user_id).unwrap();
            *counter += 1;

            if *counter >= 3 {
                // 너무 많은 실패 시도
                return Err("Too many failed attempts. Secret locked.".to_string());
            }

            return Err("Authentication token invalid".to_string());
        }

        // 저장소 암호화 키 복구
        let storage_key =
            hmac_sha256(self.enclave_id.as_bytes(), b"storage_key_material").bytes.to_vec();

        // 시크릿 복호화
        let decrypted = xor_cipher(encrypted, &storage_key);

        // 복호화된 길이 검증
        if decrypted.len() != 32 {
            return Err("Decrypted secret size mismatch".to_string());
        }

        Ok(decrypted)
    }

    /// HW 서명 생성 (공개 인증용)
    pub fn attest_key(&self, key: &[u8]) -> AttestedKey {
        let attestation_data = format!("{}{:?}", self.enclave_id, key);
        let signature = sha256(attestation_data.as_bytes()).bytes.to_vec();

        AttestedKey {
            key_bytes: key.to_vec(),
            attestation: signature,
            created_at: 1704067200,
            device_id: self.enclave_id.clone(),
        }
    }

    /// 변조 감지 (저장된 서명과 현재 시크릿 서명 비교)
    pub fn is_tampered(&self, user_id: &str, current_secret: &[u8]) -> bool {
        let encrypted = match self.master_secrets.get(user_id) {
            Some(e) => e,
            None => return true,
        };

        let stored_sig = match self.attestations.get(user_id) {
            Some(s) => s,
            None => return true,
        };

        let current_sig_input = format!("{}{:?}", user_id, encrypted);
        let current_sig = sha256(current_sig_input.as_bytes()).bytes.to_vec();

        stored_sig != &current_sig
    }

    /// 저장소 통계
    pub fn get_stats(&self) -> (usize, String) {
        (
            self.master_secrets.len(),
            format!("{:?}", self.enclave_type),
        )
    }

    /// 강제 토큰 생성 (테스트용)
    pub fn generate_auth_token(&self, user_id: &str) -> Vec<u8> {
        hmac_sha256(
            format!("{}{}", user_id, self.enclave_id).as_bytes(),
            b"retrieve_token",
        )
        .bytes
        .to_vec()
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_hw_storage_creation() {
        let storage = HwSecureStorage::new(SecureEnclaveType::SoftwareSim);
        assert_eq!(storage.enclave_type, SecureEnclaveType::SoftwareSim);
    }

    #[test]
    fn test_store_master_secret() {
        let mut storage = HwSecureStorage::new(SecureEnclaveType::TrustZone);
        let secret = [42u8; 32].to_vec();

        let result = storage.store_master_secret("user001", &secret);
        assert!(result.is_ok());
    }

    #[test]
    fn test_store_invalid_secret_size() {
        let mut storage = HwSecureStorage::new(SecureEnclaveType::SoftwareSim);
        let secret = [42u8; 16].to_vec(); // Invalid size

        let result = storage.store_master_secret("user001", &secret);
        assert!(result.is_err());
    }

    #[test]
    fn test_retrieve_with_valid_token() {
        let mut storage = HwSecureStorage::new(SecureEnclaveType::SoftwareSim);
        let secret = [42u8; 32].to_vec();

        storage.store_master_secret("user001", &secret).unwrap();
        let token = storage.generate_auth_token("user001");

        let result = storage.retrieve_master_secret("user001", &token);
        assert!(result.is_ok());
        assert_eq!(result.unwrap(), secret);
    }

    #[test]
    fn test_retrieve_with_invalid_token() {
        let mut storage = HwSecureStorage::new(SecureEnclaveType::SoftwareSim);
        let secret = [42u8; 32].to_vec();
        let wrong_token = [99u8; 32].to_vec();

        storage.store_master_secret("user001", &secret).unwrap();
        let result = storage.retrieve_master_secret("user001", &wrong_token);
        assert!(result.is_err());
    }

    #[test]
    fn test_attest_key() {
        let storage = HwSecureStorage::new(SecureEnclaveType::HSM);
        let key = [123u8; 32].to_vec();

        let attested = storage.attest_key(&key);
        assert_eq!(attested.key_bytes, key);
        assert!(!attested.attestation.is_empty());
    }

    #[test]
    fn test_is_tampered_detection() {
        let mut storage = HwSecureStorage::new(SecureEnclaveType::SoftwareSim);
        let secret = [42u8; 32].to_vec();

        storage.store_master_secret("user001", &secret).unwrap();

        // 정상 상태: 저장된 시크릿으로 확인
        let encrypted_in_storage = storage.master_secrets.get("user001").unwrap();
        assert!(!storage.is_tampered("user001", encrypted_in_storage));
    }
}
