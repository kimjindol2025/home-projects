#[test]
fn test_integration_cluster_sleep_agreement() {
    // Test: Clustering and Sleep recommendations agree on idle states
    // Expected: agreement_percent >= 85%
    let idle_patterns = vec!["IdleStates", "Idle", "Idle", "Idle", "IdleStates"];
    let sleep_recommendations = vec!["C3", "C3", "C3", "C2", "C3"];
    let agreements = idle_patterns.iter()
        .zip(sleep_recommendations.iter())
        .filter(|(pattern, sleep)| {
            pattern.contains("Idle") && (sleep.contains("C3") || sleep.contains("C2"))
        })
        .count();

    let agreement_percent = (agreements as f64 / idle_patterns.len() as f64) * 100.0;
    assert!(agreement_percent >= 80.0);
}

