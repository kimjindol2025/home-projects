#[test]
fn test_clustering_euclidean_distance() {
    // Test: Euclidean distance metric normalized
    // Expected: distance >= 0.0 and <= sqrt(6.0)
    let f1_powers = vec![100.0; 6];
    let f2_powers = vec![110.0; 6];
    let sum_sq: f64 = f1_powers.iter()
        .zip(f2_powers.iter())
        .map(|(a, b)| ((a - b) / 200.0).powi(2))
        .sum();
    let distance = sum_sq.sqrt();

    assert!(distance >= 0.0 && distance <= 2.5);
}

