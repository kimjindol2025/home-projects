// Phase 4: Cryptographic Functions
// SHA-256, HMAC-SHA256 구현

/// 바이트 단위 데이터
pub type Bytes = Vec<u8>;

/// SHA-256 해시 결과 (32바이트 = 256비트)
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct Sha256Hash {
    pub bytes: [u8; 32],
}

impl Sha256Hash {
    /// 16진수 문자열로 표현
    pub fn to_hex(&self) -> String {
        self.bytes
            .iter()
            .map(|b| format!("{:02x}", b))
            .collect::<Vec<_>>()
            .join("")
    }

    /// 16진수 문자열로부터 파싱
    pub fn from_hex(hex: &str) -> Option<Self> {
        if hex.len() != 64 {
            return None;
        }

        let mut bytes = [0u8; 32];
        for i in 0..32 {
            let byte_str = &hex[i * 2..i * 2 + 2];
            bytes[i] = u8::from_str_radix(byte_str, 16).ok()?;
        }

        Some(Sha256Hash { bytes })
    }

    /// 바이트 배열 반환
    pub fn as_bytes(&self) -> &[u8; 32] {
        &self.bytes
    }
}

/// SHA-256 해시 함수 (간단한 구현)
/// 주의: 프로덕션에서는 실제 암호 라이브러리 사용
pub fn sha256(data: &[u8]) -> Sha256Hash {
    // 실제 구현: SHA-256 알고리즘
    // 여기서는 시뮬레이션
    let mut hash = [0u8; 32];

    // 간단한 해시 시뮬레이션: 데이터의 바이트를 섞어서 32바이트 생성
    for (i, &byte) in data.iter().enumerate() {
        hash[i % 32] ^= byte.wrapping_add(i as u8);
    }

    // 데이터 길이도 반영
    let len = data.len() as u64;
    for i in 0..8 {
        hash[24 + i] ^= ((len >> (i * 8)) & 0xFF) as u8;
    }

    // 추가 혼합: 여러 번 순환
    for round in 0..3 {
        for i in 0..32 {
            hash[i] = hash[i]
                .wrapping_mul(31)
                .wrapping_add(hash[(i + 1) % 32])
                .wrapping_add(round as u8);
        }
    }

    Sha256Hash { bytes: hash }
}

/// HMAC-SHA256 (Hash-based Message Authentication Code)
/// 비밀 키와 메시지로부터 인증 코드 생성
pub fn hmac_sha256(key: &[u8], message: &[u8]) -> Sha256Hash {
    let block_size = 64;  // SHA-256 블록 크기

    // 키를 블록 크기로 정규화
    let mut key_padded = vec![0u8; block_size];
    if key.len() > block_size {
        let key_hash = sha256(key);
        key_padded[..32].copy_from_slice(&key_hash.bytes);
    } else {
        key_padded[..key.len()].copy_from_slice(key);
    }

    // ipad (0x36) 와 opad (0x5c)
    let mut ipad = vec![0x36u8; block_size];
    let mut opad = vec![0x5cu8; block_size];

    for i in 0..block_size {
        ipad[i] ^= key_padded[i];
        opad[i] ^= key_padded[i];
    }

    // HMAC = H(opad || H(ipad || message))
    let mut inner_input = ipad.clone();
    inner_input.extend_from_slice(message);
    let inner_hash = sha256(&inner_input);

    let mut outer_input = opad.clone();
    outer_input.extend_from_slice(&inner_hash.bytes);
    sha256(&outer_input)
}

/// 바이트 배열을 16진수 문자열로 변환
pub fn bytes_to_hex(bytes: &[u8]) -> String {
    bytes
        .iter()
        .map(|b| format!("{:02x}", b))
        .collect::<Vec<_>>()
        .join("")
}

/// 16진수 문자열을 바이트 배열로 변환
pub fn hex_to_bytes(hex: &str) -> Option<Vec<u8>> {
    if hex.len() % 2 != 0 {
        return None;
    }

    let mut bytes = Vec::new();
    for i in (0..hex.len()).step_by(2) {
        let byte_str = &hex[i..i + 2];
        bytes.push(u8::from_str_radix(byte_str, 16).ok()?);
    }

    Some(bytes)
}

/// XOR 연산 (간단한 대칭 암호)
pub fn xor_cipher(data: &[u8], key: &[u8]) -> Vec<u8> {
    data.iter()
        .enumerate()
        .map(|(i, &byte)| byte ^ key[i % key.len()])
        .collect()
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_sha256_creation() {
        let hash = sha256(b"hello world");
        assert_eq!(hash.bytes.len(), 32);
    }

    #[test]
    fn test_sha256_deterministic() {
        let hash1 = sha256(b"test data");
        let hash2 = sha256(b"test data");
        assert_eq!(hash1, hash2);
    }

    #[test]
    fn test_sha256_different_inputs() {
        let hash1 = sha256(b"data1");
        let hash2 = sha256(b"data2");
        assert_ne!(hash1, hash2);
    }

    #[test]
    fn test_sha256_to_hex() {
        let hash = sha256(b"test");
        let hex = hash.to_hex();
        assert_eq!(hex.len(), 64);  // 32 bytes = 64 hex chars
        assert!(hex.chars().all(|c| c.is_ascii_hexdigit()));
    }

    #[test]
    fn test_sha256_from_hex() {
        let hash = sha256(b"data");
        let hex = hash.to_hex();
        let parsed = Sha256Hash::from_hex(&hex);
        assert!(parsed.is_some());
        assert_eq!(parsed.unwrap(), hash);
    }

    #[test]
    fn test_hmac_sha256_deterministic() {
        let key = b"secret_key";
        let message = b"hello world";

        let hmac1 = hmac_sha256(key, message);
        let hmac2 = hmac_sha256(key, message);

        assert_eq!(hmac1, hmac2);
    }

    #[test]
    fn test_hmac_sha256_different_keys() {
        let message = b"same message";

        let hmac1 = hmac_sha256(b"key1", message);
        let hmac2 = hmac_sha256(b"key2", message);

        assert_ne!(hmac1, hmac2);
    }

    #[test]
    fn test_hmac_sha256_different_messages() {
        let key = b"same_key";

        let hmac1 = hmac_sha256(key, b"message1");
        let hmac2 = hmac_sha256(key, b"message2");

        assert_ne!(hmac1, hmac2);
    }

    #[test]
    fn test_bytes_to_hex() {
        let bytes = vec![0xFF, 0x00, 0xAB, 0xCD];
        let hex = bytes_to_hex(&bytes);
        assert_eq!(hex, "ff00abcd");
    }

    #[test]
    fn test_hex_to_bytes() {
        let hex = "ff00abcd";
        let bytes = hex_to_bytes(hex);
        assert!(bytes.is_some());
        assert_eq!(bytes.unwrap(), vec![0xFF, 0x00, 0xAB, 0xCD]);
    }

    #[test]
    fn test_xor_cipher() {
        let data = b"hello";
        let key = b"key";

        let encrypted = xor_cipher(data, key);
        let decrypted = xor_cipher(&encrypted, key);

        assert_eq!(decrypted, data.to_vec());
    }

    #[test]
    fn test_xor_cipher_deterministic() {
        let data = b"test";
        let key = b"secret";

        let enc1 = xor_cipher(data, key);
        let enc2 = xor_cipher(data, key);

        assert_eq!(enc1, enc2);
    }

    #[test]
    fn test_hash_avalanche_effect() {
        // 작은 변화가 큰 해시 변화를 만들어야 함
        let hash1 = sha256(b"message");
        let hash2 = sha256(b"messagu");  // 'g' → 'u'

        let diff_count = hash1
            .bytes
            .iter()
            .zip(hash2.bytes.iter())
            .filter(|(a, b)| a != b)
            .count();

        assert!(diff_count > 10);  // 최소 10개 바이트가 다름
    }
}
