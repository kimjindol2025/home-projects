#[test]
fn test_subkey_derivation() {
    let gen = DynamicKeyGenerator::new("user001".to_string());

    let purposes = vec!["encryption", "authentication", "integrity"];
    let result = gen.derive_subkeys_for_purposes(
        &AuthenticationDecision::Accept,
        0.95,
        "model_hash",
        &purposes,
    );

    assert!(result.is_ok());
    let subkeys = result.unwrap();
    assert_eq!(subkeys.len(), 3);

    // 모든 하위키가 고유해야 함
    for i in 0..subkeys.len() {
        for j in i + 1..subkeys.len() {
            assert_ne!(subkeys[i].1, subkeys[j].1);
        }
    }

    println!("✅ Subkey Derivation: {} unique keys for different purposes", subkeys.len());
}

