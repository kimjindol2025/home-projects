#[test]
fn test_shannon_entropy_calculation() {
    // 균등 분포
    let uniform: Vec<u8> = (0..=255).collect();
    let entropy = key_entropy_validator::calculate_shannon_entropy(&uniform);

    assert!(entropy > 2000.0);  // 256 bytes * 8 bits ≈ 2048

    // 편향된 분포
    let biased = vec![0u8; 256];
    let entropy_biased = key_entropy_validator::calculate_shannon_entropy(&biased);

    assert_eq!(entropy_biased, 0.0);

    println!(
        "✅ Shannon Entropy: uniform={:.0} bits, biased={:.0} bits",
        entropy, entropy_biased
    );
}

#[test]
fn test_entropy_analysis() {
    let mut data = Vec::new();
    for i in 0..512 {
        data.push((i % 256) as u8);
    }

    let analysis = analyze_entropy(&data);

    println!("Entropy: {:.1} bits", analysis.entropy_bits);
    println!("Min Entropy: {:.1} bits", analysis.min_entropy);
    println!("Unique Bytes: {}/256", analysis.unique_bytes);

    assert!(analysis.entropy_bits > 0.0);
    assert!(analysis.unique_bytes <= 256);
}

