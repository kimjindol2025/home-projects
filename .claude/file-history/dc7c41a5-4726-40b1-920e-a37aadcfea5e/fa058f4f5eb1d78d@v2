// 무관용 규칙 (Unforgiving Rules)
// ============================================================================

#[cfg(test)]
mod unforgiving_rules {
    use super::*;

    #[test]
    fn rule_1_entropy_nist_128_bit() {
        // Rule 1: 생성된 키의 엔트로피 >= 128 bits (NIST 최소 요구사항)
        let gen = DynamicKeyGenerator::new("user_entropy_001".to_string());

        let key = gen
            .generate_key_on_authentication(&AuthenticationDecision::Accept, 0.95, "model_hash")
            .unwrap();

        assert!(key.entropy_bits >= 128.0);
        assert!(key.is_valid);

        println!(
            "✅ RULE 1 PASS: Key Entropy >= 128 bits (actual: {:.1} bits)",
            key.entropy_bits
        );
    }

    #[test]
    fn rule_2_key_derivation_deterministic() {
        // Rule 2: 키 유도가 결정적이어야 함 (동일 입력 → 동일 출력)
        let gen = DynamicKeyGenerator::new("user_determinism_001".to_string());

        let key1 = gen
            .generate_key_on_authentication(&AuthenticationDecision::Accept, 0.95, "model_abc")
            .unwrap();
        let key2 = gen
            .generate_key_on_authentication(&AuthenticationDecision::Accept, 0.95, "model_abc")
            .unwrap();

        assert_eq!(key1.generation_key, key2.generation_key);

        println!("✅ RULE 2 PASS: Key Derivation Deterministic ({}...)",
            &key1.to_hex()[..16]);
    }

    #[test]
    fn rule_3_template_encryption_roundtrip() {
        // Rule 3: 템플릿 암호화/복호화 라운드트립 성공
        let gen = DynamicKeyGenerator::new("user_crypto_001".to_string());

        let plaintext = PlaintextTemplate::new(b"neural_network_model_weights".to_vec());

        let encrypted = gen
            .encrypt_user_template(
                &plaintext,
                &AuthenticationDecision::Accept,
                0.95,
                "model_hash",
            )
            .unwrap();

        let decrypted = gen
            .decrypt_user_template(
                &encrypted,
                &AuthenticationDecision::Accept,
                0.95,
                "model_hash",
            )
            .unwrap();

        assert_eq!(decrypted.data, plaintext.data);

        println!("✅ RULE 3 PASS: Template Roundtrip Success (encrypt → decrypt)");
    }

    #[test]
    fn rule_4_different_users_different_keys() {
        // Rule 4: 다른 사용자 → 다른 키
        let user1 = DynamicKeyGenerator::new("alice".to_string());
        let user2 = DynamicKeyGenerator::new("bob".to_string());
        let user3 = DynamicKeyGenerator::new("charlie".to_string());

        let key1 = user1
            .generate_key_on_authentication(&AuthenticationDecision::Accept, 0.95, "model")
            .unwrap();
        let key2 = user2
            .generate_key_on_authentication(&AuthenticationDecision::Accept, 0.95, "model")
            .unwrap();
        let key3 = user3
            .generate_key_on_authentication(&AuthenticationDecision::Accept, 0.95, "model")
            .unwrap();

        // 모든 키가 다를 것
        assert_ne!(key1.generation_key, key2.generation_key);
        assert_ne!(key2.generation_key, key3.generation_key);
        assert_ne!(key1.generation_key, key3.generation_key);

        println!("✅ RULE 4 PASS: User-Specific Keys (3 users = 3 different keys)");
    }
}

