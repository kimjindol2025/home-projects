#[test]
fn test_template_encryption() {
    let plaintext = PlaintextTemplate::new(b"neural_network_weights".to_vec());
    let key = b"encryption_key_32_bytes_long!!";

    let encrypted = encrypt_template(&plaintext, key);

    assert!(!encrypted.ciphertext.is_empty());
    assert_eq!(encrypted.iv.len(), 16);
    assert_eq!(encrypted.tag.len(), 16);

    println!(
        "✅ Template Encryption: {} → {} bytes",
        plaintext.size_bytes(),
        encrypted.size_bytes()
    );
}

#[test]
fn test_template_roundtrip() {
    let plaintext = PlaintextTemplate::new(b"secret_model".to_vec());
    let key = b"key";

    let encrypted = encrypt_template(&plaintext, key);
    let decrypted = decrypt_template(&encrypted, key).unwrap();

    assert_eq!(decrypted.data, plaintext.data);

    println!("✅ Template Roundtrip: encrypt → decrypt = original");
}

#[test]
fn test_template_authentication_tag() {
    let plaintext = PlaintextTemplate::new(b"data".to_vec());
    let key = b"key";

    let mut encrypted = encrypt_template(&plaintext, key);

    // 태그를 변조
    encrypted.tag[0] ^= 0xFF;

    let result = decrypt_template(&encrypted, key);
    assert!(result.is_err());

    println!("✅ Authentication Tag: detects tampering");
}

#[test]
fn test_different_keys_produce_different_ciphertext() {
    let plaintext = PlaintextTemplate::new(b"data".to_vec());

    let enc1 = encrypt_template(&plaintext, b"key1");
    let enc2 = encrypt_template(&plaintext, b"key2");

    assert_ne!(enc1.ciphertext, enc2.ciphertext);

    println!("✅ Encryption: different keys → different ciphertexts");
}

