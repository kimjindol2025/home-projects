#[test]
fn test_sha256_hash() {
    let hash1 = sha256(b"test data");
    let hash2 = sha256(b"test data");

    assert_eq!(hash1.bytes.len(), 32);
    assert_eq!(hash1, hash2);  // 결정적

    println!("✅ SHA256: {}", hash1.to_hex()[..16].to_string() + "...");
}

#[test]
fn test_sha256_avalanche() {
    let hash1 = sha256(b"message");
    let hash2 = sha256(b"messagu");  // 1비트 변화

    let diff_count = hash1
        .bytes
        .iter()
        .zip(hash2.bytes.iter())
        .filter(|(a, b)| a != b)
        .count();

    assert!(diff_count > 10);  // 눈사태 효과

    println!(
        "✅ Avalanche Effect: {} bytes differ (should be > 10)",
        diff_count
    );
}

#[test]
fn test_hmac_sha256() {
    let hmac1 = hmac_sha256(b"key", b"message");
    let hmac2 = hmac_sha256(b"key", b"message");

    assert_eq!(hmac1, hmac2);

    let hmac3 = hmac_sha256(b"different_key", b"message");
    assert_ne!(hmac1, hmac3);

    println!("✅ HMAC-SHA256: deterministic and key-dependent");
}

#[test]
fn test_hex_conversion() {
    let data = vec![0xFF, 0x00, 0xAB, 0xCD];
    let hex = bytes_to_hex(&data);
    assert_eq!(hex, "ff00abcd");

    let decoded = hex_to_bytes(&hex).unwrap();
    assert_eq!(decoded, data);

    println!("✅ Hex Conversion: {} → {}", hex, "ff00abcd");
}

