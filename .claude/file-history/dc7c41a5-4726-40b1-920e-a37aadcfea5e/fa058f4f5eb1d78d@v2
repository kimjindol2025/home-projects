#[test]
fn test_key_stretching() {
    let weak = b"weak_password";

    let strong1 = key_stretching::stretch_key(weak, 100);
    let strong2 = key_stretching::stretch_key(weak, 100);

    assert_eq!(strong1, strong2);  // 반복 횟수 같음 = 같은 결과

    let strong3 = key_stretching::stretch_key(weak, 101);
    assert_ne!(strong1, strong3);  // 반복 횟수 다름 = 다른 결과

    println!("✅ Key Stretching: deterministic and iterative");
}

