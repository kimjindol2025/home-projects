#[test]
fn test_phase_4_complete_workflow() {
    println!("\n📊 Phase 4: Dynamic Key Generation - Complete Workflow\n");

    // 1. 사용자 등록
    println!("1️⃣ Key Generator Initialization...");
    let gen = DynamicKeyGenerator::new("user_phase4_001".to_string());
    println!("   ✅ Generator created for user_phase4_001");

    // 2. 인증 성공
    println!("\n2️⃣ Authentication & Key Generation...");
    let key_result = gen
        .generate_key_on_authentication(&AuthenticationDecision::Accept, 0.92, "model_hash_001")
        .unwrap();
    println!("   Key ID: {}", key_result.key_id);
    println!("   Entropy: {:.1} bits", key_result.entropy_bits);
    println!("   Valid: {}", key_result.is_valid);

    // 3. 템플릿 암호화
    println!("\n3️⃣ Template Encryption...");
    let model_weights = PlaintextTemplate::new(vec![0xAB; 100]);
    let encrypted = gen
        .encrypt_user_template(
            &model_weights,
            &AuthenticationDecision::Accept,
            0.92,
            "model_hash_001",
        )
        .unwrap();
    println!("   Plaintext: {} bytes", model_weights.size_bytes());
    println!("   Encrypted: {} bytes", encrypted.size_bytes());

    // 4. 재인증 후 복호화
    println!("\n4️⃣ Re-authentication & Template Decryption...");
    let decrypted = gen
        .decrypt_user_template(
            &encrypted,
            &AuthenticationDecision::Accept,
            0.92,
            "model_hash_001",
        )
        .unwrap();
    println!("   Decryption: {} bytes recovered", decrypted.size_bytes());
    assert_eq!(decrypted.data, model_weights.data);

    // 5. 다목적 키 생성
    println!("\n5️⃣ Multi-Purpose Subkey Derivation...");
    let subkeys = gen
        .derive_subkeys_for_purposes(
            &AuthenticationDecision::Accept,
            0.92,
            "model_hash_001",
            &["encryption", "authentication", "integrity"],
        )
        .unwrap();
    for (purpose, _key) in &subkeys {
        println!("   ✅ {} key derived", purpose);
    }

    println!("\n✅ Phase 4 Complete Workflow: All stages passed");
}
