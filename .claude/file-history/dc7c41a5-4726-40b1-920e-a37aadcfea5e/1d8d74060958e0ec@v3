// Phase 3 Week 3: Efficiency Learner (400줄)
// Purpose: 5-stage learning FSM for pattern effectiveness and recommendations

pub enum PowerLearningState {
    NoData,       // 0 샘플, actionability=0.0
    Observing,    // 1-3 샘플, actionability=0.2
    Emerging,     // 4-10 샘플, actionability=0.5
    Established,  // 11-30 샘플, actionability=0.8
    Mature,       // 30+ 샘플, actionability=1.0
}

pub struct ActionEffectiveness {
    pub action: String,
    pub success_count: u32,
    pub failure_count: u32,
    pub avg_power_reduction_mw: f64,
    pub avg_latency_ms: u32,
    pub confidence: f64,
}

impl ActionEffectiveness {
    pub fn new(action: &str) -> Self {
        ActionEffectiveness {
            action: action.to_string(),
            success_count: 0,
            failure_count: 0,
            avg_power_reduction_mw: 0.0,
            avg_latency_ms: 0,
            confidence: 0.0,
        }
    }

    pub fn total_samples(&self) -> u32 {
        self.success_count + self.failure_count
    }

    pub fn success_rate(&self) -> f64 {
        if self.total_samples() == 0 {
            0.0
        } else {
            (self.success_count as f64 / self.total_samples() as f64) * 100.0
        }
    }

    pub fn is_effective(&self) -> bool {
        self.success_rate() >= 75.0
    }

    pub fn record_outcome(&mut self, success: bool, power_reduction: f64, latency_ms: u32) {
        if success {
            self.success_count += 1;
        } else {
            self.failure_count += 1;
        }

        // 이동 평균 업데이트
        let n = self.total_samples() as f64;
        self.avg_power_reduction_mw = (self.avg_power_reduction_mw * (n - 1.0) + power_reduction) / n;
        self.avg_latency_ms = ((self.avg_latency_ms as f64 * (n - 1.0) + latency_ms as f64) / n) as u32;

        // 신뢰도 업데이트 (베이지안)
        self.confidence = (self.success_rate() / 100.0).min(1.0);
    }
}

pub struct EfficiencyLearner {
    pub state: PowerLearningState,
    pub action_history: Vec<ActionEffectiveness>,
    pub total_patterns_observed: u32,
    pub learning_cycles: u32,
    pub recommendation_count: u32,
    pub hit_rate: f64,
}

impl EfficiencyLearner {
    pub fn new() -> Self {
        EfficiencyLearner {
            state: PowerLearningState::NoData,
            action_history: Vec::new(),
            total_patterns_observed: 0,
            learning_cycles: 0,
            recommendation_count: 0,
            hit_rate: 0.0,
        }
    }

    fn update_state(&mut self) {
        // 상태 전이: 샘플 수 기반
        let sample_count: u32 = self.action_history.iter().map(|a| a.total_samples()).sum();

        self.state = match sample_count {
            0 => PowerLearningState::NoData,
            1..=3 => PowerLearningState::Observing,
            4..=10 => PowerLearningState::Emerging,
            11..=30 => PowerLearningState::Established,
            _ => PowerLearningState::Mature,
        };
    }

    pub fn actionability_score(&self) -> f64 {
        match self.state {
            PowerLearningState::NoData => 0.0,
            PowerLearningState::Observing => 0.2,
            PowerLearningState::Emerging => 0.5,
            PowerLearningState::Established => 0.8,
            PowerLearningState::Mature => 1.0,
        }
    }

    pub fn observe_action(&mut self, action: &str, success: bool, power_reduction: f64, latency_ms: u32) {
        let existing = self.action_history.iter_mut().find(|a| a.action == action);

        if let Some(ae) = existing {
            ae.record_outcome(success, power_reduction, latency_ms);
        } else {
            let mut ae = ActionEffectiveness::new(action);
            ae.record_outcome(success, power_reduction, latency_ms);
            self.action_history.push(ae);
        }

        self.learning_cycles += 1;
        self.update_state();
    }

    pub fn observe_pattern(&mut self, pattern: &str) {
        self.total_patterns_observed += 1;
    }

    pub fn recommend_action(&mut self, pattern_type: &str) -> Option<String> {
        if self.action_history.is_empty() {
            return None;
        }

        // 효과적인 액션 중 최고 신뢰도 선택
        let best = self.action_history.iter()
            .filter(|a| a.is_effective())
            .max_by(|a, b| a.confidence.partial_cmp(&b.confidence).unwrap_or(std::cmp::Ordering::Equal));

        if let Some(action) = best {
            self.recommendation_count += 1;
            Some(action.action.clone())
        } else {
            None
        }
    }

    pub fn get_action_effectiveness(&self, action: &str) -> Option<&ActionEffectiveness> {
        self.action_history.iter().find(|a| a.action == action)
    }

    pub fn get_best_action(&self) -> Option<String> {
        self.action_history.iter()
            .max_by(|a, b| a.confidence.partial_cmp(&b.confidence).unwrap_or(std::cmp::Ordering::Equal))
            .map(|a| a.action.clone())
    }

    pub fn update_hit_rate(&mut self, successful: u32, total: u32) {
        if total > 0 {
            self.hit_rate = (successful as f64 / total as f64) * 100.0;
        }
    }

    pub fn get_recommendations(&self, min_confidence: f64) -> Vec<String> {
        self.action_history.iter()
            .filter(|a| a.confidence >= min_confidence && a.is_effective())
            .map(|a| a.action.clone())
            .collect()
    }

    pub fn get_action_stats(&self) -> Vec<(String, f64, u32)> {
        // (action, confidence, samples)
        self.action_history.iter()
            .map(|a| (a.action.clone(), a.confidence, a.total_samples()))
            .collect()
    }

    pub fn analyze_action_effectiveness(&self, action: &str) -> Option<String> {
        self.get_action_effectiveness(action).map(|ae| {
            format!(
                "{}: success={:.0}%, reduction={:.1}mW, latency={}ms",
                action,
                ae.success_rate(),
                ae.avg_power_reduction_mw,
                ae.avg_latency_ms
            )
        })
    }

    pub fn is_ready_for_production(&self) -> bool {
        // Mature 상태 + hit_rate > 85%
        matches!(self.state, PowerLearningState::Mature) && self.hit_rate > 85.0
    }

    pub fn reset_state(&mut self) {
        self.action_history.clear();
        self.learning_cycles = 0;
        self.hit_rate = 0.0;
        self.update_state();
    }

    pub fn describe(&self) -> String {
        format!(
            "Learner: state={:?}, actions={}, cycles={}, hit_rate={:.1}%, ready={}",
            self.state,
            self.action_history.len(),
            self.learning_cycles,
            self.hit_rate,
            self.is_ready_for_production()
        )
    }
}

mod tests {
    use super::*;

    #[test]
    fn test_action_effectiveness_creation() {
        let ae = ActionEffectiveness::new("ReduceFrequency");
        assert_eq!(ae.action, "ReduceFrequency");
        assert_eq!(ae.total_samples(), 0);
    }

    #[test]
    fn test_action_effectiveness_record_success() {
        let mut ae = ActionEffectiveness::new("ReduceFrequency");
        ae.record_outcome(true, 20.0, 50);
        assert_eq!(ae.success_count, 1);
        assert_eq!(ae.failure_count, 0);
    }

    #[test]
    fn test_action_effectiveness_success_rate() {
        let mut ae = ActionEffectiveness::new("ReduceFrequency");
        ae.record_outcome(true, 20.0, 50);
        ae.record_outcome(true, 25.0, 45);
        ae.record_outcome(false, 15.0, 60);
        assert!(ae.success_rate() > 60.0 && ae.success_rate() < 75.0);
    }

    #[test]
    fn test_action_effectiveness_is_effective() {
        let mut ae = ActionEffectiveness::new("ReduceFrequency");
        ae.record_outcome(true, 20.0, 50);
        ae.record_outcome(true, 25.0, 45);
        ae.record_outcome(true, 22.0, 48);
        ae.record_outcome(true, 23.0, 47);
        assert!(ae.is_effective());
    }

    #[test]
    fn test_learner_creation() {
        let learner = EfficiencyLearner::new();
        assert!(matches!(learner.state, PowerLearningState::NoData));
        assert_eq!(learner.action_history.len(), 0);
    }

    #[test]
    fn test_learner_observe_action() {
        let mut learner = EfficiencyLearner::new();
        learner.observe_action("ReduceFrequency", true, 20.0, 50);
        assert_eq!(learner.action_history.len(), 1);
    }

    #[test]
    fn test_learner_state_transition_to_observing() {
        let mut learner = EfficiencyLearner::new();
        learner.observe_action("Action1", true, 20.0, 50);
        learner.observe_action("Action1", true, 25.0, 45);
        assert!(matches!(learner.state, PowerLearningState::Observing));
    }

    #[test]
    fn test_learner_state_transition_to_emerging() {
        let mut learner = EfficiencyLearner::new();
        for i in 0..5 {
            learner.observe_action("Action1", true, 20.0 + i as f64, 50);
        }
        assert!(matches!(learner.state, PowerLearningState::Emerging));
    }

    #[test]
    fn test_learner_actionability_no_data() {
        let learner = EfficiencyLearner::new();
        assert_eq!(learner.actionability_score(), 0.0);
    }

    #[test]
    fn test_learner_actionability_observing() {
        let mut learner = EfficiencyLearner::new();
        learner.observe_action("Action1", true, 20.0, 50);
        assert_eq!(learner.actionability_score(), 0.2);
    }

    #[test]
    fn test_learner_actionability_emerging() {
        let mut learner = EfficiencyLearner::new();
        for i in 0..5 {
            learner.observe_action("Action1", true, 20.0 + i as f64, 50);
        }
        assert_eq!(learner.actionability_score(), 0.5);
    }

    #[test]
    fn test_learner_actionability_established() {
        let mut learner = EfficiencyLearner::new();
        for i in 0..15 {
            learner.observe_action("Action1", true, 20.0 + (i % 5) as f64, 50);
        }
        assert_eq!(learner.actionability_score(), 0.8);
    }

    #[test]
    fn test_learner_actionability_mature() {
        let mut learner = EfficiencyLearner::new();
        for i in 0..35 {
            learner.observe_action("Action1", true, 20.0 + (i % 10) as f64, 50);
        }
        assert_eq!(learner.actionability_score(), 1.0);
    }

    #[test]
    fn test_learner_recommend_action() {
        let mut learner = EfficiencyLearner::new();
        for _ in 0..4 {
            learner.observe_action("ReduceFrequency", true, 20.0, 50);
        }
        let recommendation = learner.recommend_action("MemoryLeak");
        assert!(recommendation.is_some());
    }

    #[test]
    fn test_learner_get_best_action() {
        let mut learner = EfficiencyLearner::new();
        learner.observe_action("Action1", true, 20.0, 50);
        learner.observe_action("Action2", true, 30.0, 40);
        let best = learner.get_best_action();
        assert!(best.is_some());
    }

    #[test]
    fn test_learner_hit_rate_update() {
        let mut learner = EfficiencyLearner::new();
        learner.update_hit_rate(8, 10);
        assert_eq!(learner.hit_rate, 80.0);
    }

    #[test]
    fn test_learner_get_recommendations() {
        let mut learner = EfficiencyLearner::new();
        for _ in 0..4 {
            learner.observe_action("EffectiveAction", true, 20.0, 50);
        }
        let recs = learner.get_recommendations(0.5);
        assert!(!recs.is_empty());
    }

    #[test]
    fn test_learner_describe() {
        let mut learner = EfficiencyLearner::new();
        learner.observe_action("Action1", true, 20.0, 50);
        let desc = learner.describe();
        assert!(desc.contains("Learner"));
    }

    #[test]
    fn test_learner_observe_pattern() {
        let mut learner = EfficiencyLearner::new();
        learner.observe_pattern("MemoryLeak");
        learner.observe_pattern("IOBottleneck");
        assert_eq!(learner.total_patterns_observed, 2);
    }
}

