pub mod green_raft_node;
pub mod power_leader_election;
pub mod low_power_replication;

pub use green_raft_node::GreenRaftNode;
pub use power_leader_election::power_weighted_election;
pub use low_power_replication::{ReplicationBatcher, failover_on_leader_drain};

pub struct GreenConsensusLayer {
    pub nodes: Vec<GreenRaftNode>,
    pub leader_id: Option<u32>,
}

impl GreenConsensusLayer {
    pub fn new(node_count: u32) -> Self {
        let nodes = (1..=node_count)
            .map(|id| GreenRaftNode::new(id, (1..=node_count).filter(|n| n != &id).collect()))
            .collect();
        GreenConsensusLayer { nodes, leader_id: None }
    }

    pub fn elect_leader(&mut self) {
        if let Some(leader) = power_weighted_election(&self.nodes) {
            self.leader_id = Some(leader);
        }
    }
}
