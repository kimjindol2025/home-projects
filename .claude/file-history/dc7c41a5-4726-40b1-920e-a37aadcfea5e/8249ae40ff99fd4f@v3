// Phase 3 Week 2: Green Consensus Layer Facade (60줄)
// Unified interface for L4 consensus with power awareness

pub mod green_raft_node;
pub mod power_leader_election;
pub mod low_power_replication;

pub use green_raft_node::GreenRaftNode;
pub use power_leader_election::{PowerLeaderElector, ElectionStrategy, ElectionResult};
pub use low_power_replication::{ReplicationBatcher, ReplicationMode, FailoverManager};

pub struct GreenConsensusLayer {
    pub nodes: Vec<GreenRaftNode>,
    pub leader_id: Option<u32>,
    pub elector: PowerLeaderElector,
    pub replication_batcher: ReplicationBatcher,
    pub failover_manager: FailoverManager,
    pub consensus_latency_ms: u32,
}

impl GreenConsensusLayer {
    pub fn new(node_count: u32) -> Self {
        let mut nodes = Vec::new();
        for id in 1..=node_count {
            nodes.push(GreenRaftNode::new(id, (1..=node_count).filter(|n| n != &id).collect()));
        }

        GreenConsensusLayer {
            nodes,
            leader_id: None,
            elector: PowerLeaderElector::new(node_count),
            replication_batcher: ReplicationBatcher::new(),
            failover_manager: FailoverManager::new(),
            consensus_latency_ms: 150,
        }
    }

    pub fn elect_leader(&mut self) -> ElectionResult {
        let result = self.elector.request_votes(&self.nodes, 75.0);
        if let Some(leader) = result.leader_id {
            self.leader_id = Some(leader);
            self.consensus_latency_ms = result.consensus_latency_ms;
        }
        result
    }

    pub fn is_operational(&self) -> bool {
        self.leader_id.is_some() &&
        self.consensus_latency_ms < 150 &&
        !self.failover_manager.failover_triggered
    }

    pub fn check_leader_health(&mut self) -> bool {
        if let Some(leader_idx) = self.nodes.iter().position(|n| Some(n.node_id) == self.leader_id) {
            let leader_battery = self.nodes[leader_idx].battery_level;
            let leader_state = self.nodes[leader_idx].power_state.clone();

            if self.failover_manager.should_failover(leader_battery, &leader_state) {
                let followers: Vec<_> = self.nodes.iter()
                    .filter(|n| Some(n.node_id) != self.leader_id)
                    .cloned()
                    .collect();
                return self.failover_manager.execute_failover(&followers);
            }
        }
        true
    }

    pub fn describe(&self) -> String {
        format!(
            "GreenConsensus: leader={:?}, operational={}, latency={}ms",
            self.leader_id,
            self.is_operational(),
            self.consensus_latency_ms
        )
    }
}

mod tests {
    use super::*;

    #[test]
    fn test_layer_creation() {
        let layer = GreenConsensusLayer::new(5);
        assert_eq!(layer.nodes.len(), 5);
        assert!(layer.leader_id.is_none());
    }

    #[test]
    fn test_is_operational() {
        let layer = GreenConsensusLayer::new(3);
        assert!(!layer.is_operational());
    }
}
