pub mod energy_pattern_db;
pub mod efficiency_learner;

pub use energy_pattern_db::{EnergyHistoryEntry, EnergyPatternDB};
pub use efficiency_learner::{PowerLearningState, EfficiencyLearner};

pub struct EnergyHistoryLayer {
    pub db: EnergyPatternDB,
    pub learner: EfficiencyLearner,
}

impl EnergyHistoryLayer {
    pub fn new() -> Self {
        EnergyHistoryLayer {
            db: EnergyPatternDB::new(),
            learner: EfficiencyLearner::new(),
        }
    }

    pub fn record(&mut self, entry: EnergyHistoryEntry) {
        self.db.record(entry);
    }

    pub fn recognition_accuracy(&self) -> f64 {
        self.learner.accuracy()
    }
}
