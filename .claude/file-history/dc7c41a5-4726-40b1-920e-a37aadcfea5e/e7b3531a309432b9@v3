## 모듈별 핵심 타입

### 1. `wearable_sensor.fl`
```
WearableDeviceType: SmartWatch / FitnessBand / MedicalPatch
WearableDevice { device_id, device_type, battery_level: u8, firmware_version }

SensorReading {
    heart_rate_bpm: f64, heart_rate_variability: f64,
    accelerometer_x/y/z: f64,   // 움직임 감지
    skin_conductance: f64,        // 피부 전기 반응
    confidence: f64, timestamp: u64,
}

WearableSensorHub {
    fn connect_device() / read_sensor()
    fn multi_device_fuse(readings) -> SensorReading   // 다중 기기 융합
    fn to_heart_rate_signal(reading) -> HeartRateSignal  // Phase 1 연결
}
```

### 2. `hw_secure_storage.fl`
```
SecureEnclaveType: SoftwareSim / TrustZone / SecureElement / HSM
AttestedKey { key_bytes, attestation: Vec<u8>, created_at }

HwSecureStorage {
    fn store_master_secret(user_id, secret) -> Result<String>
    fn retrieve_master_secret(user_id, auth_token) -> Result<Vec<u8>>
    fn attest_key(key) -> AttestedKey    // HW 서명
    fn is_tampered() -> bool              // 변조 감지
}
```

### 3. `pqc_crypto.fl` (Lattice-based, Kyber-like)
```
LatticeParams { n: usize, q: u64, eta: u64 }  // 격자 파라미터
LatticeKey { polynomial: Vec<i64>, modulus: u64, dimension: usize }
PqcPublicKey / PqcPrivateKey { key: LatticeKey, params: LatticeParams }

PqcCrypto {
    fn generate_keypair() -> (PqcPublicKey, PqcPrivateKey)
    fn encapsulate(pk) -> (ciphertext, shared_secret)  // KEM
    fn decapsulate(sk, ct) -> shared_secret
    fn key_size_bits() -> usize    // >= 1024 비트 검증용
    fn security_level() -> u32     // NIST Level 1-5
}
```

### 4. `wearable_authenticator.fl`
```
WearableAuthConfig { sensor_fusion_threshold: f64, require_hw_storage: bool, pqc_enabled: bool }

WearableAuthResult {
    decision: AuthenticationDecision,    // Phase 3 타입 재사용
    pqc_key: Option<Vec<u8>>,
    hw_attested: bool,
    sensor_count: usize,
    fusion_confidence: f64,
    dynamic_key: Option<DynamicKeyResult>,  // Phase 4 타입 재사용
}

WearableAuthenticator {
    engine: AuthenticationEngine,    // Phase 3 재사용
    fn enroll_with_wearable(user_id, devices) -> Result<()>
    fn authenticate_with_wearable(user_id, devices) -> Result<WearableAuthResult>
    fn upgrade_key_to_pqc(classical_key) -> Vec<u8>  // 하이브리드 업그레이드
}
```

