mod tests {
    use super::*;

    #[test]
    fn test_power_sensing_layer_creation() {
        let layer = PowerSensingLayer::new(1200);
        assert_eq!(layer.sensor.battery_state().capacity_mah, 1200);
    }

    #[test]
    fn test_power_sensing_layer_tick() {
        let mut layer = PowerSensingLayer::new(1200);

        let reading = PowerReading::new(1000, 3700, 100, 25.0, 1000);
        layer.tick(reading);

        assert_eq!(layer.tick_count, 1);
    }

    #[test]
    fn test_current_state() {
        let mut layer = PowerSensingLayer::new(1200);

        let reading = PowerReading::new(1000, 3700, 100, 25.0, 1000);
        layer.tick(reading);

        let (r, patterns, forecast) = layer.current_state();
        assert_eq!(r.current_ma, 100);
        assert!(!patterns.is_empty() || patterns.is_empty()); // 패턴이 있을 수도 없을 수도
    }
}
