// Green-Distributed-Fabric Layer 1: Power Sensing
// mod.fl - 모듈 통합 및 Facade API

pub mod power_sensor;
pub mod power_pattern;
pub mod battery_predictor;

pub use power_sensor::{PowerReading, BatteryState, PowerSensor};
pub use power_pattern::{PowerPatternType, PowerPattern, PowerPatternMatcher};
pub use battery_predictor::{BatteryForecast, BatteryPredictor, DrainRateHistory};

// ─────────────────────────────────────────────────────────────────
// PowerSensingLayer: L1 공개 API Facade
// ─────────────────────────────────────────────────────────────────

pub struct PowerSensingLayer {
    pub sensor: PowerSensor,
    pub matcher: PowerPatternMatcher,
    pub predictor: BatteryPredictor,
    tick_count: u64,
}

impl PowerSensingLayer {
    pub fn new(capacity_mah: u32) -> PowerSensingLayer {
        let battery = BatteryState::new(capacity_mah);
        let predictor = BatteryPredictor::new(battery.clone(), 240);

        PowerSensingLayer {
            sensor: PowerSensor::new(capacity_mah, 250.0),
            matcher: PowerPatternMatcher::new(),
            predictor,
            tick_count: 0,
        }
    }

    pub fn tick(&mut self, reading: PowerReading) {
        // 1. 전력 센서에 측정값 추가
        self.sensor.sample(reading.clone());
        self.matcher.add_reading(reading.clone());

        // 2. 패턴 감지
        let patterns = self.matcher.run_detection();

        // 3. 배터리 상태 업데이트
        let elapsed_sec = if self.tick_count > 0 { 1.0 } else { 0.0 };
        self.predictor.update(&reading, elapsed_sec);
        self.predictor.update_context(patterns.iter().map(|p| p.pattern_type.clone()).collect());

        self.tick_count += 1;
    }

    pub fn current_state(&self) -> (PowerReading, Vec<PowerPattern>, BatteryForecast) {
        let reading = self.sensor.current_reading()
            .unwrap_or(&PowerReading::new(0, 3700, 0, 25.0, 1000))
            .clone();

        let patterns = self.matcher.detected_patterns().to_vec();

        let forecast = self.predictor.current_forecast()
            .cloned()
            .unwrap_or_else(|| BatteryForecast {
                current_level_percent: 1.0,
                predicted_empty_minutes: 0,
                predicted_empty_hours: 0.0,
                confidence: 0.0,
                prediction_method: "None".to_string(),
                safe_operation_window_min: 0,
            });

        (reading, patterns, forecast)
    }

    pub fn power_savings_mw(&self) -> f64 {
        self.sensor.savings_vs_baseline() * 250.0 // 절감된 mW
    }

    pub fn battery_critical(&self) -> bool {
        self.sensor.battery_state().is_critical()
    }

    pub fn battery_low(&self) -> bool {
        self.sensor.battery_state().is_low()
    }
}

