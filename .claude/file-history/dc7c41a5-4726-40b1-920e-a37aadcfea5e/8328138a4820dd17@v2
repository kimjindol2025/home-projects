// battery_predictor.fl - 배터리 수명 예측
// 재사용: Phase 7 urgency_score() 알고리즘

use super::power_sensor::{PowerReading, BatteryState};
use super::power_pattern::PowerPatternType;
use std::collections::VecDeque;

// ─────────────────────────────────────────────────────────────────
// BatteryForecast: 배터리 수명 예측 결과
// ─────────────────────────────────────────────────────────────────

#[derive(Clone, Debug)]
pub struct BatteryForecast {
    pub current_level_percent: f64,
    pub predicted_empty_minutes: u32,  // 배터리 소진까지 남은 분수
    pub predicted_empty_hours: f64,    // 가독성 단위
    pub confidence: f64,               // 예측 신뢰도 (0.0-1.0)
    pub prediction_method: String,     // "Linear" / "Weighted" / "PatternAware"
    pub safe_operation_window_min: u32, // 안전 운영 가능 시간
}

impl BatteryForecast {
    pub fn is_critical(&self) -> bool {
        self.predicted_empty_minutes < 30
    }

    pub fn drain_urgency_score(&self) -> f64 {
        // Phase 7 MemoryPrediction.urgency_score() 동일 알고리즘:
        // time_factor = 1.0 / (1.0 + time_to_limit_sec / 3600.0)
        // urgency = time_factor × confidence
        let time_factor = 1.0 / (1.0 + (self.predicted_empty_minutes as f64) / 60.0);
        time_factor * self.confidence
    }

    pub fn is_doubled_vs_linux(&self) -> bool {
        // 무관용 규칙 2 검증:
        // Linux baseline: 1200mAh / 250mW = 4.8h
        // Green target: >= 9.6h
        self.predicted_empty_hours >= 9.6
    }
}

// ─────────────────────────────────────────────────────────────────
// DrainRateHistory: 방전률 이력 추적
// ─────────────────────────────────────────────────────────────────

pub struct DrainRateHistory {
    samples: VecDeque<(u64, f64)>,  // (timestamp_ms, drain_rate_mah_per_hour)
    window_size: usize,              // 최근 N 샘플
}

impl DrainRateHistory {
    pub fn new(window_size: usize) -> DrainRateHistory {
        DrainRateHistory {
            samples: VecDeque::new(),
            window_size,
        }
    }

    pub fn add_sample(&mut self, timestamp: u64, rate: f64) {
        self.samples.push_back((timestamp, rate));

        if self.samples.len() > self.window_size {
            self.samples.pop_front();
        }
    }

    pub fn weighted_average_rate(&self) -> f64 {
        if self.samples.is_empty() {
            return 100.0; // 기본값
        }

        let mut weighted_sum = 0.0;
        let mut weight_sum = 0.0;

        // 최신 샘플에 더 높은 가중치
        for (i, (_, rate)) in self.samples.iter().enumerate() {
            let weight = ((i + 1) as f64) / (self.samples.len() as f64);
            weighted_sum += rate * weight;
            weight_sum += weight;
        }

        weighted_sum / weight_sum
    }

    pub fn trend_direction(&self) -> f64 {
        // +: 소비 증가, -: 감소
        if self.samples.len() < 2 {
            return 0.0;
        }

        let first = self.samples.front().unwrap().1;
        let last = self.samples.back().unwrap().1;

        last - first
    }
}

// ─────────────────────────────────────────────────────────────────
// BatteryPredictor: 배터리 수명 예측 엔진
// ─────────────────────────────────────────────────────────────────

pub struct BatteryPredictor {
    battery: BatteryState,
    drain_history: DrainRateHistory,
    pattern_context: Vec<PowerPatternType>,
    linux_baseline_life_min: u32,      // 기준값: 240분
    last_forecast: Option<BatteryForecast>,
}

impl BatteryPredictor {
    pub fn new(battery: BatteryState, linux_baseline_min: u32) -> BatteryPredictor {
        BatteryPredictor {
            battery,
            drain_history: DrainRateHistory::new(20), // 최근 20 샘플
            pattern_context: Vec::new(),
            linux_baseline_life_min,
            last_forecast: None,
        }
    }

    pub fn update(&mut self, reading: &PowerReading, elapsed_sec: f64) {
        let drain_rate = (reading.current_ma.abs() as f64) * (3600.0 / 1000.0);
        self.drain_history.add_sample(reading.timestamp_us / 1000, drain_rate);
        self.battery.update_from_reading(reading, elapsed_sec);
    }

    pub fn predict_linear(&self) -> BatteryForecast {
        // remaining_mah / drain_rate_mah_per_hour × 60 = minutes
        let drain_rate = 100.0; // 기본 방전률
        let remaining_min = if drain_rate > 0.0 {
            ((self.battery.remaining_mah as f64) / drain_rate * 60.0) as u32
        } else {
            u32::MAX
        };

        BatteryForecast {
            current_level_percent: self.battery.level_percent,
            predicted_empty_minutes: remaining_min,
            predicted_empty_hours: (remaining_min as f64) / 60.0,
            confidence: 0.70, // 선형 예측은 신뢰도 낮음
            prediction_method: "Linear".to_string(),
            safe_operation_window_min: (remaining_min / 2).max(5),
        }
    }

    pub fn predict_weighted(&self) -> BatteryForecast {
        // DrainRateHistory.weighted_average_rate() 활용
        let weighted_rate = self.drain_history.weighted_average_rate();
        let remaining_min = if weighted_rate > 0.0 {
            ((self.battery.remaining_mah as f64) / weighted_rate * 60.0) as u32
        } else {
            u32::MAX
        };

        BatteryForecast {
            current_level_percent: self.battery.level_percent,
            predicted_empty_minutes: remaining_min,
            predicted_empty_hours: (remaining_min as f64) / 60.0,
            confidence: 0.80, // 가중 평균은 신뢰도 더 높음
            prediction_method: "Weighted".to_string(),
            safe_operation_window_min: (remaining_min / 2).max(5),
        }
    }

    pub fn predict_pattern_aware(&self, patterns: &[PowerPatternType]) -> BatteryForecast {
        // 활성 패턴의 severity_weight 반영
        let mut total_severity = 0.0;
        for pattern in patterns {
            total_severity += pattern.severity_weight();
        }

        // 심각도가 높을수록 방전률 증가로 가정
        let severity_factor = if !patterns.is_empty() {
            1.0 + (total_severity / patterns.len() as f64) * 0.3
        } else {
            1.0
        };

        let adjusted_rate = 100.0 * severity_factor;
        let remaining_min = if adjusted_rate > 0.0 {
            ((self.battery.remaining_mah as f64) / adjusted_rate * 60.0) as u32
        } else {
            u32::MAX
        };

        BatteryForecast {
            current_level_percent: self.battery.level_percent,
            predicted_empty_minutes: remaining_min,
            predicted_empty_hours: (remaining_min as f64) / 60.0,
            confidence: 0.85,
            prediction_method: "PatternAware".to_string(),
            safe_operation_window_min: (remaining_min / 2).max(5),
        }
    }

    pub fn best_forecast(&self, patterns: &[PowerPatternType]) -> BatteryForecast {
        let linear = self.predict_linear();
        let weighted = self.predict_weighted();
        let pattern_aware = self.predict_pattern_aware(patterns);

        // 신뢰도가 가장 높은 예측 선택
        if pattern_aware.confidence >= weighted.confidence && pattern_aware.confidence >= linear.confidence {
            pattern_aware
        } else if weighted.confidence >= linear.confidence {
            weighted
        } else {
            linear
        }
    }

    pub fn savings_ratio_vs_linux(&self) -> f64 {
        // 무관용 규칙 2: 배터리 수명 2배 연장 검증
        if let Some(forecast) = &self.last_forecast {
            let predicted_min = forecast.predicted_empty_minutes as f64;
            let baseline_min = self.linux_baseline_life_min as f64;

            if baseline_min > 0.0 {
                predicted_min / baseline_min
            } else {
                1.0
            }
        } else {
            1.0
        }
    }

    pub fn update_context(&mut self, patterns: Vec<PowerPatternType>) {
        self.pattern_context = patterns;
    }

    pub fn current_forecast(&self) -> Option<&BatteryForecast> {
        self.last_forecast.as_ref()
    }

    pub fn forecast(&mut self, patterns: &[PowerPatternType]) -> BatteryForecast {
        let forecast = self.best_forecast(patterns);
        self.last_forecast = Some(forecast.clone());
        forecast
    }
}

// ─────────────────────────────────────────────────────────────────
// 테스트
// ─────────────────────────────────────────────────────────────────

mod tests {
    use super::*;

    #[test]
    fn test_forecast_is_critical() {
        let forecast = BatteryForecast {
            current_level_percent: 0.04,
            predicted_empty_minutes: 20,
            predicted_empty_hours: 0.33,
            confidence: 0.80,
            prediction_method: "Linear".to_string(),
            safe_operation_window_min: 10,
        };

        assert!(forecast.is_critical());
    }

    #[test]
    fn test_drain_urgency_score() {
        let forecast = BatteryForecast {
            current_level_percent: 0.10,
            predicted_empty_minutes: 60,
            predicted_empty_hours: 1.0,
            confidence: 0.80,
            prediction_method: "Linear".to_string(),
            safe_operation_window_min: 30,
        };

        let urgency = forecast.drain_urgency_score();
        // time_factor = 1.0 / (1.0 + 60/60) = 0.5
        // urgency = 0.5 × 0.80 = 0.40
        assert!(urgency > 0.39 && urgency < 0.41);
    }

    #[test]
    fn test_is_doubled_vs_linux() {
        let forecast = BatteryForecast {
            current_level_percent: 1.0,
            predicted_empty_minutes: 576, // 9.6시간
            predicted_empty_hours: 9.6,
            confidence: 0.85,
            prediction_method: "PatternAware".to_string(),
            safe_operation_window_min: 288,
        };

        assert!(forecast.is_doubled_vs_linux());
    }

    #[test]
    fn test_drain_rate_history() {
        let mut history = DrainRateHistory::new(5);

        history.add_sample(1000, 100.0);
        history.add_sample(2000, 110.0);
        history.add_sample(3000, 120.0);

        let avg = history.weighted_average_rate();
        assert!(avg > 100.0 && avg < 120.0);
    }

    #[test]
    fn test_predictor_linear() {
        let battery = BatteryState::new(1200);
        let mut predictor = BatteryPredictor::new(battery, 240);

        let forecast = predictor.predict_linear();
        assert_eq!(forecast.prediction_method, "Linear");
        assert_eq!(forecast.confidence, 0.70);
    }

    #[test]
    fn test_predictor_weighted() {
        let battery = BatteryState::new(1200);
        let mut predictor = BatteryPredictor::new(battery, 240);

        // 방전률 샘플 추가
        predictor.drain_history.add_sample(1000, 100.0);
        predictor.drain_history.add_sample(2000, 105.0);

        let forecast = predictor.predict_weighted();
        assert_eq!(forecast.prediction_method, "Weighted");
        assert_eq!(forecast.confidence, 0.80);
    }

    #[test]
    fn test_predictor_pattern_aware() {
        let battery = BatteryState::new(1200);
        let mut predictor = BatteryPredictor::new(battery, 240);

        let patterns = vec![PowerPatternType::PowerSpike];
        let forecast = predictor.predict_pattern_aware(&patterns);
        assert_eq!(forecast.prediction_method, "PatternAware");
        assert_eq!(forecast.confidence, 0.85);
    }

    #[test]
    fn test_savings_ratio_vs_linux() {
        let battery = BatteryState::new(1200);
        let mut predictor = BatteryPredictor::new(battery, 240);

        let forecast = BatteryForecast {
            current_level_percent: 1.0,
            predicted_empty_minutes: 480, // 8시간
            predicted_empty_hours: 8.0,
            confidence: 0.85,
            prediction_method: "Linear".to_string(),
            safe_operation_window_min: 240,
        };

        predictor.last_forecast = Some(forecast);
        let ratio = predictor.savings_ratio_vs_linux();
        // 480 / 240 = 2.0
        assert_eq!(ratio, 2.0);
    }
}
