// Phase 1: Biometric Signal Collection E2E Tests

use crate::signals::*;

#[test]
fn test_keystroke_dynamics_collection() {
    let mut collector = BiometricCollector::new(100);

    // 문장 타이핑 시뮬레이션
    let keys = "hello";
    for (i, ch) in keys.chars().enumerate() {
        collector.record_keystroke(
            ch,
            (i as u64) * 150,  // 키 간 시간차 150ms
            75,                 // 누름 시간 75ms
            if i == 0 { 0 } else { 150 },  // 비행 시간
            0.7 + (i as f64) * 0.02,  // 누른 강도 (변동)
        );
    }

    assert_eq!(collector.keystroke_buffer.len(), 5);
    assert_eq!(collector.typing_speed() > 0.0, true);

    println!("✅ Keystroke Dynamics:");
    println!("   Typing Speed: {:.1} WPM", collector.typing_speed());
    println!("   Dwell Time: {:.1} ms", collector.average_dwell_time());
    println!("   Flight Time: {:.1} ms", collector.average_flight_time());
}

#[test]
fn test_touch_pressure_patterns() {
    let mut collector = BiometricCollector::new(100);

    // 스크린에 터치하는 패턴 (좌상단 → 우하단)
    for i in 0..10 {
        let x = 100.0 + (i as f64) * 50.0;
        let y = 200.0 + (i as f64) * 30.0;
        let pressure = 0.5 + (i as f64) * 0.05;  // 점진적으로 강해짐

        collector.record_touch(
            x,
            y,
            pressure,
            (i as u64) * 100,
            80,  // 각 터치 지속 시간 80ms
        );
    }

    assert_eq!(collector.touch_buffer.len(), 10);

    let avg_pressure = collector.average_touch_pressure();
    assert!(avg_pressure > 0.5 && avg_pressure < 1.0);

    println!("✅ Touch Pressure Patterns:");
    println!("   Touch Points: {}", collector.touch_buffer.len());
    println!("   Average Pressure: {:.2}", avg_pressure);
}

#[test]
fn test_heart_rate_variability() {
    let mut collector = BiometricCollector::new(100);

    // 실제 심박수 데이터 (변동성 있음)
    let heart_rates = vec![
        72.0, 73.0, 75.0, 74.0, 76.0,
        77.0, 75.0, 74.0, 73.0, 72.0,
    ];

    for (i, &bpm) in heart_rates.iter().enumerate() {
        let hrv = 0.5 + ((i as f64) * 0.03).sin().abs() * 0.3;
        collector.record_heartrate(
            bpm,
            (i as u64) * 1000,
            hrv,
            0.95,  // 측정 신뢰도 95%
        );
    }

    assert_eq!(collector.heartrate_buffer.len(), 10);

    let avg_hr = collector.average_heart_rate();
    let avg_hrv = collector.average_hrv();

    assert!(avg_hr > 70.0 && avg_hr < 80.0);
    assert!(avg_hrv > 0.0 && avg_hrv < 1.0);

    println!("✅ Heart Rate Variability:");
    println!("   Average HR: {:.1} BPM", avg_hr);
    println!("   Average HRV: {:.3}", avg_hrv);
}

#[test]
fn test_biometric_profile_extraction() {
    let mut collector = BiometricCollector::new(100);

    // 통합 생체 신호 수집
    for i in 0..20 {
        // 타이핑
        collector.record_keystroke(
            ['h', 'e', 'l', 'l', 'o'][i % 5],
            (i as u64) * 100,
            50 + (i as u64) % 50,
            100,
            0.7,
        );

        // 터치
        if i % 2 == 0 {
            collector.record_touch(
                100.0 + (i as f64) * 10.0,
                200.0,
                0.6 + (i as f64) * 0.01,
                (i as u64) * 150,
                60,
            );
        }

        // 심박수
        if i % 3 == 0 {
            collector.record_heartrate(
                72.0 + (i as f64) % 10.0,
                (i as u64) * 200,
                0.5,
                0.9,
            );
        }
    }

    let profile = collector.biometric_profile();

    assert!(profile.typing_speed > 0.0);
    assert!(profile.dwell_time > 0.0);
    assert!(profile.heart_rate > 0.0);
    assert_eq!(profile.keystroke_count, 20);

    println!("✅ Biometric Profile:");
    println!("   Typing Speed: {:.1} WPM", profile.typing_speed);
    println!("   Dwell Time: {:.1} ms", profile.dwell_time);
    println!("   Heart Rate: {:.1} BPM", profile.heart_rate);
    println!("   Touch Pressure: {:.2}", profile.touch_pressure);
}

#[test]
fn test_buffer_overflow_handling() {
    let mut collector = BiometricCollector::new(10);

    // 버퍼 크기(10)보다 많은 신호 기록
    for i in 0..20 {
        collector.record_keystroke(
            'a',
            (i as u64) * 100,
            50,
            100,
            0.7,
        );
    }

    // 버퍼는 최대 크기로 제한되어야 함
    assert_eq!(collector.keystroke_buffer.len(), 10);
    // 총 신호는 모두 카운트됨
    assert_eq!(collector.total_signals_collected, 20);

    println!("✅ Buffer Management: Correctly limited to {} items", collector.max_buffer_size);
}

#[cfg(test)]
mod unforgiving_rules {
    use super::*;

    #[test]
    fn rule_1_keystroke_accuracy_100_percent() {
        // Rule: 타이핑 신호 기록 정확도 = 100%
        let mut collector = BiometricCollector::new(100);

        for i in 0..50 {
            let recorded = collector.record_keystroke(
                'a',
                (i as u64) * 100,
                50,
                100,
                0.7,
            );
            assert!(recorded);
        }

        assert_eq!(collector.keystroke_buffer.len(), 50);
        assert_eq!(collector.total_signals_collected, 50);

        println!("✅ RULE 1 PASS: Keystroke Recording 100% Accurate (50/50)");
    }

    #[test]
    fn rule_2_heartrate_validation_100_percent() {
        // Rule: 심박수 유효성 검증 = 100% (생리적 범위)
        let mut collector = BiometricCollector::new(100);

        // 유효한 범위 (40~200 BPM)
        let valid_rates = vec![40.0, 60.0, 72.0, 100.0, 150.0, 200.0];
        for (i, &bpm) in valid_rates.iter().enumerate() {
            let recorded = collector.record_heartrate(bpm, i as u64 * 1000, 0.5, 0.9);
            assert!(recorded);
        }

        // 무효한 범위
        let invalid_rates = vec![30.0, 250.0, -50.0, 1000.0];
        for (i, &bpm) in invalid_rates.iter().enumerate() {
            let recorded = collector.record_heartrate(bpm, (i as u64 + 100) * 1000, 0.5, 0.9);
            assert!(!recorded);  // 모두 거부되어야 함
        }

        assert_eq!(collector.heartrate_buffer.len(), 6);

        println!("✅ RULE 2 PASS: Heart Rate Validation 100% (6 valid, 4 rejected)");
    }
}

// 최종 E2E 테스트
#[test]
fn test_phase_1_complete_workflow() {
    let mut collector = BiometricCollector::new(100);

    println!("\n📊 Phase 1: Biometric Signal Collection - Complete Workflow\n");

    // 시나리오: 사용자가 "BioKey123" 입력 + 터치 + 심박 측정
    let password = "BioKey123";

    // 1. 타이핑 신호 수집
    for (i, ch) in password.chars().enumerate() {
        collector.record_keystroke(
            ch,
            (i as u64) * 120,  // 120ms 키 간 간격
            45 + (i as u64) % 30,  // 45~75ms 누름 시간
            if i == 0 { 0 } else { 120 },
            0.65 + ((i as f64) % 3.0) * 0.1,  // 0.65~0.95 압력
        );
    }

    // 2. 터치 신호 수집 (화면 입력)
    for i in 0..5 {
        collector.record_touch(
            200.0 + (i as f64) * 50.0,
            400.0 + (i as f64) * 30.0,
            0.5 + (i as f64) * 0.08,
            (i as u64) * 200,
            70,
        );
    }

    // 3. 심박수 신호 수집 (웨어러블)
    for i in 0..10 {
        collector.record_heartrate(
            70.0 + (i as f64) * 0.5,  // 70~75 BPM
            (i as u64) * 500,
            0.4 + ((i as f64) / 10.0),  // 0.4~0.5 HRV
            0.92 + ((i as f64) / 100.0),  // 92~93% 신뢰도
        );
    }

    // 4. 통계
    let profile = collector.biometric_profile();
    let stats = collector.statistics();

    println!("✅ Phase 1 Complete Workflow:");
    println!("   1. Keystroke Signals Collected: {}", profile.keystroke_count);
    println!("      - Typing Speed: {:.2} WPM", profile.typing_speed);
    println!("      - Dwell Time: {:.1} ms", profile.dwell_time);
    println!("      - Flight Time: {:.1} ms", profile.flight_time);
    println!();
    println!("   2. Touch Signals Collected: {}", profile.touch_count);
    println!("      - Average Pressure: {:.2}", profile.touch_pressure);
    println!();
    println!("   3. Heart Rate Signals Collected: {}", profile.heartrate_count);
    println!("      - Average HR: {:.1} BPM", profile.heart_rate);
    println!("      - Average HRV: {:.3}", profile.heart_rate_variability);
    println!();
    println!("   Total Signals: {}", stats.total_signals);
    println!("   Total Keystroke Pressure: {:.2}", stats.avg_keystroke_pressure);
}
