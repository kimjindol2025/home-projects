// Green-Distributed-Fabric Phase 2 Week 3: Extended Power Patterns
// Purpose: Detect 7-12 additional power patterns beyond Phase 1
// Strategy: Pattern recognition + temporal analysis + classification

// ============================================================================
// Part 1: Extended Pattern Definitions (280 lines)
// ============================================================================

pub enum ExtendedPowerPattern {
    // Phase 1 patterns (6)
    MemoryLeak,
    IOBottleneck,
    ThreadContention,
    PeriodicLoad,
    CacheThreshing,
    CombinedPressure,

    // Phase 2 new patterns (7-12)
    IntermittentComputing,        // Wake-up surge (0-50-0mW)
    DeepSleep,                     // ULP mode (1-5mW)
    ThermalThrottling,             // Temp-based power reduction
    NetworkWakeup,                 // Network interrupt spike
    SensorSamplingSpike,           // Sensor burst activity
    DynamicVoltageSpike,           // DVFS transition overhead
    CacheLineContention,           // L3 cache conflicts
    PageFaultStorm,                // TLB misses, page faults
    ContextSwitchHeavy,            // Frequent context switching
    InterruptNesting,              // Nested interrupt handling
}

pub struct ExtendedPatternSignature {
    pub pattern: ExtendedPowerPattern,
    pub base_power_mw: f64,
    pub peak_power_mw: f64,
    pub duration_ms: u32,
    pub frequency_hz: f64,         // How often pattern occurs
    pub confidence: f64,           // 0.0-1.0, detection accuracy
    pub detection_metrics: Vec<(String, f64)>,  // Diagnostic metrics
}

impl ExtendedPatternSignature {
    pub fn new(pattern: ExtendedPowerPattern) -> Self {
        let (base, peak, duration, freq) = match pattern {
            ExtendedPowerPattern::MemoryLeak => (10.0, 200.0, 60000, 0.01),
            ExtendedPowerPattern::IOBottleneck => (100.0, 180.0, 5000, 0.5),
            ExtendedPowerPattern::ThreadContention => (80.0, 200.0, 1000, 2.0),
            ExtendedPowerPattern::PeriodicLoad => (50.0, 150.0, 10000, 0.1),
            ExtendedPowerPattern::CacheThreshing => (120.0, 220.0, 500, 5.0),
            ExtendedPowerPattern::CombinedPressure => (150.0, 250.0, 2000, 0.5),

            // New patterns
            ExtendedPowerPattern::IntermittentComputing => (5.0, 50.0, 3000, 0.05),
            ExtendedPowerPattern::DeepSleep => (2.0, 5.0, 30000, 0.01),
            ExtendedPowerPattern::ThermalThrottling => (90.0, 120.0, 5000, 0.2),
            ExtendedPowerPattern::NetworkWakeup => (10.0, 180.0, 2000, 0.3),
            ExtendedPowerPattern::SensorSamplingSpike => (50.0, 150.0, 1000, 1.0),
            ExtendedPowerPattern::DynamicVoltageSpike => (100.0, 200.0, 100, 10.0),
            ExtendedPowerPattern::CacheLineContention => (80.0, 190.0, 800, 3.0),
            ExtendedPowerPattern::PageFaultStorm => (60.0, 200.0, 2000, 1.0),
            ExtendedPowerPattern::ContextSwitchHeavy => (120.0, 210.0, 1500, 2.0),
            ExtendedPowerPattern::InterruptNesting => (70.0, 220.0, 500, 5.0),
        };

        ExtendedPatternSignature {
            pattern,
            base_power_mw: base,
            peak_power_mw: peak,
            duration_ms: duration,
            frequency_hz: freq,
            confidence: 0.0,
            detection_metrics: Vec::new(),
        }
    }

    pub fn describe(&self) -> String {
        format!(
            "{:?}: base={:.0}mW, peak={:.0}mW, freq={:.1}Hz, confidence={:.0}%",
            self.pattern, self.base_power_mw, self.peak_power_mw,
            self.frequency_hz, self.confidence * 100.0
        )
    }
}

// ============================================================================
// Part 2: Pattern Detection Engine (250 lines)
// ============================================================================

pub struct PatternDetector {
    pub power_readings: Vec<f64>,
    pub timestamps_ms: Vec<u64>,
    pub detected_patterns: Vec<(ExtendedPowerPattern, f64)>,  // (pattern, confidence)
}

impl PatternDetector {
    pub fn new() -> Self {
        PatternDetector {
            power_readings: Vec::new(),
            timestamps_ms: Vec::new(),
            detected_patterns: Vec::new(),
        }
    }

    pub fn add_reading(&mut self, power_mw: f64, timestamp_ms: u64) {
        self.power_readings.push(power_mw);
        self.timestamps_ms.push(timestamp_ms);
    }

    pub fn analyze(&mut self) -> Result<(), String> {
        if self.power_readings.len() < 10 {
            return Err("Insufficient readings for analysis".to_string());
        }

        // Detect patterns
        self.detect_intermittent_computing();
        self.detect_deep_sleep();
        self.detect_thermal_throttling();
        self.detect_network_wakeup();
        self.detect_sensor_spikes();
        self.detect_dvfs_transitions();
        self.detect_cache_contention();
        self.detect_page_fault_storms();
        self.detect_context_switch_heavy();
        self.detect_interrupt_nesting();

        Ok(())
    }

    fn detect_intermittent_computing(&mut self) {
        // Pattern: power jumps from ~0 to 50+ mW, then back to near 0
        let mut confidence = 0.0;

        for i in 1..self.power_readings.len() - 1 {
            let prev = self.power_readings[i - 1];
            let curr = self.power_readings[i];
            let next = self.power_readings[i + 1];

            if prev < 10.0 && curr > 40.0 && next < 10.0 {
                confidence += 0.1;
            }
        }

        confidence = (confidence / self.power_readings.len() as f64).min(1.0);
        if confidence > 0.2 {
            self.detected_patterns.push((ExtendedPowerPattern::IntermittentComputing, confidence));
        }
    }

    fn detect_deep_sleep(&mut self) {
        // Pattern: power stays very low (< 5mW) for extended period
        let low_count = self.power_readings.iter().filter(|&&p| p < 5.0).count();
        let confidence = low_count as f64 / self.power_readings.len() as f64;

        if confidence > 0.5 {
            self.detected_patterns.push((ExtendedPowerPattern::DeepSleep, confidence));
        }
    }

    fn detect_thermal_throttling(&mut self) {
        // Pattern: power drops and stays lower (throttle signature)
        if self.power_readings.len() > 10 {
            let first_half_avg = self.power_readings[..self.power_readings.len() / 2]
                .iter().sum::<f64>() / (self.power_readings.len() / 2) as f64;
            let second_half_avg = self.power_readings[self.power_readings.len() / 2..]
                .iter().sum::<f64>() / (self.power_readings.len() / 2) as f64;

            let reduction = (first_half_avg - second_half_avg) / first_half_avg;
            if reduction > 0.2 && reduction < 0.6 {
                self.detected_patterns.push((ExtendedPowerPattern::ThermalThrottling, reduction));
            }
        }
    }

    fn detect_network_wakeup(&mut self) {
        // Pattern: single spike from baseline
        let avg = self.power_readings.iter().sum::<f64>() / self.power_readings.len() as f64;
        let max = self.power_readings.iter().copied().fold(0.0, f64::max);

        let spike_ratio = if avg > 0.0 { max / avg } else { 1.0 };
        if spike_ratio > 3.0 {
            self.detected_patterns.push((ExtendedPowerPattern::NetworkWakeup, spike_ratio / 10.0));
        }
    }

    fn detect_sensor_spikes(&mut self) {
        // Pattern: regular small spikes every ~1 second
        let mut spike_count = 0;
        for i in 1..self.power_readings.len() {
            if self.power_readings[i] > self.power_readings[i - 1] * 1.5 {
                spike_count += 1;
            }
        }

        let confidence = spike_count as f64 / self.power_readings.len() as f64;
        if confidence > 0.1 && confidence < 0.5 {
            self.detected_patterns.push((ExtendedPowerPattern::SensorSamplingSpike, confidence));
        }
    }

    fn detect_dvfs_transitions(&mut self) {
        // Pattern: rapid power changes (voltage/frequency switching)
        let mut changes = 0;
        for i in 1..self.power_readings.len() {
            let change_rate = (self.power_readings[i] - self.power_readings[i - 1]).abs();
            if change_rate > 20.0 {
                changes += 1;
            }
        }

        let confidence = changes as f64 / self.power_readings.len() as f64;
        if confidence > 0.05 {
            self.detected_patterns.push((ExtendedPowerPattern::DynamicVoltageSpike, confidence));
        }
    }

    fn detect_cache_contention(&mut self) {
        // Pattern: sustained elevated power with high variance
        let avg = self.power_readings.iter().sum::<f64>() / self.power_readings.len() as f64;
        let variance = self.power_readings.iter()
            .map(|&p| (p - avg).powi(2))
            .sum::<f64>() / self.power_readings.len() as f64;

        let stddev = variance.sqrt();
        let coefficient_of_variation = stddev / avg;

        if avg > 80.0 && coefficient_of_variation > 0.3 {
            self.detected_patterns.push((ExtendedPowerPattern::CacheLineContention, coefficient_of_variation));
        }
    }

    fn detect_page_fault_storms(&mut self) {
        // Pattern: rapid spiky variations in power
        let mut spike_variance = 0.0;
        for i in 1..self.power_readings.len() {
            spike_variance += (self.power_readings[i] - self.power_readings[i - 1]).abs();
        }
        spike_variance /= self.power_readings.len() as f64;

        if spike_variance > 50.0 {
            self.detected_patterns.push((ExtendedPowerPattern::PageFaultStorm, (spike_variance / 100.0).min(1.0)));
        }
    }

    fn detect_context_switch_heavy(&mut self) {
        // Pattern: high power with frequent transitions
        let avg = self.power_readings.iter().sum::<f64>() / self.power_readings.len() as f64;

        if avg > 100.0 {
            let mut transitions = 0;
            for i in 1..self.power_readings.len() {
                if (self.power_readings[i] > avg) != (self.power_readings[i - 1] > avg) {
                    transitions += 1;
                }
            }

            let confidence = transitions as f64 / self.power_readings.len() as f64;
            if confidence > 0.2 {
                self.detected_patterns.push((ExtendedPowerPattern::ContextSwitchHeavy, confidence));
            }
        }
    }

    fn detect_interrupt_nesting(&mut self) {
        // Pattern: very rapid high-frequency spikes
        let avg = self.power_readings.iter().sum::<f64>() / self.power_readings.len() as f64;
        let mut rapid_spikes = 0;

        for i in 2..self.power_readings.len() {
            if self.power_readings[i - 1] > avg * 1.5 && self.power_readings[i] > avg * 1.5 {
                rapid_spikes += 1;
            }
        }

        let confidence = rapid_spikes as f64 / self.power_readings.len() as f64;
        if confidence > 0.1 {
            self.detected_patterns.push((ExtendedPowerPattern::InterruptNesting, confidence));
        }
    }

    pub fn get_top_patterns(&self, count: usize) -> Vec<(ExtendedPowerPattern, f64)> {
        let mut sorted = self.detected_patterns.clone();
        sorted.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));
        sorted.into_iter().take(count).collect()
    }

    pub fn detection_accuracy(&self) -> f64 {
        if self.detected_patterns.is_empty() {
            return 0.0;
        }
        self.detected_patterns.iter().map(|(_, conf)| conf).sum::<f64>()
            / self.detected_patterns.len() as f64
    }
}

// Clone impl for ExtendedPowerPattern
impl Clone for ExtendedPowerPattern {
    fn clone(&self) -> Self {
        match self {
            ExtendedPowerPattern::MemoryLeak => ExtendedPowerPattern::MemoryLeak,
            ExtendedPowerPattern::IOBottleneck => ExtendedPowerPattern::IOBottleneck,
            ExtendedPowerPattern::ThreadContention => ExtendedPowerPattern::ThreadContention,
            ExtendedPowerPattern::PeriodicLoad => ExtendedPowerPattern::PeriodicLoad,
            ExtendedPowerPattern::CacheThreshing => ExtendedPowerPattern::CacheThreshing,
            ExtendedPowerPattern::CombinedPressure => ExtendedPowerPattern::CombinedPressure,
            ExtendedPowerPattern::IntermittentComputing => ExtendedPowerPattern::IntermittentComputing,
            ExtendedPowerPattern::DeepSleep => ExtendedPowerPattern::DeepSleep,
            ExtendedPowerPattern::ThermalThrottling => ExtendedPowerPattern::ThermalThrottling,
            ExtendedPowerPattern::NetworkWakeup => ExtendedPowerPattern::NetworkWakeup,
            ExtendedPowerPattern::SensorSamplingSpike => ExtendedPowerPattern::SensorSamplingSpike,
            ExtendedPowerPattern::DynamicVoltageSpike => ExtendedPowerPattern::DynamicVoltageSpike,
            ExtendedPowerPattern::CacheLineContention => ExtendedPowerPattern::CacheLineContention,
            ExtendedPowerPattern::PageFaultStorm => ExtendedPowerPattern::PageFaultStorm,
            ExtendedPowerPattern::ContextSwitchHeavy => ExtendedPowerPattern::ContextSwitchHeavy,
            ExtendedPowerPattern::InterruptNesting => ExtendedPowerPattern::InterruptNesting,
        }
    }
}

// ============================================================================
// Tests (40 lines)
// ============================================================================

mod tests {
    use super::*;

    #[test]
    fn test_extended_pattern_creation() {
        let sig = ExtendedPatternSignature::new(ExtendedPowerPattern::IntermittentComputing);
        assert!(sig.base_power_mw > 0.0);
    }

    #[test]
    fn test_pattern_detector() {
        let mut detector = PatternDetector::new();

        // Simulate intermittent computing: 0-50-0-50-0
        for i in 0..10 {
            let power = if i % 2 == 0 { 5.0 } else { 50.0 };
            detector.add_reading(power, (i * 100) as u64);
        }

        assert!(detector.analyze().is_ok());
    }

    #[test]
    fn test_detect_deep_sleep() {
        let mut detector = PatternDetector::new();

        for i in 0..20 {
            detector.add_reading(3.0, (i * 100) as u64);  // Low power
        }

        assert!(detector.analyze().is_ok());
        assert!(!detector.detected_patterns.is_empty());
    }

    #[test]
    fn test_all_extended_patterns() {
        let patterns = vec![
            ExtendedPowerPattern::IntermittentComputing,
            ExtendedPowerPattern::DeepSleep,
            ExtendedPowerPattern::ThermalThrottling,
            ExtendedPowerPattern::NetworkWakeup,
        ];

        for pattern in patterns {
            let sig = ExtendedPatternSignature::new(pattern);
            assert!(sig.base_power_mw > 0.0);
        }
    }
}
