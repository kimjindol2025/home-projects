// Phase 3 Week 1: Demand Response Planner (390줄)
// Purpose: Generate power management actions based on energy forecasts

pub enum PowerAction {
    IncreaseFrequency,      // Boost performance
    MaintainFrequency,      // Stable operation
    ReduceFrequency,        // Save power
    ActivateSleep,          // Enter sleep state
    PreventiveThrottling,   // Preemptive thermal control
    BalancedMode,           // Balanced power/performance
}

pub struct DemandPlan {
    pub action: PowerAction,
    pub target_frequency_mhz: u32,
    pub sleep_state: String,
    pub duration_ms: u32,
    pub confidence_percent: f64,
    pub rationale: String,
}

pub struct DemandResponsePlanner {
    pub forecast_power_mw: f64,
    pub current_power_mw: f64,
    pub battery_remaining_percent: f64,
    pub thermal_headroom_percent: f64,
    pub workload_type: String,
    pub plan: DemandPlan,
    pub plans_generated: u32,
    pub plan_execution_rate: f64,
}

impl DemandResponsePlanner {
    pub fn new() -> Self {
        DemandResponsePlanner {
            forecast_power_mw: 150.0,
            current_power_mw: 150.0,
            battery_remaining_percent: 50.0,
            thermal_headroom_percent: 50.0,
            workload_type: "Mixed".to_string(),
            plan: DemandPlan {
                action: PowerAction::MaintainFrequency,
                target_frequency_mhz: 2000,
                sleep_state: "C0".to_string(),
                duration_ms: 0,
                confidence_percent: 0.0,
                rationale: String::new(),
            },
            plans_generated: 0,
            plan_execution_rate: 0.0,
        }
    }

    pub fn generate_response_plan(&mut self, forecast_power_mw: f64, horizon_ms: u32) -> DemandPlan {
        self.forecast_power_mw = forecast_power_mw;

        let mut action = PowerAction::MaintainFrequency;
        let mut target_freq = 2000u32;
        let mut sleep_state = "C0".to_string();
        let mut confidence = 80.0;
        let mut rationale = String::new();

        // Decision 1: Battery level critical?
        if self.battery_remaining_percent < 15.0 {
            action = PowerAction::ReduceFrequency;
            target_freq = 1200;
            rationale = "Battery critical (<15%)".to_string();
            confidence = 95.0;
        }
        // Decision 2: Thermal pressure?
        else if self.thermal_headroom_percent < 25.0 {
            action = PowerAction::PreventiveThrottling;
            target_freq = 1800;
            rationale = "Preemptive thermal control".to_string();
            confidence = 90.0;
        }
        // Decision 3: Power forecast high?
        else if forecast_power_mw > 200.0 {
            action = PowerAction::ReduceFrequency;
            target_freq = 1600;
            rationale = format!("High power forecast ({}mW)", forecast_power_mw as i32);
            confidence = 75.0;
        }
        // Decision 4: Power forecast low?
        else if forecast_power_mw < 100.0 {
            action = PowerAction::ActivateSleep;
            sleep_state = if horizon_ms > 5000 { "C3".to_string() } else { "C1".to_string() };
            rationale = format!("Low power opportunity ({}mW)", forecast_power_mw as i32);
            confidence = 85.0;
        }
        // Decision 5: Workload type
        else if self.workload_type == "Interactive" {
            action = PowerAction::IncreaseFrequency;
            target_freq = 2800;
            rationale = "Interactive workload needs responsiveness".to_string();
            confidence = 80.0;
        }
        // Decision 6: Balanced mode
        else {
            action = PowerAction::BalancedMode;
            target_freq = 2000;
            sleep_state = "C2".to_string();
            rationale = "Balanced power/performance mode".to_string();
            confidence = 80.0;
        }

        self.plan = DemandPlan {
            action,
            target_frequency_mhz: target_freq,
            sleep_state,
            duration_ms: horizon_ms,
            confidence_percent: confidence,
            rationale,
        };

        self.plans_generated += 1;

        DemandPlan {
            action: self.plan.action,
            target_frequency_mhz: self.plan.target_frequency_mhz,
            sleep_state: self.plan.sleep_state.clone(),
            duration_ms: self.plan.duration_ms,
            confidence_percent: self.plan.confidence_percent,
            rationale: self.plan.rationale.clone(),
        }
    }

    pub fn estimate_power_reduction(&self) -> f64 {
        let base_reduction = match self.plan.action {
            PowerAction::IncreaseFrequency => 0.0,
            PowerAction::MaintainFrequency => 0.0,
            PowerAction::ReduceFrequency => 20.0,
            PowerAction::ActivateSleep => 150.0,
            PowerAction::PreventiveThrottling => 30.0,
            PowerAction::BalancedMode => 10.0,
        };

        let battery_factor = if self.battery_remaining_percent < 20.0 { 1.3 } else { 1.0 };
        (base_reduction * battery_factor).min(self.current_power_mw)
    }

    pub fn describe(&self) -> String {
        format!(
            "DemandPlan: action={:?}, freq={}MHz, sleep={}, \
            confidence={:.0}%, reduction={}mW",
            self.plan.action,
            self.plan.target_frequency_mhz,
            self.plan.sleep_state,
            self.plan.confidence_percent,
            self.estimate_power_reduction() as i32
        )
    }
}

mod tests {
    use super::*;

    #[test]
    fn test_planner_creation() {
        let planner = DemandResponsePlanner::new();
        assert_eq!(planner.battery_remaining_percent, 50.0);
    }

    #[test]
    fn test_battery_critical_response() {
        let mut planner = DemandResponsePlanner::new();
        planner.battery_remaining_percent = 10.0;
        let plan = planner.generate_response_plan(150.0, 5000);
        
        // Should reduce frequency when battery critical
        assert!(plan.target_frequency_mhz < 2000);
    }

    #[test]
    fn test_thermal_response() {
        let mut planner = DemandResponsePlanner::new();
        planner.thermal_headroom_percent = 20.0;
        let plan = planner.generate_response_plan(150.0, 5000);
        
        // Should throttle when thermal pressure
        assert!(plan.target_frequency_mhz < 2200);
    }

    #[test]
    fn test_high_power_forecast() {
        let mut planner = DemandResponsePlanner::new();
        planner.battery_remaining_percent = 50.0;
        planner.thermal_headroom_percent = 50.0;
        let plan = planner.generate_response_plan(220.0, 5000);
        
        assert!(plan.target_frequency_mhz <= 1600);
    }

    #[test]
    fn test_low_power_forecast_activates_sleep() {
        let mut planner = DemandResponsePlanner::new();
        let plan = planner.generate_response_plan(80.0, 6000);
        
        assert!(plan.sleep_state != "C0");
    }

    #[test]
    fn test_interactive_workload_boost() {
        let mut planner = DemandResponsePlanner::new();
        planner.workload_type = "Interactive".to_string();
        let plan = planner.generate_response_plan(150.0, 5000);
        
        assert!(plan.target_frequency_mhz > 2500);
    }

    #[test]
    fn test_power_reduction_estimation() {
        let mut planner = DemandResponsePlanner::new();
        planner.current_power_mw = 150.0;
        planner.plan.action = PowerAction::ActivateSleep;
        
        let reduction = planner.estimate_power_reduction();
        assert!(reduction > 100.0);
    }

    #[test]
    fn test_plan_confidence_varies() {
        let mut planner = DemandResponsePlanner::new();
        
        let plan1 = planner.generate_response_plan(150.0, 5000);
        let conf1 = plan1.confidence_percent;
        
        planner.battery_remaining_percent = 5.0;
        let plan2 = planner.generate_response_plan(150.0, 5000);
        let conf2 = plan2.confidence_percent;
        
        assert!(conf2 >= conf1);
    }
}
