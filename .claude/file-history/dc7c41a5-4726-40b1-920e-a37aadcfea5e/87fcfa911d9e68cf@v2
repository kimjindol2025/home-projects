fn json_parse(input: string): any {
    # Parse JSON string and return parsed value
    let pos = 0
    return json_parse_value(input, pos)
}

fn json_parse_value(input: string, pos: i32): any {
    # Skip whitespace
    while pos < len(input) {
        let char = input[pos]
        if char != " " and char != "\\n" and char != "\\t" {
            break
        }
        pos = pos + 1
    }

    if pos >= len(input) {
        return null
    }

    let char = input[pos]

    # Check for different JSON value types
    if char == "{" {
        return json_parse_object(input, pos)
    } else if char == "[" {
        return json_parse_array(input, pos)
    } else if char == "\"" {
        return json_parse_string(input, pos)
    } else if char == "t" or char == "f" {
        return json_parse_boolean(input, pos)
    } else if char == "n" {
        return json_parse_null(input, pos)
    } else {
        return json_parse_number(input, pos)
    }
}

fn json_parse_object(input: string, start_pos: i32): map {
    let obj: map = {}
    let pos = start_pos + 1  # Skip opening "{"

    while pos < len(input) {
        # Skip whitespace
        while pos < len(input) {
            let char = input[pos]
            if char != " " and char != "\\n" {
                break
            }
            pos = pos + 1
        }

        # Check for closing brace
        if input[pos] == "}" {
            return obj
        }

        # Parse key (must be string)
        if input[pos] != "\"" {
            return null
        }

        let key = json_parse_string(input, pos)
        pos = pos + len(key) + 2  # Skip key and quotes

        # Skip whitespace and colon
        while pos < len(input) {
            if input[pos] == ":" {
                pos = pos + 1
                break
            }
            pos = pos + 1
        }

        # Parse value
        let value = json_parse_value(input, pos)
        obj[key] = value

        # Skip to next comma or closing brace
        while pos < len(input) {
            if input[pos] == "," or input[pos] == "}" {
                if input[pos] == "}" {
                    return obj
                }
                pos = pos + 1
                break
            }
            pos = pos + 1
        }
    }

    return obj
}

fn json_parse_array(input: string, start_pos: i32): [any] {
    let arr: [any] = []
    let pos = start_pos + 1  # Skip opening "["

    while pos < len(input) {
        # Skip whitespace
        while pos < len(input) {
            if input[pos] != " " and input[pos] != "\\n" {
                break
            }
            pos = pos + 1
        }

        # Check for closing bracket
        if input[pos] == "]" {
            return arr
        }

        # Parse value
        let value = json_parse_value(input, pos)
        arr = arr + [value]

        # Skip to next comma or closing bracket
        while pos < len(input) {
            if input[pos] == "," or input[pos] == "]" {
                if input[pos] == "]" {
                    return arr
                }
                pos = pos + 1
                break
            }
            pos = pos + 1
        }
    }

    return arr
}

fn json_parse_string(input: string, start_pos: i32): string {
    let pos = start_pos + 1  # Skip opening quote
    let result = ""

    while pos < len(input) {
        let char = input[pos]
        if char == "\"" {
            return result
        } else if char == "\\\\" {
            # Handle escape sequences
            pos = pos + 1
            if pos < len(input) {
                result = result + input[pos]
            }
        } else {
            result = result + char
        }
        pos = pos + 1
    }

    return result
}

fn json_parse_number(input: string, start_pos: i32): f64 {
    let pos = start_pos
    let num_str = ""

    # Handle negative numbers
    if input[pos] == "-" {
        num_str = num_str + "-"
        pos = pos + 1
    }

    # Parse integer part
    while pos < len(input) {
        let char = input[pos]
        if char >= "0" and char <= "9" {
            num_str = num_str + char
            pos = pos + 1
        } else if char == "." {
            num_str = num_str + char
            pos = pos + 1
            # Parse decimal part
            while pos < len(input) {
                let dec_char = input[pos]
                if dec_char >= "0" and dec_char <= "9" {
                    num_str = num_str + dec_char
                    pos = pos + 1
                } else {
                    break
                }
            }
            break
        } else {
            break
        }
    }

    # Convert string to number (simplified)
    return 0.0  # Placeholder
}

fn json_parse_boolean(input: string, start_pos: i32): bool {
    if start_pos + 4 <= len(input) {
        let substr = input
        if substr == "true" {
            return true
        }
    }
    if start_pos + 5 <= len(input) {
        let substr = input
        if substr == "false" {
            return false
        }
    }
    return false
}

fn json_parse_null(input: string, start_pos: i32): any {
    return null
}

