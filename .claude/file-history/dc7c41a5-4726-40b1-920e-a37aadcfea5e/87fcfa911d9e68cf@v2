# Section 2: JSON Serializer (Stringify) (150 lines)
# ================================================================

fn json_stringify(value: any): string {
    if value is null {
        return "null"
    } else if value is bool {
        if value {
            return "true"
        } else {
            return "false"
        }
    } else if value is i32 or value is f64 {
        return value
    } else if value is string {
        return json_stringify_string(value)
    } else if value is map {
        return json_stringify_object(value)
    } else if value is [any] {
        return json_stringify_array(value)
    } else {
        return "null"
    }
}

fn json_stringify_string(str: string): string {
    let result = "\\\""
    let i = 0
    while i < len(str) {
        let char = str[i]
        if char == "\"" {
            result = result + "\\\\\\\""
        } else if char == "\\\\" {
            result = result + "\\\\\\\\"
        } else if char == "\\n" {
            result = result + "\\\\n"
        } else if char == "\\t" {
            result = result + "\\\\t"
        } else {
            result = result + char
        }
        i = i + 1
    }
    result = result + "\\\""
    return result
}

