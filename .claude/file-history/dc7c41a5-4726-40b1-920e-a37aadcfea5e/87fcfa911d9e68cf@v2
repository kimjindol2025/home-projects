# Section 3: JSON Utilities (50 lines)
# ================================================================

fn json_get(obj: map, path: string): any {
    # Get nested value using dot notation: "user.name.first"
    let keys = json_split_path(path)
    let current = obj

    let i = 0
    while i < len(keys) {
        if current is map {
            current = current[keys[i]]
        } else {
            return null
        }
        i = i + 1
    }

    return current
}

fn json_set(obj: map, path: string, value: any): map {
    # Set nested value using dot notation
    let keys = json_split_path(path)
    let current = obj
    let i = 0

    while i < len(keys) - 1 {
        let key = keys[i]
        if not (key in current) {
            current[key] = {}
        }
        current = current[key]
        i = i + 1
    }

    current[keys[len(keys) - 1]] = value
    return obj
}

fn json_split_path(path: string): [string] {
    # Split "a.b.c" into ["a", "b", "c"]
    let parts: [string] = []
    let current = ""
    let i = 0

    while i < len(path) {
        let char = path[i]
        if char == "." {
            if len(current) > 0 {
                parts = parts + [current]
            }
            current = ""
        } else {
            current = current + char
        }
        i = i + 1
    }

    if len(current) > 0 {
        parts = parts + [current]
    }

    return parts
}

