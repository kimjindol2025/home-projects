// Phase 3.1.3 Fixed-Point (16.16) 연산 라이브러리
// 베어메탈 환경에서 정수 연산만으로 고정 소수점 연산 수행
// 정밀도: 0.0000152587890625 (1/65536)

pub type Fixed16 = i32;

pub const FIXED_SHIFT: i32 = 16;
pub const FIXED_ONE: Fixed16 = 1 << FIXED_SHIFT;      // 1.0 = 65536
pub const FIXED_HALF: Fixed16 = FIXED_ONE >> 1;        // 0.5 = 32768
pub const FIXED_QUARTER: Fixed16 = FIXED_ONE >> 2;     // 0.25 = 16384

// 변환: 정수 → 고정 소수점
pub fn from_int(n: i32) -> Fixed16 {
    n << FIXED_SHIFT
}

// 변환: 고정 소수점 → 정수 (반올림)
pub fn to_int(f: Fixed16) -> i32 {
    (f + FIXED_HALF) >> FIXED_SHIFT
}

// 변환: 고정 소수점 → f64 (디버깅 용)
pub fn to_f64(f: Fixed16) -> f64 {
    (f as f64) / (FIXED_ONE as f64)
}

// 곱셈: a * b (오버플로우 방지)
pub fn mul(a: Fixed16, b: Fixed16) -> Fixed16 {
    (((a as i64) * (b as i64)) >> FIXED_SHIFT) as Fixed16
}

// 나눗셈: a / b (division by zero 예방)
pub fn div(a: Fixed16, b: Fixed16) -> Fixed16 {
    if b == 0 {
        return 0;  // Contract: 0으로 나누기는 0 반환
    }
    (((a as i64) << FIXED_SHIFT) / (b as i64)) as Fixed16
}

// 절댓값
pub fn abs(a: Fixed16) -> Fixed16 {
    if a < 0 { -a } else { a }
}

// 제곱: a²
pub fn square(a: Fixed16) -> Fixed16 {
    mul(a, a)
}

// 세제곱: a³
pub fn cube(a: Fixed16) -> Fixed16 {
    mul(square(a), a)
}

// 음수 판정
pub fn is_negative(a: Fixed16) -> bool {
    a < 0
}

// 부호 변경
pub fn negate(a: Fixed16) -> Fixed16 {
    -a
}

// 3차 다항식 평가: f(t) = at³ + bt² + ct + d
pub fn eval_cubic(a: Fixed16, b: Fixed16, c: Fixed16, d: Fixed16, t: Fixed16) -> Fixed16 {
    let t2 = square(t);
    let t3 = cube(t);

    let term_a = mul(a, t3);
    let term_b = mul(b, t2);
    let term_c = mul(c, t);

    term_a + term_b + term_c + d
}

// 3차 다항식 미분: f'(t) = 3at² + 2bt + c
pub fn eval_cubic_derivative(a: Fixed16, b: Fixed16, c: Fixed16, t: Fixed16) -> Fixed16 {
    let t2 = square(t);

    let term_a = mul(mul(a, from_int(3)), t2);
    let term_b = mul(mul(b, from_int(2)), t);

    term_a + term_b + c
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_fixed_conversion() {
        assert_eq!(from_int(1), FIXED_ONE);
        assert_eq!(from_int(2), FIXED_ONE * 2);
        assert_eq!(to_int(FIXED_ONE), 1);
    }

    #[test]
    fn test_fixed_multiplication() {
        let half = FIXED_ONE / 2;
        let result = mul(half, from_int(2));
        assert_eq!(result, FIXED_ONE);
    }

    #[test]
    fn test_fixed_division() {
        let result = div(FIXED_ONE * 2, from_int(2));
        assert_eq!(result, FIXED_ONE);
    }

    #[test]
    fn test_division_by_zero() {
        let result = div(FIXED_ONE, 0);
        assert_eq!(result, 0);  // Contract: 안전한 반환
    }

    #[test]
    fn test_cubic_evaluation() {
        // f(t) = t³ + t² + t + 1 at t=1 should be 4
        let a = FIXED_ONE;
        let b = FIXED_ONE;
        let c = FIXED_ONE;
        let d = FIXED_ONE;
        let t = FIXED_ONE;

        let result = eval_cubic(a, b, c, d, t);
        let expected = FIXED_ONE * 4;

        assert_eq!(result, expected);
    }

    #[test]
    fn test_cubic_derivative() {
        // f'(t) = 3t² + 2t + 1 at t=1 should be 6
        let a = FIXED_ONE;
        let b = FIXED_ONE;
        let c = FIXED_ONE;
        let t = FIXED_ONE;

        let result = eval_cubic_derivative(a, b, c, t);
        let expected = FIXED_ONE * 6;

        assert_eq!(result, expected);
    }
}
