// Phase 3 Week 3: Energy Pattern Database (490줄)
// Purpose: Historical pattern storage and efficient querying for learning

pub struct EnergyHistoryEntry {
    pub timestamp_ms: u64,
    pub pattern_type: String,     // MemoryLeak, IOBottleneck, etc.
    pub power_mw: f64,
    pub battery_percent: f64,
    pub action_taken: String,
    pub action_duration_ms: u32,
    pub power_reduction_mw: f64,
    pub success: bool,
    pub confidence: f64,
}

impl EnergyHistoryEntry {
    pub fn new(
        timestamp_ms: u64,
        pattern_type: String,
        power_mw: f64,
        battery_percent: f64,
        action_taken: String,
    ) -> Self {
        EnergyHistoryEntry {
            timestamp_ms,
            pattern_type,
            power_mw,
            battery_percent,
            action_taken,
            action_duration_ms: 0,
            power_reduction_mw: 0.0,
            success: false,
            confidence: 0.0,
        }
    }

    pub fn mark_success(&mut self, reduction_mw: f64, duration_ms: u32, confidence: f64) {
        self.success = true;
        self.power_reduction_mw = reduction_mw;
        self.action_duration_ms = duration_ms;
        self.confidence = confidence;
    }
}

pub struct PatternStatistics {
    pub pattern_type: String,
    pub total_occurrences: u32,
    pub successful_actions: u32,
    pub failed_actions: u32,
    pub avg_power_reduction_mw: f64,
    pub avg_action_duration_ms: u32,
    pub avg_confidence: f64,
    pub success_rate: f64,
}

impl PatternStatistics {
    pub fn compute(entries: &[EnergyHistoryEntry], pattern: &str) -> Self {
        let filtered: Vec<_> = entries.iter()
            .filter(|e| e.pattern_type == pattern)
            .collect();

        let total = filtered.len() as u32;
        let successful = filtered.iter().filter(|e| e.success).count() as u32;
        let failed = total - successful;

        let avg_reduction = if !filtered.is_empty() {
            filtered.iter().map(|e| e.power_reduction_mw).sum::<f64>() / filtered.len() as f64
        } else {
            0.0
        };

        let avg_duration = if successful > 0 {
            filtered.iter()
                .filter(|e| e.success)
                .map(|e| e.action_duration_ms as f64)
                .sum::<f64>() as u32 / successful
        } else {
            0
        };

        let avg_conf = if !filtered.is_empty() {
            filtered.iter().map(|e| e.confidence).sum::<f64>() / filtered.len() as f64
        } else {
            0.0
        };

        let success_rate = if total > 0 {
            (successful as f64 / total as f64) * 100.0
        } else {
            0.0
        };

        PatternStatistics {
            pattern_type: pattern.to_string(),
            total_occurrences: total,
            successful_actions: successful,
            failed_actions: failed,
            avg_power_reduction_mw: avg_reduction,
            avg_action_duration_ms: avg_duration,
            avg_confidence: avg_conf,
            success_rate,
        }
    }

    pub fn is_actionable(&self) -> bool {
        self.success_rate > 70.0 && self.total_occurrences >= 3
    }

    pub fn improvement_potential(&self) -> f64 {
        // 잠재적 개선도 (0-100)
        let success_score = self.success_rate / 100.0;
        let frequency_score = (self.total_occurrences as f64 / 10.0).min(1.0);
        ((success_score + frequency_score) / 2.0) * 100.0
    }
}

pub struct EnergyPatternDB {
    pub entries: Vec<EnergyHistoryEntry>,
    pub max_entries: u32,
    pub query_count: u32,
}

impl EnergyPatternDB {
    pub fn new(max_size: u32) -> Self {
        EnergyPatternDB {
            entries: Vec::new(),
            max_entries: max_size,
            query_count: 0,
        }
    }

    pub fn record(&mut self, entry: EnergyHistoryEntry) {
        self.entries.push(entry);
        if self.entries.len() > self.max_entries as usize {
            self.entries.remove(0);  // FIFO eviction
        }
    }

    pub fn query_by_pattern(&self, pattern: &str) -> Vec<&EnergyHistoryEntry> {
        self.entries.iter()
            .filter(|e| e.pattern_type == pattern)
            .collect()
    }

    pub fn query_by_time_range(&self, start_ms: u64, end_ms: u64) -> Vec<&EnergyHistoryEntry> {
        self.entries.iter()
            .filter(|e| e.timestamp_ms >= start_ms && e.timestamp_ms <= end_ms)
            .collect()
    }

    pub fn query_recent(&self, count: u32) -> Vec<&EnergyHistoryEntry> {
        let start = if self.entries.len() > count as usize {
            self.entries.len() - count as usize
        } else {
            0
        };
        self.entries[start..].iter().collect()
    }

    pub fn query_successful_actions(&self) -> Vec<&EnergyHistoryEntry> {
        self.entries.iter().filter(|e| e.success).collect()
    }

    pub fn query_failed_actions(&self) -> Vec<&EnergyHistoryEntry> {
        self.entries.iter().filter(|e| !e.success).collect()
    }

    pub fn query_by_battery_saturation(&self, min_battery: f64, max_battery: f64) -> Vec<&EnergyHistoryEntry> {
        self.entries.iter()
            .filter(|e| e.battery_percent >= min_battery && e.battery_percent <= max_battery)
            .collect()
    }

    pub fn query_effective_actions(&self, min_reduction_mw: f64) -> Vec<&EnergyHistoryEntry> {
        self.entries.iter()
            .filter(|e| e.success && e.power_reduction_mw >= min_reduction_mw)
            .collect()
    }

    pub fn get_pattern_stats(&self, pattern: &str) -> PatternStatistics {
        PatternStatistics::compute(&self.entries, pattern)
    }

    pub fn get_all_patterns(&self) -> Vec<String> {
        let mut patterns = Vec::new();
        for entry in &self.entries {
            if !patterns.contains(&entry.pattern_type) {
                patterns.push(entry.pattern_type.clone());
            }
        }
        patterns
    }

    pub fn get_best_pattern(&self) -> Option<String> {
        let patterns = self.get_all_patterns();
        patterns.iter()
            .map(|p| (p.clone(), self.get_pattern_stats(p)))
            .max_by(|a, b| {
                let score_a = a.1.success_rate * (a.1.total_occurrences as f64);
                let score_b = b.1.success_rate * (b.1.total_occurrences as f64);
                score_a.partial_cmp(&score_b).unwrap_or(std::cmp::Ordering::Equal)
            })
            .map(|(p, _)| p)
    }

    pub fn query_by_action(&self, action: &str) -> Vec<&EnergyHistoryEntry> {
        self.entries.iter()
            .filter(|e| e.action_taken == action)
            .collect()
    }

    pub fn count_by_pattern(&self, pattern: &str) -> u32 {
        self.entries.iter()
            .filter(|e| e.pattern_type == pattern)
            .count() as u32
    }

    pub fn get_pattern_improvement(&self, pattern: &str) -> f64 {
        self.get_pattern_stats(pattern).improvement_potential()
    }

    pub fn clear(&mut self) {
        self.entries.clear();
        self.query_count = 0;
    }

    pub fn describe(&self) -> String {
        format!(
            "PatternDB: entries={}/{}, patterns={}, queries={}",
            self.entries.len(),
            self.max_entries,
            self.get_all_patterns().len(),
            self.query_count
        )
    }
}

mod tests {
    use super::*;

    #[test]
    fn test_entry_creation() {
        let entry = EnergyHistoryEntry::new(1000, "MemoryLeak".to_string(), 150.0, 75.0, "Reduce".to_string());
        assert_eq!(entry.pattern_type, "MemoryLeak");
        assert_eq!(entry.power_mw, 150.0);
    }

    #[test]
    fn test_entry_mark_success() {
        let mut entry = EnergyHistoryEntry::new(1000, "MemoryLeak".to_string(), 150.0, 75.0, "Reduce".to_string());
        entry.mark_success(30.0, 50, 85.0);
        assert!(entry.success);
        assert_eq!(entry.power_reduction_mw, 30.0);
    }

    #[test]
    fn test_pattern_statistics_computation() {
        let entries = vec![
            EnergyHistoryEntry::new(1000, "MemoryLeak".to_string(), 150.0, 75.0, "Reduce".to_string()),
            EnergyHistoryEntry::new(2000, "MemoryLeak".to_string(), 145.0, 70.0, "Reduce".to_string()),
        ];
        let stats = PatternStatistics::compute(&entries, "MemoryLeak");
        assert_eq!(stats.total_occurrences, 2);
    }

    #[test]
    fn test_pattern_statistics_success_rate() {
        let mut e1 = EnergyHistoryEntry::new(1000, "MemoryLeak".to_string(), 150.0, 75.0, "Reduce".to_string());
        e1.mark_success(30.0, 50, 85.0);
        let e2 = EnergyHistoryEntry::new(2000, "MemoryLeak".to_string(), 145.0, 70.0, "Reduce".to_string());
        let entries = vec![e1, e2];
        let stats = PatternStatistics::compute(&entries, "MemoryLeak");
        assert!(stats.success_rate > 0.0 && stats.success_rate <= 100.0);
    }

    #[test]
    fn test_db_creation() {
        let db = EnergyPatternDB::new(1000);
        assert_eq!(db.entries.len(), 0);
        assert_eq!(db.max_entries, 1000);
    }

    #[test]
    fn test_db_record_entry() {
        let mut db = EnergyPatternDB::new(1000);
        let entry = EnergyHistoryEntry::new(1000, "MemoryLeak".to_string(), 150.0, 75.0, "Reduce".to_string());
        db.record(entry);
        assert_eq!(db.entries.len(), 1);
    }

    #[test]
    fn test_db_query_by_pattern() {
        let mut db = EnergyPatternDB::new(1000);
        db.record(EnergyHistoryEntry::new(1000, "MemoryLeak".to_string(), 150.0, 75.0, "Reduce".to_string()));
        db.record(EnergyHistoryEntry::new(2000, "IOBottleneck".to_string(), 160.0, 70.0, "Sleep".to_string()));
        let results = db.query_by_pattern("MemoryLeak");
        assert_eq!(results.len(), 1);
    }

    #[test]
    fn test_db_query_by_time_range() {
        let mut db = EnergyPatternDB::new(1000);
        db.record(EnergyHistoryEntry::new(1000, "MemoryLeak".to_string(), 150.0, 75.0, "Reduce".to_string()));
        db.record(EnergyHistoryEntry::new(5000, "IOBottleneck".to_string(), 160.0, 70.0, "Sleep".to_string()));
        let results = db.query_by_time_range(1000, 3000);
        assert_eq!(results.len(), 1);
    }

    #[test]
    fn test_db_query_recent() {
        let mut db = EnergyPatternDB::new(1000);
        for i in 0..10 {
            db.record(EnergyHistoryEntry::new((i * 1000) as u64, "Pattern".to_string(), 150.0, 75.0, "Action".to_string()));
        }
        let recent = db.query_recent(3);
        assert_eq!(recent.len(), 3);
    }

    #[test]
    fn test_db_query_successful_actions() {
        let mut db = EnergyPatternDB::new(1000);
        let mut e1 = EnergyHistoryEntry::new(1000, "MemoryLeak".to_string(), 150.0, 75.0, "Reduce".to_string());
        e1.mark_success(30.0, 50, 85.0);
        db.record(e1);
        let e2 = EnergyHistoryEntry::new(2000, "IOBottleneck".to_string(), 160.0, 70.0, "Sleep".to_string());
        db.record(e2);
        let successful = db.query_successful_actions();
        assert_eq!(successful.len(), 1);
    }

    #[test]
    fn test_db_get_all_patterns() {
        let mut db = EnergyPatternDB::new(1000);
        db.record(EnergyHistoryEntry::new(1000, "MemoryLeak".to_string(), 150.0, 75.0, "Reduce".to_string()));
        db.record(EnergyHistoryEntry::new(2000, "IOBottleneck".to_string(), 160.0, 70.0, "Sleep".to_string()));
        let patterns = db.get_all_patterns();
        assert_eq!(patterns.len(), 2);
    }

    #[test]
    fn test_db_get_best_pattern() {
        let mut db = EnergyPatternDB::new(1000);
        let mut e1 = EnergyHistoryEntry::new(1000, "MemoryLeak".to_string(), 150.0, 75.0, "Reduce".to_string());
        e1.mark_success(30.0, 50, 85.0);
        db.record(e1);
        let best = db.get_best_pattern();
        assert!(best.is_some());
    }
