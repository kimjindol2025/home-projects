// Green-Distributed-Fabric Phase 2+ Week 2: Pattern Clustering Engine
// Purpose: Consolidate 16 patterns into 8 optimized clusters for 95%+ detection accuracy
// Strategy: K-means clustering, feature extraction, similarity-based grouping

// ============================================================================
// Part 1: Pattern Similarity Analysis (220 lines)
// ============================================================================

pub enum PowerPatternCluster {
    IdleStates,           // Cluster 1: Low-power idle patterns
    ComputeHeavy,         // Cluster 2: High CPU, predictable
    MemoryStress,         // Cluster 3: Memory-dominated
    IOOperations,         // Cluster 4: I/O-dominated
    ThermalManagement,    // Cluster 5: Thermal throttling
    InterruptHandling,    // Cluster 6: Interrupt-driven
    NetworkActivity,      // Cluster 7: Network-related
    MixedWorkloads,       // Cluster 8: Balanced mixed
}

pub struct PatternFeatures {
    pub power_mean_mw: f64,
    pub power_variance: f64,
    pub power_max_mw: f64,
    pub frequency_hz: f64,
    pub transition_rate: f64,
    pub periodicity: f64,
    pub cpu_dependency: f64,      // 0.0-1.0 correlation with CPU
    pub memory_dependency: f64,   // 0.0-1.0 correlation with memory
}

impl PatternFeatures {
    pub fn new() -> Self {
        PatternFeatures {
            power_mean_mw: 0.0,
            power_variance: 0.0,
            power_max_mw: 0.0,
            frequency_hz: 0.0,
            transition_rate: 0.0,
            periodicity: 0.0,
            cpu_dependency: 0.0,
            memory_dependency: 0.0,
        }
    }

    pub fn extract_from_readings(readings: &[f64]) -> Self {
        let mut features = PatternFeatures::new();

        if readings.is_empty() {
            return features;
        }

        // Mean and max
        features.power_mean_mw = readings.iter().sum::<f64>() / readings.len() as f64;
        features.power_max_mw = readings.iter().copied().fold(f64::NEG_INFINITY, f64::max);

        // Variance
        features.power_variance = readings.iter()
            .map(|r| (r - features.power_mean_mw).powi(2))
            .sum::<f64>() / readings.len() as f64;

        // Transition rate (power changes)
        let mut transitions = 0;
        for i in 1..readings.len() {
            if (readings[i] - readings[i-1]).abs() > 10.0 {  // >10mW change
                transitions += 1;
            }
        }
        features.transition_rate = transitions as f64 / readings.len() as f64;

        // Estimate periodicity (simplified)
        features.periodicity = Self::estimate_periodicity(readings);

        features
    }

    fn estimate_periodicity(readings: &[f64]) -> f64 {
        // Check for repeating patterns
        if readings.len() < 4 {
            return 0.0;
        }

        // Simple autocorrelation check at period=4
        let correlation = readings[..readings.len()-4].iter()
            .zip(&readings[4..])
            .map(|(a, b)| (a - readings.iter().sum::<f64>() / readings.len() as f64) *
                           (b - readings.iter().sum::<f64>() / readings.len() as f64))
            .sum::<f64>() / (readings.len() - 4) as f64;

        (correlation / readings.iter().map(|r| (r - readings.iter().sum::<f64>() / readings.len() as f64).powi(2)).sum::<f64>()).abs().min(1.0)
    }

    pub fn euclidean_distance(&self, other: &PatternFeatures) -> f64 {
        // Calculate feature distance for clustering
        let d1 = (self.power_mean_mw - other.power_mean_mw) / 200.0;  // Normalize
        let d2 = (self.power_variance - other.power_variance) / 500.0;
        let d3 = (self.transition_rate - other.transition_rate);
        let d4 = (self.periodicity - other.periodicity);
        let d5 = (self.cpu_dependency - other.cpu_dependency);
        let d6 = (self.memory_dependency - other.memory_dependency);

        (d1*d1 + d2*d2 + d3*d3 + d4*d4 + d5*d5 + d6*d6).sqrt()
    }

    pub fn describe(&self) -> String {
        format!(
            "Features: mean={:.0}mW, var={:.0}, max={:.0}mW, \
            trans_rate={:.2}, period={:.2}, cpu_dep={:.2}, mem_dep={:.2}",
            self.power_mean_mw, self.power_variance, self.power_max_mw,
            self.transition_rate, self.periodicity, self.cpu_dependency, self.memory_dependency
        )
    }
}

