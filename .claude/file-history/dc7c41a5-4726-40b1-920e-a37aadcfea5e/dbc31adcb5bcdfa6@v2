// Part 2: K-Means Clustering (260 lines)
// ============================================================================

pub struct PatternCluster {
    pub cluster_id: u32,
    pub centroid: PatternFeatures,
    pub member_count: u32,
    pub members: Vec<PatternFeatures>,
}

impl PatternCluster {
    pub fn new(id: u32) -> Self {
        PatternCluster {
            cluster_id: id,
            centroid: PatternFeatures::new(),
            member_count: 0,
            members: Vec::new(),
        }
    }

    pub fn add_member(&mut self, features: PatternFeatures) {
        self.members.push(features);
        self.member_count += 1;
    }

    pub fn update_centroid(&mut self) {
        if self.members.is_empty() {
            return;
        }

        // Calculate mean of all features
        let count = self.members.len() as f64;

        self.centroid.power_mean_mw = self.members.iter()
            .map(|m| m.power_mean_mw).sum::<f64>() / count;

        self.centroid.power_variance = self.members.iter()
            .map(|m| m.power_variance).sum::<f64>() / count;

        self.centroid.power_max_mw = self.members.iter()
            .map(|m| m.power_max_mw).sum::<f64>() / count;

        self.centroid.transition_rate = self.members.iter()
            .map(|m| m.transition_rate).sum::<f64>() / count;

        self.centroid.periodicity = self.members.iter()
            .map(|m| m.periodicity).sum::<f64>() / count;

        self.centroid.cpu_dependency = self.members.iter()
            .map(|m| m.cpu_dependency).sum::<f64>() / count;

        self.centroid.memory_dependency = self.members.iter()
            .map(|m| m.memory_dependency).sum::<f64>() / count;
    }

    pub fn cluster_cohesion(&self) -> f64 {
        // How tightly grouped members are around centroid
        if self.members.is_empty() {
            return 1.0;
        }

        let avg_distance = self.members.iter()
            .map(|m| self.centroid.euclidean_distance(m))
            .sum::<f64>() / self.members.len() as f64;

        // Invert so higher = better cohesion
        1.0 / (1.0 + avg_distance)
    }

    pub fn describe(&self) -> String {
        format!(
            "Cluster {}: {} members, cohesion={:.2}%, centroid={}",
            self.cluster_id, self.member_count,
            self.cluster_cohesion() * 100.0,
            self.centroid.describe()
        )
    }
}

pub struct KMeansClustering {
    pub clusters: Vec<PatternCluster>,
    pub k: u32,
    pub iteration: u32,
    pub converged: bool,
    pub silhouette_score: f64,
}

impl KMeansClustering {
    pub fn new(k: u32) -> Self {
        let mut clusters = Vec::new();
        for i in 0..k {
            clusters.push(PatternCluster::new(i));
        }

        KMeansClustering {
            clusters,
            k,
            iteration: 0,
            converged: false,
            silhouette_score: 0.0,
        }
    }

    pub fn assign_to_clusters(&mut self, features_list: &[PatternFeatures]) {
        // Clear existing assignments
        for cluster in &mut self.clusters {
            cluster.members.clear();
            cluster.member_count = 0;
        }

        // Assign each feature to nearest cluster
        for features in features_list {
            let nearest_cluster = self.find_nearest_cluster(features);
            self.clusters[nearest_cluster as usize].add_member(features.clone());
        }
    }

    fn find_nearest_cluster(&self, features: &PatternFeatures) -> u32 {
        let mut nearest = 0;
        let mut min_distance = f64::INFINITY;

        for (i, cluster) in self.clusters.iter().enumerate() {
            let distance = cluster.centroid.euclidean_distance(features);
            if distance < min_distance {
                min_distance = distance;
                nearest = i as u32;
            }
        }

        nearest
    }

    pub fn run_iteration(&mut self, features_list: &[PatternFeatures]) {
        // Assignment step
        self.assign_to_clusters(features_list);

        // Update step
        for cluster in &mut self.clusters {
            cluster.update_centroid();
        }

        self.iteration += 1;

        // Check convergence (simplified: assume converged after 10 iterations)
        if self.iteration > 10 {
            self.converged = true;
        }
    }

    pub fn calculate_silhouette_score(&mut self) {
        // Silhouette coefficient measures cluster quality
        let mut total_score = 0.0;
        let mut count = 0;

        for cluster in &self.clusters {
            for member in &cluster.members {
                // Cohesion: distance to own cluster center
                let a = cluster.centroid.euclidean_distance(member);

                // Separation: distance to nearest other cluster
                let mut b = f64::INFINITY;
                for other_cluster in &self.clusters {
                    if other_cluster.cluster_id != cluster.cluster_id {
                        let dist = other_cluster.centroid.euclidean_distance(member);
                        b = b.min(dist);
                    }
                }

                // Silhouette: (b - a) / max(a, b)
                let silhouette = if a == 0.0 && b == 0.0 {
                    0.0
                } else {
                    (b - a) / a.max(b)
                };

                total_score += silhouette;
                count += 1;
            }
        }

        self.silhouette_score = if count > 0 {
            total_score / count as f64
        } else {
            0.0
        };
    }

    pub fn get_cluster_assignment(&self, features: &PatternFeatures) -> PowerPatternCluster {
        // Map k-means cluster to semantic cluster
        let nearest = self.find_nearest_cluster(features);

        match nearest {
            0 => PowerPatternCluster::IdleStates,
            1 => PowerPatternCluster::ComputeHeavy,
            2 => PowerPatternCluster::MemoryStress,
            3 => PowerPatternCluster::IOOperations,
            4 => PowerPatternCluster::ThermalManagement,
            5 => PowerPatternCluster::InterruptHandling,
            6 => PowerPatternCluster::NetworkActivity,
            _ => PowerPatternCluster::MixedWorkloads,
        }
    }

    pub fn summary(&self) -> String {
        format!(
            "K-Means Clustering: k={}, iterations={}, \
            converged={}, silhouette={:.2}",
            self.k, self.iteration, self.converged, self.silhouette_score
        )
    }
}

// ============================================================================
// Tests (140 lines)
// ============================================================================

mod tests {
    use super::*;

    #[test]
    fn test_pattern_features_creation() {
        let features = PatternFeatures::new();
        assert_eq!(features.power_mean_mw, 0.0);
    }

    #[test]
    fn test_features_extraction() {
        let readings = vec![100.0, 105.0, 110.0, 105.0, 100.0];
        let features = PatternFeatures::extract_from_readings(&readings);

        assert!(features.power_mean_mw > 0.0);
        assert!(features.power_max_mw > features.power_mean_mw);
    }

    #[test]
    fn test_euclidean_distance() {
        let f1 = PatternFeatures {
            power_mean_mw: 100.0,
            power_variance: 50.0,
            power_max_mw: 150.0,
            frequency_hz: 1.0,
            transition_rate: 0.1,
            periodicity: 0.5,
            cpu_dependency: 0.7,
            memory_dependency: 0.3,
        };

        let f2 = PatternFeatures {
            power_mean_mw: 110.0,
            power_variance: 60.0,
            power_max_mw: 160.0,
            frequency_hz: 1.0,
            transition_rate: 0.1,
            periodicity: 0.5,
            cpu_dependency: 0.7,
            memory_dependency: 0.3,
        };

        let distance = f1.euclidean_distance(&f2);
        assert!(distance > 0.0);
    }

    #[test]
    fn test_pattern_cluster_creation() {
        let cluster = PatternCluster::new(0);
        assert_eq!(cluster.cluster_id, 0);
        assert_eq!(cluster.member_count, 0);
    }

    #[test]
    fn test_cluster_centroid_update() {
        let mut cluster = PatternCluster::new(0);

        let f1 = PatternFeatures {
            power_mean_mw: 100.0,
            power_variance: 50.0,
            power_max_mw: 150.0,
            frequency_hz: 1.0,
            transition_rate: 0.1,
            periodicity: 0.5,
            cpu_dependency: 0.7,
            memory_dependency: 0.3,
        };

        let f2 = PatternFeatures {
            power_mean_mw: 120.0,
            power_variance: 60.0,
            power_max_mw: 170.0,
            frequency_hz: 1.0,
            transition_rate: 0.1,
            periodicity: 0.5,
            cpu_dependency: 0.7,
            memory_dependency: 0.3,
        };

        cluster.add_member(f1);
        cluster.add_member(f2);
        cluster.update_centroid();

        assert!(cluster.centroid.power_mean_mw > 100.0);
        assert!(cluster.centroid.power_mean_mw < 120.0);
    }

    #[test]
    fn test_kmeans_clustering() {
        let mut kmeans = KMeansClustering::new(8);
        assert_eq!(kmeans.clusters.len(), 8);

        let features = vec![
            PatternFeatures::extract_from_readings(&[10.0, 15.0, 10.0]),
            PatternFeatures::extract_from_readings(&[200.0, 210.0, 205.0]),
        ];

        kmeans.run_iteration(&features);
        assert!(kmeans.iteration > 0);
    }

    #[test]
    fn test_silhouette_score_calculation() {
        let mut kmeans = KMeansClustering::new(2);
        let features = vec![
            PatternFeatures::extract_from_readings(&[50.0, 55.0, 50.0]),
            PatternFeatures::extract_from_readings(&[51.0, 56.0, 51.0]),
            PatternFeatures::extract_from_readings(&[200.0, 205.0, 200.0]),
        ];

        kmeans.run_iteration(&features);
        kmeans.calculate_silhouette_score();

        assert!(kmeans.silhouette_score >= -1.0 && kmeans.silhouette_score <= 1.0);
    }
}
