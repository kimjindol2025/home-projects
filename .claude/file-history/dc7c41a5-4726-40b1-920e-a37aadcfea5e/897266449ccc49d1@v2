// Phase 3.2 부팅 통합
// 나노 커널 → SDF 폰트 엔진 → 디버그 콘솔

use crate::integration::FontEngine;
use crate::console::{FrameBuffer, TextRenderer, TextLayout, Color};

pub struct KernelConsole {
    pub font_engine: FontEngine,
    pub frame_buffer: FrameBuffer,
    pub text_renderer: TextRenderer,
    pub initialized: bool,
}

impl KernelConsole {
    /// 커널 콘솔 초기화
    pub fn new(ttf_data: Vec<u8>) -> Self {
        let font_engine = FontEngine::new(ttf_data);
        let frame_buffer = FrameBuffer::new_default();
        let text_renderer = TextRenderer::new(font_engine);

        KernelConsole {
            font_engine: text_renderer.font,
            frame_buffer,
            text_renderer,
            initialized: false,
        }
    }

    /// 부팅 화면 초기화
    pub fn init(&mut self) -> bool {
        // 화면을 검은색으로 지우기
        self.frame_buffer.clear(Color::black());

        // 부팅 메시지 렌더링
        let layout = TextLayout::new(50, 50, 24)
            .with_color(Color::white());

        self.text_renderer.render_text(&mut self.frame_buffer, "Booting...", layout);

        self.initialized = true;
        true
    }

    /// "GOGS" 텍스트 100pt로 렌더링 (최종 목표)
    pub fn render_gogs(&mut self) -> bool {
        if !self.initialized {
            return false;
        }

        // 화면 중앙에 "GOGS" 100pt
        let text_width = self.text_renderer.measure_text("GOGS", 100);
        let x = ((800 - text_width) / 2).max(0);
        let y = 250;

        let layout = TextLayout::new(x, y, 100)
            .with_color(Color::white());

        self.text_renderer.render_text(&mut self.frame_buffer, "GOGS", layout);

        true
    }

    /// 커널 메시지 출력 (콘솔)
    pub fn print(&mut self, message: &str) -> bool {
        // 스크롤 처리 (간단화): 위에서 아래로 렌더링
        let layout = TextLayout::new(20, 500, 12)
            .with_color(Color::white());

        self.text_renderer.render_text(&mut self.frame_buffer, message, layout);
        true
    }

    /// 패닉 메시지 (빨강 텍스트)
    pub fn panic(&mut self, message: &str) -> bool {
        let layout = TextLayout::new(50, 300, 18)
            .with_color(Color::new(255, 0, 0, 255));  // 빨강

        self.text_renderer.render_text(&mut self.frame_buffer, "PANIC:", layout);

        let msg_layout = TextLayout::new(50, 350, 14)
            .with_color(Color::new(255, 100, 100, 255));  // 연한 빨강

        self.text_renderer.render_text(&mut self.frame_buffer, message, msg_layout);
        true
    }

    /// 프레임버퍼 플러시 (화면 업데이트)
    pub fn flush_display(&mut self) -> usize {
        let dirty_count = self.frame_buffer.dirty_count();
        self.frame_buffer.clear_dirty();
        dirty_count
    }

    /// 부팅 완료 확인
    pub fn is_ready(&self) -> bool {
        self.initialized && self.frame_buffer.dirty_count() == 0
    }

    /// 메모리 사용량 (bytes)
    pub fn memory_usage(&self) -> usize {
        self.frame_buffer.memory_usage()
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_kernel_console_creation() {
        let console = KernelConsole::new(vec![0x00; 500]);
        assert!(!console.initialized);
    }

    #[test]
    fn test_kernel_console_init() {
        let mut console = KernelConsole::new(vec![0x00; 500]);
        let result = console.init();

        assert!(result);
        assert!(console.initialized);
    }

    #[test]
    fn test_render_gogs() {
        let mut console = KernelConsole::new(vec![0x00; 500]);
        console.init();

        let result = console.render_gogs();
        assert!(result);
    }

    #[test]
    fn test_print_message() {
        let mut console = KernelConsole::new(vec![0x00; 500]);
        console.init();

        let result = console.print("Hello, Kernel!");
        assert!(result);
    }

    #[test]
    fn test_panic_message() {
        let mut console = KernelConsole::new(vec![0x00; 500]);
        console.init();

        let result = console.panic("Out of memory");
        assert!(result);
    }

    #[test]
    fn test_memory_usage() {
        let console = KernelConsole::new(vec![0x00; 500]);
        let memory = console.memory_usage();

        // 800×600×4 = 1,920,000 bytes (약 1.8 MB)
        assert!(memory > 1_000_000);
        assert!(memory < 3_000_000);  // < 3 MB
    }

    #[test]
    fn test_is_ready() {
        let mut console = KernelConsole::new(vec![0x00; 500]);
        assert!(!console.is_ready());

        console.init();
        // 초기화 후 더티 플래그가 있으므로 아직 ready 아님

        console.flush_display();
        // 플러시 후 ready
    }
}
