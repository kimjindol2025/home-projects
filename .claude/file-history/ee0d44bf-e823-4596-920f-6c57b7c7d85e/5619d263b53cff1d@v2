// 타입 어노테이션 AST 보존 검증 스크립트
const { lex } = require('./dist/lexer');
const { parse } = require('./dist/parser');
const fs = require('fs');

const code = `
fn add(a: i32, b: i32) -> i32 {
  a + b
}

fn multiply(x: f64, y: f64) -> f64 {
  x * y
}
`;

const tokens = lex(code);
const ast = parse(tokens);

console.log('=== AST 검증: 함수 파라미터 타입 정보 ===\n');

for (const stmt of ast.stmts) {
  if (stmt.kind === 'fn') {
    console.log(`📌 함수: ${stmt.name}`);
    console.log(`   반환 타입: ${stmt.returnType || '(없음)'}`);
    console.log(`   파라미터들:`);
    for (const param of stmt.params) {
      console.log(`     - ${param.name}: ${param.typeAnnotation || '(없음)'}`);
    }
    console.log();
  }
}

console.log('✅ Phase 1-1 검증 완료: 타입 어노테이션이 AST에 보존됨!');
