enum TokenKind {
  Number,
  String,
  Ident
}

enum Token {
  Tok(TokenKind, string, i32)
}

enum ExprList {
  Nil,
  Cons(Token, ExprList)
}

fn kind_to_string(k) {
  match k {
    TokenKind.Number => "Number",
    TokenKind.String => "String",
    TokenKind.Ident => "Ident"
  }
}

fn list_length(lst) {
  match lst {
    ExprList.Nil => 0,
    ExprList.Cons(head, tail) => 1 + list_length(tail)
  }
}

fn main() {
  let num_kind = TokenKind.Number
  let str_kind = TokenKind.String
  let id_kind = TokenKind.Ident
  print(kind_to_string(num_kind))
}
