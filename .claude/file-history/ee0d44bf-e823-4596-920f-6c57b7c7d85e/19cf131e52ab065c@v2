enum List {
  Nil,
  Cons(i32, List)
}

enum Option {
  Some(List),
  None
}

fn first_element(opt_list) {
  match opt_list {
    Option.Some(lst) => {
      match lst {
        List.Nil => 0,
        List.Cons(head, tail) => head
      }
    },
    Option.None => 0
  }
}

fn length(lst) {
  match lst {
    List.Nil => 0,
    List.Cons(head, tail) => 1 + length(tail)
  }
}

fn main() {
  let list1 = List.Cons(10, List.Nil)
  let list2 = List.Cons(20, list1)
  let opt1 = Option.Some(list2)
  let result = first_element(opt1)
  print(result)
}
