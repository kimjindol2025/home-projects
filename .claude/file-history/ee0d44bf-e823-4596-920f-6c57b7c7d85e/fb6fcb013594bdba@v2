enum Result {
  Ok(i32),
  Err(string)
}

enum Option {
  Some(i32),
  None
}

enum Tree {
  Leaf(i32),
  Node(i32, Tree, Tree)
}

fn safe_divide(a, b) {
  match Result.Ok(b) {
    Result.Ok(divisor) => {
      match Result.Ok(a) {
        Result.Ok(dividend) => Result.Ok(dividend),
        Result.Err(msg) => Result.Err(msg)
      }
    },
    Result.Err(msg) => Result.Err(msg)
  }
}

fn sum_tree(t) {
  match t {
    Tree.Leaf(val) => val,
    Tree.Node(val, left, right) => val + sum_tree(left) + sum_tree(right)
  }
}

fn opt_extract(opt) {
  match opt {
    Option.Some(x) => x,
    Option.None => 0
  }
}

fn main() {
  let ok_val = Result.Ok(42)
  let err_val = Result.Err("division by zero")
  let some_val = Option.Some(100)
  let none_val = Option.None
  print(ok_val)
}
