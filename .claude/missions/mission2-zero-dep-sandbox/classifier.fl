module zero_dep_sandbox

# ============================================================
# ImportClassifier: import 라인 분류 (Internal/External/Stdlib)
# ============================================================

struct ImportClassification {
  import_line: String
  classification: String  # "internal" | "external" | "stdlib"
  package_name: String
}

# 화이트리스트: Go stdlib 패키지
func is_stdlib(pkg: String) -> Bool {
  var std_packages: Array<String> = [
    "encoding/json",
    "encoding/xml",
    "encoding/base64",
    "io",
    "os",
    "path",
    "path/filepath",
    "strings",
    "fmt",
    "bytes",
    "bufio",
    "crypto",
    "crypto/sha256",
    "hash",
    "hash/fnv",
    "time",
    "math",
    "sort",
    "regexp",
    "strconv",
    "log",
    "testing",
    "net",
    "net/http",
    "flag",
    "context",
    "sync",
    "runtime",
    "reflect",
  ]

  var i: Int = 0
  while i < len(std_packages) {
    if std_packages[i] == pkg {
      return true
    }
    i = i + 1
  }
  return false
}

# import 라인 파싱 및 분류
func classify_import(line: String) -> ImportClassification {
  var pkg: String = extract_package_name(line)
  var classification: String = classify_package(pkg)

  return ImportClassification{
    import_line: line,
    classification: classification,
    package_name: pkg,
  }
}

func extract_package_name(line: String) -> String {
  # Go 스타일: import "package/name"
  if contains(line, "import \"") {
    var start: Int = find_index(line, "\"") + 1
    var end: Int = find_index_from(line, "\"", start)
    if start > 0 && end > start {
      return line[start:end]
    }
  }

  # FreeLang 스타일: @use package/name
  if contains(line, "@use ") {
    var parts: Array<String> = split_by_whitespace(line)
    if len(parts) >= 2 {
      return parts[1]
    }
  }

  # JavaScript/TypeScript: import from "package"
  if contains(line, "from \"") {
    var start: Int = find_index(line, "from \"") + 6
    var end: Int = find_index_from(line, "\"", start)
    if start > 0 && end > start {
      return line[start:end]
    }
  }

  return ""
}

func classify_package(pkg: String) -> String {
  if pkg == "" {
    return "unknown"
  }

  # Internal 패턴
  if contains(pkg, "internal/") {
    return "internal"
  }

  # FreeLang stdlib 패턴
  if contains(pkg, "stdlib/") {
    return "internal"
  }

  # Go stdlib 확인
  if is_stdlib(pkg) {
    return "stdlib"
  }

  # 상대 경로 (로컬)
  if contains(pkg, "./") || contains(pkg, "../") {
    return "internal"
  }

  # 외부 패턴 (github.com, npm 패키지, etc)
  if contains(pkg, "/") && !contains(pkg, "internal") {
    return "external"
  }

  # 기본값: 로컬 패키지
  return "internal"
}

# ============================================================
# 문자열 유틸
# ============================================================

func contains(s: String, substr: String) -> Bool {
  var i: Int = 0
  while i <= len(s) - len(substr) {
    if s[i:i+len(substr)] == substr {
      return true
    }
    i = i + 1
  }
  return false
}

func find_index(s: String, substr: String) -> Int {
  var i: Int = 0
  while i <= len(s) - len(substr) {
    if s[i:i+len(substr)] == substr {
      return i
    }
    i = i + 1
  }
  return -1
}

func find_index_from(s: String, substr: String, start: Int) -> Int {
  var i: Int = start
  while i <= len(s) - len(substr) {
    if s[i:i+len(substr)] == substr {
      return i
    }
    i = i + 1
  }
  return -1
}

func split_by_whitespace(s: String) -> Array<String> {
  var result: Array<String> = []
  var current: String = ""
  var i: Int = 0

  while i < len(s) {
    var ch: String = s[i:i+1]
    if ch == " " || ch == "\t" || ch == "\n" {
      if len(current) > 0 {
        result = append(result, current)
        current = ""
      }
    } else {
      current = current + ch
    }
    i = i + 1
  }

  if len(current) > 0 {
    result = append(result, current)
  }

  return result
}

func trim_space(s: String) -> String {
  var start: Int = 0
  var end: Int = len(s)

  while start < end && (s[start:start+1] == " " || s[start:start+1] == "\t") {
    start = start + 1
  }

  while end > start && (s[end-1:end] == " " || s[end-1:end] == "\t") {
    end = end - 1
  }

  return s[start:end]
}
