# ============================================================
# Test 3: test_classify_internal — "internal/ast" → Internal
# ============================================================
func TestClassifyInternal(t *testing.T) {
  var line string = `import "internal/ast"`
  var result ImportClassification = classify_import(line)

  if result.classification != "internal" {
    t.Errorf("expected 'internal', got '%s'", result.classification)
  }
  if result.package_name != "internal/ast" {
    t.Errorf("expected 'internal/ast', got '%s'", result.package_name)
  }

  t.Log("PASS: test_classify_internal")
}

# ============================================================
# Test 4: test_classify_stdlib — "encoding/json" → Stdlib
# ============================================================
func TestClassifyStdlib(t *testing.T) {
  var line string = `import "encoding/json"`
  var result ImportClassification = classify_import(line)

  if result.classification != "stdlib" {
    t.Errorf("expected 'stdlib', got '%s'", result.classification)
  }

  t.Log("PASS: test_classify_stdlib")
}

