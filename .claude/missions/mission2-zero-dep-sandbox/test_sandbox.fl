# ============================================================
# Test 11: test_whitelist_stdlib — stdlib은 허용 목록 유지
# ============================================================
func TestWhitelistStdlib(t *testing.T) {
  if !is_stdlib("encoding/json") {
    t.Errorf("encoding/json should be in stdlib")
  }
  if !is_stdlib("net/http") {
    t.Errorf("net/http should be in stdlib")
  }
  if is_stdlib("github.com/unknown") {
    t.Errorf("github.com/unknown should NOT be in stdlib")
  }

  t.Log("PASS: test_whitelist_stdlib")
}

