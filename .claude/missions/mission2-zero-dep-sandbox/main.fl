package main

import "fmt"
import "os"

# ============================================================
# Zero-Dep-Sandbox Main CLI
# ============================================================

type ViolationReport struct {
  has_violations bool
  violations     []ImportClassification
  external_count int
  report_text    string
}

func main() {
  if len(os.Args) < 2 {
    print_usage()
    os.Exit(1)
  }

  var cmd string = os.Args[1]

  if cmd == "check" || cmd == "" {
    var target_dir string = "."
    if len(os.Args) > 2 {
      target_dir = os.Args[2]
    }

    var result int = check_dependencies(target_dir)
    os.Exit(result)

  } else if cmd == "report" {
    var target_dir string = "."
    if len(os.Args) > 2 {
      target_dir = os.Args[2]
    }

    generate_report(target_dir)
    os.Exit(0)

  } else if cmd == "test" {
    run_tests()
    os.Exit(0)

  } else if cmd == "--help" || cmd == "-h" {
    print_usage()
    os.Exit(0)

  } else {
    fmt.Printf("unknown command: %s\n", cmd)
    print_usage()
    os.Exit(1)
  }
}

