module zero_dep_sandbox

import "os"
import "path/filepath"

# ============================================================
# Scanner: 파일시스템 스캔 후 import 추출
# ============================================================

struct FilePath {
  name: String
  path: String
  ext: String
}

struct ImportLine {
  file_path: String
  line_num: Int
  content: String
}

# 프로젝트 디렉토리를 스캔하여 .go, .fl, .ts 파일 목록 반환
func scan_project(root_dir: String) -> Array<FilePath> {
  var result: Array<FilePath> = []
  scan_recursive(root_dir, result)
  return result
}

func scan_recursive(dir: String, result: Array<FilePath>) {
  var entries: Array<DirEntry>
  entries, _ = os.ReadDir(dir)

  for _, entry := range entries {
    var full_path: String = filepath.Join(dir, entry.Name())

    if entry.IsDir() {
      # 숨긴 디렉토리와 특수 디렉토리 제외
      if !should_skip_dir(entry.Name()) {
        scan_recursive(full_path, result)
      }
    } else {
      # 파일 확장자 확인
      var file: FilePath = parse_file_path(full_path, entry.Name())
      if is_source_file(file.ext) {
        append(result, file)
      }
    }
  }
}

func should_skip_dir(name: String) -> Bool {
  if name == "." || name == ".." {
    return true
  }
  if name[0:1] == "." {  # 숨긴 디렉토리
    return true
  }
  if name == "node_modules" || name == ".git" || name == "__pycache__" {
    return true
  }
  return false
}

func parse_file_path(full_path: String, name: String) -> FilePath {
  var ext: String = ""
  var dot_idx: Int = -1

  for i := len(name) - 1; i >= 0; i-- {
    if name[i:i+1] == "." {
      dot_idx = i
      break
    }
  }

  if dot_idx >= 0 {
    ext = name[dot_idx+1:]
  }

  return FilePath{
    name: name,
    path: full_path,
    ext: ext,
  }
}

func is_source_file(ext: String) -> Bool {
  return ext == "go" || ext == "fl" || ext == "ts" || ext == "js"
}

# 파일에서 import 라인 추출
func extract_imports(file_path: String) -> Array<ImportLine> {
  var result: Array<ImportLine> = []
  var content: String
  var err: error

  content, err = os.ReadFile(file_path)
  if err != nil {
    return result
  }

  var lines: Array<String> = split_lines(string(content))
  var line_num: Int = 1

  for _, line := range lines {
    if is_import_line(line) {
      var import_obj: ImportLine = ImportLine{
        file_path: file_path,
        line_num: line_num,
        content: line,
      }
      append(result, import_obj)
    }
    line_num++
  }

  return result
}

func is_import_line(line: String) -> Bool {
  var trimmed: String = strings.TrimSpace(line)

  # Go 스타일
  if strings.HasPrefix(trimmed, "import \"") || strings.HasPrefix(trimmed, "import (") {
    return true
  }

  # FreeLang 스타일
  if strings.HasPrefix(trimmed, "@use ") {
    return true
  }

  # JavaScript/TypeScript
  if strings.HasPrefix(trimmed, "import ") || strings.HasPrefix(trimmed, "require(") {
    return true
  }

  return false
}

func split_lines(content: String) -> Array<String> {
  return strings.Split(content, "\n")
}
