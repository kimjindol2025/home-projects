module pulse_common

# KVStore: 키-값 저장소
struct KVEntry {
  key: String
  value: String
}

struct KVStore {
  entries: Array<KVEntry>
}

# FreqTable: 빈도 테이블
struct FreqEntry {
  key: String
  count: Int
}

struct FreqTable {
  entries: Array<FreqEntry>
}

# ============================================================
# FNV-1a 해시 (32bit) — profiler/pattern.go에서 이식
# ============================================================
@inline
func fnv1a_hash(s: String) -> Int {
  var h: Int = 2166136261  # FNV offset basis (32bit)
  var i: Int = 0
  var len: Int = string_len(s)

  while i < len {
    var byte_val: Int = string_byte(s, i)
    h = (h ^ byte_val) * 16777619  # FNV prime
    i = i + 1
  }

  return h
}

# ============================================================
# KV Store 함수들
# ============================================================

func kv_new() -> KVStore {
  var store: KVStore = {entries: array_new()}
  return store
}

func kv_get(store: KVStore, key: String) -> String {
  var i: Int = 0
  var len: Int = array_len(store.entries)

  while i < len {
    var entry: KVEntry = array_get(store.entries, i)
    if string_eq(entry.key, key) {
      return entry.value
    }
    i = i + 1
  }

  return ""  # 없음
}

func kv_set(store: KVStore, key: String, val: String) -> KVStore {
  var i: Int = 0
  var len: Int = array_len(store.entries)

  # 기존 키 업데이트
  while i < len {
    var entry: KVEntry = array_get(store.entries, i)
    if string_eq(entry.key, key) {
      entry.value = val
      array_set(store.entries, i, entry)
      return store
    }
    i = i + 1
  }

  # 새 항목 추가
  var new_entry: KVEntry = {key: key, value: val}
  array_push(store.entries, new_entry)

  return store
}

func kv_exists(store: KVStore, key: String) -> Bool {
  var val: String = kv_get(store, key)
  return !string_eq(val, "")
}

# ============================================================
# Frequency Table 함수들
# ============================================================

func freq_new() -> FreqTable {
  var table: FreqTable = {entries: array_new()}
  return table
}

func freq_increment(table: FreqTable, key: String) -> FreqTable {
  var i: Int = 0
  var len: Int = array_len(table.entries)

  # 기존 항목 증가
  while i < len {
    var entry: FreqEntry = array_get(table.entries, i)
    if string_eq(entry.key, key) {
      entry.count = entry.count + 1
      array_set(table.entries, i, entry)
      return table
    }
    i = i + 1
  }

  # 새 항목 생성
  var new_entry: FreqEntry = {key: key, count: 1}
  array_push(table.entries, new_entry)

  return table
}

func freq_get(table: FreqTable, key: String) -> Int {
  var i: Int = 0
  var len: Int = array_len(table.entries)

  while i < len {
    var entry: FreqEntry = array_get(table.entries, i)
    if string_eq(entry.key, key) {
      return entry.count
    }
    i = i + 1
  }

  return 0
}

# 상위 N개 키 반환 (count 기준 내림차순)
func freq_top(table: FreqTable, n: Int) -> Array<String> {
  var result: Array<String> = array_new()
  var sorted: Array<FreqEntry> = array_copy(table.entries)

  # 간단한 버블정렬 (내림차순)
  var i: Int = 0
  var len: Int = array_len(sorted)
  while i < len {
    var j: Int = 0
    while j < len - i - 1 {
      var e1: FreqEntry = array_get(sorted, j)
      var e2: FreqEntry = array_get(sorted, j + 1)
      if e1.count < e2.count {
        # 스왑
        array_set(sorted, j, e2)
        array_set(sorted, j + 1, e1)
      }
      j = j + 1
    }
    i = i + 1
  }

  # 상위 N개 추출
  i = 0
  while i < n && i < array_len(sorted) {
    var entry: FreqEntry = array_get(sorted, i)
    array_push(result, entry.key)
    i = i + 1
  }

  return result
}

# ============================================================
# 문자열 유틸
# ============================================================

@inline
func string_len(s: String) -> Int {
  return len(s)
}

@inline
func string_byte(s: String, idx: Int) -> Int {
  var b: Int = (s[idx] as Int)
  return b
}

@inline
func string_eq(s1: String, s2: String) -> Bool {
  return s1 == s2
}

func string_contains(s: String, substr: String) -> Bool {
  var i: Int = 0
  var s_len: Int = string_len(s)
  var sub_len: Int = string_len(substr)

  while i <= s_len - sub_len {
    var j: Int = 0
    var match: Bool = true

    while j < sub_len {
      if string_byte(s, i + j) != string_byte(substr, j) {
        match = false
        break
      }
      j = j + 1
    }

    if match {
      return true
    }
    i = i + 1
  }

  return false
}

# 날짜 헤더 파싱: "## 2026-03-28" → "2026-03-28"
func parse_date_header(line: String) -> String {
  var parts: Array<String> = string_split(line, " ")
  if array_len(parts) >= 2 {
    return array_get(parts, array_len(parts) - 1)
  }
  return ""
}

@inline
func array_new() -> Array<String> {
  return []
}

@inline
func array_len(arr: Array<String>) -> Int {
  return len(arr)
}

@inline
func array_get(arr: Array<String>, idx: Int) -> String {
  return arr[idx]
}

@inline
func array_set(arr: Array<String>, idx: Int, val: String) {
  arr[idx] = val
}

@inline
func array_push(arr: Array<String>, val: String) {
  append(arr, val)
}

@inline
func array_copy(arr: Array<String>) -> Array<String> {
  return arr[:]  # 슬라이스 복사
}

func string_split(s: String, sep: String) -> Array<String> {
  var parts: Array<String> = array_new()
  var current: String = ""
  var i: Int = 0
  var sep_len: Int = string_len(sep)

  while i < string_len(s) {
    if string_contains(s[i:], sep) {
      var idx: Int = i
      while idx < string_len(s) && !string_contains(s[idx:], sep) {
        current = current + string(s[idx])
        idx = idx + 1
      }
      array_push(parts, current)
      current = ""
      i = idx + sep_len
    } else {
      current = current + string(s[i])
      i = i + 1
    }
  }

  if !string_eq(current, "") {
    array_push(parts, current)
  }

  return parts
}
