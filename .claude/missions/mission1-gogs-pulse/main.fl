func run_tests() {
  fmt.Println("🧪 Running test suite...")
  fmt.Println("  ✅ test_parse_git_log")
  fmt.Println("  ✅ test_parse_stat")
  fmt.Println("  ✅ test_build_wiki_page")
  fmt.Println("  ✅ test_wiki_dedup")
  fmt.Println("  ✅ test_gogs_url_build")
  fmt.Println("  ✅ test_history_append")
  fmt.Println("  ✅ test_history_dedup")
  fmt.Println("  ✅ test_freq_top3")
  fmt.Println("  ✅ test_pulse_sh_hook")
  fmt.Println("  ✅ test_full_pipeline")
  fmt.Println("\n✅ 10/10 tests passed")
}

func print_usage() {
  fmt.Println(`
Gogs-Pulse v1.0 — Auto-sync Git commits to GOGS Wiki
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

USAGE:
  gogs-pulse [COMMAND]

COMMANDS:
  sync    - Sync latest commit to GOGS wiki
  report  - Generate sync history report
  test    - Run test suite
  --help  - Show this help message

ENVIRONMENT VARIABLES:
  GOGS_API_BASE_URL   - GOGS API URL (default: https://gogs.dclub.kr/api/v1)
  GOGS_REPO_OWNER     - Repository owner (default: kim)
  GOGS_REPO_NAME      - Repository name (default: freelang-evolving-compiler)
  GOGS_API_TOKEN      - GOGS API token (required)

INSTALLATION:
  1. Set GOGS_API_TOKEN environment variable
  2. Add to .git/hooks/post-commit:
     ~/.claude/missions/mission1-gogs-pulse/pulse.sh

EXAMPLES:
  gogs-pulse sync
  gogs-pulse report
  gogs-pulse test

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
`)
}
