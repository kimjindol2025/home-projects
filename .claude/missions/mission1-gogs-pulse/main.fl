package main

import "fmt"
import "os"
import "path/filepath"

# ============================================================
# Gogs-Pulse: Main CLI
# ============================================================

func main() {
  if len(os.Args) < 2 {
    print_usage()
    os.Exit(1)
  }

  var cmd string = os.Args[1]

  if cmd == "sync" {
    sync_commit_to_gogs()
    os.Exit(0)

  } else if cmd == "report" {
    generate_pulse_report()
    os.Exit(0)

  } else if cmd == "test" {
    run_tests()
    os.Exit(0)

  } else if cmd == "--help" || cmd == "-h" {
    print_usage()
    os.Exit(0)

  } else {
    fmt.Printf("unknown command: %s\n", cmd)
    print_usage()
    os.Exit(1)
  }
}

