package main

import "fmt"
import "bytes"
import "net/http"
import "encoding/json"
import "os"
import "io"

# ============================================================
# GogsPush: GOGS API 호출 및 WIKI 동기화
# ============================================================

type GogsConfig struct {
  api_base_url string // e.g., "https://gogs.dclub.kr/api/v1"
  repo_owner   string
  repo_name    string
  token        string
}

type GogsWikiRequest struct {
  Title   string `json:"title"`
  Content string `json:"content"`
  Message string `json:"message"`
}

# GOGS 설정 로드 (환경변수 또는 .env 파일)
func load_gogs_config() GogsConfig {
  var config GogsConfig

  config.api_base_url = os.Getenv("GOGS_API_BASE_URL")
  if config.api_base_url == "" {
    config.api_base_url = "https://gogs.dclub.kr/api/v1"
  }

  config.repo_owner = os.Getenv("GOGS_REPO_OWNER")
  if config.repo_owner == "" {
    config.repo_owner = "kim"
  }

  config.repo_name = os.Getenv("GOGS_REPO_NAME")
  if config.repo_name == "" {
    config.repo_name = "freelang-evolving-compiler"
  }

  config.token = os.Getenv("GOGS_API_TOKEN")

  return config
}

# GOGS WIKI 페이지 생성/업데이트
func push_wiki_page(config GogsConfig, wiki_page WikiPage) (string, error) {
  if config.token == "" {
    return "", fmt.Errorf("GOGS_API_TOKEN not set")
  }

  # URL: /repos/{owner}/{repo}/wiki/pages
  url := fmt.Sprintf("%s/repos/%s/%s/wiki/pages",
    config.api_base_url, config.repo_owner, config.repo_name)

  # 요청 바디 생성
  req_body := GogsWikiRequest{
    Title:   wiki_page.title,
    Content: wiki_page.content,
    Message: fmt.Sprintf("Auto-sync: %s", wiki_page.title),
  }

  body, err := json.Marshal(req_body)
  if err != nil {
    return "", err
  }

  # HTTP PUT 요청
  req, err := http.NewRequest("PUT", url, bytes.NewBuffer(body))
  if err != nil {
    return "", err
  }

  req.Header.Set("Content-Type", "application/json")
  req.Header.Set("Authorization", fmt.Sprintf("token %s", config.token))

  client := &http.Client{}
  resp, err := client.Do(req)
  if err != nil {
    return "", err
  }
  defer resp.Body.Close()

  # 응답 읽기
  resp_body, _ := io.ReadAll(resp.Body)

  if resp.StatusCode < 200 || resp.StatusCode >= 300 {
    return "", fmt.Errorf("GOGS API error: %d - %s", resp.StatusCode, string(resp_body))
  }

  return url, nil
}

# 히스토리 파일에 기록 추가
func append_to_history(wiki_page WikiPage, record CommitRecord, history_file string) error {
  # JSON 형식: {hash, message, fingerprint, timestamp}
  entry := fmt.Sprintf(`{"hash":"%s","message":"%s","fingerprint":%d,"timestamp":"%s"}`,
    record.hash, record.message, wiki_page.fingerprint, record.timestamp)

  # 파일에 행 추가
  file, err := os.OpenFile(history_file, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0644)
  if err != nil {
    return err
  }
  defer file.Close()

  _, err = file.WriteString(entry + "\n")
  return err
}

# 히스토리에서 fingerprint 중복 확인
func check_history_duplicate(fingerprint int, history_file string) (bool, error) {
  data, err := os.ReadFile(history_file)
  if err != nil {
    // 파일이 없으면 새로 생성
    if os.IsNotExist(err) {
      return false, nil
    }
    return false, err
  }

  search_str := fmt.Sprintf(`"fingerprint":%d`, fingerprint)

  if bytes.Contains(data, []byte(search_str)) {
    return true, nil
  }

  return false, nil
}

# GOGS URL 조립
func build_gogs_wiki_url(config GogsConfig, page_title string) string {
  return fmt.Sprintf("https://gogs.dclub.kr/%s/%s/wiki/%s",
    config.repo_owner, config.repo_name, page_title)
}
