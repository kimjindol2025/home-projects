func TestBuildWikiPage(t *testing.T) {
  var record CommitRecord = CommitRecord{
    hash:          "abc1234567890",
    message:       "feat: 새로운 기능",
    timestamp:     "2026-03-28T12:00:00Z",
    files_changed: 3,
    insertions:    10,
    deletions:     5,
  }

  wiki_page := build_wiki_page(record)

  if wiki_page.title == "" {
    t.Errorf("expected title, got empty string")
  }
  if wiki_page.content == "" {
    t.Errorf("expected content, got empty string")
  }
  if wiki_page.fingerprint == 0 {
    t.Errorf("expected non-zero fingerprint")
  }

  t.Log("PASS: test_build_wiki_page")
}

