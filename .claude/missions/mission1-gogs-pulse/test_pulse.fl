func TestGogsUrlBuild(t *testing.T) {
  config := GogsConfig{
    api_base_url: "https://gogs.dclub.kr/api/v1",
    repo_owner:   "kim",
    repo_name:    "freelang",
  }

  url := build_gogs_wiki_url(config, "test-page")

  if !contains(url, "gogs.dclub.kr") {
    t.Errorf("expected gogs.dclub.kr in URL, got %s", url)
  }

  t.Log("PASS: test_gogs_url_build")
}

