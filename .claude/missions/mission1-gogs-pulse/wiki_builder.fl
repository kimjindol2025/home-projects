package main

import "fmt"
import "strings"
import "time"

# ============================================================
# WikiBuilder: CommitRecord → 마크다운 WIKI 페이지
# ============================================================

type WikiPage struct {
  title       string
  content     string
  fingerprint int // fnv1a_hash(content)
}

# CommitRecord → 마크다운 WIKI 페이지
func build_wiki_page(record CommitRecord) WikiPage {
  var page WikiPage

  # 제목: 커밋 해시 (단축) + 메시지
  page.title = fmt.Sprintf("%s — %s", record.hash[:8], record.message)

  # 마크다운 콘텐츠 생성
  var sb strings.Builder

  sb.WriteString("# ")
  sb.WriteString(page.title)
  sb.WriteString("\n\n")

  sb.WriteString("| 속성 | 값 |\n")
  sb.WriteString("|------|-----|\n")

  sb.WriteString("| **Hash** | `")
  sb.WriteString(record.hash)
  sb.WriteString("` |\n")

  sb.WriteString("| **Message** | ")
  sb.WriteString(record.message)
  sb.WriteString(" |\n")

  sb.WriteString("| **Timestamp** | ")
  sb.WriteString(record.timestamp)
  sb.WriteString(" |\n")

  sb.WriteString("| **Files Changed** | ")
  sb.WriteString(fmt.Sprintf("%d", record.files_changed))
  sb.WriteString(" |\n")

  sb.WriteString("| **Insertions** | +")
  sb.WriteString(fmt.Sprintf("%d", record.insertions))
  sb.WriteString(" |\n")

  sb.WriteString("| **Deletions** | -")
  sb.WriteString(fmt.Sprintf("%d", record.deletions))
  sb.WriteString(" |\n")

  sb.WriteString("\n---\n\n")

  sb.WriteString("**Generated**: ")
  sb.WriteString(time.Now().Format(time.RFC3339))
  sb.WriteString("\n")

  page.content = sb.String()
  page.fingerprint = fnv1a_hash(page.content)

  return page
}

# FNV-1a 해시 (32bit)
func fnv1a_hash(s string) int {
  const (
    offset_basis = 2166136261
    fnv_prime    = 16777619
  )

  var h int = offset_basis

  for i := 0; i < len(s); i++ {
    h = (h ^ int(s[i])) * fnv_prime
  }

  return h
}

# WikiPage를 마크다운 파일로 저장
func save_wiki_page(page WikiPage, dir string) (string, error) {
  # 파일명: hash값 기반
  filename := fmt.Sprintf("%s/wiki_%d.md", dir, page.fingerprint)

  // 파일 저장 로직
  // err := os.WriteFile(filename, []byte(page.content), 0644)
  // if err != nil {
  //   return "", err
  // }

  return filename, nil
}

# 중복 검사: 같은 hash면 업데이트 스킵
func is_wiki_duplicate(new_page WikiPage, existing_fingerprints map[int]bool) bool {
  _, exists := existing_fingerprints[new_page.fingerprint]
  return exists
}

# WikiPage → JSON 형식 (저장용)
func wiki_page_to_json(page WikiPage) string {
  return fmt.Sprintf(`{
  "title": "%s",
  "content": "%s",
  "fingerprint": %d
}`,
    escape_json_string(page.title),
    escape_json_string(page.content),
    page.fingerprint,
  )
}

func escape_json_string(s string) string {
  // JSON 문자열 이스케이프
  return strings.NewReplacer(
    `"`, `\"`,
    `\`, `\\`,
    "\n", `\n`,
    "\r", `\r`,
  ).Replace(s)
}

# WikiPage 구조체 스트링 표현
func (w WikiPage) String() string {
  return fmt.Sprintf("WikiPage{title=%s, fingerprint=%d}", w.title, w.fingerprint)
}
