package main

import "fmt"
import "strings"
import "os/exec"
import "strconv"

# ============================================================
# Parser: git log/status 파싱
# ============================================================

type CommitRecord struct {
  hash          string
  message       string
  timestamp     string
  files_changed int
  insertions    int
  deletions     int
}

type GitStatus struct {
  status string // "modified", "added", "deleted"
  files  []string
}

# git log -1 파싱: "abc1234 feat: 기능" → CommitRecord
func parse_git_log() (CommitRecord, error) {
  var record CommitRecord

  # git log -1 --oneline
  cmd := exec.Command("git", "log", "-1", "--format=%H %s")
  output, err := cmd.Output()
  if err != nil {
    return record, err
  }

  line := strings.TrimSpace(string(output))
  parts := strings.SplitN(line, " ", 2)

  if len(parts) < 2 {
    return record, fmt.Errorf("invalid git log format")
  }

  record.hash = parts[0]
  record.message = parts[1]

  # 타임스탬프 추출: git log -1 --format=%aI
  cmd = exec.Command("git", "log", "-1", "--format=%aI")
  output, err = cmd.Output()
  if err == nil {
    record.timestamp = strings.TrimSpace(string(output))
  }

  # --stat 파싱
  cmd = exec.Command("git", "log", "-1", "--stat")
  output, err = cmd.Output()
  if err == nil {
    parse_stat_output(string(output), &record)
  }

  return record, nil
}

# git status 파싱
func parse_git_status() GitStatus {
  cmd := exec.Command("git", "status", "--porcelain")
  output, err := cmd.Output()

  var status GitStatus
  status.status = "clean"
  status.files = make([]string, 0)

  if err != nil || len(output) == 0 {
    return status
  }

  status.status = "dirty"
  lines := strings.Split(string(output), "\n")

  for _, line := range lines {
    if len(line) > 3 {
      status.files = append(status.files, strings.TrimSpace(line[3:]))
    }
  }

  return status
}

# "3 files changed, 10 insertions(+), 5 deletions(-)" 파싱
func parse_stat_output(output string, record *CommitRecord) {
  lines := strings.Split(output, "\n")

  for _, line := range lines {
    // "3 files changed, 10 insertions(+), 5 deletions(-)"
    if strings.Contains(line, "files changed") {
      parts := strings.Fields(line)

      for i := 0; i < len(parts); i++ {
        if parts[i] == "files" && i > 0 {
          val, err := strconv.Atoi(parts[i-1])
          if err == nil {
            record.files_changed = val
          }
        }

        if strings.HasPrefix(parts[i], "insertion") && i > 0 {
          val, err := strconv.Atoi(parts[i-1])
          if err == nil {
            record.insertions = val
          }
        }

        if strings.HasPrefix(parts[i], "deletion") && i > 0 {
          val, err := strconv.Atoi(parts[i-1])
          if err == nil {
            record.deletions = val
          }
        }
      }
    }
  }
}

# CommitRecord → 문자열 표현
func (c CommitRecord) String() string {
  return fmt.Sprintf(
    "CommitRecord{hash=%s, msg=%s, time=%s, files=%d, +%d, -%d}",
    c.hash, c.message, c.timestamp, c.files_changed, c.insertions, c.deletions,
  )
}
