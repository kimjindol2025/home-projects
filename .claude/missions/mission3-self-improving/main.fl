func print_usage() {
  fmt.Println(`
Self-Improving Prompt Engine v1.0
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

USAGE:
  self-improve [COMMAND]

COMMANDS:
  analyze       - Analyze session history for patterns
  update-rules  - Update .clauderules with new patterns
  report        - Generate improvement report
  test          - Run test suite
  --help        - Show this help message

INSTALLATION:
  Add to ~/.claude/settings.json hooks:
  {
    "hooks": {
      "Stop": [{
        "matcher": "-",
        "hooks": [{
          "type": "command",
          "command": "~/.claude/missions/mission3-self-improving/self_improve.sh"
        }]
      }]
    }
  }

EXAMPLES:
  self-improve analyze
  self-improve update-rules
  self-improve report
  self-improve test

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
`)
}
