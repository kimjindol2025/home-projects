{"parentUuid":"dd71fbef-7749-4c27-a9d8-b9382021978a","isSidechain":false,"type":"progress","data":{"type":"hook_progress","hookEvent":"PostToolUse","hookName":"PostToolUse:Edit","command":"callback"},"parentToolUseID":"toolu_01KepCzvKWebANnQbDqUfVUa","toolUseID":"toolu_01KepCzvKWebANnQbDqUfVUa","timestamp":"2026-03-13T04:40:57.852Z","uuid":"3f36d2e2-65c8-41a6-a248-ca29987ee3a2","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
{"parentUuid":"dd71fbef-7749-4c27-a9d8-b9382021978a","isSidechain":false,"promptId":"bfc6b3c2-2b85-472e-8cf2-4539f3af6c21","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KepCzvKWebANnQbDqUfVUa","type":"tool_result","content":"The file /data/data/com.termux/files/home/freelang-hybrid/freelang/core/websocket-server.js has been updated successfully."}]},"uuid":"e0652b24-50e3-45e3-b9a7-91159346f21c","timestamp":"2026-03-13T04:40:57.843Z","toolUseResult":{"filePath":"/data/data/com.termux/files/home/freelang-hybrid/freelang/core/websocket-server.js","oldString":"    this.metrics = {\n      totalConnections: 0,\n      activeConnections: 0,\n      totalMessages: 0,\n      totalRooms: 0,\n      messageLatencies: []\n    };","newString":"    this.metrics = {\n      totalConnections: 0,\n      activeConnections: 0,\n      totalMessages: 0,\n      totalRooms: 0,\n      messageLatencies: [],\n      latency: {\n        avg: 0,\n        min: 0,\n        max: 0,\n        p50: 0,\n        p95: 0,\n        p99: 0\n      }\n    };","originalFile":"// ============================================================================\n// Phase 7.1: WebSocket Server - Real-time Bidirectional Communication\n// ============================================================================\n\nconst crypto = require('crypto');\nconst EventEmitter = require('events');\n\n// ──────────────────────────────────────────────────────────────────────────\n// WebSocket Server with Room-based Broadcasting\n// ──────────────────────────────────────────────────────────────────────────\n\nclass WebSocketServer extends EventEmitter {\n  constructor(options = {}) {\n    super();\n    this.port = options.port || 8000;\n    this.clients = new Map();              // clientId → { ws, subscriptions, metadata }\n    this.rooms = new Map();                // roomId → Set<clientId>\n    this.messageQueue = [];                // 오프라인 메시지 큐\n    this.metrics = {\n      totalConnections: 0,\n      activeConnections: 0,\n      totalMessages: 0,\n      totalRooms: 0,\n      messageLatencies: []\n    };\n    this.heartbeatInterval = options.heartbeatInterval || 30000; // 30초\n    this.heartbeatTimeout = options.heartbeatTimeout || 60000;   // 60초\n    this.maxMessageQueueSize = options.maxMessageQueueSize || 1000;\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Client Connection Management\n  // ──────────────────────────────────────────────────────────────────────────\n\n  addClient(ws, request = {}) {\n    const clientId = this.generateClientId();\n    const client = {\n      id: clientId,\n      ws,\n      subscriptions: new Set(),\n      metadata: {\n        connectedAt: Date.now(),\n        remoteAddress: request.socket?.remoteAddress || 'unknown',\n        lastActivity: Date.now(),\n        messageCount: 0,\n        pingsPending: 0\n      }\n    };\n\n    this.clients.set(clientId, client);\n    this.metrics.totalConnections++;\n    this.metrics.activeConnections++;\n\n    // Event listeners\n    ws.on('message', (data) => this.handleMessage(clientId, data));\n    ws.on('close', () => this.removeClient(clientId));\n    ws.on('error', (err) => this.handleClientError(clientId, err));\n    ws.on('pong', () => this.handlePong(clientId));\n\n    // 시작 메시지\n    this.sendToClient(clientId, {\n      type: 'connected',\n      clientId,\n      timestamp: Date.now(),\n      serverTime: new Date().toISOString()\n    });\n\n    // 하트비트 시작\n    this.startHeartbeat(clientId);\n\n    this.emit('client_connected', { clientId, client });\n    return clientId;\n  }\n\n  removeClient(clientId) {\n    const client = this.clients.get(clientId);\n    if (!client) return;\n\n    // 모든 룸에서 제거\n    for (const roomId of client.subscriptions) {\n      this.leaveRoom(clientId, roomId);\n    }\n\n    // 클라이언트 제거\n    this.clients.delete(clientId);\n    this.metrics.activeConnections--;\n\n    this.emit('client_disconnected', { clientId, reason: 'client_close' });\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Room Management\n  // ──────────────────────────────────────────────────────────────────────────\n\n  joinRoom(clientId, roomId) {\n    const client = this.clients.get(clientId);\n    if (!client) return false;\n\n    if (!this.rooms.has(roomId)) {\n      this.rooms.set(roomId, new Set());\n      this.metrics.totalRooms++;\n    }\n\n    const room = this.rooms.get(roomId);\n    room.add(clientId);\n    client.subscriptions.add(roomId);\n\n    // 입장 알림\n    this.broadcast(roomId, {\n      type: 'user_joined',\n      clientId,\n      room: roomId,\n      totalInRoom: room.size,\n      timestamp: Date.now()\n    }, clientId); // 본인 제외\n\n    this.emit('client_joined_room', { clientId, roomId, roomSize: room.size });\n    return true;\n  }\n\n  leaveRoom(clientId, roomId) {\n    const client = this.clients.get(clientId);\n    const room = this.rooms.get(roomId);\n\n    if (!client || !room) return false;\n\n    room.delete(clientId);\n    client.subscriptions.delete(roomId);\n\n    // 퇴장 알림\n    if (room.size > 0) {\n      this.broadcast(roomId, {\n        type: 'user_left',\n        clientId,\n        room: roomId,\n        totalInRoom: room.size,\n        timestamp: Date.now()\n      });\n    }\n\n    // 빈 룸 삭제\n    if (room.size === 0) {\n      this.rooms.delete(roomId);\n      this.metrics.totalRooms--;\n      this.emit('room_closed', { roomId });\n    }\n\n    return true;\n  }\n\n  getRoomClients(roomId) {\n    const room = this.rooms.get(roomId);\n    if (!room) return [];\n    return Array.from(room);\n  }\n\n  getRoomInfo(roomId) {\n    const room = this.rooms.get(roomId);\n    if (!room) return null;\n\n    return {\n      roomId,\n      size: room.size,\n      clients: this.getRoomClients(roomId),\n      createdAt: room.createdAt || Date.now()\n    };\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Message Handling & Broadcasting\n  // ──────────────────────────────────────────────────────────────────────────\n\n  handleMessage(clientId, data) {\n    const client = this.clients.get(clientId);\n    if (!client) return;\n\n    try {\n      const msg = JSON.parse(data.toString());\n      client.metadata.lastActivity = Date.now();\n      client.metadata.messageCount++;\n\n      const startTime = Date.now();\n\n      switch (msg.type) {\n        case 'subscribe':\n          this.joinRoom(clientId, msg.room);\n          break;\n\n        case 'unsubscribe':\n          this.leaveRoom(clientId, msg.room);\n          break;\n\n        case 'publish':\n          this.broadcast(msg.room, {\n            type: 'message',\n            from: clientId,\n            room: msg.room,\n            data: msg.data,\n            timestamp: Date.now()\n          });\n          break;\n\n        case 'ping':\n          this.sendToClient(clientId, {\n            type: 'pong',\n            timestamp: Date.now(),\n            echo: msg.data\n          });\n          break;\n\n        case 'get_rooms':\n          this.sendToClient(clientId, {\n            type: 'rooms_list',\n            rooms: Array.from(this.rooms.keys()).map(roomId => ({\n              roomId,\n              size: this.rooms.get(roomId).size\n            }))\n          });\n          break;\n\n        default:\n          this.emit('unknown_message_type', { clientId, type: msg.type });\n      }\n\n      const latency = Date.now() - startTime;\n      this.recordLatency(latency);\n      this.metrics.totalMessages++;\n\n    } catch (err) {\n      this.emit('message_parse_error', { clientId, error: err.message });\n    }\n  }\n\n  broadcast(roomId, message, excludeClientId = null) {\n    const room = this.rooms.get(roomId);\n    if (!room) return 0;\n\n    let sentCount = 0;\n    const startTime = Date.now();\n\n    room.forEach(clientId => {\n      if (clientId !== excludeClientId) {\n        if (this.sendToClient(clientId, message)) {\n          sentCount++;\n          this.metrics.totalMessages++;\n        }\n      }\n    });\n\n    const latency = Date.now() - startTime;\n    this.recordLatency(latency);\n\n    return sentCount;\n  }\n\n  sendToClient(clientId, message) {\n    const client = this.clients.get(clientId);\n    if (!client) return false;\n\n    try {\n      const data = JSON.stringify(message);\n      if (client.ws && client.ws.readyState === 1) { // OPEN\n        client.ws.send(data);\n        return true;\n      }\n    } catch (err) {\n      this.emit('send_error', { clientId, error: err.message });\n      return false;\n    }\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Heartbeat & Connection Health\n  // ──────────────────────────────────────────────────────────────────────────\n\n  startHeartbeat(clientId) {\n    const client = this.clients.get(clientId);\n    if (!client) return;\n\n    client.heartbeatTimer = setInterval(() => {\n      if (!this.clients.has(clientId)) {\n        clearInterval(client.heartbeatTimer);\n        return;\n      }\n\n      client.metadata.pingsPending++;\n\n      if (client.metadata.pingsPending > 3) {\n        // 3회 이상 응답 없음 → 강제 종료\n        try {\n          client.ws.close(1000, 'Heartbeat timeout');\n        } catch (e) {}\n        return;\n      }\n\n      try {\n        client.ws.ping();\n      } catch (err) {\n        clearInterval(client.heartbeatTimer);\n      }\n    }, this.heartbeatInterval);\n  }\n\n  handlePong(clientId) {\n    const client = this.clients.get(clientId);\n    if (client) {\n      client.metadata.pingsPending = 0;\n      client.metadata.lastActivity = Date.now();\n    }\n  }\n\n  handleClientError(clientId, error) {\n    this.emit('client_error', { clientId, error: error.message });\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Message Queue (Offline Support)\n  // ──────────────────────────────────────────────────────────────────────────\n\n  queueMessage(roomId, message, ttl = 3600000) { // 1시간 TTL\n    if (this.messageQueue.length >= this.maxMessageQueueSize) {\n      this.messageQueue.shift(); // 오래된 메시지 제거\n    }\n\n    this.messageQueue.push({\n      roomId,\n      message,\n      timestamp: Date.now(),\n      expiresAt: Date.now() + ttl\n    });\n  }\n\n  getQueuedMessages(roomId, since) {\n    return this.messageQueue.filter(\n      msg => msg.roomId === roomId &&\n             msg.timestamp > since &&\n             msg.expiresAt > Date.now()\n    );\n  }\n\n  purgeExpiredMessages() {\n    const now = Date.now();\n    this.messageQueue = this.messageQueue.filter(\n      msg => msg.expiresAt > now\n    );\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Metrics & Analytics\n  // ──────────────────────────────────────────────────────────────────────────\n\n  recordLatency(latency) {\n    this.metrics.messageLatencies.push(latency);\n    if (this.metrics.messageLatencies.length > 1000) {\n      this.metrics.messageLatencies.shift();\n    }\n  }\n\n  getMetrics() {\n    const latencies = this.metrics.messageLatencies;\n    const sorted = [...latencies].sort((a, b) => a - b);\n    const getPercentile = (arr, p) => {\n      const idx = Math.ceil((p / 100) * arr.length) - 1;\n      return arr[Math.max(0, idx)] || 0;\n    };\n\n    return {\n      timestamp: Date.now(),\n      activeConnections: this.metrics.activeConnections,\n      totalConnections: this.metrics.totalConnections,\n      totalRooms: this.metrics.totalRooms,\n      totalMessages: this.metrics.totalMessages,\n      messageQueue: {\n        length: this.messageQueue.length,\n        maxSize: this.maxMessageQueueSize\n      },\n      latency: {\n        avg: latencies.length > 0 ?\n          (latencies.reduce((a, b) => a + b, 0) / latencies.length).toFixed(2) : 0,\n        min: latencies.length > 0 ? Math.min(...latencies) : 0,\n        max: latencies.length > 0 ? Math.max(...latencies) : 0,\n        p50: getPercentile(sorted, 50),\n        p95: getPercentile(sorted, 95),\n        p99: getPercentile(sorted, 99)\n      },\n      clients: Array.from(this.clients.entries()).map(([id, client]) => ({\n        clientId: id,\n        subscriptions: client.subscriptions.size,\n        messageCount: client.metadata.messageCount,\n        connectedFor: Date.now() - client.metadata.connectedAt,\n        lastActivity: Date.now() - client.metadata.lastActivity\n      }))\n    };\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Utilities\n  // ──────────────────────────────────────────────────────────────────────────\n\n  generateClientId() {\n    return crypto.randomBytes(8).toString('hex');\n  }\n\n  getClientInfo(clientId) {\n    const client = this.clients.get(clientId);\n    if (!client) return null;\n\n    return {\n      clientId,\n      subscriptions: Array.from(client.subscriptions),\n      metadata: client.metadata,\n      connected: true\n    };\n  }\n\n  getAllClients() {\n    return Array.from(this.clients.entries()).map(([id, client]) => ({\n      clientId: id,\n      subscriptions: Array.from(client.subscriptions),\n      messageCount: client.metadata.messageCount\n    }));\n  }\n\n  shutdown() {\n    // 모든 클라이언트 연결 종료\n    for (const [clientId, client] of this.clients) {\n      if (client.heartbeatTimer) clearInterval(client.heartbeatTimer);\n      try {\n        client.ws.close(1001, 'Server shutdown');\n      } catch (e) {}\n    }\n    this.clients.clear();\n    this.rooms.clear();\n    this.messageQueue = [];\n    this.emit('shutdown');\n  }\n}\n\n// Export\nmodule.exports = {\n  WebSocketServer,\n  createWebSocketServer: (options) => new WebSocketServer(options)\n};\n","structuredPatch":[{"oldStart":21,"oldLines":7,"newStart":21,"newLines":15,"lines":["       activeConnections: 0,","       totalMessages: 0,","       totalRooms: 0,","-      messageLatencies: []","+      messageLatencies: [],","+      latency: {","+        avg: 0,","+        min: 0,","+        max: 0,","+        p50: 0,","+        p95: 0,","+        p99: 0","+      }","     };","     this.heartbeatInterval = options.heartbeatInterval || 30000; // 30초","     this.heartbeatTimeout = options.heartbeatTimeout || 60000;   // 60초"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"dd71fbef-7749-4c27-a9d8-b9382021978a","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
