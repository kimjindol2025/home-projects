   .map(line => '  ' + line)\n      .join('\\n');\n\n    return html;\n  }\n}\n\nmodule.exports = { HTMLGenerator };\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"725332c5-3336-43ad-af1b-67e1939e3164","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-light","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
