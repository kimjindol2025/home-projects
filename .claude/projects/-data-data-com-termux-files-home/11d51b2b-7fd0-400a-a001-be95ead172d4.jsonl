a, options = {}) {\n    const timestamp = Date.now();\n    const event = {\n      type: eventType,\n      data,\n      channelId,\n      timestamp,\n      id: options.id || this.generateEventId()\n    };\n\n    // 히스토리에 추가\n    this.addToHistory(event);\n\n    // 채널의 모든 구독자에게 전송\n    const channel = this.channels.get(channelId);\n    if (!channel) return 0;\n\n    let sentCount = 0;\n    channel.forEach(clientId => {\n      if (this.sendToClient(clientId, eventType, data, false, event.id)) {\n        sentCount++;\n      }\n    });\n\n    this.metrics.totalEvents++;\n    return sentCount;\n  }\n\n  publishToAll(eventType, data) {\n    let totalSent = 0;\n    for (const channelId of this.channels.keys()) {\n      totalSent += this.publish(channelId, eventType, data);\n    }\n    return totalSent;\n  }\n\n  sendToClient(clientId, eventType, data, isHistorical = false, eventId = null) {\n    const client = this.clients.get(clientId);\n    if (!client) return false;\n\n    try {\n      const res = client.res;\n      const payload = JSON.stringify(data);\n\n      let message = '';\n\n      // 이벤트 ID (클라이언트 재연결 시 복구용)\n      if (eventId) {\n        message += `id: ${eventId}\\n`;\n      }\n\n      // 이벤트 타입\n      message += `event: ${eventType}\\n`;\n\n      // 데이터\n      message += `data: ${payload}\\n`;\n\n      // 재연결 지연 (클라이언트 재연결 정책)\n      if (eventType === 'connection') {\n        message += `retry: ${this.reconnectDelay}\\n`;\n      }\n\n      message += '\\n';\n\n      res.write(message);\n\n      client.metadata.lastEvent = Date.now();\n      client.metadata.messageCount++;\n\n      this.recordLatency(Date.now() - client.metadata.lastEvent);\n\n      return true;\n    } catch (err) {\n      this.emit('send_error', { clientId, error: err.message });\n      return false;\n    }\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Event History Management\n  // ──────────────────────────────────────────────────────────────────────────\n\n  addToHistory(event) {\n    this.eventHistory.push(event);\n\n    // 크기 제한\n    if (this.eventHistory.length > this.maxHistorySize) {\n      this.eventHistory.shift();\n    }\n  }\n\n  getChannelHistory(channelId, limit = 10) {\n    return this.eventHistory\n      .filter(e => e.channelId === channelId)\n      .slice(-limit);\n  }\n\n  getHistorySince(channelId, timestamp) {\n    return this.eventHistory.filter(\n      e => e.channelId === channelId && e.timestamp > timestamp\n    );\n  }\n\n  clearHistory() {\n    this.eventHistory = [];\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Metrics & Analytics\n  // ──────────────────────────────────────────────────────────────────────────\n\n  recordLatency(latency) {\n    if (!this.metrics.eventLatencies) {\n      this.metrics.eventLatencies = [];\n    }\n    this.metrics.eventLatencies.push(latency);\n    if (this.metrics.eventLatencies.length > 1000) {\n      this.metrics.eventLatencies.shift();\n    }\n  }\n\n  getMetrics() {\n    const latencies = this.metrics.eventLatencies || [];\n    const sorted = [...latencies].sort((a, b) => a - b);\n    const getPercentile = (arr, p) => {\n      const idx = Math.ceil((p / 100) * arr.length) - 1;\n      return arr[Math.max(0, idx)] || 0;\n    };\n\n    return {\n      timestamp: Date.now(),\n      activeConnections: this.metrics.activeConnections,\n      totalConnections: this.metrics.totalConnections,\n      totalChannels: this.metrics.totalChannels,\n      totalEvents: this.metrics.totalEvents,\n      history: {\n        size: this.eventHistory.length,\n        maxSize: this.maxHistorySize\n      },\n      latency: {\n        avg: latencies.length > 0 ?\n          (latencies.reduce((a, b) => a + b, 0) / latencies.length).toFixed(2) : 0,\n        min: latencies.length > 0 ? Math.min(...latencies) : 0,\n        max: latencies.length > 0 ? Math.max(...latencies) : 0,\n        p50: getPercentile(sorted, 50),\n        p95: getPercentile(sorted, 95),\n        p99: getPercentile(sorted, 99)\n      },\n      clients: Array.from(this.clients.entries()).map(([id, client]) => ({\n        clientId: id,\n        subscriptions: client.subscriptions.size,\n        messageCount: client.metadata.messageCount,\n        connectedFor: Date.now() - client.metadata.connectedAt,\n        lastEvent: Date.now() - client.metadata.lastEvent\n      })),\n      channels: Array.from(this.channels.entries()).map(([id, clients]) => ({\n        channelId: id,\n        subscribers: clients.size\n      }))\n    };\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Utilities\n  // ──────────────────────────────────────────────────────────────────────────\n\n  generateClientId() {\n    return 'sse_' + Math.random().toString(36).substr(2, 9);\n  }\n\n  generateEventId() {\n    return Date.now() + '_' + Math.random().toString(36).substr(2, 5);\n  }\n\n  getClientInfo(clientId) {\n    const client = this.clients.get(clientId);\n    if (!client) return null;\n\n    return {\n      clientId,\n      subscriptions: Array.from(client.subscriptions),\n      metadata: client.metadata,\n      connected: true\n    };\n  }\n\n  getAllClients() {\n    return Array.from(this.clients.entries()).map(([id, client]) => ({\n      clientId: id,\n      subscriptions: Array.from(client.subscriptions),\n      messageCount: client.metadata.messageCount\n    }));\n  }\n\n  getAllChannels() {\n    return Array.from(this.channels.entries()).map(([id, clients]) => ({\n      channelId: id,\n      subscribers: clients.size,\n      subscriberList: Array.from(clients)\n    }));\n  }\n\n  shutdown() {\n    // 모든 클라이언트 연결 종료\n    for (const [clientId, client] of this.clients) {\n      if (client.heartbeatTimer) clearInterval(client.heartbeatTimer);\n      try {\n        client.res.end();\n      } catch (e) {}\n    }\n    this.clients.clear();\n    this.channels.clear();\n    this.eventHistory = [];\n   