aries', () => {\n    53→      ffi.registerLibrary('m', '/usr/lib/libm.so', [\n    54→        'double sqrt(double x)',\n    55→      ]);\n    56→      ffi.registerLibrary('c', '/usr/lib/libc.so', ['int strlen(char* s)']);\n    57→\n    58→      const libs = ffi.getLibraries();\n    59→      expect(libs.length).toBeGreaterThanOrEqual(2);\n    60→    });\n    61→\n    62→    test('registers library with multiple functions', () => {\n    63→      ffi.registerLibrary('m', '/usr/lib/libm.so', [\n    64→        'double sqrt(double x)',\n    65→        'double sin(double x)',\n    66→        'double cos(double x)',\n    67→      ]);\n    68→\n    69→      const lib = ffi.getLibrary('m');\n    70→      expect(lib?.bindings.size).toBe(3);\n    71→    });\n    72→\n    73→    test('handles invalid library path gracefully', () => {\n    74→      const lib = ffi.registerLibrary(\n    75→        'invalid',\n    76→        '/nonexistent/lib/invalid.so',\n    77→        ['int func()']\n    78→      );\n    79→      expect(lib).toBeNull();\n    80→    });\n    81→\n    82→    test('reports errors when library not found', () => {\n    83→      ffi.registerLibrary('invalid', '/nonexistent/lib.so', []);\n    84→      const errors = ffi.getErrors();\n    85→      expect(errors.length).toBeGreaterThan(0);\n    86→    });\n    87→  });\n    88→\n    89→  // ───── Function Calling Tests (8) ─────\n    90→\n    91→  describe('Function Calling', () => {\n    92→    beforeEach(() => {\n    93→      ffi.registerLibrary('m', '/usr/lib/libm.so', [\n    94→        'double sqrt(double x)',\n    95→        'int add(int a, int b)',\n    96→      ]);\n    97→    });\n    98→\n    99→    test('calls registered function', () => {\n   100→      const result = ffi.callFunction('m', 'sqrt', 4.0);\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augm