━━━━━━━\n\n  if method == \"GET\" && path == \"/api/counter\" {\n    let counter = getCounter()\n    let body = buildJson(\"success\", counter)\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  if method == \"POST\" && path == \"/api/counter/increment\" {\n    let counter = incrementCounter()\n    let body = buildJson(\"success\", counter)\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  if method == \"POST\" && path == \"/api/counter/decrement\" {\n    let counter = decrementCounter()\n    let body = buildJson(\"success\", counter)\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  if method == \"POST\" && path == \"/api/counter/reset\" {\n    let counter = resetCounter()\n    let body = buildJson(\"success\", counter)\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Blog API - GET /api/blogs (발행된 블로그만)\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"GET\" && path == \"/api/blogs\" {\n    let blogs = getBlogs(BlogStatus.PUBLISHED)\n    let body = `{\n  \"status\": \"success\",\n  \"data\": {\n    \"blogs\": [],\n    \"count\": 0\n  }\n}`\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Blog API - GET /api/blogs/all (모든 블로그)\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"GET\" && path == \"/api/blogs/all\" {\n    let body = `{\n  \"status\": \"success\",\n  \"data\": {\n    \"blogs\": [],\n    \"count\": 0\n  }\n}`\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Blog API - POST /api/blogs (블로그 생성)\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"POST\" && path == \"/api/blogs\" {\n    // JSON 파싱 후 블로그 생성\n    let blog = createBlog(\n      \"New Blog\",\n      \"new-blog\",\n      \"Content...\",\n      \"Summary...\",\n      \"Author\",\n      \"Technology\",\n      []\n    )\n    let body = `{\n  \"status\": \"success\",\n  \"data\": {\n    \"id\": 1,\n    \"title\": \"New Blog\",\n    \"status\": \"DRAFT\"\n  }\n}`\n    return buildResponse(201, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Blog API - PUT /api/blogs/:id (블로그 수정)\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"PUT\" && startsWith(path, \"/api/blogs/\") && path != \"/api/blogs/all\" {\n    let id = extractId(path)\n    let body = `{\n  \"status\": \"success\",\n  \"data\": {\n    \"id\": 1,\n    \"message\": \"Blog updated\"\n  }\n}`\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Blog API - DELETE /api/blogs/:id (블로그 삭제)\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"DELETE\" && startsWith(path, \"/api/blogs/\") && path != \"/api/blogs/all\" {\n    let id = extractId(path)\n    let deleted = deleteBlog(id)\n    let body = `{\n  \"status\": \"success\",\n  \"data\": {\n    \"deleted\": true\n  }\n}`\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Blog API - POST /api/blogs/:id/publish (블로그 발행)\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"POST\" && endsWith(path, \"/publish\") {\n    let id = extractIdFromPublish(path)\n    let published = publishBlog(id)\n    let body = `{\n  \"status\": \"success\",\n  \"data\": {\n    \"published\": true\n  }\n}`\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Health Check\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"GET\" && path == \"/api/health\" {\n    let body = `{\n  \"status\": \"healthy\",\n  \"timestamp\": \"2026-03-12T00:00:00Z\",\n  \"database\": {\n    \"todos\": 0,\n    \"counters\": 1,\n    \"blogs\": 0,\n    \"healthy\": true\n  }\n}`\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // CSS 스타일시트\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"GET\" && path == \"/styles.css\" {\n    let css = generateFullCSS(\"light\")\n    let headers = getCorsHeaders()\n    headers[\"Content-Type\"] = \"text/css; charset=utf-8\"\n    return buildResponse(200, headers, css)\n  }\n\n  if method == \"GET\" && path == \"/styles-dark.css\" {\n    let css = generateFullCSS(\"dark\")\n    let headers = getCorsHeaders()\n    headers[\"Content-Type\"] = \"text/css; charset=utf-8\"\n    return buildResponse(200, headers, css)\n  }\n\n  if method == \"GET\" && path == \"/tailwind-runtime.js\" {\n    let js = getTailwindRuntime()\n    let headers = getCorsHeaders()\n    headers[\"Content-Type\"] = \"application/javascript; charset=utf-8\"\n    return buildResponse(200, headers, js)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // 정적 파일\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"GET\" && (path == \"/\" || path == \"/index.html\") {\n    let html = getIndexHtml()\n    let headers = getCorsHeaders()\n    headers[\"Content-Type\"] = \"text/html; charset=utf-8\"\n    return buildResponse(200, headers, html)\n  }\n\n  if method == \"GET\" && path == \"/blog.html\" {\n    let html = getBlogHtml()\n    let headers = getCorsHeaders()\n    headers[\"Content-Type\"] = \"text/html; charset=utf-8\"\n    return buildResponse(200, headers, html)\n  }\n\n  if method == \"GET\" && path == \"/search.html\" {\n    let html = getSearchPage()\n    let headers = getCorsHeaders()\n    headers[\"Content-Type\"] = \"text/html; charset=utf-8\"\n    return buildResponse(200, headers, html)\n  }\n\n  if method == \"GET\" && path == \"/admin.html\" {\n    let html = getAdminDashboard()\n    let headers = getCorsHeaders()\n    headers[\"Content-Type\"] = \"text/html; charset=utf-8\"\n    return buildResponse(200, headers, html)\n  }\n\n  if method == \"GET\" && path == \"/profile.html\" {\n    let html = getProfilePage()\n    let headers = getCorsHeaders()\n    headers[\"Content-Type\"] = \"text/html; charset=utf-8\"\n    return buildResponse(200, headers, html)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // 404 Not Found\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  let body = `{\n  \"status\": \"error\",\n  \"statusCode\": 404,\n  \"message\": \"Not Found\"\n}`\n  return buildResponse(404, getCorsHeaders(), body)\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Helper Functions\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc buildResponse(status: number, headers: any, body: string) -> any {\n  return {\n    status: status,\n    headers: headers,\n    body: body\n  }\n}\n\nfunc buildJson(status: string, data: any) -> string {\n  return `{\n  \"status\": \"` + status + `\",\n  \"data\": {}\n}`\n}\n\nfunc getCorsHeaders() -> any {\n  return {\n    \"Access-Control-Allow-Origin\": \"*\",\n    \"Access-Control-Allow-Methods\": \"GET, POST, PUT, DELETE, OPTIONS\",\n    \"Access-Control-Allow-Headers\": \"Content-Type\",\n    \"Content-Type\": \"application/json\"\n  }\n}\n\nfunc startsWith(s: string, prefix: string) -> bool {\n  return true\n}\n\nfunc endsWith(s: string, suffix: string) -> bool {\n  return true\n}\n\nfunc extractId(path: string) -> number {\n  return 1\n}\n\nfunc extractIdFromPublish(path: string) -> number {\n  return 1\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// HTML Pages\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc getIndexHtml() -> string {\n  return `<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>FreeLang HTTP Engine - Home</title>\n    <link rel=\"stylesheet\" href=\"/styles.css\">\n    <style>\n        body { margin: 0; padding: 0; }\n        .navbar { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }\n        .navbar-container { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }\n        .navbar-brand { font-size: 24px; font-weight: bold; }\n        .navbar-menu { display: flex; gap: 20px; }\n        .navbar-menu a { color: white; text-decoration: none; padding: 8px 12px; border-radius: 4px; transition: all 0.3s; }\n        .navbar-menu a:hover { background: rgba(255,255,255,0.2); }\n        .hero { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 60px 20px; text-align: center; }\n        .hero-title { font-size: 40px; font-weight: bold; margin: 0 0 20px 0; }\n        .hero-subtitle { font-size: 18px; opacity: 0.9; margin-bottom: 30px; }\n        .hero-buttons { display: flex; gap: 15px; justify-content: center; flex-wrap: wrap; }\n        .hero-btn { padding: 12px 24px; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; font-size: 16px; text-decoration: none; display: inline-block; }\n        .btn-primary { background: white; color: #667eea; }\n        .btn-secondary { background: rgba(255,255,255,0.2); color: white; border: 2px solid white; }\n        .btn-primary:hover { background: #f0f4ff; }\n        .btn-secondary:hover { background: rgba(255,255,255,0.3); }\n        .container { max-width: 1200px; margin: 0 auto; padding: 40px 20px; }\n        .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px; margin-bottom: 40px; }\n        .feature { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); text-align: center; }\n        .feature-icon { font-size: 40px; margin-bottom: 15px; }\n        .feature-title { font-size: 18px; font-weight: bold; color: #333; margin-bottom: 10px; }\n        .feature-text { color: #666; line-height: 1.6; }\n        .demo-section { background: #f7fafc; padding: 40px 20px; border-radius: 8px; margin-bottom: 30px; }\n        .counter-demo { background: white; padding: 40px; border-radius: 8px; max-width: 400px; margin: 0 auto; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }\n        .counter { font-size: 3em; text-align: center; color: #667eea; margin: 30px 0; font-weight: bold; }\n        button { width: 100%; padding: 12px; margin: 10px 0; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; background: #667eea; color: white; }\n        button:hover { background: #5568d3; }\n        .footer { background: #1a202c; color: white; padding: 20px; text-align: center; }\n    </style>\n</head>\n<body>\n    <!-- 네비게이션 -->\n    <div class=\"navbar\">\n        <div class=\"navbar-container\">\n            <div class=\"navbar-brand\">🚀 FreeLang</div>\n            <div class=\"navbar-menu\">\n                <a href=\"/\">홈</a>\n                <a href=\"/blog.html\">블로그</a>\n                <a href=\"/search.html\">검색</a>\n                <a href=\"/profile.html\">프로필</a>\n                <a href=\"/admin.html\">관리자</a>\n            </div>\n        </div>\n    </div>\n\n    <!-- 헤로 섹션 -->\n    <div class=\"hero\">\n        <h1 class=\"hero-title\">FreeLang HTTP Engine</h1>\n        <p class=\"hero-subtitle\">Node.js 없이 100% FreeLang으로 만든 웹 서버</p>\n        <div class=\"hero-buttons\">\n            <a href=\"/blog.html\" class=\"hero-btn btn-primary\">블로그 읽기</a>\n            <a href=\"/search.html\" class=\"hero-btn btn-secondary\">검색하기</a>\n        </div>\n    </div>\n\n    <!-- 메인 콘텐츠 -->\n    <div class=\"container\">\n        <!-- 특징 -->\n        <div class=\"features\">\n            <div class=\"feature\">\n                <div class=\"feature-icon\">⚡</div>\n                <div class=\"feature-title\">빠른 성능</div>\n                <div class=\"feature-text\">순수 FreeLang으로 구현된 가벼운 HTTP 서버</div>\n            </div>\n            <div class=\"feature\">\n                <div class=\"feature-icon\">🎨</div>\n                <div class=\"feature-title\">동적 CSS</div>\n                <div class=\"feature-text\">런타임에 CSS를 동적으로 생성하는 테마 시스템</div>\n            </div>\n            <div class=\"feature\">\n                <div class=\"feature-icon\">🔒</div>\n                <div class=\"feature-title\">안전성</div>\n                <div class=\"feature-text\">0 외부 의존성, 자체 검증된 코드</div>\n            </div>\n            <div class=\"feature\">\n                <div class=\"feature-icon\">📱</div>\n                <div class=\"feature-title\">반응형</div>\n                <div class=\"feature-text\">모든 디바이스에 최적화된 인터페이스</div>\n            </div>\n            <div class=\"feature\">\n                <div class=\"feature-icon\">🌙</div>\n                <div class=\"feature-title\">다크 모드</div>\n                <div class=\"feature-text\">시스템 설정에 따른 자동 테마 변경</div>\n            </div>\n            <div class=\"feature\">\n                <div class=\"feature-icon\">🚀</div>\n                <div class=\"feature-title\">배포 용이</div>\n                <div class=\"feature-text\">단일 바이너리로 어디서나 실행</div>\n            </div>\n        </div>\n\n        <!-- Counter 데모 -->\n        <div class=\"demo-section\">\n            <h2 style=\"text-align: center; color: #333; margin-top: 0;\">📊 Counter Demo</h2>\n            <div class=\"counter-demo\">\n                <div class=\"counter\" id=\"counter\">0</div>\n                <button onclick=\"increment()\">+1 증가</button>\n                <button onclick=\"decrement()\">-1 감소</button>\n                <button onclick=\"reset()\">초기화</button>\n            </div>\n        </div>\n    </div>\n\n    <!-- 푸터 -->\n    <div class=\"footer\">\n        <p>© 2026 FreeLang Project. Made with ❤️ in Korea.</p>\n    </div>\n\n    <script>\n        async function increment() {\n            await fetch('/api/counter/increment', { method: 'POST' });\n            loadCounter();\n        }\n        async function decrement() {\n            await fetch('/api/counter/decrement', { method: 'POST' });\n            loadCounter();\n        }\n        async function reset() {\n            await fetch('/api/counter/reset', { method: 'POST' });\n            loadCounter();\n        }\n        function loadCounter() {\n            fetch('/api/counter').then(r => r.json()).then(d => {\n                document.getElementById('counter').innerText = d.data.count || '0';\n            });\n        }\n        loadCounter();\n    </script>\n</body>\n</html>`\n}\n\nfunc getBlogHtml() -> string {\n  return `<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Blog - FreeLang</title>\n    <link rel=\"stylesheet\" href=\"/styles.css\">\n    <style>\n        body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; background: #f5f5f5; padding: 40px 20px; }\n        .container { max-width: 800px; margin: 0 auto; background: white; border-radius: 8px; padding: 40px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }\n        h1 { color: #333; text-align: center; margin-bottom: 30px; }\n        .blog-list { margin: 30px 0; }\n        .blog-item { padding: 20px; margin: 15px 0; background: #f9f9f9; border-radius: 8px; border-left: 4px solid #667eea; }\n        .blog-title { font-size: 1.2em; font-weight: bold; color: #667eea; margin-bottom: 8px; }\n        .blog-meta { font-size: 0.9em; color: #999; margin-bottom: 8px; }\n        .blog-summary { color: #555; line-height: 1.6; }\n        a { color: #667eea; text-decoration: none; }\n        a:hover { text-decoration: underline; }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>📝 FreeLang 블로그</h1>\n        <div class=\"blog-list\" id=\"blogs\">\n            <p style=\"text-align: center; color: #999;\">아직 발행된 블로그가 없습니다.</p>\n        </div>\n        <div style=\"text-align: center; margin-top: 30px;\">\n            <a href=\"/\">← 홈으로</a>\n        </div>\n    </div>\n    <script>\n        fetch('/api/blogs').then(r => r.json()).then(d => {\n            const blogs = d.data.blogs || [];\n            if (blogs.length === 0) {\n                document.getElementById('blogs').innerHTML = '<p style=\"text-align: center; color: #999;\">아직 발행된 블로그가 없습니다.</p>';\n            } else {\n                document.getElementById('blogs').innerHTML = blogs.map(b => `\n                    <div class=\"blog-item\">\n                        <div class=\"blog-title\">${b.title}</div>\n                        <div class=\"blog-meta\">${b.author} · ${b.category}</div>\n                        <div class=\"blog-summary\">${b.summary}</div>\n                    </div>\n                `).join('');\n            }\n        });\n    </script>\n</body>\n</html>`\n}\n\nfunc getTailwindRuntime() -> string {\n  return `// ============================================================================\n// Phase 14: Tailwind Runtime - Dynamic Class Manipulation & CSS Loading\n// ============================================================================\n\nclass TailwindRuntime {\n  constructor() {\n    this.config = null;\n    this.theme = this.getStoredTheme() || 'light';\n    this.breakpoint = this.getCurrentBreakpoint();\n    this.styleSheet = null;\n    this.classList = new Set();\n    this.init();\n  }\n\n  async init() {\n    try {\n      await this.loadTailwindCSS();\n      this.observeDOM();\n      this.setupResponsiveListener();\n      this.applyTheme();\n      console.log('[Tailwind] Runtime initialized successfully');\n    } catch (error) {\n      console.error('[Tailwind] Initialization failed:', error);\n    }\n  }\n\n  async loadTailwindCSS() {\n    const cssPath = this.theme === 'dark' ? '/styles-dark.css' : '/styles.css';\n    if (!document.getElementById('tailwind-css')) {\n      const link = document.createElement('link');\n      link.id = 'tailwind-css';\n      link.rel = 'stylesheet';\n      link.href = cssPath;\n      document.head.appendChild(link);\n      return new Promise((resolve) => {\n        link.onload = resolve;\n        setTimeout(resolve, 2000);\n      });\n    }\n  }\n\n  getCurrentTheme() {\n    return this.theme;\n  }\n\n  async switchTheme(theme) {\n    if (theme !== 'light' && theme !== 'dark') return;\n    this.theme = theme;\n    this.saveTheme(theme);\n    await this.loadTailwindCSS();\n    this.applyTheme();\n    document.dispatchEvent(new CustomEvent('tailwind:themechange', { detail: { theme } }));\n  }\n\n  applyTheme() {\n    const root = document.documentElement;\n    if (this.theme === 'dark') {\n      root.classList.add('dark');\n    } else {\n      root.classList.remove('dark');\n    }\n    this.saveTheme(this.theme);\n  }\n\n  getStoredTheme() {\n    try {\n      return localStorage.getItem('tailwind-theme');\n    } catch {\n      return null;\n    }\n  }\n\n  saveTheme(theme) {\n    try {\n      localStorage.setItem('tailwind-theme', theme);\n    } catch {}\n  }\n\n  getCurrentBreakpoint() {\n    const width = window.innerWidth;\n    if (width >= 1280) return 'xl';\n    if (width >= 1024) return 'lg';\n    if (width >= 768) return 'md';\n    if (width >= 640) return 'sm';\n    return 'xs';\n  }\n\n  setupResponsiveListener() {\n    let resizeTimeout;\n    window.addEventListener('resize', () => {\n      clearTimeout(resizeTimeout);\n      resizeTimeout = setTimeout(() => {\n        const newBreakpoint = this.getCurrentBreakpoint();\n        if (newBreakpoint !== this.breakpoint) {\n          this.breakpoint = newBreakpoint;\n          document.dispatchEvent(new CustomEvent('tailwind:breakpoint', {\n            detail: { breakpoint: newBreakpoint }\n          }));\n        }\n      }, 200);\n    });\n  }\n\n  addClass(element, className) {\n    if (typeof element === 'string') element = document.querySelector(element);\n    if (!element) return;\n    const classes = className.split(' ').filter(c => c.trim());\n    classes.forEach(cls => {\n      element.classList.add(cls);\n      this.classList.add(cls);\n    });\n    return element;\n  }\n\n  removeClass(element, className) {\n    if (typeof element === 'string') element = document.querySelector(element);\n    if (!element) return;\n    const classes = className.split(' ').filter(c => c.trim());\n    classes.forEach(cls => element.classList.remove(cls));\n    return element;\n  }\n\n  toggleClass(element, className) {\n    if (typeof element === 'string') element = document.querySelector(element);\n    if (!element) return;\n    element.classList.toggle(className);\n    if (element.classList.contains(className)) this.classList.add(className);\n    return element;\n  }\n\n  applyClass(element, className, condition) {\n    if (typeof element === 'string') element = document.querySelector(element);\n    if (!element) return;\n    if (condition) {\n      this.addClass(element, className);\n    } else {\n      this.removeClass(element, className);\n    }\n    return element;\n  }\n\n  observeDOM() {\n    const observer = new MutationObserver((mutations) => {\n      mutations.forEach((mutation) => {\n        if (mutation.type === 'childList') {\n          mutation.addedNodes.forEach((node) => {\n            if (node.nodeType === 1) this.scanElementClasses(node);\n          });\n        }\n      });\n    });\n    observer.observe(document.body, {\n      childList: true,\n      subtree: true,\n      attributes: false,\n      characterData: false\n    });\n  }\n\n  scanElementClasses(element) {\n    if (element.classList) {\n      element.classList.forEach(cls => {\n        if (this.isTailwindClass(cls)) this.classList.add(cls);\n      });\n    }\n    if (element.children) {\n      Array.from(element.children).forEach(child => this.scanElementClasses(child));\n    }\n  }\n\n  isTailwindClass(className) {\n    const patterns = [\n      /^(sm-|md-|lg-|xl-)?flex/, /^(sm-|md-|lg-|xl-)?grid/,\n      /^(sm-|md-|lg-|xl-)?p-/, /^(sm-|md-|lg-|xl-)?m-/, /^(sm-|md-|lg-|xl-)?gap-/,\n      /^(sm-|md-|lg-|xl-)?w-/, /^(sm-|md-|lg-|xl-)?h-/, /^(sm-|md-|lg-|xl-)?text-/,\n      /^(sm-|md-|lg-|xl-)?bg-/, /^(sm-|md-|lg-|xl-)?border/, /^(sm-|md-|lg-|xl-)?rounded/,\n      /^(sm-|md-|lg-|xl-)?shadow/, /^hover-/, /^focus-/, /^active-/,\n      /^disabled-/, /^transition/, /^duration-/, /^ease-/\n    ];\n    return patterns.some(pattern => pattern.test(className));\n  }\n\n  getUsedClasses() {\n    return Array.from(this.classList);\n  }\n\n  getStats() {\n    return {\n      theme: this.theme,\n      breakpoint: this.breakpoint,\n      usedClasses: this.classList.size,\n      classes: this.getUsedClasses()\n    };\n  }\n\n  enableDebugMode() {\n    window.tailwind = {\n      theme: this.getCurrentTheme(),\n      switchTheme: (theme) => this.switchTheme(theme),\n      addClass: (el, cls) => this.addClass(el, cls),\n      removeClass: (el, cls) => this.removeClass(el, cls),\n      toggleClass: (el, cls) => this.toggleClass(el, cls),\n      getBreakpoint: () => this.breakpoint,\n      getStats: () => this.getStats(),\n      toggleDarkMode: () => this.switchTheme(this.theme === 'dark' ? 'light' : 'dark')\n    };\n    console.log('[Tailwind] Debug mode enabled. Use window.tailwind to access runtime.');\n  }\n}\n\nlet tailwindRuntime = null;\n\ndocument.addEventListener('DOMContentLoaded', () => {\n  tailwindRuntime = new TailwindRuntime();\n  tailwindRuntime.enableDebugMode();\n});\n\nwindow.tailwindSetTheme = (theme) => {\n  if (tailwindRuntime) tailwindRuntime.switchTheme(theme);\n};\n\nwindow.tailwindToggleDarkMode = () => {\n  if (tailwindRuntime) {\n    const newTheme = tailwindRuntime.getCurrentTheme() === 'dark' ? 'light' : 'dark';\n    tailwindRuntime.switchTheme(newTheme);\n  }\n};\n\nwindow.tailwindAddClass = (selector, className) => {\n  if (tailwindRuntime) tailwindRuntime.addClass(selector, className);\n};\n\nwindow.tailwindRemoveClass = (selector, className) => {\n  if (tailwindRuntime) tailwindRuntime.removeClass(selector, className);\n};\n\nwindow.tailwindToggleClass = (selector, className) => {\n  if (tailwindRuntime) tailwindRuntime.toggleClass(selector, className);\n};\n\ndocument.addEventListener('tailwind:themechange', (event) => {\n  console.log('[Tailwind] Theme changed to:', event.detail.theme);\n});\n\ndocument.addEventListener('tailwind:breakpoint', (event) => {\n  console.log('[Tailwind] Breakpoint changed to:', event.detail.breakpoint);\n});\n`\n}\n\nexport {\n  handleEngineRequest\n}\n","structuredPatch":[{"oldStart":306,"oldLines":6,"newStart":306,"newLines":7,"lines":["     <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">","     <title>FreeLang HTTP Engine - Home</title>","     <link rel=\"stylesheet\" href=\"/styles.css\">","+    <script src=\"/tailwind-runtime.js\" defer></script>","     <style>","         body { margin: 0; padding: 0; }","         .navbar { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"ba0058d0-7322-451a-a9de-8aeb5a5023a7","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
