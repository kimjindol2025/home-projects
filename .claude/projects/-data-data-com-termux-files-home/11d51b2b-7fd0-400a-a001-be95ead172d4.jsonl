ter)\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  if method == \"POST\" && path == \"/api/counter/reset\" {\n    let counter = resetCounter()\n    let body = buildJson(\"success\", counter)\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Blog API - GET /api/blogs (발행된 블로그만)\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"GET\" && path == \"/api/blogs\" {\n    let blogs = getBlogs(BlogStatus.PUBLISHED)\n    let body = `{\n  \"status\": \"success\",\n  \"data\": {\n    \"blogs\": [],\n    \"count\": 0\n  }\n}`\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Blog API - GET /api/blogs/all (모든 블로그)\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"GET\" && path == \"/api/blogs/all\" {\n    let body = `{\n  \"status\": \"success\",\n  \"data\": {\n    \"blogs\": [],\n    \"count\": 0\n  }\n}`\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Blog API - POST /api/blogs (블로그 생성)\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"POST\" && path == \"/api/blogs\" {\n    // JSON 파싱 후 블로그 생성\n    let blog = createBlog(\n      \"New Blog\",\n      \"new-blog\",\n      \"Content...\",\n      \"Summary...\",\n      \"Author\",\n      \"Technology\",\n      []\n    )\n    let body = `{","numLines":100,"startLine":1,"totalLines":749}},"sourceToolAssistantUUID":"fad7c15e-37b3-435f-932e-fc3a7bbeee44","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
