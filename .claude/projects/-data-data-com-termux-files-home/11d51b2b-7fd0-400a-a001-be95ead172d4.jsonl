S\",","+    \"Access-Control-Allow-Headers\": \"Content-Type\"","+  }","+}","+","+func stringToBytes(s: string) -> array<u8> {","+  // 간단한 구현: 문자열을 바이트 배열로","+  let bytes: array<u8> = []","+  // 실제 구현은 FreeLang 문법에 따라 필요","+  return bytes","+}","+","+func getIndexHtml() -> string {","+  return `<!DOCTYPE html>","+<html lang=\"ko\">","+<head>","+    <meta charset=\"UTF-8\">","+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">","+    <title>FreeLang HTTP Engine Demo</title>","+    <style>","+        body {","+            font-family: -apple-system, BlinkMacSystemFont, sans-serif;","+            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);","+            min-height: 100vh;","+            display: flex;","+            align-items: center;","+            justify-content: center;","+            padding: 20px;","+        }","+        .container {","+            background: white;","+            border-radius: 16px;","+            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);","+            padding: 40px;","+            max-width: 500px;","+            width: 100%;","+        }","+        h1 {","+            color: #333;","+            text-align: center;","+            font-size: 2em;","+            margin-bottom: 30px;","+        }","+        .counter {","+            font-size: 3em;","+            text-align: center;","+            color: #667eea;","+            margin: 30px 0;","+            font-weight: bold;","+        }","+        button {","+            display: block;","+            width: 100%;","+            padding: 12px;","+            margin: 10px 0;","+            border: none;","+            border-radius: 8px;","+            font-weight: 600;","+            cursor: pointer;","+            background: #667eea;","+            color: white;","+        }","+        button:hover {","+            background: #5568d3;","+        }","+    </style>","+</head>","+<body>","+    <div class=\"container\">","+        <h1>🚀 FreeLang HTTP Engine</h1>","+        <div class=\"counter\" id=\"counter\">0</div>","+        <button onclick=\"increment()\">+1 증가</button>","+        <button onclick=\"decrement()\">-1 감소</button>","+        <button onclick=\"reset()\">초기화</button>","+        <p style=\"text-align: center; margin-top: 30px; color: #999;\">","+            TCP + HTTP/1.1 Parser로 구현된 순수 FreeLang 웹 서버","+        </p>","+    </div>","+    <script>","+        async function increment() {","+            const res = await fetch('/api/counter/increment', { method: 'POST' });","+            const data = await res.json();","+            document.getElementById('counter').innerText = data.data.count || '?';","+        }","+        async function decrement() {","+            const res = await fetch('/api/counter/decrement', { method: 'POST' });","+            const data = await res.json();","+            document.getElementById('counter').innerText = data.data.count || '?';","+        }","+        async function reset() {","+            const res = await fetch('/api/counter/reset', { method: 'POST' });","+            const data = await res.json();","+            document.getElementById('counter').innerText = data.data.count || '?';","+        }","+        async function load() {","+            const res = await fetch('/api/counter');","+            const data = await res.json();","+            document.getElementById('counter').innerText = data.data.count || '0';","+        }","+        load();","+    </script>","+</body>","+</html>`","+}","+","+func getBlogHtml() -> string {","+  return `<!DOCTYPE html>","+<html lang=\"ko\">","+<head>","+    <meta charset=\"UTF-8\">","+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">","+    <title>Blog - FreeLang</title>","+    <style>","+        body {","+            font-family: -apple-system, BlinkMacSystemFont, sans-serif;","+            background: #f5f5f5;","+            padding: 40px 20px;","+        }","+        .container {","+            max-width: 800px;","+            margin: 0 auto;","+            background: white;","+            border-radius: 8px;","+            padding: 40px;","+            box-shadow: 0 2px 8px rgba(0,0,0,0.1);","+        }","+        h1 {","+            color: #333;","+            text-align: center;","+            margin-bottom: 30px;","+        }","+        a {","+            color: #667eea;","+            text-decoration: none;","+        }","+        a:hover {","+            text-decoration: underline;","+        }","+    </style>","+</head>","+<body>","+    <div class=\"container\">","+        <h1>📝 FreeLang 블로그</h1>","+        <p style=\"text-align: center; color: #999;\">아직 발행된 블로그가 없습니다.</p>","+        <div style=\"text-align: center;\">","+            <a href=\"/\">← 홈으로</a>","+        </div>","+    </div>","+</body>","+</html>`","+}","+"," // ──────────────────────────────────────────────────────────────────────────","-// 내보내기","+// Export"," // ──────────────────────────────────────────────────────────────────────────"," "," export {","-  EngineRequest,","-  EngineResponse,","-  parseHttpRequest,","-  buildEngineResponse,","-  serializeEngineResponse,","   handleEngineRequest"," }"]}],"originalFile":"// ============================================================================\n// FreeLang HTTP Engine Integration\n// freelang-http-engine과 freelang-hybrid의 통합 레이어\n// ============================================================================\n\nuse \"http-server\"\nuse \"../core/state\"\n\n// ──────────────────────────────────────────────────────────────────────────\n// HTTP 요청/응답 타입 (http-engine과 호환)\n// ──────────────────────────────────────────────────────────────────────────\n\nrecord EngineRequest {\n  method: string        // \"GET\", \"POST\", \"PUT\", \"DELETE\"\n  path: string         // \"/api/counter\", \"/api/blogs\"\n  version: string      // \"HTTP/1.1\"\n  headers: map<string, string>\n  body: string\n  bodyLen: number\n}\n\nrecord EngineResponse {\n  version: string      // \"HTTP/1.1\"\n  status: number       // 200, 404, 500\n  reason: string       // \"OK\", \"Not Found\"\n  headers: map<string, string>\n  body: string\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// HTTP 요청 파싱 (TCP 소켓에서 읽은 바이트 → 구조화된 요청)\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc parseHttpRequest(rawBytes: string) -> EngineRequest {\n  let lines = rawBytes.split(\"\\r\\n\")\n\n  // 요청 라인 파싱: GET /api/counter HTTP/1.1\n  let requestLine = lines[0].split(\" \")\n  let method = requestLine[0]\n  let pathWithQuery = requestLine[1]\n  let version = requestLine[2]\n\n  // Path와 Query 분리\n  let pathParts = pathWithQuery.split(\"?\")\n  let path = pathParts[0]\n\n  // 헤더 파싱\n  let headers: map<string, string> = {}\n  let bodyStart = 0\n\n  for i in 1..lines.length {\n    if lines[i] == \"\" {\n      bodyStart = i + 1\n      break\n    }\n\n    let headerParts = lines[i].split(\": \")\n    if headerParts.length == 2 {\n      headers[headerParts[0]] = headerParts[1]\n    }\n  }\n\n  // 바디 추출\n  let body = bodyStart < lines.length ? lines[bodyStart..].join(\"\\r\\n\") : \"\"\n\n  return {\n    method: method,\n    path: path,\n    version: version,\n    headers: headers,\n    body: body,\n    bodyLen: body.length\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// HTTP 응답 빌드\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc buildEngineResponse(status: number, headers: map<string, string>, body: string) -> EngineResponse {\n  let reason = getStatusReason(status)\n\n  return {\n    version: \"HTTP/1.1\",\n    status: status,\n    reason: reason,\n    headers: headers,\n    body: body\n  }\n}\n\nfunc getStatusReason(status: number) -> string {\n  match status {\n    200 => \"OK\"\n    201 => \"Created\"\n    204 => \"No Content\"\n    400 => \"Bad Request\"\n    404 => \"Not Found\"\n    500 => \"Internal Server Error\"\n    default => \"Unknown\"\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// HTTP 응답 직렬화 (구조화된 응답 → 바이트)\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc serializeEngineResponse(resp: EngineResponse) -> string {\n  let statusLine = `\\(resp.version) \\(resp.status) \\(resp.reason)\\r\\n`\n\n  let headerLines = \"\"\n  for key, value in resp.headers {\n    headerLines += `\\(key): \\(value)\\r\\n`\n  }\n\n  // Content-Length 추가\n  headerLines += `Content-Length: \\(resp.body.length)\\r\\n`\n\n  return statusLine + headerLines + \"\\r\\n\" + resp.body\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 라우팅 핸들러\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc handleEngineRequest(request: EngineRequest) -> EngineResponse {\n  let method = request.method\n  let path = request.path\n\n  // Counter API\n  match (method, path) {\n    (\"GET\", \"/api/counter\") => {\n      let counter = getCounter()\n      return buildEngineResponse(200, {\n        \"Content-Type\": \"application/json\",\n        \"Access-Control-Allow-Origin\": \"*\"\n      }, jsonResponse(\"success\", counter))\n    }\n\n    (\"POST\", \"/api/counter/increment\") => {\n      let counter = incrementCounter()\n      return buildEngineResponse(200, {\n        \"Content-Type\": \"application/json\",\n        \"Access-Control-Allow-Origin\": \"*\"\n      }, jsonResponse(\"success\", counter))\n    }\n\n    (\"POST\", \"/api/counter/decrement\") => {\n      let counter = decrementCounter()\n      return buildEngineResponse(200, {\n        \"Content-Type\": \"application/json\",\n        \"Access-Control-Allow-Origin\": \"*\"\n      }, jsonResponse(\"success\", counter))\n    }\n\n    (\"POST\", \"/api/counter/reset\") => {\n      let counter = resetCounter()\n      return buildEngineResponse(200, {\n        \"Content-Type\": \"application/json\",\n        \"Access-Control-Allow-Origin\": \"*\"\n      }, jsonResponse(\"success\", counter))\n    }\n\n    // Health Check\n    (\"GET\", \"/api/health\") => {\n      return buildEngineResponse(200, {\n        \"Content-Type\": \"application/json\",\n        \"Access-Control-Allow-Origin\": \"*\"\n      }, `{\n  \"status\": \"healthy\",\n  \"timestamp\": \"2026-03-12T00:00:00Z\",\n  \"database\": {\n    \"todos\": 0,\n    \"counters\": 1,\n    \"healthy\": true\n  }\n}`)\n    }\n\n    // 404\n    default => {\n      return buildEngineResponse(404, {\n        \"Content-Type\": \"application/json\",\n        \"Access-Control-Allow-Origin\": \"*\"\n      }, `{\n  \"status\": \"error\",\n  \"statusCode\": 404,\n  \"message\": \"Not Found\"\n}`)\n    }\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// JSON 응답 헬퍼\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc jsonResponse(status: string, data: any) -> string {\n  return `{\n  \"status\": \"\\(status)\",\n  \"data\": {}\n}`\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 내보내기\n// ──────────────────────────────────────────────────────────────────────────\n\nexport {\n  EngineRequest,\n  EngineResponse,\n  parseHttpRequest,\n  buildEngineResponse,\n  serializeEngineResponse,\n  handleEngineRequest\n}\n"},"sourceToolAssistantUUID":"aa3b6deb-e3ca-494f-82b0-62af35f58f1e","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
