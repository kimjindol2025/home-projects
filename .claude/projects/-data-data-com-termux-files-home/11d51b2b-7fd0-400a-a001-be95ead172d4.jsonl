{"parentUuid":"fece867c-e156-49b0-8f11-0f8e57f3a419","isSidechain":false,"promptId":"5a4f8631-30cf-4c83-835b-a950305c9468","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0183YGmHThvPnRhFjybDpb7c","type":"tool_result","content":"File created successfully at: /data/data/com.termux/files/home/freelang-hybrid/freelang/server/http-server.free"}]},"uuid":"5aea32d8-a705-4be4-9ce8-97f67186e245","timestamp":"2026-03-12T13:02:48.314Z","toolUseResult":{"type":"create","filePath":"/data/data/com.termux/files/home/freelang-hybrid/freelang/server/http-server.free","content":"// ============================================================================\n// FreeLang HTTP Server: 네이티브 웹 서버\n// 포트 3000에서 바인드, 정적 파일 + API 서빙\n// ============================================================================\n\nuse \"..core/state\"\nuse \"./router\"\n\n// ──────────────────────────────────────────────────────────────────────────\n// 상수\n// ──────────────────────────────────────────────────────────────────────────\n\nconst PORT = 3000\nconst LISTEN_ADDR = \"127.0.0.1\"\nconst MAX_REQUEST_SIZE = 1024 * 1024  // 1MB\n\n// ──────────────────────────────────────────────────────────────────────────\n// HTTP 요청/응답 타입\n// ──────────────────────────────────────────────────────────────────────────\n\nrecord HttpRequest {\n  method: string        // \"GET\", \"POST\", \"PUT\", \"DELETE\", \"PATCH\"\n  path: string\n  query: map<string, string>\n  headers: map<string, string>\n  body: string\n}\n\nrecord HttpResponse {\n  status: number\n  headers: map<string, string>\n  body: string\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 내장 정적 파일\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc getEmbeddedFile(path: string) -> string? {\n  match path {\n    \"/\" | \"/index.html\" => return getIndexHtml()\n    \"/blog.html\" => return getBlogHtml()\n    \"/freelang-bridge.js\" => return getFreelangBridgeJs()\n    \"/main.js\" => return getMainJs()\n    \"/style.css\" => return getStyleCss()\n    default => return null\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// HTML 임베드 (최소 구조)\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc getIndexHtml() -> string {\n  return `<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>FreeLang + JS 통합 예제</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            padding: 20px;\n        }\n\n        .container {\n            background: white;\n            border-radius: 16px;\n            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);\n            padding: 40px;\n            max-width: 500px;\n            width: 100%;\n        }\n\n        h1 {\n            color: #333;\n            margin-bottom: 30px;\n            text-align: center;\n            font-size: 2em;\n        }\n\n        .counter-display {\n            font-size: 3em;\n            font-weight: bold;\n            text-align: center;\n            color: #667eea;\n            margin: 30px 0;\n            font-family: 'Monaco', monospace;\n        }\n\n        .button-group {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 12px;\n            margin: 30px 0;\n        }\n\n        button {\n            padding: 12px 20px;\n            font-size: 1em;\n            border: none;\n            border-radius: 8px;\n            cursor: pointer;\n            font-weight: 600;\n            transition: all 0.3s ease;\n        }\n\n        .btn-primary {\n            background: #667eea;\n            color: white;\n            grid-column: 1 / -1;\n        }\n\n        .btn-primary:hover {\n            background: #5568d3;\n            transform: translateY(-2px);\n        }\n\n        .btn-secondary {\n            background: #f0f0f0;\n            color: #333;\n        }\n\n        .btn-secondary:hover {\n            background: #e0e0e0;\n        }\n\n        .stats {\n            margin-top: 30px;\n            padding: 20px;\n            background: #f9f9f9;\n            border-radius: 8px;\n        }\n\n        .stat-item {\n            display: flex;\n            justify-content: space-between;\n            margin: 10px 0;\n            font-size: 0.95em;\n        }\n\n        .stat-label {\n            color: #666;\n        }\n\n        .stat-value {\n            font-weight: bold;\n            color: #667eea;\n        }\n\n        .loading {\n            display: none;\n            text-align: center;\n            color: #999;\n            margin: 20px 0;\n        }\n\n        .loading.active {\n            display: block;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>🚀 FreeLang + JS</h1>\n\n        <div class=\"counter-display\" id=\"counter\">0</div>\n\n        <div class=\"button-group\">\n            <button class=\"btn-primary\" id=\"btn-increment\">+1 증가</button>\n            <button class=\"btn-secondary\" id=\"btn-decrement\">-1 감소</button>\n            <button class=\"btn-secondary\" id=\"btn-reset\">초기화</button>\n        </div>\n\n        <div class=\"loading\" id=\"loading\">\n            처리 중...\n        </div>\n\n        <div class=\"stats\">\n            <div class=\"stat-item\">\n                <span class=\"stat-label\">상태:</span>\n                <span class=\"stat-value\" id=\"status\">준비됨</span>\n            </div>\n            <div class=\"stat-item\">\n                <span class=\"stat-label\">요청:</span>\n                <span class=\"stat-value\" id=\"requests\">0</span>\n            </div>\n            <div class=\"stat-item\">\n                <span class=\"stat-label\">응답시간:</span>\n                <span class=\"stat-value\" id=\"response-time\">-</span>\n            </div>\n        </div>\n    </div>\n\n    <script src=\"freelang-bridge.js\"></script>\n    <script src=\"main.js\"></script>\n</body>\n</html>`\n}\n\nfunc getBlogHtml() -> string {\n  return `<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Blog - FreeLang</title>\n</head>\n<body>\n    <h1>Blog</h1>\n    <p>블로그는 준비 중입니다.</p>\n    <a href=\"/\">홈으로</a>\n</body>\n</html>`\n}\n\nfunc getStyleCss() -> string {\n  return `/* 스타일 시트 */`\n}\n\nfunc getFreelangBridgeJs() -> string {\n  return `// FreeLang 브리지 객체\nwindow.freelang = {\n    apiBase: 'http://127.0.0.1:3000',\n\n    async request(method, path, data) {\n        const startTime = performance.now();\n        try {\n            const options = {\n                method: method,\n                headers: {\n                    'Content-Type': 'application/json'\n                }\n            };\n\n            if (data && method !== 'GET') {\n                options.body = JSON.stringify(data);\n            }\n\n            const response = await fetch(this.apiBase + path, options);\n            const result = await response.json();\n\n            const duration = (performance.now() - startTime).toFixed(2);\n            window.debug?.logRequest(method, path, duration);\n\n            return result;\n        } catch (error) {\n            console.error('Freelang request error:', error);\n            return { status: 'error', message: error.message };\n        }\n    },\n\n    counter: {\n        async get() {\n            return window.freelang.request('GET', '/api/counter');\n        },\n        async increment() {\n            return window.freelang.request('POST', '/api/counter/increment');\n        },\n        async decrement() {\n            return window.freelang.request('POST', '/api/counter/decrement');\n        },\n        async reset() {\n            return window.freelang.request('POST', '/api/counter/reset');\n        }\n    }\n};\n\n// 디버그 객체\nwindow.debug = {\n    requestCount: 0,\n    logRequest(method, path, duration) {\n        this.requestCount++;\n        console.log(\\`[\\${method}] \\${path} - \\${duration}ms (Total: \\${this.requestCount})\\`);\n    }\n};`\n}\n\nfunc getMainJs() -> string {\n  return `// 이벤트 핸들러 + 상태 관리\nlet requestCount = 0;\n\nasync function updateCounter() {\n    const result = await window.freelang.counter.get();\n    if (result.status === 'success') {\n        document.getElementById('counter').innerText = result.data.count;\n    }\n}\n\nasync function handleIncrement() {\n    showLoading();\n    const result = await window.freelang.counter.increment();\n    if (result.status === 'success') {\n        updateCounter();\n        updateStats('증가됨');\n    }\n    hideLoading();\n}\n\nasync function handleDecrement() {\n    showLoading();\n    const result = await window.freelang.counter.decrement();\n    if (result.status === 'success') {\n        updateCounter();\n        updateStats('감소됨');\n    }\n    hideLoading();\n}\n\nasync function handleReset() {\n    showLoading();\n    const result = await window.freelang.counter.reset();\n    if (result.status === 'success') {\n        updateCounter();\n        updateStats('초기화됨');\n    }\n    hideLoading();\n}\n\nfunction updateStats(action) {\n    requestCount++;\n    document.getElementById('requests').innerText = requestCount;\n    document.getElementById('status').innerText = action;\n    document.getElementById('response-time').innerText = 'OK';\n}\n\nfunction showLoading() {\n    document.getElementById('loading').classList.add('active');\n}\n\nfunction hideLoading() {\n    document.getElementById('loading').classList.remove('active');\n}\n\n// 이벤트 리스너 등록\ndocument.addEventListener('DOMContentLoaded', () => {\n    document.getElementById('btn-increment').addEventListener('click', handleIncrement);\n    document.getElementById('btn-decrement').addEventListener('click', handleDecrement);\n    document.getElementById('btn-reset').addEventListener('click', handleReset);\n\n    // 초기 로드\n    updateCounter();\n    document.getElementById('status').innerText = '준비됨';\n});`\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 요청 파싱\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc parseHttpRequest(rawRequest: string) -> HttpRequest {\n  let lines = rawRequest.split(\"\\n\")\n  let firstLine = lines[0].split(\" \")\n\n  let method = firstLine[0]\n  let pathWithQuery = firstLine[1]\n  let pathParts = pathWithQuery.split(\"?\")\n  let path = pathParts[0]\n  let query = parseQueryString(pathParts.length > 1 ? pathParts[1] : \"\")\n\n  let headers: map<string, string> = {}\n  let bodyStart = 0\n\n  for i in 1..lines.length {\n    if lines[i] == \"\" {\n      bodyStart = i + 1\n      break\n    }\n\n    let headerParts = lines[i].split(\": \")\n    if headerParts.length == 2 {\n      headers[headerParts[0].toLowerCase()] = headerParts[1]\n    }\n  }\n\n  let body = bodyStart < lines.length ? lines[bodyStart..].join(\"\\n\") : \"\"\n\n  return {\n    method: method,\n    path: path,\n    query: query,\n    headers: headers,\n    body: body\n  }\n}\n\nfunc parseQueryString(query: string) -> map<string, string> {\n  let params: map<string, string> = {}\n\n  if query == \"\" {\n    return params\n  }\n\n  let parts = query.split(\"&\")\n  for part in parts {\n    let pair = part.split(\"=\")\n    if pair.length == 2 {\n      params[pair[0]] = pair[1]\n    }\n  }\n\n  return params\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 응답 생성\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc buildHttpResponse(response: HttpResponse) -> string {\n  let status = getStatusText(response.status)\n  let result = \"HTTP/1.1 \\(response.status) \\(status)\\r\\n\"\n\n  result += \"Server: FreeLang/1.0\\r\\n\"\n  result += \"Connection: close\\r\\n\"\n  result += \"Content-Length: \\(response.body.length)\\r\\n\"\n\n  for key, value in response.headers {\n    result += \"\\(key): \\(value)\\r\\n\"\n  }\n\n  result += \"\\r\\n\"\n  result += response.body\n\n  return result\n}\n\nfunc getStatusText(status: number) -> string {\n  match status {\n    200 => \"OK\"\n    201 => \"Created\"\n    400 => \"Bad Request\"\n    404 => \"Not Found\"\n    500 => \"Internal Server Error\"\n    default => \"Unknown\"\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// CORS 헤더\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc getCorsHeaders() -> map<string, string> {\n  return {\n    \"Access-Control-Allow-Origin\": \"*\",\n    \"Access-Control-Allow-Methods\": \"GET, POST, PUT, DELETE, OPTIONS\",\n    \"Access-Control-Allow-Headers\": \"Content-Type\"\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 서버 시작\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc startServer() {\n  println(\"═══════════════════════════════════════════════════════\")\n  println(\"🚀 FreeLang HTTP Server 시작\")\n  println(\"═══════════════════════════════════════════════════════\")\n  println(\"📍 주소: http://\\(LISTEN_ADDR):\\(PORT)\")\n  println(\"═══════════════════════════════════════════════════════\")\n\n  // 여기서 실제 TCP 서버 구현이 필요함\n  // 현재는 개념 증명용 스켈레톤\n  handleConnections()\n}\n\nfunc handleConnections() {\n  // TCP 수신 대기 루프\n  loop {\n    // 클라이언트 연결 수락\n    // rawRequest = readSocket()\n    // request = parseHttpRequest(rawRequest)\n    // response = handleRequest(request)\n    // writeSocket(buildHttpResponse(response))\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 라우팅\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc handleRequest(request: HttpRequest) -> HttpResponse {\n  // 정적 파일 요청\n  if request.method == \"GET\" {\n    let file = getEmbeddedFile(request.path)\n    if file {\n      let contentType = getContentType(request.path)\n      return {\n        status: 200,\n        headers: {\n          \"Content-Type\": contentType,\n          ...getCorsHeaders()\n        },\n        body: file\n      }\n    }\n  }\n\n  // API 라우팅\n  return handleApiRequest(request)\n}\n\nfunc getContentType(path: string) -> string {\n  match path {\n    _ if path.endsWith(\".html\") => \"text/html; charset=utf-8\"\n    _ if path.endsWith(\".js\") => \"application/javascript; charset=utf-8\"\n    _ if path.endsWith(\".css\") => \"text/css; charset=utf-8\"\n    _ if path.endsWith(\".json\") => \"application/json\"\n    default => \"text/plain\"\n  }\n}\n\nfunc handleApiRequest(request: HttpRequest) -> HttpResponse {\n  // router 모듈에 위임\n  return routeRequest(request)\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 내보내기\n// ──────────────────────────────────────────────────────────────────────────\n\nexport {\n  startServer,\n  handleRequest,\n  parseHttpRequest,\n  buildHttpResponse,\n  PORT,\n  LISTEN_ADDR\n}\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"fece867c-e156-49b0-8f11-0f8e57f3a419","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
