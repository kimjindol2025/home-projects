{"parentUuid":"6c3e1682-2ee0-4656-84ae-950048f0f987","isSidechain":false,"promptId":"bfc6b3c2-2b85-472e-8cf2-4539f3af6c21","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NjhceihYfPBNB1xSpgExHk","type":"tool_result","content":"File created successfully at: /data/data/com.termux/files/home/freelang-hybrid/freelang/core/autoscaling.js"}]},"uuid":"22d6c2d7-4e30-478a-9834-865e957c0287","timestamp":"2026-03-13T04:19:53.546Z","toolUseResult":{"type":"create","filePath":"/data/data/com.termux/files/home/freelang-hybrid/freelang/core/autoscaling.js","content":"// ============================================================================\n// Phase 5 New: Dynamic Autoscaling & Load Management\n// ============================================================================\n\nconst crypto = require('crypto');\n\nclass AutoScaler {\n  constructor(options = {}) {\n    this.minInstances = options.minInstances || 2;\n    this.maxInstances = options.maxInstances || 10;\n    this.targetCPU = options.targetCPU || 70;  // 70% CPU target\n    this.targetMemory = options.targetMemory || 80;\n    this.scaleUpThreshold = options.scaleUpThreshold || 3;  // Seconds above threshold\n    this.scaleDownThreshold = options.scaleDownThreshold || 10;\n\n    this.instances = [];\n    this.metrics = [];\n    this.decisions = [];\n    this.scaleCounter = 0;\n    this.lastScaleAction = Date.now();\n\n    this.initialize();\n  }\n\n  initialize() {\n    // Create minimum instances\n    for (let i = 0; i < this.minInstances; i++) {\n      this.addInstance();\n    }\n    console.log(`✅ Autoscaler initialized with ${this.minInstances} instances`);\n  }\n\n  addInstance() {\n    const instance = {\n      id: generateId(),\n      status: 'running',\n      createdAt: Date.now(),\n      cpu: 0,\n      memory: 0,\n      requests: 0,\n      errors: 0,\n      lastHealthCheck: Date.now()\n    };\n    this.instances.push(instance);\n    console.log(`✅ Instance added: ${instance.id}`);\n    return instance.id;\n  }\n\n  removeInstance(instanceId) {\n    const idx = this.instances.findIndex(i => i.id === instanceId);\n    if (idx >= 0) {\n      this.instances.splice(idx, 1);\n      console.log(`✅ Instance removed: ${instanceId}`);\n      return true;\n    }\n    return false;\n  }\n\n  // Update instance metrics\n  updateMetrics(instanceId, metrics) {\n    const instance = this.instances.find(i => i.id === instanceId);\n    if (instance) {\n      instance.cpu = metrics.cpu || 0;\n      instance.memory = metrics.memory || 0;\n      instance.requests = (instance.requests || 0) + (metrics.newRequests || 0);\n      instance.errors = (instance.errors || 0) + (metrics.newErrors || 0);\n      instance.lastHealthCheck = Date.now();\n\n      this.metrics.push({\n        timestamp: Date.now(),\n        instanceId,\n        cpu: instance.cpu,\n        memory: instance.memory\n      });\n\n      // Keep last 1000 metrics\n      if (this.metrics.length > 1000) {\n        this.metrics.shift();\n      }\n    }\n  }\n\n  // Main scaling decision algorithm\n  makeScalingDecision() {\n    const avgCPU = this.getAverageCPU();\n    const avgMemory = this.getAverageMemory();\n    const currentInstanceCount = this.instances.length;\n\n    const decision = {\n      timestamp: Date.now(),\n      currentInstances: currentInstanceCount,\n      avgCPU,\n      avgMemory,\n      action: 'none',\n      reason: ''\n    };\n\n    // Scale UP: CPU or Memory above threshold\n    if (avgCPU > this.targetCPU || avgMemory > this.targetMemory) {\n      this.scaleCounter++;\n\n      if (this.scaleCounter >= this.scaleUpThreshold && currentInstanceCount < this.maxInstances) {\n        const newCount = Math.min(currentInstanceCount + 1, this.maxInstances);\n        decision.action = 'scale_up';\n        decision.reason = `CPU: ${avgCPU}%, Memory: ${avgMemory}%`;\n        decision.newInstances = newCount;\n\n        this.addInstance();\n        this.scaleCounter = 0;\n        this.lastScaleAction = Date.now();\n\n        console.log(`📈 SCALE UP: ${currentInstanceCount} → ${newCount} instances`);\n      }\n    }\n    // Scale DOWN: CPU and Memory below 30%\n    else if (avgCPU < 30 && avgMemory < 30) {\n      this.scaleCounter--;\n\n      if (this.scaleCounter <= -this.scaleDownThreshold && currentInstanceCount > this.minInstances) {\n        const newCount = Math.max(currentInstanceCount - 1, this.minInstances);\n        decision.action = 'scale_down';\n        decision.reason = `Low utilization: CPU ${avgCPU}%, Memory ${avgMemory}%`;\n        decision.newInstances = newCount;\n\n        // Find least utilized instance to remove\n        const instanceToRemove = this.instances.reduce((a, b) =>\n          (a.cpu + a.memory) < (b.cpu + b.memory) ? a : b\n        );\n\n        this.removeInstance(instanceToRemove.id);\n        this.scaleCounter = 0;\n        this.lastScaleAction = Date.now();\n\n        console.log(`📉 SCALE DOWN: ${currentInstanceCount} → ${newCount} instances`);\n      }\n    } else {\n      this.scaleCounter = 0;\n    }\n\n    this.decisions.push(decision);\n\n    // Keep last 1000 decisions\n    if (this.decisions.length > 1000) {\n      this.decisions.shift();\n    }\n\n    return decision;\n  }\n\n  getAverageCPU() {\n    if (this.instances.length === 0) return 0;\n    const sum = this.instances.reduce((a, b) => a + (b.cpu || 0), 0);\n    return Math.round(sum / this.instances.length);\n  }\n\n  getAverageMemory() {\n    if (this.instances.length === 0) return 0;\n    const sum = this.instances.reduce((a, b) => a + (b.memory || 0), 0);\n    return Math.round(sum / this.instances.length);\n  }\n\n  // Health check for failed instances\n  healthCheck() {\n    const now = Date.now();\n    const healthyInstances = [];\n    const unhealthyInstances = [];\n\n    this.instances.forEach(instance => {\n      const timeSinceCheck = now - instance.lastHealthCheck;\n\n      // Instance is unhealthy if not checked in 30 seconds\n      if (timeSinceCheck > 30000) {\n        unhealthyInstances.push(instance);\n      } else {\n        healthyInstances.push(instance);\n      }\n    });\n\n    // Replace unhealthy instances\n    unhealthyInstances.forEach(instance => {\n      console.log(`⚠️ Unhealthy instance detected: ${instance.id}`);\n      this.removeInstance(instance.id);\n      if (this.instances.length < this.minInstances) {\n        this.addInstance();\n        console.log(`✅ Replacement instance created`);\n      }\n    });\n\n    return {\n      total: this.instances.length,\n      healthy: healthyInstances.length,\n      unhealthy: unhealthyInstances.length\n    };\n  }\n\n  // Pod Disruption Budget (PDB) - graceful shutdown\n  gracefulShutdown(instanceId, gracePeriod = 30000) {\n    const instance = this.instances.find(i => i.id === instanceId);\n    if (!instance) return false;\n\n    instance.status = 'draining';\n\n    return new Promise((resolve) => {\n      setTimeout(() => {\n        this.removeInstance(instanceId);\n        resolve(true);\n      }, gracePeriod);\n    });\n  }\n\n  // Metrics export\n  getMetrics() {\n    return {\n      timestamp: Date.now(),\n      currentInstances: this.instances.length,\n      minInstances: this.minInstances,\n      maxInstances: this.maxInstances,\n      averageCPU: this.getAverageCPU(),\n      averageMemory: this.getAverageMemory(),\n      targetCPU: this.targetCPU,\n      targetMemory: this.targetMemory,\n      instances: this.instances.map(i => ({\n        id: i.id,\n        status: i.status,\n        cpu: i.cpu,\n        memory: i.memory,\n        requests: i.requests,\n        errors: i.errors,\n        uptime: Math.floor((Date.now() - i.createdAt) / 1000)\n      })),\n      recentDecisions: this.decisions.slice(-10)\n    };\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Horizontal Pod Autoscaler (HPA) Simulator\n// ──────────────────────────────────────────────────────────────────────────\n\nclass HorizontalPodAutoscaler {\n  constructor(deployment, metrics, options = {}) {\n    this.deployment = deployment;\n    this.metrics = metrics;\n    this.minReplicas = options.minReplicas || 1;\n    this.maxReplicas = options.maxReplicas || 10;\n    this.targetUtilization = options.targetUtilization || 70;\n    this.scaleUpCooldown = options.scaleUpCooldown || 60000;  // 60s\n    this.scaleDownCooldown = options.scaleDownCooldown || 300000;  // 5min\n    this.lastScaleUp = 0;\n    this.lastScaleDown = 0;\n  }\n\n  calculateReplicas() {\n    const currentReplicas = this.deployment.replicas;\n    const currentUtilization = this.deployment.metrics.cpu || 0;\n\n    let desiredReplicas = currentReplicas;\n\n    if (currentUtilization > this.targetUtilization) {\n      // Scale up\n      const now = Date.now();\n      if (now - this.lastScaleUp > this.scaleUpCooldown) {\n        desiredReplicas = Math.ceil(\n          (currentReplicas * currentUtilization) / this.targetUtilization\n        );\n        desiredReplicas = Math.min(desiredReplicas, this.maxReplicas);\n        this.lastScaleUp = now;\n      }\n    } else if (currentUtilization < this.targetUtilization * 0.5) {\n      // Scale down\n      const now = Date.now();\n      if (now - this.lastScaleDown > this.scaleDownCooldown) {\n        desiredReplicas = Math.max(\n          Math.floor((currentReplicas * currentUtilization) / this.targetUtilization),\n          this.minReplicas\n        );\n        this.lastScaleDown = now;\n      }\n    }\n\n    return Math.max(this.minReplicas, Math.min(desiredReplicas, this.maxReplicas));\n  }\n\n  status() {\n    return {\n      deployment: this.deployment.name,\n      currentReplicas: this.deployment.replicas,\n      desiredReplicas: this.calculateReplicas(),\n      minReplicas: this.minReplicas,\n      maxReplicas: this.maxReplicas,\n      currentUtilization: this.deployment.metrics.cpu,\n      targetUtilization: this.targetUtilization\n    };\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Resource Quota & Limits\n// ──────────────────────────────────────────────────────────────────────────\n\nclass ResourceQuota {\n  constructor(options = {}) {\n    this.limits = {\n      cpuTotal: options.cpuTotal || 4000,  // millicores\n      memoryTotal: options.memoryTotal || 8192,  // MB\n      requestsPerSecond: options.rps || 10000\n    };\n    this.used = {\n      cpu: 0,\n      memory: 0,\n      requests: 0\n    };\n  }\n\n  canAllocate(cpu, memory) {\n    return (this.used.cpu + cpu) <= this.limits.cpuTotal &&\n           (this.used.memory + memory) <= this.limits.memoryTotal;\n  }\n\n  allocate(cpu, memory) {\n    if (this.canAllocate(cpu, memory)) {\n      this.used.cpu += cpu;\n      this.used.memory += memory;\n      return true;\n    }\n    return false;\n  }\n\n  release(cpu, memory) {\n    this.used.cpu = Math.max(0, this.used.cpu - cpu);\n    this.used.memory = Math.max(0, this.used.memory - memory);\n  }\n\n  getUtilization() {\n    return {\n      cpu: ((this.used.cpu / this.limits.cpuTotal) * 100).toFixed(2) + '%',\n      memory: ((this.used.memory / this.limits.memoryTotal) * 100).toFixed(2) + '%'\n    };\n  }\n}\n\nfunction generateId() {\n  return crypto.randomBytes(6).toString('hex');\n}\n\n// Export\nmodule.exports = {\n  AutoScaler,\n  HorizontalPodAutoscaler,\n  ResourceQuota,\n  createAutoScaler: (options) => new AutoScaler(options),\n  createHPA: (deployment, metrics, options) => new HorizontalPodAutoscaler(deployment, metrics, options),\n  createResourceQuota: (options) => new ResourceQuota(options)\n};\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"6c3e1682-2ee0-4656-84ae-950048f0f987","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
