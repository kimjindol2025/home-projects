peScript/npm 불필요            ║\")\n  println(\"║                                                           ║\")\n  println(\"╚═══════════════════════════════════════════════════════════╝\")\n  println(\"\")\n\n  // 데이터베이스 초기화\n  loadFromDatabase()\n\n  printSystemInfo()\n\n  // HTTP Engine 시작\n  println(\"🔌 HTTP Engine 시작 중...\")\n  match http_server_main(\"0.0.0.0\", 5020, handleEngineRequest)\n    Ok(_) => {\n      println(\"✅ 서버 정상 종료\")\n    }\n    Err(e) => {\n      println(\"❌ 서버 에러: \\(e)\")\n    }\n  end\n}","originalFile":"// ============================================================================\n// FreeLang Main: 단독 실행 웹 서버\n// Node.js, TypeScript, npm 없이 완벽한 독립 실행 애플리케이션\n// ============================================================================\n\nuse \"server/http-server\"\nuse \"core/state\"\n\n// ──────────────────────────────────────────────────────────────────────────\n// 프로그램 진입점\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc main() {\n  println(\"\")\n  println(\"╔═══════════════════════════════════════════════════════════╗\")\n  println(\"║                                                           ║\")\n  println(\"║   🚀 FreeLang Standalone Web Server                      ║\")\n  println(\"║   자립형 언어 - Node.js/TypeScript/npm 불필요            ║\")\n  println(\"║                                                           ║\")\n  println(\"╚═══════════════════════════════════════════════════════════╝\")\n  println(\"\")\n\n  // 데이터베이스 초기화\n  loadFromDatabase()\n\n  // 서버 시작\n  startServer()\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 시스템 정보 출력\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc printSystemInfo() {\n  println(\"📊 시스템 정보:\")\n  println(\"  • 언어: FreeLang\")\n  println(\"  • 버전: 2.8.0\")\n  println(\"  • 모드: Standalone (자립형)\")\n  println(\"  • 배포: 단일 바이너리\")\n  println(\"\")\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 초기화\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc initializeState() {\n  println(\"⚙️  상태 초기화...\")\n\n  // Counter 기본값\n  let counter = getCounter()\n  println(\"  ✓ Counter: \\(counter.count)\")\n\n  // Todo 리스트 기본값\n  let todos = getTodos()\n  println(\"  ✓ Todos: \\(todos.length)개\")\n\n  // 시스템 헬스 체크\n  let health = getSystemHealth()\n  println(\"  ✓ Health: \\(health.status)\")\n\n  println(\"\")\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 종료 처리\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc onShutdown() {\n  println(\"\")\n  println(\"╔═══════════════════════════════════════════════════════════╗\")\n  println(\"║ 서버 종료 중...                                           ║\")\n  println(\"╚═══════════════════════════════════════════════════════════╝\")\n  println(\"\")\n\n  // 상태 저장 로직 추가 가능\n  clearHistory()\n\n  println(\"✓ 안전하게 종료되었습니다\")\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 메인 실행\n// ──────────────────────────────────────────────────────────────────────────\n\nmain()\n","structuredPatch":[{"oldStart":3,"oldLines":7,"newStart":3,"newLines":8,"lines":[" // Node.js, TypeScript, npm 없이 완벽한 독립 실행 애플리케이션"," // ============================================================================"," ","-use \"server/http-server\"","+use \"engine/server\"","+use \"server/http-engine\""," use \"core/state\""," "," // ──────────────────────────────────────────────────────────────────────────"]},{"oldStart":15,"oldLines":6,"newStart":16,"newLines":7,"lines":["   println(\"╔═══════════════════════════════════════════════════════════╗\")","   println(\"║                                                           ║\")","   println(\"║   🚀 FreeLang Standalone Web Server                      ║\")","+  println(\"║   (HTTP Engine: TCP + HTTP/1.1 Parser)                   ║\")","   println(\"║   자립형 언어 - Node.js/TypeScript/npm 불필요            ║\")","   println(\"║                                                           ║\")","   println(\"╚═══════════════════════════════════════════════════════════╝\")"]},{"oldStart":23,"oldLines":8,"newStart":25,"newLines":18,"lines":["   // 데이터베이스 초기화","   loadFromDatabase()"," ","-  // 서버 시작","-  startServer()","+  printSystemInfo()","+","+  // HTTP Engine 시작","+  println(\"🔌 HTTP Engine 시작 중...\")","+  match http_server_main(\"0.0.0.0\", 5020, handleEngineRequest)","+    Ok(_) => {","+      println(\"✅ 서버 정상 종료\")","+    }","+    Err(e) => {","+      println(\"❌ 서버 에러: \\(e)\")","+    }","+  end"," }"," "," // ──────────────────────────────────────────────────────────────────────────"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"8acfe895-7c47-4c4e-9b4a-d0aee1f2db3f","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
