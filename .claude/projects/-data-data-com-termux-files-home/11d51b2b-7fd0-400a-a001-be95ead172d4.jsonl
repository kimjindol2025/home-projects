{"parentUuid":"8902e95d-1811-4312-bdee-bec9e03d7914","isSidechain":false,"message":{"model":"claude-haiku-4-5-20251001","id":"msg_01KpbkkXnHgyQRVEjZkd3ayw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RCE3YXXMqTiHzxesHaWVRa","name":"Write","input":{"file_path":"/data/data/com.termux/files/home/freelang-hybrid/freelang/core/security-utils.free","content":"// ============================================================================\n// FreeLang 보안 유틸리티 모듈\n// 파일 경로 검증, URL 파라미터 검증, API 인증\n// ============================================================================\n\n// ──────────────────────────────────────────────────────────────────────────\n// 1. 파일 경로 Traversal 방지\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc validateFilePath(path: string, basePath: string) -> bool {\n  // 경로 정규화: ../../../ 같은 패턴 제거\n  let cleanPath = path\n\n  // 절대 경로 차단\n  if cleanPath.startsWith(\"/\") {\n    return false\n  }\n\n  // 상위 디렉토리 접근 차단\n  if cleanPath.contains(\"..\") {\n    return false\n  }\n\n  // null byte 차단 (C 스타일 문자열 공격)\n  if cleanPath.contains(\"\\0\") {\n    return false\n  }\n\n  // 허용된 파일만\n  if !isAllowedFile(cleanPath) {\n    return false\n  }\n\n  return true\n}\n\nfunc normalizePath(path: string) -> string {\n  let result = path\n\n  // 앞의 슬래시 제거\n  if result.startsWith(\"/\") {\n    result = result.substring(1)\n  }\n\n  // 뒤의 슬래시 제거\n  if result.endsWith(\"/\") {\n    result = result.substring(0, result.length() - 1)\n  }\n\n  // 연속된 슬래시 단일화\n  // \"/\" 반복 제거 (간단한 구현)\n  let normalized = \"\"\n  let i = 0\n  while i < result.length() {\n    let char = result[i]\n    if char == \"/\" {\n      // 이전 문자도 \"/\"인지 확인\n      if i > 0 {\n        let prevChar = result[i - 1]\n        if prevChar == \"/\" {\n          // 건너뛰기\n          i = i + 1\n          continue\n        }\n      }\n    }\n    normalized = normalized + char\n    i = i + 1\n  }\n\n  return normalized\n}\n\nfunc isAllowedFile(path: string) -> bool {\n  // 화이트리스트 기반 파일 접근 제어\n  let whitelist: [string] = [\n    \"blog.html\",\n    \"public/css/styles.css\",\n    \"public/css/styles-dark.css\",\n    \"frontend/tailwind-runtime.js\",\n    \"index.html\",\n    \"api/posts.json\"\n  ]\n\n  for allowed in whitelist {\n    if path == allowed {\n      return true\n    }\n  }\n\n  // public/ 디렉토리는 일부 허용\n  if path.startsWith(\"public/\") {\n    return true\n  }\n\n  // frontend/ 디렉토리는 일부 허용\n  if path.startsWith(\"frontend/\") {\n    return true\n  }\n\n  return false\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 2. URL 파라미터 검증\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc validateURLParameter(param: string, paramType: string) -> bool {\n  // 파라미터 타입별 검증\n\n  if paramType == \"id\" {\n    return isValidId(param)\n  }\n\n  if paramType == \"string\" {\n    return isValidString(param)\n  }\n\n  if paramType == \"boolean\" {\n    return isValidBoolean(param)\n  }\n\n  if paramType == \"email\" {\n    return isValidEmail(param)\n  }\n\n  return false\n}\n\nfunc isValidId(id: string) -> bool {\n  // ID는 숫자만 허용\n  if id.isEmpty() {\n    return false\n  }\n\n  // 길이 제한 (최대 10자)\n  if id.length() > 10 {\n    return false\n  }\n\n  // 모든 문자가 숫자인지 확인\n  for i in 0..id.length() {\n    let char = id[i]\n    if !isDigit(char) {\n      return false\n    }\n  }\n\n  return true\n}\n\nfunc isValidString(str: string) -> bool {\n  // 문자열은 최대 256자\n  if str.isEmpty() || str.length() > 256 {\n    return false\n  }\n\n  // 특수문자 제한 (XSS 방지)\n  if str.contains(\"<\") || str.contains(\">\") || str.contains(\"\\\"\") {\n    return false\n  }\n\n  // SQL injection 패턴 제거\n  if str.contains(\"'\") || str.contains(\"--\") || str.contains(\";\") {\n    return false\n  }\n\n  return true\n}\n\nfunc isValidBoolean(value: string) -> bool {\n  // \"true\" 또는 \"false\" 또는 \"1\" 또는 \"0\" 만 허용\n  if value == \"true\" || value == \"false\" || value == \"1\" || value == \"0\" {\n    return true\n  }\n  return false\n}\n\nfunc isValidEmail(email: string) -> bool {\n  // 기본 이메일 검증 (간단한 버전)\n  if email.isEmpty() || email.length() > 254 {\n    return false\n  }\n\n  // @ 포함 확인\n  let atCount = 0\n  for i in 0..email.length() {\n    if email[i] == \"@\" {\n      atCount = atCount + 1\n    }\n  }\n\n  if atCount != 1 {\n    return false\n  }\n\n  // @ 위치 확인 (시작/끝 제외)\n  let atIndex = email.indexOf(\"@\")\n  if atIndex <= 0 || atIndex >= email.length() - 1 {\n    return false\n  }\n\n  // 도메인에 . 포함 확인\n  let afterAt = email.substring(atIndex + 1)\n  if !afterAt.contains(\".\") {\n    return false\n  }\n\n  return true\n}\n\nfunc isDigit(char: string) -> bool {\n  if char == \"0\" || char == \"1\" || char == \"2\" || char == \"3\" || char == \"4\" {\n    return true\n  }\n  if char == \"5\" || char == \"6\" || char == \"7\" || char == \"8\" || char == \"9\" {\n    return true\n  }\n  return false\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 3. API 인증 (토큰 기반)\n// ──────────────────────────────────────────────────────────────────────────\n\ntype APIToken = {\n  value: string,\n  expires: i32,\n  scope: string\n}\n\nfunc generateToken(userId: string) -> string {\n  // 간단한 토큰 생성 (실제로는 JWT 사용)\n  // 형식: \"token_\" + userId + \"_\" + timestamp\n\n  let token = \"token_\" + userId + \"_\" + i32ToString(getCurrentTimestamp())\n  return token\n}\n\nfunc validateToken(token: string, requiredScope: string) -> bool {\n  // 토큰 형식 확인\n  if !token.startsWith(\"token_\") {\n    return false\n  }\n\n  // 토큰 길이 제한\n  if token.length() > 100 {\n    return false\n  }\n\n  // 실제로는 데이터베이스에서 토큰 확인\n  // 현재는 형식만 검증\n\n  return true\n}\n\nfunc extractTokenFromHeader(header: string) -> string {\n  // \"Bearer <token>\" 형식에서 토큰 추출\n\n  if !header.startsWith(\"Bearer \") {\n    return \"\"\n  }\n\n  let token = header.substring(7)\n  return token\n}\n\nfunc requireAuth(headers: map[string]string, requiredScope: string) -> (bool, string) {\n  // Authorization 헤더 확인\n  let authHeader = headers[\"Authorization\"]\n\n  if authHeader.isEmpty() {\n    return (false, \"Missing Authorization header\")\n  }\n\n  // 토큰 추출 및 검증\n  let token = extractTokenFromHeader(authHeader)\n\n  if token.isEmpty() {\n    return (false, \"Invalid Authorization format\")\n  }\n\n  if !validateToken(token, requiredScope) {\n    return (false, \"Invalid or expired token\")\n  }\n\n  return (true, \"OK\")\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 4. Rate Limiting (기본)\n// ──────────────────────────────────────────────────────────────────────────\n\ntype RateLimitConfig = {\n  maxRequests: i32,\n  timeWindowSeconds: i32\n}\n\ntype RateLimitEntry = {\n  ip: string,\n  requestCount: i32,\n  firstRequestTime: i32\n}\n\ntype RateLimiter = {\n  config: RateLimitConfig,\n  entries: [RateLimitEntry]\n}\n\nfunc createRateLimiter(maxRequests: i32, timeWindowSeconds: i32) -> RateLimiter {\n  return {\n    config: {\n      maxRequests: maxRequests,\n      timeWindowSeconds: timeWindowSeconds\n    },\n    entries: []\n  }\n}\n\nfunc checkRateLimit(limiter: RateLimiter, ip: string) -> bool {\n  let now = getCurrentTimestamp()\n  let timeWindow = limiter.config.timeWindowSeconds\n\n  // 해당 IP의 항목 찾기\n  for i in 0..limiter.entries.length() {\n    let entry = limiter.entries[i]\n\n    if entry.ip == ip {\n      // 시간 윈도우 초과 확인\n      let elapsedTime = now - entry.firstRequestTime\n\n      if elapsedTime > timeWindow {\n        // 시간 윈도우 만료 - 리셋\n        limiter.entries[i].requestCount = 1\n        limiter.entries[i].firstRequestTime = now\n        return true\n      }\n\n      // 요청 수 확인\n      if entry.requestCount >= limiter.config.maxRequests {\n        return false\n      }\n\n      // 요청 수 증가\n      limiter.entries[i].requestCount = entry.requestCount + 1\n      return true\n    }\n  }\n\n  // 새로운 IP 항목 추가\n  limiter.entries.push({\n    ip: ip,\n    requestCount: 1,\n    firstRequestTime: now\n  })\n\n  return true\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 5. 보안 헤더 추가\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc getSecurityHeaders() -> map[string]string {\n  let headers: map[string]string = {}\n\n  // XSS 방지\n  headers[\"X-Content-Type-Options\"] = \"nosniff\"\n  headers[\"X-Frame-Options\"] = \"DENY\"\n  headers[\"X-XSS-Protection\"] = \"1; mode=block\"\n\n  // CSRF 방지\n  headers[\"X-CSRF-Token\"] = generateCSRFToken()\n\n  // Content Security Policy\n  headers[\"Content-Security-Policy\"] = \"default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'\"\n\n  // 기타 보안 헤더\n  headers[\"Strict-Transport-Security\"] = \"max-age=31536000; includeSubDomains\"\n  headers[\"Referrer-Policy\"] = \"strict-origin-when-cross-origin\"\n  headers[\"Permissions-Policy\"] = \"geolocation=(), microphone=(), camera=()\"\n\n  return headers\n}\n\nfunc generateCSRFToken() -> string {\n  // CSRF 토큰 생성 (간단한 버전)\n  let token = \"csrf_\" + i32ToString(getCurrentTimestamp())\n  return token\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 6. HTTPS/TLS 설정 (std/net 지원 필요)\n// ──────────────────────────────────────────────────────────────────────────\n\ntype TLSConfig = {\n  enabled: bool,\n  certFile: string,\n  keyFile: string,\n  minVersion: string,\n  ciphers: [string]\n}\n\nfunc createTLSConfig(certFile: string, keyFile: string) -> TLSConfig {\n  return {\n    enabled: true,\n    certFile: certFile,\n    keyFile: keyFile,\n    minVersion: \"1.2\",\n    ciphers: [\n      \"TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384\",\n      \"TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305\",\n      \"TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384\"\n    ]\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 7. 유틸리티 함수\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc getCurrentTimestamp() -> i32 {\n  // 현재 타임스탐프 반환 (초 단위)\n  // 실제 구현: std/time.now()\n  return 0\n}\n\nfunc i32ToString(n: i32) -> string {\n  if n == 0 {\n    return \"0\"\n  }\n\n  let negative = n < 0\n  let abs = if negative { -n } else { n }\n\n  let result = \"\"\n  let temp = abs\n  while temp > 0 {\n    let digit = temp % 10\n    let char = if digit == 0 { \"0\" }\n             else if digit == 1 { \"1\" }\n             else if digit == 2 { \"2\" }\n             else if digit == 3 { \"3\" }\n             else if digit == 4 { \"4\" }\n             else if digit == 5 { \"5\" }\n             else if digit == 6 { \"6\" }\n             else if digit == 7 { \"7\" }\n             else if digit == 8 { \"8\" }\n             else { \"9\" }\n    result = char + result\n    temp = temp / 10\n  }\n\n  if negative {\n    return \"-\" + result\n  }\n  return result\n}\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1304,"cache_read_input_tokens":129390,"output_tokens":4111,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1304,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"}},"requestId":"req_011CYz7sriM1WkfEad3vSpKX","type":"assistant","uuid":"1087fdb4-5ffd-4fad-b299-106dd059696d","timestamp":"2026-03-13T00:18:36.471Z","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
