ease;\n    \" id=\"themeLight\">☀️ Light</button>\n\n    <button onclick=\"switchTheme('dark')\" style=\"\n        padding: 12px 16px;\n        background: #333;\n        border: 2px solid #333;\n        border-radius: 50px;\n        cursor: pointer;\n        font-weight: bold;\n        color: white;\n        transition: all 0.3s ease;\n    \" id=\"themeDark\">🌙 Dark</button>\n</div>\n\n<script>\nfunction switchTheme(theme) {\n    const stylesheet = document.querySelector('link[rel=\"stylesheet\"]');\n    if (theme === 'dark') {\n        stylesheet.href = '/styles-dark.css';\n        localStorage.setItem('theme', 'dark');\n        document.body.style.colorScheme = 'dark';\n    } else {\n        stylesheet.href = '/styles.css';\n        localStorage.setItem('theme', 'light');\n        document.body.style.colorScheme = 'light';\n    }\n}\n\n// 저장된 테마 로드\nwindow.addEventListener('DOMContentLoaded', () => {\n    const savedTheme = localStorage.getItem('theme') || 'light';\n    switchTheme(savedTheme);\n});\n</script>\n`\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Export\n// ──────────────────────────────────────────────────────────────────────────\n\nexport {\n  getSearchPage,\n  getAdminDashboard,\n  getProfilePage,\n  getThemeSwitcher\n}\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":10,"cache_creation_input_tokens":665,"cache_read_input_tokens":123897,"output_tokens":7909,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":665,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"}},"requestId":"req_011CYyLZMJXg4yUDT8ZHtSHN","type":"assistant","uuid":"7b139d24-573e-4c8c-aa27-da16687f35e8","timestamp":"2026-03-12T14:24:39.483Z","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4"