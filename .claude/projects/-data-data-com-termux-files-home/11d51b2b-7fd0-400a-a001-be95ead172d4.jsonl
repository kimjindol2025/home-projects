: port,\n    socket: 0,\n    running: false,\n    requestCount: 0\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 서버 시작/중지\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc startServer(server: HTTPServer) -> bool {\n  // 서버 상태 초기화\n  server.running = true\n  server.requestCount = 0\n\n  println(\"🚀 서버 초기화 중...\")\n  println(\"  호스트: \" + server.host)\n  println(\"  포트: \" + i32ToString(server.port))\n\n  // 실제 소켓 생성 및 바인드는 runServerLoop()에서 수행\n  return true\n}\n\nfunc stopServer(server: HTTPServer) -> void {\n  server.running = false\n  // net.close(server.socket)\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 요청 처리\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc parseHTTPRequest(rawRequest: string) -> (string, string, map[string]string, string) {\n  // CRLF(\\r\\n) 및 LF(\\n) 모두 처리\n  let lines = rawRequest.split(\"\\r\\n\")\n  if lines.length() < 1 {\n    lines = rawRequest.split(\"\\n\")\n  }\n","numLines":100,"startLine":1,"totalLines":416}},"sourceToolAssistantUUID":"f2578d2d-a68e-4db0-bf05-668f6e492bb2","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
