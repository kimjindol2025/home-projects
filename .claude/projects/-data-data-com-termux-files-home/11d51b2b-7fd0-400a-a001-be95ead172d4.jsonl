nt-size: 14px; }\n        .filter-tag:hover { background: #667eea; color: white; }\n        .results { display: grid; gap: 20px; }\n        .result-item { padding: 20px; background: white; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }\n        .result-title { font-size: 18px; font-weight: bold; color: #667eea; margin-bottom: 8px; }\n        .result-meta { font-size: 12px; color: #999; margin-bottom: 8px; }\n        .result-snippet { color: #555; line-height: 1.6; margin-bottom: 10px; }\n        .result-tags { display: flex; gap: 8px; }\n        .tag { padding: 4px 8px; background: #f0f4ff; border-radius: 4px; font-size: 12px; color: #667eea; }\n        .pagination { display: flex; gap: 10px; justify-content: center; margin-top: 30px; }\n        .page-btn { padding: 8px 12px; border: 1px solid #e2e8f0; border-radius: 4px; cursor: pointer; }\n        .page-btn.active { background: #667eea; color: white; border-color: #667eea; }\n        .no-results { text-align: center; padding: 40px; color: #999; }\n    </style>\n</head>\n<body>\n    <div class=\"search-container\">\n        <h1>🔍 블로그 검색</h1>\n\n        <div class=\"search-box\">\n            <input type=\"text\" id=\"searchInput\" placeholder=\"제목, 내용, 태그로 검색...\">\n            <button onclick=\"search()\">검색</button>\n        </div>\n\n        <div class=\"filters\">\n            <div class=\"filter-tag\" onclick=\"filterByCategory('기술')\">기술</div>\n            <div class=\"filter-tag\" onclick=\"filterByCategory('튜토리얼')\">튜토리얼</div>\n            <div class=\"filter-tag\" onclick=\"filterByCategory('뉴스')\">뉴스</div>\n            <div class=\"filter-tag\" onclick=\"clearFilters()\">전체</div>\n        </div>\n\n        <div id=\"results\" class=\"results\">\n            <p class=\"no-results\">검색어를 입력하면 결과가 표시됩니다.</p>\n        </div>\n\n        <div class=\"pagination\" id=\"pagination\"></div>\n    </div>\n\n    <script>\n        let allBlogs = [];\n        let filteredBlogs = [];\n        let currentPage = 1;\n        const itemsPerPage = 10;\n\n        async function loadBlogs() {\n            const response = await fetch('/api/blogs/all');\n            const data = await response.json();\n            allBlogs = data.data.blogs || [];\n        }\n\n        function search() {\n            const query = document.getElementById('searchInput').value.toLowerCase();\n            if (!query) {\n                document.getElementById('results').innerHTML = '<p class=\"no-results\">검색어를 입력하세요.</p>';\n                return;\n            }\n\n            filteredBlogs = allBlogs.filter(blog =>\n                blog.title.toLowerCase().includes(query) ||\n                blog.content.toLowerCase().includes(query) ||\n                blog.summary.toLowerCase().includes(query) ||\n                (blog.tags && blog.tags.some(tag => tag.toLowerCase().includes(query)))\n            );\n\n            currentPage = 1;\n            displayResults();\n        }\n\n        function filterByCategory(category) {\n            filteredBlogs = allBlogs.filter(blog => blog.category === category);\n            currentPage = 1;\n            displayResults();\n        }\n\n        function clearFilters() {\n            filteredBlogs = [];\n            document.getElementById('results').innerHTML = '<p class=\"no-results\">검색어를 입력하면 결과가 표시됩니다.</p>';\n            document.getElementById('pagination').innerHTML = '';\n        }\n\n        function displayResults() {\n            if (filteredBlogs.length === 0) {\n                document.getElementById('results').innerHTML = '<p class=\"no-results\">검색 결과가 없습니다.</p>';\n                return;\n            }\n\n            const start = (currentPage - 1) * itemsPerPage;\n            const end = start + itemsPerPage;\n            const pageItems = filteredBlogs.slice(start, end);\n\n            const html = pageItems.map(blog => \\`\n                <div class=\"result-item\">\n                    <div class=\"result-title\">\\${blog.title}</div>\n                    <div class=\"result-meta\">\\${blog.author} · \\${blog.category} · 조회수 \\${blog.viewCount}</div>\n                    <div class=\"result-snippet\">\\${blog.summary}</div>\n                    <div class=\"result-tags\">\n                        \\${(blog.tags || []).map(tag => \\`<span class=\"tag\">\\${tag}</span>\\`).join('')}\n                    </div>\n                </div>\n            \\`).join('');\n\n            document.getElementById('results').innerHTML = html;\n            displayPagination();\n        }\n\n        function displayPagination() {\n            const totalPages = Math.ceil(filteredBlogs.length / itemsPerPage);\n            const pagination = document.getElementById('pagination');\n            pagination.innerHTML = '';\n\n            for (let i = 1; i <= totalPages; i++) {\n                const btn = document.createElement('button');\n                btn.className = 'page-btn' + (i === currentPage ? ' active' : '');\n                btn.textContent = i;\n                btn.onclick = () => {\n                    currentPage = i;\n                    displayResults();\n                };\n                pagination.appendChild(btn);\n            }\n        }\n\n        loadBlogs();\n    </script>\n</body>\n</html>`\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 관리자 대시보드\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc getAdminDashboard() -> string {\n  return `<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>관리자 대시보드 - FreeLang</title>\n    <link rel=\"stylesheet\" href=\"/styles.css\">\n    <style>\n        .admin-header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px; }\n        .admin-title { font-size: 28px; font-weight: bold; margin: 0; }\n        .admin-subtitle { font-size: 14px; opacity: 0.9; margin-top: 8px; }\n        .admin-container { max-width: 1200px; margin: 0 auto; padding: 30px; }\n        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 30px; }\n        .stat-card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); border-left: 4px solid #667eea; }\n        .stat-label { font-size: 14px; color: #999; margin-bottom: 8px; }\n        .stat-value { font-size: 32px; font-weight: bold; color: #333; }\n        .stat-change { font-size: 12px; color: #48bb78; margin-top: 8px; }\n        .section { margin-bottom: 30px; }\n        .section-title { font-size: 20px; font-weight: bold; color: #333; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 2px solid #f0f4ff; }\n        .blog-table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }\n        .blog-table th { background: #f7fafc; padding: 15px; text-align: left; font-weight: bold; color: #333; border-bottom: 2px solid #e2e8f0; }\n        .blog-table td { padding: 15px; border-bottom: 1px solid #e2e8f0; }\n        .blog-table tbody tr:hover { background: #f7fafc; }\n        .status-badge { padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; }\n        .status-draft { background: #fed7d7; color: #c53030; }\n        .status-published { background: #c6f6d5; color: #22543d; }\n        .action-btn { padding: 6px 12px; margin-right: 5px; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; }\n        .btn-edit { background: #4299e1; color: white; }\n        .btn-delete { background: #f56565; color: white; }\n        .btn-publish { background: #48bb78; color: white; }\n        .activity-feed { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }\n        .activity-item { padding: 15px; border-left: 3px solid #667eea; margin-bottom: 15px; background: #f7fafc; border-radius: 4px; }\n        .activity-time { font-size: 12px; color: #999; }\n        .activity-text { color: #333; margin-top: 5px; }\n    </style>\n</head>\n<body>\n    <div class=\"admin-header\">\n        <h1 class=\"admin-title\">📊 관리자 대시보드</h1>\n        <p class=\"admin-subtitle\">블로그 및 시스템 관리</p>\n    </div>\n\n    <div class=\"admin-container\">\n        <!-- 통계 카드 -->\n        <div class=\"stats-grid\">\n            <div class=\"stat-card\">\n                <div class=\"stat-label\">전체 블로그</div>\n                <div class=\"stat-value\" id=\"totalBlogs\">0</div>\n                <div class=\"stat-change\">↑ 증가 추세</div>\n            </div>\n            <div class=\"stat-card\">\n                <div class=\"stat-label\">발행된 블로그</div>\n                <div class=\"stat-value\" id=\"publishedBlogs\">0</div>\n                <div class=\"stat-change\">↑ 10% 이상</div>\n            </div>\n            <div class=\"stat-card\">\n                <div class=\"stat-label\">초안 블로그</div>\n                <div class=\"stat-value\" id=\"draftBlogs\">0</div>\n                <div class=\"stat-change\">→ 변화 없음</div>\n            </div>\n            <div class=\"stat-card\">\n                <div class=\"stat-label\">총 조회수</div>\n                <div class=\"stat-value\" id=\"totalViews\">0</div>\n                <div class=\"stat-change\">↑ 꾸준한 증가</div>\n            </div>\n        </div>\n\n        <!-- 블로그 관리 -->\n        <div class=\"section\">\n            <h2 class=\"section-title\">📝 블로그 관리</h2>\n            <table class=\"blog-table\">\n                <thead>\n                    <tr>\n                        <th>제목</th>\n                        <th>상태</th>\n                        <th>작성자</th>\n                        <th>조회수</th>\n                        <th>작성일</th>\n                        <th>작업</th>\n                    </tr>\n                </thead>\n                <tbody id=\"blogList\"></tbody>\n            </table>\n        </div>\n\n        <!-- 최근 활동 -->\n        <div class=\"section\">\n            <h2 class=\"section-title\">🔔 최근 활동</h2>\n            <div class=\"activity-feed\">\n                <div class=\"activity-item\">\n                    <div class=\"activity-time\">오늘 10:30</div>\n                    <div class=\"activity-text\">새 블로그 \"FreeLang CSS 생성\" 발행</div>\n                </div>\n                <div class=\"activity-item\">\n                    <div class=\"activity-time\">어제 15:45</div>\n                    <div class=\"activity-text\">블로그 \"HTTP 서버 구현\" 수정됨</div>\n                </div>\n                <div class=\"activity-item\">\n                    <div class=\"activity-time\">3일 전 09:20</div>\n                    <div class=\"activity-text\">새 블로그 \"타입 시스템\" 초안 작성</div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        async function loadDashboard() {\n            const response = await fetch('/api/blogs/all');\n            const data = await response.json();\n            const blogs = data.data.blogs || [];\n\n            const published = blogs.filter(b => b.status === 'PUBLISHED').length;\n            const draft = blogs.filter(b => b.status === 'DRAFT').length;\n            const totalViews = blogs.reduce((sum, b) => sum + (b.viewCount || 0), 0);\n\n            document.getElementById('totalBlogs').textContent = blogs.length;\n            document.getElementById('publishedBlogs').textContent = published;\n            document.getElementById('draftBlogs').textContent = draft;\n            document.getElementById('totalViews').textContent = totalViews;\n\n            displayBlogTable(blogs);\n        }\n\n        function displayBlogTable(blogs) {\n            const tbody = document.getElementById('blogList');\n            tbody.innerHTML = blogs.map(blog => \\`\n                <tr>\n                    <td>\\${blog.title}</td>\n                    <td><span class=\"status-badge status-\\${blog.status.toLowerCase()}\">\\${blog.status}</span></td>\n                    <td>\\${blog.author}</td>\n                    <td>\\${blog.viewCount || 0}</td>\n                    <td>\\${new Date(blog.createdAt).toLocaleDateString('ko-KR')}</td>\n                    <td>\n                        <button class=\"action-btn btn-edit\">수정</button>\n                        <button class=\"action-btn btn-delete\">삭제</button>\n                        \\${blog.status === 'DRAFT' ? '<button class=\"action-btn btn-publish\">발행</button>' : ''}\n                    </td>\n                </tr>\n            \\`).join('');\n        }\n\n        loadDashboard();\n    </script>\n</body>\n</html>`\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 프로필 페이지\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc getProfilePage() -> string {\n  return `<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>프로필 - FreeLang</title>\n    <link rel=\"stylesheet\" href=\"/styles.css\">\n    <style>\n        .profile-header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 40px 20px; text-align: center; }\n        .profile-avatar { width: 120px; height: 120px; border-radius: 50%; background: rgba(255,255,255,0.2); margin: 0 auto 20px; display: flex; align-items: center; justify-content: center; font-size: 60px; }\n        .profile-name { font-size: 28px; font-weight: bold; margin: 0; }\n        .profile-role { font-size: 16px; opacity: 0.9; margin-top: 5px; }\n        .profile-container { max-width: 900px; margin: 0 auto; padding: 30px; }\n        .profile-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 30px; }\n        .profile-section { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }\n        .section-title { font-size: 18px; font-weight: bold; color: #333; margin-bottom: 15px; padding-bottom: 10px; border-bottom: 2px solid #f0f4ff; }\n        .info-item { margin-bottom: 15px; }\n        .info-label { font-size: 12px; color: #999; text-transform: uppercase; }\n        .info-value { font-size: 16px; font-weight: 500; color: #333; margin-top: 5px; }\n        .stats-row { display: flex; justify-content: space-around; margin-bottom: 20px; }\n        .stat { text-align: center; }\n        .stat-number { font-size: 28px; font-weight: bold; color: #667eea; }\n        .stat-name { font-size: 12px; color: #999; margin-top: 5px; }\n        .bio { color: #555; line-height: 1.6; }\n        .skills { display: flex; gap: 10px; flex-wrap: wrap; }\n        .skill-tag { padding: 8px 12px; background: #f0f4ff; border: 1px solid #667eea; border-radius: 20px; color: #667eea; font-size: 14px; }\n        .full-width { grid-column: 1 / -1; }\n        .edit-btn { background: #667eea; color: white; padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; }\n        .edit-btn:hover { background: #5568d3; }\n    </style>\n</head>\n<body>\n    <div class=\"profile-header\">\n        <div class=\"profile-avatar\">👨‍💻</div>\n        <h1 class=\"profile-name\">개발자</h1>\n        <p class=\"profile-role\">FreeLang 커뮤니티 관리자</p>\n    </div>\n\n    <div class=\"profile-container\">\n        <div class=\"profile-grid\">\n            <!-- 통계 -->\n            <div class=\"profile-section\">\n                <div class=\"section-title\">📈 활동 통계</div>\n                <div class=\"stats-row\">\n                    <div class=\"stat\">\n                        <div class=\"stat-number\" id=\"userBlogs\">12</div>\n                        <div class=\"stat-name\">작성한 블로그</div>\n                    </div>\n                    <div class=\"stat\">\n                        <div class=\"stat-number\">2.3K</div>\n                        <div class=\"stat-name\">총 조회수</div>\n                    </div>\n                    <div class=\"stat\">\n                        <div class=\"stat-number\">158</div>\n                        <div class=\"stat-name\">총 좋아요</div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- 정보 -->\n            <div class=\"profile-section\">\n                <div class=\"section-title\">ℹ️ 프로필 정보</div>\n                <div class=\"info-item\">\n                    <div class=\"info-label\">이메일</div>\n                    <div class=\"info-value\">dev@freelang.io</div>\n                </div>\n                <div class=\"info-item\">\n                    <div class=\"info-label\">가입일</div>\n                    <div class=\"info-value\">2026년 1월 15일</div>\n                </div>\n                <div class=\"info-item\">\n                    <div class=\"info-label\">위치</div>\n                    <div class=\"info-value\">서울, 대한민국</div>\n                </div>\n            </div>\n\n            <!-- 소개 -->\n            <div class=\"profile-section full-width\">\n                <div class=\"section-title\">📝 소개</div>\n                <p class=\"bio\">\n                    FreeLang 커뮤니티의 활발한 멤버입니다.\n                    시스템 프로그래밍, 웹 개발, 그리고 오픈소스 프로젝트에 관심이 있습니다.\n                    최신 기술 트렌드를 따라가며 함께 성장하고 싶습니다.\n                </p>\n            </div>\n\n            <!-- 기술 스택 -->\n            <div class=\"profile-section full-width\">\n                <div class=\"section-title\">🛠️ 기술 스택</div>\n                <div class=\"skills\">\n                    <span class=\"skill-tag\">FreeLang</span>\n                    <span class=\"skill-tag\">HTTP Server</span>\n                    <span class=\"skill-tag\">Web Development</span>\n                    <span class=\"skill-tag\">TypeScript</span>\n                    <span class=\"skill-tag\">React</span>\n                    <span class=\"skill-tag\">Node.js</span>\n                    <span class=\"skill-tag\">CSS</span>\n                    <span class=\"skill-tag\">System Programming</span>\n                </div>\n            </div>\n\n            <!-- 최근 블로그 -->\n            <div class=\"profile-section full-width\">\n                <div class=\"section-title\">📚 최근 작성한 블로그</div>\n                <div id=\"recentBlogs\" style=\"display: grid; gap: 15px;\"></div>\n            </div>\n        </div>\n\n        <div style=\"text-align: center; margin-top: 30px;\">\n            <button class=\"edit-btn\">프로필 수정</button>\n        </div>\n    </div>\n\n    <script>\n        async function loadProfile() {\n            const response = await fetch('/api/blogs/all');\n            const data = await response.json();\n            const blogs = data.data.blogs || [];\n\n            const recentBlogsHtml = blogs.slice(0, 3).map(blog => \\`\n                <div style=\"padding: 15px; background: #f7fafc; border-left: 4px solid #667eea; border-radius: 4px;\">\n                    <div style=\"font-weight: bold; color: #333;\">\\${blog.title}</div>\n                    <div style=\"font-size: 12px; color: #999; margin-top: 5px;\">\n                        \\${new Date(blog.createdAt).toLocaleDateString('ko-KR')} · 조회수 \\${blog.viewCount}\n                    </div>\n                </div>\n            \\`).join('');\n\n            document.getElementById('recentBlogs').innerHTML = recentBlogsHtml;\n            document.getElementById('userBlogs').textContent = blogs.length;\n        }\n\n        loadProfile();\n    </script>\n</body>\n</html>`\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 테마 선택기 (동적 테마 변경)\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc getThemeSwitcher() -> string {\n  return `\n<div style=\"position: fixed; bottom: 30px; right: 30px; display: flex; gap: 10px; z-index: 1000;\">\n    <button onclick=\"switchTheme('light')\" style=\"\n        padding: 12px 16px;\n        background: white;\n        border: 2px solid #667eea;\n        border-radius: 50px;\n        cursor: pointer;\n        font-weight: bold;\n        color: #667eea;\n        transition: all 0.3s ease;\n    \" id=\"themeLight\">☀️ Light</button>\n\n    <button onclick=\"switchTheme('dark')\" style=\"\n        padding: 12px 16px;\n        background: #333;\n        border: 2px solid #333;\n        border-radius: 50px;\n        cursor: pointer;\n        font-weight: bold;\n        color: white;\n        transition: all 0.3s ease;\n    \" id=\"themeDark\">🌙 Dark</button>\n</div>\n\n<script>\nfunction switchTheme(theme) {\n    const stylesheet = document.querySelector('link[rel=\"stylesheet\"]');\n    if (theme === 'dark') {\n        stylesheet.href = '/styles-dark.css';\n        localStorage.setItem('theme', 'dark');\n        document.body.style.colorScheme = 'dark';\n    } else {\n        stylesheet.href = '/styles.css';\n        localStorage.setItem('theme', 'light');\n        document.body.style.colorScheme = 'light';\n    }\n}\n\n// 저장된 테마 로드\nwindow.addEventListener('DOMContentLoaded', () => {\n    const savedTheme = localStorage.getItem('theme') || 'light';\n    switchTheme(savedTheme);\n});\n</script>\n`\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Export\n// ──────────────────────────────────────────────────────────────────────────\n\nexport {\n  getSearchPage,\n  getAdminDashboard,\n  getProfilePage,\n  getThemeSwitcher\n}\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"7b139d24-573e-4c8c-aa27-da16687f35e8","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
