    \"Access-Control-Allow-Origin\": \"*\"\n      }, `{\n  \"status\": \"error\",\n  \"statusCode\": 404,\n  \"message\": \"Not Found\"\n}`)\n    }\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// JSON 응답 헬퍼\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc jsonResponse(status: string, data: any) -> string {\n  return `{\n  \"status\": \"\\(status)\",\n  \"data\": {}\n}`\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 내보내기\n// ──────────────────────────────────────────────────────────────────────────\n\nexport {\n  EngineRequest,\n  EngineResponse,\n  parseHttpRequest,\n  buildEngineResponse,\n  serializeEngineResponse,\n  handleEngineRequest\n}\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"f6ce75ea-9301-4558-a124-5d128fbb16ec","userType":"external","cwd":"/data/data/com.termux/files/home","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
