\n    46→      }));\n    47→      return res.end(JSON.stringify({ results: allPackages, total: allPackages.length }));\n    48→    }\n    49→\n    50→    const results = searchIndex\n    51→      .filter(idx => idx.searchable_text.includes(q) || idx.name.includes(q))\n    52→      .map(idx => {\n    53→        const pkg = packages.packages.find(p => p.id === idx.id);\n    54→        return {\n    55→          id: pkg.id,\n    56→          name: pkg.name,\n    57→          version: pkg.version,\n    58→          description: pkg.description,\n    59→          category: pkg.category,\n    60→          ranking: idx.ranking,\n    61→          features: pkg.features\n    62→        };\n    63→      })\n    64→      .sort((a, b) => b.ranking - a.ranking);\n    65→\n    66→    return res.end(JSON.stringify({\n    67→      query: q,\n    68→      results,\n    69→      total: results.length\n    70→    }));\n    71→  }\n    72→\n    73→  // Get package details\n    74→  if (pathname.startsWith(\"/api/package/\")) {\n    75→    const pkgId = pathname.replace(\"/api/package/\", \"\");\n    76→    const pkg = packages.packages.find(p => p.id === pkgId);\n    77→\n    78→    if (!pkg) {\n    79→      res.writeHead(404);\n    80→      return res.end(JSON.stringify({ error: \"Package not found\" }));\n    81→    }\n    82→\n    83→    return res.end(JSON.stringify(pkg));\n    84→  }\n    85→\n    86→  // List all packages\n    87→  if (pathname === \"/api/packages\") {\n    88→    const list = packages.packages.map(p => ({\n    89→      id: p.id,\n    90→      name: p.name,\n    91→      version: p.version,\n    92→      description: p.description,\n    93→      category: p.category,\n    94→      level: p.level,\n    95→      completeness: p.completeness\n    96→    }));\n    97→    return res.end(JSON.stringify({ packages: list, total: list.length }));\n    98→  }\n    99→\n   100→  res.writeHead(404);\n   101→  res.end(JSON.stringify({ error: \"Not found\" }));\n   102→});\n  