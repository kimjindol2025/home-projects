리슨 시작 (backlog=128)\")\n  let listenResult = net.listen(server.socket, 128)\n\n  if listenResult != 0 {\n    println(\"❌ API 리슨 실패\")\n    net.close(server.socket)\n    return\n  }\n  println(\"✅ API 리슨 시작됨, 클라이언트 대기 중...\")\n  println(\"\")\n\n  // 5️⃣ 메인 수락 루프\n  while server.running {\n    // 클라이언트 연결 수락\n    let (clientFd, clientHost, clientPort) = net.accept(server.socket)\n\n    if clientFd < 0 {\n      continue\n    }\n\n    // 6️⃣ HTTP 요청 읽기\n    let (readOk, rawRequest) = net.read(clientFd, 4096)\n\n    if !readOk || rawRequest.isEmpty() {\n      net.close(clientFd)\n      continue\n    }\n\n    server.requestCount = server.requestCount + 1\n\n    // 7️⃣ 요청 파싱 (path와 query 추출)\n    let path = parseRequestPath(rawRequest)\n    let query = parseQueryString(rawRequest)\n\n    println(\"📨 요청 #\" + i32ToString(server.requestCount) + \": \" + path + \" (from \" + clientHost + \":\" + i32ToString(clientPort) + \")\")\n\n    // 8️⃣ API 처리\n    let response = handleAPIRequest(server, path, query)\n\n    // 9️⃣ HTTP 응답 생성\n    let httpResponse = buildAPIHTTPResponse(response.status, response.contentType, response.body)\n\n    // 🔟 응답 전송\n    let writeOk = net.write(clientFd, httpResponse)\n\n    if writeOk {\n      println(\"✅ API 응답 전송: \" + i32ToString(response.status))\n    } else {\n      println(\"❌ API 응답 전송 실패\")\n    }\n\n    // 1️⃣1️⃣ 연결 종료\n    net.close(clientFd)\n  }\n\n  // 서버 종료 시 소켓 정리\n  println(\"\")\n  println(\"🛑 API 서버 종료 중...\")\n  net.close(server.socket)\n  println(\"✅ API 소켓 닫음\")\n}","originalFile":"// ============================================================================\n// FreeLang API 서버 (메인 프로그램)\n// 정식 FreeLang 모듈 - 컴파일 가능, 독립 실행 가능\n// freec api-main.free && ./api-main\n// ============================================================================\n\nuse \"std/net\"\nuse \"std/json\"\nuse \"std/http\"\n\ntype Blog = {\n  id: i32,\n  title: string,\n  excerpt: string,\n  date: string,\n  author: string,\n  category: string,\n  views: i32\n}\n\ntype APIResponse = {\n  status: i32,\n  contentType: string,\n  body: string\n}\n\nfunc main() -> void {\n  println(\"\")\n  println(\"╔═══════════════════════════════════════════════════════╗\")\n  println(\"║  🔌 FreeLang API 서버 (정식 모듈)                   ║\")\n  println(\"╚═══════════════════════════════════════════════════════╝\")\n  println(\"\")\n\n  let port: i32 = 8001\n  let host: string = \"127.0.0.1\"\n\n  println(\"📍 포트: \" + i32ToString(port))\n  println(\"📍 호스트: \" + host)\n  println(\"\")\n\n  println(\"📋 API 엔드포인트:\")\n  println(\"  GET  /api/posts       - 블로그 목록\")\n  println(\"  GET  /api/posts/:id   - 블로그 상세\")\n  println(\"  GET  /api/theme       - 테마 설정\")\n  println(\"  GET  /api/health      - 상태 확인\")\n  println(\"\")\n\n  // API 서버 시작\n  let server = createAPIServer(host, port)\n  if startAPIServer(server) {\n    println(\"✅ API 서버 시작됨\")\n    println(\"🔗 http://localhost:\" + i32ToString(port) + \"/api/posts\")\n    println(\"\")\n    println(\"⌨️  Ctrl+C로 종료\")\n    println(\"\")\n\n    // 메인 루프\n    runAPILoop(server)\n  } else {\n    println(\"❌ API 서버 시작 실패\")\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// API 서버 구조\n// ──────────────────────────────────────────────────────────────────────────\n\ntype APIServer = {\n  host: string,\n  port: i32,\n  socket: i32,\n  running: bool,\n  requestCount: i32,\n  blogs: [Blog]\n}\n\nfunc createAPIServer(host: string, port: i32) -> APIServer {\n  let blogs = createSampleBlogs()\n\n  return {\n    host: host,\n    port: port,\n    socket: 0,\n    running: false,\n    requestCount: 0,\n    blogs: blogs\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 샘플 데이터\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc createSampleBlogs() -> [Blog] {\n  let blogs: [Blog] = []\n\n  blogs.push({\n    id: 1,\n    title: \"FreeLang 시작하기\",\n    excerpt: \"FreeLang으로 첫 프로젝트를 시작해보세요\",\n    date: \"2026-03-13\",\n    author: \"김프리\",\n    category: \"튜토리얼\",\n    views: 156\n  })\n\n  blogs.push({\n    id: 2,\n    title: \"CSS 모듈 시스템 소개\",\n    excerpt: \"타입 안전한 CSS를 FreeLang으로 작성하기\",\n    date: \"2026-03-12\",\n    author: \"김프리\",\n    category: \"기술\",\n    views: 243\n  })\n\n  blogs.push({\n    id: 3,\n    title: \"의존성 0으로 배포하기\",\n    excerpt: \"npm 없이 완전 독립적인 시스템 구축\",\n    date: \"2026-03-11\",\n    author: \"김프리\",\n    category: \"배포\",\n    views: 89\n  })\n\n  return blogs\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 서버 시작/중지\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc startAPIServer(server: APIServer) -> bool {\n  server.running = true\n  return true\n}\n\nfunc stopAPIServer(server: APIServer) -> void {\n  server.running = false\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// API 엔드포인트 핸들러\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc handleAPIRequest(server: APIServer, path: string, query: map[string]string) -> APIResponse {\n  // GET /api/posts - 블로그 목록\n  if path == \"/api/posts\" {\n    let json = blogsToJSON(server.blogs)\n    return {\n      status: 200,\n      contentType: \"application/json; charset=utf-8\",\n      body: json\n    }\n  }\n\n  // GET /api/posts/:id - 블로그 상세 (🔒 ID 검증 추가)\n  if path.startsWith(\"/api/posts/\") {\n    let idStr = path.substring(11)\n\n    // 🔒 보안: ID 검증\n    if !isValidBlogId(idStr) {\n      return {\n        status: 400,\n        contentType: \"application/json; charset=utf-8\",\n        body: \"{\\\"error\\\": \\\"Invalid blog ID\\\", \\\"message\\\": \\\"Blog ID must be numeric\\\"}\"\n      }\n    }\n\n    let id = stringToI32(idStr)\n\n    // 🔒 보안: ID 범위 확인 (1-1000)\n    if id < 1 || id > 1000 {\n      return {\n        status: 400,\n        contentType: \"application/json; charset=utf-8\",\n        body: \"{\\\"error\\\": \\\"Invalid blog ID\\\", \\\"message\\\": \\\"Blog ID out of range\\\"}\"\n      }\n    }\n\n    let blog = getBlogById(server.blogs, id)\n\n    let json = blogToJSON(blog)\n    return {\n      status: 200,\n      contentType: \"application/json; charset=utf-8\",\n      body: json\n    }\n  }\n\n  // GET /api/theme - 테마 설정\n  if path == \"/api/theme\" {\n    let isDark = query[\"dark\"] == \"true\"\n    let json = \"{\"\n    json = json + \"\\\"isDarkMode\\\": \" + boolToString(isDark) + \", \"\n    json = json + \"\\\"primaryColor\\\": \\\"#3b82f6\\\", \"\n    json = json + \"\\\"fontSize\\\": 14\"\n    json = json + \"}\"\n\n    return {\n      status: 200,\n      contentType: \"application/json; charset=utf-8\",\n      body: json\n    }\n  }\n\n  // GET /api/health - 상태 확인 (인증 불필요)\n  if path == \"/api/health\" {\n    let json = \"{\"\n    json = json + \"\\\"status\\\": \\\"ok\\\", \"\n    json = json + \"\\\"version\\\": \\\"1.0.0\\\", \"\n    json = json + \"\\\"uptime\\\": \\\"3600s\\\"\"\n    json = json + \"}\"\n\n    return {\n      status: 200,\n      contentType: \"application/json; charset=utf-8\",\n      body: json\n    }\n  }\n\n  // POST /api/posts - 새 블로그 생성 (🔒 인증 필요)\n  if path == \"/api/posts\" {\n    // 🔒 보안: 이 엔드포인트는 인증이 필요하다고 표시\n    // 실제 구현 시 헤더에서 Authorization 토큰 확인\n    return {\n      status: 401,\n      contentType: \"application/json; charset=utf-8\",\n      body: \"{\\\"error\\\": \\\"Unauthorized\\\", \\\"message\\\": \\\"Authorization header required\\\"}\"\n    }\n  }\n\n  // 404 Not Found\n  let error = \"{\\\"error\\\": \\\"Not Found\\\", \\\"path\\\": \\\"\" + path + \"\\\"}\"\n  return {\n    status: 404,\n    contentType: \"application/json; charset=utf-8\",\n    body: error\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// JSON 변환\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc blogToJSON(blog: Blog) -> string {\n  let json = \"{\"\n  json = json + \"\\\"id\\\": \" + i32ToString(blog.id) + \", \"\n  json = json + \"\\\"title\\\": \\\"\" + blog.title + \"\\\", \"\n  json = json + \"\\\"excerpt\\\": \\\"\" + blog.excerpt + \"\\\", \"\n  json = json + \"\\\"date\\\": \\\"\" + blog.date + \"\\\", \"\n  json = json + \"\\\"author\\\": \\\"\" + blog.author + \"\\\", \"\n  json = json + \"\\\"category\\\": \\\"\" + blog.category + \"\\\", \"\n  json = json + \"\\\"views\\\": \" + i32ToString(blog.views)\n  json = json + \"}\"\n  return json\n}\n\nfunc blogsToJSON(blogs: [Blog]) -> string {\n  let json = \"[\"\n  for i in 0..blogs.length() {\n    if i > 0 {\n      json = json + \", \"\n    }\n    json = json + blogToJSON(blogs[i])\n  }\n  json = json + \"]\"\n  return json\n}\n\nfunc getBlogById(blogs: [Blog], id: i32) -> Blog {\n  for blog in blogs {\n    if blog.id == id {\n      return blog\n    }\n  }\n  return blogs[0]\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 서버 메인 루프\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc runAPILoop(server: APIServer) -> void {\n  while server.running {\n    // clientSocket = net.accept(server.socket)\n    // rawRequest = net.read(clientSocket)\n\n    // 요청 파싱 (path와 query 추출)\n    // path = parseRequestPath(rawRequest)\n    // query = parseQueryString(rawRequest)\n\n    // API 처리\n    // response = handleAPIRequest(server, path, query)\n\n    // HTTP 응답 생성\n    // httpResponse = buildHTTPResponse(response.status, response.contentType, response.body)\n\n    // 응답 전송\n    // net.write(clientSocket, httpResponse)\n    // net.close(clientSocket)\n\n    server.requestCount = server.requestCount + 1\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 유틸리티\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc i32ToString(n: i32) -> string {\n  if n == 0 {\n    return \"0\"\n  }\n\n  let negative = n < 0\n  let abs = if negative { -n } else { n }\n\n  let result = \"\"\n  let temp = abs\n  while temp > 0 {\n    let digit = temp % 10\n    let char = if digit == 0 { \"0\" }\n             else if digit == 1 { \"1\" }\n             else if digit == 2 { \"2\" }\n             else if digit == 3 { \"3\" }\n             else if digit == 4 { \"4\" }\n             else if digit == 5 { \"5\" }\n             else if digit == 6 { \"6\" }\n             else if digit == 7 { \"7\" }\n             else if digit == 8 { \"8\" }\n             else { \"9\" }\n    result = char + result\n    temp = temp / 10\n  }\n\n  if negative {\n    return \"-\" + result\n  }\n  return result\n}\n\nfunc stringToI32(s: string) -> i32 {\n  if s.isEmpty() {\n    return 0\n  }\n\n  let result: i32 = 0\n  let negative = s.startsWith(\"-\")\n  let start = if negative { 1 } else { 0 }\n\n  for i in start..s.length() {\n    let char = s[i]\n    let digit = if char == \"0\" { 0 }\n              else if char == \"1\" { 1 }\n              else if char == \"2\" { 2 }\n              else if char == \"3\" { 3 }\n              else if char == \"4\" { 4 }\n              else if char == \"5\" { 5 }\n              else if char == \"6\" { 6 }\n              else if char == \"7\" { 7 }\n              else if char == \"8\" { 8 }\n              else if char == \"9\" { 9 }\n              else { 0 }\n    result = result * 10 + digit\n  }\n\n  if negative {\n    return -result\n  }\n  return result\n}\n\nfunc boolToString(b: bool) -> string {\n  if b {\n    return \"true\"\n  }\n  return \"false\"\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 🔒 보안 검증 함수\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc isValidBlogId(idStr: string) -> bool {\n  // ID는 숫자만 허용, 길이 1-10자\n  if idStr.isEmpty() || idStr.length() > 10 {\n    return false\n  }\n\n  // 모든 문자가 숫자인지 확인\n  for i in 0..idStr.length() {\n    let char = idStr[i]\n    if !isDigitChar(char) {\n      return false\n    }\n  }\n\n  return true\n}\n\nfunc isDigitChar(char: string) -> bool {\n  // 문자가 숫자인지 확인\n  if char == \"0\" || char == \"1\" || char == \"2\" || char == \"3\" || char == \"4\" {\n    return true\n  }\n  if char == \"5\" || char == \"6\" || char == \"7\" || char == \"8\" || char == \"9\" {\n    return true\n  }\n  return false\n}\n\nfunc isValidQueryParam(paramName: string, paramValue: string) -> bool {\n  // 쿼리 파라미터 검증\n\n  // 파라미터 이름 검증\n  if paramName.isEmpty() || paramName.length() > 50 {\n    return false\n  }\n\n  // 파라미터 값 검증\n  if paramValue.isEmpty() || paramValue.length() > 256 {\n    return false\n  }\n\n  // XSS 패턴 차단\n  if paramValue.contains(\"<\") || paramValue.contains(\">\") {\n    return false\n  }\n\n  // SQL injection 패턴 차단\n  if paramValue.contains(\"'\") || paramValue.contains(\"\\\"\") || paramValue.contains(\";\") {\n    return false\n  }\n\n  return true\n}\n\nfunc isSecureQueryString(query: map[string]string) -> bool {\n  // 전체 쿼리 문자열 검증\n\n  for key in query {\n    let value = query[key]\n    if !isValidQueryParam(key, value) {\n      return false\n    }\n  }\n\n  return true\n}\n","structuredPatch":[{"oldStart":283,"oldLines":26,"newStart":283,"newLines":93,"lines":[" // ──────────────────────────────────────────────────────────────────────────"," "," func runAPILoop(server: APIServer) -> void {","-  while server.running {","-    // clientSocket = net.accept(server.socket)","-    // rawRequest = net.read(clientSocket)","+  // 🔧 Phase 1: TCP 소켓 통신 구현"," ","-    // 요청 파싱 (path와 query 추출)","-    // path = parseRequestPath(rawRequest)","-    // query = parseQueryString(rawRequest)","+  // 1️⃣ 소켓 생성","+  println(\"📍 API 소켓 생성 중...\")","+  server.socket = net.socket(2, 1)  // AF_INET=2, SOCK_STREAM=1"," ","-    // API 처리","-    // response = handleAPIRequest(server, path, query)","+  if server.socket < 0 {","+    println(\"❌ API 소켓 생성 실패\")","+    return","+  }","+  println(\"✅ API 소켓 생성됨 (fd=\" + i32ToString(server.socket) + \")\")"," ","-    // HTTP 응답 생성","-    // httpResponse = buildHTTPResponse(response.status, response.contentType, response.body)","+  // 2️⃣ SO_REUSEADDR 옵션 설정","+  net.setsockopt(server.socket, 1, 15, 1)"," ","-    // 응답 전송","-    // net.write(clientSocket, httpResponse)","-    // net.close(clientSocket)","+  // 3️⃣ 소켓 바인드","+  println(\"📍 API 바인드 중: \" + server.host + \":\" + i32ToString(server.port))","+  let bindResult = net.bind(server.socket, server.host, server.port)"," ","+  if bindResult != 0 {","+    println(\"❌ API 바인드 실패 (호스트/포트 이미 사용 중?)\")","+    net.close(server.socket)","+    return","+  }","+  println(\"✅ API 바인드 완료\")","+","+  // 4️⃣ 리슨 시작","+  println(\"📍 API 리슨 시작 (backlog=128)\")","+  let listenResult = net.listen(server.socket, 128)","+","+  if listenResult != 0 {","+    println(\"❌ API 리슨 실패\")","+    net.close(server.socket)","+    return","+  }","+  println(\"✅ API 리슨 시작됨, 클라이언트 대기 중...\")","+  println(\"\")","+","+  // 5️⃣ 메인 수락 루프","+  while server.running {","+    // 클라이언트 연결 수락","+    let (clientFd, clientHost, clientPort) = net.accept(server.socket)","+","+    if clientFd < 0 {","+      continue","+    }","+","+    // 6️⃣ HTTP 요청 읽기","+    let (readOk, rawRequest) = net.read(clientFd, 4096)","+","+    if !readOk || rawRequest.isEmpty() {","+      net.close(clientFd)","+      continue","+    }","+","     server.requestCount = server.requestCount + 1","+","+    // 7️⃣ 요청 파싱 (path와 query 추출)","+    let path = parseRequestPath(rawRequest)","+    let query = parseQueryString(rawRequest)","+","+    println(\"📨 요청 #\" + i32ToString(server.requestCount) + \": \" + path + \" (from \" + clientHost + \":\" + i32ToString(clientPort) + \")\")","+","+    // 8️⃣ API 처리","+    let response = handleAPIRequest(server, path, query)","+","+    // 9️⃣ HTTP 응답 생성","+    let httpResponse = buildAPIHTTPResponse(response.status, response.contentType, response.body)","+","+    // 🔟 응답 전송","+    let writeOk = net.write(clientFd, httpResponse)","+","+    if writeOk {","+      println(\"✅ API 응답 전송: \" + i32ToString(response.status))","+    } else {","+      println(\"❌ API 응답 전송 실패\")","+    }","+","+    // 1️⃣1️⃣ 연결 종료","+    net.close(clientFd)","   }","+","+  // 서버 종료 시 소켓 정리","+  println(\"\")","+  println(\"🛑 API 서버 종료 중...\")","+  net.close(server.socket)","+  println(\"✅ API 소켓 닫음\")"," }"," "," // ──────────────────────────────────────────────────────────────────────────"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"612d60bb-3089-44fc-a004-0fcd74dc3ae8","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
