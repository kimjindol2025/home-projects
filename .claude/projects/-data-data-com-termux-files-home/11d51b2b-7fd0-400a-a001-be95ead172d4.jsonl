{"parentUuid":"8532bfee-9e31-4140-a0ae-e9f72919834d","isSidechain":false,"message":{"model":"claude-haiku-4-5-20251001","id":"msg_01WWGBQG8aEBW6KhQMWkzr5o","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TKTKQQboPzL6xsUreJKHRB","name":"Write","input":{"file_path":"/data/data/com.termux/files/home/freelang-light/src/test-phase3.js","content":"/**\n * FreeLang Light Phase 3 Tests\n * 조건부, 반복, 변수 치환 테스트\n */\n\nconst { ExpressionEvaluator } = require('./expression-evaluator');\nconst { MarkupProcessor } = require('./markup-processor');\n\nfunction test(name, fn) {\n  try {\n    fn();\n    console.log(`✅ ${name}`);\n  } catch (error) {\n    console.error(`❌ ${name}: ${error.message}`);\n  }\n}\n\n// ExpressionEvaluator 테스트\nconsole.log('\\n📝 Expression Evaluator Tests\\n');\n\ntest('기본 산술 연산', () => {\n  const eval = new ExpressionEvaluator({ a: 5, b: 3 });\n  const result = eval.evaluate('a + b');\n  if (result !== 8) throw new Error(`Expected 8, got ${result}`);\n});\n\ntest('비교 연산', () => {\n  const eval = new ExpressionEvaluator({ count: 5 });\n  const result = eval.evaluateCondition('count > 3');\n  if (!result) throw new Error(`Expected true, got ${result}`);\n});\n\ntest('문자열 연결', () => {\n  const eval = new ExpressionEvaluator({ name: 'Alice' });\n  const result = eval.evaluate('\"Hello, \" + name');\n  if (result !== 'Hello, Alice') throw new Error(`Expected 'Hello, Alice', got ${result}`);\n});\n\ntest('삼항 연산자', () => {\n  const eval = new ExpressionEvaluator({ age: 18 });\n  const result = eval.evaluateTernary('age >= 18 ? \"adult\" : \"minor\"', {});\n  if (result !== 'adult') throw new Error(`Expected 'adult', got ${result}`);\n});\n\ntest('배열 길이', () => {\n  const eval = new ExpressionEvaluator({ items: [1, 2, 3] });\n  const result = eval.evaluate('items.length');\n  if (result !== 3) throw new Error(`Expected 3, got ${result}`);\n});\n\ntest('Props 기본값 - 문자열', () => {\n  const eval = new ExpressionEvaluator({});\n  const result = eval.parseDefaultValue(\"string = 'hello'\");\n  if (result !== 'hello') throw new Error(`Expected 'hello', got ${result}`);\n});\n\ntest('Props 기본값 - 숫자', () => {\n  const eval = new ExpressionEvaluator({});\n  const result = eval.parseDefaultValue('number = 42');\n  if (result !== 42) throw new Error(`Expected 42, got ${result}`);\n});\n\ntest('Props 기본값 - boolean', () => {\n  const eval = new ExpressionEvaluator({});\n  const result = eval.parseDefaultValue('boolean = true');\n  if (result !== true) throw new Error(`Expected true, got ${result}`);\n});\n\ntest('변수 추출', () => {\n  const eval = new ExpressionEvaluator({});\n  const vars = eval.extractVariables('count > 0 && items.length > 0');\n  if (!vars.includes('count') || !vars.includes('items')) {\n    throw new Error(`Expected ['count', 'items'], got ${vars}`);\n  }\n});\n\n// MarkupProcessor 테스트\nconsole.log('\\n🎨 Markup Processor Tests\\n');\n\ntest('변수 치환', () => {\n  const processor = new MarkupProcessor({ name: 'Alice' });\n  const html = '<h1>{name}</h1>';\n  const result = processor.substituteVariables(html, {});\n  if (!result.includes('Alice')) throw new Error(`Expected 'Alice' in result`);\n});\n\ntest('조건부 렌더링 - true', () => {\n  const processor = new MarkupProcessor({ show: true });\n  const html = '{if show ? \"<div>Visible</div>\" : \"<div>Hidden</div>\"}';\n  const result = processor.processConditions(html, {});\n  if (!result.includes('Visible')) throw new Error(`Expected 'Visible' in result`);\n});\n\ntest('조건부 렌더링 - false', () => {\n  const processor = new MarkupProcessor({ show: false });\n  const html = '{if show ? \"<div>Visible</div>\" : \"<div>Hidden</div>\"}';\n  const result = processor.processConditions(html, {});\n  if (!result.includes('Hidden')) throw new Error(`Expected 'Hidden' in result`);\n});\n\ntest('반복 렌더링', () => {\n  const processor = new MarkupProcessor({ items: ['apple', 'banana', 'cherry'] });\n  const html = '<ul>{for item in items ? \"<li>{item}</li>\" }</ul>';\n  const result = processor.processLoops(html, {});\n  if (!result.includes('<li>apple</li>')) throw new Error(`Expected '<li>apple</li>' in result`);\n  if (!result.includes('<li>banana</li>')) throw new Error(`Expected '<li>banana</li>' in result`);\n  if (!result.includes('<li>cherry</li>')) throw new Error(`Expected '<li>cherry</li>' in result`);\n});\n\ntest('반복 - index 접근', () => {\n  const processor = new MarkupProcessor({ items: ['a', 'b'] });\n  const html = '{for item in items ? \"<span>{item_index}</span>\" }';\n  const result = processor.processLoops(html, {});\n  if (!result.includes('<span>0</span>')) throw new Error(`Expected index 0`);\n  if (!result.includes('<span>1</span>')) throw new Error(`Expected index 1`);\n});\n\ntest('반복 - first/last 플래그', () => {\n  const processor = new MarkupProcessor({ items: ['a', 'b', 'c'] });\n  const html = '{for item in items ? \"<li class=\\\"{item_first ? first : \\\"\\\"} {item_last ? last : \\\"\\\"}\\\">{item}</li>\" }';\n  const result = processor.processLoops(html, {});\n  if (!result.includes('class=\"first')) throw new Error(`Expected first class`);\n  if (!result.includes('class=\" last\"')) throw new Error(`Expected last class`);\n});\n\ntest('중첩된 조건 + 반복', () => {\n  const processor = new MarkupProcessor({\n    show: true,\n    items: ['x', 'y']\n  });\n  const html = '{if show ? \"{for item in items ? <li>{item}</li> }\" : \"\"}';\n  const result = processor.processComplete(html, {});\n  if (!result.includes('<li>x</li>')) throw new Error(`Expected nested result`);\n});\n\ntest('바인딩 속성 처리', () => {\n  const processor = new MarkupProcessor({ id: 'btn1' });\n  const html = '<button id=\"{id}\">Click</button>';\n  const result = processor.processBindings(html, {});\n  if (!result.includes('id=\"btn1\"')) throw new Error(`Expected id=\"btn1\"`);\n});\n\nconsole.log('\\n✨ Phase 3 테스트 완료!\\n');\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":8,"cache