ng completed`);\n      console.log(`   Total spans: ${traces.totalSpans}`);\n      passed++;\n    } else {\n      console.log('❌ Tracing failed');\n      failed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 5 failed:', err.message);\n    failed++;\n  }","originalFile":"// ============================================================================\n// Integration Tests: Phase 6 Advanced Features\n// ============================================================================\n\nconst { createAutoScaler, createResourceQuota } = require('./freelang/core/autoscaling');\nconst { createMesh, createTracer } = require('./freelang/core/service-mesh');\nconst { MetricsCollector, Dashboard } = require('./freelang/core/metrics-prometheus');\n\n// ──────────────────────────────────────────────────────────────────────────\n// Phase 6.1: Prometheus Metrics Tests\n// ──────────────────────────────────────────────────────────────────────────\n\nasync function testPrometheus() {\n  console.log('\\n╔═══════════════════════════════════════════════════════╗');\n  console.log('║  📊 Phase 6.1: Prometheus Metrics & Monitoring        ║');\n  console.log('╚═══════════════════════════════════════════════════════╝\\n');\n\n  const collector = new MetricsCollector();\n  let passed = 0;\n  let failed = 0;\n\n  // Test 1: HTTP Metrics Recording\n  console.log('📝 Test 1: HTTP Metrics Recording');\n  try {\n    for (let i = 0; i < 20; i++) {\n      collector.recordRequest('GET', i % 20 < 18 ? 200 : 500, Math.random() * 1000);\n    }\n\n    const dashboard = collector.getDashboard();\n    if (dashboard.httpMetrics.totalRequests === 20) {\n      console.log(`✅ Recorded 20 HTTP requests`);\n      console.log(`   Success rate: ${dashboard.httpMetrics.successRate}`);\n      passed++;\n    } else {\n      console.log('❌ Request recording failed');\n      failed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 1 failed:', err.message);\n    failed++;\n  }\n\n  // Test 2: Database Metrics\n  console.log('\\n📝 Test 2: Database Metrics');\n  try {\n    for (let i = 0; i < 10; i++) {\n      collector.recordDatabaseOperation('INSERT', i < 9, Math.random() * 100);\n    }\n\n    const json = collector.exportJSON();\n    if (json.metrics.database_operations_total.value === 10) {\n      console.log(`✅ Recorded 10 DB operations`);\n      console.log(`   Errors: ${json.metrics.database_errors_total.value}`);\n      passed++;\n    } else {\n      console.log('❌ DB metrics failed');\n      failed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 2 failed:', err.message);\n    failed++;\n  }\n\n  // Test 3: Prometheus Format Export\n  console.log('\\n📝 Test 3: Prometheus Format Export');\n  try {\n    const prom = collector.exportPrometheus();\n    if (prom.includes('http_requests_total') && prom.includes('TYPE counter')) {\n      console.log(`✅ Prometheus format valid (${prom.split('\\n').length} lines)`);\n      passed++;\n    } else {\n      console.log('❌ Prometheus export failed');\n      failed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 3 failed:', err.message);\n    failed++;\n  }\n\n  // Test 4: Alert Detection\n  console.log('\\n📝 Test 4: Alert Detection');\n  try {\n    // Simulate many errors\n    for (let i = 0; i < 15; i++) {\n      collector.recordDatabaseOperation('UPDATE', false, 100);\n    }\n\n    const alerts = collector.checkAlerts();\n    if (alerts.length > 0) {\n      console.log(`✅ Alerts detected: ${alerts.length}`);\n      alerts.forEach(a => console.log(`   [${a.severity}] ${a.message}`));\n      passed++;\n    } else {\n      console.log('⚠️ No alerts triggered (may be normal)');\n      passed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 4 failed:', err.message);\n    failed++;\n  }\n\n  // Test 5: Dashboard Rendering\n  console.log('\\n📝 Test 5: Dashboard Rendering');\n  try {\n    const dashboard = new Dashboard(collector);\n    // Redirect console for dashboard\n    const output = collector.getDashboard();\n    if (output.httpMetrics && output.databaseMetrics && output.systemMetrics) {\n      console.log(`✅ Dashboard data complete`);\n      console.log(`   HTTP Success: ${output.httpMetrics.successRate}`);\n      console.log(`   Latency p99: ${output.latency.p99}`);\n      passed++;\n    } else {\n      console.log('❌ Dashboard generation failed');\n      failed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 5 failed:', err.message);\n    failed++;\n  }\n\n  console.log('\\n📊 Phase 6.1 Results:');\n  console.log(`✅ Passed: ${passed}/5`);\n  console.log(`❌ Failed: ${failed}/5\\n`);\n\n  return failed === 0;\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Phase 6.2: Autoscaling Tests\n// ──────────────────────────────────────────────────────────────────────────\n\nasync function testAutoscaling() {\n  console.log('\\n╔═══════════════════════════════════════════════════════╗');\n  console.log('║  ⚙️  Phase 6.2: Dynamic Autoscaling                   ║');\n  console.log('╚═══════════════════════════════════════════════════════╝\\n');\n\n  const scaler = createAutoScaler({\n    minInstances: 2,\n    maxInstances: 5,\n    targetCPU: 70,\n    scaleUpThreshold: 2\n  });\n\n  let passed = 0;\n  let failed = 0;\n\n  // Test 1: Initialization\n  console.log('📝 Test 1: Initialization');\n  try {\n    if (scaler.instances.length === 2) {\n      console.log(`✅ Initialized with 2 instances`);\n      passed++;\n    } else {\n      console.log('❌ Initialization failed');\n      failed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 1 failed:', err.message);\n    failed++;\n  }\n\n  // Test 2: Scale UP (High CPU)\n  console.log('\\n📝 Test 2: Scale UP (High CPU)');\n  try {\n    const initialCount = scaler.instances.length;\n\n    // Simulate high CPU\n    for (let i = 0; i < 2; i++) {\n      scaler.instances.forEach(inst => {\n        scaler.updateMetrics(inst.id, { cpu: 85, memory: 70 });\n      });\n      scaler.makeScalingDecision();\n    }\n\n    const afterScaleUp = scaler.instances.length;\n    if (afterScaleUp > initialCount) {\n      console.log(`✅ Scaled UP: ${initialCount} → ${afterScaleUp} instances`);\n      passed++;\n    } else {\n      console.log('❌ Scale up failed');\n      failed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 2 failed:', err.message);\n    failed++;\n  }\n\n  // Test 3: Scale DOWN (Low CPU)\n  console.log('\\n📝 Test 3: Scale DOWN (Low CPU)');\n  try {\n    const beforeCount = scaler.instances.length;\n\n    // Simulate low CPU\n    for (let i = 0; i < 12; i++) {\n      scaler.instances.forEach(inst => {\n        scaler.updateMetrics(inst.id, { cpu: 20, memory: 30 });\n      });\n      scaler.makeScalingDecision();\n    }\n\n    const afterScaleDown = scaler.instances.length;\n    if (afterScaleDown < beforeCount && afterScaleDown >= scaler.minInstances) {\n      console.log(`✅ Scaled DOWN: ${beforeCount} → ${afterScaleDown} instances`);\n      passed++;\n    } else {\n      console.log('⚠️ Scale down behavior normal');\n      passed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 3 failed:', err.message);\n    failed++;\n  }\n\n  // Test 4: Health Check\n  console.log('\\n📝 Test 4: Health Check');\n  try {\n    const health = scaler.healthCheck();\n    if (health.total > 0 && health.healthy > 0) {\n      console.log(`✅ Health check passed`);\n      console.log(`   Total: ${health.total}, Healthy: ${health.healthy}, Unhealthy: ${health.unhealthy}`);\n      passed++;\n    } else {\n      console.log('❌ Health check failed');\n      failed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 4 failed:', err.message);\n    failed++;\n  }\n\n  // Test 5: Metrics Export\n  console.log('\\n📝 Test 5: Metrics Export');\n  try {\n    const metrics = scaler.getMetrics();\n    if (metrics.currentInstances && metrics.averageCPU !== undefined) {\n      console.log(`✅ Metrics exported`);\n      console.log(`   Instances: ${metrics.currentInstances}`);\n      console.