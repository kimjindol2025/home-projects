──────────────────────────────────\n// 초기화\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc initializeState() {\n  println(\"⚙️  상태 초기화...\")\n\n  // Counter 기본값\n  let counter = getCounter()\n  println(\"  ✓ Counter: \\(counter.count)\")\n\n  // Todo 리스트 기본값\n  let todos = getTodos()\n  println(\"  ✓ Todos: \\(todos.length)개\")\n\n  // 시스템 헬스 체크\n  let health = getSystemHealth()\n  println(\"  ✓ Health: \\(health.status)\")\n\n  println(\"\")\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 종료 처리\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc onShutdown() {\n  println(\"\")\n  println(\"╔═══════════════════════════════════════════════════════════╗\")\n  println(\"║ 서버 종료 중...                                           ║\")\n  println(\"╚═══════════════════════════════════════════════════════════╝\")\n  println(\"\")\n\n  // 상태 저장 로직 추가 가능\n  clearHistory()\n\n  println(\"✓ 안전하게 종료되었습니다\")\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 메인 실행\n// ──────────────────────────────────────────────────────────────────────────\n\nmain()\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"3d4f338d-79c4-4f40-bd3f-aa813905c8b9","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
