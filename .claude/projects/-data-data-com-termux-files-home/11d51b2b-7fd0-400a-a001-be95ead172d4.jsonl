 let id = stringToI32(idStr)\n\n    // 🔒 보안: ID 범위 확인 (1-1000)\n    if id < 1 || id > 1000 {\n      return {\n        status: 400,\n        contentType: \"application/json; charset=utf-8\",\n        body: \"{\\\"error\\\": \\\"Invalid blog ID\\\", \\\"message\\\": \\\"Blog ID out of range\\\"}\"\n      }\n    }\n\n    let blog = getBlogById(server.blogs, id)\n\n    let json = blogToJSON(blog)\n    return {\n      status: 200,\n      contentType: \"application/json; charset=utf-8\",\n      body: json\n    }\n  }","originalFile":"// ============================================================================\n// FreeLang API 서버 (메인 프로그램)\n// 정식 FreeLang 모듈 - 컴파일 가능, 독립 실행 가능\n// freec api-main.free && ./api-main\n// ============================================================================\n\nuse \"std/net\"\nuse \"std/json\"\nuse \"std/http\"\n\ntype Blog = {\n  id: i32,\n  title: string,\n  excerpt: string,\n  date: string,\n  author: string,\n  category: string,\n  views: i32\n}\n\ntype APIResponse = {\n  status: i32,\n  contentType: string,\n  body: string\n}\n\nfunc main() -> void {\n  println(\"\")\n  println(\"╔═══════════════════════════════════════════════════════╗\")\n  println(\"║  🔌 FreeLang API 서버 (정식 모듈)                   ║\")\n  println(\"╚═══════════════════════════════════════════════════════╝\")\n  println(\"\")\n\n  let port: i32 = 8001\n  let host: string = \"127.0.0.1\"\n\n  println(\"📍 포트: \" + i32ToString(port))\n  println(\"📍 호스트: \" + host)\n  println(\"\")\n\n  println(\"📋 API 엔드포인트:\")\n  println(\"  GET  /api/posts       - 블로그 목록\")\n  println(\"  GET  /api/posts/:id   - 블로그 상세\")\n  println(\"  GET  /api/theme       - 테마 설정\")\n  println(\"  GET  /api/health      - 상태 확인\")\n  println(\"\")\n\n  // API 서버 시작\n  let server = createAPIServer(host, port)\n  if startAPIServer(server) {\n    println(\"✅ API 서버 시작됨\")\n    println(\"🔗 http://localhost:\" + i32ToString(port) + \"/api/posts\")\n    println(\"\")\n    println(\"⌨️  Ctrl+C로 종료\")\n    println(\"\")\n\n    // 메인 루프\n    runAPILoop(server)\n  } else {\n    println(\"❌ API 서버 시작 실패\")\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// API 서버 구조\n// ──────────────────────────────────────────────────────────────────────────\n\ntype APIServer = {\n  host: string,\n  port: i32,\n  socket: i32,\n  running: bool,\n  requestCount: i32,\n  blogs: [Blog]\n}\n\nfunc createAPIServer(host: string, port: i32) -> APIServer {\n  let blogs = createSampleBlogs()\n\n  return {\n    host: host,\n    port: port,\n    socket: 0,\n    running: false,\n    requestCount: 0,\n    blogs: blogs\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 샘플 데이터\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc createSampleBlogs() -> [Blog] {\n  let blogs: [Blog] = []\n\n  blogs.push({\n    id: 1,\n    title: \"FreeLang 시작하기\",\n    excerpt: \"FreeLang으로 첫 프로젝트를 시작해보세요\",\n    date: \"2026-03-13\",\n    author: \"김프리\",\n    category: \"튜토리얼\",\n    views: 156\n  })\n\n  blogs.push({\n    id: 2,\n    title: \"CSS 모듈 시스템 소개\",\n    excerpt: \"타입 안전한 CSS를 FreeLang으로 작성하기\",\n    date: \"2026-03-12\",\n    author: \"김프리\",\n    category: \"기술\",\n    views: 243\n  })\n\n  blogs.push({\n    id: 3,\n    title: \"의존성 0으로 배포하기\",\n    excerpt: \"npm 없이 완전 독립적인 시스템 구축\",\n    date: \"2026-03-11\",\n    author: \"김프리\",\n    category: \"배포\",\n    views: 89\n  })\n\n  return blogs\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 서버 시작/중지\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc startAPIServer(server: APIServer) -> bool {\n  server.running = true\n  return true\n}\n\nfunc stopAPIServer(server: APIServer) -> void {\n  server.running = false\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// API 엔드포인트 핸들러\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc handleAPIRequest(server: APIServer, path: string, query: map[string]string) -> APIResponse {\n  // GET /api/posts - 블로그 목록\n  if path == \"/api/posts\" {\n    let json = blogsToJSON(server.blogs)\n    return {\n      status: 200,\n      contentType: \"application/json; charset=utf-8\",\n      body: json\n    }\n  }\n\n  // GET /api/posts/:id - 블로그 상세\n  if path.startsWith(\"/api/posts/\") {\n    let idStr = path.substring(11)\n    let id = stringToI32(idStr)\n    let blog = getBlogById(server.blogs, id)\n\n    let json = blogToJSON(blog)\n    return {\n      status: 200,\n      contentType: \"application/json; charset=utf-8\",\n      body: json\n    }\n  }\n\n  // GET /api/theme - 테마 설정\n  if path == \"/api/theme\" {\n    let isDark = query[\"dark\"] == \"true\"\n    let json = \"{\"\n    json = json + \"\\\"isDarkMode\\\": \" + boolToString(isDark) + \", \"\n    json = json + \"\\\"primaryColor\\\": \\\"#3b82f6\\\", \"\n    json = json + \"\\\"fontSize\\\": 14\"\n    json = json + \"}\"\n\n    return {\n      status: 200,\n      contentType: \"application/json; charset=utf-8\",\n      body: json\n    }\n  }\n\n  // GET /api/health - 상태 확인\n  if path == \"/api/health\" {\n    let json = \"{\"\n    json = json + \"\\\"status\\\": \\\"ok\\\", \"\n    json = json + \"\\\"version\\\": \\\"1.0.0\\\", \"\n    json = json + \"\\\"uptime\\\": \\\"3600s\\\"\"\n    json = json + \"}\"\n\n    return {\n      status: 200,\n      contentType: \"application/json; charset=utf-8\",\n      body: json\n    }\n  }\n\n  // 404 Not Found\n  let error = \"{\\\"error\\\": \\\"Not Found\\\", \\\"path\\\": \\\"\" + path + \"\\\"}\"\n  return {\n    status: 404,\n    contentType: \"application/json; charset=utf-8\",\n    body: error\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// JSON 변환\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc blogToJSON(blog: Blog) -> string {\n  let json = \"{\"\n  json = json + \"\\\"id\\\": \" + i32ToString(blog.id) + \", \"\n  json = json + \"\\\"title\\\": \\\"\" + blog.title + \"\\\", \"\n  json = json + \"\\\"excerpt\\\": \\\"\" + blog.excerpt + \"\\\", \"\n  json = json + \"\\\"date\\\": \\\"\" + blog.date + \"\\\", \"\n  json = json + \"\\\"author\\\": \\\"\" + blog.author + \"\\\", \"\n  json = json + \"\\\"category\\\": \\\"\" + blog.category + \"\\\", \"\n  json = json + \"\\\"views\\\": \" + i32ToString(blog.views)\n  json = json + \"}\"\n  return json\n}\n\nfunc blogsToJSON(blogs: [Blog]) -> string {\n  let json = \"[\"\n  for i in 0..blogs.length() {\n    if i > 0 {\n      json = json + \", \"\n    }\n    json = json + blogToJSON(blogs[i])\n  }\n  json = json + \"]\"\n  return json\n}\n\nfunc getBlogById(blogs: [Blog], id: i32) -> Blog {\n  for blog in blogs {\n    if blog.id == id {\n      return blog\n    }\n  }\n  return blogs[0]\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 서버 메인 루프\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc runAPILoop(server: APIServer) -> void {\n  while server.running {\n    // clientSocket = net.accept(server.socket)\n    // rawRequest = net.read(clientSocket)\n\n    // 요청 파싱 (path와 query 추출)\n    // path = parseRequestPath(rawRequest)\n    // query = parseQueryString(rawRequest)\n\n    // API 처리\n    // response = handleAPIRequest(server, path, query)\n\n    // HTTP 응답 생성\n    // httpResponse = buildHTTPResponse(response.status, response.contentType, response.body)\n\n    // 응답 전송\n    // net.write(clientSocket, httpResponse)\n    // net.close(clientSocket)\n\n    server.requestCount = server.requestCount + 1\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 유틸리티\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc i32ToString(n: i32) -> string {\n  if n == 0 {\n    return \"0\"\n  }\n\n  let negative = n < 0\n  let abs = if negative { -n } else { n }\n\n  let result = \"\"\n  let temp = abs\n  while temp > 0 {\n    let digit = temp % 10\n    let char = if digit == 0 { \"0\" }\n             else if digit == 1 { \"1\" }\n             else if digit == 2 { \"2\" }\n             else if digit == 3 { \"3\" }\n             else if digit == 4 { \"4\" }\n             else if digit == 5 { \"5\" }\n             else if digit == 6 { \"6\" }\n             else if digit == 7 { \"7\" }\n             else if digit == 8 { \"8\" }\n             else { \"9\" }\n    result = char + result\n    temp = temp / 10\n  }\n\n  if negative {\n    return \"-\" + result\n  }\n  return result\n}\n\nfunc stringToI32(s: string) -> i32 {\n  if s.isEmpty() {\n    return 0\n  }\n\n  let result: i32 = 0\n  let negative = s.startsWith(\"-\")\n  let start = if negative { 1 } else { 0 }\n\n  for i in start..s.length() {\n    let char = s[i]\n    let digit = if char == \"0\" { 0 }\n              else if char == \"1\" { 1 }\n              else if char == \"2\" { 2 }\n              else if char == \"3\" { 3 }\n              else if char == \"4\" { 4 }\n              else if char == \"5\" { 5 }\n              else if char == \"6\" { 6 }\n              else if char == \"7\" { 7 }\n              else if char == \"8\" { 8 }\n              else if char == \"9\" { 9 }\n              else { 0 }\n    result = result * 10 + digit\n  }\n\n  if negative {\n    return -result\n  }\n  return result\n}\n\nfunc boolToString(b: bool) -> string {\n  if b {\n    return \"true\"\n  }\n  return \"false\"\n}\n","structuredPatch":[{"oldStart":155,"oldLines":10,"newStart":155,"newLines":30,"lines":["     }","   }"," ","-  // GET /api/posts/:id - 블로그 상세","+  // GET /api/posts/:id - 블로그 상세 (🔒 ID 검증 추가)","   if path.startsWith(\"/api/posts/\") {","     let idStr = path.substring(11)","+","+    // 🔒 보안: ID 검증","+    if !isValidBlogId(idStr) {","+      return {","+        status: 400,","+        contentType: \"application/json; charset=utf-8\",","+        body: \"{\\\"error\\\": \\\"Invalid blog ID\\\", \\\"message\\\": \\\"Blog ID must be numeric\\\"}\"","+      }","+    }","+","     let id = stringToI32(idStr)","+","+    // 🔒 보안: ID 범위 확인 (1-1000)","+    if id < 1 || id > 1000 {","+      return {","+        status: 400,","+        contentType: \"application/json; charset=utf-8\",","+        body: \"{\\\"error\\\": \\\"Invalid blog ID\\\", \\\"message\\\": \\\"Blog ID out of range\\\"}\"","+      }","+    }","+","     let blog = getBlogById(server.blogs, id)"," ","     let json = blogToJSON(blog)"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"f8b800c5-a77c-4c01-8ed5-7cd28e41b7d4","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
