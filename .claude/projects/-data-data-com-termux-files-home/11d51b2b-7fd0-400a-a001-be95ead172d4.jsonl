{"parentUuid":"e75fcd2b-5f24-4977-aea0-d2392121a59b","isSidechain":false,"message":{"model":"claude-haiku-4-5-20251001","id":"msg_01MakAu1zR1HfjybzgNNNTVM","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XdDkcUTySQ6cAJ9rEW5NJh","name":"Write","input":{"file_path":"/data/data/com.termux/files/home/freelang-hybrid/freelang/core/tailwind-generator.free","content":"// ============================================================================\n// Phase 12: CSS Generation Engine\n// 모든 Tailwind 설정을 CSS로 동적 생성\n// ============================================================================\n\nimport { getTailwindConfig } from \"./tailwind-config\"\nimport { generateAllUtilityClasses } from \"./tailwind-utils\"\nimport { generateAllResponsiveClasses } from \"./tailwind-responsive\"\nimport { generateAllStateClasses } from \"./tailwind-states\"\n\n// ──────────────────────────────────────────────────────────────────────────\n// CSS Variables Generator (CSS Custom Properties)\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateCSSVariables() -> any {\n  let config = getTailwindConfig()\n  let spacing = config[\"spacing\"]\n  let colors = config[\"colors\"]\n  let breakpoints = config[\"breakpoints\"]\n  let fontSize = config[\"fontSize\"]\n  let borderRadius = config[\"borderRadius\"]\n  let shadows = config[\"shadows\"]\n\n  let cssVars = \":root {\\n\"\n\n  // Spacing variables\n  cssVars = cssVars + \"  /* Spacing Scale (4px units) */\\n\"\n  for key in spacing {\n    let value = spacing[key]\n    cssVars = cssVars + \"  --spacing-\\(key): \\(value);\\n\"\n  }\n\n  // Color variables\n  cssVars = cssVars + \"\\n  /* Color Palette */\\n\"\n  for colorName in colors {\n    let colorObj = colors[colorName]\n    for shade in colorObj {\n      let hexValue = colorObj[shade]\n      cssVars = cssVars + \"  --color-\\(colorName)-\\(shade): \\(hexValue);\\n\"\n    }\n  }\n\n  // Font size variables\n  cssVars = cssVars + \"\\n  /* Font Sizes */\\n\"\n  for sizeKey in fontSize {\n    let sizeValue = fontSize[sizeKey]\n    cssVars = cssVars + \"  --font-size-\\(sizeKey): \\(sizeValue);\\n\"\n  }\n\n  // Border radius variables\n  cssVars = cssVars + \"\\n  /* Border Radius */\\n\"\n  for radiusKey in borderRadius {\n    let radiusValue = borderRadius[radiusKey]\n    cssVars = cssVars + \"  --border-radius-\\(radiusKey): \\(radiusValue);\\n\"\n  }\n\n  // Shadow variables\n  cssVars = cssVars + \"\\n  /* Shadows */\\n\"\n  for shadowKey in shadows {\n    let shadowValue = shadows[shadowKey]\n    cssVars = cssVars + \"  --shadow-\\(shadowKey): \\(shadowValue);\\n\"\n  }\n\n  // Transition defaults\n  cssVars = cssVars + \"\\n  /* Transitions */\\n\"\n  cssVars = cssVars + \"  --duration-default: 200ms;\\n\"\n  cssVars = cssVars + \"  --timing-default: ease-in-out;\\n\"\n\n  cssVars = cssVars + \"}\\n\"\n\n  return cssVars\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Reset/Normalize CSS\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateResetCSS() -> any {\n  let resetCSS = \"/* Reset & Normalize */\\n\"\n    + \"* {\\n\"\n    + \"  margin: 0;\\n\"\n    + \"  padding: 0;\\n\"\n    + \"  box-sizing: border-box;\\n\"\n    + \"}\\n\\n\"\n    + \"html {\\n\"\n    + \"  -webkit-font-smoothing: antialiased;\\n\"\n    + \"  -moz-osx-font-smoothing: grayscale;\\n\"\n    + \"}\\n\\n\"\n    + \"body {\\n\"\n    + \"  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;\\n\"\n    + \"  line-height: 1.5;\\n\"\n    + \"  color: #1f2937;\\n\"\n    + \"  background-color: #ffffff;\\n\"\n    + \"}\\n\\n\"\n    + \"img {\\n\"\n    + \"  max-width: 100%;\\n\"\n    + \"  height: auto;\\n\"\n    + \"  display: block;\\n\"\n    + \"}\\n\\n\"\n    + \"button, input, textarea, select {\\n\"\n    + \"  font-family: inherit;\\n\"\n    + \"  font-size: inherit;\\n\"\n    + \"}\\n\\n\"\n    + \"button {\\n\"\n    + \"  cursor: pointer;\\n\"\n    + \"}\\n\\n\"\n    + \"a {\\n\"\n    + \"  color: #3b82f6;\\n\"\n    + \"  text-decoration: none;\\n\"\n    + \"  transition: color 200ms ease-in-out;\\n\"\n    + \"}\\n\\n\"\n    + \"a:hover {\\n\"\n    + \"  color: #1d4ed8;\\n\"\n    + \"}\\n\\n\"\n    + \"h1, h2, h3, h4, h5, h6 {\\n\"\n    + \"  font-weight: 600;\\n\"\n    + \"  line-height: 1.2;\\n\"\n    + \"}\\n\"\n\n  return resetCSS\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Utility Classes Generator (기본 유틸리티)\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateUtilityCSS() -> any {\n  let utilities = generateAllUtilityClasses()\n  return utilities\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Responsive CSS Generator\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateResponsiveCSS() -> any {\n  let responsive = generateAllResponsiveClasses()\n  return responsive[\"css\"]\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// State CSS Generator\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateStateCSS() -> any {\n  let states = generateAllStateClasses()\n  return states[\"css\"]\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Component Default Styles\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateComponentStyles() -> any {\n  let componentCSS = \"/* Component Base Styles */\\n\"\n    + \".button, button[type=button], button[type=submit], button[type=reset] {\\n\"\n    + \"  display: inline-flex;\\n\"\n    + \"  align-items: center;\\n\"\n    + \"  justify-content: center;\\n\"\n    + \"  padding: 12px 16px;\\n\"\n    + \"  font-size: 14px;\\n\"\n    + \"  font-weight: 500;\\n\"\n    + \"  border: 1px solid transparent;\\n\"\n    + \"  border-radius: 6px;\\n\"\n    + \"  background-color: #3b82f6;\\n\"\n    + \"  color: white;\\n\"\n    + \"  cursor: pointer;\\n\"\n    + \"  transition: all 200ms ease-in-out;\\n\"\n    + \"}\\n\\n\"\n    + \".button:hover, button[type=button]:hover, button[type=submit]:hover, button[type=reset]:hover {\\n\"\n    + \"  background-color: #2563eb;\\n\"\n    + \"  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\\n\"\n    + \"}\\n\\n\"\n    + \".button:active, button[type=button]:active, button[type=submit]:active, button[type=reset]:active {\\n\"\n    + \"  background-color: #1d4ed8;\\n\"\n    + \"  transform: scale(0.98);\\n\"\n    + \"}\\n\\n\"\n    + \".button:disabled, button[type=button]:disabled, button[type=submit]:disabled, button[type=reset]:disabled {\\n\"\n    + \"  opacity: 0.5;\\n\"\n    + \"  cursor: not-allowed;\\n\"\n    + \"  transform: none;\\n\"\n    + \"}\\n\\n\"\n    + \"input, textarea {\\n\"\n    + \"  padding: 8px 12px;\\n\"\n    + \"  border: 1px solid #d1d5db;\\n\"\n    + \"  border-radius: 6px;\\n\"\n    + \"  font-size: 14px;\\n\"\n    + \"  transition: all 200ms ease-in-out;\\n\"\n    + \"}\\n\\n\"\n    + \"input:focus, textarea:focus {\\n\"\n    + \"  outline: 2px solid #3b82f6;\\n\"\n    + \"  outline-offset: 2px;\\n\"\n    + \"  border-color: #3b82f6;\\n\"\n    + \"  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);\\n\"\n    + \"}\\n\\n\"\n    + \".card {\\n\"\n    + \"  background-color: white;\\n\"\n    + \"  border: 1px solid #e5e7eb;\\n\"\n    + \"  border-radius: 8px;\\n\"\n    + \"  padding: 20px;\\n\"\n    + \"  box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);\\n\"\n    + \"}\\n\\n\"\n    + \".card:hover {\\n\"\n    + \"  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\\n\"\n    + \"  border-color: #d1d5db;\\n\"\n    + \"}\\n\\n\"\n    + \".badge {\\n\"\n    + \"  display: inline-block;\\