lock; } }\",\n      \"xl\": \"@media (min-width: 1280px) { .xl-block { display: block; } .xl-flex { display: flex; } .xl-grid { display: grid; } .xl-hidden { display: none; } .xl-inline { display: inline; } .xl-inline-block { display: inline-block; } }\"\n    }\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Responsive Spacing Classes (Padding)\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateResponsivePaddingClasses() -> any {\n  let spacingScale = getSpacingScale()\n  let scales = [\"0\", \"1\", \"2\", \"3\", \"4\", \"5\", \"6\", \"8\", \"10\", \"12\"]\n\n  let sm_classes = \"\"\n  let md_classes = \"\"\n  let lg_classes = \"\"\n  let xl_classes = \"\"\n\n  for scale in scales {\n    let value = spacingScale[scale]\n    sm_classes = sm_classes + \".sm-p-\\(scale) { padding: \\(value); } \"\n    sm_classes = sm_classes + \".sm-px-\\(scale) { padding-left: \\(value); padding-right: \\(value); } \"\n    sm_classes = sm_classes + \".sm-py-\\(scale) { padding-top: \\(value); padding-bottom: \\(value); } \"\n\n    md_classes = md_classes + \".md-p-\\(scale) { padding: \\(value); } \"\n    md_classes = md_classes + \".md-px-\\(scale) { padding-left: \\(value); padding-right: \\(value); } \"\n    md_classes = md_classes + \".md-py-\\(scale) { padding-top: \\(value); padding-bottom: \\(value); } \"\n\n    lg_classes = lg_classes + \".lg-p-\\(scale) { padding: \\(value); } \"\n    lg_classes = lg_classes + \".lg-px-\\(scale) { padding-left: \\(value); padding-right: \\(value); } \"\n    lg_classes = lg_classes + \".lg-py-\\(scale) { padding-top: \\(value); padding-bottom: \\(value); } \"\n\n    xl_classes = xl_classes + \".xl-p-\\(scale) { padding: \\(value); } \"\n    xl_classes = xl_classes + \".xl-px-\\(scale) { padding-left: \\(value); padding-right: \\(value); } \"\n    xl_classes = xl_classes + \".xl-py-\\(scale) { padding-top: \\(value); padding-bottom: \\(value); } \"\n  }\n\n  return {\n    \"sm\": \"@media (min-width: 640px) { \\(sm_classes) }\",\n    \"md\": \"@media (min-width: 768px) { \\(md_classes) }\",\n    \"lg\": \"@media (min-width: 1024px) { \\(lg_classes) }\",\n    \"xl\": \"@media (min-width: 1280px) { \\(xl_classes) }\"\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Responsive Spacing Classes (Margin)\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateResponsiveMarginClasses() -> any {\n  let spacingScale = getSpacingScale()\n  let scales = [\"0\", \"1\", \"2\", \"3\", \"4\", \"5\", \"6\", \"8\"]\n\n  let sm_classes = \"\"\n  let md_classes = \"\"\n  let lg_classes = \"\"\n  let xl_classes = \"\"\n\n  for scale in scales {\n    let value = spacingScale[scale]\n    sm_classes = sm_classes + \".sm-m-\\(scale) { margin: \\(value); } \"\n    sm_classes = sm_classes + \".sm-mx-\\(scale) { margin-left: \\(value); margin-right: \\(value); } \"\n    sm_classes = sm_classes + \".sm-my-\\(scale) { margin-top: \\(value); margin-bottom: \\(value); } \"\n\n    md_classes = md_classes + \".md-m-\\(scale) { margin: \\(value); } \"\n    md_classes = md_classes + \".md-mx-\\(scale) { margin-left: \\(value); margin-right: \\(value); } \"\n    md_classes = md_classes + \".md-my-\\(scale) { margin-top: \\(value); margin-bottom: \\(value); } \"\n\n    lg_classes = lg_classes + \".lg-m-\\(scale) { margin: \\(value); } \"\n    lg_classes = lg_classes + \".lg-mx-\\(scale) { margin-left: \\(value); margin-right: \\(value); } \"\n    lg_classes = lg_classes + \".lg-my-\\(scale) { margin-top: \\(value); margin-bottom: \\(value); } \"\n\n    xl_classes = xl_classes + \".xl-m-\\(scale) { margin: \\(value); } \"\n    xl_classes = xl_classes + \".xl-mx-\\(scale) { margin-left: \\(value); margin-right: \\(value); } \"\n    xl_classes = xl_classes + \".xl-my-\\(scale) { margin-top: \\(value); margin-bottom: \\(value); } \"\n  }\n\n  return {\n    \"sm\": \"@media (min-width: 640px) { \\(sm_classes) }\",\n    \"md\": \"@media (min-width: 768px) { \\(md_classes) }\",\n    \"lg\": \"@media (min-width: 1024px) { \\(lg_classes) }\",\n    \"xl\": \"@media (min-width: 1280px) { \\(xl_classes) }\"\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Responsive Font Size Classes\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateResponsiveFontSizeClasses() -> any {\n  let fontSizes = getFontSizes()\n  let sizeKeys = [\"xs\", \"sm\", \"base\", \"lg\", \"xl\", \"2xl\", \"3xl\", \"4xl\", \"5xl\"]\n\n  let sm_classes = \"\"\n  let md_classes = \"\"\n  let lg_classes = \"\"\n  let xl_classes = \"\"\n\n  for key in sizeKeys {\n    let size = fontSizes[key]\n    sm_classes = sm_classes + \".sm-text-\\(key) { font-size: \\(size); } \"\n    md_classes = md_classes + \".md-text-\\(key) { font-size: \\(size); } \"\n    lg_classes = lg_classes + \".lg-text-\\(key) { font-size: \\(size); } \"\n    xl_classes = xl_classes + \".xl-text-\\(key) { font-size: \\(size); } \"\n  }\n\n  return {\n    \"sm\": \"@media (min-width: 640px) { \\(sm_classes) }\",\n    \"md\": \"@media (min-width: 768px) { \\(md_classes) }\",\n    \"lg\": \"@media (min-width: 1024px) { \\(lg_classes) }\",\n    \"xl\": \"@media (min-width: 1280px) { \\(xl_classes) }\"\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Responsive Width & Height Classes\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateResponsiveSizeClasses() -> any {\n  let spacingScale = getSpacingScale()\n  let widths = [\"2\", \"4\", \"6\", \"8\", \"12\", \"16\"]\n\n  let sm_classes = \"\"\n  let md_classes = \"\"\n  let lg_classes = \"\"\n  let xl_classes = \"\"\n\n  // Width classes\n  for w in widths {\n    let value = spacingScale[w]\n    sm_classes = sm_classes + \".sm-w-\\(w) { width: \\(value); } \"\n    md_classes = md_classes + \".md-w-\\(w) { width: \\(value); } \"\n    lg_classes = lg_classes + \".lg-w-\\(w) { width: \\(value); } \"\n    xl_classes = xl_classes + \".xl-w-\\(w) { width: \\(value); } \"\n  }\n\n  // Height classes\n  for h in widths {\n    let value = spacingScale[h]\n    sm_classes = sm_classes + \".sm-h-\\(h) { height: \\(value); } \"\n    md_classes = md_classes + \".md-h-\\(h) { height: \\(value); } \"\n    lg_classes = lg_classes + \".lg-h-\\(h) { height: \\(value); } \"\n    xl_classes = xl_classes + \".xl-h-\\(h) { height: \\(value); } \"\n  }\n\n  return {\n    \"sm\": \"@media (min-width: 640px) { \\(sm_classes) }\",\n    \"md\": \"@media (min-width: 768px) { \\(md_classes) }\",\n    \"lg\": \"@media (min-width: 1024px) { \\(lg_classes) }\",\n    \"xl\": \"@media (min-width: 1280px) { \\(xl_classes) }\"\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Responsive Flexbox Classes\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateResponsiveFlexClasses() -> any {\n  let sm_classes = \".sm-flex-row { flex-direction: row; } \"\n    + \".sm-flex-col { flex-direction: column; } \"\n    + \".sm-flex-wrap { flex-wrap: wrap; } \"\n    + \".sm-flex-nowrap { flex-wrap: nowrap; } \"\n    + \".sm-justify-start { justify-content: flex-start; } \"\n    + \".sm-justify-center { justify-content: center; } \"\n    + \".sm-justify-end { justify-content: flex-end; } \"\n    + \".sm-justify-between { justify-content: space-between; } \"\n    + \".sm-justify-around { justify-content: space-around; } \"\n    + \".sm-items-start { align-items: flex-start; } \"\n    + \".sm-items-center { align-items: center; } \"\n    + \".sm-items-end { align-items: flex-end; } \"\n    + \".sm-gap-2 { gap: 8px; } \"\n    + \".sm-gap-4 { gap: 16px; } \"\n    + \".sm-gap-6 { gap: 24px; } \"\n\n  let md_classes = \".md-flex-row { flex-direction: row; } \"\n    + \".md-flex-col { flex-direction: column; } \"\n    + \".md-flex-wrap { flex-wrap: wrap; } \"\n    + \".md-flex-nowrap { flex-wrap: nowrap; } \"\n    + \".md-justify-start { justify-content: flex-start; } \"\n    + \".md-justify-center { justify-content: center; } \"\n    + \".md-justify-end { justify-content: flex-end; } \"\n    + \".md-justify-between { justify-content: space-between; } \"\n    + \".md-justify-around { justify-content: space-around; } \"\n    + \".md-items-start { align-items: flex-start; } \"\n    + \".md-items-center { align-items: center; } \"\n    + \".md-items-end { align-items: flex-end; } \"\n    + \".md-gap-2 { gap: 8px; } \"\n    + \".md-gap-4 { gap: 16px; } \"\n    + \".md-gap-6 { gap: 24px; } \"\n\n  let lg_classes = \".lg-flex-row { flex-direction: row; } \"\n    + \".lg-flex-col { flex-direction: column; } \"\n    + \".lg-flex-wrap { flex-wrap: wrap; } \"\n    + \".lg-flex-nowrap { flex-wrap: nowrap; } \"\n    + \".lg-justify-start { justify-content: flex-start; } \"\n    + \".lg-justify-center { justify-content: center; } \"\n    + \".lg-justify-end { justify-content: flex-end; } \"\n    + \".lg-justify-between { justify-content: space-between; } \"\n    + \".lg-justify-around { justify-content: space-around; } \"\n    + \".lg-items-start { align-items: flex-start; } \"\n    + \".lg-items-center { align-items: center; } \"\n    + \".lg-items-end { align-items: flex-end; } \"\n    + \".lg-gap-2 { gap: 8px; } \"\n    + \".lg-gap-4 { gap: 16px; } \"\n    + \".lg-gap-6 { gap: 24px; } \"\n\n  let xl_classes = \".xl-flex-row { flex-direction: row; } \"\n    + \".xl-flex-col { flex-direction: column; } \"\n    + \".xl-flex-wrap { flex-wrap: wrap; } \"\n    + \".xl-flex-nowrap { flex-wrap: nowrap; } \"\n    + \".xl-justify-start { justify-content: flex-start; } \"\n    + \".xl-justify-center { justify-content: center; } \"\n    + \".xl-justify-end { justify-content: flex-end; } \"\n    + \".xl-justify-between { justify-content: space-between; } \"\n    + \".xl-justify-around { justify-content: space-around; } \"\n    + \".xl-items-start { align-items: flex-start; } \"\n    + \".xl-items-center { align-items: center; } \"\n    + \".xl-items-end { align-items: flex-end; } \"\n    + \".xl-gap-2 { gap: 8px; } \"\n    + \".xl-gap-4 { gap: 16px; } \"\n    + \".xl-gap-6 { gap: 24px; } \"\n\n  return {\n    \"sm\": \"@media (min-width: 640px) { \\(sm_classes) }\",\n    \"md\": \"@media (min-width: 768px) { \\(md_classes) }\",\n    \"lg\": \"@media (min-width: 1024px) { \\(lg_classes) }\",\n    \"xl\": \"@media (min-width: 1280px) { \\(xl_classes) }\"\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Responsive Grid Classes\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateResponsiveGridClasses() -> any {\n  let sm_classes = \".sm-grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); } \"\n    + \".sm-grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } \"\n    + \".sm-grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } \"\n    + \".sm-grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } \"\n    + \".sm-gap-2 { gap: 8px; } \"\n    + \".sm-gap-4 { gap: 16px; } \"\n    + \".sm-gap-6 { gap: 24px; } \"\n\n  let md_classes = \".md-grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); } \"\n    + \".md-grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } \"\n    + \".md-grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } \"\n    + \".md-grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } \"\n    + \".md-gap-2 { gap: 8px; } \"\n    + \".md-gap-4 { gap: 16px; } \"\n    + \".md-gap-6 { gap: 24px; } \"\n\n  let lg_classes = \".lg-grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); } \"\n    + \".lg-grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } \"\n    + \".lg-grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } \"\n    + \".lg-grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } \"\n    + \".lg-gap-2 { gap: 8px; } \"\n    + \".lg-gap-4 { gap: 16px; } \"\n    + \".lg-gap-6 { gap: 24px; } \"\n\n  let xl_classes = \".xl-grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); } \"\n    + \".xl-grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } \"\n    + \".xl-grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } \"\n    + \".xl-grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } \"\n    + \".xl-gap-2 { gap: 8px; } \"\n    + \".xl-gap-4 { gap: 16px; } \"\n    + \".xl-gap-6 { gap: 24px; } \"\n\n  return {\n    \"sm\": \"@media (min-width: 640px) { \\(sm_classes) }\",\n    \"md\": \"@media (min-width: 768px) { \\(md_classes) }\",\n    \"lg\": \"@media (min-width: 1024px) { \\(lg_classes) }\",\n    \"xl\": \"@media (min-width: 1280px) { \\(xl_classes) }\"\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Responsive Text Alignment & Decoration\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateResponsiveTextClasses() -> any {\n  let sm_classes = \".sm-text-left { text-align: left; } \"\n    + \".sm-text-center { text-align: center; } \"\n    + \".sm-text-right { text-align: right; } \"\n    + \".sm-text-justify { text-align: justify; } \"\n    + \".sm-font-bold { font-weight: 700; } \"\n    + \".sm-font-normal { font-weight: 400; } \"\n    + \".sm-italic { font-style: italic; } \"\n    + \".sm-not-italic { font-style: normal; } \"\n    + \".sm-underline { text-decoration: underline; } \"\n\n  let md_classes = \".md-text-left { text-align: left; } \"\n    + \".md-text-center { text-align: center; } \"\n    + \".md-text-right { text-align: right; } \"\n    + \".md-text-justify { text-align: justify; } \"\n    + \".md-font-bold { font-weight: 700; } \"\n    + \".md-font-normal { font-weight: 400; } \"\n    + \".md-italic { font-style: italic; } \"\n    + \".md-not-italic { font-style: normal; } \"\n    + \".md-underline { text-decoration: underline; } \"\n\n  let lg_classes = \".lg-text-left { text-align: left; } \"\n    + \".lg-text-center { text-align: center; } \"\n    + \".lg-text-right { text-align: right; } \"\n    + \".lg-text-justify { text-align: justify; } \"\n    + \".lg-font-bold { font-weight: 700; } \"\n    + \".lg-font-normal { font-weight: 400; } \"\n    + \".lg-italic { font-style: italic; } \"\n    + \".lg-not-italic { font-style: normal; } \"\n    + \".lg-underline { text-decoration: underline; } \"\n\n  let xl_classes = \".xl-text-left { text-align: left; } \"\n    + \".xl-text-center { text-align: center; } \"\n    + \".xl-text-right { text-align: right; } \"\n    + \".xl-text-justify { text-align: justify; } \"\n    + \".xl-font-bold { font-weight: 700; } \"\n    + \".xl-font-normal { font-weight: 400; } \"\n    + \".xl-italic { font-style: italic; } \"\n    + \".xl-not-italic { font-style: normal; } \"\n    + \".xl-underline { text-decoration: underline; } \"\n\n  return {\n    \"sm\": \"@media (min-width: 640px) { \\(sm_classes) }\",\n    \"md\": \"@media (min-width: 768px) { \\(md_classes) }\",\n    \"lg\": \"@media (min-width: 1024px) { \\(lg_classes) }\",\n    \"xl\": \"@media (min-width: 1280px) { \\(xl_classes) }\"\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Responsive Border & Radius Classes\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateResponsiveBorderClasses() -> any {\n  let borderRadius = getBorderRadius()\n  let radiusKeys = [\"sm\", \"default\", \"md\", \"lg\", \"xl\", \"2xl\", \"3xl\"]\n\n  let sm_classes = \"\"\n  let md_classes = \"\"\n  let lg_classes = \"\"\n  let xl_classes = \"\"\n\n  for key in radiusKeys {\n    let radius = borderRadius[key]\n    sm_classes = sm_classes + \".sm-rounded-\\(key) { border-radius: \\(radius); } \"\n    md_classes = md_classes + \".md-rounded-\\(key) { border-radius: \\(radius); } \"\n    lg_classes = lg_classes + \".lg-rounded-\\(key) { border-radius: \\(radius); } \"\n    xl_classes = xl_classes + \".xl-rounded-\\(key) { border-radius: \\(radius); } \"\n  }\n\n  return {\n    \"sm\": \"@media (min-width: 640px) { \\(sm_classes) }\",\n    \"md\": \"@media (min-width: 768px) { \\(md_classes) }\",\n    \"lg\": \"@media (min-width: 1024px) { \\(lg_classes) }\",\n    \"xl\": \"@media (min-width: 1280px) { \\(xl_classes) }\"\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 모든 반응형 클래스 통합\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateAllResponsiveClasses() -> any {\n  let displayClasses = generateResponsiveDisplayClasses()\n  let paddingClasses = generateResponsivePaddingClasses()\n  let marginClasses = generateResponsiveMarginClasses()\n  let fontClasses = generateResponsiveFontSizeClasses()\n  let sizeClasses = generateResponsiveSizeClasses()\n  let flexClasses = generateResponsiveFlexClasses()\n  let gridClasses = generateResponsiveGridClasses()\n  let textClasses = generateResponsiveTextClasses()\n  let borderClasses = generateResponsiveBorderClasses()\n\n  let cssOutput = \"\"\n    + displayClasses[\"sm\"] + \"\\n\"\n    + displayClasses[\"md\"] + \"\\n\"\n    + displayClasses[\"lg\"] + \"\\n\"\n    + displayClasses[\"xl\"] + \"\\n\"\n    + paddingClasses[\"sm\"] + \"\\n\"\n    + paddingClasses[\"md\"] + \"\\n\"\n    + paddingClasses[\"lg\"] + \"\\n\"\n    + paddingClasses[\"xl\"] + \"\\n\"\n    + marginClasses[\"sm\"] + \"\\n\"\n    + marginClasses[\"md\"] + \"\\n\"\n    + marginClasses[\"lg\"] + \"\\n\"\n    + marginClasses[\"xl\"] + \"\\n\"\n    + fontClasses[\"sm\"] + \"\\n\"\n    + fontClasses[\"md\"] + \"\\n\"\n    + fontClasses[\"lg\"] + \"\\n\"\n    + fontClasses[\"xl\"] + \"\\n\"\n    + sizeClasses[\"sm\"] + \"\\n\"\n    + sizeClasses[\"md\"] + \"\\n\"\n    + sizeClasses[\"lg\"] + \"\\n\"\n    + sizeClasses[\"xl\"] + \"\\n\"\n    + flexClasses[\"sm\"] + \"\\n\"\n    + flexClasses[\"md\"] + \"\\n\"\n    + flexClasses[\"lg\"] + \"\\n\"\n    + flexClasses[\"xl\"] + \"\\n\"\n    + gridClasses[\"sm\"] + \"\\n\"\n    + gridClasses[\"md\"] + \"\\n\"\n    + gridClasses[\"lg\"] + \"\\n\"\n    + gridClasses[\"xl\"] + \"\\n\"\n    + textClasses[\"sm\"] + \"\\n\"\n    + textClasses[\"md\"] + \"\\n\"\n    + textClasses[\"lg\"] + \"\\n\"\n    + textClasses[\"xl\"] + \"\\n\"\n    + borderClasses[\"sm\"] + \"\\n\"\n    + borderClasses[\"md\"] + \"\\n\"\n    + borderClasses[\"lg\"] + \"\\n\"\n    + borderClasses[\"xl\"] + \"\\n\"\n\n  return {\n    \"css\": cssOutput,\n    \"breakpoints\": {\n      \"sm\": \"640px\",\n      \"md\": \"768px\",\n      \"lg\": \"1024px\",\n      \"xl\": \"1280px\"\n    }\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 반응형 클래스 추출 (HTML에서 사용된 클래스만 선별)\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc extractResponsiveClasses(className: String) -> any {\n  let classArray = className.split(\" \")\n  let responsiveClasses = []\n\n  for cls in classArray {\n    if cls.startsWith(\"sm-\") || cls.startsWith(\"md-\") || cls.startsWith(\"lg-\") || cls.startsWith(\"xl-\") {\n      responsiveClasses.append(cls)\n    }\n  }\n\n  return responsiveClasses\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Export\n// ──────────────────────────────────────────────────────────────────────────\n\nexport {\n  generateResponsiveDisplayClasses,\n  generateResponsivePaddingClasses,\n  generateResponsiveMarginClasses,\n  generateResponsiveFontSizeClasses,\n  generateResponsiveSizeClasses,\n  generateResponsiveFlexClasses,\n  generateResponsiveGridClasses,\n  generateResponsiveTextClasses,\n  generateResponsiveBorderClasses,\n  generateAllResponsiveClasses,\n  extractResponsiveClasses\n}\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"b36a5941-24db-4b77-a37a-d8ef71302dd