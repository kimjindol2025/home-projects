ibs.length).toBeGreaterThanOrEqual(2);\n    });\n\n    test('registers library with multiple functions', () => {\n      ffi.registerLibrary('m', '/usr/lib/libm.so', [\n        'double sqrt(double x)',\n        'double sin(double x)',\n        'double cos(double x)',\n      ]);\n\n      const lib = ffi.getLibrary('m');\n      expect(lib?.bindings.size).toBe(3);\n    });\n\n    test('handles invalid library path gracefully', () => {\n      const lib = ffi.registerLibrary(\n        'invalid',\n        '/nonexistent/lib/invalid.so',\n        ['int func()']\n      );\n      expect(lib).toBeNull();\n    });\n\n    test('reports errors when library not found', () => {\n      ffi.registerLibrary('invalid', '/nonexistent/lib.so', []);\n      const errors = ffi.getErrors();\n      expect(errors.length).toBeGreaterThan(0);\n    });\n  });\n\n  // ───── Function Calling Tests (8) ─────\n\n  describe('Function Calling', () => {\n    beforeEach(() => {\n      ffi.registerLibrary('m', '/usr/lib/libm.so', [\n        'double sqrt(double x)',\n        'int add(int a, int b)',\n      ]);\n    });\n\n    test('calls registered function', () => {\n      const result = ffi.callFunction('m', 'sqrt', 4.0);","numLines":100,"startLine":1,"totalLines":367}},"sourceToolAssistantUUID":"0f46ca34-24bd-46c1-ac4e-aa0630b86519","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
