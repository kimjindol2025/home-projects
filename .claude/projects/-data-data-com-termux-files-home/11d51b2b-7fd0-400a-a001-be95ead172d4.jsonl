{"parentUuid":"72bd7a75-fd13-4492-b2ba-011da84b4908","isSidechain":false,"message":{"model":"claude-haiku-4-5-20251001","id":"msg_019Myiop45oPkNrnnD1ymx3Q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TnLMm1kN9Q9mHfvh4wVVAv","name":"Write","input":{"file_path":"/data/data/com.termux/files/home/freelang-hybrid/freelang/db/storage.free","content":"// ============================================================================\n// FreeLang Database: 파일 기반 저장소 (JSON)\n// 메모리 → 디스크 영속성\n// ============================================================================\n\nuse \"..shared/types\"\n\n// ──────────────────────────────────────────────────────────────────────────\n// DB 파일 경로\n// ──────────────────────────────────────────────────────────────────────────\n\nconst DB_FILE = \"data/db.json\"\nconst BACKUP_DIR = \"data/backups\"\n\n// ──────────────────────────────────────────────────────────────────────────\n// DB 스키마\n// ──────────────────────────────────────────────────────────────────────────\n\nrecord DatabaseSchema {\n  counter: Counter\n  todos: array<Todo>\n  blogs: array<Blog>\n  metadata: record {\n    version: string\n    lastSaved: timestamp\n    totalBlogs: number\n    totalTodos: number\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 초기화\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc initializeDatabase() {\n  // 데이터 디렉토리 생성\n  if !directoryExists(\"data\") {\n    createDirectory(\"data\")\n  }\n\n  if !directoryExists(BACKUP_DIR) {\n    createDirectory(BACKUP_DIR)\n  }\n\n  // DB 파일 초기화\n  if !fileExists(DB_FILE) {\n    let initialDb = {\n      counter: {\n        id: \"main\",\n        count: 0,\n        name: \"Main Counter\",\n        createdAt: now(),\n        updatedAt: now()\n      },\n      todos: [],\n      blogs: [],\n      metadata: {\n        version: \"1.0\",\n        lastSaved: now(),\n        totalBlogs: 0,\n        totalTodos: 0\n      }\n    }\n\n    saveToFile(DB_FILE, serializeToJson(initialDb))\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 저장 함수\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc saveDatabase(counter: Counter, todos: array<Todo>, blogs: array<Blog>) {\n  let dbData = {\n    counter: counter,\n    todos: todos,\n    blogs: blogs,\n    metadata: {\n      version: \"1.0\",\n      lastSaved: now(),\n      totalBlogs: blogs.length,\n      totalTodos: todos.length\n    }\n  }\n\n  // JSON 직렬화\n  let jsonString = serializeToJson(dbData)\n\n  // 백업 생성 (선택사항)\n  if shouldCreateBackup() {\n    createBackup()\n  }\n\n  // 파일 저장\n  saveToFile(DB_FILE, jsonString)\n\n  println(\"💾 데이터베이스 저장됨 (Blogs: \\(blogs.length), Todos: \\(todos.length))\")\n}\n\nfunc loadDatabase() -> DatabaseSchema {\n  initializeDatabase()\n\n  if fileExists(DB_FILE) {\n    let content = readFromFile(DB_FILE)\n    let dbData = deserializeFromJson(content)\n    return dbData\n  }\n\n  // 폴백: 빈 DB 반환\n  return {\n    counter: {id: \"main\", count: 0, name: \"Main Counter\", createdAt: now(), updatedAt: now()},\n    todos: [],\n    blogs: [],\n    metadata: {version: \"1.0\", lastSaved: now(), totalBlogs: 0, totalTodos: 0}\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 백업 관리\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc shouldCreateBackup() -> bool {\n  // 5번 저장마다 백업\n  let fileSize = getFileSize(DB_FILE)\n  return fileSize > 1024  // 1KB 이상이면 백업\n}\n\nfunc createBackup() {\n  let timestamp = formatTimestamp(now())\n  let backupFile = \"\\(BACKUP_DIR)/db-\\(timestamp).json\"\n\n  if fileExists(DB_FILE) {\n    copyFile(DB_FILE, backupFile)\n    cleanupOldBackups()\n  }\n}\n\nfunc cleanupOldBackups() {\n  // 최근 10개 백업만 유지\n  let backupFiles = listFiles(BACKUP_DIR)\n  if backupFiles.length > 10 {\n    for i in 0..(backupFiles.length - 10) {\n      deleteFile(\"\\(BACKUP_DIR)/\\(backupFiles[i])\")\n    }\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 직렬화/역직렬화 (간단한 버전)\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc serializeToJson(data: any) -> string {\n  // 실제 JSON 직렬화 (간단한 구현)\n  return jsonStringify(data)\n}\n\nfunc deserializeFromJson(jsonString: string) -> any {\n  // 실제 JSON 파싱 (간단한 구현)\n  return jsonParse(jsonString)\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 파일 시스템 래퍼\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc fileExists(path: string) -> bool {\n  // 내장 함수\n  return fs.exists(path)\n}\n\nfunc directoryExists(path: string) -> bool {\n  return fs.isDirectory(path)\n}\n\nfunc createDirectory(path: string) {\n  fs.mkdir(path)\n}\n\nfunc readFromFile(path: string) -> string {\n  return fs.readFile(path, \"utf-8\")\n}\n\nfunc saveToFile(path: string, content: string) {\n  fs.writeFile(path, content, \"utf-8\")\n}\n\nfunc copyFile(from: string, to: string) {\n  fs.copyFile(from, to)\n}\n\nfunc deleteFile(path: string) {\n  fs.unlink(path)\n}\n\nfunc getFileSize(path: string) -> number {\n  return fs.statSync(path).size\n}\n\nfunc listFiles(path: string) -> array<string> {\n  return fs.readdirSync(path)\n}\n\nfunc formatTimestamp(ts: timestamp) -> string {\n  // ISO 8601 형식: 2026-03-12T14-30-45\n  return ts.toISOString().replace(/[:.]/g, \"-\").substring(0, 19)\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 내보내기\n// ──────────────────────────────────────────────────────────────────────────\n\nexport {\n  initializeDatabase,\n  loadDatabase,\n  saveDatabase,\n  createBackup,\n  cleanupOldBackups,\n  DB_FILE\n}\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":601,"cache_read_input_tokens":135985,"output_tokens":2037,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":601,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"}},"requestId":"req_011CYyEoqWNE9CgEPsKQ5hHA","type":"assistant","uuid":"98c7e5f1-3748-45f2-aa07-4122babe1573","timestamp":"2026-03-12T13:08:45.015Z","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
