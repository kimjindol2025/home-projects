    new GraphQLType('String', {}, { isScalar: true, description: 'String value' }),\n      new GraphQLType('Boolean', {}, { isScalar: true, description: 'Boolean value' }),\n      new GraphQLType('ID', {}, { isScalar: true, description: 'Unique identifier' }),\n      new GraphQLType('DateTime', {}, { isScalar: true, description: 'ISO 8601 DateTime' })\n    ];\n    scalars.forEach(scalar => this.types.set(scalar.name, scalar));\n  }\n\n  registerType(type) {\n    this.types.set(type.name, type);\n  }\n\n  getType(name) {\n    return this.types.get(name);\n  }\n\n  getQueryType() {\n    return this.queryType;\n  }\n\n  getMutationType() {\n    return this.mutationType;\n  }\n\n  getSubscriptionType() {\n    return this.subscriptionType;\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// GraphQL Query Parser & Executor\n// ──────────────────────────────────────────────────────────────────────────\n\nclass GraphQLExecutor {\n  constructor(schema, resolvers = {}) {\n    this.schema = schema;\n    this.resolvers = resolvers;\n    this.queryCache = new Map();\n    this.subscriptions = new Map();\n    this.metrics = {\n      totalQueries: 0,\n      totalMutations: 0,\n      totalSubscriptions: 0,\n      executionTimes: [],\n      cacheHits: 0,\n      cacheMisses: 0\n    };\n  }\n\n  // 간단한 쿼리 파서 (실제로는 graphql-core 같은 라이브러리 사용)\n  parseQuery(queryString) {\n    const lines = queryString.trim().split('\\n').filter(l => l.trim());\n    const operationType = lines[0].split(' ')[0].toLowerCase();\n\n    return {\n      type: operationType,\n      raw: queryString,\n      hash: this.hashQuery(queryString)\n    };\n  }\n\n  hashQuery(query) {\n    const crypto = require('crypto');\n    return crypto.createHash('md5').update(query).digest('hex');\n  }\n\n  async execute(query, variables = {}) {\n    const startTime = Date.now();\n    const parsed = this.parseQuery(query);\n\n    // 캐시 확인\n    const cacheKey = parsed.hash + JSON.stringify(variables);\n    if (this.queryCache.has(cacheKey)) {\n      this.metrics.cacheHits++;\n      return this.queryCache.get(cacheKey);\n    }\n\n    this.metrics.cacheMisses++;\n\n    try {\n      let result;\n\n      switch (parsed.type) {\n        case 'query':\n          result = await this.executeQuery(query, variables);\n          this.metrics.totalQueries++;\n          break;\n\n        case 'mutation':\n          result = await this.executeMutation(query, variables);\n          this.metrics.totalMutations++;\n          break;\n\n        case 'subscription':\n          result = this.executeSubscription(query, variables);\n          this.metrics.totalSubscriptions++;\n          break;\n\n        default:\n          throw new Error(`Unknown operation type: ${parsed.type}`);\n      }\n\n      // 결과 캐싱 (5분 TTL)\n      this.queryCache.set(cacheKey, result);\n      setTimeout(() => this.queryCache.delete(cacheKey), 300000);\n\n      const executionTime = Date.now() - startTime;\n      this.metrics.executionTimes.push(executionTime);\n      if (this.metrics.executionTimes.length > 1000) {\n        this.metrics.executionTimes.shift();\n      }\n\n      return result;\n\n    } catch (err) {\n      return {\n        errors: [{ message: err.message, query }],\n        data: null\n      };\n    }\n  }\n\n  async executeQuery(query, variables) {\n    // 쿼리 실행 (간단한 시뮬레이션)\n    const resolver = this.resolvers.Query || {};\n\n    return {\n      data: await resolver(variables),\n      errors: [],\n      extensions: {\n        executedAt: new Date().toISOString()\n      }\n    };\n  }\n\n  async executeMutation(mutation, variables) {\n    // 뮤테이션 실행\n    const resolver = this.resolvers.Mutation || {};\n\n    return {\n      data: await resolver(variables),\n      errors: [],\n      extensions: {\n        mutatedAt: new Date().toISOString()\n      }\n    };\n  }\n\n  executeSubscription(subscription, variables) {\n    // 구독 설정\n    const subscriptionId = this.generateSubscriptionId();\n\n    const resolver = this.resolvers.Subscription || {};\n    const unsubscribe = resolver(variables, (data) => {\n      const sub = this.subscriptions.get(subscriptionId);\n      if (sub) {\n        sub.callback({ data, subscriptionId });\n      }\n    });\n\n    this.subscriptions.set(subscriptionId, {\n      subscription,\n      variables,\n      unsubscribe,\n      createdAt: Date.now()\n    });\n\n    return {\n      subscriptionId,\n      message: 'Subscription established'\n    };\n  }\n\n  unsubscribe(subscriptionId) {\n    const sub = this.subscriptions.get(subscriptionId);\n    if (sub) {\n      sub.unsubscribe();\n      this.subscriptions.delete(subscriptionId);\n      return true;\n    }\n    return false;\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Metrics & Analytics\n  // ──────────────────────────────────────────────────────────────────────────\n\n  getMetrics() {\n    const times = this.metrics.executionTimes;\n    const sorted = [...times].sort((a, b) => a - b);\n    const getPercentile = (arr, p) => {\n      const idx = Math.ceil((p / 100) * arr.length) - 1;\n      return arr[Math.max(0, idx)] || 0;\n    };\n\n    const cacheHitRate = this.metrics.cacheHits + this.metrics.cacheMisses > 0 ?\n      ((this.metrics.cacheHits / (this.metrics.cacheHits + this.metrics.cacheMisses)) * 100).toFixed(2) : 0;\n\n    return {\n      timestamp: Date.now(),\n      queries: this.metrics.totalQueries,\n      mutations: this.metrics.totalMutations,\n      subscriptions: this.metrics.totalSubscriptions,\n      activeSubscriptions: this.subscriptions.size,\n      execution: {\n        avg: times.length > 0 ?\n          (times.reduce((a, b) => a + b, 0) / times.length).toFixed(2) : 0,\n        min: times.length > 0 ? Math.min(...times) : 0,\n        max: times.length > 0 ? Math.max(...times) : 0,\n        p50: getPercentile(sorted, 50),\n        p95: getPercentile(sorted, 95),\n        p99: getPercentile(sorted, 99)\n      },\n      cache: {\n        hits: this.metrics.cacheHits,\n        misses: this.metrics.cacheMisses,\n        hitRate: `${cacheHitRate}%`,\n        size: this.queryCache.size\n      }\n    };\n  }\n\n  generateSubscriptionId() {\n    return 'sub_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// GraphQL Server (Express middleware)\n// ──────────────────────────────────────────────────────────────────────────\n\nclass GraphQLServer extends EventEmitter {\n  constructor(options = {}) {\n    super();\n    this.schema = options.schema;\n    this.resolvers = options.resolvers || {};\n    this.executor = new GraphQLExecutor(this.schema, this.resolvers);\n    this.context = options.context || {};\n  }\n\n  // Express 미들웨어\n  middleware() {\n    return async (req, res, next) => {\n      if (req.method === 'POST' && req.path === '/graphql') {\n        try {\n          const { query, variables, operationName } = req.body;\n\n          if (!query) {\n            return res.status(400).json({ errors: [{ message: 'No query provided' }] });\n          }\n\n          const result = await this.executor.execute(query, variables);\n\n          res.json(result);\n        } catch (err) {\n          res.status(500).json({\n            errors: [{ message: err.message }]\n          });\n        }\n      } else {\n        next();\n      }\n    };\n  }\n\n  // GraphQL 쿼리 실행 (직접 호출용)\n  async query(query, variables = {}) {\n    return this.executor.execute(query, variables);\n  }\n\n  // GraphQL 뮤테이션 실행\n  async mutate(mutation, variables = {}) {\n    return this.executor.execute(mutation, variables);\n  }\n\n  // GraphQL 구독 설정\n  subscribe(subscription, variables = {}, callback) {\n    const result = this.executor.executeSubscription(subscription, variables);\n    const sub = this.executor.subscriptions.get(result.subscriptionId);\n    if (sub) {\n      sub.callback = callback;\n    }\n    return result.subscriptionId;\n  }\n\n  // 구독 취소\n  unsubscribe(subscriptionId) {\n    return this.executor.unsubscribe(subscriptionId);\n  }\n\n  // 스키마 조회\n  getSchema() {\n    return this.schema;\n  }\n\n  // 타입 조회 (Introspection)\n  introspect() {\n    return {\n      types: Array.from(this.schema.types.values()).map(type => ({\n        name: type.name,\n        description: type.description,\n        fields: type.fields,\n        isScalar: type.isScalar\n      })),\n      queryType: this.schema.queryType?.name,\n      mutationType: this.schema.mutationType?.name,\n      subscriptionType: this.schema.subscriptionType?.name\n    };\n  }\n\n  // 메트릭 조회\n  getMetrics() {\n    return this.executor.getMetrics();\n  }\n\n  // 구독 목록 조회\n  getSubscriptions() {\n    return Array.from(this.executor.subscriptions.entries()).map(([id, sub]) => ({\n      subscriptionId: id,\n      subscription: sub.subscription.substring(0, 100),\n      variables: sub.variables,\n      createdAt: sub.createdAt,\n      age: Date.now() - sub.createdAt\n    }));\n  }\n}\n\n// Export\nmodule.exports = {\n  GraphQLType,\n  GraphQLSchema,\n  GraphQLExecutor,\n  GraphQLServer,\n  createGraphQLServer: (options) => new GraphQLServer(options)\n};\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":3968,"cache_read_input_tokens":124485,"output_tokens":3469,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3968,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"}},"requestId":"req_011CYzTBxEwCLZeNucLFZbKK","type":"assistant","uuid":"2dc71cd9-7b45-45e1-b4ac-b548a177e76b","timestamp":"2026-03-13T04:31:51.931Z","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrf