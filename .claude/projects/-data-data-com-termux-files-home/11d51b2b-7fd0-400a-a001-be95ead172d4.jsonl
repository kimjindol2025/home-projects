{"parentUuid":"2162f799-a373-43a5-b1e3-bef0344cbf6e","isSidechain":false,"message":{"model":"claude-haiku-4-5-20251001","id":"msg_012ziPEC7wWY1XY3rG5zprHX","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Nuzi7VtyF5mysxZYLtbXmn","name":"Write","input":{"file_path":"/data/data/com.termux/files/home/freelang-light/src/indexer.js","content":"/**\n * FreeLang Light Indexer\n * .free 파일들을 파싱해서 검색 인덱스 생성\n */\n\nconst fs = require('fs');\nconst path = require('path');\nconst { parseFreeLang } = require('./parser');\n\nclass FreeLangIndexer {\n  constructor() {\n    this.index = [];\n    this.components = [];\n  }\n\n  /**\n   * 디렉토리의 모든 .free 파일 인덱싱\n   */\n  indexDirectory(dirPath) {\n    console.log(`📂 Indexing directory: ${dirPath}`);\n\n    const files = this.findFreeLangFiles(dirPath);\n    console.log(`📄 Found ${files.length} .free files`);\n\n    files.forEach(file => {\n      try {\n        this.indexFile(file);\n      } catch (error) {\n        console.error(`❌ Error indexing ${file}: ${error.message}`);\n      }\n    });\n\n    console.log(`✅ Indexed ${this.components.length} components`);\n    return this.index;\n  }\n\n  /**\n   * 단일 .free 파일 인덱싱\n   */\n  indexFile(filePath) {\n    const content = fs.readFileSync(filePath, 'utf-8');\n    const ast = parseFreeLang(content);\n\n    const indexEntry = {\n      file: filePath,\n      component: ast.name,\n      type: 'component',\n      props: ast.props.properties.map(p => ({\n        name: p.name,\n        type: p.type\n      })),\n      functions: ast.script.functions.map(f => ({\n        name: f.name,\n        params: f.params\n      })),\n      styles: this.extractStyleSelectors(ast.style.content),\n      markup: this.extractMarkupElements(ast.markup.content),\n      searchable_text: this.generateSearchableText(ast),\n      file_size: content.length,\n      indexed_at: new Date().toISOString(),\n      ranking: 0\n    };\n\n    // 랭킹 계산\n    indexEntry.ranking = this.calculateRanking(indexEntry);\n\n    this.index.push(indexEntry);\n    this.components.push(ast.name);\n  }\n\n  /**\n   * CSS 선택자 추출\n   */\n  extractStyleSelectors(styleContent) {\n    const selectors = [];\n    const regex = /\\.([a-zA-Z0-9_-]+)|#([a-zA-Z0-9_-]+)|@media/g;\n    let match;\n\n    while ((match = regex.exec(styleContent)) !== null) {\n      if (match[1]) selectors.push(`.${match[1]}`);\n      if (match[2]) selectors.push(`#${match[2]}`);\n    }\n\n    return [...new Set(selectors)]; // 중복 제거\n  }\n\n  /**\n   * HTML 요소 추출\n   */\n  extractMarkupElements(markupContent) {\n    const elements = [];\n    const regex = /<([a-zA-Z][a-zA-Z0-9]*)/g;\n    let match;\n\n    while ((match = regex.exec(markupContent)) !== null) {\n      elements.push(match[1]);\n    }\n\n    return [...new Set(elements)];\n  }\n\n  /**\n   * 검색 가능한 텍스트 생성\n   */\n  generateSearchableText(ast) {\n    const parts = [\n      ast.name,\n      ...ast.props.properties.map(p => p.name),\n      ...ast.script.functions.map(f => f.name),\n      ...this.extractStyleSelectors(ast.style.content),\n      ...this.extractMarkupElements(ast.markup.content)\n    ];\n\n    return parts.join(' ').toLowerCase();\n  }\n\n  /**\n   * 검색 랭킹 계산\n   */\n  calculateRanking(entry) {\n    let score = 0;\n\n    // Props 개수 (더 많으면 더 복잡)\n    score += entry.props.length * 5;\n\n    // 함수 개수\n    score += entry.functions.length * 10;\n\n    // 스타일 선택자 개수\n    score += entry.styles.length * 3;\n\n    // 마크업 요소 개수\n    score += entry.markup.length * 2;\n\n    // 파일 크기\n    score += Math.floor(entry.file_size / 100);\n\n    return score;\n  }\n\n  /**\n   * .free 파일 찾기\n   */\n  findFreeLangFiles(dirPath) {\n    const files = [];\n\n    const traverse = (currentPath) => {\n      const entries = fs.readdirSync(currentPath, { withFileTypes: true });\n\n      entries.forEach(entry => {\n        const fullPath = path.join(currentPath, entry.name);\n\n        if (entry.isDirectory() && !entry.name.startsWith('.')) {\n          traverse(fullPath);\n        } else if (entry.isFile() && entry.name.endsWith('.free')) {\n          files.push(fullPath);\n        }\n      });\n    };\n\n    traverse(dirPath);\n    return files;\n  }\n\n  /**\n   * 검색\n   */\n  search(query) {\n    const q = query.toLowerCase();\n\n    const results = this.index\n      .filter(entry => {\n        // 컴포넌트 이름 매칭\n        if (entry.component.toLowerCase().includes(q)) return true;\n\n        // Props 매칭\n        if (entry.props.some(p => p.name.toLowerCase().includes(q))) return true;\n\n        // 함수 매칭\n        if (entry.functions.some(f => f.name.toLowerCase().includes(q))) return true;\n\n        // 스타일 선택자 매칭\n        if (entry.styles.some(s => s.toLowerCase().includes(q))) return true;\n\n        // 전체 검색 텍스트 매칭\n        if (entry.searchable_text.includes(q)) return true;\n\n        return false;\n      })\n      .map(entry => ({\n        component: entry.component,\n        file: entry.file,\n        type: 'component',\n        props: entry.props.length,\n        functions: entry.functions.length,\n        styles: entry.styles.length,\n        ranking: entry.ranking,\n        match_fields: this.getMatchFields(entry, q)\n      }))\n      .sort((a, b) => b.ranking - a.ranking);\n\n    return {\n      query,\n      total_results: results.length,\n      results\n    };\n  }\n\n  /**\n   * 매칭된 필드 반환\n   */\n  getMatchFields(entry, query) {\n    const q = query.toLowerCase();\n    const fields = [];\n\n    if (entry.component.toLowerCase().includes(q)) fields.push('component');\n    if (entry.props.some(p => p.name.toLowerCase().includes(q))) fields.push('props');\n    if (entry.functions.some(f => f.name.toLowerCase().includes(q))) fields.push('functions');\n    if (entry.styles.some(s => s.toLowerCase().includes(q))) fields.push('styles');\n\n    return fields;\n  }\n\n  /**\n   * 인덱스를 파일로 저장\n   */\n  saveIndex(outputFile) {\n    const data = {\n      version: '1.0',\n      created_at: new Date().toISOString(),\n      total_components: this.components.length,\n      total_indexed_items: this.index.length,\n      components: this.components,\n      index: this.index\n    };\n\n    fs.writeFileSync(outputFile, JSON.stringify(data, null, 2));\n    console.log(`✅ Index saved to ${outputFile}`);\n    return data;\n  }\n\n  /**\n   * 인덱스 로드\n   */\n  loadIndex(inputFile) {\n    const data = JSON.parse(fs.readFileSync(inputFile, 'utf-8'));\n    this.index = data.index;\n    this.components = data.components;\n    console.log(`✅ Loaded ${data.total_components} components from ${inputFile}`);\n    return data;\n  }\n\n  /**\n   * 통계 반환\n   */\n  getStats() {\n    return {\n      total_components: this.components.length,\n      total_indexed_items: this.index.length,\n      total_props: this.index.reduce((sum, e) => sum + e.props.length, 0),\n      total_functions: this.index.reduce((sum, e) => sum + e.functions.length, 0),\n      total_styles: this.index.reduce((sum, e) => sum + e.styles.length, 0),\n      avg_file_size: Math.floor(this.index.reduce((sum, e) => sum + e.file_size, 0) / this.index.length)\n    };\n  }\n}\n\nmodule.exports = { FreeLangIndexer };\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":183,"cache_read_input_tokens":106551,"output_tokens":2650,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":183,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"}},"requestId":"req_011CYxmajYS3B9xieCSpqKR1","type":"assistant","uuid":"14564bb6-9087-4f81-bb13-b06419612d95","timestamp":"2026-03-12T07:11:45.724Z","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-light","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
