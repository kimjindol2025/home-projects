인드 완료\")\n\n  // 4️⃣ 리슨 시작\n  println(\"📍 리슨 시작 (backlog=128)\")\n  let listenResult = net.listen(server.socket, 128)\n\n  if listenResult != 0 {\n    println(\"❌ 리슨 실패\")\n    net.close(server.socket)\n    return\n  }\n  println(\"✅ 리슨 시작됨, 클라이언트 대기 중...\")\n  println(\"\")\n\n  // 5️⃣ 메인 수락 루프\n  while server.running {\n    // 클라이언트 연결 수락\n    let (clientFd, clientHost, clientPort) = net.accept(server.socket)\n\n    if clientFd < 0 {\n      // 타임아웃 또는 에러\n      continue\n    }\n\n    // 6️⃣ HTTP 요청 읽기\n    let (readOk, rawRequest) = net.read(clientFd, 4096)\n\n    if !readOk || rawRequest.isEmpty() {\n      net.close(clientFd)\n      continue\n    }\n\n    server.requestCount = server.requestCount + 1\n\n    // 7️⃣ HTTP 요청 파싱\n    let (method, path, headers, body) = parseHTTPRequest(rawRequest)\n\n    println(\"📨 요청 #\" + i32ToString(server.requestCount) + \": \" + method + \" \" + path + \" (from \" + clientHost + \":\" + i32ToString(clientPort) + \")\")\n\n    // 8️⃣ 요청 처리 (파일 서빙)\n    let (statusCode, contentType, responseBody) = serveStaticFile(path)\n\n    // 9️⃣ HTTP 응답 생성\n    let httpResponse = buildHTTPResponse(statusCode, contentType, responseBody)\n\n    // 🔟 응답 전송\n    let writeOk = net.write(clientFd, httpResponse)\n\n    if writeOk {\n      println(\"✅ 응답 전송: \" + i32ToString(statusCode))\n    } else {\n      println(\"❌ 응답 전송 실패\")\n    }\n\n    // 1️⃣1️⃣ 연결 종료\n    net.close(clientFd)\n  }\n\n  // 서버 종료 시 소켓 정리\n  println(\"\")\n  println(\"🛑 서버 종료 중...\")\n  net.close(server.socket)\n  println(\"✅ 소켓 닫음\")\n}","originalFile":"// ============================================================================\n// FreeLang HTTP 서버 (메인 프로그램)\n// 정식 FreeLang 모듈 - 컴파일 가능, 독립 실행 가능\n// freec http-main.free && ./http-main\n// ============================================================================\n\nuse \"std/net\"\nuse \"std/fs\"\nuse \"std/http\"\nuse \"std/json\"\n\ntype RequestHandler = fn(method: string, path: string, headers: map[string]string) -> (i32, string, string)\n\nfunc main() -> void {\n  println(\"\")\n  println(\"╔═══════════════════════════════════════════════════════╗\")\n  println(\"║  🌐 FreeLang HTTP 서버 (정식 모듈)                  ║\")\n  println(\"╚═══════════════════════════════════════════════════════╝\")\n  println(\"\")\n\n  let port: i32 = 8000\n  let host: string = \"127.0.0.1\"\n\n  println(\"📍 포트: \" + i32ToString(port))\n  println(\"📍 호스트: \" + host)\n  println(\"📁 루트: ./\")\n  println(\"📄 기본 페이지: blog.html\")\n  println(\"\")\n\n  // HTTP 서버 시작\n  let server = createHTTPServer(host, port)\n  if startServer(server) {\n    println(\"✅ HTTP 서버 시작됨\")\n    println(\"🌐 http://localhost:\" + i32ToString(port) + \"/blog.html\")\n    println(\"\")\n    println(\"⌨️  Ctrl+C로 종료\")\n    println(\"\")\n\n    // 메인 루프\n    runServerLoop(server)\n  } else {\n    println(\"❌ HTTP 서버 시작 실패\")\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// HTTP 서버 구조\n// ──────────────────────────────────────────────────────────────────────────\n\ntype HTTPServer = {\n  host: string,\n  port: i32,\n  socket: i32,\n  running: bool,\n  requestCount: i32\n}\n\nfunc createHTTPServer(host: string, port: i32) -> HTTPServer {\n  return {\n    host: host,\n    port: port,\n    socket: 0,\n    running: false,\n    requestCount: 0\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 서버 시작/중지\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc startServer(server: HTTPServer) -> bool {\n  // std/net을 이용한 소켓 생성\n  // socket = net.socket(AF_INET, SOCK_STREAM)\n  // net.bind(socket, server.host, server.port)\n  // net.listen(socket, 128)\n\n  server.running = true\n  return true\n}\n\nfunc stopServer(server: HTTPServer) -> void {\n  server.running = false\n  // net.close(server.socket)\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 요청 처리\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc parseHTTPRequest(rawRequest: string) -> (string, string, map[string]string, string) {\n  let lines = rawRequest.split(\"\\n\")\n\n  // 첫 줄: GET /path HTTP/1.1\n  let requestLine = lines[0].split(\" \")\n  let method = requestLine[0]\n  let path = requestLine[1]\n\n  if path == \"/\" {\n    path = \"/blog.html\"\n  }\n\n  // 헤더 파싱\n  let headers: map[string]string = {}\n  for i in 1..lines.length() {\n    let line = lines[i]\n    if line.isEmpty() || line == \"\\r\" {\n      break\n    }\n    let idx = line.indexOf(\":\")\n    if idx > 0 {\n      let key = line.substring(0, idx).trim()\n      let value = line.substring(idx + 1).trim()\n      headers[key] = value\n    }\n  }\n\n  return (method, path, headers, \"\")\n}\n\nfunc serveStaticFile(path: string) -> (i32, string, string) {\n  // std/fs를 이용한 파일 읽기 (보안 검증 포함)\n\n  let normalizedPath = path\n  if normalizedPath.startsWith(\"/\") {\n    normalizedPath = normalizedPath.substring(1)\n  }\n\n  // 🔒 보안: 파일 경로 traversal 방지\n  if !isPathSafe(normalizedPath) {\n    println(\"❌ 보안 경고: 의심스러운 파일 경로 접근 시도 - \" + path)\n    return (403, \"text/html; charset=utf-8\", \"<h1>403 Forbidden</h1>\")\n  }\n\n  // 파일 읽기\n  let content = readFileContent(normalizedPath)\n\n  if content.isEmpty() {\n    return (404, \"text/html; charset=utf-8\", \"<h1>404 Not Found</h1>\")\n  }\n\n  let mimeType = getMimeType(normalizedPath)\n  return (200, mimeType, content)\n}\n\nfunc readFileContent(path: string) -> string {\n  // fs.readFile(path) 호출\n  // 실제 구현: fs 모듈에서 파일 내용 반환\n\n  if path == \"blog.html\" {\n    return \"<html><body><h1>FreeLang Blog</h1></body></html>\"\n  }\n\n  if path.startsWith(\"public/css/\") {\n    // CSS 파일 반환\n    return \"/* CSS Content */\"\n  }\n\n  if path.startsWith(\"frontend/\") {\n    // JavaScript 파일 반환\n    return \"// JavaScript Content\"\n  }\n\n  return \"\"\n}\n\nfunc getMimeType(filePath: string) -> string {\n  if filePath.endsWith(\".html\") {\n    return \"text/html; charset=utf-8\"\n  }\n  if filePath.endsWith(\".css\") {\n    return \"text/css; charset=utf-8\"\n  }\n  if filePath.endsWith(\".js\") {\n    return \"application/javascript; charset=utf-8\"\n  }\n  if filePath.endsWith(\".json\") {\n    return \"application/json; charset=utf-8\"\n  }\n  return \"text/plain\"\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 🔒 보안 함수\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc isPathSafe(path: string) -> bool {\n  // 절대 경로 차단\n  if path.startsWith(\"/\") {\n    return false\n  }\n\n  // 상위 디렉토리 접근 차단 (../)\n  if path.contains(\"..\") {\n    return false\n  }\n\n  // null byte 차단\n  if path.contains(\"\\0\") {\n    return false\n  }\n\n  // 숨김 파일 차단 (.env, .git, .htaccess 등)\n  if path.contains(\"/.\") {\n    return false\n  }\n  if path.startsWith(\".\") {\n    return false\n  }\n\n  // 허용된 확장자만\n  if isAllowedExtension(path) {\n    return true\n  }\n\n  return false\n}\n\nfunc isAllowedExtension(path: string) -> bool {\n  let allowedExts: [string] = [\n    \".html\", \".css\", \".js\", \".json\",\n    \".png\", \".jpg\", \".jpeg\", \".gif\", \".svg\",\n    \".woff\", \".woff2\", \".ttf\", \".eot\"\n  ]\n\n  for ext in allowedExts {\n    if path.endsWith(ext) {\n      return true\n    }\n  }\n\n  return false\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// HTTP 응답 생성\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc buildHTTPResponse(status: i32, contentType: string, body: string) -> string {\n  let statusText = \"OK\"\n  if status == 404 {\n    statusText = \"Not Found\"\n  }\n\n  let response = \"HTTP/1.1 \" + i32ToString(status) + \" \" + statusText + \"\\r\\n\"\n  response = response + \"Content-Type: \" + contentType + \"\\r\\n\"\n  response = response + \"Content-Length: \" + i32ToString(body.length()) + \"\\r\\n\"\n  response = response + \"Access-Control-Allow-Origin: *\\r\\n\"\n  response = response + \"Connection: close\\r\\n\"\n  response = response + \"\\r\\n\"\n  response = response + body\n\n  return response\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 서버 메인 루프\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc runServerLoop(server: HTTPServer) -> void {\n  while server.running {\n    // clientSocket = net.accept(server.socket)\n    // rawRequest = net.read(clientSocket)\n\n    // 요청 파싱\n    // (method, path, headers, body) = parseHTTPRequest(rawRequest)\n\n    // 요청 처리\n    // (statusCode, contentType, responseBody) = serveStaticFile(path)\n\n    // HTTP 응답 생성\n    // httpResponse = buildHTTPResponse(statusCode, contentType, responseBody)\n\n    // 응답 전송\n    // net.write(clientSocket, httpResponse)\n    // net.close(clientSocket)\n\n    server.requestCount = server.requestCount + 1\n\n    // 실제 구현에서는 블로킹 accept()\n    // 여기서는 시뮬레이션만 수행\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 유틸리티\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc i32ToString(n: i32) -> string {\n  if n == 0 {\n    return \"0\"\n  }\n\n  let negative = n < 0\n  let abs = if negative { -n } else { n }\n\n  let result = \"\"\n  let temp = abs\n  while temp > 0 {\n    let digit = temp % 10\n    let char = if digit == 0 { \"0\" }\n             else if digit == 1 { \"1\" }\n             else if digit == 2 { \"2\" }\n             else if digit == 3 { \"3\" }\n             else if digit == 4 { \"4\" }\n             else if digit == 5 { \"5\" }\n             else if digit == 6 { \"6\" }\n             else if digit == 7 { \"7\" }\n             else if digit == 8 { \"8\" }\n             else { \"9\" }\n    result = char + result\n    temp = temp / 10\n  }\n\n  if negative {\n    return \"-\" + result\n  }\n  return result\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 엔트리 포인트\n// ──────────────────────────────────────────────────────────────────────────\n\n// 메인 함수가 위에 정의되어 있음\n// freec http-main.free 로 컴파일\n// ./http-main 으로 실행\n","structuredPatch":[{"oldStart":258,"oldLines":28,"newStart":258,"newLines":93,"lines":[" // ──────────────────────────────────────────────────────────────────────────"," "," func runServerLoop(server: HTTPServer) -> void {","-  while server.running {","-    // clientSocket = net.accept(server.socket)","-    // rawRequest = net.read(clientSocket)","+  // 🔧 Phase 1: TCP 소켓 통신 구현"," ","-    // 요청 파싱","-    // (method, path, headers, body) = parseHTTPRequest(rawRequest)","+  // 1️⃣ 소켓 생성","+  println(\"📍 소켓 생성 중...\")","+  server.socket = net.socket(2, 1)  // AF_INET=2, SOCK_STREAM=1"," ","-    // 요청 처리","-    // (statusCode, contentType, responseBody) = serveStaticFile(path)","+  if server.socket < 0 {","+    println(\"❌ 소켓 생성 실패\")","+    return","+  }","+  println(\"✅ 소켓 생성됨 (fd=\" + i32ToString(server.socket) + \")\")"," ","-    // HTTP 응답 생성","-    // httpResponse = buildHTTPResponse(statusCode, contentType, responseBody)","+  // 2️⃣ SO_REUSEADDR 옵션 설정 (포트 재사용)","+  net.setsockopt(server.socket, 1, 15, 1)  // SOL_SOCKET=1, SO_REUSEADDR=15"," ","-    // 응답 전송","-    // net.write(clientSocket, httpResponse)","-    // net.close(clientSocket)","+  // 3️⃣ 소켓 바인드","+  println(\"📍 바인드 중: \" + server.host + \":\" + i32ToString(server.port))","+  let bindResult = net.bind(server.socket, server.host, server.port)"," ","+  if bindResult != 0 {","+    println(\"❌ 바인드 실패 (호스트/포트 이미 사용 중?)\")","+    net.close(server.socket)","+    return","+  }","+  println(\"✅ 바인드 완료\")","+","+  // 4️⃣ 리슨 시작","+  println(\"📍 리슨 시작 (backlog=128)\")","+  let listenResult = net.listen(server.socket, 128)","+","+  if listenResult != 0 {","+    println(\"❌ 리슨 실패\")","+    net.close(server.socket)","+    return","+  }","+  println(\"✅ 리슨 시작됨, 클라이언트 대기 중...\")","+  println(\"\")","+","+  // 5️⃣ 메인 수락 루프","+  while server.running {","+    // 클라이언트 연결 수락","+    let (clientFd, clientHost, clientPort) = net.accept(server.socket)","+","+    if clientFd < 0 {","+      // 타임아웃 또는 에러","+      continue","+    }","+","+    // 6️⃣ HTTP 요청 읽기","+    let (readOk, rawRequest) = net.read(clientFd, 4096)","+","+    if !readOk || rawRequest.isEmpty() {","+      net.close(clientFd)","+      continue","+    }","+","     server.requestCount = server.requestCount + 1"," ","-    // 실제 구현에서는 블로킹 accept()","-    // 여기서는 시뮬레이션만 수행","+    // 7️⃣ HTTP 요청 파싱","+    let (method, path, headers, body) = parseHTTPRequest(rawRequest)","+","+    println(\"📨 요청 #\" + i32ToString(server.requestCount) + \": \" + method + \" \" + path + \" (from \" + clientHost + \":\" + i32ToString(clientPort) + \")\")","+","+    // 8️⃣ 요청 처리 (파일 서빙)","+    let (statusCode, contentType, responseBody) = serveStaticFile(path)","+","+    // 9️⃣ HTTP 응답 생성","+    let httpResponse = buildHTTPResponse(statusCode, contentType, responseBody)","+","+    // 🔟 응답 전송","+    let writeOk = net.write(clientFd, httpResponse)","+","+    if writeOk {","+      println(\"✅ 응답 전송: \" + i32ToString(statusCode))","+    } else {","+      println(\"❌ 응답 전송 실패\")","+    }","+","+    // 1️⃣1️⃣ 연결 종료","+    net.close(clientFd)","   }","+","+  // 서버 종료 시 소켓 정리","+  println(\"\")","+  println(\"🛑 서버 종료 중...\")","+  net.close(server.socket)","+  println(\"✅ 소켓 닫음\")"," }"," "," // ──────────────────────────────────────────────────────────────────────────"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"8131b3f8-5f95-4294-97c2-87c5a7cf7af0","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
