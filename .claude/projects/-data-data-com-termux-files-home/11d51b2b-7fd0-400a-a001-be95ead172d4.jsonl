\"#4b5563\",\n    \"gray-700\": \"#374151\",\n    \"gray-800\": \"#1f2937\",\n    \"gray-900\": \"#111827\",\n    \"blue-50\": \"#eff6ff\",\n    \"blue-100\": \"#dbeafe\",\n    \"blue-500\": \"#3b82f6\",\n    \"blue-600\": \"#2563eb\",\n    \"blue-900\": \"#1e3a8a\",\n    \"red-500\": \"#ef4444\",\n    \"red-600\": \"#dc2626\",\n    \"green-500\": \"#10b981\",\n    \"green-600\": \"#059669\"\n  }\n}\n\nfunc defineSpacing() -> map[string]string {\n  return {\n    \"0\": \"0\",\n    \"1\": \"4px\",\n    \"2\": \"8px\",\n    \"3\": \"12px\",\n    \"4\": \"16px\",\n    \"6\": \"24px\",\n    \"8\": \"32px\",\n    \"10\": \"40px\",\n    \"12\": \"48px\",\n    \"16\": \"64px\",\n    \"20\": \"80px\",\n    \"24\": \"96px\"\n  }\n}\n\nfunc defineTypography() -> map[string]string {\n  return {\n    \"font-xs\": \"12px\",\n    \"font-sm\": \"14px\",\n    \"font-base\": \"16px\",\n    \"font-lg\": \"18px\",\n    \"font-xl\": \"20px\",\n    \"font-2xl\": \"24px\",\n    \"font-3xl\": \"30px\",\n    \"font-4xl\": \"36px\",\n    \"font-bold\": \"700\",\n    \"font-semibold\": \"600\",\n    \"font-normal\": \"400\",\n    \"font-light\": \"300\"\n  }\n}\n\nfunc defineBreakpoints() -> map[string]string {\n  return {\n    \"xs\": \"320px\",\n    \"sm\": \"640px\",\n    \"md\": \"768px\",\n    \"lg\": \"1024px\",\n    \"xl\": \"1280px\",\n    \"2xl\": \"1536px\"\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// CSS 규칙 생성 함수\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc createRule(selector: string, props: map[string]string) -> CSSRule {\n  return {\n    selector: selector,\n    properties: props,\n    mediaQuery: nil,\n    pseudo: nil\n  }\n}\n\nfunc createRuleWithPseudo(selector: string, pseudo: string, props: map[string]string) -> CSSRule {\n  return {\n    selector: selector,\n    properties: props,\n    mediaQuery: nil,\n    pseudo: pseudo\n  }\n}\n\nfunc createRuleWithMedia(selector: string, media: string, props: map[string]string) -> CSSRule {\n  return {\n    selector: selector,\n    properties: props,\n    mediaQuery: media,\n    pseudo: nil\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// CSS 클래스 생성\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc createColorClass(name: string, color: string) -> CSSRule {\n  return createRule(\".\" + name, {\n    \"color\": color\n  })\n}\n\nfunc createBackgroundClass(name: string, color: string) -> CSSRule {\n  return createRule(\".bg-\" + name, {\n    \"background-color\": color\n  })\n}\n\nfunc createPaddingClass(name: string, size: string) -> CSSRule {\n  return createRule(\".p-\" + name, {\n    \"padding\": size\n  })\n}\n\nfunc createMarginClass(name: string, size: string) -> CSSRule {\n  return createRule(\".m-\" + name, {\n    \"margin\": size\n  })\n}\n\nfunc createFlexClass() -> [CSSRule] {\n  let rules: [CSSRule] = []\n\n  // Flex utilities\n  rules.push(createRule(\".flex\", {\n    \"display\": \"flex\"\n  }))\n\n  rules.push(createRule(\".flex-col\", {\n    \"flex-direction\": \"column\"\n  }))\n\n  rules.push(createRule(\".flex-row\", {\n    \"flex-direction\": \"row\"\n  }))\n\n  rules.push(createRule(\".gap-4\", {\n    \"gap\": \"16px\"\n  }))\n\n  rules.push(createRule(\".items-center\", {\n    \"align-items\": \"center\"\n  }))\n\n  rules.push(createRule(\".justify-center\", {\n    \"justify-content\": \"center\"\n  }))\n\n  return rules\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// CSS 모듈 구성\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc buildCSSModule(name: string) -> CSSModule {\n  let colors = defineColors()\n  let spacing = defineSpacing()\n  let typography = defineTypography()\n  let breakpoints = defineBreakpoints()\n\n  let rules: [CSSRule] = []\n\n  // 색상 클래스 생성\n  for (colorName, colorValue) in colors {\n    rules.push(createColorClass(\"text-\" + colorName, colorValue))\n    rules.push(createBackgroundClass(colorName, colorValue))\n  }\n\n  // 간격 클래스 생성\n  for (spaceName, spaceValue) in spacing {\n    rules.push(createPaddingClass(spaceName, spaceValue))\n    rules.push(createMarginClass(spaceName, spaceValue))\n  }\n\n  // Flex 클래스\n  rules.extend(createFlexClass())\n\n  // Reset 규칙\n  rules.push(createRule(\"*\", {\n    \"margin\": \"0\",\n    \"padding\": \"0\",\n    \"box-sizing\": \"border-box\"\n  }))\n\n  rules.push(createRule(\"body\", {\n    \"font-family\": \"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif\",\n    \"line-height\": \"1.5\",\n    \"color\": colors[\"gray-900\"]\n  }))\n\n  return {\n    name: name,\n    rules: rules,\n    variables: {\n      ...colors,\n      ...spacing,\n      ...typography\n    },\n    theme: \"light\",\n    breakpoints: breakpoints\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// CSS 생성 함수\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc renderRule(rule: CSSRule) -> string {\n  let selector = rule.selector\n\n  if rule.pseudo != nil {\n    selector = selector + \":\" + rule.pseudo\n  }\n\n  let css = selector + \" {\\n\"\n\n  for (prop, value) in rule.properties {\n    css = css + \"  \" + prop + \": \" + value + \";\\n\"\n  }\n\n  css = css + \"}\\n\"\n\n  return css\n}\n\nfunc generateCSS(module: CSSModule) -> string {\n  let css = \"/* ========================================\\n\"\n  css = css + \"   FreeLang CSS Module: \" + module.name + \"\\n\"\n  css = css + \"   Theme: \" + module.theme + \"\\n\"\n  css = css + \"   ======================================== */\\n\\n\"\n\n  // CSS 변수\n  css = css + \":root {\\n\"\n  for (varName, varValue) in module.variables {\n    css = css + \"  --\" + varName + \": \" + varValue + \";\\n\"\n  }\n  css = css + \"}\\n\\n\"\n\n  // CSS 규칙\n  for rule in module.rules {\n    if rule.mediaQuery != nil {\n      css = css + \"@media \" + rule.mediaQuery + \" {\\n\"\n      css = css + renderRule(rule)\n      css = css + \"}\\n\"\n    } else {\n      css = css + renderRule(rule)\n    }\n  }\n\n  return css\n}\n\nfunc minifyCSS(css: string) -> string {\n  // 공백 제거\n  let minified = css\n  minified = minified.replace(\"\\n\", \"\")\n  minified = minified.replace(\"  \", \"\")\n  minified = minified.replace(\": \", \":\")\n  minified = minified.replace(\"; \", \";\")\n\n  return minified\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 스타일시트 생성 및 배포\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc compileStyleSheet(moduleName: string) -> StyleSheet {\n  let module = buildCSSModule(moduleName)\n  let css = generateCSS(module)\n  let minified = minifyCSS(css)\n\n  let ruleCount = i32(module.rules.length)\n  let size = css.length()\n  let gzipSize = size / 3  // 대략적 추정\n\n  return {\n    module: moduleName,\n    css: css,\n    minified: minified,\n    stats: {\n      ruleCount: ruleCount,\n      size: i32(size),\n      gzipSize: i32(gzipSize)\n    }\n  }\n}\n\nfunc exportStyleSheet(sheet: StyleSheet, filename: string) -> bool {\n  // 파일에 저장하는 로직\n  // (실제 구현에서는 파일 I/O)\n  return true\n}\n\nfunc getStyleSheetStats(sheet: StyleSheet) -> string {\n  let stats = sheet.stats\n  return \"CSS Module: \" + sheet.module + \"\\n\" +\n         \"Rules: \" + i32ToString(stats.ruleCount) + \"\\n\" +\n         \"Size: \" + i32ToString(stats.size) + \" bytes\\n\" +\n         \"Gzipped: \" + i32ToString(stats.gzipSize) + \" bytes\"\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 반응형 스타일 생성\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc createResponsiveClass(\n  baseName: string,\n  breakpoint: string,\n  breakpointValue: string,\n  props: map[string]string\n) -> CSSRule {\n  let selector = \"@media (min-width: \" + breakpointValue + \") { .\" + baseName + \" }\"\n\n  return createRuleWithMedia(\n    \".\" + baseName,\n    \"(min-width: \" + breakpointValue + \")\",\n    props\n  )\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 다크 모드 지원\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc createDarkModeClass(lightColor: string, darkColor: string) -> [CSSRule] {\n  let rules: [CSSRule] = []\n\n  rules.push(createRule(\".dark-mode\", {\n    \"background-color\": darkColor,\n    \"color\": lightColor\n  }))\n\n  return rules\n}\n\nfunc generateDarkTheme(module: CSSModule) -> CSSModule {\n  let darkModule = module\n  darkModule.theme = \"dark\"\n\n  // 다크 테마용 색상 오버라이드\n  let darkColors = defineColors()\n  darkColors[\"gray-900\"] = \"#ffffff\"\n  darkColors[\"gray-50\"] = \"#0f172a\"\n\n  darkModule.variables = darkColors\n\n  return darkModule\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 유틸리티 함수\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc i32ToString(n: i32) -> string {\n  return \"number\"  // 실제 구현에서는 숫자를 문자열로 변환\n}\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"b1511255-fe04-49a7-8ea4-91a35c5da519","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
