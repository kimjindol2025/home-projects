record) -> Blog? {\n  for mut blog in global.blogs {\n    if blog.id == id {\n      if updates.title {\n        blog.title = updates.title\n      }\n      if updates.content {\n        blog.content = updates.content\n      }\n      if updates.summary {\n        blog.summary = updates.summary\n      }\n      if updates.category {\n        blog.category = updates.category\n      }\n      if updates.tags {\n        blog.tags = updates.tags\n      }\n\n      blog.updatedAt = now()\n\n      recordEvent(EventType::BLOG_UPDATED, { id: id, updates: updates })\n      persistDatabase()\n\n      return blog\n    }\n  }\n\n  return null\n}\n\nfunc deleteBlog(id: number) -> bool {\n  for i in 0..global.blogs.length {\n    if global.blogs[i].id == id {\n      let deleted = global.blogs[i]\n      global.blogs.remove(i)\n\n      recordEvent(EventType::BLOG_DELETED, { id: id })\n      persistDatabase()\n\n      return true\n    }\n  }\n\n  return false\n}\n\nfunc getBlogById(id: number) -> Blog? {\n  for blog in global.blogs {\n    if blog.id == id {\n      return blog\n    }\n  }\n\n  return null\n}\n\nfunc getBlogBySlug(slug: string) -> Blog? {\n  for blog in global.blogs {\n    if blog.slug == slug {\n      return blog\n    }\n  }\n\n  return null\n}\n\nfunc getBlogs(status: BlogStatus = BlogStatus::PUBLISHED) -> array<Blog> {\n  let result: array<Blog> = []\n\n  for blog in global.blogs {\n    if blog.status == status {\n      result.push(blog)\n    }\n  }\n\n  return result\n}\n\nfunc getAllBlogs() -> array<Blog> {\n  return global.blogs\n}\n\nfunc incrementBlogView(id: number) {\n  for mut blog in global.blogs {\n    if blog.id == id {\n      blog.viewCount += 1\n      persistDatabase()\n      break\n    }\n  }\n}\n\nfunc likeBlog(id: number) -> number? {\n  for mut blog in global.blogs {\n    if blog.id == id {\n      blog.likeCount += 1\n      persistDatabase()\n      return blog.likeCount\n    }\n  }\n\n  return null\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 상태 조회\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc getTodoStats() -> TodoStats {","originalFile":"// ============================================================================\n// FreeLang Core: 상태 관리 + 비즈니스 로직\n// 단독 실행 가능한 서버 상태 정의 (DB 연동)\n// ============================================================================\n\nuse \"..shared/types\"\nuse \"..db/storage\"\n\n// ──────────────────────────────────────────────────────────────────────────\n// 글로벌 상태\n// ──────────────────────────────────────────────────────────────────────────\n\nglobal {\n  counter: Counter = {\n    id: \"main\",\n    count: 0,\n    name: \"Main Counter\",\n    createdAt: now(),\n    updatedAt: now()\n  }\n\n  todos: array<Todo> = []\n\n  blogs: array<Blog> = []\n\n  nextTodoId: number = 1\n\n  nextBlogId: number = 1\n\n  // 변경 이력 추적\n  history: array<StateEvent> = []\n\n  // DB 초기화 플래그\n  dbInitialized: bool = false\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Counter 함수들\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc incrementCounter() -> Counter {\n  global.counter.count += 1\n  global.counter.updatedAt = now()\n\n  // 이벤트 기록\n  recordEvent(\n    EventType::COUNTER_INCREMENTED,\n    {\n      previousValue: global.counter.count - 1,\n      newValue: global.counter.count\n    }\n  )\n\n  return global.counter\n}\n\nfunc decrementCounter() -> Counter {\n  global.counter.count -= 1\n  global.counter.updatedAt = now()\n\n  recordEvent(\n    EventType::COUNTER_DECREMENTED,\n    {\n      previousValue: global.counter.count + 1,\n      newValue: global.counter.count\n    }\n  )\n\n  return global.counter\n}\n\nfunc resetCounter() -> Counter {\n  let oldCount = global.counter.count\n  global.counter.count = 0\n  global.counter.updatedAt = now()\n\n  recordEvent(\n    EventType::COUNTER_RESET,\n    {\n      previousValue: oldCount,\n      newValue: 0\n    }\n  )\n\n  return global.counter\n}\n\nfunc setCounter(value: number) -> Counter {\n  let oldCount = global.counter.count\n  global.counter.count = value\n  global.counter.updatedAt = now()\n\n  recordEvent(\n    EventType::COUNTER_RESET,\n    {\n      previousValue: oldCount,\n      newValue: value\n    }\n  )\n\n  return global.counter\n}\n\nfunc getCounter() -> Counter {\n  return global.counter\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Todo 함수들\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc addTodo(text: string, priority: Priority) -> Todo {\n  let todo: Todo = {\n    id: global.nextTodoId,\n    text: text,\n    done: false,\n    priority: priority,\n    tags: [],\n    createdAt: now(),\n    updatedAt: now()\n  }\n\n  global.todos.push(todo)\n  global.nextTodoId += 1\n\n  recordEvent(\n    EventType::TODO_CREATED,\n    todo\n  )\n\n  return todo\n}\n\nfunc updateTodo(id: number, updates: record) -> Todo? {\n  for mut todo in global.todos {\n    if todo.id == id {\n      if updates.text {\n        todo.text = updates.text\n      }\n      if updates.priority {\n        todo.priority = updates.priority\n      }\n      if updates.tags {\n        todo.tags = updates.tags\n      }\n\n      todo.updatedAt = now()\n\n      recordEvent(\n        EventType::TODO_UPDATED,\n        { id: id, updates: updates }\n      )\n\n      return todo\n    }\n  }\n\n  return null\n}\n\nfunc toggleTodo(id: number) -> Todo? {\n  for mut todo in global.todos {\n    if todo.id == id {\n      todo.done = !todo.done\n      todo.updatedAt = now()\n\n      let eventType = todo.done ?\n        EventType::TODO_TOGGLED :\n        EventType::TODO_TOGGLED\n\n      recordEvent(eventType, { id: id, done: todo.done })\n\n      return todo\n    }\n  }\n\n  return null\n}\n\nfunc deleteTodo(id: number) -> bool {\n  for i in 0..global.todos.length {\n    if global.todos[i].id == id {\n      let deleted = global.todos[i]\n      global.todos.remove(i)\n\n      recordEvent(\n        EventType::TODO_DELETED,\n        { id: id }\n      )\n\n      return true\n    }\n  }\n\n  return false\n}\n\nfunc getTodos() -> array<Todo> {\n  return global.todos\n}\n\nfunc getTodoById(id: number) -> Todo? {\n  for todo in global.todos {\n    if todo.id == id {\n      return todo\n    }\n  }\n\n  return null\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 상태 조회\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc getTodoStats() -> TodoStats {\n  let stats: TodoStats = {\n    total: global.todos.length,\n    done: 0,\n    pending: 0,\n    byPriority: {\n      high: 0,\n      medium: 0,\n      low: 0\n    },\n    byTag: {}\n  }\n\n  for todo in global.todos {\n    if todo.done {\n      stats.done += 1\n    } else {\n      stats.pending += 1\n    }\n\n    match todo.priority {\n      Priority::HIGH => stats.byPriority.high += 1\n      Priority::MEDIUM => stats.byPriority.medium += 1\n      Priority::LOW => stats.byPriority.low += 1\n    }\n\n    for tag in todo.tags {\n      if stats.byTag[tag] {\n        stats.byTag[tag] += 1\n      } else {\n        stats.byTag[tag] = 1\n      }\n    }\n  }\n\n  return stats\n}\n\nfunc getSystemHealth() -> SystemHealth {\n  return {\n    status: \"healthy\",\n    uptime: 0,\n    timestamp: now(),\n    database: {\n      todos: global.todos.length,\n      counters: 1,\n      healthy: true\n    }\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 내부 유틸리티\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc recordEvent(eventType: EventType, payload: any) {\n  let event: StateEvent = {\n    type: eventType,\n    timestamp: now(),\n    payload: payload,\n    metadata: {\n      userId: \"system\",\n      source: \"backend\"\n    }\n  }\n\n  global.history.push(event)\n\n  // 최근 100개만 유지\n  if global.history.length > 100 {\n    global.history = global.history[global.history.length - 100..]\n  }\n}\n\nfunc clearHistory() {\n  global.history = []\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 내보내기 (다른 모듈에서 사용)\n// ──────────────────────────────────────────────────────────────────────────\n\nexport {\n  // Counter\n  incrementCounter,\n  decrementCounter,\n  resetCounter,\n  setCounter,\n  getCounter,\n\n  // Todo\n  addTodo,\n  updateTodo,\n  toggleTodo,\n  deleteTodo,\n  getTodos,\n  getTodoById,\n\n  // 조회\n  getTodoStats,\n  getSystemHealth,\n\n  // 이벤트\n  recordEvent,\n  clearHistory\n}\n","structuredPatch":[{"oldStart":210,"oldLines":6,"newStart":210,"newLines":167,"lines":[" }"," "," // ──────────────────────────────────────────────────────────────────────────","+// Blog 함수들","+// ──────────────────────────────────────────────────────────────────────────","+","+func createBlog(","+  title: string,","+  slug: string,","+  content: string,","+  summary: string,","+  author: string,","+  category: string,","+  tags: array<string>","+) -> Blog {","+  let blog: Blog = {","+    id: global.nextBlogId,","+    title: title,","+    slug: slug,","+    content: content,","+    summary: summary,","+    status: BlogStatus::DRAFT,","+    author: author,","+    category: category,","+    tags: tags,","+    viewCount: 0,","+    likeCount: 0,","+    createdAt: now(),","+    updatedAt: now(),","+    publishedAt: null","+  }","+","+  global.blogs.push(blog)","+  global.nextBlogId += 1","+","+  recordEvent(EventType::BLOG_CREATED, blog)","+  persistDatabase()","+","+  return blog","+}","+","+func publishBlog(id: number) -> Blog? {","+  for mut blog in global.blogs {","+    if blog.id == id {","+      blog.status = BlogStatus::PUBLISHED","+      blog.publishedAt = now()","+      blog.updatedAt = now()","+","+      recordEvent(EventType::BLOG_PUBLISHED, { id: id })","+      persistDatabase()","+","+      return blog","+    }","+  }","+","+  return nul