{"parentUuid":"d98a8222-875f-4102-acfb-dbbab421cf9d","isSidechain":false,"message":{"model":"claude-haiku-4-5-20251001","id":"msg_018mKGpGzBaspMwXPM3yFvuD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019xogZQBGoVC7W11dpJAuxt","name":"Write","input":{"file_path":"/data/data/com.termux/files/home/freelang-hybrid/freelang/core/database-sqlite3.js","content":"// ============================================================================\n// Phase 2 Enhanced: SQLite3 Persistent Database\n// ============================================================================\n\nconst Database = require('better-sqlite3');\nconst path = require('path');\nconst crypto = require('crypto');\n\nconst DB_PATH = path.join(__dirname, '../../db/blogs.db');\n\nlet db = null;\n\nfunction initializeDB() {\n  try {\n    db = new Database(DB_PATH);\n    db.pragma('journal_mode = WAL');\n    db.pragma('synchronous = NORMAL');\n    db.pragma('foreign_keys = ON');\n\n    db.exec(`\n      CREATE TABLE IF NOT EXISTS blogs (\n        id TEXT PRIMARY KEY,\n        title TEXT NOT NULL,\n        content TEXT NOT NULL,\n        author TEXT NOT NULL,\n        createdAt TEXT NOT NULL,\n        updatedAt TEXT NOT NULL,\n        views INTEGER DEFAULT 0,\n        version INTEGER DEFAULT 1,\n        deleted INTEGER DEFAULT 0,\n        status TEXT DEFAULT 'draft',\n        tags TEXT\n      );\n\n      CREATE INDEX IF NOT EXISTS idx_author ON blogs(author);\n      CREATE INDEX IF NOT EXISTS idx_status ON blogs(status);\n      CREATE INDEX IF NOT EXISTS idx_deleted ON blogs(deleted);\n    `);\n\n    console.log(`✅ SQLite3 initialized: ${DB_PATH}`);\n    return true;\n  } catch (err) {\n    console.error('❌ SQLite3 init failed:', err.message);\n    return false;\n  }\n}\n\nfunction connect() {\n  if (!db) initializeDB();\n  return {\n    insert: insertBlog,\n    get: getBlog,\n    getAll: getAllBlogs,\n    update: updateBlog,\n    delete: deleteBlog,\n    search: searchBlogs,\n    stats: getStats,\n    backup: backupDatabase,\n    migrate: migrateFromJSON\n  };\n}\n\nfunction insertBlog(blog) {\n  try {\n    const stmt = db.prepare(`\n      INSERT INTO blogs (id, title, content, author, createdAt, updatedAt, version, status)\n      VALUES (?, ?, ?, ?, ?, ?, 1, ?)\n    `);\n\n    const blogId = blog.id || generateId();\n    const now = new Date().toISOString();\n\n    stmt.run(\n      blogId,\n      blog.title || 'Untitled',\n      blog.content || '',\n      blog.author || 'Unknown',\n      blog.createdAt || now,\n      blog.updatedAt || now,\n      blog.status || 'draft'\n    );\n\n    console.log(`✅ Blog inserted: ${blogId}`);\n    return { success: true, id: blogId };\n  } catch (err) {\n    console.error('❌ Insert failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction getBlog(blogId) {\n  try {\n    const stmt = db.prepare(`\n      SELECT * FROM blogs WHERE id = ? AND deleted = 0\n    `);\n\n    const blog = stmt.get(blogId);\n    if (blog) {\n      // Increment views\n      db.prepare(`UPDATE blogs SET views = views + 1 WHERE id = ?`).run(blogId);\n      return { success: true, data: blog };\n    }\n    return { success: false, error: 'Not found' };\n  } catch (err) {\n    console.error('❌ Get failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction getAllBlogs(limit = 100, offset = 0) {\n  try {\n    const stmt = db.prepare(`\n      SELECT * FROM blogs WHERE deleted = 0 ORDER BY createdAt DESC LIMIT ? OFFSET ?\n    `);\n\n    const blogs = stmt.all(limit, offset);\n    const count = db.prepare(`SELECT COUNT(*) as c FROM blogs WHERE deleted = 0`).get().c;\n\n    return { success: true, data: blogs, total: count };\n  } catch (err) {\n    console.error('❌ GetAll failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction updateBlog(blogId, updates) {\n  try {\n    const blog = db.prepare(`SELECT * FROM blogs WHERE id = ?`).get(blogId);\n    if (!blog) return { success: false, error: 'Not found' };\n\n    if (updates.version && updates.version !== blog.version) {\n      return { success: false, error: 'Version conflict' };\n    }\n\n    const stmt = db.prepare(`\n      UPDATE blogs SET\n        title = COALESCE(?, title),\n        content = COALESCE(?, content),\n        author = COALESCE(?, author),\n        status = COALESCE(?, status),\n        updatedAt = ?,\n        version = ?\n      WHERE id = ?\n    `);\n\n    stmt.run(\n      updates.title || null,\n      updates.content || null,\n      updates.author || null,\n      updates.status || null,\n      new Date().toISOString(),\n      (blog.version || 0) + 1,\n      blogId\n    );\n\n    console.log(`✅ Blog updated: ${blogId}`);\n    return { success: true, version: (blog.version || 0) + 1 };\n  } catch (err) {\n    console.error('❌ Update failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction deleteBlog(blogId, hardDelete = false) {\n  try {\n    if (hardDelete) {\n      db.prepare(`DELETE FROM blogs WHERE id = ?`).run(blogId);\n      console.log(`✅ Hard deleted: ${blogId}`);\n    } else {\n      db.prepare(`UPDATE blogs SET deleted = 1, updatedAt = ? WHERE id = ?`).run(\n        new Date().toISOString(),\n        blogId\n      );\n      console.log(`✅ Soft deleted: ${blogId}`);\n    }\n    return { success: true };\n  } catch (err) {\n    console.error('❌ Delete failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction searchBlogs(query, filters = {}) {\n  try {\n    let sql = `SELECT * FROM blogs WHERE deleted = 0`;\n    const params = [];\n\n    if (query) {\n      sql += ` AND (title LIKE ? OR content LIKE ? OR author LIKE ?)`;\n      params.push(`%${query}%`, `%${query}%`, `%${query}%`);\n    }\n\n    if (filters.author) {\n      sql += ` AND author = ?`;\n      params.push(filters.author);\n    }\n\n    if (filters.status) {\n      sql += ` AND status = ?`;\n      params.push(filters.status);\n    }\n\n    sql += ` ORDER BY updatedAt DESC LIMIT 100`;\n\n    const results = db.prepare(sql).all(...params);\n    return { success: true, data: results, count: results.length };\n  } catch (err) {\n    console.error('❌ Search failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction getStats() {\n  try {\n    const total = db.prepare(`SELECT COUNT(*) as c FROM blogs`).get().c;\n    const active = db.prepare(`SELECT COUNT(*) as c FROM blogs WHERE deleted = 0`).get().c;\n    const views = db.prepare(`SELECT SUM(views) as v FROM blogs`).get().v || 0;\n    const authors = db.prepare(`SELECT COUNT(DISTINCT author) as a FROM blogs`).get().a;\n\n    return {\n      success: true,\n      data: {\n        totalBlogs: total,\n        activeBlogs: active,\n        totalViews: views,\n        uniqueAuthors: authors,\n        dbSize: require('fs').statSync(DB_PATH).size\n      }\n    };\n  } catch (err) {\n    return { success: false, error: err.message };\n  }\n}\n\nfunction backupDatabase() {\n  try {\n    const backupPath = path.join(__dirname, `../../db/blogs-backup-${Date.now()}.db`);\n    db.exec(`VACUUM INTO '${backupPath}'`);\n    console.log(`✅ Backup created: ${backupPath}`);\n    return { success: true, path: backupPath };\n  } catch (err) {\n    console.error('❌ Backup failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction migrateFromJSON(jsonPath) {\n  try {\n    const fs = require('fs');\n    const data = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));\n\n    const stmt = db.prepare(`\n      INSERT INTO blogs (id, title, content, author, createdAt, updatedAt, views, version)\n      VALUES (?, ?, ?, ?, ?, ?, ?, 1)\n    `);\n\n    const transaction = db.transaction((blogs) => {\n      for (const blog of blogs) {\n        stmt.run(\n          blog.id,\n          blog.title,\n          blog.content,\n          blog.author,\n          blog.createdAt,\n          blog.updatedAt,\n          blog.views || 0\n        );\n      }\n    });\n\n    transaction(data);\n    console.log(`✅ Migrated ${data.length} blogs`);\n    return { success: true, count: data.length };\n  } catch (err) {\n    console.error('❌ Migration failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction close() {\n  if (db) {\n    db.close();\n    console.log('✅ Database closed');\n  }\n}\n\nfunction generateId() {\n  return crypto.randomBytes(8).toString('hex');\n}\n\nmodule.exports = {\n  initializeDB,\n  connect,\n  close,\n  _db: () => db,\n  _path: DB_PATH\n};\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":10,"cache_creation_input_tokens":846,"cache_read_input_tokens":139596,"output_tokens":3089,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":846,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"}},"requestId":"req_011CYzSCj9oGdp2sYPtkTKy6","type":"assistant","uuid":"19c4150d-1a02-4735-837e-20c107803795","timestamp":"2026-03-13T04:18:51.689Z","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
