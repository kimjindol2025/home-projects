;\n    }\n\n    // 숫자 값\n    if (!isNaN(defaultValue)) {\n      return Number(defaultValue);\n    }\n\n    // boolean 값\n    if (defaultValue === 'true') return true;\n    if (defaultValue === 'false') return false;\n\n    // null\n    if (defaultValue === 'null') return null;\n\n    // 배열 값\n    if (defaultValue === '[]') return [];\n\n    // 객체 값\n    if (defaultValue === '{}') return {};\n\n    // 평가해서 반환\n    try {\n      return Function('\"use strict\"; return (' + defaultValue + ')')();\n    } catch (e) {\n      return this.getDefaultForType(typeStr);\n    }\n  }\n\n  /**\n   * 타입별 기본값\n   */\n  getDefaultForType(type) {\n    if (type.includes('array')) return [];\n    if (type.includes('object')) return {};\n    if (type.includes('number')) return 0;\n    if (type.includes('boolean')) return false;\n    return ''; // string\n  }\n\n  /**\n   * 표현식에서 변수 추출\n   */\n  extractVariables(expression) {\n    const vars = new Set();\n    const matches = expression.match(/\\b[a-zA-Z_]\\w*\\b/g);\n\n    if (matches) {\n      matches.forEach(m => {\n        if (!this.isKeyword(m)) {\n          vars.add(m);\n        }\n      });\n    }\n\n    return Array.from(vars);\n  }\n\n  /**\n   * JavaScript 예약어 확인\n   */\n  isKeyword(word) {\n    const keywords = [\n      'true', 'false', 'null', 'undefined',\n      'if', 'else', 'for', 'while', 'return',\n      'function', 'var', 'let', 'const',\n      'and', 'or', 'not', 'in'\n    ];\n    return keywords.includes(word);\n  }\n}\n\nmodule.exports = { ExpressionEvaluator };\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"a24ff1c9-e6f1-44c0-bf29-36663cff3a07","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-light","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
