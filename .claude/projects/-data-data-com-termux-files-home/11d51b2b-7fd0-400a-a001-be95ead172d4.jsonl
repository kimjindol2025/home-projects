{\n      font-size: 1.3em;\n      color: #333;\n      margin-bottom: 15px;\n      border-bottom: 2px solid #667eea;\n      padding-bottom: 10px;\n    }\n\n    .endpoint {\n      background: #f9f9f9;\n      padding: 10px;\n      margin: 8px 0;\n      border-radius: 5px;\n      font-family: 'Courier New', monospace;\n      cursor: pointer;\n      transition: all 0.3s;\n    }\n\n    .endpoint:hover {\n      background: #667eea;\n      color: white;\n    }\n\n    .endpoint-method {\n      font-weight: bold;\n      color: #667eea;\n    }\n\n    .endpoint:hover .endpoint-method {\n      color: white;\n    }\n\n    .test-section {\n      margin-top: 30px;\n      padding-top: 30px;\n      border-top: 2px solid #eee;\n    }\n\n    button {\n      background: #667eea;\n      color: white;\n      border: none;\n      padding: 10px 20px;\n      border-radius: 5px;\n      cursor: pointer;\n      margin: 5px;\n      font-size: 1em;\n      transition: all 0.3s;\n    }\n\n    button:hover {\n      background: #764ba2;\n      transform: translateY(-2px);\n      box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);\n    }\n\n    .response {\n      background: #f5f5f5;\n      padding: 15px;\n      margin-top: 10px;\n      border-radius: 5px;\n      font-family: 'Courier New', monospace;\n      font-size: 0.9em;\n      max-height: 300px;\n      overflow-y: auto;\n      display: none;\n    }\n\n    .response.show {\n      display: block;\n    }\n\n    .response.success {\n      background: #e8f5e9;\n      border-left: 4px solid #4caf50;\n    }\n\n    .response.error {\n      background: #ffebee;\n      border-left: 4px solid #f44336;\n    }\n\n    .footer {\n      margin-top: 40px;\n      text-align: center;\n      color: #999;\n      font-size: 0.9em;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <h1>🌐 FreeLang Production System</h1>\n    <p class=\"subtitle\">Phase 1: HTTP Server (Real TCP Sockets)</p>\n\n    <div class=\"status\">\n      <div class=\"status-title\">✅ 서버 상태</div>\n      <div class=\"status-line\">상태: 운영 중</div>\n      <div class=\"status-line\" id=\"uptime\">가동 시간: 계산 중...</div>\n      <div class=\"status-line\" id=\"requests\">요청: 계산 중...</div>\n      <div class=\"status-line\" id=\"connections\">활성 연결: 계산 중...</div>\n    </div>\n\n    <div class=\"section\">\n      <div class=\"section-title\">📚 사용 가능한 엔드포인트</div>\n      <div class=\"endpoint\">\n        <span class=\"endpoint-method\">GET</span> /\n      </div>\n      <div class=\"endpoint\">\n        <span class=\"endpoint-method\">GET</span> /status\n      </div>\n      <div class=\"endpoint\">\n        <span class=\"endpoint-method\">GET</span> /api/hello\n      </div>\n      <div class=\"endpoint\">\n        <span class=\"endpoint-method\">POST</span> /api/echo\n      </div>\n    </div>\n\n    <div class=\"section test-section\">\n      <div class=\"section-title\">🧪 API 테스트</div>\n\n      <button onclick=\"testHello()\">테스트: /api/hello</button>\n      <div id=\"hello-response\" class=\"response\"></div>\n\n      <button onclick=\"testEcho()\">테스트: /api/echo</button>\n      <div id=\"echo-response\" class=\"response\"></div>\n\n      <button onclick=\"testStatus()\">테스트: /status</button>\n      <div id=\"status-response\" class=\"response\"></div>\n    </div>\n\n    <div class=\"footer\">\n      <p>FreeLang v1.0 - Production Ready</p>\n      <p>Real TCP Socket Implementation | Zero Dependencies</p>\n    </div>\n  </div>\n\n  <script>\n    // 서버 상태 업데이트\n    function updateStatus() {\n      fetch('/status')\n        .then(r => r.json())\n        .then(data => {\n          document.getElementById('uptime').textContent = `가동 시간: ${data.uptime}초`;\n          document.getElementById('requests').textContent = `요청: ${data.totalRequests}`;\n          document.getElementById('connections').textContent = `활성 연결: ${data.activeConnections}`;\n        })\n        .catch(e => console.error('Status update error:', e));\n    }\n\n    function testHello() {\n      fetch('/api/hello')\n        .then(r => r.json())\n        .then(data => {\n          showResponse('hello-response', data, 'success');\n        })\n        .catch(e => showResponse('hello-response', { error: e.message }, 'error'));\n    }\n\n    function testEcho() {\n      fetch('/api/echo', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ message: 'Hello Phase 1!', timestamp: new Date().toISOString() })\n      })\n        .then(r => r.json())\n        .then(data => {\n          showResponse('echo-response', data, 'success');\n        })\n        .catch(e => showResponse('echo-response', { error: e.message }, 'error'));\n    }\n\n    function testStatus() {\n      fetch('/status')\n        .then(r => r.json())\n        .then(data => {\n          showResponse('status-response', data, 'success');\n        })\n        .catch(e => showResponse('status-response', { error: e.message }, 'error'));\n    }\n\n    function showResponse(elementId, data, className) {\n      const elem = document.getElementById(elementId);\n      elem.textContent = JSON.stringify(data, null, 2);\n      elem.className = `response show ${className}`;\n    }\n\n    // 초기 업데이트\n    updateStatus();\n    setInterval(updateStatus, 2000);\n  </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"e04510d4-ffb9-4297-9bbf-bbc00d1a5d25","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
