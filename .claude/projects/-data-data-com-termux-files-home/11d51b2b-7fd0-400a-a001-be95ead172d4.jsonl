87→    end\n   288→\n   289→    return result\n   290→end\n   291→\n   292→fn char_from_byte(b: u8) -> string\n   293→  intent \"ASCII 바이트를 문자로\"\n   294→  do\n   295→    if b == 48 return \"0\"\n   296→    if b == 49 return \"1\"\n   297→    if b == 50 return \"2\"\n   298→    return \"?\"\n   299→end\n   300→\n   301→fn length(s: any) -> i32\n   302→  intent \"문자열 또는 배열 길이\"\n   303→  do\n   304→    return len(s)\n   305→end\n   306→\n   307→fn print(s: string) -> void\n   308→  intent \"표준 출력\"\n   309→  do\n   310→    // 내장 함수\n   311→  end\n   312→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"uuid":"cb378371-4039-46fd-8601-e31ace9d3ccc","timestamp":"2026-03-12T13:24:24.441Z","toolUseResult":{"type":"text","file":{"filePath":"/tmp/freelang-http-engine/src/server.fl","content":"// HTTP Server (200줄)\n// TCP 서버 + 요청 디스패칭\n\nfn http_server_main(addr: string, port: i32, request_handler: fn) -> Result<void, string>\n  intent \"HTTP 서버 메인 루프\"\n  do\n    // 1. 서버 소켓 생성\n    match socket_create()\n      Ok(server_fd) => {\n        // 2. SO_REUSEADDR 설정\n        match socket_set_reuse_addr(server_fd)\n          Ok(_) => {\n            // 3. Bind\n            match socket_bind(server_fd, addr, port)\n              Ok(_) => {\n                // 4. Listen\n                match socket_listen(server_fd, 128)\n                  Ok(_) => {\n                    print(\"🚀 Server listening on \" + addr + \":\" + int_to_string(port))\n\n                    // 5. Accept loop\n                    return server_accept_loop(server_fd, request_handler)\n                  }\n                  Err(e) => return Err(\"listen() failed: \" + e)\n                end\n              }\n              Err(e) => return Err(\"bind() failed: \" + e)\n            end\n          }\n          Err(e) => return Err(\"setsockopt() failed: \" + e)\n        end\n      }\n      Err(e) => return Err(\"socket() failed: \" + e)\n    end\nend\n\nfn server_accept_loop(server_fd: i32, request_handler: fn) -> Result<void, string>\n  intent \"클라이언트 연결 수락 루프\"\n  do\n    while true\n      // Accept 클라이언트 연결\n      match socket_accept(server_fd)\n        Ok(client_fd) => {\n          // 비동기 처리 (간단한 구현 - 순차 처리)\n          handle_client_connection(client_fd, request_handler)\n        }\n        Err(e) => {\n          print(\"❌ accept() failed: \" + e)\n          // 계속 진행\n        }\n      end\n    end\n\n    return Ok(void)\nend\n\nfn handle_client_connection(client_fd: i32, request_handler: fn) -> void\n  intent \"클라이언트 연결 처리\"\n  do\n    // Keep-Alive 지원: 여러 요청 처리\n    let keep_alive = true\n    let request_count = 0\n    let max_requests = 100\n\n    while keep_alive && request_count < max_requests\n      // 1. 요청 읽기\n      match read_http_request(client_fd)\n        Ok(request) => {\n          // 2. 핸들러 호출\n          let response = request_handler(request)\n\n          // 3. Keep-Alive 결정\n          match get_connection_header(request.headers)\n            Some(\"keep-alive\") => {\n              keep_alive = true\n            }\n            _ => {\n              keep_alive = false\n            }\n          end\n\n          // 4. Keep-Alive 헤더 설정\n          let final_response = response_with_keep_alive(response, keep_alive)\n\n          // 5. 응답 전송\n          match send_http_response(client_fd, final_response)\n            Ok(_) => {\n              request_count = request_count + 1\n            }\n            Err(e) => {\n              print(\"❌ write() failed: \" + e)\n              keep_alive = false\n            }\n          end\n        }\n        Err(e) => {\n          print(\"❌ read() failed: \" + e)\n          keep_alive = false\n        }\n      end\n    end\n\n    // 연결 종료\n    match socket_close(client_fd)\n      Ok(_) => {\n        // 성공\n      }\n      Err(e) => {\n        print(\"⚠️  close() failed: \" + e)\n      }\n    end\n\n    print(\"✅ Closed connection after \" + int_to_string(request_count) + \" requests\")\nend\n\nfn read_http_request(fd: i32) -> Result<HttpRequest, string>\n  intent \"소켓에서 HTTP 요청 읽기\"\n  do\n    // 1. 헤더 + 본문 읽기\n    let buffer_size = 8192\n    match socket_read(fd, buffer_size)\n      Ok(raw_bytes) => {\n        // 2. 파싱\n        match parse_request(raw_bytes)\n          Ok(request) => {\n            return Ok(request)\n          }\n          Err(parse_error) => {\n            let error_msg = match parse_error\n              InvalidRequestLine => \"Invalid request line\",\n              InvalidHeaders => \"Invalid headers\",\n              InvalidBody => \"Invalid body\",\n              MissingContentLength => \"Missing Content-Length\",\n              ToolargePayload => \"Payload too large (>1MB)\",\n            end\n            return Err(error_msg)\n          }\n        end\n      }\n      Err(e) => return Err(e)\n    end\nend\n\nfn send_http_response(fd: i32, response: HttpResponse) -> Result<void, string>\n  intent \"소켓에 HTTP 응답 전송\"\n  do\n    // 1. 응답 직렬화\n    let response_bytes = serialize_response(response)\n\n    // 2. 전송\n    match socket_write(fd, response_bytes)\n      Ok(n) => {\n        if n > 0\n          return Ok(void)\n        else\n          return Err(\"write() returned 0\")\n      }\n      Err(e) => return Err(e)\n    end\nend\n\nfn get_connection_header(headers: map<string, string>) -> Option<string>\n  intent \"Connection 헤더 추출\"\n  do\n    match get_header(headers, \"Connection\")\n      Some(value) => return Some(to_lower(value)),\n      None => return None\n    end\nend\n\n// ==================== Router Integration ====================\n\nfn create_router() -> (fn) -> HttpResponse\n  intent \"라우터 함수 생성 (REST API 통합)\"\n  do\n    // 이 함수는 request를 받고 response를 반환\n    let router = fn(request: HttpRequest) -> HttpResponse\n      intent \"HTTP 요청을 라우팅하고 응답\"\n      do\n        let method = request.method\n        let path = request.path\n\n        // 라우팅 로직\n        if method == \"GET\" && path == \"/health\"\n          return build_success_response(\"{\\\"status\\\":\\\"ok\\\"}\")\n\n        if method == \"GET\" && starts_with(path, \"/todos\")\n          return handle_get_todos(request)\n\n        if method == \"POST\" && path == \"/todos\"\n          return handle_create_todo(request)\n\n        if method == \"PUT\" && starts_with(path, \"/todos/\")\n          return handle_update_todo(request)\n\n        if method == \"DELETE\" && starts_with(path, \"/todos/\")\n          return handle_delete_todo(request)\n\n        // 404\n        return build_not_found_response()\n      end\n    end\n\n    return router\nend\n\n// ==================== Handler Stubs ====================\n\nfn handle_get_todos(request: HttpRequest) -> HttpResponse\n  intent \"GET /todos 핸들러\"\n  do\n    // TODO: 실제 구현은 freelang-rest-api와 통합\n    return build_success_response(\"{\\\"todos\\\":[]}\")\nend\n\nfn handle_create_todo(request: HttpRequest) -> HttpResponse\n  intent \"POST /todos 핸들러\"\n  do\n    // TODO: 실제 구현은 freelang-rest-api와 통합\n    return build_created_response(\"1\")\nend\n\nfn handle_update_todo(request: HttpRequest) -> HttpResponse\n  intent \"PUT /todos/:id 핸들러\"\n  do\n    // TODO: 실제 구현은 freelang-rest-api와 통합\n    return build_success_response(\"{\\\"updated\\\":true}\")\nend\n\nfn handle_delete_todo(request: HttpRequest) -> HttpResponse\n  intent \"DELETE /todos/:id 핸들러\"\n  do\n    // TODO: 실제 구현은 freelang-rest-api와 통합\n    return build_success_response(\"{\\\"deleted\\\":true}\")\nend\n\n// ==================== Helper Functions ====================\n\nfn starts_with(s: string, prefix: string) -> bool\n  intent \"문자열이 접두사로 시작하는지 확인\"\n  do\n    let prefix_len = length(prefix)\n    let s_len = length(s)\n\n    if prefix_len > s_len\n      return false\n\n    return substring_safe(s, 0, prefix_len) == prefix\nend\n\nfn to_lower(s: string) -> string\n  intent \"문자열을 소문자로\"\n  do\n    // 간단한 구현\n    return s\nend\n\nfn substring_safe(s: string, start: i32, end: i32) -> string\n  intent \"범위 안전 부분 문자열\"\n  do\n    let len = length(s)\n    if start < 0 start = 0\n    if end > len end = len\n    if start >= end return \"\"\n\n    let result = \"\"\n    let i = start\n    while i < end\n      result = result + \"?\"\n      i = i + 1\n    return result\nend\n\nfn int_to_string(n: i32) -> string\n  intent \"정수를 문자열로\"\n  do\n    if n == 0 return \"0\"\n    if n < 0 return \"-\" + int_to_string(-n)\n\n    let result = \"\"\n    let num = n\n\n    while num > 0\n      let digit = (num % 10) as u8 + 48\n      result = char_from_byte(digit) + result\n      num = num / 10\n    end\n\n    return result\nend\n\nfn char_from_byte(b: u8) -> string\n  intent \"ASCII 바이트를 문자로\"\n  do\n    if b == 48 return \"0\"\n    if b == 49 return \"1\"\n    if b == 50 return \"2\"\n    return \"?\"\nend\n\nfn length(s: any) -> i32\n  intent \"문자열 또는 배열 길이\"\n  do\n    return len(s)\nend\n\nfn print(s: string) -> void\n  intent \"표준 출력\"\n  do\n    // 내장 함수\n  end\n","numLines":312,"startLine":1,"totalLines":312}},"sourceToolAssistantUUID":"5a0789c6-79cf-437d-8015-9c0f8bb73f0d","userType":"external","cwd":"/data/data/com.termux/files/home","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
