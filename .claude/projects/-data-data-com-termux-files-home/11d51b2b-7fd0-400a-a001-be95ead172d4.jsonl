──────────────────────────────────────────────────────────────────────\n    49→\n    50→type HTTPServer = {\n    51→  host: string,\n    52→  port: i32,\n    53→  socket: i32,\n    54→  running: bool,\n    55→  requestCount: i32\n    56→}\n    57→\n    58→func createHTTPServer(host: string, port: i32) -> HTTPServer {\n    59→  return {\n    60→    host: host,\n    61→    port: port,\n    62→    socket: 0,\n    63→    running: false,\n    64→    requestCount: 0\n    65→  }\n    66→}\n    67→\n    68→// ──────────────────────────────────────────────────────────────────────────\n    69→// 서버 시작/중지\n    70→// ──────────────────────────────────────────────────────────────────────────\n    71→\n    72→func startServer(server: HTTPServer) -> bool {\n    73→  // std/net을 이용한 소켓 생성\n    74→  // socket = net.socket(AF_INET, SOCK_STREAM)\n    75→  // net.bind(socket, server.host, server.port)\n    76→  // net.listen(socket, 128)\n    77→\n    78→  server.running = true\n    79→  return true\n    80→}\n    81→\n    82→func stopServer(server: HTTPServer) -> void {\n    83→  server.running = false\n    84→  // net.close(server.socket)\n    85→}\n    86→\n    87→// ──────────────────────────────────────────────────────────────────────────\n    88→// 요청 처리\n    89→// ──────────────────────────────────────────────────────────────────────────\n    90→\n    91→func parseHTTPRequest(rawRequest: string) -> (string, string, map[string]string, string) {\n    92→  let lines = rawRequest.split(\"\\n\")\n    93→\n    94→  // 첫 줄: GET /path HTTP/1.1\n    95→  let requestLine = lines[0].split(\" \")\n    96→  let method = requestLine[0]\n    97→  let path = requestLine[1]\n    98→\n    99→  if path == \"/\" {\n   100→    path = \"/blog.html\"\n   101→  }\n   102→\n   103→  // 헤더 파싱\n   104→  let headers: map[string]string = {}\n   105→  for i in 1..lines.length() {\n   106→    let line = lines[i]\n   107→    if line.isEmpty() || line == \"\\r\" {\n   108→      break\n   109→    }\n   110→    let idx = line.indexOf(\":\")\n   111→    if idx > 0 {\n   112→      let key = line.substring(0, idx).trim()\n   113→      let value = line.substring(idx + 1).trim()\n   114→      headers[key] = value\n   115→    }\n   116→  }\n   117→\n   118→  return (method, path, headers, \"\")\n   119→}\n   120→\n   121→func serveStaticFile(path: string) -> (i32, string, string) {\n   122→  // std/fs를 이용한 파일 읽기 (보안 검증 포함)\n   123→\n   124→  let normalizedPath = path\n   125→  if normalizedPath.startsWith(\"/\") {\n   126→    normalizedPath = normalizedPath.substring(1)\n   127→  }\n   128→\n   129→  // 🔒 보안: 파일 경로 traversal 방지\n   130→  if !isPathSafe(normalizedPath) {\n   131→    println(\"❌ 보안 경고: 의심스러운 파일 경로 접근 시도 - \" + path)\n   132→    return (403, \"text/html; charset=utf-8\", \"<h1>403 Forbidden</h1>\")\n   133→  }\n   134→\n   135→  // 파일 읽기\n   136→  let content = readFileContent(normalizedPath)\n   137→\n   138→  if content.isEmpty() {\n   139→    return (404, \"text/html; charset=utf-8\", \"<h1>404 Not Found</h1>\")\n   140→  }\n   141→\n   142→  let mimeType = getMimeType(normalizedPath)\n   143→  return (200, mimeType, content)\n   144→}\n   145→\n   146→func readFileContent(path: string) -> string {\n   147→  // fs.readFile(path) 호출\n   148→  // 실제 구현: fs 모듈에서 파일 내용 반환\n   149→\n   150→  if path == \"blog.html\" {\n   151→    return \"<html><body><h1>FreeLang Blog</h1></body></html>\"\n   152→  }\n   153→\n   154→  if path.startsWith(\"public/css/\") {\n   155→    // CSS 파일 반환\n   156→    return \"/* CSS Content */\"\n   157→  }\n   158→\n   159→  if path.startsWith(\"frontend/\") {\n   160→    // JavaScript 파일 반환\n   161→    return \"// JavaScript Content\"\n   162→  }\n   163→\n   164→  return \"\"\n   165→}\n   166→\n   167→func getMimeType(filePath: string) -> string {\n   168→  if filePath.endsWith(\".html\") {\n   169→    return \"text/html; charset=utf-8\"\n   170→  }\n   171→  if filePath.endsWith(\".css\") {\n   172→    return \"text/css; charset=utf-8\"\n   173→  }\n   174→  if filePath.endsWith(\".js\") {\n   175→    return \"application/javascript; charset=utf-8\"\n   176→  }\n   177→  if filePath.endsWith(\".json\") {\n   178→    return \"application/json; charset=utf-8\"\n   179→  }\n   180→  return \"text/plain\"\n   181→}\n   182→\n   183→// ──────────────────────────────────────────────────────────────────────────\n   184→// 🔒 보안 함수\n   185→// ──────────────────────────────────────────────────────────────────────────\n   186→\n   187→func isPathSafe(path: string) -> bool {\n   188→  // 절대 경로 차단\n   189→  if path.startsWith(\"/\") {\n   190→    return false\n   191→  }\n   192→\n   193→  // 상위 디렉토리 접근 차단 (../)\n   194→  if path.contains(\"..\") {\n   195→    return false\n   196→  }\n   197→\n   198→  // null byte 차단\n   199→  if path.contains(\"\\0\") {\n   200→    return false\n   201→  }\n   202→\n   203→  // 숨김 파일 차단 (.env, .git, .htaccess 등)\n   204→  if path.contains(\"/.\") {\n   205→    return false\n   206→  }\n   207→  if path.startsWith(\".\") {\n   208→    return false\n   209→  }\n   210→\n   211→  // 허용된 확장자만\n   212→  if isAllowedExtension(path) {\n   213→    return true\n   214→  }\n   215→\n   216→  return false\n   217→}\n   218→\n   219→func isAllowedExtension(path: string) -> bool {\n   220→  let allowedExts: [string] = [\n   221→    \".html\", \".css\", \".js\", \".json\",\n   222→    \".png\", \".jpg\", \".jpeg\", \".gif\", \".svg\",\n   223→    \".woff\", \".woff2\", \".ttf\", \".eot\"\n   224→  ]\n   225→\n   226→  for ext in allowedExts {\n   227→    if path.endsWith(ext) {\n   228→      return true\n   229→    }\n   230→  }\n   231→\n   232→  return false\n   233→}\n   234→\n   235→// ──────────────────────────────────────────────────────────────────────────\n   236→// HTTP 응답 생성\n   237→// ──────────────────────────────────────────────────────────────────────────\n   238→\n   239→func buildHTTPResponse(status: i32, contentType: string, body: string) -> string {\n   240→  let statusText = \"OK\"\n   241→  if status == 404 {\n   242→    statusText = \"Not Found\"\n   243→  }\n   244→\n   245→  let response = \"HTTP/1.1 \" + i32ToString(status) + \" \" + statusText + \"\\r\\n\"\n   246→  response = response + \"Content-Type: \" + contentType + \"\\r\\n\"\n   247→  response = response + \"Content-Length: \" + i32ToString(body.length()) + \"\\r\\n\"\n   248→  response = response + \"Access-Control-Allow-Origin: *\\r\\n\"\n   249→  response = response + \"Connection: close\\r\\n\"\n   250→  response = response + \"\\r\\n\"\n   251→  response = response + body\n   252→\n   253→  return response\n   254→}\n   255→\n   256→// ──────────────────────────────────────────────────────────────────────────\n   257→// 서버 메인 루프\n   258→// ──────────────────────────────────────────────────────────────────────────\n   259→\n   260→func runServerLoop(server: HTTPServer) -> void {\n   261→  while server.running {\n   262→    // clientSocket = net.accept(server.socket)\n   263→    // rawRequest = net.read(clientSocket)\n   264→\n   265→    // 요청 파싱\n   266→    // (method, path, headers, body) = parseHTTPRequest(rawRequest)\n   267→\n   268→    // 요청 처리\n   269→    // (statusCode, contentType, responseBody) = serveStaticFile(path)\n   270→\n   271→    // HTTP 응답 생성\n   272→    // httpResponse = buildHTTPResponse(statusCode, contentType, responseBody)\n   273→\n   274→    // 응답 전송\n   275→    // net.write(clientSocket, httpResponse)\n   276→    // net.close(clientSocket)\n   277→\n   278→    server.requestCount = server.requestCount + 1\n   279→\n   280→    // 실제 구현에서는 블로킹 accept()\n   281→    // 여기서는 시뮬레이션만 수행\n   282→  }\n   283→}\n   284→\n   285→// ──────────────────────────────────────────────────────────────────────────\n   286→// 유틸리티\n   287→// ──────────────────────────────────────────────────────────────────────────\n   288→\n   289→func i32ToString(n: i32) -> string {\n   290→  if n == 0 {\n   291→    return \"0\"\n   292→  }\n   293→\n   294→  let negative = n < 0\n   295→  let abs = if negative { -n } else { n }\n   296→\n   297→  let result = \"\"\n   298→  let temp = abs\n   299→  while temp > 0 {\n   300→    let digit = temp % 10\n   301→    let char = if digit == 0 { \"0\" }\n   302→             else if digit == 1 { \"1\" }\n   303→             else if digit == 2 { \"2\" }\n   304→             else if digit == 3 { \"3\" }\n   305→             else if digit == 4 { \"4\" }\n   306→             else if digit == 5 { \"5\" }\n   307→             else if digit == 6 { \"6\" }\n   308→             else if digit == 7 { \"7\" }\n   309→             else if digit == 8 { \"8\" }\n   310→             else { \"9\" }\n   311→    result = char + result\n   312→    temp = temp / 10\n   313→  }\n   314→\n   315→  if negative {\n   316→    return \"-\" + result\n   317→  }\n   318→  return result\n   319→}\n   320→\n   321→// ──────────────────────────────────────────────────────────────────────────\n   322→// 엔트리 포인트\n   323→// ──────────────────────────────────────────────────────────────────────────\n   324→\n   325→// 메인 함수가 위에 정의되어 있음\n   326→// freec http-main.free 로 컴파일\n   327→// ./http-main 으로 실행\n   328→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"uuid":"114f1b5e-803f-43ca-a420-f859ce685d3f","timestamp":"2026-03-13T00:29:38.764Z","toolUseResult":{"type":"text","file":{"filePath":"/data/data/com.termux/files/home/freelang-hybrid/freelang/servers/http-main.free","content":"// ============================================================================\n// FreeLang HTTP 서버 (메인 프로그램)\n// 정식 FreeLang 모듈 - 컴파일 가능, 독립 실행 가능\n// freec http-main.free && ./http-main\n// ============================================================================\n\nuse \"std/net\"\nuse \"std/fs\"\nuse \"std/http\"\nuse \"std/json\"\n\ntype RequestHandler = fn(method: string, path: string, headers: map[string]string) -> (i32, string, string)\n\nfunc main() -> void {\n  println(\"\")\n  println(\"╔═══════════════════════════════════════════════════════╗\")\n  println(\"║  🌐 FreeLang HTTP 서버 (정식 모듈)                  ║\")\n  println(\"╚═══════════════════════════════════════════════════════╝\")\n  println(\"\")\n\n  let port: i32 = 8000\n  let host: string = \"127.0.0.1\"\n\n  println(\"📍 포트: \" + i32ToString(port))\n  println(\"📍 호스트: \" + host)\n  println(\"📁 루트: ./\")\n  println(\"📄 기본 페이지: blog.html\")\n  println(\"\")\n\n  // HTTP 서버 시작\n  let server = createHTTPServer(host, port)\n  if startServer(server) {\n    println(\"✅ HTTP 서버 시작됨\")\n    println(\"🌐 http://localhost:\" + i32ToString(port) + \"/blog.html\")\n    println(\"\")\n    println(\"⌨️  Ctrl+C로 종료\")\n    println(\"\")\n\n    // 메인 루프\n    runServerLoop(server)\n  } else {\n    println(\"❌ HTTP 서버 시작 실패\")\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// HTTP 서버 구조\n// ──────────────────────────────────────────────────────────────────────────\n\ntype HTTPServer = {\n  host: string,\n  port: i32,\n  socket: i32,\n  running: bool,\n  requestCount: i32\n}\n\nfunc createHTTPServer(host: string, port: i32) -> HTTPServer {\n  return {\n    host: host,\n    port: port,\n    socket: 0,\n    running: false,\n    requestCount: 0\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 서버 시작/중지\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc startServer(server: HTTPServer) -> bool {\n  // std/net을 이용한 소켓 생성\n  // socket = net.socket(AF_INET, SOCK_STREAM)\n  // net.bind(socket, server.host, server.port)\n  // net.listen(socket, 128)\n\n  server.running = true\n  return true\n}\n\nfunc stopServer(server: HTTPServer) -> void {\n  server.running = false\n  // net.close(server.socket)\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 요청 처리\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc parseHTTPRequest(rawRequest: string) -> (string, string, map[string]string, string) {\n  let lines = rawRequest.split(\"\\n\")\n\n  // 첫 줄: GET /path HTTP/1.1\n  let requestLine = lines[0].split(\" \")\n  let method = requestLine[0]\n  let path = requestLine[1]\n\n  if path == \"/\" {\n    path = \"/blog.html\"\n  }\n\n  // 헤더 파싱\n  let headers: map[string]string = {}\n  for i in 1..lines.length() {\n    let line = lines[i]\n    if line.isEmpty() || line == \"\\r\" {\n      break\n    }\n    let idx = line.indexOf(\":\")\n    if idx > 0 {\n      let key = line.substring(0, idx).trim()\n      let value = line.substring(idx + 1).trim()\n      headers[key] = value\n    }\n  }\n\n  return (method, path, headers, \"\")\n}\n\nfunc serveStaticFile(path: string) -> (i32, string, string) {\n  // std/fs를 이용한 파일 읽기 (보안 검증 포함)\n\n  let normalizedPath = path\n  if normalizedPath.startsWith(\"/\") {\n    normalizedPath = normalizedPath.substring(1)\n  }\n\n  // 🔒 보안: 파일 경로 traversal 방지\n  if !isPathSafe(normalizedPath) {\n    println(\"❌ 보안 경고: 의심스러운 파일 경로 접근 시도 - \" + path)\n    return (403, \"text/html; charset=utf-8\", \"<h1>403 Forbidden</h1>\")\n  }\n\n  // 파일 읽기\n  let content = readFileContent(normalizedPath)\n\n  if content.isEmpty() {\n    return (404, \"text/html; charset=utf-8\", \"<h1>404 Not Found</h1>\")\n  }\n\n  let mimeType = getMimeType(normalizedPath)\n  return (200, mimeType, content)\n}\n\nfunc readFileContent(path: string) -> string {\n  // fs.readFile(path) 호출\n  // 실제 구현: fs 모듈에서 파일 내용 반환\n\n  if path == \"blog.html\" {\n    return \"<html><body><h1>FreeLang Blog</h1></body></html>\"\n  }\n\n  if path.startsWith(\"public/css/\") {\n    // CSS 파일 반환\n    return \"/* CSS Content */\"\n  }\n\n  if path.startsWith(\"frontend/\") {\n    // JavaScript 파일 반환\n    return \"// JavaScript Content\"\n  }\n\n  return \"\"\n}\n\nfunc getMimeType(filePath: string) -> string {\n  if filePath.endsWith(\".html\") {\n    return \"text/html; charset=utf-8\"\n  }\n  if filePath.endsWith(\".css\") {\n    return \"text/css; charset=utf-8\"\n  }\n  if filePath.endsWith(\".js\") {\n    return \"application/javascript; charset=utf-8\"\n  }\n  if filePath.endsWith(\".json\") {\n    return \"application/json; charset=utf-8\"\n  }\n  return \"text/plain\"\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 🔒 보안 함수\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc isPathSafe(path: string) -> bool {\n  // 절대 경로 차단\n  if path.startsWith(\"/\") {\n    return false\n  }\n\n  // 상위 디렉토리 접근 차단 (../)\n  if path.contains(\"..\") {\n    return false\n  }\n\n  // null byte 차단\n  if path.contains(\"\\0\") {\n    return false\n  }\n\n  // 숨김 파일 차단 (.env, .git, .htaccess 등)\n  if path.contains(\"/.\") {\n    return false\n  }\n  if path.startsWith(\".\") {\n    return false\n  }\n\n  // 허용된 확장자만\n  if isAllowedExtension(path) {\n    return true\n  }\n\n  return false\n}\n\nfunc isAllowedExtension(path: string) -> bool {\n  let allowedExts: [string] = [\n    \".html\", \".css\", \".js\", \".json\",\n    \".png\", \".jpg\", \".jpeg\", \".gif\", \".svg\",\n    \".woff\", \".woff2\", \".ttf\", \".eot\"\n  ]\n\n  for ext in allowedExts {\n    if path.endsWith(ext) {\n      return true\n    }\n  }\n\n  return false\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// HTTP 응답 생성\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc buildHTTPResponse(status: i32, contentType: string, body: string) -> string {\n  let statusText = \"OK\"\n  if status == 404 {\n    statusText = \"Not Found\"\n  }\n\n  let response = \"HTTP/1.1 \" + i32ToString(status) + \" \" + statusText + \"\\r\\n\"\n  response = response + \"Content-Type: \" + contentType + \"\\r\\n\"\n  response = response + \"Content-Length: \" + i32ToString(body.length()) + \"\\r\\n\"\n  response = response + \"Access-Control-Allow-Origin: *\\r\\n\"\n  response = response + \"Connection: close\\r\\n\"\n  response = response + \"\\r\\n\"\n  response = response + body\n\n  return response\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 서버 메인 루프\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc runServerLoop(server: HTTPServer) -> void {\n  while server.running {\n    // clientSocket = net.accept(server.socket)\n    // rawRequest = net.read(clientSocket)\n\n    // 요청 파싱\n    // (method, path, headers, body) = parseHTTPRequest(rawRequest)\n\n    // 요청 처리\n    // (statusCode, contentType, responseBody) = serveStaticFile(path)\n\n    // HTTP 응답 생성\n    // httpResponse = buildHTTPResponse(statusCode, contentType, responseBody)\n\n    // 응답 전송\n    // net.write(clientSocket, httpResponse)\n    // net.close(clientSocket)\n\n    server.requestCount = server.requestCount + 1\n\n    // 실제 구현에서는 블로킹 accept()\n    // 여기서는 시뮬레이션만 수행\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 유틸리티\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc i32ToString(n: i32) -> string {\n  if n == 0 {\n    return \"0\"\n  }\n\n  let negative = n < 0\n  let abs = if negative { -n } else { n }\n\n  let result = \"\"\n  let temp = abs\n  while temp > 0 {\n    let digit = temp % 10\n    let char = if digit == 0 { \"0\" }\n             else if digit == 1 { \"1\" }\n             else if digit == 2 { \"2\" }\n             else if digit == 3 { \"3\" }\n             else if digit == 4 { \"4\" }\n             else if digit == 5 { \"5\" }\n             else if digit == 6 { \"6\" }\n             else if digit == 7 { \"7\" }\n             else if digit == 8 { \"8\" }\n             else { \"9\" }\n    result = char + result\n    temp = temp / 10\n  }\n\n  if negative {\n    return \"-\" + result\n  }\n  return result\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 엔트리 포인트\n// ──────────────────────────────────────────────────────────────────────────\n\n// 메인 함수가 위에 정의되어 있음\n// freec http-main.free 로 컴파일\n// ./http-main 으로 실행\n","numLines":328,"startLine":1,"totalLines":328}},"sourceToolAssistantUUID":"073e01a1-85a5-45f7-b673-a0b33fea58fa","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
