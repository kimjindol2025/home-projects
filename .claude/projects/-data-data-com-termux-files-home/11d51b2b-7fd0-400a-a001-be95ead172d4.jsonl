se if (inSelector && line) {\n        // 속성 라인: key: value 형식\n        if (line.includes(':') && !line.startsWith(':')) {\n          const [key, ...valueParts] = line.split(':');\n          let value = valueParts.join(':').trim();\n\n          // 끝에 ;가 없으면 추가\n          if (!value.endsWith(';')) {\n            value += ';';\n          }\n\n          result += `  ${key.trim()}: ${value}\\n`;\n        }\n      }\n    }\n\n    return result;\n  }\n}\n\nmodule.exports = { CSSCompiler };\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"54762042-060a-4d9c-8d1c-12a1a1106a6f","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-light","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
