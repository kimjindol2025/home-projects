 increment() { const res = await fetch('/api/counter/increment', { method: 'POST' }); location.reload(); }","-        async function decrement() { const res = await fetch('/api/counter/decrement', { method: 'POST' }); location.reload(); }","-        async function reset() { const res = await fetch('/api/counter/reset', { method: 'POST' }); location.reload(); }","-        fetch('/api/counter').then(r => r.json()).then(d => document.getElementById('counter').innerText = d.data.count || '0');","+        async function increment() {","+            await fetch('/api/counter/increment', { method: 'POST' });","+            loadCounter();","+        }","+        async function decrement() {","+            await fetch('/api/counter/decrement', { method: 'POST' });","+            loadCounter();","+        }","+        async function reset() {","+            await fetch('/api/counter/reset', { method: 'POST' });","+            loadCounter();","+        }","+        function loadCounter() {","+            fetch('/api/counter').then(r => r.json()).then(d => {","+                document.getElementById('counter').innerText = d.data.count || '0';","+            });","+        }","+        loadCounter();","     </script>"," </body>"," </html>`"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"3495d311-e182-4b3f-a4a4-ee558a2f8157","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
