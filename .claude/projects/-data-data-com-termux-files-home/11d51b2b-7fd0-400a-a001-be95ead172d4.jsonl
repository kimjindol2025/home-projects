olorName]\n    for shade in colorObj {\n      let hexValue = colorObj[shade]\n      cssVars = cssVars + \"  --color-\\(colorName)-\\(shade): \\(hexValue);\\n\"\n    }\n  }\n\n  // Font size variables\n  cssVars = cssVars + \"\\n  /* Font Sizes */\\n\"\n  for sizeKey in fontSize {\n    let sizeValue = fontSize[sizeKey]\n    cssVars = cssVars + \"  --font-size-\\(sizeKey): \\(sizeValue);\\n\"\n  }\n\n  // Border radius variables\n  cssVars = cssVars + \"\\n  /* Border Radius */\\n\"\n  for radiusKey in borderRadius {\n    let radiusValue = borderRadius[radiusKey]\n    cssVars = cssVars + \"  --border-radius-\\(radiusKey): \\(radiusValue);\\n\"\n  }\n\n  // Shadow variables\n  cssVars = cssVars + \"\\n  /* Shadows */\\n\"\n  for shadowKey in shadows {\n    let shadowValue = shadows[shadowKey]\n    cssVars = cssVars + \"  --shadow-\\(shadowKey): \\(shadowValue);\\n\"\n  }\n\n  // Transition defaults\n  cssVars = cssVars + \"\\n  /* Transitions */\\n\"\n  cssVars = cssVars + \"  --duration-default: 200ms;\\n\"\n  cssVars = cssVars + \"  --timing-default: ease-in-out;\\n\"\n\n  cssVars = cssVars + \"}\\n\"\n\n  return cssVars\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Reset/Normalize CSS\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateResetCSS() -> any {\n  let resetCSS = \"/* Reset & Normalize */\\n\"\n    + \"* {\\n\"\n    + \"  margin: 0;\\n\"\n    + \"  padding: 0;\\n\"\n    + \"  box-sizing: border-box;\\n\"\n    + \"}\\n\\n\"\n    + \"html {\\n\"\n    + \"  -webkit-font-smoothing: antialiased;\\n\"\n    + \"  -moz-osx-font-smoothing: grayscale;\\n\"\n    + \"}\\n\\n\"\n    + \"body {\\n\"\n    + \"  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;\\n\"\n    + \"  line-height: 1.5;\\n\"\n    + \"  color: #1f2937;\\n\"\n    + \"  background-color: #ffffff;\\n\"\n    + \"}\\n\\n\"\n    + \"img {\\n\"\n    + \"  max-width: 1