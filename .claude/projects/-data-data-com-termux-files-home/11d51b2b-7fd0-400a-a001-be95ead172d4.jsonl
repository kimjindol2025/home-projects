{"parentUuid":"222b43bd-6b80-4676-b8ac-ba66de1b8b80","isSidechain":false,"message":{"model":"claude-haiku-4-5-20251001","id":"msg_01WXuVfokXmyZ55Bmvt6VKBq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016PwK4B93SfoThXsA3xR8nn","name":"Write","input":{"file_path":"/data/data/com.termux/files/home/freelang-hybrid/freelang/core/circuit-breaker.js","content":"// ============================================================================\n// FreeLang Phase 5: Circuit Breaker Pattern with Weighted Load Balancing\n// ============================================================================\n\n// Circuit Breaker States\nconst STATE = {\n  CLOSED: 'CLOSED',           // Normal operation, requests pass through\n  OPEN: 'OPEN',               // Failure detected, fast-fail\n  HALF_OPEN: 'HALF_OPEN'      // Recovery attempt, single request allowed\n};\n\nclass CircuitBreaker {\n  constructor(options = {}) {\n    this.failureThreshold = options.failureThreshold || 5;      // Failures before OPEN\n    this.successThreshold = options.successThreshold || 2;      // Successes to CLOSED\n    this.timeout = options.timeout || 60000;                    // Timeout before HALF_OPEN\n    this.monitoringPeriod = options.monitoringPeriod || 10000;  // Period to reset counter\n\n    this.state = STATE.CLOSED;\n    this.failureCount = 0;\n    this.successCount = 0;\n    this.lastFailureTime = null;\n    this.nextAttemptTime = null;\n    this.totalCalls = 0;\n    this.totalFailures = 0;\n    this.metrics = [];\n\n    this.onStateChange = options.onStateChange || (() => {});\n  }\n\n  isCallable() {\n    if (this.state === STATE.CLOSED) return true;\n    if (this.state === STATE.OPEN) {\n      if (Date.now() >= this.nextAttemptTime) {\n        this.transitionTo(STATE.HALF_OPEN);\n        return true;\n      }\n      return false;\n    }\n    if (this.state === STATE.HALF_OPEN) return true;\n    return false;\n  }\n\n  recordSuccess() {\n    this.totalCalls++;\n    this.logMetric('SUCCESS');\n\n    if (this.state === STATE.HALF_OPEN) {\n      this.successCount++;\n      if (this.successCount >= this.successThreshold) {\n        this.transitionTo(STATE.CLOSED);\n        this.failureCount = 0;\n        this.successCount = 0;\n      }\n    } else if (this.state === STATE.CLOSED) {\n      this.failureCount = Math.max(0, this.failureCount - 1);\n    }\n  }\n\n  recordFailure() {\n    this.totalCalls++;\n    this.totalFailures++;\n    this.failureCount++;\n    this.lastFailureTime = Date.now();\n    this.logMetric('FAILURE');\n\n    if (this.state === STATE.HALF_OPEN) {\n      this.transitionTo(STATE.OPEN);\n      this.successCount = 0;\n    } else if (this.state === STATE.CLOSED && this.failureCount >= this.failureThreshold) {\n      this.transitionTo(STATE.OPEN);\n      this.nextAttemptTime = Date.now() + this.timeout;\n    }\n  }\n\n  transitionTo(newState) {\n    const oldState = this.state;\n    this.state = newState;\n\n    console.log(`🔄 Circuit Breaker: ${oldState} → ${newState}`);\n    this.onStateChange({\n      from: oldState,\n      to: newState,\n      timestamp: new Date().toISOString()\n    });\n  }\n\n  logMetric(status) {\n    this.metrics.push({\n      timestamp: new Date().toISOString(),\n      status,\n      state: this.state,\n      failureCount: this.failureCount\n    });\n\n    // Keep last 1000 metrics\n    if (this.metrics.length > 1000) {\n      this.metrics.shift();\n    }\n  }\n\n  getStatus() {\n    const successRate = this.totalCalls > 0\n      ? ((this.totalCalls - this.totalFailures) / this.totalCalls * 100).toFixed(2)\n      : 100;\n\n    return {\n      state: this.state,\n      failureCount: this.failureCount,\n      successCount: this.successCount,\n      totalCalls: this.totalCalls,\n      totalFailures: this.totalFailures,\n      successRate: `${successRate}%`,\n      lastFailureTime: this.lastFailureTime,\n      nextAttemptTime: this.nextAttemptTime,\n      metrics: this.metrics.slice(-10)\n    };\n  }\n\n  reset() {\n    this.state = STATE.CLOSED;\n    this.failureCount = 0;\n    this.successCount = 0;\n    this.lastFailureTime = null;\n    this.nextAttemptTime = null;\n    console.log('🔄 Circuit Breaker reset to CLOSED');\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Service with Weighted Load Balancing\n// ──────────────────────────────────────────────────────────────────────────\n\nclass Service {\n  constructor(name, host, port, weight = 1) {\n    this.name = name;\n    this.host = host;\n    this.port = port;\n    this.weight = weight;  // Higher weight = higher chance of selection\n    this.breaker = new CircuitBreaker({\n      failureThreshold: 5,\n      successThreshold: 2,\n      timeout: 30000\n    });\n    this.requestCount = 0;\n    this.averageResponseTime = 0;\n  }\n\n  isHealthy() {\n    return this.breaker.state !== STATE.OPEN;\n  }\n\n  isCallable() {\n    return this.breaker.isCallable();\n  }\n\n  getScore() {\n    // Score = weight * health * response_time_factor\n    const healthFactor = this.breaker.state === STATE.CLOSED ? 1.0 : 0.5;\n    const responseTimeFactor = Math.max(0.1, 1.0 / (1 + this.averageResponseTime / 100));\n    return this.weight * healthFactor * responseTimeFactor;\n  }\n\n  recordCall(success, responseTime = 0) {\n    this.requestCount++;\n    if (success) {\n      this.breaker.recordSuccess();\n    } else {\n      this.breaker.recordFailure();\n    }\n\n    // Exponential moving average for response time\n    this.averageResponseTime = (this.averageResponseTime * 0.9) + (responseTime * 0.1);\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Service Registry with Load Balancing\n// ──────────────────────────────────────────────────────────────────────────\n\nclass ServiceRegistry {\n  constructor() {\n    this.services = new Map();\n    this.callHistory = [];\n    this.totalCalls = 0;\n  }\n\n  registerService(name, host, port, weight = 1) {\n    if (this.services.has(name)) {\n      console.warn(`⚠️ Service '${name}' already registered`);\n      return false;\n    }\n\n    const service = new Service(name, host, port, weight);\n    this.services.set(name, service);\n\n    console.log(`✅ Service registered: ${name} (${host}:${port}, weight=${weight})`);\n    return true;\n  }\n\n  deregisterService(name) {\n    if (this.services.delete(name)) {\n      console.log(`✅ Service deregistered: ${name}`);\n      return true;\n    }\n    return false;\n  }\n\n  // Weighted round-robin selection\n  selectService(serviceName) {\n    const instance = this.services.get(serviceName);\n    if (!instance) {\n      return { success: false, error: `Service '${serviceName}' not found` };\n    }\n\n    // Get all callable instances of this service\n    const callableInstances = [instance].filter(s => s.isCallable());\n\n    if (callableInstances.length === 0) {\n      return {\n        success: false,\n        error: `No callable instances of '${serviceName}' available`,\n        breakerState: instance.breaker.state\n      };\n    }\n\n    // Select by weight score\n    const selectedService = this.weightedSelect(callableInstances);\n    return { success: true, service: selectedService };\n  }\n\n  weightedSelect(services) {\n    if (services.length === 1) return services[0];\n\n    // Weighted selection\n    const totalScore = services.reduce((sum, s) => sum + s.getScore(), 0);\n    let random = Math.random() * totalScore;\n\n    for (const service of services) {\n      random -= service.getScore();\n      if (random <= 0) return service;\n    }\n\n    return services[0];\n  }\n\n  async callService(serviceName, options = {}) {\n    const startTime = Date.now();\n\n    // 1. Select service instance\n    const selection = this.selectService(serviceName);\n    if (!selection.success) {\n      this.totalCalls++;\n      this.logCall(serviceName, false, 0, selection.error);\n      return selection;\n    }\n\n    const service = selection.service;\n\n    try {\n      // 2. Simulate service call (replace with actual HTTP/RPC call)\n      const result = await this.simulateServiceCall(service, options);\n\n      // 3. Record success\n      const responseTime = Date.now() - startTime;\n      service.recordCall(true, responseTime);\n      this.totalCalls++;\n      this.logCall(serviceName, true, responseTime);\n\n      return {\n        success: true,\n        data: result,\n        service: `${service.host}:${service.port}`,\n        responseTime,\n        breaker: service.breaker.getStatus()\n      };\n    } catch (error) {\n      // Record failure\n      const responseTime = Date.now() - startTime;\n      service.recordCall(false, responseTime);\n      this.totalCalls++;\n      this.logCall(serviceName, false, responseTime, error.message);\n\n      return {\n        success: false,\n        error: error.message,\n        service: `${service.host}:${service.port}`,\n        responseTime,\n        breaker: service.breaker.getStatus()\n      };\n    }\n  }\n\n  async simulateServiceCall(service, options = {}) {\n    // Simulate varying response times and occasional failures\n    const delay = Math.random() * 100;\n    const failureRate = 0.1;  // 10% failure rate for testing\n\n    return new Promise((resolve, reject) => {\n      setTimeout(() => {\n        if (Math.random() < failureRate) {\n          reject(new Error(`Service call failed (simulated)`));\n        } else {\n          resolve({\n            service: service.name,\n            timestamp: new Date().toISOString(),\n            data: options.data || {},\n            delay\n          });\n        }\n      }, delay);\n    });\n  }\n\n  healthCheck(serviceName) {\n    const service = this.services.get(serviceName);\n    if (!service) {\n      return { success: false, error: `Service '${serviceName}' not found` };\n    }\n\n    return {\n      success: true,\n      service: serviceName,\n      host: service.host,\n      port: service.port,\n      healthy: service.isHealthy(),\n      breaker: {\n        state: service.breaker.state,\n        failureCount: service.breaker.failureCount,\n        successRate: service.breaker.getStatus().successRate\n      },\n      metrics: {\n        requestCount: service.requestCount,\n        averageResponseTime: service.averageResponseTime.toFixed(2) + 'ms'\n      }\n    };\n  }\n\n  healthCheckAll() {\n    const results = [];\n    for (const [name] of this.services) {\n      results.push(this.healthCheck(name));\n    }\n    return results;\n  }\n\n  logCall(serviceName, success, responseTime, error = null) {\n    this.callHistory.push({\n      timestamp: new Date().toISOString(),\n      service: serviceName,\n      success,\n      responseTime,\n      error\n    });\n\n    // Keep last 1000 calls\n    if (this.callHistory.length > 1000) {\n      this.callHistory.shift();\n    }\n  }\n\n  getMetrics() {\n    const successfulCalls = this.callHistory.filter(c => c.success).length;\n    const failedCalls = this.callHistory.filter(c => !c.success).length;\n    const avgResponseTime = this.callHistory.length > 0\n      ? (this.callHistory.reduce((sum, c) => sum + c.responseTime, 0) / this.callHistory.length).toFixed(2)\n      : 0;\n\n    const serviceMetrics = {};\n    for (const [name, service] of this.services) {\n      serviceMetrics[name] = {\n        healthy: service.isHealthy(),\n        state: service.breaker.state,\n        weight: service.weight,\n        requestCount: service.requestCount,\n        averageResponseTime: service.averageResponseTime.toFixed(2)\n      };\n    }\n\n    return {\n      totalCalls: this.totalCalls,\n      successfulCalls,\n      failedCalls,\n      successRate: this.totalCalls > 0\n        ? ((successfulCalls / this.totalCalls) * 100).toFixed(2) + '%'\n        : '100%',\n      averageResponseTime: avgResponseTime + 'ms',\n      serviceCount: this.services.size,\n      healthyServices: Array.from(this.services.values()).filter(s => s.isHealthy()).length,\n      services: serviceMetrics\n    };\n  }\n\n  // Retries with exponential backoff\n  async callServiceWithRetry(serviceName, options = {}, maxRetries = 3) {\n    let lastError;\n\n    for (let attempt = 0; attempt < maxRetries; attempt++) {\n      const result = await this.callService(serviceName, options);\n\n      if (result.success) {\n        result.attempts = attempt + 1;\n        return result;\n      }\n\n      lastError = result;\n\n      if (attempt < maxRetries - 1) {\n        // Exponential backoff: 100ms, 200ms, 400ms\n        const backoffMs = Math.pow(2, attempt) * 100;\n        await new Promise(resolve => setTimeout(resolve, backoffMs));\n      }\n    }\n\n    lastError.attempts = maxRetries;\n    return lastError;\n  }\n\n  reset() {\n    this.services.forEach(service => service.breaker.reset());\n    this.callHistory = [];\n    this.totalCalls = 0;\n    console.log('✅ Service registry reset');\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Helper Functions\n// ──────────────────────────────────────────────────────────────────────────\n\nasync function createRegistryWithServices() {\n  const registry = new ServiceRegistry();\n\n  // Register services with different weights\n  registry.registerService('api-gateway', '127.0.0.1', 8000, 2);      // High weight\n  registry.registerService('auth-service', '127.0.0.1', 8001, 1);\n  registry.registerService('data-service', '127.0.0.1', 8002, 1.5);\n\n  return registry;\n}\n\n// Export\nmodule.exports = {\n  CircuitBreaker,\n  Service,\n  ServiceRegistry,\n  STATE,\n  createRegistryWithServices\n};\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":4654,"cache_read_input_tokens":101119,"output_tokens":4073,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1