stPath = path.join(bundleDir, `${this.options.bundleName}.manifest.json`);\n    fs.writeFileSync(manifestPath, JSON.stringify(this.manifest, null, 2));\n    console.log(`   ✅ Generated: ${this.options.bundleName}.manifest.json`);\n\n    // 소스맵 생성\n    if (this.options.sourcemap) {\n      this.generateSourceMaps(bundleDir);\n    }\n\n    console.log(`\\n✨ Bundling complete!\\n`);\n\n    return {\n      css: cssPath,\n      js: jsPath,\n      html: htmlPath,\n      manifest: manifestPath,\n      stats: this.getStats()\n    };\n  }\n\n  /**\n   * CSS 번들 생성\n   */\n  generateCSSBundle() {\n    let css = '/* FreeLang Light - Bundled CSS */\\n';\n    css += `/* Generated: ${new Date().toISOString()} */\\n`;\n    css += `/* Components: ${this.manifest.components.join(', ')} */\\n\\n`;\n\n    // 각 컴포넌트의 CSS 합치기\n    this.assets.css.forEach(asset => {\n      css += `/* Component: ${asset.name} */\\n`;\n      css += asset.content + '\\n\\n';\n    });\n\n    // 최소화\n    if (this.options.minify) {\n      css = this.minifyCSS(css);\n    }\n\n    return css;\n  }\n\n  /**\n   * JavaScript 번들 생성\n   */\n  generateJSBundle() {\n    let js = '// FreeLang Light - Bundled JavaScript\\n';\n    js += `// Generated: ${new Date().toISOString()}\\n`;\n    js += `// Components: ${this.manifest.components.join(', ')}\\n\\n`;\n\n    js += '(function() {\\n';\n    js += '  \"use strict\";\\n\\n';\n\n    // 각 컴포넌트의 JS 함수 합치기\n    this.assets.js.forEach(asset => {\n      js += `  // Component: ${asset.name}\\n`;\n      js += this.indentCode(asset.content, 2) + '\\n\\n';\n    });\n\n    js += '})();\\n';\n\n    // 최소화\n    if (this.options.minify) {\n      js = this.minifyJS(js);\n    }\n\n    return js;\n  }\n\n  /**\n   * HTML 번들 생성\n   */\n  generateHTMLBundle() {\n    let html = '<!DOCTYPE html>\\n';\n    html += '<html lang=\"ko\">\\n';\n    html += '<head>\\n';\n    html += '  <meta charset=\"UTF-8\">\\n';\n    html += '  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\\n';\n    html += `  <title>FreeLang Light - ${this.options.bundleName}</title>\\n`;\n    html += `  <link rel=\"stylesheet\" href=\"${this.options.bundleName}.css\">\\n`;\n    html += '</head>\\n';\n    html += '<body>\\n\\n';\n\n    // 컴포넌트 마크업 합치기\n    this.assets.html.forEach(asset => {\n      html += `  <!-- Component: ${asset.name} -->\\n`;\n      html += this.indentCode(asset.content, 2) + '\\n\\n';\n    });\n\n    html += `  <script src=\"${this.options.bundleName}.js\"><\\/script>\\n`;\n    html += '</body>\\n';\n    html += '</html>\\n';\n\n    return html;\n  }\n\n  /**\n   * CSS 최소화\n   */\n  minifyCSS(css) {\n    return css\n      // 주석 제거\n      .replace(/\\/\\*[\\s\\S]*?\\*\\//g, '')\n      // 불필요한 공백 제거\n      .replace(/\\s+/g, ' ')\n      .replace(/\\s*[{}:;,]\\s*/g, match => match.trim())\n      // 빈 줄 제거\n      .replace(/^\\s*\\n/gm, '')\n      .trim();\n  }\n\n  /**\n   * JavaScript 최소화\n   */\n  minifyJS(js) {\n    return js\n      // 단일 줄 주석 제거\n      .replace(/\\/\\/.*$/gm, '')\n      // 다중 줄 주석 제거\n      .replace(/\\/\\*[\\s\\S]*?\\*\\//g, '')\n      // 불필요한 공백 제거\n      .replace(/\\s+/g, ' ')\n      // 줄바꿈 정리\n      .replace(/;\\s*/g, ';')\n      .replace(/\\s*[{}()[\\],]\\s*/g, match => match.trim())\n      .trim();\n  }\n\n  /**\n   * 소스맵 생성\n   */\n  generateSourceMaps(bundleDir) {\n    const cssMap = {\n      version: 3,\n      sources: this.assets.css.map(a => a.file),\n      sourcesContent: this.assets.css.map(a => a.content),\n      mappings: ''\n    };\n\n    const jsMap = {\n      version: 3,\n      sources: this.assets.js.map(a => a.file),\n      sourcesContent: this.assets.js.map(a => a.content),\n      mappings: ''\n    };\n\n    fs.writeFileSync(\n      path.join(bundleDir, `${this.options.bundleName}.css.map`),\n      JSON.stringify(cssMap)\n    );\n\n    fs.writeFileSync(\n      path.join(bundleDir, `${this.options.bundleName}.js.map`),\n      JSON.stringify(jsMap)\n    );\n\n    console.log(`   ✅ Source maps generated`)