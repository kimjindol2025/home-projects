// Metrics & Analytics\n  // ──────────────────────────────────────────────────────────────────────────\n\n  getMetrics() {\n    return {\n      timestamp: Date.now(),\n      subscriptions: {\n        total: this.metrics.totalSubscriptions,\n        active: this.metrics.activeSubscriptions,\n        byProtocol: this.metrics.protocolDistribution\n      },\n      channels: {\n        total: this.metrics.totalChannels,\n        list: this.getAllChannels()\n      },\n      events: {\n        total: this.metrics.totalEvents,\n        logged: this.eventLog.filter(e => e.expiresAt > Date.now()).length,\n        maxLogSize: this.maxEventLogSize\n      },\n      subscriptionDetails: Array.from(this.subscriptions.entries()).map(([id, sub]) => ({\n        subscriptionId: id,\n        channel: sub.channel,\n        protocol: sub.protocol,\n        clientId: sub.clientId,\n        messageCount: sub.metadata.messageCount,\n        subscribedFor: Date.now() - sub.metadata.subscribedAt,\n        lastMessage: sub.metadata.lastMessageAt ?\n          Date.now() - sub.metadata.lastMessageAt : null\n      }))\n    };\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Multi-protocol Integration\n  // ──────────────────────────────────────────────────────────────────────────\n\n  // WebSocket → Subscription\n  createWebSocketSubscription(clientId, room, wsCallback) {\n    return this.subscribe(room, wsCallback, {\n      protocol: 'websocket',\n      clientId\n    });\n  }\n\n  // SSE → Subscription\n  createSSESubscription(clientId, channel, sseCallback) {\n    return this.subscribe(channel, sseCallback, {\n      protocol: 'sse',\n      clientId\n    });\n  }\n\n  // GraphQL → Subscription\n  createGraphQLSubscription(clientId, channel, graphqlCallback) {\n    return this.subscribe(channel, graphqlCallback, {\n      protocol: 'graphql',\n      clientId\n    });\n  }\n\n  // 프로토콜 변환 (cross-protocol 메시징)\n  broadcastAcrossProtocols(channel, event, data) {\n    const channelSubs = this.channels.get(channel);\n    if (!channelSubs) return;\n\n    const protocols = {};\n    for (const subId of channelSubs) {\n      const sub = this.subscriptions.get(subId);\n      if (sub) {\n        if (!protocols[sub.protocol]) protocols[sub.protocol] = [];\n        protocols[sub.protocol].push(sub);\n      }\n    }\n\n    this.emit('broadcast_started', { channel, event, protocols });\n\n    // 각 프로토콜별로 이벤트 전송\n    for (const protocol in protocols) {\n      protocols[protocol].forEach(subscription => {\n        this.publish(channel, event, data);\n      });\n    }\n\n    this.emit('broadcast_completed', { channel, event, protocolCount: Object.keys(protocols).length });\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Utilities\n  // ──────────────────────────────────────────────────────────────────────────\n\n  generateSubscriptionId() {\n    return 'sub_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);\n  }\n\n  generateEventId() {\n    return 'evt_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);\n  }\n\n  getClientSubscriptions(clientId) {\n    return Array.from(this.subscriptions.entries())\n      .filter(([_, sub]) => sub.clientId === clientId)\n      .map(([id, sub]) => ({\n        subscriptionId: id,\n        channel: sub.channel,\n        protocol: sub.protocol,\n        messageCount: sub.metadata.messageCount\n      }));\n  }\n\n  // 통계 리셋\n  resetMetrics() {\n    this.metrics = {\n      totalSubscriptions: this.subscriptions.size,\n      activeSubscriptions: this.subscriptions.size,\n      totalChannels: this.channels.size,\n      totalEvents: 0,\n      protocolDistribution: {\n        websocket: 0,\n        sse: 0,\n        graphql: 0\n      }\n    };\n\n    // 활성 프로토콜 다시 계산\n    for (const sub of this.subscriptions.values()) {\n      this.metrics.protocolDistribution[sub.protocol]++;\n    }\n  }\n\n  // 전체 상태 정리\n  shutdown() {\n    // 모든 구독 취