{"parentUuid":"d6c37510-a33e-46d2-8216-60c517d7aec9","isSidechain":false,"message":{"model":"claude-haiku-4-5-20251001","id":"msg_0154UVF3ReutEHowRTrHwz3t","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DZvt3tWXB7vmkaWohGi3qV","name":"Write","input":{"file_path":"/data/data/com.termux/files/home/freelang-light/src/bundler.js","content":"/**\n * FreeLang Light Bundler\n * CSS/JS/HTML 병합 및 최적화\n */\n\nconst fs = require('fs');\nconst path = require('path');\nconst crypto = require('crypto');\n\nclass Bundler {\n  constructor(options = {}) {\n    this.options = {\n      minify: options.minify !== false,\n      sourcemap: options.sourcemap === true,\n      bundleName: options.bundleName || 'app',\n      outputDir: options.outputDir || '.',\n      ...options\n    };\n\n    this.assets = {\n      css: [],\n      js: [],\n      html: []\n    };\n\n    this.manifest = {\n      version: '1.0',\n      components: [],\n      bundled_at: new Date().toISOString(),\n      checksums: {}\n    };\n  }\n\n  /**\n   * 여러 컴포넌트 번들링\n   */\n  bundleComponents(componentFiles) {\n    console.log(`\\n📦 Bundling ${componentFiles.length} components...\\n`);\n\n    componentFiles.forEach(file => {\n      this.bundleComponent(file);\n    });\n\n    return this.generate();\n  }\n\n  /**\n   * 단일 컴포넌트 번들링\n   */\n  bundleComponent(filePath) {\n    if (!fs.existsSync(filePath)) {\n      console.warn(`⚠️  File not found: ${filePath}`);\n      return;\n    }\n\n    const name = path.basename(filePath, '.free');\n\n    // CSS 로드\n    const cssFile = path.join(path.dirname(filePath), `${name}.css`);\n    if (fs.existsSync(cssFile)) {\n      const css = fs.readFileSync(cssFile, 'utf-8');\n      this.assets.css.push({ name, content: css, file: cssFile });\n      console.log(`   ✅ CSS: ${name}.css`);\n    }\n\n    // JavaScript 로드\n    const jsFile = path.join(path.dirname(filePath), `${name}.js`);\n    if (fs.existsSync(jsFile)) {\n      const js = fs.readFileSync(jsFile, 'utf-8');\n      this.assets.js.push({ name, content: js, file: jsFile });\n      console.log(`   ✅ JS: ${name}.js`);\n    }\n\n    // HTML 로드\n    const htmlFile = path.join(path.dirname(filePath), `${name}.html`);\n    if (fs.existsSync(htmlFile)) {\n      const html = fs.readFileSync(htmlFile, 'utf-8');\n      this.assets.html.push({ name, content: html, file: htmlFile });\n      console.log(`   ✅ HTML: ${name}.html`);\n    }\n\n    this.manifest.components.push(name);\n  }\n\n  /**\n   * 번들 생성\n   */\n  generate() {\n    console.log(`\\n🔗 Generating bundles...\\n`);\n\n    const bundleDir = this.options.outputDir;\n    if (!fs.existsSync(bundleDir)) {\n      fs.mkdirSync(bundleDir, { recursive: true });\n    }\n\n    // CSS 번들\n    const cssBundle = this.generateCSSBundle();\n    const cssPath = path.join(bundleDir, `${this.options.bundleName}.css`);\n    fs.writeFileSync(cssPath, cssBundle);\n    this.manifest.checksums.css = this.calculateHash(cssBundle);\n    console.log(`   ✅ Generated: ${this.options.bundleName}.css (${cssBundle.length} bytes)`);\n\n    // JavaScript 번들\n    const jsBundle = this.generateJSBundle();\n    const jsPath = path.join(bundleDir, `${this.options.bundleName}.js`);\n    fs.writeFileSync(jsPath, jsBundle);\n    this.manifest.checksums.js = this.calculateHash(jsBundle);\n    console.log(`   ✅ Generated: ${this.options.bundleName}.js (${jsBundle.length} bytes)`);\n\n    // HTML 번들\n    const htmlBundle = this.generateHTMLBundle();\n    const htmlPath = path.join(bundleDir, `${this.options.bundleName}.html`);\n    fs.writeFileSync(htmlPath, htmlBundle);\n    this.manifest.checksums.html = this.calculateHash(htmlBundle);\n    console.log(`   ✅ Generated: ${this.options.bundleName}.html (${htmlBundle.length} bytes)`);\n\n    // Manifest 저장\n    const manifestPath = path.join(bundleDir, `${this.options.bundleName}.manifest.json`);\n    fs.writeFileSync(manifestPath, JSON.stringify(this.manifest, null, 2));\n    console.log(`   ✅ Generated: ${this.options.bundleName}.manifest.json`);\n\n    // 소스맵 생성\n    if (this.options.sourcemap) {\n      this.generateSourceMaps(bundleDir);\n    }\n\n    console.log(`\\n✨ Bundling complete!\\n`);\n\n    return {\n      css: cssPath,\n      js: jsPath,\n      html: htmlPath,\n      manifest: manifestPath,\n      stats: this.getStats()\n    };\n  }\n\n  /**\n   * CSS 번들 생성\n   */\n  generateCSSBundle() {\n    let css = '/* FreeLang Light - Bundled CSS */\\n';\n    css += `/* Generated: ${new Date().toISOString()} */\\n`;\n    css += `/* Components: ${this.manifest.components.join(', ')} */\\n\\n`;\n\n    // 각 컴포넌트의 CSS 합치기\n    this.assets.css.forEach(asset => {\n      css += `/* Component: ${asset.name} */\\n`;\n      css += asset.content + '\\n\\n';\n    });\n\n    // 최소화\n    if (this.options.minify) {\n      css = this.minifyCSS(css);\n    }\n\n    return css;\n  }\n\n  /**\n   * JavaScript 번들 생성\n   */\n  generateJSBundle() {\n    let js = '// FreeLang Light - Bundled JavaScript\\n';\n    js += `// Generated: ${new Date().toISOString()}\\n`;\n    js += `// Components: ${this.manifest.components.join(', ')}\\n\\n`;\n\n    js += '(function() {\\n';\n    js += '  \"use strict\";\\n\\n';\n\n    // 각 컴포넌트의 JS 함수 합치기\n    this.assets.js.forEach(asset => {\n      js += `  // Component: ${asset.name}\\n`;\n      js += this.indentCode(asset.content, 2) + '\\n\\n';\n    });\n\n    js += '})();\\n';\n\n    // 최소화\n    if (this.options.minify) {\n      js = this.minifyJS(js);\n    }\n\n    return js;\n  }\n\n  /**\n   * HTML 번들 생성\n   */\n  generateHTMLBundle() {\n    let html = '<!DOCTYPE html>\\n';\n    html += '<html lang=\"ko\">\\n';\n    html += '<head>\\n';\n    html += '  <meta charset=\"UTF-8\">\\n';\n    html += '  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\\n';\n    html += `  <title>FreeLang Light - ${this.options.bundleName}</title>\\n`;\n    html += `  <link rel=\"stylesheet\" href=\"${this.options.bundleName}.css\">\\n`;\n    html += '</head>\\n';\n    html += '<body>\\n\\n';\n\n    // 컴포넌트 마크업 합치기\n    this.assets.html.forEach(asset => {\n      html += `  <!-- Component: ${asset.name} -->\\n`;\n      html += this.indentCode(asset.content, 2) + '\\n\\n';\n    });\n\n    html += `  <script src=\"${this.options.bundleName}.js\"><\\/script>\\n`;\n    html += '</body>\\n';\n    html += '</html>\\n';\n\n    return html;\n  }\n\n  /**\n   * CSS 최소화\n   */\n  minifyCSS(css) {\n    return css\n      // 주석 제거\n      .replace(/\\/\\*[\\s\\S]*?\\*\\//g, '')\n      // 불필요한 공백 제거\n      .replace(/\\s+/g, ' ')\n      .replace(/\\s*[{}:;,]\\s*/g, match => match.trim())\n      // 빈 줄 제거\n      .replace(/^\\s*\\n/gm, '')\n      .trim();\n  }\n\n  /**\n   * JavaScript 최소화\n   */\n  minifyJS(js) {\n    return js\n      // 단일 줄 주석 제거\n      .replace(/\\/\\/.*$/gm, '')\n      // 다중 줄 주석 제거\n      .replace(/\\/\\*[\\s\\S]*?\\*\\//g, '')\n      // 불필요한 공백 제거\n      .replace(/\\s+/g, ' ')\n      // 줄바꿈 정리\n      .replace(/;\\s*/g, ';')\n      .replace(/\\s*[{}()[\\],]\\s*/g, match => match.trim())\n      .trim();\n  }\n\n  /**\n   * 소스맵 생성\n   */\n  generateSourceMaps(bundleDir) {\n    const cssMap = {\n      version: 3,\n      sources: this.assets.css.map(a => a.file),\n      sourcesContent: this.assets.css.map(a => a.content),\n      mappings: ''\n    };\n\n    const jsMap = {\n      version: 3,\n      sources: this.assets.js.map(a => a.file),\n      sourcesContent: this.assets.js.map(a => a.content),\n      mappings: ''\n    };\n\n    fs.writeFileSync(\n      path.join(bundleDir, `${this.options.bundleName}.css.map`),\n      JSON.stringify(cssMap)\n    );\n\n    fs.writeFileSync(\n      path.join(bundleDir, `${this.options.bundleName}.js.map`),\n      JSON.stringify(jsMap)\n    );\n\n    console.log(`   ✅ Source maps generated`);\n  }\n\n  /**\n   * 해시값 계산 (무결성 검증)\n   */\n  calculateHash(content) {\n    return crypto.createHash('sha256').update(content).digest('hex').slice(0, 8);\n  }\n\n  /**\n   * 코드 들여쓰기\n   */\n  indentCode(code, spaces) {\n    const indent = ' '.repeat(spaces);\n    return code.split('\\n')\n      .map(line => line ? indent + line : line)\n      .join('\\n');\n  }\n\n  /**\n   * 번들 통계\n   */\n  getStats() {\n    const cssSize = this.assets.css.reduce((sum, a) => sum + a.content.length, 0);\n    const jsSize = this.assets.js.reduce((sum, a) => sum + a.content.length, 0);\n    const htmlSize = this.assets.html.reduce((sum, a) => sum + a.content.length, 0);\n\n    return {\n      components: this.manifest.components.length,\n      css_files: this.assets.css.length,\n      js_files: this.assets.js.length,\n      html_files: this.assets.html.length,\n      total_size_uncompressed: cssSize + jsSize + htmlSize,\n      css_size: cssSize,\n      js_size: jsSize,\n      html_size: htmlSize\n    };\n  }\n}\n\nmodule.exports = { Bundler };\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":10,"cache_creation_input_tokens":265,"cache_read_input_tokens":139014,"output_tokens":3276,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":265,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"}},"requestId":"req_011CYxnBvDMEvAeqLxP2oDTn","type":"assistant","uuid":"4d09888c-fef2-49bb-a5a9-61775388612b","timestamp":"2026-03-12T07:20:18.867Z","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-light","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
