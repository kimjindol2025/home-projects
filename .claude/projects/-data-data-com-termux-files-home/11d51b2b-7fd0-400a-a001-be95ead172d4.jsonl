{"parentUuid":"7a38141a-6e40-4cb2-885c-d193217411b3","isSidechain":false,"message":{"model":"claude-haiku-4-5-20251001","id":"msg_01TNqDRC6owKm3SnboFJi2Zn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TVLGohmqZfUg6tcyc7QJp8","name":"Write","input":{"file_path":"/data/data/com.termux/files/home/freelang-hybrid/freelang/core/css-generator.free","content":"// ============================================================================\n// FreeLang CSS Generator: 동적 CSS 생성 엔진\n// 테마 변수, 유틸리티 클래스, 반응형 디자인\n// ============================================================================\n\nuse \\\"../core/types\\\"\n\n// ──────────────────────────────────────────────────────────────────────────\n// 테마 설정\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc getThemeColors() -> any {\n  return {\n    primary: \\\"#667eea\\\",\n    secondary: \\\"#764ba2\\\",\n    success: \\\"#48bb78\\\",\n    warning: \\\"#ed8936\\\",\n    danger: \\\"#f56565\\\",\n    info: \\\"#4299e1\\\",\n    light: \\\"#f7fafc\\\",\n    dark: \\\"#1a202c\\\",\n    muted: \\\"#cbd5e0\\\"\n  }\n}\n\nfunc getThemeSpacing() -> any {\n  return {\n    xs: \\\"4px\\\",\n    sm: \\\"8px\\\",\n    md: \\\"16px\\\",\n    lg: \\\"24px\\\",\n    xl: \\\"32px\\\",\n    xxl: \\\"48px\\\"\n  }\n}\n\nfunc getThemeFonts() -> any {\n  return {\n    primary: \\\"-apple-system, BlinkMacSystemFont, sans-serif\\\",\n    mono: \\\"Menlo, Monaco, 'Courier New', monospace\\\",\n    serif: \\\"Georgia, serif\\\"\n  }\n}\n\nfunc getThemeBreakpoints() -> any {\n  return {\n    xs: \\\"320px\\\",\n    sm: \\\"640px\\\",\n    md: \\\"768px\\\",\n    lg: \\\"1024px\\\",\n    xl: \\\"1280px\\\"\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 유틸리티 클래스 생성\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateUtilityClasses() -> string {\n  let colors = getThemeColors()\n  let spacing = getThemeSpacing()\n  let css = \\\"\\\"\n\n  // Margin 유틸리티\n  css = css + `\n/* Margin Utilities */\n.m-0 { margin: 0; }\n.m-xs { margin: 4px; }\n.m-sm { margin: 8px; }\n.m-md { margin: 16px; }\n.m-lg { margin: 24px; }\n.m-xl { margin: 32px; }\n\n.mt-xs { margin-top: 4px; }\n.mt-sm { margin-top: 8px; }\n.mt-md { margin-top: 16px; }\n.mt-lg { margin-top: 24px; }\n\n.mb-xs { margin-bottom: 4px; }\n.mb-sm { margin-bottom: 8px; }\n.mb-md { margin-bottom: 16px; }\n.mb-lg { margin-bottom: 24px; }\n\n/* Padding Utilities */\n.p-0 { padding: 0; }\n.p-xs { padding: 4px; }\n.p-sm { padding: 8px; }\n.p-md { padding: 16px; }\n.p-lg { padding: 24px; }\n.p-xl { padding: 32px; }\n\n/* Display Utilities */\n.block { display: block; }\n.inline { display: inline; }\n.inline-block { display: inline-block; }\n.flex { display: flex; }\n.hidden { display: none; }\n\n/* Flexbox Utilities */\n.flex-row { flex-direction: row; }\n.flex-col { flex-direction: column; }\n.justify-start { justify-content: flex-start; }\n.justify-center { justify-content: center; }\n.justify-between { justify-content: space-between; }\n.items-start { align-items: flex-start; }\n.items-center { align-items: center; }\n.items-end { align-items: flex-end; }\n\n/* Text Utilities */\n.text-left { text-align: left; }\n.text-center { text-align: center; }\n.text-right { text-align: right; }\n\n.text-xs { font-size: 12px; }\n.text-sm { font-size: 14px; }\n.text-base { font-size: 16px; }\n.text-lg { font-size: 18px; }\n.text-xl { font-size: 20px; }\n.text-2xl { font-size: 24px; }\n.text-3xl { font-size: 32px; }\n\n.font-normal { font-weight: 400; }\n.font-medium { font-weight: 500; }\n.font-semibold { font-weight: 600; }\n.font-bold { font-weight: 700; }\n\n.text-gray { color: #718096; }\n.text-dark { color: #1a202c; }\n.text-light { color: #f7fafc; }\n\n/* Width & Height */\n.w-full { width: 100%; }\n.h-full { height: 100%; }\n.w-1/2 { width: 50%; }\n.w-1/3 { width: 33.333%; }\n.w-2/3 { width: 66.667%; }\n\n/* Border Radius */\n.rounded-none { border-radius: 0; }\n.rounded-sm { border-radius: 4px; }\n.rounded { border-radius: 8px; }\n.rounded-lg { border-radius: 12px; }\n.rounded-full { border-radius: 9999px; }\n\n/* Shadows */\n.shadow-sm { box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05); }\n.shadow { box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); }\n.shadow-lg { box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1); }\n.shadow-xl { box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3); }\n`\n\n  return css\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// CSS Variable 생성 (CSS Custom Properties)\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateCSSVariables() -> string {\n  let colors = getThemeColors()\n  let spacing = getThemeSpacing()\n  let fonts = getThemeFonts()\n\n  let css = `:root {\n  /* Colors */\n  --color-primary: ` + colors.primary + `;\n  --color-secondary: ` + colors.secondary + `;\n  --color-success: ` + colors.success + `;\n  --color-warning: ` + colors.warning + `;\n  --color-danger: ` + colors.danger + `;\n  --color-info: ` + colors.info + `;\n  --color-light: ` + colors.light + `;\n  --color-dark: ` + colors.dark + `;\n  --color-muted: ` + colors.muted + `;\n\n  /* Spacing */\n  --space-xs: ` + spacing.xs + `;\n  --space-sm: ` + spacing.sm + `;\n  --space-md: ` + spacing.md + `;\n  --space-lg: ` + spacing.lg + `;\n  --space-xl: ` + spacing.xl + `;\n\n  /* Fonts */\n  --font-primary: ` + fonts.primary + `;\n  --font-mono: ` + fonts.mono + `;\n\n  /* Border Radius */\n  --radius-sm: 4px;\n  --radius-md: 8px;\n  --radius-lg: 12px;\n\n  /* Shadows */\n  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);\n  --shadow-md: 0 2px 8px rgba(0, 0, 0, 0.1);\n  --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.1);\n  --shadow-xl: 0 20px 60px rgba(0, 0, 0, 0.3);\n}\n`\n\n  return css\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 기본 컴포넌트 스타일\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateComponentStyles() -> string {\n  return `\n/* Typography */\nbody {\n  font-family: var(--font-primary);\n  color: #333;\n  line-height: 1.6;\n  margin: 0;\n  padding: 0;\n  background: #fff;\n}\n\nh1, h2, h3, h4, h5, h6 {\n  margin: var(--space-lg) 0 var(--space-md) 0;\n  font-weight: 700;\n  line-height: 1.3;\n}\n\nh1 { font-size: 32px; color: var(--color-dark); }\nh2 { font-size: 24px; color: var(--color-dark); }\nh3 { font-size: 20px; color: var(--color-dark); }\nh4 { font-size: 18px; }\nh5 { font-size: 16px; }\nh6 { font-size: 14px; }\n\np {\n  margin: var(--space-md) 0;\n}\n\n/* Buttons */\nbutton {\n  padding: var(--space-sm) var(--space-md);\n  border: none;\n  border-radius: var(--radius-md);\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  background: var(--color-primary);\n  color: white;\n}\n\nbutton:hover {\n  background: var(--color-secondary);\n  box-shadow: var(--shadow-md);\n}\n\nbutton:active {\n  transform: scale(0.98);\n}\n\nbutton.secondary {\n  background: var(--color-muted);\n  color: var(--color-dark);\n}\n\nbutton.success {\n  background: var(--color-success);\n}\n\nbutton.danger {\n  background: var(--color-danger);\n}\n\n/* Links */\na {\n  color: var(--color-primary);\n  text-decoration: none;\n  transition: color 0.2s ease;\n}\n\na:hover {\n  color: var(--color-secondary);\n  text-decoration: underline;\n}\n\n/* Forms */\ninput, textarea, select {\n  padding: var(--space-sm);\n  border: 1px solid var(--color-muted);\n  border-radius: var(--radius-sm);\n  font-family: inherit;\n  font-size: 16px;\n  transition: border-color 0.2s ease;\n}\n\ninput:focus, textarea:focus, select:focus {\n  outline: none;\n  border-color: var(--color-primary);\n  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);\n}\n\n/* Cards */\n.card {\n  background: white;\n  border-radius: var(--radius-lg);\n  padding: var(--space-lg);\n  box-shadow: var(--shadow-md);\n  transition: box-shadow 0.2s ease;\n}\n\n.card:hover {\n  box-shadow: var(--shadow-lg);\n}\n\n/* Containers */\n.container {\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: var(--space-lg);\n}\n\n.container-sm {\n  max-width: 800px;\n  margin: 0 auto;\n  padding: var(--space-lg);\n}\n\n/* Grid */\n.grid {\n  display: grid;\n  gap: var(--space-md);\n}\n\n.grid-cols-1 { grid-template-columns: 1fr; }\n.grid-cols-2 { grid-template-columns: repeat(2, 1fr); }\n.grid-cols-3 { grid-template-columns: repeat(3, 1fr); }\n.grid-cols-4 { grid-template-columns: repeat(4, 1fr); }\n\n/* Badges */\n.badge {\n  display: inline-block;\n  padding: 4px 8px;\n  border-radius: 999px;\n  font-size: 12px;\n  font-weight: 600;\n  background: var(--color-muted);\n  color: var(--color-dark);\n}\n\n.badge-primary {\n  background: var(--color-primary);\n  color: white;\n}\n\n.badge-success {\n  background: var(--color-success);\n  color: white;\n}\n\n.badge-danger {\n  background: var(--color-danger);\n  color: white;\n}\n\n/* Alerts */\n.alert {\n  padding: var(--space-md);\n  border-radius: var(--radius-md);\n  margin-bottom: var(--space-md);\n  border-left: 4px solid var(--color-primary);\n  background: rgba(102, 126, 234, 0.05);\n  color: var(--color-dark);\n}\n\n.alert-success {\n  border-left-color: var(--color-success);\n  background: rgba(72, 187, 120, 0.05);\n}\n\n.alert-danger {\n  border-left-color: var(--color-danger);\n  background: rgba(245, 101, 101, 0.05);\n}\n`\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 반응형 디자인\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateResponsiveStyles() -> string {\n  return `\n/* Mobile First (xs: 320px) */\n.grid-cols-1 {\n  grid-template-columns: 1fr;\n}\n\n/* Small (sm: 640px) */\n@media (min-width: 640px) {\n  .sm\\\\:grid-cols-2 {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  .sm\\\\:px-4 {\n    padding-left: 16px;\n    padding-right: 16px;\n  }\n}\n\n/* Medium (md: 768px) */\n@media (min-width: 768px) {\n  .container {\n    padding: 24px;\n  }\n  .md\\\\:grid-cols-3 {\n    grid-template-columns: repeat(3, 1fr);\n  }\n  .md\\\\:text-lg {\n    font-size: 18px;\n  }\n}\n\n/* Large (lg: 1024px) */\n@media (min-width: 1024px) {\n  .lg\\\\:grid-cols-4 {\n    grid-template-columns: repeat(4, 1fr);\n  }\n  .lg\\\\:w-3/4 {\n    width: 75%;\n  }\n}\n\n/* X-Large (xl: 1280px) */\n@media (min-width: 1280px) {\n  .container {\n    max-width: 1280px;\n  }\n}\n\n/* Dark Mode */\n@media (prefers-color-scheme: dark) {\n  body {\n    background: #1a202c;\n    color: #f7fafc;\n  }\n\n  .card {\n    background: #2d3748;\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);\n  }\n\n  h1, h2, h3, h4, h5, h6 {\n    color: #f7fafc;\n  }\n}\n`\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 테마별 CSS 생성\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateThemedCSS(themeName: string) -> string {\n  let css = \\\"\\\"\n\n  if themeName == \\\"light\\\" {\n    css = `\nbody {\n  background: white;\n  color: #1a202c;\n}\n\n.card {\n  background: #f7fafc;\n  border: 1px solid #e2e8f0;\n}\n`\n  }\n\n  if themeName == \\\"dark\\\" {\n    css = `\nbody {\n  background: #1a202c;\n  color: #f7fafc;\n}\n\n.card {\n  background: #2d3748;\n  border: 1px solid #4a5568;\n}\n\nh1, h2, h3 {\n  color: #f7fafc;\n}\n`\n  }\n\n  if themeName == \\\"purple\\\" {\n    css = `\n:root {\n  --color-primary: #667eea;\n  --color-secondary: #764ba2;\n}\n\nbody {\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n  color: white;\n}\n`\n  }\n\n  return css\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 통합 CSS 생성\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateFullCSS(themeName: string) -> string {\n  let css = \\\"\\\"\n\n  // 1. CSS Variables\n  css = css + generateCSSVariables()\n  css = css + \\\"\\\\n\\\\n\\\"\n\n  // 2. Base Component Styles\n  css = css + generateComponentStyles()\n  css = css + \\\"\\\\n\\\\n\\\"\n\n  // 3. Utility Classes\n  css = css + generateUtilityClasses()\n  css = css + \\\"\\\\n\\\\n\\\"\n\n  // 4. Responsive Design\n  css = css + generateResponsiveStyles()\n  css = css + \\\"\\\\n\\\\n\\\"\n\n  // 5. Theme-specific CSS\n  css = css + generateThemedCSS(themeName)\n\n  return css\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// 인라인 스타일 생성 (작은 요소용)\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc getInlineHeaderStyles() -> string {\n  return `\n    style=\\\"\n      font-family: -apple-system, BlinkMacSystemFont, sans-serif;\n      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n      min-height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 20px;\n    \\\"\n  `\n}\n\nfunc getInlineContainerStyles() -> string {\n  return `\n    style=\\\"\n      background: white;\n      border-radius: 16px;\n      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);\n      padding: 40px;\n      max-width: 500px;\n      width: 100%;\n    \\\"\n  `\n}\n\nfunc getInlineCardStyles() -> string {\n  return `\n    style=\\\"\n      padding: 20px;\n      margin: 15px 0;\n      background: #f9f9f9;\n      border-radius: 8px;\n      border-left: 4px solid #667eea;\n    \\\"\n  `\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Export\n// ──────────────────────────────────────────────────────────────────────────\n\nexport {\n  getThemeColors,\n  getThemeSpacing,\n  getThemeFonts,\n  getThemeBreakpoints,\n  generateUtilityClasses,\n  generateCSSVariables,\n  generateComponentStyles,\n  generateResponsiveStyles,\n  generateThemedCSS,\n  generateFullCSS,\n  getInlineHeaderStyles,\n  getInlineContainerStyles,\n  getInlineCardStyles\n}\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":nul