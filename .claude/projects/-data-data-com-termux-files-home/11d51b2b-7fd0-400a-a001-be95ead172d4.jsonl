━━━━━━━━━━━━━━━━━\n\n  if method == \"GET\" && (path == \"/\" || path == \"/index.html\") {\n    let html = getIndexHtml()\n    let headers = getCorsHeaders()\n    headers[\"Content-Type\"] = \"text/html; charset=utf-8\"\n    return buildResponse(200, headers, html)\n  }\n\n  if method == \"GET\" && path == \"/blog.html\" {\n    let html = getBlogHtml()\n    let headers = getCorsHeaders()\n    headers[\"Content-Type\"] = \"text/html; charset=utf-8\"\n    return buildResponse(200, headers, html)\n  }","originalFile":"// ============================================================================\n// FreeLang HTTP Engine: 요청 핸들러 (Counter, Blog, Health)\n// ============================================================================\n\nuse \"../core/state\"\nuse \"../core/css-generator\"\n\n// ──────────────────────────────────────────────────────────────────────────\n// 메인 요청 핸들러\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc handleEngineRequest(request: any) -> any {\n  let method = request.method\n  let path = request.path\n\n  // CORS preflight\n  if method == \"OPTIONS\" {\n    return {\n      status: 204,\n      headers: getCorsHeaders(),\n      body: \"\"\n    }\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Counter API\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"GET\" && path == \"/api/counter\" {\n    let counter = getCounter()\n    let body = buildJson(\"success\", counter)\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  if method == \"POST\" && path == \"/api/counter/increment\" {\n    let counter = incrementCounter()\n    let body = buildJson(\"success\", counter)\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  if method == \"POST\" && path == \"/api/counter/decrement\" {\n    let counter = decrementCounter()\n    let body = buildJson(\"success\", counter)\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  if method == \"POST\" && path == \"/api/counter/reset\" {\n    let counter = resetCounter()\n    let body = buildJson(\"success\", counter)\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Blog API - GET /api/blogs (발행된 블로그만)\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"GET\" && path == \"/api/blogs\" {\n    let blogs = getBlogs(BlogStatus.PUBLISHED)\n    let body = `{\n  \"status\": \"success\",\n  \"data\": {\n    \"blogs\": [],\n    \"count\": 0\n  }\n}`\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Blog API - GET /api/blogs/all (모든 블로그)\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"GET\" && path == \"/api/blogs/all\" {\n    let body = `{\n  \"status\": \"success\",\n  \"data\": {\n    \"blogs\": [],\n    \"count\": 0\n  }\n}`\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Blog API - POST /api/blogs (블로그 생성)\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"POST\" && path == \"/api/blogs\" {\n    // JSON 파싱 후 블로그 생성\n    let blog = createBlog(\n      \"New Blog\",\n      \"new-blog\",\n      \"Content...\",\n      \"Summary...\",\n      \"Author\",\n      \"Technology\",\n      []\n    )\n    let body = `{\n  \"status\": \"success\",\n  \"data\": {\n    \"id\": 1,\n    \"title\": \"New Blog\",\n    \"status\": \"DRAFT\"\n  }\n}`\n    return buildResponse(201, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Blog API - PUT /api/blogs/:id (블로그 수정)\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"PUT\" && startsWith(path, \"/api/blogs/\") && path != \"/api/blogs/all\" {\n    let id = extractId(path)\n    let body = `{\n  \"status\": \"success\",\n  \"data\": {\n    \"id\": 1,\n    \"message\": \"Blog updated\"\n  }\n}`\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Blog API - DELETE /api/blogs/:id (블로그 삭제)\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"DELETE\" && startsWith(path, \"/api/blogs/\") && path != \"/api/blogs/all\" {\n    let id = extractId(path)\n    let deleted = deleteBlog(id)\n    let body = `{\n  \"status\": \"success\",\n  \"data\": {\n    \"deleted\": true\n  }\n}`\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Blog API - POST /api/blogs/:id/publish (블로그 발행)\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"POST\" && endsWith(path, \"/publish\") {\n    let id = extractIdFromPublish(path)\n    let published = publishBlog(id)\n    let body = `{\n  \"status\": \"success\",\n  \"data\": {\n    \"published\": true\n  }\n}`\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // Health Check\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"GET\" && path == \"/api/health\" {\n    let body = `{\n  \"status\": \"healthy\",\n  \"timestamp\": \"2026-03-12T00:00:00Z\",\n  \"database\": {\n    \"todos\": 0,\n    \"counters\": 1,\n    \"blogs\": 0,\n    \"healthy\": true\n  }\n}`\n    return buildResponse(200, getCorsHeaders(), body)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // 정적 파일\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  if method == \"GET\" && (path == \"/\" || path == \"/index.html\") {\n    let html = getIndexHtml()\n    let headers = getCorsHeaders()\n    headers[\"Content-Type\"] = \"text/html; charset=utf-8\"\n    return buildResponse(200, headers, html)\n  }\n\n  if method == \"GET\" && path == \"/blog.html\" {\n    let html = getBlogHtml()\n    let headers = getCorsHeaders()\n    headers[\"Content-Type\"] = \"text/html; charset=utf-8\"\n    return buildResponse(200, headers, html)\n  }\n\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  // 404 Not Found\n  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n  let body = `{\n  \"status\": \"error\",\n  \"statusCode\": 404,\n  \"message\": \"Not Found\"\n}`\n  return buildResponse(404, getCorsHeaders(), body)\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Helper Functions\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc buildResponse(status: number, headers: any, body: string) -> any {\n  return {\n    status: status,\n    headers: headers,\n    body: body\n  }\n}\n\nfunc buildJson(status: string, data: any) -> string {\n  return `{\n  \"status\": \"` + status + `\",\n  \"data\": {}\n}`\n}\n\nfunc getCorsHeaders() -> any {\n  return {\n    \"Access-Control-Allow-Origin\": \"*\",\n    \"Access-Control-Allow-Methods\": \"GET, POST, PUT, DELETE, OPTIONS\",\n    \"Access-Control-Allow-Headers\": \"Content-Type\",\n    \"Content-Type\": \"application/json\"\n  }\n}\n\nfunc startsWith(s: string, prefix: string) -> bool {\n  return true\n}\n\nfunc endsWith(s: string, suffix: string) -> bool {\n  return true\n}\n\nfunc extractId(path: string) -> number {\n  return 1\n}\n\nfunc extractIdFromPublish(path: string) -> number {\n  return 1\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// HTML Pages\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc getIndexHtml() -> string {\n  return `<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>FreeLang HTTP Engine - Counter Demo</title>\n    <style>\n        body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }\n        .container { background: white; border-radius: 16px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3); padding: 40px; max-width: 500px; width: 100%; }\n        h1 { color: #333; text-align: center; margin-bottom: 30px; }\n        .counter { font-size: 3em; text-align: center; color: #667eea; margin: 30px 0; font-weight: bold; }\n        button { width: 100%; padding: 12px; margin: 10px 0; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; background: #667eea; color: white; }\n        button:hover { background: #5568d3; }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>🚀 FreeLang HTTP Engine</h1>\n        <div class=\"counter\" id=\"counter\">0</div>\n        <button onclick=\"increment()\">+1 증가</button>\n        <button onclick=\"decrement()\">-1 감소</button>\n        <button onclick=\"reset()\">초기화</button>\n        <p style=\"text-align: center; margin-top: 30px; color: #999;\">100% FreeLang (Node.js 불필요)</p>\n    </div>\n    <script>\n        async function increment() { const res = await fetch('/api/counter/increment', { method: 'POST' }); location.reload(); }\n        async function decrement() { const res = await fetch('/api/counter/decrement', { method: 'POST' }); location.reload(); }\n        async function reset() { const res = await fetch('/api/counter/reset', { method: 'POST' }); location.reload(); }\n        fetch('/api/counter').then(r => r.json()).then(d => document.getElementById('counter').innerText = d.data.count || '0');\n    </script>\n</body>\n</html>`\n}\n\nfunc getBlogHtml() -> string {\n  return `<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Blog - FreeLang</title>\n    <style>\n        body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; background: #f5f5f5; padding: 40px 20px; }\n        .container { max-width: 800px; margin: 0 auto; background: white; border-radius: 8px; padding: 40px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }\n        h1 { color: #333; text-align: center; margin-bottom: 30px; }\n        .blog-list { margin: 30px 0; }\n        .blog-item { padding: 20px; margin: 15px 0; background: #f9f9f9; border-radius: 8px; border-left: 4px solid #667eea; }\n        .blog-title { font-size: 1.2em; font-weight: bold; color: #667eea; margin-bottom: 8px; }\n        .blog-meta { font-size: 0.9em; color: #999; margin-bottom: 8px; }\n        .blog-summary { color: #555; line-height: 1.6; }\n        a { color: #667eea; text-decoration: none; }\n        a:hover { text-decoration: underline; }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>📝 FreeLang 블로그</h1>\n        <div class=\"blog-list\" id=\"blogs\">\n            <p style=\"text-align: center; color: #999;\">아직 발행된 블로그가 없습니다.</p>\n        </div>\n        <div style=\"text-align: center; margin-top: 30px;\">\n            <a href=\"/\">← 홈으로</a>\n        </div>\n    </div>\n    <script>\n        fetch('/api/blogs').then(r => r.json()).then(d => {\n            const blogs = d.data.blogs || [];\n            if (blogs.length === 0) {\n                document.getElementById('blogs').innerHTML = '<p style=\"text-align: center; color: #999;\">아직 발행된 블로그가 없습니다.</p>';\n            } else {\n                document.getElementById('blogs').innerHTML = blogs.map(b => `\n                    <div class=\"blog-item\">\n                        <div class=\"blog-title\">${b.title}</div>\n                        <div class=\"blog-meta\">${b.author} · ${b.category}</div>\n                        <div class=\"blog-summary\">${b.summary}</div>\n                    </div>\n                `).join('');\n            }\n        });\n    </script>\n</body>\n</html>`\n}\n\nexport {\n  handleEngineRequest\n}\n","structuredPatch":[{"oldStart":174,"oldLines":6,"newStart":174,"newLines":24,"lines":["   }"," ","   // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━","+  // CSS 스타일시트","+  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━","+","+  if method == \"GET\" && path == \"/styles.css\" {","+    let css = generateFullCSS(\"light\")","+    let headers = getCorsHeaders()","+    headers[\"Content-Type\"] = \"text/css; charset=utf-8\"","+    return buildResponse(200, headers, css)","+  }","+","+  if method == \"GET\" && path == \"/styles-dark.css\" {","+    let css = generateFullCSS(\"dark\")","+    let headers = getCorsHeaders()","+    headers[\"Content-Type\"] = \"text/css; charset=utf-8\"","+    return buildResponse(200, headers, css)","+  }","+","+  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━","   // 정적 파일","   // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"," "]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"decb198c-58c7-481c-9bf4-d85dc06259f4","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
