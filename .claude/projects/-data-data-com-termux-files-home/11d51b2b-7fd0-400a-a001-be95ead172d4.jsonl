n\ntest('번들 통계', () => {\n  const bundler = new Bundler();\n  bundler.assets.css.push({ name: 'test', content: 'body {}' });\n  bundler.assets.js.push({ name: 'test', content: 'console.log(\"test\")' });\n  bundler.manifest.components = ['test'];\n\n  const stats = bundler.getStats();\n  if (stats.components !== 1) throw new Error('Invalid component count');\n  if (stats.css_files !== 1) throw new Error('Invalid CSS file count');\n});\n\ntest('코드 들여쓰기', () => {\n  const bundler = new Bundler();\n  const code = 'line1\\nline2';\n  const indented = bundler.indentCode(code, 2);\n  if (!indented.startsWith('  ')) throw new Error('Not indented');\n});\n\nconsole.log('\\n✨ Bundler 테스트 완료!\\n');\n\n// 실제 번들링 테스트\nconsole.log('🎯 실제 번들링 테스트\\n');\n\ntry {\n  // 예제 CSS/JS/HTML 파일 생성\n  const exampleDir = path.join(testDir, 'example-components');\n  if (!fs.existsSync(exampleDir)) {\n    fs.mkdirSync(exampleDir, { recursive: true });\n  }\n\n  // 예제 파일 생성\n  fs.writeFileSync(path.join(exampleDir, 'demo1.css'), `.demo1 { color: blue; }`);\n  fs.writeFileSync(path.join(exampleDir, 'demo1.js'), `function demo1() { console.log(\"demo1\"); }`);\n  fs.writeFileSync(path.join(exampleDir, 'demo1.html'), `<div class=\"demo1\">Demo 1</div>`);\n\n  fs.writeFileSync(path.join(exampleDir, 'demo2.css'), `.demo2 { color: red; }`);\n  fs.writeFileSync(path.join(exampleDir, 'demo2.js'), `function demo2() { console.log(\"demo2\"); }`);\n  fs.writeFileSync(path.join(exampleDir, 'demo2.html'), `<div class=\"demo2\">Demo 2</div>`);\n\n  // 번들링\n  const bundler = new Bundler({\n    bundleName: 'demo-bundle',\n    outputDir: testDir,\n    minify: true,\n    sourcemap: true\n  });\n\n  bundler.bundleComponent(path.join(exampleDir, 'demo1.css'));\n  bundler.bundleComponent(path.join(exampleDir, 'demo1.js'));\n  bundler.bundleComponent(path.join(exampleDir, 'demo1.html'));\n\n  const result = bundler.generate();\n\n  console.log('📊 번들링 결과:');\n  console.log(`   CSS: ${result.css}`);\n  console.log(`   JS: ${result.js}`);\n  console.log(`   HTML: ${result.html}`);\n  console.log(`\\n📈 통계:`);\n  console.log(`   Components: ${result.stats.components}`);\n  console.log(`   Total Size: ${result.stats.total_size_uncompressed} bytes`);\n  console.log(`   CSS Size: ${result.stats.css_size} bytes`);\n  console.log(`   JS Size: ${result.stats.js_size} bytes`);\n\n  // 파일 존재 확인\n  if (fs.existsSync(result.css)) {\n    console.log(`\\n✅ 번들 생성 성공!`);\n  }\n} catch (error) {\n  console.error(`❌ 번들링 실패: ${error.message}`);\n}\n\nconsole.log();\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":3324,"cache_read_input_tokens":139279,"output_tokens":1657,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3324,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"}},"requestId":"req_011CYxnKUHcHYxmhaNCdcCX7","type":"assistant","uuid":"3309e2c1-89bb-430d-9eaa-f26e7576280e","timestamp":"2026-03-12T07:21:20.638Z","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-light","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
