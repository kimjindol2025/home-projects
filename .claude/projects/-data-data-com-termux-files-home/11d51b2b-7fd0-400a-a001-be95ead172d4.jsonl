earchAPI = new FreeLangSearchAPI();\n  }\n\n  showHelp() {\n    console.log(`\n╔════════════════════════════════════════════════╗\n║         FreeLang Light CLI v1.0               ║\n║  Unified Frontend Language Compiler            ║\n╚════════════════════════════════════════════════╝\n\n📖 USAGE:\n   freelang <command> [options]\n\n🎯 COMMANDS:\n\n   compile <file>          Compile .free file to CSS/JS/HTML\n   search <query>          Search components\n   index <dir>             Index directory\n   serve                   Start search API server (port 4002)\n   list                    List all indexed components\n   stats                   Show indexing statistics\n   help                    Show this help message\n\n📝 EXAMPLES:\n\n   # Compile a component\n   freelang compile card.free\n   → Generates: card.css, card.js, card.html\n\n   # Search for components\n   freelang search \"button\"\n   → Find all components matching 'button'\n\n   # Index a directory\n   freelang index ./components\n   → Creates freelang-light.index.json\n\n   # Start API server\n   freelang serve\n   → Runs on http://localhost:4002\n\n   # List all components\n   freelang list\n   → Shows all indexed components\n\n   # Show statistics\n   freelang stats\n   → Total components, functions, styles, etc.\n\n🔧 OPTIONS:\n\n   -o, --output <dir>      Output directory (default: current dir)\n   -f, --format <format>   Output format: html, css, js, all (default: all)\n   -m, --minify            Minify output\n   -v, --version           Show version\n   -h, --help              Show help\n\n📚 DOCUMENTATION:\n\n   https://github.com/kim/freelang-light\n   Documentation: ./docs/SPEC.md\n    `);\n  }\n\n  showVersion() {\n    console.log('FreeLang Light v1.0.0');\n  }\n\n  /**\n   * compile <file> 명령\n   */\n  async compileFile(filePath, options = {}) {\n    console.log(`\\n📦 Compiling: ${filePath}`);\n\n    if (!fs.existsSync(filePath)) {\n      console.error(`❌ File not found: ${filePath}`);\n      process.exit(1);\n    }\n\n    try {\n      const content = fs.readFileSync(filePath, 'utf-8');\n      const ast = parseFreeLang(content);\n\n      console.log(`✅ Parsed component: ${ast.name}`);\n\n      const outputDir = options.output || '.';\n      const baseName = path.basename(filePath, '.free');\n\n      // CSS 컴파일\n      const cssCompiler = new CSSCompiler();\n      const cssCode = cssCompiler.compile(ast);\n      const cssFile = path.join(outputDir, `${baseName}.css`);\n      fs.writeFileSync(cssFile, cssCode);\n      console.log(`   ✅ Generated: ${baseName}.css (${cssCode.length} bytes)`);\n\n      // JavaScript 컴파일\n      const jsCompiler = new JSCompiler();\n      const jsCode = jsCompiler.compile(ast);\n      const jsFile = path.join(outputDir, `${baseName}.js`);\n      fs.writeFileSync(jsFile, jsCode);\n      console.log(`   ✅ Generated: ${baseName}.js (${jsCode.length} bytes)`);\n\n      // HTML 생성\n      const htmlGen = new HTMLGenerator();\n      const htmlCode = htmlGen.generate(ast);\n      const htmlFile = path.join(outputDir, `${baseName}.html`);\n      fs.writeFileSync(htmlFile, htmlCode);\n      console.log(`   ✅ Generated: ${baseName}.html (${htmlCode.length} bytes)`);\n\n      console.log(`\\n✨ Compilation successful!`);\n      console.log(`   Output directory: ${path.resolve(outputDir)}\\n`);\n    } catch (error) {\n      console.error(`❌ Compilation failed: ${error.message}`);\n      process.exit(1);\n    }\n  }\n\n  /**\n   * search <query> 명령\n   */\n  searchComponents(query) {\n    console.log(`\\n🔍 Searching for: \"${query}\"`);\n\n    const results = this.searchAPI.searchCLI(query);\n\n    if (results.total_results === 0) {\n      console.log(`❌ No results found\\n`);\n      return;\n    }\n\n    console.log(`\\n✅ Found ${results.total_results} result(s):\\n`);\n    results.results.forEach((result, i) => {\n      console.log(`${i + 1}. ${result.component}`);\n      console.log(`   File: ${result.file}`);\n      console.log(`   Props: ${result.props}, Functions: ${result.functions}, Styles: ${result.styles}`);\n      console.log(`   Match fields: ${result.match_fields.join(', ')}`);\n      console.log(`   Ranking: ${result.ranking}\\n`);\n    });\n  }\n\n  /**\n   * index <dir> 명령\n   */\n  indexDirectory(dirPath) {\n    console.log(`\\n📂 Indexing directory: ${dirPath}`);\n\n    if (!fs.existsSync(dirPath)) {\n      console.error(`❌ Directory not found: ${dirPath}`);\n      process.exit(1);\n    }\n\n    try {\n      this.searchAPI.indexDirectoryCLI(dirPath);\n      const stats = this.searchAPI.getStatsCLI();\n\n      console.log(`\\n✅ Indexing complete!`);\n      console.log(`   Components: ${stats.total_components}`);\n      console.log(`   Indexed items: ${stats.total_indexed_items}`);\n      console.log(`   Total functions: ${stats.total_functions}`);\n      console.log(`   Total styles: ${stats.total_styles}\\n`);\n    } catch (error) {\n      console.error(`❌ Indexing failed: ${error.message}`);\n      process.exit(1);\n    }\n  }\n\n  /**\n   * list 명령\n   */\n  listComponents() {\n    console.log(`\\n📋 Indexed Components:\\n`);\n\n    const components = this.searchAPI.indexer.components;\n\n    if (components.length === 0) {\n      console.log(`   (No components indexed)\\n`);\n      return;\n    }\n\n    components.forEach((name, i) => {\n      const entry = this.searchAPI.indexer.index.find(e => e.component === name);\n      console.log(`${i + 1}. ${name}`);\n      console.log(`   File: ${entry.file}`);\n      console.log(`   Props: ${entry.props.length}, Functions: ${entry.functions.length}`);\n      console.log(`   Ranking: ${entry.ranking}\\n`);\n    });\n\n    console.log(`Total: ${components.length} components\\n`);\n  }\n\n  /**\n   * stats 명령\n   */\n  showStats() {\n    console.log(`\\n📊 FreeLang Light Statistics:\\n`);\n\n    const stats = this.searchAPI.getStatsCLI();\n\n    console.log(`   Components indexed: ${stats.total_components}`);\n    console.log(`   Total indexed items: ${stats.total_indexed_items}`);\n    console.log(`   Total props: ${stats.total_props}`);\n    console.log(`   Total functions: ${stats.total_functions}`);\n    console.log(`   Total styles: ${stats.total_styles}`);\n    console.log(`   Avg file size: ${stats.avg_file_size} bytes\\n`);\n  }\n\n  /**\n   * bundle 명령\n   */\n  bundleComponents(dirPath, args = []) {\n    console.log(`\\n📦 Bundling components from: ${dirPath}`);\n\n    if (!fs.existsSync(dirPath)) {\n      console.error(`❌ Directory not found: ${dirPath}`);\n      process.exit(1);\n    }\n\n    try {\n      const options = {\n        minify: !args.includes('--no-minify'),\n        sourcemap: args.includes('--sourcemap'),\n        bundleName: 'app'\n      };\n\n      const bundler = new Bundler(options);\n\n      // 디렉토리의 모든 .css, .js, .html 파일 찾기\n      const files = this.findComponentAssets(dirPath);\n\n      if (files.length === 0) {\n        console.error(`❌ No component assets found in ${dirPath}`);\n        process.exit(1);\n      }\n\n      console.log(`\\n📄 Found ${files.length} assets\\n`);\n\n      files.forEach(file => {\n        bundler.bundleComponent(file);\n      });\n\n      const result = bundler.generate();\n\n      console.log(`\\n📊 Bundle Summary:`);\n      console.log(`   Output: ${result.css}`);\n      console.log(`   Size: ${result.stats.total_size_uncompressed} bytes`);\n      console.log();\n    } catch (error) {\n      console.error(`❌ Bundling failed: ${error.message}`);\n      process.exit(1);\n    }\n  }\n\n  /**\n   * 컴포넌트 자산 찾기\n   */\n  findComponentAssets(dirPath) {\n    const files = [];\n    const extensions = ['.css', '.js', '.html'];\n\n    const traverse = (currentPath) => {\n      const entries = fs.readdirSync(currentPath, { withFileTypes: true });\n\n      entries.forEach(entry => {\n        const fullPath = path.join(currentPath, entry.name);\n\n        if (entry.isDirectory() && !entry.name.startsWith('.')) {\n          traverse(fullPath);\n        } else if (entry.isFile() && extensions.includes(path.extname(entry.name))) {\n          files.push(fullPath);\n        }\n      });\n    };\n\n    traverse(dirPath);\n    return files;\n  }\n\n  /**\n   * serve 명령\n   */\n  startServer() {\n    const api = new FreeLangSearchAPI();\n    api.startServer();\n  }\n\n  /**\n   * 메인 CLI 처리\n   */\n  async run(args) {\n    if (args.length === 0) {\n      this.showHelp();\n      return;\n    }\n\n    const command = args[0];\n    const cmdArgs = args.slice(1);\n\n    switch (command) {\n      case 'compile':\n        if (!cmdArgs[0]) {\n          console.error('❌ Usage: freelang compile <file>');\n          process.exit(1);\n        }\n        await this.compileFile(cmdArgs[0]);\n        break;\n\n      case 'search':\n        if (!cmdArgs[0]) {\n          console.error('❌ Usage: freelang search <query>');\n          process.exit(1);\n        }\n        this.searchComponents(cmdArgs.join(' '));\n        break;\n\n      case 'index':\n        if (!cmdArgs[0]) {\n          console.error('❌ Usage: freelang index <directory>');\n          process.exit(1);\n        }\n        this.indexDirectory(cmdArgs[0]);\n        break;\n\n      case 'list':\n        this.listComponents();\n        break;\n\n      case 'stats':\n        this.showStats();\n        break;\n\n      case 'bundle':\n        if (!cmdArgs[0]) {\n          console.error('❌ Usage: freelang bundle <dir> [--minify] [--sourcemap]');\n          process.exit(1);\n        }\n        this.bundleComponents(cmdArgs[0], cmdArgs);\n        break;\n\n      case 'serve':\n        this.startServer();\n        break;\n\n      case 'help':\n      case '-h':\n      case '--help':\n        this.showHelp();\n        break;\n\n      case 'version':\n      case '-v':\n      case '--version':\n        this.showVersion();\n        break;\n\n      default:\n        console.error(`❌ Unknown command: ${command}`);\n        console.log(`\\nRun 'freelang help' for usage information.\\n`);\n        process.exit(1);\n    }\n  }\n}\n\n// CLI 실행\nif (require.main === module) {\n  const cli = new FreeLangCLI();\n  cli.run(process.argv.slice(2));\n}\n\nmodule.exports = { FreeLangCLI };\n","structuredPatch":[{"oldStart":34,"oldLines":6,"newStart":34,"newLines":7,"lines":[" 🎯 COMMANDS:"," ","    compile <file>          Compile .free file to CSS/JS/HTML","+   bundle <dir>            Bundle all components in directory","    search <query>          Search components","    index <dir>             Index directory","    serve                   Start search API server (port 4002)"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"5e75254e-f629-4ad9-95aa-25ffe1336c31","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-light","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
