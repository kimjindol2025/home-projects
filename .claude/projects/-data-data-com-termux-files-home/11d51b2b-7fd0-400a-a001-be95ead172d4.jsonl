{"parentUuid":"c7fab108-d12d-4ae7-994f-13796c88377d","isSidechain":false,"message":{"model":"claude-haiku-4-5-20251001","id":"msg_01RS7abYK98wzCaqRqgDo3Wy","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018nZdcm44dQFsf7kAT8qKFW","name":"Write","input":{"file_path":"/data/data/com.termux/files/home/freelang-hybrid/freelang/core/database-sqlite.js","content":"// ============================================================================\n// FreeLang Phase 2: SQLite Database with Transactions & Concurrency Control\n// ============================================================================\n\nconst sqlite3 = require('better-sqlite3');\nconst path = require('path');\nconst crypto = require('crypto');\n\n// Database initialization\nconst DB_PATH = path.join(__dirname, '../../db/blogs.db');\nlet db = null;\nlet CONNECTION_POOL = [];\nconst MAX_CONNECTIONS = 5;\n\n// ──────────────────────────────────────────────────────────────────────────\n// Connection Pool Management\n// ──────────────────────────────────────────────────────────────────────────\n\nfunction initializeDatabase() {\n  try {\n    db = new sqlite3(DB_PATH);\n    db.pragma('journal_mode = WAL');  // Write-Ahead Logging for concurrency\n    db.pragma('synchronous = NORMAL');\n\n    // Enable foreign keys\n    db.pragma('foreign_keys = ON');\n\n    // Create tables if not exist\n    createTables();\n\n    console.log(`✅ SQLite initialized (${DB_PATH})`);\n    return true;\n  } catch (err) {\n    console.error('❌ SQLite initialization failed:', err.message);\n    return false;\n  }\n}\n\nfunction createTables() {\n  // Main blogs table\n  db.exec(`\n    CREATE TABLE IF NOT EXISTS blogs (\n      id TEXT PRIMARY KEY,\n      title TEXT NOT NULL,\n      content TEXT NOT NULL,\n      author TEXT NOT NULL,\n      createdAt TEXT NOT NULL,\n      updatedAt TEXT NOT NULL,\n      views INTEGER DEFAULT 0,\n      version INTEGER DEFAULT 1,\n      deleted INTEGER DEFAULT 0,\n      createdBy TEXT,\n      lastModifiedBy TEXT,\n      tags TEXT,\n      status TEXT DEFAULT 'draft'\n    )\n  `);\n\n  // Transaction log for ACID compliance\n  db.exec(`\n    CREATE TABLE IF NOT EXISTS transactions (\n      id TEXT PRIMARY KEY,\n      blogId TEXT,\n      operation TEXT,\n      timestamp TEXT,\n      status TEXT,\n      rollback INTEGER DEFAULT 0,\n      FOREIGN KEY(blogId) REFERENCES blogs(id)\n    )\n  `);\n\n  // Concurrency lock table (optimistic locking)\n  db.exec(`\n    CREATE TABLE IF NOT EXISTS locks (\n      id TEXT PRIMARY KEY,\n      blogId TEXT UNIQUE,\n      lockedBy TEXT,\n      lockedAt TEXT,\n      expiresAt TEXT,\n      FOREIGN KEY(blogId) REFERENCES blogs(id)\n    )\n  `);\n\n  // Create indices for performance\n  db.exec(`\n    CREATE INDEX IF NOT EXISTS idx_blogs_author ON blogs(author);\n    CREATE INDEX IF NOT EXISTS idx_blogs_status ON blogs(status);\n    CREATE INDEX IF NOT EXISTS idx_blogs_deleted ON blogs(deleted);\n    CREATE INDEX IF NOT EXISTS idx_transactions_blogId ON transactions(blogId);\n  `);\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Blog CRUD Operations with Transactions\n// ──────────────────────────────────────────────────────────────────────────\n\nfunction connectDatabase() {\n  if (!db) {\n    initializeDatabase();\n  }\n  return {\n    insertBlog,\n    getBlog,\n    getAllBlogs,\n    updateBlog,\n    deleteBlog,\n    searchBlogs,\n    beginTransaction,\n    commitTransaction,\n    rollbackTransaction,\n    getTransactionLog\n  };\n}\n\nfunction beginTransaction(transactionId = null) {\n  const txId = transactionId || generateId();\n  try {\n    db.exec('BEGIN IMMEDIATE');\n    logTransaction(txId, null, 'BEGIN', 'started');\n    return { success: true, transactionId: txId };\n  } catch (err) {\n    console.error('❌ Transaction begin failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction commitTransaction(transactionId) {\n  try {\n    db.exec('COMMIT');\n    logTransaction(transactionId, null, 'COMMIT', 'completed');\n    console.log(`✅ Transaction ${transactionId} committed`);\n    return { success: true };\n  } catch (err) {\n    console.error('❌ Transaction commit failed:', err.message);\n    rollbackTransaction(transactionId);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction rollbackTransaction(transactionId) {\n  try {\n    db.exec('ROLLBACK');\n    logTransaction(transactionId, null, 'ROLLBACK', 'rolled_back');\n    console.log(`⚠️ Transaction ${transactionId} rolled back`);\n    return { success: true };\n  } catch (err) {\n    console.error('❌ Transaction rollback failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction insertBlog(blog, transactionId = null) {\n  const blogId = blog.id || generateId();\n  const now = new Date().toISOString();\n\n  try {\n    // Optimistic locking check\n    if (transactionId) {\n      acquireLock(blogId, transactionId);\n    }\n\n    const stmt = db.prepare(`\n      INSERT INTO blogs (\n        id, title, content, author, createdAt, updatedAt,\n        views, version, createdBy, lastModifiedBy, status\n      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n    `);\n\n    stmt.run(\n      blogId,\n      blog.title || 'Untitled',\n      blog.content || '',\n      blog.author || 'Unknown',\n      blog.createdAt || now,\n      blog.updatedAt || now,\n      blog.views || 0,\n      1,  // version\n      blog.createdBy || blog.author,\n      blog.lastModifiedBy || blog.author,\n      blog.status || 'draft'\n    );\n\n    logTransaction(transactionId, blogId, 'INSERT', 'completed');\n\n    console.log(`✅ Blog inserted: ${blogId}`);\n    return { success: true, id: blogId };\n  } catch (err) {\n    logTransaction(transactionId, blogId, 'INSERT', 'failed');\n    console.error('❌ Insert failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction getBlog(blogId, transactionId = null) {\n  try {\n    if (transactionId) {\n      acquireLock(blogId, transactionId);\n    }\n\n    const stmt = db.prepare(`\n      SELECT * FROM blogs WHERE id = ? AND deleted = 0\n    `);\n\n    const blog = stmt.get(blogId);\n\n    if (blog) {\n      // Increment view count\n      const updateStmt = db.prepare(`UPDATE blogs SET views = views + 1 WHERE id = ?`);\n      updateStmt.run(blogId);\n\n      logTransaction(transactionId, blogId, 'SELECT', 'completed');\n      return { success: true, data: blog };\n    } else {\n      return { success: false, error: 'Blog not found' };\n    }\n  } catch (err) {\n    console.error('❌ Get blog failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction getAllBlogs(limit = 100, offset = 0) {\n  try {\n    const stmt = db.prepare(`\n      SELECT * FROM blogs WHERE deleted = 0 ORDER BY createdAt DESC LIMIT ? OFFSET ?\n    `);\n\n    const blogs = stmt.all(limit, offset);\n\n    const countStmt = db.prepare(`SELECT COUNT(*) as count FROM blogs WHERE deleted = 0`);\n    const { count } = countStmt.get();\n\n    logTransaction(null, null, 'SELECT_ALL', 'completed');\n    return { success: true, data: blogs, total: count };\n  } catch (err) {\n    console.error('❌ Get all blogs failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction updateBlog(blogId, updates, transactionId = null) {\n  try {\n    // Optimistic locking: check version\n    const blog = db.prepare(`SELECT * FROM blogs WHERE id = ?`).get(blogId);\n    if (!blog) {\n      return { success: false, error: 'Blog not found' };\n    }\n\n    // Version conflict detection\n    if (updates.version && updates.version !== blog.version) {\n      return { success: false, error: 'Version conflict - concurrent modification detected' };\n    }\n\n    if (transactionId) {\n      acquireLock(blogId, transactionId);\n    }\n\n    const now = new Date().toISOString();\n    const newVersion = blog.version + 1;\n\n    const stmt = db.prepare(`\n      UPDATE blogs SET\n        title = COALESCE(?, title),\n        content = COALESCE(?, content),\n        author = COALESCE(?, author),\n        updatedAt = ?,\n        version = ?,\n        lastModifiedBy = COALESCE(?, lastModifiedBy),\n        status = COALESCE(?, status)\n      WHERE id = ?\n    `);\n\n    stmt.run(\n      updates.title || null,\n      updates.content || null,\n      updates.author || null,\n      now,\n      newVersion,\n      updates.lastModifiedBy || null,\n      updates.status || null,\n      blogId\n    );\n\n    logTransaction(transactionId, blogId, 'UPDATE', 'completed');\n\n    console.log(`✅ Blog updated: ${blogId} (v${blog.version} → v${newVersion})`);\n    return { success: true, version: newVersion };\n  } catch (err) {\n    logTransaction(transactionId, blogId, 'UPDATE', 'failed');\n    console.error('❌ Update failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction deleteBlog(blogId, transactionId = null, hardDelete = false) {\n  try {\n    if (transactionId) {\n      acquireLock(blogId, transactionId);\n    }\n\n    if (hardDelete) {\n      // Hard delete: remove from database\n      const stmt = db.prepare(`DELETE FROM blogs WHERE id = ?`);\n      stmt.run(blogId);\n      console.log(`✅ Blog hard-deleted: ${blogId}`);\n    } else {\n      // Soft delete: mark as deleted\n      const stmt = db.prepare(`UPDATE blogs SET deleted = 1, updatedAt = ? WHERE id = ?`);\n      stmt.run(new Date().toISOString(), blogId);\n      console.log(`✅ Blog soft-deleted: ${blogId}`);\n    }\n\n    logTransaction(transactionId, blogId, 'DELETE', 'completed');\n    return { success: true };\n  } catch (err) {\n    logTransaction(transactionId, blogId, 'DELETE', 'failed');\n    console.error('❌ Delete failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction searchBlogs(query, filters = {}) {\n  try {\n    let sql = `SELECT * FROM blogs WHERE deleted = 0`;\n    const params = [];\n\n    if (query) {\n      sql += ` AND (title LIKE ? OR content LIKE ? OR author LIKE ?)`;\n      const searchTerm = `%${query}%`;\n      params.push(searchTerm, searchTerm, searchTerm);\n    }\n\n    if (filters.author) {\n      sql += ` AND author = ?`;\n      params.push(filters.author);\n    }\n\n    if (filters.status) {\n      sql += ` AND status = ?`;\n      params.push(filters.status);\n    }\n\n    if (filters.minViews !== undefined) {\n      sql += ` AND views >= ?`;\n      params.push(filters.minViews);\n    }\n\n    sql += ` ORDER BY updatedAt DESC LIMIT 100`;\n\n    const stmt = db.prepare(sql);\n    const results = stmt.all(...params);\n\n    logTransaction(null, null, 'SEARCH', 'completed');\n    return { success: true, data: results, count: results.length };\n  } catch (err) {\n    console.error('❌ Search failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Locking & Transaction Log\n// ──────────────────────────────────────────────────────────────────────────\n\nfunction acquireLock(blogId, lockId, timeout = 30000) {\n  try {\n    const expiresAt = new Date(Date.now() + timeout).toISOString();\n\n    const stmt = db.prepare(`\n      INSERT OR REPLACE INTO locks (id, blogId, lockedBy, lockedAt, expiresAt)\n      VALUES (?, ?, ?, ?, ?)\n    `);\n\n    stmt.run(\n      generateId(),\n      blogId,\n      lockId,\n      new Date().toISOString(),\n      expiresAt\n    );\n\n    return { success: true };\n  } catch (err) {\n    console.error('❌ Lock acquisition failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction releaseLock(blogId) {\n  try {\n    const stmt = db.prepare(`DELETE FROM locks WHERE blogId = ?`);\n    stmt.run(blogId);\n    return { success: true };\n  } catch (err) {\n    console.error('❌ Lock release failed:', err.message);\n    return { success: false };\n  }\n}\n\nfunction logTransaction(transactionId, blogId, operation, status) {\n  try {\n    const stmt = db.prepare(`\n      INSERT INTO transactions (id, blogId, operation, timestamp, status)\n      VALUES (?, ?, ?, ?, ?)\n    `);\n\n    stmt.run(\n      transactionId || generateId(),\n      blogId,\n      operation,\n      new Date().toISOString(),\n      status\n    );\n  } catch (err) {\n    console.warn('⚠️ Transaction log failed:', err.message);\n  }\n}\n\nfunction getTransactionLog(limit = 100) {\n  try {\n    const stmt = db.prepare(`\n      SELECT * FROM transactions ORDER BY timestamp DESC LIMIT ?\n    `);\n\n    const logs = stmt.all(limit);\n    return { success: true, data: logs };\n  } catch (err) {\n    console.error('❌ Get transaction log failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Utility Functions\n// ──────────────────────────────────────────────────────────────────────────\n\nfunction generateId() {\n  return crypto.randomBytes(8).toString('hex');\n}\n\nfunction migrateFromJSON(jsonFilePath) {\n  try {\n    const fs = require('fs');\n    const data = JSON.parse(fs.readFileSync(jsonFilePath, 'utf8'));\n\n    const tx = beginTransaction('migration');\n\n    for (const blog of data) {\n      insertBlog(blog, tx.transactionId);\n    }\n\n    commitTransaction(tx.transactionId);\n    console.log(`✅ Migrated ${data.length} blogs to SQLite`);\n    return { success: true, count: data.length };\n  } catch (err) {\n    console.error('❌ Migration failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction close() {\n  if (db) {\n    db.close();\n    console.log('✅ Database closed');\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Batch Operations with Transaction\n// ──────────────────────────────────────────────────────────────────────────\n\nfunction batchInsert(blogs) {\n  const tx = beginTransaction();\n  if (!tx.success) return tx;\n\n  try {\n    const insertStmt = db.prepare(`\n      INSERT INTO blogs (id, title, content, author, createdAt, updatedAt, views, version)\n      VALUES (?, ?, ?, ?, ?, ?, ?, 1)\n    `);\n\n    const insertMany = db.transaction((blogs) => {\n      for (const blog of blogs) {\n        insertStmt.run(\n          blog.id || generateId(),\n          blog.title,\n          blog.content,\n          blog.author,\n          blog.createdAt || new Date().toISOString(),\n          blog.updatedAt || new Date().toISOString(),\n          blog.views || 0\n        );\n      }\n    });\n\n    insertMany(blogs);\n    commitTransaction(tx.transactionId);\n\n    console.log(`✅ Batch inserted ${blogs.length} blogs`);\n    return { success: true, count: blogs.length };\n  } catch (err) {\n    rollbackTransaction(tx.transactionId);\n    console.error('❌ Batch insert failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\n// Export\nmodule.exports = {\n  initializeDatabase,\n  connectDatabase,\n  close,\n  migrateFromJSON,\n  batchInsert,\n  // For testing\n  _db: () => db,\n  _path: DB_PATH\n};\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1759,"cache_read_input_tokens":99360,"output_tokens":4695,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1759,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"}},"requestId":"req_011CYzQPUBiFS4S39Vyf7QFp","type":"assistant","uuid":"3fb8ec84-8d89-4c67-8dbe-6eb380ad943f","timestamp":"2026-03-13T03:55:10.882Z","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
