{"parentUuid":"a7117b1f-b751-4ba4-8129-5b615a1efd8c","isSidechain":false,"promptId":"54a96065-3665-4048-935d-5f0e34b4c75d","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013AcpjPYcmqg4s2ZN5nNqRG","type":"tool_result","content":"File created successfully at: /data/data/com.termux/files/home/freelang-light/src/search-api.js"}]},"uuid":"946f264d-6489-4314-a78b-b7ec817cc373","timestamp":"2026-03-12T07:13:01.183Z","toolUseResult":{"type":"create","filePath":"/data/data/com.termux/files/home/freelang-light/src/search-api.js","content":"/**\n * FreeLang Light Search API Server\n * 검색 엔드포인트 제공\n */\n\nconst http = require('http');\nconst fs = require('fs');\nconst path = require('path');\nconst url = require('url');\nconst { FreeLangIndexer } = require('./indexer');\n\nconst PORT = 4002;\n\nclass FreeLangSearchAPI {\n  constructor() {\n    this.indexer = new FreeLangIndexer();\n    this.indexPath = path.join(__dirname, '..', 'freelang-light.index.json');\n    this.loadOrCreateIndex();\n  }\n\n  loadOrCreateIndex() {\n    if (fs.existsSync(this.indexPath)) {\n      try {\n        this.indexer.loadIndex(this.indexPath);\n        console.log(`✅ Loaded existing index`);\n      } catch (e) {\n        console.warn(`⚠️ Failed to load index, creating new one`);\n        this.createIndex();\n      }\n    } else {\n      this.createIndex();\n    }\n  }\n\n  createIndex() {\n    const examplesDir = path.join(__dirname, '..', 'examples');\n    if (fs.existsSync(examplesDir)) {\n      this.indexer.indexDirectory(examplesDir);\n      this.indexer.saveIndex(this.indexPath);\n    }\n  }\n\n  startServer() {\n    const server = http.createServer((req, res) => {\n      // CORS 설정\n      res.setHeader('Content-Type', 'application/json');\n      res.setHeader('Access-Control-Allow-Origin', '*');\n      res.setHeader('Access-Control-Allow-Methods', 'GET, OPTIONS');\n      res.setHeader('Access-Control-Allow-Headers', 'Content-Type');\n\n      // OPTIONS 요청 처리\n      if (req.method === 'OPTIONS') {\n        res.writeHead(200);\n        return res.end();\n      }\n\n      const parsedUrl = url.parse(req.url, true);\n      const pathname = parsedUrl.pathname;\n      const query = parsedUrl.query;\n\n      // 헬스 체크\n      if (pathname === '/api/health') {\n        const stats = this.indexer.getStats();\n        return res.end(JSON.stringify({\n          status: '✅ ok',\n          indexed_at: new Date().toISOString(),\n          ...stats\n        }));\n      }\n\n      // 검색\n      if (pathname === '/api/search') {\n        const q = query.q || '';\n\n        if (!q) {\n          res.writeHead(400);\n          return res.end(JSON.stringify({\n            error: 'Query parameter \"q\" is required'\n          }));\n        }\n\n        const results = this.indexer.search(q);\n        return res.end(JSON.stringify(results));\n      }\n\n      // 3단어 검색 (freelang-v2의 KPM과 호환)\n      if (pathname === '/api/search-three-words') {\n        const word1 = query.w1 || '';\n        const word2 = query.w2 || '';\n        const word3 = query.w3 || '';\n\n        const allWords = [word1, word2, word3].filter(w => w).join(' ');\n\n        if (!allWords) {\n          res.writeHead(400);\n          return res.end(JSON.stringify({\n            error: 'At least one word parameter required (w1, w2, w3)'\n          }));\n        }\n\n        const results = this.indexer.search(allWords);\n        return res.end(JSON.stringify({\n          ...results,\n          search_mode: 'three-words'\n        }));\n      }\n\n      // 컴포넌트 상세 조회\n      if (pathname.startsWith('/api/component/')) {\n        const componentName = pathname.replace('/api/component/', '');\n        const entry = this.indexer.index.find(e =>\n          e.component.toLowerCase() === componentName.toLowerCase()\n        );\n\n        if (!entry) {\n          res.writeHead(404);\n          return res.end(JSON.stringify({\n            error: `Component '${componentName}' not found`\n          }));\n        }\n\n        return res.end(JSON.stringify({\n          component: entry.component,\n          file: entry.file,\n          props: entry.props,\n          functions: entry.functions,\n          styles: entry.styles,\n          markup_elements: entry.markup,\n          file_size: entry.file_size,\n          ranking: entry.ranking\n        }));\n      }\n\n      // 모든 컴포넌트 목록\n      if (pathname === '/api/components') {\n        const list = this.indexer.index.map(e => ({\n          name: e.component,\n          file: e.file,\n          props_count: e.props.length,\n          functions_count: e.functions.length,\n          styles_count: e.styles.length,\n          ranking: e.ranking\n        }));\n\n        return res.end(JSON.stringify({\n          total: list.length,\n          components: list\n        }));\n      }\n\n      // API 문서\n      if (pathname === '/api/docs') {\n        return res.end(JSON.stringify({\n          name: 'FreeLang Light Search API',\n          version: '1.0',\n          endpoints: [\n            {\n              method: 'GET',\n              path: '/api/health',\n              description: 'Health check',\n              example: 'GET /api/health'\n            },\n            {\n              method: 'GET',\n              path: '/api/search?q=button',\n              description: 'Search components by query',\n              example: 'GET /api/search?q=button'\n            },\n            {\n              method: 'GET',\n              path: '/api/search-three-words?w1=button&w2=click&w3=event',\n              description: 'Search with three words (compatible with KPM)',\n              example: 'GET /api/search-three-words?w1=button&w2=click&w3=event'\n            },\n            {\n              method: 'GET',\n              path: '/api/component/Button',\n              description: 'Get component details',\n              example: 'GET /api/component/Button'\n            },\n            {\n              method: 'GET',\n              path: '/api/components',\n              description: 'List all components',\n              example: 'GET /api/components'\n            },\n            {\n              method: 'GET',\n              path: '/api/docs',\n              description: 'API documentation',\n              example: 'GET /api/docs'\n            }\n          ],\n          examples: [\n            {\n              description: 'Search for button-related components',\n              request: 'GET http://localhost:4002/api/search?q=button',\n              response: {\n                query: 'button',\n                total_results: 2,\n                results: [\n                  {\n                    component: 'Button',\n                    file: 'examples/button.free',\n                    type: 'component',\n                    props: 2,\n                    functions: 3,\n                    ranking: 45\n                  }\n                ]\n              }\n            }\n          ]\n        }));\n      }\n\n      // 404\n      res.writeHead(404);\n      res.end(JSON.stringify({\n        error: 'Not found',\n        available_endpoints: ['/api/health', '/api/search', '/api/components', '/api/docs']\n      }));\n    });\n\n    server.listen(PORT, () => {\n      console.log(`\\n🚀 FreeLang Light Search API running on http://localhost:${PORT}`);\n      console.log(`📖 API Docs: http://localhost:${PORT}/api/docs\\n`);\n      console.log(`📊 Server Stats:`);\n      const stats = this.indexer.getStats();\n      console.log(`   Components: ${stats.total_components}`);\n      console.log(`   Indexed Items: ${stats.total_indexed_items}`);\n      console.log(`   Total Functions: ${stats.total_functions}\\n`);\n    });\n\n    return server;\n  }\n\n  // CLI 사용을 위한 메서드들\n  searchCLI(query) {\n    const results = this.indexer.search(query);\n    return results;\n  }\n\n  indexDirectoryCLI(dirPath) {\n    this.indexer.indexDirectory(dirPath);\n    this.indexer.saveIndex(this.indexPath);\n  }\n\n  getStatsCLI() {\n    return this.indexer.getStats();\n  }\n}\n\n// 직접 실행 시\nif (require.main === module) {\n  const api = new FreeLangSearchAPI();\n  api.startServer();\n}\n\nmodule.exports = { FreeLangSearchAPI };\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"a7117b1f-b751-4ba4-8129-5b615a1efd8c","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-light","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
