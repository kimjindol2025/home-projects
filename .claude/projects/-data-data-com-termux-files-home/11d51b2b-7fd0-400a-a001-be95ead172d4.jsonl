      braceCount--;\n        if (braceCount > 0) {\n          content += token.value;\n        }\n        this.advance();\n      } else {\n        content += token.value;\n        this.advance();\n      }\n    }\n\n    return {\n      type: 'script',\n      functions,\n      rawContent: content.trim()\n    };\n  }\n\n  parseMarkupBlock() {\n    this.expect('MARKUP');\n    this.expect('LBRACE');\n\n    let content = '';\n    let braceCount = 1;\n\n    while (braceCount > 0 && this.peek()) {\n      const token = this.peek();\n\n      if (token.type === 'LBRACE') {\n        braceCount++;\n        content += token.value;\n      } else if (token.type === 'RBRACE') {\n        braceCount--;\n        if (braceCount > 0) {\n          content += token.value;\n        }\n      } else if (token.type === 'STRING') {\n        content += `\"${token.value}\"`;\n      } else if (token.type === 'NUMBER') {\n        content += token.value;\n      } else {\n        content += token.value;\n      }\n\n      this.advance();\n    }\n\n    return {\n      type: 'markup',\n      content: content.trim()\n    };\n  }\n}\n\nfunction parseFreeLang(source) {\n  const tokenizer = new Tokenizer(source);\n  const tokens = tokenizer.tokenize();\n\n  const parser = new Parser(tokens);\n  const ast = parser.parseComponent();\n\n  return ast;\n}\n\nmodule.exports = { parseFreeLang, Tokenizer, Parser };\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"60a88881-f29f-4734-8fdf-f38f55efb15f","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-light","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
