   */\n  processLoops(markup, context = {}) {\n    const allContext = { ...this.props, ...context };\n\n    // {for ...} 패턴 찾기\n    const forPattern = /\\{for\\s+(\\w+)\\s+in\\s+(\\w+)\\s*\\?\\s*(.+?)\\s*\\}/gs;\n\n    return markup.replace(forPattern, (match, itemVar, arrayVar, template) => {\n      try {\n        const array = allContext[arrayVar];\n\n        if (!Array.isArray(array)) {\n          console.warn(`\"${arrayVar}\" is not an array`);\n          return '';\n        }\n\n        // 각 아이템에 대해 템플릿 반복\n        return array.map((item, index) => {\n          const itemContext = {\n            ...allContext,\n            [itemVar]: item,\n            [`${itemVar}_index`]: index,\n            [`${itemVar}_first`]: index === 0,\n            [`${itemVar}_last`]: index === array.length - 1\n          };\n\n          return this.substituteVariables(template.trim(), itemContext);\n        }).join('');\n      } catch (error) {\n        console.warn(`Loop processing failed: \"for ${itemVar} in ${arrayVar}\"`, error.message);\n        return '';\n      }\n    });\n  }\n\n  /**\n   * 변수 치환\n   * {변수명} → 값으로 대체\n   */\n  substituteVariables(markup, context = {}) {\n    const allContext = { ...this.props, ...context };\n\n    // {변수명} 패턴 찾기\n    const varPattern = /\\{([a-zA-Z_]\\w*)\\}/g;\n\n    return markup.replace(varPattern, (match, varName) => {\n      const value = allContext[varName];\n\n      if (value === null || value === undefined) {\n        return '';\n      }\n\n      if (typeof value === 'object') {\n        return JSON.stringify(value);\n      }\n\n      return String(value);\n    });\n  }\n\n  /**\n   * 바인딩 표현식 처리 (onclick, onchange 등)\n   * onclick=\"handler(this, {param})\"\n   */\n  processBindings(html, context = {}) {\n    const allContext = { ...this.props, ...context };\n\n    // 속성값의 {변수}를 치환\n    const bindPattern = /(\\w+)=\"([^\"]*)\"/g;\n\n    return html.replace(bindPattern, (match, attrName, attrValue) => {\n      let newValue = attrValue;\n\n      // 속성값 내의 {변수} 치환\n      newValue = newValue.replace(/\\{([a-zA-Z_]\\w*)\\}/g, (m, varName) => {\n        const value = allContext[varName];\n        return value !== undefined && value !== null ? String(value) : '';\n      });\n\n      return `${attrName}=\"${newValue}\"`;\n    });\n  }\n\n  /**\n   * 전체 처리 (모든 단계)\n   */\n  processComplete(markup, context = {}) {\n    let result = markup;\n\n    // 조건 처리\n    result = this.processConditions(result, context);\n\n    // 반복 처리\n    result = this.processLoops(result, context);\n\n    // 바인딩 처리\n    result = this.processBindings(result, context);\n\n    // 변수 치환\n    result = this.substituteVariables(result, context);\n\n    return result;\n  }\n}\n\nmodule.exports = { MarkupProcessor };\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"b92493a0-12bf-4d41-82a5-23154a4c7fcc","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-light","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
