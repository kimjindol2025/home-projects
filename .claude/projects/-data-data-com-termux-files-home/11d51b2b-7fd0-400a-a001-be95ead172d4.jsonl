{"parentUuid":"3309e2c1-89bb-430d-9eaa-f26e7576280e","isSidechain":false,"promptId":"49b9e97e-88a9-4cf6-aeab-eef05075e70b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UpmZFkevhNWxQcFTpqXfV9","type":"tool_result","content":"File created successfully at: /data/data/com.termux/files/home/freelang-light/src/test-bundler.js"}]},"uuid":"bfd3dc18-a856-44a3-a36c-a06c47dfa5fe","timestamp":"2026-03-12T07:21:42.253Z","toolUseResult":{"type":"create","filePath":"/data/data/com.termux/files/home/freelang-light/src/test-bundler.js","content":"/**\n * Bundler Tests\n */\n\nconst fs = require('fs');\nconst path = require('path');\nconst { Bundler } = require('./bundler');\n\nfunction test(name, fn) {\n  try {\n    fn();\n    console.log(`✅ ${name}`);\n  } catch (error) {\n    console.error(`❌ ${name}: ${error.message}`);\n  }\n}\n\nconst testDir = path.join(__dirname, '..', 'test-bundles');\nif (!fs.existsSync(testDir)) {\n  fs.mkdirSync(testDir, { recursive: true });\n}\n\nconsole.log('\\n📦 Bundler Tests\\n');\n\ntest('번들러 생성', () => {\n  const bundler = new Bundler({\n    bundleName: 'test-app',\n    outputDir: testDir,\n    minify: false\n  });\n  if (!bundler.options) throw new Error('Bundler not initialized');\n});\n\ntest('CSS 최소화', () => {\n  const bundler = new Bundler();\n  const css = `\n    /* Comment */\n    .button {\n      padding: 10px;\n      color: red;\n    }\n  `;\n  const minified = bundler.minifyCSS(css);\n  if (minified.includes('/*')) throw new Error('Comments not removed');\n  if (minified.length >= css.length) throw new Error('Not minified');\n});\n\ntest('JavaScript 최소화', () => {\n  const bundler = new Bundler();\n  const js = `\n    // Comment\n    function test() {\n      console.log(\"hello\");\n    }\n  `;\n  const minified = bundler.minifyJS(js);\n  if (minified.includes('//')) throw new Error('Comments not removed');\n});\n\ntest('해시값 계산', () => {\n  const bundler = new Bundler();\n  const hash1 = bundler.calculateHash('hello');\n  const hash2 = bundler.calculateHash('hello');\n  if (hash1 !== hash2) throw new Error('Hash mismatch');\n  if (hash1.length !== 8) throw new Error('Invalid hash length');\n});\n\ntest('번들 통계', () => {\n  const bundler = new Bundler();\n  bundler.assets.css.push({ name: 'test', content: 'body {}' });\n  bundler.assets.js.push({ name: 'test', content: 'console.log(\"test\")' });\n  bundler.manifest.components = ['test'];\n\n  const stats = bundler.getStats();\n  if (stats.components !== 1) throw new Error('Invalid component count');\n  if (stats.css_files !== 1) throw new Error('Invalid CSS file count');\n});\n\ntest('코드 들여쓰기', () => {\n  const bundler = new Bundler();\n  const code = 'line1\\nline2';\n  const indented = bundler.indentCode(code, 2);\n  if (!indented.startsWith('  ')) throw new Error('Not indented');\n});\n\nconsole.log('\\n✨ Bundler 테스트 완료!\\n');\n\n// 실제 번들링 테스트\nconsole.log('🎯 실제 번들링 테스트\\n');\n\ntry {\n  // 예제 CSS/JS/HTML 파일 생성\n  const exampleDir = path.join(testDir, 'example-components');\n  if (!fs.existsSync(exampleDir)) {\n    fs.mkdirSync(exampleDir, { recursive: true });\n  }\n\n  // 예제 파일 생성\n  fs.writeFileSync(path.join(exampleDir, 'demo1.css'), `.demo1 { color: blue; }`);\n  fs.writeFileSync(path.join(exampleDir, 'demo1.js'), `function demo1() { console.log(\"demo1\"); }`);\n  fs.writeFileSync(path.join(exampleDir, 'demo1.html'), `<div class=\"demo1\">Demo 1</div>`);\n\n  fs.writeFileSync(path.join(exampleDir, 'demo2.css'), `.demo2 { color: red; }`);\n  fs.writeFileSync(path.join(exampleDir, 'demo2.js'), `function demo2() { console.log(\"demo2\"); }`);\n  fs.writeFileSync(path.join(exampleDir, 'demo2.html'), `<div class=\"demo2\">Demo 2</div>`);\n\n  // 번들링\n  const bundler = new Bundler({\n    bundleName: 'demo-bundle',\n    outputDir: testDir,\n    minify: true,\n    sourcemap: true\n  });\n\n  bundler.bundleComponent(path.join(exampleDir, 'demo1.css'));\n  bundler.bundleComponent(path.join(exampleDir, 'demo1.js'));\n  bundler.bundleComponent(path.join(exampleDir, 'demo1.html'));\n\n  const result = bundler.generate();\n\n  console.log('📊 번들링 결과:');\n  console.log(`   CSS: ${result.css}`);\n  console.log(`   JS: ${result.js}`);\n  console.log(`   HTML: ${result.html}`);\n  console.log(`\\n📈 통계:`);\n  console.log(`   Components: ${result.stats.components}`);\n  console.log(`   Total Size: ${result.stats.total_size_uncompressed} bytes`);\n  console.log(`   CSS Size: ${result.stats.css_size} bytes`);\n  console.log(`   JS Size: ${result.stats.js_size} bytes`);\n\n  // 파일 존재 확인\n  if (fs.existsSync(result.css)) {\n    console.log(`\\n✅ 번들 생성 성공!`);\n  }\n} catch (error) {\n  console.error(`❌ 번들링 실패: ${error.message}`);\n}\n\nconsole.log();\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"3309e2c1-89bb-430d-9eaa-f26e7576280e","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-light","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
