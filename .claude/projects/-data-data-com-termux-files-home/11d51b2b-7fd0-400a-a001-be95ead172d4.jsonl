{"parentUuid":"6a438457-e9b4-46a9-a8be-067f9f86a89d","isSidechain":false,"message":{"model":"claude-haiku-4-5-20251001","id":"msg_01RC3pxrth86A692cnRb4eba","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01THTnqspHfNAe7L23QZ6D8Z","name":"Write","input":{"file_path":"/data/data/com.termux/files/home/freelang-hybrid/freelang/core/database-transactions.js","content":"// ============================================================================\n// Phase 2: Database with Transaction Support (Pure Node.js)\n// ============================================================================\n\nconst fs = require('fs');\nconst path = require('path');\nconst crypto = require('crypto');\n\nconst DB_PATH = path.join(__dirname, '../../db/blogs-transactions.json');\nconst LOCK_DIR = path.join(__dirname, '../../db/locks');\nconst TRANSACTION_LOG_PATH = path.join(__dirname, '../../db/transaction-log.json');\n\n// Ensure directories exist\nfunction ensureDirs() {\n  const dbDir = path.dirname(DB_PATH);\n  if (!fs.existsSync(dbDir)) {\n    fs.mkdirSync(dbDir, { recursive: true });\n  }\n  if (!fs.existsSync(LOCK_DIR)) {\n    fs.mkdirSync(LOCK_DIR, { recursive: true });\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Transaction Management\n// ──────────────────────────────────────────────────────────────────────────\n\nclass TransactionManager {\n  constructor() {\n    this.activeTransactions = new Map();\n    this.transactionLog = [];\n    this.locks = new Map();\n    ensureDirs();\n  }\n\n  beginTransaction(txId = null) {\n    const id = txId || generateId();\n    this.activeTransactions.set(id, {\n      id,\n      status: 'ACTIVE',\n      startTime: Date.now(),\n      operations: [],\n      snapshot: this.getCurrentSnapshot()\n    });\n\n    this.logTransaction(id, null, 'BEGIN', 'started');\n    console.log(`✅ Transaction started: ${id}`);\n\n    return {\n      success: true,\n      transactionId: id,\n      timestamp: new Date().toISOString()\n    };\n  }\n\n  recordOperation(txId, operation, data) {\n    const tx = this.activeTransactions.get(txId);\n    if (!tx) {\n      return { success: false, error: 'Transaction not found' };\n    }\n\n    tx.operations.push({\n      type: operation,\n      data,\n      timestamp: Date.now()\n    });\n\n    return { success: true };\n  }\n\n  commitTransaction(txId) {\n    const tx = this.activeTransactions.get(txId);\n    if (!tx) {\n      return { success: false, error: 'Transaction not found' };\n    }\n\n    try {\n      // Write all operations to file atomically\n      const data = this.loadDatabase();\n\n      for (const op of tx.operations) {\n        this.applyOperation(data, op);\n      }\n\n      // Atomic write\n      fs.writeFileSync(DB_PATH, JSON.stringify(data, null, 2));\n\n      this.activeTransactions.delete(txId);\n      this.logTransaction(txId, null, 'COMMIT', 'completed');\n\n      console.log(`✅ Transaction committed: ${txId}`);\n      return { success: true };\n    } catch (err) {\n      console.error('❌ Commit failed:', err.message);\n      return { success: false, error: err.message };\n    }\n  }\n\n  rollbackTransaction(txId) {\n    const tx = this.activeTransactions.get(txId);\n    if (!tx) {\n      return { success: false, error: 'Transaction not found' };\n    }\n\n    this.activeTransactions.delete(txId);\n    this.logTransaction(txId, null, 'ROLLBACK', 'rolled_back');\n\n    console.log(`⚠️ Transaction rolled back: ${txId}`);\n    return { success: true };\n  }\n\n  applyOperation(data, op) {\n    switch (op.type) {\n      case 'INSERT':\n        data.push(op.data);\n        break;\n      case 'UPDATE':\n        const updateIdx = data.findIndex(b => b.id === op.data.id);\n        if (updateIdx >= 0) {\n          data[updateIdx] = { ...data[updateIdx], ...op.data };\n          data[updateIdx].version = (data[updateIdx].version || 0) + 1;\n        }\n        break;\n      case 'DELETE':\n        const deleteIdx = data.findIndex(b => b.id === op.data.id);\n        if (deleteIdx >= 0) {\n          data.splice(deleteIdx, 1);\n        }\n        break;\n    }\n  }\n\n  getCurrentSnapshot() {\n    try {\n      return JSON.parse(fs.readFileSync(DB_PATH, 'utf8'));\n    } catch {\n      return [];\n    }\n  }\n\n  loadDatabase() {\n    ensureDirs();\n    try {\n      if (fs.existsSync(DB_PATH)) {\n        return JSON.parse(fs.readFileSync(DB_PATH, 'utf8'));\n      }\n    } catch (err) {\n      console.warn('⚠️ Database load warning:', err.message);\n    }\n    return [];\n  }\n\n  logTransaction(txId, blogId, operation, status) {\n    this.transactionLog.push({\n      id: txId,\n      blogId,\n      operation,\n      status,\n      timestamp: new Date().toISOString()\n    });\n\n    // Keep last 1000 logs\n    if (this.transactionLog.length > 1000) {\n      this.transactionLog.shift();\n    }\n\n    // Persist transaction log\n    try {\n      fs.writeFileSync(TRANSACTION_LOG_PATH, JSON.stringify(this.transactionLog, null, 2));\n    } catch (err) {\n      console.warn('⚠️ Transaction log write failed:', err.message);\n    }\n  }\n\n  getTransactionLog(limit = 100) {\n    return {\n      success: true,\n      data: this.transactionLog.slice(-limit)\n    };\n  }\n\n  // Optimistic locking\n  acquireLock(blogId, txId) {\n    if (this.locks.has(blogId)) {\n      const lock = this.locks.get(blogId);\n      if (Date.now() - lock.acquiredAt > 30000) {\n        // Lock expired\n        this.locks.delete(blogId);\n      } else {\n        return {\n          success: false,\n          error: `Resource locked by ${lock.txId}`\n        };\n      }\n    }\n\n    this.locks.set(blogId, {\n      txId,\n      acquiredAt: Date.now()\n    });\n\n    return { success: true };\n  }\n\n  releaseLock(blogId) {\n    this.locks.delete(blogId);\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Database Operations\n// ──────────────────────────────────────────────────────────────────────────\n\nconst txManager = new TransactionManager();\n\nfunction connectDatabase() {\n  ensureDirs();\n  return {\n    insertBlog,\n    getBlog,\n    getAllBlogs,\n    updateBlog,\n    deleteBlog,\n    searchBlogs,\n    beginTransaction,\n    commitTransaction,\n    rollbackTransaction,\n    getTransactionLog\n  };\n}\n\nfunction beginTransaction(txId = null) {\n  return txManager.beginTransaction(txId);\n}\n\nfunction commitTransaction(txId) {\n  return txManager.commitTransaction(txId);\n}\n\nfunction rollbackTransaction(txId) {\n  return txManager.rollbackTransaction(txId);\n}\n\nfunction insertBlog(blog, txId = null) {\n  const blogId = blog.id || generateId();\n  const now = new Date().toISOString();\n\n  const record = {\n    id: blogId,\n    title: blog.title || 'Untitled',\n    content: blog.content || '',\n    author: blog.author || 'Unknown',\n    createdAt: blog.createdAt || now,\n    updatedAt: blog.updatedAt || now,\n    views: blog.views || 0,\n    version: 1,\n    deleted: false,\n    createdBy: blog.createdBy || blog.author,\n    lastModifiedBy: blog.lastModifiedBy || blog.author,\n    status: blog.status || 'draft'\n  };\n\n  if (txId) {\n    // Record operation in transaction\n    const result = txManager.recordOperation(txId, 'INSERT', record);\n    if (!result.success) return result;\n\n    txManager.logTransaction(txId, blogId, 'INSERT', 'recorded');\n    console.log(`✅ Blog INSERT recorded in transaction: ${blogId}`);\n  } else {\n    // Immediate write\n    try {\n      const data = txManager.loadDatabase();\n      data.push(record);\n      fs.writeFileSync(DB_PATH, JSON.stringify(data, null, 2));\n\n      txManager.logTransaction(null, blogId, 'INSERT', 'completed');\n      console.log(`✅ Blog inserted: ${blogId}`);\n    } catch (err) {\n      console.error('❌ Insert failed:', err.message);\n      return { success: false, error: err.message };\n    }\n  }\n\n  return { success: true, id: blogId };\n}\n\nfunction getBlog(blogId, txId = null) {\n  try {\n    const data = txManager.loadDatabase();\n    const blog = data.find(b => b.id === blogId && !b.deleted);\n\n    if (blog) {\n      // Increment views\n      blog.views = (blog.views || 0) + 1;\n      if (!txId) {\n        fs.writeFileSync(DB_PATH, JSON.stringify(data, null, 2));\n      }\n\n      txManager.logTransaction(txId, blogId, 'SELECT', 'completed');\n      return { success: true, data: blog };\n    }\n\n    return { success: false, error: 'Blog not found' };\n  } catch (err) {\n    console.error('❌ Get blog failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction getAllBlogs(limit = 100, offset = 0) {\n  try {\n    const data = txManager.loadDatabase();\n    const blogs = data\n      .filter(b => !b.deleted)\n      .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt))\n      .slice(offset, offset + limit);\n\n    txManager.logTransaction(null, null, 'SELECT_ALL', 'completed');\n    return {\n      success: true,\n      data: blogs,\n      total: data.filter(b => !b.deleted).length\n    };\n  } catch (err) {\n    console.error('❌ Get all blogs failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction updateBlog(blogId, updates, txId = null) {\n  try {\n    const data = txManager.loadDatabase();\n    const blog = data.find(b => b.id === blogId && !b.deleted);\n\n    if (!blog) {\n      return { success: false, error: 'Blog not found' };\n    }\n\n    // Version conflict detection (optimistic locking)\n    if (updates.version && updates.version !== blog.version) {\n      return {\n        success: false,\n        error: 'Version conflict - concurrent modification detected'\n      };\n    }\n\n    const oldVersion = blog.version || 1;\n    const newBlog = {\n      ...blog,\n      title: updates.title || blog.title,\n      content: updates.content || blog.content,\n      author: updates.author || blog.author,\n      updatedAt: new Date().toISOString(),\n      version: oldVersion + 1,\n      lastModifiedBy: updates.lastModifiedBy || blog.author,\n      status: updates.status || blog.status\n    };\n\n    if (txId) {\n      txManager.recordOperation(txId, 'UPDATE', newBlog);\n      txManager.logTransaction(txId, blogId, 'UPDATE', 'recorded');\n      console.log(`✅ Blog UPDATE recorded in transaction: ${blogId}`);\n    } else {\n      const idx = data.findIndex(b => b.id === blogId);\n      if (idx >= 0) {\n        data[idx] = newBlog;\n        fs.writeFileSync(DB_PATH, JSON.stringify(data, null, 2));\n      }\n      txManager.logTransaction(null, blogId, 'UPDATE', 'completed');\n      console.log(`✅ Blog updated: ${blogId} (v${oldVersion} → v${newBlog.version})`);\n    }\n\n    return { success: true, version: newBlog.version };\n  } catch (err) {\n    console.error('❌ Update failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction deleteBlog(blogId, txId = null, hardDelete = false) {\n  try {\n    const data = txManager.loadDatabase();\n    const idx = data.findIndex(b => b.id === blogId);\n\n    if (idx < 0) {\n      return { success: false, error: 'Blog not found' };\n    }\n\n    if (hardDelete) {\n      if (txId) {\n        txManager.recordOperation(txId, 'DELETE', { id: blogId });\n        txManager.logTransaction(txId, blogId, 'DELETE', 'recorded');\n      } else {\n        data.splice(idx, 1);\n        fs.writeFileSync(DB_PATH, JSON.stringify(data, null, 2));\n        txManager.logTransaction(null, blogId, 'DELETE', 'completed');\n      }\n      console.log(`✅ Blog hard-deleted: ${blogId}`);\n    } else {\n      data[idx].deleted = true;\n      data[idx].updatedAt = new Date().toISOString();\n\n      if (!txId) {\n        fs.writeFileSync(DB_PATH, JSON.stringify(data, null, 2));\n      }\n      txManager.logTransaction(txId, blogId, 'SOFT_DELETE', 'completed');\n      console.log(`✅ Blog soft-deleted: ${blogId}`);\n    }\n\n    return { success: true };\n  } catch (err) {\n    console.error('❌ Delete failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction searchBlogs(query, filters = {}) {\n  try {\n    let data = txManager.loadDatabase();\n\n    if (query) {\n      const q = query.toLowerCase();\n      data = data.filter(b =>\n        !b.deleted && (\n          b.title.toLowerCase().includes(q) ||\n          b.content.toLowerCase().includes(q) ||\n          b.author.toLowerCase().includes(q)\n        )\n      );\n    } else {\n      data = data.filter(b => !b.deleted);\n    }\n\n    if (filters.author) {\n      data = data.filter(b => b.author === filters.author);\n    }\n\n    if (filters.status) {\n      data = data.filter(b => b.status === filters.status);\n    }\n\n    if (filters.minViews !== undefined) {\n      data = data.filter(b => (b.views || 0) >= filters.minViews);\n    }\n\n    txManager.logTransaction(null, null, 'SEARCH', 'completed');\n    return {\n      success: true,\n      data: data.slice(0, 100),\n      count: data.length\n    };\n  } catch (err) {\n    console.error('❌ Search failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nfunction getTransactionLog(limit = 100) {\n  return txManager.getTransactionLog(limit);\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Batch Operations\n// ──────────────────────────────────────────────────────────────────────────\n\nfunction batchInsert(blogs) {\n  const tx = beginTransaction();\n  if (!tx.success) return tx;\n\n  try {\n    for (const blog of blogs) {\n      const result = insertBlog(blog, tx.transactionId);\n      if (!result.success) {\n        rollbackTransaction(tx.transactionId);\n        return result;\n      }\n    }\n\n    commitTransaction(tx.transactionId);\n    console.log(`✅ Batch inserted ${blogs.length} blogs`);\n    return { success: true, count: blogs.length };\n  } catch (err) {\n    rollbackTransaction(tx.transactionId);\n    console.error('❌ Batch insert failed:', err.message);\n    return { success: false, error: err.message };\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Utility Functions\n// ──────────────────────────────────────────────────────────────────────────\n\nfunction generateId() {\n  return crypto.randomBytes(8).toString('hex');\n}\n\nfunction close() {\n  console.log('✅ Database closed');\n}\n\n// Export\nmodule.exports = {\n  connectDatabase,\n  close,\n  batchInsert,\n  _path: DB_PATH,\n  _txManager: txManager\n};\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":696,"cache_read_input_tokens":116159,"output_tokens":4556,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":696,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"}},"requestId":"req_011CYzQbrppoiSErxgjkN7Fb","type":"assistant","uuid":"3d6ce3fd-fa61-4f80-bc70-ef4a2407baa7","timestamp":"2026-03-13T03:58:00.765Z","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
