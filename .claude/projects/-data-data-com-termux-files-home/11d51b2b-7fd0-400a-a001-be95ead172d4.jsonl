st result3 = ms.callService('nonexistent-server', 'PING', {});\nconsole.log(`✅ 에러 처리: ${result3.error}\\n`);\n\n// 테스트 8: 레지스트리 상태\nconsole.log('테스트 8️⃣: 레지스트리 상태');\nconst status = ms.getStatus();\nconsole.log(`✅ 온라인 서비스: ${status.onlineServices}개`);\nconsole.log(`✅ 총 헬스 체크: ${status.stats.totalHealthChecks}회`);\nconsole.log(`✅ 온라인 상태: ${status.stats.healthyServices}회\\n`);\n\n// 테스트 9: 서비스 등록 해제\nconsole.log('테스트 9️⃣: 서비스 등록 해제');\nms.deregisterService(authServer.id);\nconsole.log(`✅ 남은 서비스: ${ms.listServices().length}개\\n`);\n\nconsole.log('✅ Phase 5 Microservices 모든 테스트 통과!');\nconsole.log('🌐 마이크로서비스 아키텍처: 완전히 작동 중');\nTESTEOF\n\nnode /tmp/test-microservices-phase5.js","description":"Test Phase 5 Microservices with registry and discovery"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":2691,"cache_read_input_tokens":149933,"output_tokens":1265,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2691,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"}},"requestId":"req_011CYzKFXemFvRYbFCKEngnv","type":"assistant","uuid":"64fbfa6f-f3d8-49b2-8a2d-4b34526ad4e5","timestamp":"2026-03-13T02:47:32.639Z","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
