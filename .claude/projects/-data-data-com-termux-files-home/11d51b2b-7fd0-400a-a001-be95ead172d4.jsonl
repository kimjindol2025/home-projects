{"parentUuid":"9c3fc9a7-6c8a-473f-925b-a932e397dad8","isSidechain":false,"message":{"model":"claude-haiku-4-5-20251001","id":"msg_01QKhHn1dBkKAXSue3h4TyiM","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DzdyUe9q7E4FrYa7JW21Z2","name":"Write","input":{"file_path":"/data/data/com.termux/files/home/freelang-hybrid/freelang/core/tailwind-parser.free","content":"// ============================================================================\n// Phase 13: Class Parser & JIT Compiler\n// HTML에서 사용된 Tailwind 클래스를 추출하여 필요한 CSS만 생성\n// ============================================================================\n\nimport { getTailwindConfig } from \"./tailwind-config\"\nimport { generateLightThemeCSS, generateDarkThemeCSS } from \"./tailwind-generator\"\n\n// ──────────────────────────────────────────────────────────────────────────\n// HTML Class Extractor\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc extractClassesFromHTML(htmlContent: String) -> any {\n  let classRegex = \"class=\\\"([^\\\"]*)\\\"\"\n  let matches = []\n  let classSet = {}\n\n  // Simple regex-like pattern matching\n  let lines = htmlContent.split(\"\\n\")\n\n  for line in lines {\n    if line.contains(\"class=\") {\n      let startIdx = line.indexOf(\"class=\\\"\")\n      if startIdx >= 0 {\n        let endIdx = line.indexOf(\"\\\"\", startIdx + 7)\n        if endIdx > startIdx {\n          let classStr = line.substring(startIdx + 7, endIdx)\n          let classes = classStr.split(\" \")\n\n          for cls in classes {\n            if cls.length() > 0 && cls != \" \" {\n              classSet[cls] = true\n            }\n          }\n        }\n      }\n    }\n  }\n\n  let classArray = []\n  for cls in classSet {\n    classArray.append(cls)\n  }\n\n  return classArray\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Class Category Detector\n// 클래스를 카테고리별로 분류\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc classifyClass(className: String) -> any {\n  // 반응형 prefix 체크\n  if className.startsWith(\"sm-\") || className.startsWith(\"md-\") || className.startsWith(\"lg-\") || className.startsWith(\"xl-\") {\n    return \"responsive\"\n  }\n\n  // 상태 prefix 체크\n  if className.startsWith(\"hover-\") {\n    return \"hover\"\n  }\n  if className.startsWith(\"active-\") {\n    return \"active\"\n  }\n  if className.startsWith(\"focus-\") {\n    return \"focus\"\n  }\n  if className.startsWith(\"disabled-\") {\n    return \"disabled\"\n  }\n  if className.startsWith(\"group-\") {\n    return \"group\"\n  }\n  if className.startsWith(\"dark-\") {\n    return \"dark\"\n  }\n  if className.startsWith(\"transition\") || className.startsWith(\"duration-\") || className.startsWith(\"ease-\") {\n    return \"transition\"\n  }\n\n  // Display 클래스\n  if className.contains(\"flex\") || className.contains(\"grid\") || className.contains(\"block\") || className.contains(\"hidden\") || className.contains(\"inline\") {\n    return \"display\"\n  }\n\n  // Spacing 클래스\n  if className.startsWith(\"p-\") || className.startsWith(\"m-\") || className.startsWith(\"px-\") || className.startsWith(\"py-\") || className.startsWith(\"mx-\") || className.startsWith(\"my-\") {\n    return \"spacing\"\n  }\n\n  // Color 클래스\n  if className.startsWith(\"bg-\") || className.startsWith(\"text-\") || className.startsWith(\"border-\") {\n    return \"color\"\n  }\n\n  // Size 클래스\n  if className.startsWith(\"w-\") || className.startsWith(\"h-\") || className.startsWith(\"text-\") || className.startsWith(\"gap-\") {\n    return \"size\"\n  }\n\n  // Flexbox 클래스\n  if className.contains(\"flex-\") || className.contains(\"justify-\") || className.contains(\"items-\") {\n    return \"flexbox\"\n  }\n\n  // Grid 클래스\n  if className.contains(\"grid-\") || className.contains(\"col-\") {\n    return \"grid\"\n  }\n\n  // Border 클래스\n  if className.startsWith(\"border\") || className.startsWith(\"rounded-\") {\n    return \"border\"\n  }\n\n  // Shadow 클래스\n  if className.startsWith(\"shadow-\") {\n    return \"shadow\"\n  }\n\n  // Typography 클래스\n  if className.startsWith(\"font-\") || className.startsWith(\"text-\") {\n    return \"typography\"\n  }\n\n  return \"utility\"\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Class Validator\n// Tailwind 시스템에서 지원하는 클래스인지 확인\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc isValidTailwindClass(className: String) -> any {\n  // Reserved keywords that are not valid classes\n  let reserved = [\"class\", \"id\", \"style\", \"data\", \"aria\", \"role\", \"tabindex\"]\n\n  for keyword in reserved {\n    if className == keyword {\n      return false\n    }\n  }\n\n  // Check if it matches known patterns\n  let patterns = [\n    // Display\n    { pattern: \"^(sm-|md-|lg-|xl-|)?(flex|grid|block|hidden|inline|inline-block)$\" },\n    // Spacing\n    { pattern: \"^(sm-|md-|lg-|xl-|)?(p|m|px|py|mx|my|mt|mb|ml|mr)(\\\\-[0-9]+)?$\" },\n    // Colors\n    { pattern: \"^(sm-|md-|lg-|xl-|)?(bg|text|border)\\\\-(gray|blue|red|green|yellow|purple)\\\\-(50|100|200|300|400|500|600|700|800|900)$\" },\n    // Typography\n    { pattern: \"^(sm-|md-|lg-|xl-|)?text\\\\-(xs|sm|base|lg|xl|2xl|3xl|4xl|5xl)$\" },\n    // Size\n    { pattern: \"^(sm-|md-|lg-|xl-|)?(w|h|gap|rounded)\\\\-[0-9a-z]+$\" },\n    // State\n    { pattern: \"^(hover|active|focus|disabled|group|dark|transition|duration|ease)\\\\-\" },\n    // Flexbox\n    { pattern: \"^(sm-|md-|lg-|xl-|)?(flex|justify|items|gap)\\\\-\" },\n    // Grid\n    { pattern: \"^(sm-|md-|lg-|xl-|)?grid\\\\-\" }\n  ]\n\n  // Simple pattern matching\n  if className.startsWith(\"p-\") || className.startsWith(\"m-\") || className.startsWith(\"gap-\") {\n    return true\n  }\n  if className.startsWith(\"bg-\") || className.startsWith(\"text-\") || className.startsWith(\"border-\") {\n    return true\n  }\n  if className.contains(\"flex\") || className.contains(\"grid\") || className.contains(\"block\") {\n    return true\n  }\n  if className.startsWith(\"hover-\") || className.startsWith(\"focus-\") || className.startsWith(\"active-\") {\n    return true\n  }\n  if className.startsWith(\"sm-\") || className.startsWith(\"md-\") || className.startsWith(\"lg-\") || className.startsWith(\"xl-\") {\n    return true\n  }\n  if className.startsWith(\"rounded-\") || className.startsWith(\"shadow-\") {\n    return true\n  }\n  if className.startsWith(\"transition\") || className.startsWith(\"duration-\") || className.startsWith(\"ease-\") {\n    return true\n  }\n  if className == \"group\" || className == \"dark\" {\n    return true\n  }\n\n  return false\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// CSS Rule Generator\n// 클래스명을 CSS 규칙으로 변환\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateCSSRule(className: String) -> any {\n  let config = getTailwindConfig()\n  let spacing = config[\"spacing\"]\n  let colors = config[\"colors\"]\n  let fontSize = config[\"fontSize\"]\n  let borderRadius = config[\"borderRadius\"]\n  let shadows = config[\"shadows\"]\n\n  // Display classes\n  if className == \"flex\" {\n    return \".flex { display: flex; }\"\n  }\n  if className == \"grid\" {\n    return \".grid { display: grid; }\"\n  }\n  if className == \"block\" {\n    return \".block { display: block; }\"\n  }\n  if className == \"hidden\" {\n    return \".hidden { display: none; }\"\n  }\n  if className == \"inline\" {\n    return \".inline { display: inline; }\"\n  }\n  if className == \"inline-block\" {\n    return \".inline-block { display: inline-block; }\"\n  }\n\n  // Padding classes\n  if className.startsWith(\"p-\") {\n    let scale = className.substring(2, className.length())\n    let value = spacing[scale]\n    if value {\n      return \".\\(className) { padding: \\(value); }\"\n    }\n  }\n\n  // Margin classes\n  if className.startsWith(\"m-\") && !className.startsWith(\"md-\") {\n    let scale = className.substring(2, className.length())\n    let value = spacing[scale]\n    if value {\n      return \".\\(className) { margin: \\(value); }\"\n    }\n  }\n\n  // Gap classes\n  if className.startsWith(\"gap-\") {\n    let scale = className.substring(4, className.length())\n    let value = spacing[scale]\n    if value {\n      return \".\\(className) { gap: \\(value); }\"\n    }\n  }\n\n  // Font size classes\n  if className.startsWith(\"text-\") && !className.startsWith(\"text-\") {\n    let sizeKey = className.substring(5, className.length())\n    let size = fontSize[sizeKey]\n    if size {\n      return \".\\(className) { font-size: \\(size); }\"\n    }\n  }\n\n  // Background color classes\n  if className.startsWith(\"bg-\") {\n    let rest = className.substring(3, className.length())\n    let parts = rest.split(\"-\")\n    if parts.length() >= 2 {\n      let colorName = parts[0]\n      let shade = parts[1]\n      let color = colors[colorName]\n      if color {\n        let hexColor = color[shade]\n        if hexColor {\n          return \".\\(className) { background-color: \\(hexColor); }\"\n        }\n      }\n    }\n  }\n\n  // Text color classes\n  if className.startsWith(\"text-\") && className.contains(\"-\") {\n    let rest = className.substring(5, className.length())\n    let parts = rest.split(\"-\")\n    if parts.length() >= 2 {\n      let colorName = parts[0]\n      let shade = parts[1]\n      let color = colors[colorName]\n      if color {\n        let hexColor = color[shade]\n        if hexColor {\n          return \".\\(className) { color: \\(hexColor); }\"\n        }\n      }\n    }\n  }\n\n  // Border color classes\n  if className.startsWith(\"border-\") {\n    let rest = className.substring(7, className.length())\n    let parts = rest.split(\"-\")\n    if parts.length() >= 2 {\n      let colorName = parts[0]\n      let shade = parts[1]\n      let color = colors[colorName]\n      if color {\n        let hexColor = color[shade]\n        if hexColor {\n          return \".\\(className) { border-color: \\(hexColor); }\"\n        }\n      }\n    }\n  }\n\n  // Border radius classes\n  if className.startsWith(\"rounded-\") {\n    let radiusKey = className.substring(8, className.length())\n    let radius = borderRadius[radiusKey]\n    if radius {\n      return \".\\(className) { border-radius: \\(radius); }\"\n    }\n  }\n\n  // Shadow classes\n  if className.startsWith(\"shadow-\") {\n    let shadowKey = className.substring(7, className.length())\n    let shadow = shadows[shadowKey]\n    if shadow {\n      return \".\\(className) { box-shadow: \\(shadow); }\"\n    }\n  }\n\n  return \"\"\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// JIT CSS Generator\n// HTML에서 추출한 클래스만으로 CSS 생성\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc generateJITCSS(htmlContent: String) -> any {\n  let classes = extractClassesFromHTML(htmlContent)\n  let cssRules = []\n  let categories = {}\n\n  for className in classes {\n    if isValidTailwindClass(className) {\n      let category = classifyClass(className)\n      let rule = generateCSSRule(className)\n\n      if rule != \"\" {\n        cssRules.append(rule)\n\n        if !categories[category] {\n          categories[category] = []\n        }\n        categories[category].append(className)\n      }\n    }\n  }\n\n  let css = \"/* Generated JIT CSS */\\n\"\n  for rule in cssRules {\n    css = css + rule + \"\\n\"\n  }\n\n  return {\n    \"css\": css,\n    \"classes\": classes,\n    \"validClasses\": cssRules.length(),\n    \"categories\": categories\n  }\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Class Statistics\n// 클래스 사용 통계 분석\n// ──────────────────────────────────────────────────────────────────────────\n\nfunc analyzeClassUsage(htmlContent: String) -> any {\n  let classes = extractClassesFromHTML(htmlContent)\n  let statistics = {\n    \"totalClasses\": classes.length(),\n    \"validClasses\": 0,\n    \"invalidClasses\": 0,\n    \"byCategory\": {},\n    \"unused\": []\n  }\n\n  for className in classes {\n    let category = classifyClass(className)\n    if !statistics[\"byCategory\"][category] {\n      statistics[\"byCategory\"][category] = 0\n    }\n    statistics[\"byCategory\"][category] = statistics[\"byCategory\"][category] + 1\n\n    if isValidTailwindClass(className) {\n      statistics[\"validClasses\"] = statistics[\"validClasses\"] + 1\n    } else {\n      statistics[\"invalidClasses\"] = statistics[\"invalidClasses\"] + 1\n    }\n  }\n\n  return statistics\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Export\n// ──────────────────────────────────────────────────────────────────────────\n\nexport {\n  extractClassesFromHTML,\n  classifyClass,\n  isValidTailwindClass,\n  generateCSSRule,\n  generateJITCSS,\n  analyzeClassUsage\n}\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":5118,"cache_read_input_tokens":104059,"output_tokens":4280,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":5118,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"}},"requestId":"req_011CYyMEytnacdasmqgbTS7m","type":"assistant","uuid":"9d00a7a9-c8f6-4dca-a77d-e7fdb3e6cdd3","timestamp":"2026-03-12T14:33:17.351Z","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
