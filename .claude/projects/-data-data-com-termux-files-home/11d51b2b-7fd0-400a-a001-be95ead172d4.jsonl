erify it exists\n      const beforeDelete = db.getBlog(blogId);\n\n      // Soft delete (without transaction for clarity)\n      const deleteResult = db.deleteBlog(blogId, null, false);\n\n      // Verify it's marked as deleted\n      const afterDelete = db.getBlog(blogId);\n\n      if (deleteResult.success && beforeDelete.success && !afterDelete.success) {\n        console.log('✅ Soft delete successful (blog marked as deleted)');\n        passed++;\n      } else {\n        console.log('❌ Soft delete failed');\n        failed++;\n      }\n    }\n  } catch (err) {\n    console.log('❌ Test 5 failed:', err.message);\n    failed++;\n  }","originalFile":"// ============================================================================\n// Integration Tests: Phase 2 SQLite + Phase 5 Circuit Breaker\n// ============================================================================\n\nconst dbModule = require('./freelang/core/database-transactions');\nconst { ServiceRegistry, STATE } = require('./freelang/core/circuit-breaker');\n\n// ──────────────────────────────────────────────────────────────────────────\n// Phase 2: SQLite Database Tests\n// ──────────────────────────────────────────────────────────────────────────\n\nasync function testPhase2SQLite() {\n  console.log('\\n╔═══════════════════════════════════════════════════════╗');\n  console.log('║  🗄️  Phase 2: SQLite Database with Transactions     ║');\n  console.log('╚═══════════════════════════════════════════════════════╝\\n');\n\n  // Initialize database\n  const db = dbModule.connectDatabase();\n  if (!db) {\n    console.error('❌ Database initialization failed');\n    return false;\n  }\n  let passed = 0;\n  let failed = 0;\n\n  // Test 1: Basic INSERT\n  console.log('\\n📝 Test 1: Basic INSERT with Transaction');\n  try {\n    const tx = db.beginTransaction();\n    const result = db.insertBlog({\n      title: 'SQLite Test Blog',\n      content: 'Testing transaction support',\n      author: 'Test User'\n    }, tx.transactionId);\n\n    db.commitTransaction(tx.transactionId);\n\n    if (result.success) {\n      console.log('✅ INSERT + COMMIT successful');\n      passed++;\n    } else {\n      console.log('❌ INSERT failed:', result.error);\n      failed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 1 failed:', err.message);\n    failed++;\n  }\n\n  // Test 2: SELECT with View Increment\n  console.log('\\n📝 Test 2: SELECT with View Increment');\n  try {\n    const blogs = db.getAllBlogs();\n    if (blogs.success && blogs.data.length > 0) {\n      const blog = blogs.data[0];\n      const initialViews = blog.views;\n\n      // Get the blog again to increment views\n      const result = db.getBlog(blog.id);\n      if (result.success && result.data.views > initialViews) {\n        console.log(`✅ View count incremented: ${initialViews} → ${result.data.views}`);\n        passed++;\n      } else {\n        console.log('❌ View increment failed');\n        failed++;\n      }\n    }\n  } catch (err) {\n    console.log('❌ Test 2 failed:', err.message);\n    failed++;\n  }\n\n  // Test 3: Optimistic Locking (Version Conflict)\n  console.log('\\n📝 Test 3: Optimistic Locking - Version Conflict Detection');\n  try {\n    const blogs = db.getAllBlogs();\n    if (blogs.success && blogs.data.length > 0) {\n      const blog = blogs.data[0];\n\n      // Try to update with old version\n      const result = db.updateBlog(blog.id, {\n        version: 0,  // Wrong version\n        title: 'Updated Title'\n      });\n\n      if (!result.success && result.error.includes('Version conflict')) {\n        console.log('✅ Version conflict correctly detected');\n        passed++;\n      } else {\n        console.log('❌ Version conflict detection failed');\n        failed++;\n      }\n    }\n  } catch (err) {\n    console.log('❌ Test 3 failed:', err.message);\n    failed++;\n  }\n\n  // Test 4: UPDATE with Version Increment\n  console.log('\\n📝 Test 4: UPDATE with Version Increment');\n  try {\n    const blogs = db.getAllBlogs();\n    if (blogs.success && blogs.data.length > 0) {\n      const blog = blogs.data[0];\n      const initialVersion = blog.version;\n\n      const result = db.updateBlog(blog.id, {\n        title: 'Updated Blog Title',\n        content: 'Updated content',\n        lastModifiedBy: 'Test User'\n      });\n\n      if (result.success && result.version === initialVersion + 1) {\n        console.log(`✅ Version incremented: ${initialVersion} → ${result.version}`);\n        passed++;\n      } else {\n        console.log('❌ UPDATE failed');\n        failed++;\n      }\n    }\n  } catch (err) {\n    console.log('❌ Test 4 failed:', err.message);\n    failed++;\n  }\n\n  // Test 5: SOFT DELETE (logical deletion)\n  console.log('\\n📝 Test 5: Soft Delete (Logical Deletion)');\n  try {\n    const tx = db.beginTransaction();\n\n    // Create a test blog\n    const insertResult = db.insertBlog({\n      title: 'Blog to Delete',\n      content: 'This will be soft deleted',\n      author: 'Test User'\n    }, tx.transactionId);\n\n    if (insertResult.success) {\n      const blogId = insertResult.id;\n\n      // Soft delete\n      const deleteResult = db.deleteBlog(blogId, tx.transactionId, false);\n\n      // Verify it's marked as deleted\n      const getResult = db.getBlog(blogId);\n\n      db.commitTransaction(tx.transactionId);\n\n      if (deleteResult.success && !getResult.success) {\n        console.log('✅ Soft delete successful (blog marked as deleted)');\n        passed++;\n      } else {\n        console.log('❌ Soft delete failed');\n        failed++;\n      }\n    }\n  } catch (err) {\n    console.log('❌ Test 5 failed:', err.message);\n    failed++;\n  }\n\n  // Test 6: SEARCH with Filters\n  console.log('\\n📝 Test 6: SEARCH with Author Filter');\n  try {\n    const result = db.searchBlogs('', { author: 'Test User' });\n    if (result.success && result.count >= 0) {\n      console.log(`✅ Search found ${result.count} blogs by 'Test User'`);\n      passed++;\n    } else {\n      console.log('❌ Search failed');\n      failed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 6 failed:', err.message);\n    failed++;\n  }\n\n  // Test 7: Batch Insert with Transaction\n  console.log('\\n📝 Test 7: Batch Insert with Transaction');\n  try {\n    const blogs = [\n      { id: 'batch-1', title: 'Batch 1', content: 'Content 1', author: 'Batch User' },\n      { id: 'batch-2', title: 'Batch 2', content: 'Content 2', author: 'Batch User' },\n      { id: 'batch-3', title: 'Batch 3', content: 'Content 3', author: 'Batch User' }\n    ];\n\n    const result = dbModule.batchInsert(blogs);\n    if (result.success && result.count === 3) {\n      console.log(`✅ Batch inserted ${result.count} blogs`);\n      passed++;\n    } else {\n      console.log('❌ Batch insert failed');\n      failed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 7 failed:', err.message);\n    failed++;\n  }\n\n  // Test 8: Transaction Log\n  console.log('\\n📝 Test 8: Transaction Log Review');\n  try {\n    const result = db.getTransactionLog(10);\n    if (result.success && result.data.length > 0) {\n      console.log(`✅ Transaction log contains ${result.data.length} entries`);\n      console.log('   Recent operations:');\n      result.data.slice(0, 3).forEach(log => {\n        console.log(`   - ${log.operation} (${log.status}) at ${log.timestamp}`);\n      });\n      passed++;\n    } else {\n      console.log('❌ Transaction log retrieval failed');\n      failed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 8 failed:', err.message);\n    failed++;\n  }\n\n  dbModule.close();\n\n  console.log('\\n📊 Phase 2 Results:');\n  console.log(`✅ Passed: ${passed}/8`);\n  console.log(`❌ Failed: ${failed}/8`);\n\n  return failed === 0;\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Phase 5: Circuit Breaker Tests\n// ──────────────────────────────────────────────────────────────────────────\n\nasync function testPhase5CircuitBreaker() {\n  console.log('\\n╔═══════════════════════════════════════════════════════╗');\n  console.log('║  🔄 Phase 5: Circuit Breaker & Load Balancing        ║');\n  console.log('╚═══════════════════════════════════════════════════════╝\\n');\n\n  const registry = new ServiceRegistry();\n  let passed = 0;\n  let failed = 0;\n\n  // Test 1: Service Registration\n  console.log('\\n📝 Test 1: Service Registration with Weights');\n  try {\n    registry.registerService('api-gateway', '127.0.0.1', 8000, 2);\n    registry.registerService('auth-service', '127.0.0.1', 8001, 1);\n    registry.registerService('data-service', '127.0.0.1', 8002, 1.5);\n\n    const metrics = registry.getMetrics();\n    if (metrics.serviceCount === 3) {\n      console.log(`✅ Registered ${metrics.serviceCount} services`);\n      console.log(`   - api-gateway (weight: 2)`);\n      console.log(`   - auth-service (weight: 1)`);\n      console.log(`   - data-service (weight: 1.5)`);\n      passed++;\n    } else {\n      console.log('❌ Service registration failed');\n      failed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 1 failed:', err.message);\n    failed++;\n  }\n\n  // Test 2: Initial Health Check\n  console.log('\\n📝 Test 2: Initial Health Check');\n  try {\n    const checks = registry.healthCheckAll();\n    if (checks.length === 3 && checks.every(c => c.healthy)) {\n      console.log(`✅ All ${checks.length} services are healthy`);\n      checks.forEach(c => {\n        console.log(`   - ${c.service}: ${c.breaker.state}`);\n      });\n      passed++;\n    } else {\n      console.log('❌ Health check failed');\n      failed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 2 failed:', err.message);\n    failed++;\n  }\n\n  // Test 3: Service Selection\n  console.log('\\n📝 Test 3: Weighted Service Selection');\n  try {\n    const selection = registry.selectService('api-gateway');\n    if (selection.success) {\n      console.log(`✅ Service selected: ${selection.service.name} (weight: ${selection.service.weight})`);\n      passed++;\n    } else {\n      console.log('❌ Service selection failed');\n      failed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 3 failed:', err.message);\n    failed++;\n  }\n\n  // Test 4: Service Calls (simulate success/failure)\n  console.log('\\n📝 Test 4: Service Calls with Success/Failure');\n  try {\n    let successCount = 0;\n    let failureCount = 0;\n\n    for (let i = 0; i < 20; i++) {\n      const result = await registry.callService('api-gateway', { data: 'test' });\n      if (result.success) {\n        successCount++;\n      } else {\n        failureCount++;\n      }\n    }\n\n    console.log(`✅ Made 20 service calls: ${successCount} success, ${failureCount} failures`);\n    const metrics = registry.getMetrics();\n    console.log(`   Success rate: ${metrics.successRate}`);\n    console.log(`   Avg response time: ${metrics.averageResponseTime}`);\n    passed++;\n  } catch (err) {\n    console.log('❌ Test 4 failed:', err.message);\n    failed++;\n  }\n\n  // Test 5: Circuit Breaker State Transitions\n  console.log('\\n📝 Test 5: Circuit Breaker State Transitions');\n  try {\n    const service = registry.services.get('api-gateway');\n    let stateChanges = [];\n\n    // Override onStateChange to track transitions\n    service.breaker.onStateChange = (transition) => {\n      stateChanges.push(`${transition.from}→${transition.to}`);\n    };\n\n    // Simulate failures to trigger OPEN\n    for (let i = 0; i < 6; i++) {\n      service.breaker.recordFailure();\n    }\n\n    if (service.breaker.state === STATE.OPEN) {\n      console.log('✅ Circuit breaker transitioned to OPEN after failures');\n      console.log(`   State changes: ${stateChanges.join(' → ')}`);\n      passed++;\n    } else {\n      console.log('❌ State transition failed');\n      failed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 5 failed:', err.message);\n    failed++;\n  }\n\n  // Test 6: Half-Open Recovery\n  console.log('\\n📝 Test 6: Half-Open Recovery Attempt');\n  try {\n    const service = registry.services.get('api-gateway');\n\n    // Manually move to HALF_OPEN\n    service.breaker.nextAttemptTime = Date.now() - 1000;\n\n    const callable = service.breaker.isCallable();\n    if (callable && service.breaker.state === STATE.HALF_OPEN) {\n      console.log('✅ Circuit breaker in HALF_OPEN state');\n\n      // Simulate success to recover\n      service.breaker.recordSuccess();\n      service.breaker.recordSuccess();\n\n      if (service.breaker.state === STATE.CLOSED) {\n        console.log('✅ Recovered to CLOSED after successes');\n        passed++;\n      } else {\n        console.log('❌ Recovery failed');\n        failed++;\n      }\n    }\n  } catch (err) {\n    console.log('❌ Test 6 failed:', err.message);\n    failed++;\n  }\n\n  // Test 7: Retry with Exponential Backoff\n  console.log('\\n📝 Test 7: Retry with Exponential Backoff');\n  try {\n    registry.reset();\n    registry.registerService('test-service', '127.0.0.1', 9000, 1);\n\n    const startTime = Date.now();\n    const result = await registry.callServiceWithRetry('test-service', {}, 3);\n    const elapsed = Date.now() - startTime;\n\n    // Should have exponential backoff: ~100ms + ~200ms = ~300ms\n    if (result.attempts && result.attempts <= 3 && elapsed >= 200) {\n      console.log(`✅ Retry completed in ${elapsed}ms with ${result.attempts} attempts`);\n      passed++;\n    } else {\n      console.log('⚠️ Retry test completed (timing may vary)');\n      passed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 7 failed:', err.message);\n    failed++;\n  }\n\n  // Test 8: Metrics and Reporting\n  console.log('\\n📝 Test 8: Metrics and Reporting');\n  try {\n    const metrics = registry.getMetrics();\n\n    console.log('✅ Metrics retrieved:');\n    console.log(`   Total calls: ${metrics.totalCalls}`);\n    console.log(`   Successful: ${metrics.successfulCalls}`);\n    console.log(`   Failed: ${metrics.failedCalls}`);\n    console.log(`   Success rate: ${metrics.successRate}`);\n    console.log(`   Avg response: ${metrics.averageResponseTime}`);\n    console.log(`   Healthy services: ${metrics.healthyServices}/${metrics.serviceCount}`);\n\n    if (metrics.totalCalls > 0) {\n      console.log('   Service status:');\n      Object.entries(metrics.services).forEach(([name, status]) => {\n        console.log(`     - ${name}: ${status.state} (requests: ${status.requestCount})`);\n      });\n      passed++;\n    }\n  } catch (err) {\n    console.log('❌ Test 8 failed:', err.message);\n    failed++;\n  }\n\n  console.log('\\n📊 Phase 5 Results:');\n  console.log(`✅ Passed: ${passed}/8`);\n  console.log(`❌ Failed: ${failed}/8`);\n\n  return failed === 0;\n}\n\n// ──────────────────────────────────────────────────────────────────────────\n// Main Test Runner\n// ──────────────────────────────────────────────────────────────────────────\n\nasync function runAllTests() {\n  console.log('\\n╔════════════════════════════════════════════════════════╗');\n  console.log('║  🧪 Integration Tests: Phase 2 + Phase 5 Improvements ║');\n  console.log('╚════════════════════════════════════════════════════════╝');\n\n  const phase2Result = await testPhase2SQLite();\n  const phase5Result = await testPhase5CircuitBreaker();\n\n  console.log('\\n╔════════════════════════════════════════════════════════╗');\n  console.log('║  📋 Final Summary                                      ║');\n  console.log('╚════════════════════════════════════════════════════════╝\\n');\n\n  console.log('Phase 2 (SQLite): ' + (phase2Result ? '✅ PASS' : '❌ FAIL'));\n  console.log('Phase 5 (Circuit Breaker): ' + (phase5Result ? '✅ PASS' : '❌ FAIL'));\n\n  if (phase2Result && phase5Result) {\n    console.log('\\n🎉 All integration tests passed!');\n  } else {\n    console.log('\\n⚠️ Some tests failed. Review the output above.');\n  }\n}\n\n// Run tests\nrunAllTests().catch(err => {\n  console.error('💥 Test runner error:', err);\n  process.exit(1);\n});\n","structuredPatch":[{"oldStart":126,"oldLines":27,"newStart":126,"newLines":26,"lines":["   // Test 5: SOFT DELETE (logical deletion)","   console.log('\\n📝 Test 5: Soft Delete (Logical Deletion)');","   try {","-    const tx = db.beginTransaction();","-","-    // Create a test blog","+    // Create a test blog first","     const insertResult = db.insertBlog({","       title: 'Blog to Delete',","       content: 'This will be soft deleted',","-      author: 'Test User'","-    }, tx.transactionId);","+      author: 'Delete Test User'","+    });"," ","     if (insertResult.success) {","       const blogId = insertResult.id;"," ","-      // Soft delete","-      const deleteResult = db.deleteBlog(blogId, tx.transactionId, false);","+      // Verify it exists","+      const beforeDelete = db.getBlog(blogId);"," ","+      // Soft delete (without transaction for clarity)","+      const deleteResult = db.deleteBlog(blogId, null, false);","+","       // Verify it's marked as deleted","-      const getResult = db.getBlog(blogId);","+      const afterDelete = db.getBlog(blogId);"," ","-      db.commitTransaction(tx.transactionId);","-","-      if (deleteResult.success && !getResult.success) {","+      if (deleteResult.success && beforeDelete.success && !afterDelete.success) {","         console.log('✅ Soft delete successful (blog marked as deleted)');","         passed++;","       } else {"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"16571262-70a9-4c72-be98-ff81a5929ba7","userType":"external","cwd":"/data/data/com.termux/files/home/freelang-hybrid","sessionId":"11d51b2b-7fd0-400a-a001-be95ead172d4","version":"2.1.74","gitBranch":"master","slug":"purrfect-hatching-lecun"}
