{"parentUuid":"f2de2cfd-96e1-4d12-8c4e-8d91e541f261","isSidechain":false,"message":{"model":"claude-haiku-4-5-20251001","id":"msg_01GCj49Bs2Vnv2hxsvk24K46","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01E8YWgvcpADw2iZNKzhBhJM","name":"Write","input":{"file_path":"/data/data/com.termux/files/home/freelang-hybrid/freelang/core/subscription-manager.js","content":"// ============================================================================\n// Phase 7.4: Real-time Subscription Manager - Multi-protocol Event Coordination\n// ============================================================================\n\nconst EventEmitter = require('events');\n\n// ──────────────────────────────────────────────────────────────────────────\n// Subscription Manager (WebSocket + SSE + GraphQL 통합)\n// ──────────────────────────────────────────────────────────────────────────\n\nclass RealtimeSubscriptionManager extends EventEmitter {\n  constructor(options = {}) {\n    super();\n    this.subscriptions = new Map();      // subscriptionId → subscription\n    this.channels = new Map();           // channelId → Set<subscriptionId>\n    this.eventLog = [];                  // 이벤트 히스토리\n    this.metrics = {\n      totalSubscriptions: 0,\n      activeSubscriptions: 0,\n      totalChannels: 0,\n      totalEvents: 0,\n      protocolDistribution: {\n        websocket: 0,\n        sse: 0,\n        graphql: 0\n      }\n    };\n    this.maxEventLogSize = options.maxEventLogSize || 5000;\n    this.eventTTL = options.eventTTL || 3600000; // 1시간\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Subscription Management\n  // ──────────────────────────────────────────────────────────────────────────\n\n  subscribe(channel, callback, options = {}) {\n    const subscriptionId = this.generateSubscriptionId();\n\n    const subscription = {\n      id: subscriptionId,\n      channel,\n      callback,\n      protocol: options.protocol || 'direct',\n      clientId: options.clientId,\n      metadata: {\n        subscribedAt: Date.now(),\n        messageCount: 0,\n        lastMessageAt: null\n      }\n    };\n\n    // 채널 추가\n    if (!this.channels.has(channel)) {\n      this.channels.set(channel, new Set());\n      this.metrics.totalChannels++;\n    }\n\n    this.channels.get(channel).add(subscriptionId);\n    this.subscriptions.set(subscriptionId, subscription);\n\n    this.metrics.totalSubscriptions++;\n    this.metrics.activeSubscriptions++;\n    this.metrics.protocolDistribution[subscription.protocol]++;\n\n    this.emit('subscription_created', {\n      subscriptionId,\n      channel,\n      protocol: subscription.protocol\n    });\n\n    // 구독 취소 함수 반환\n    return () => this.unsubscribe(subscriptionId);\n  }\n\n  unsubscribe(subscriptionId) {\n    const subscription = this.subscriptions.get(subscriptionId);\n    if (!subscription) return false;\n\n    const channel = subscription.channel;\n    const channelSet = this.channels.get(channel);\n\n    if (channelSet) {\n      channelSet.delete(subscriptionId);\n\n      // 빈 채널 정리\n      if (channelSet.size === 0) {\n        this.channels.delete(channel);\n        this.metrics.totalChannels--;\n        this.emit('channel_closed', { channel });\n      }\n    }\n\n    this.subscriptions.delete(subscriptionId);\n    this.metrics.activeSubscriptions--;\n    this.metrics.protocolDistribution[subscription.protocol]--;\n\n    this.emit('subscription_closed', { subscriptionId, channel });\n    return true;\n  }\n\n  unsubscribeAll(clientId) {\n    const subscriptionIds = Array.from(this.subscriptions.entries())\n      .filter(([_, sub]) => sub.clientId === clientId)\n      .map(([id, _]) => id);\n\n    subscriptionIds.forEach(id => this.unsubscribe(id));\n    return subscriptionIds.length;\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Event Publishing\n  // ──────────────────────────────────────────────────────────────────────────\n\n  publish(channel, event, data) {\n    const timestamp = Date.now();\n    const eventRecord = {\n      id: this.generateEventId(),\n      channel,\n      event,\n      data,\n      timestamp,\n      expiresAt: timestamp + this.eventTTL\n    };\n\n    // 히스토리에 추가\n    this.addToEventLog(eventRecord);\n\n    // 채널의 모든 구독자에게 전송\n    const channelSubscriptions = this.channels.get(channel);\n    if (!channelSubscriptions) {\n      this.metrics.totalEvents++;\n      return 0;\n    }\n\n    let deliveredCount = 0;\n    const eventPayload = {\n      type: event,\n      data,\n      channel,\n      timestamp,\n      eventId: eventRecord.id\n    };\n\n    for (const subscriptionId of channelSubscriptions) {\n      const subscription = this.subscriptions.get(subscriptionId);\n      if (subscription) {\n        try {\n          subscription.callback(eventPayload);\n          subscription.metadata.messageCount++;\n          subscription.metadata.lastMessageAt = timestamp;\n          deliveredCount++;\n        } catch (err) {\n          this.emit('delivery_error', {\n            subscriptionId,\n            channel,\n            error: err.message\n          });\n        }\n      }\n    }\n\n    this.metrics.totalEvents++;\n    return deliveredCount;\n  }\n\n  publishMultiple(channels, event, data) {\n    let totalDelivered = 0;\n    if (Array.isArray(channels)) {\n      channels.forEach(channel => {\n        totalDelivered += this.publish(channel, event, data);\n      });\n    }\n    return totalDelivered;\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Event History & Recovery\n  // ──────────────────────────────────────────────────────────────────────────\n\n  addToEventLog(event) {\n    this.eventLog.push(event);\n\n    // 크기 제한\n    if (this.eventLog.length > this.maxEventLogSize) {\n      this.eventLog.shift();\n    }\n  }\n\n  getEventHistory(channel, limit = 100) {\n    return this.eventLog\n      .filter(e => e.channel === channel && e.expiresAt > Date.now())\n      .slice(-limit);\n  }\n\n  getEventsSince(channel, timestamp) {\n    return this.eventLog.filter(\n      e => e.channel === channel &&\n           e.timestamp > timestamp &&\n           e.expiresAt > Date.now()\n    );\n  }\n\n  getEventById(eventId) {\n    return this.eventLog.find(e => e.id === eventId);\n  }\n\n  purgeExpiredEvents() {\n    const now = Date.now();\n    const before = this.eventLog.length;\n    this.eventLog = this.eventLog.filter(e => e.expiresAt > now);\n    const purged = before - this.eventLog.length;\n    return purged;\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Channel Management\n  // ──────────────────────────────────────────────────────────────────────────\n\n  getChannelInfo(channel) {\n    const subscriptions = this.channels.get(channel);\n    if (!subscriptions) return null;\n\n    const subscribers = Array.from(subscriptions)\n      .map(subId => this.subscriptions.get(subId))\n      .filter(Boolean)\n      .map(sub => ({\n        subscriptionId: sub.id,\n        protocol: sub.protocol,\n        clientId: sub.clientId,\n        messageCount: sub.metadata.messageCount\n      }));\n\n    return {\n      channel,\n      subscribers: subscribers.length,\n      details: subscribers,\n      recentEvents: this.getEventHistory(channel, 5)\n    };\n  }\n\n  getAllChannels() {\n    return Array.from(this.channels.entries()).map(([channel, subscriptions]) => ({\n      channel,\n      subscribers: subscriptions.size,\n      events: this.eventLog.filter(\n        e => e.channel === channel && e.expiresAt > Date.now()\n      ).length\n    }));\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Metrics & Analytics\n  // ──────────────────────────────────────────────────────────────────────────\n\n  getMetrics() {\n    return {\n      timestamp: Date.now(),\n      subscriptions: {\n        total: this.metrics.totalSubscriptions,\n        active: this.metrics.activeSubscriptions,\n        byProtocol: this.metrics.protocolDistribution\n      },\n      channels: {\n        total: this.metrics.totalChannels,\n        list: this.getAllChannels()\n      },\n      events: {\n        total: this.metrics.totalEvents,\n        logged: this.eventLog.filter(e => e.expiresAt > Date.now()).length,\n        maxLogSize: this.maxEventLogSize\n      },\n      subscriptionDetails: Array.from(this.subscriptions.entries()).map(([id, sub]) => ({\n        subscriptionId: id,\n        channel: sub.channel,\n        protocol: sub.protocol,\n        clientId: sub.clientId,\n        messageCount: sub.metadata.messageCount,\n        subscribedFor: Date.now() - sub.metadata.subscribedAt,\n        lastMessage: sub.metadata.lastMessageAt ?\n          Date.now() - sub.metadata.lastMessageAt : null\n      }))\n    };\n  }\n\n  // ──────────────────────────────────────────────────────────────────────────\n  // Multi-protocol Integration\n  // ──────────────────────────────────────────────────────────────────────────\n\n  // WebSocket → Subscription\n  createWebSocketSubscription(clientId, room, wsCallback) {\n    return this.subscribe(room, wsCallback, {\n      protocol: 'websocket',\n      clientId\n    });\n  }\n\n  // SSE → Subscription\n  createSSESubscription(clientId, channel, sseCallback) {\n    return this.subscribe(channel, sseCallback, {\n      protocol: 'sse',\n      clientId\n    });\n  }\n\n  // GraphQL → Subscription\n  createGraphQLSubscription(clientId, channel, graphqlCallback) {\n    return this.subscribe(channel, graphqlCallback, {\n      protocol: 'graphql',\n      clientId\n    });\n  }\n\n  // 프로토콜 변환 (cross-protocol 메시징)\n  broadcastAcrossProtocols(channel, event, data) {\n    const channelSubs = this.channels.get(channel);\n    if (!channelSubs) return;\n\n    const protocols = {};\n    for (const subId of channelSubs) {\n      const sub = this.subscriptions.get(subI