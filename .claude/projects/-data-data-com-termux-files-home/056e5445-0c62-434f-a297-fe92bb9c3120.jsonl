return 0\n}\n\n# ======================== Phase 2: 재컴파일 (자체 호스팅) ========================\necho -e \"\\n🔄 Phase 2: 자체 호스팅 - 재컴파일\"\necho \"==================================================\"\n\n# Phase 1에서 생성된 바이너리로 원본 예제를 다시 컴파일\n# (시뮬레이션: 같은 파일을 다시 컴파일)\n\nrecompile_example() {\n    local name=$1\n    local c_file=\"$BUILD_DIR/${name}_gen1.c\"\n    local bin2=\"$BUILD_DIR/${name}_gen2\"\n\n    if [ ! -f \"$c_file\" ]; then\n        echo \"  ❌ 1단계 C 코드 없음: $c_file\"\n        return 1\n    fi\n\n    echo -e \"\\n✓ [$name] 자체 호스팅: C → 바이너리 (2단계)\"\n    if gcc -o \"$bin2\" \"$c_file\" 2>/dev/null; then\n        echo \"  ✓ 2단계 gcc 컴파일 성공: $bin2\"\n    else\n        echo \"  ❌ 2단계 gcc 컴파일 실패\"\n        return 1\n    fi\n\n    echo -e \"\\n✓ [$name] 자체 호스팅 바이너리 실행\"\n    if [ -x \"$bin2\" ]; then\n        output=$(\"$bin2\" 2>&1 || true)\n        echo \"  출력: $output\"\n        echo \"  ✓ 2단계 실행 성공\"\n    else\n        echo \"  ❌ 2단계 실행 실패\"\n        return 1\n    fi\n\n    return 0\n}\n\n# ======================== Phase 3: 3단계 부트스트랩 ========================\necho -e \"\\n🔄 Phase 3: 3단계 부트스트랩\"\necho \"==================================================\"\n\nbootstrap_level_3() {\n    local name=$1\n    local c_file=\"$BUILD_DIR/${name}_gen1.c\"\n    local bin3=\"$BUILD_DIR/${name}_gen3\"\n\n    echo -e \"\\n✓ [$name] 부트스트랩 3단계: C → 바이너리\"\n    if gcc -o \"$bin3\" \"$c_file\" 2>/dev/null; then\n        echo \"  ✓ 3단계 gcc 컴파일 성공: $bin3\"\n    else\n        echo \"  ❌ 3단계 gcc 컴파일 실패\"\n        return 1\n    fi\n\n    echo -e \"\\n✓ [$name] 3단계 바이너리 실행\"\n    if [ -x \"$bin3\" ]; then\n        output=$(\"$bin3\" 2>&1 || true)\n        echo \"  출력: $output\"\n        echo \"  ✓ 3단계 실행 성공\"\n    else\n        echo \"  ❌ 3단계 실행 실패\"\n        return 1\n    fi\n\n    return 0\n}\n\n# ======================== 테스트 실행 ========================\n\npassed=0\nfailed=0\n\nfor example in example1 example2 example3; do\n    echo -e \"\\n📌 테스트: $example\"\n    echo \"==================================\"\n\n    if compile_example \"$example\"; then\n        echo \"  ✅ Phase 1 통과\"\n        ((passed++))\n    else\n        echo \"  ❌ Phase 1 실패\"\n        ((failed++))\n        continue\n    fi\n\n    if recompile_example \"$example\"; then\n        echo \"  ✅ Phase 2 통과\"\n        ((passed++))\n    else\n        echo \"  ❌ Phase 2 실패\"\n        ((failed++))\n        continue\n    fi\n\n    if bootstrap_level_3 \"$example\"; then\n        echo \"  ✅ Phase 3 통과\"\n        ((passed++))\n    else\n        echo \"  ❌ Phase 3 실패\"\n        ((failed++))\n        continue\n    fi\ndone\n\n# ======================== 최종 결과 ========================\n\necho -e \"\\n\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\"\necho \"📊 부트스트랩 테스트 결과\"\necho \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\" \"=\"\n\necho \"✅ 통과: $passed 단계\"\necho \"❌ 실패: $failed 단계\"\n\nif [ $failed -eq 0 ]; then\n    echo -e \"\\n🚀 자체 호스팅 부트스트랩 완료!\"\n    exit 0\nelse\n    echo -e \"\\n❌ 부트스트랩 실패\"\n    exit 1\nfi\n"},"sourceToolAssistantUUID":"8b19266f-2e96-4f92-91d9-ebf3494f2a46"}
