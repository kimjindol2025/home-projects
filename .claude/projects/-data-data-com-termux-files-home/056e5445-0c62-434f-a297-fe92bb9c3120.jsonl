{"parentUuid":"cb517d99-2c9f-45d1-b056-5f1808aa2398","isSidechain":false,"userType":"external","cwd":"/data/data/com.termux/files/home","sessionId":"056e5445-0c62-434f-a297-fe92bb9c3120","version":"2.1.72","gitBranch":"master","slug":"quizzical-pondering-nova","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Db3WKEideW8t3GQSQ4S1oL","type":"tool_result","content":"File created successfully at: /tmp/js-minlang-project/test.js"}]},"uuid":"ac0d16d7-6721-47d4-9130-44941adf5ac8","timestamp":"2026-03-11T12:08:38.673Z","toolUseResult":{"type":"create","filePath":"/tmp/js-minlang-project/test.js","content":"/**\n * MiniScript 테스트\n */\n\nconst { Tokenizer } = require('./tokenizer');\nconst { Parser } = require('./parser');\nconst { Interpreter } = require('./interpreter');\n\nfunction test(name, code, expectedOutput = null) {\n  console.log(`Testing: ${name}`);\n  try {\n    const tokenizer = new Tokenizer(code);\n    const tokens = tokenizer.tokenize();\n\n    const parser = new Parser(tokens);\n    const ast = parser.parse();\n\n    const interpreter = new Interpreter();\n\n    // 출력 캡처\n    const originalLog = console.log;\n    let output = '';\n    console.log = (...args) => {\n      output += args.join(' ') + '\\n';\n    };\n\n    try {\n      interpreter.interpret(ast);\n      console.log = originalLog;\n\n      if (expectedOutput && output.trim() !== expectedOutput.trim()) {\n        console.log(`  ❌ FAIL: Expected \"${expectedOutput}\", got \"${output}\"`);\n      } else {\n        console.log(`  ✅ PASS`);\n      }\n    } finally {\n      console.log = originalLog;\n    }\n  } catch (error) {\n    console.log(`  ❌ ERROR: ${error.message}`);\n  }\n  console.log('');\n}\n\n// 테스트 실행\nconsole.log('=== MiniScript Test Suite ===\\n');\n\n// 1. 기본 산술\ntest('Basic Arithmetic', `\nlet x = 5;\nlet y = 3;\nprintln(x + y);\n`, '8');\n\ntest('Multiplication', `\nprintln(4 * 5);\n`, '20');\n\ntest('Modulo', `\nprintln(17 % 5);\n`, '2');\n\n// 2. 문자열\ntest('String Concatenation', `\nlet name = \"MiniScript\";\nprintln(\"Hello, \" + name);\n`, 'Hello, MiniScript');\n\n// 3. 조건문\ntest('If Statement', `\nlet x = 10;\nif (x > 5) {\n  println(\"x is greater than 5\");\n}\n`, 'x is greater than 5');\n\ntest('If-Else Statement', `\nlet x = 3;\nif (x > 5) {\n  println(\"big\");\n} else {\n  println(\"small\");\n}\n`, 'small');\n\n// 4. 루프\ntest('For Loop', `\nfor (let i = 0; i < 3; i = i + 1) {\n  println(i);\n}\n`, '0\\n1\\n2');\n\ntest('While Loop', `\nlet i = 0;\nwhile (i < 3) {\n  println(i);\n  i = i + 1;\n}\n`, '0\\n1\\n2');\n\n// 5. 함수\ntest('Function Declaration', `\nfn add(a, b) {\n  return a + b;\n}\nprintln(add(3, 4));\n`, '7');\n\ntest('Recursive Function', `\nfn factorial(n) {\n  if (n <= 1) {\n    return 1;\n  }\n  return n * factorial(n - 1);\n}\nprintln(factorial(5));\n`, '120');\n\n// 6. 배열\ntest('Array Creation', `\nlet arr = [1, 2, 3];\nprintln(arr[0]);\nprintln(arr[1]);\nprintln(arr[2]);\n`, '1\\n2\\n3');\n\ntest('Array Length', `\nlet arr = [10, 20, 30];\nprintln(length(arr));\n`, '3');\n\n// 7. 내장 함수\ntest('Built-in Functions', `\nprintln(length(\"hello\"));\nprintln(type(42));\nprintln(type(\"text\"));\nprintln(type(true));\n`, '5\\nnumber\\nstring\\nboolean');\n\n// 8. 논리 연산\ntest('Logical AND', `\nif (true && true) {\n  println(\"yes\");\n}\n`, 'yes');\n\ntest('Logical OR', `\nif (false || true) {\n  println(\"yes\");\n}\n`, 'yes');\n\ntest('NOT Operator', `\nif (!false) {\n  println(\"yes\");\n}\n`, 'yes');\n\n// 9. 변수 할당\ntest('Variable Assignment', `\nlet x = 10;\nx = 20;\nprintln(x);\n`, '20');\n\n// 10. 복잡한 예제\ntest('Fibonacci', `\nfn fib(n) {\n  if (n <= 1) {\n    return n;\n  }\n  return fib(n - 1) + fib(n - 2);\n}\nprintln(fib(6));\n`, '8');\n\n// 결과 요약\nconsole.log('=== Test Complete ===');\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"cb517d99-2c9f-45d1-b056-5f1808aa2398"}
