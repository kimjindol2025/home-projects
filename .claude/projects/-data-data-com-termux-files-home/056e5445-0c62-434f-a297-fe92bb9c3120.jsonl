  color: white;\n  transform: translateY(-2px);\n  box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);\n}\n\n/* 기능 소개 */\n.features {\n  background: white;\n  border-radius: 12px;\n  padding: 40px;\n  margin-bottom: 30px;\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);\n  animation: fadeIn 1s ease-out;\n}\n\n.features h2 {\n  font-size: 2em;\n  margin-bottom: 30px;\n  color: #667eea;\n  text-align: center;\n}\n\n.features-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n  gap: 30px;\n}\n\n.feature {\n  padding: 25px;\n  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);\n  border-radius: 10px;\n  text-align: center;\n  transition: transform 0.3s ease;\n}\n\n.feature:hover {\n  transform: translateY(-5px);\n}\n\n.feature h3 {\n  margin-bottom: 15px;\n  color: #667eea;\n  font-size: 1.2em;\n}\n\n.feature code {\n  background: white;\n  padding: 10px;\n  border-radius: 6px;\n  display: block;\n  font-size: 0.85em;\n  line-height: 1.5;\n  text-align: left;\n  border: 1px solid #e0e0e0;\n}\n\n/* 문법 가이드 */\n.syntax-guide {\n  background: white;\n  border-radius: 12px;\n  padding: 40px;\n  margin-bottom: 30px;\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);\n  animation: fadeIn 1.2s ease-out;\n}\n\n.syntax-guide h2 {\n  font-size: 2em;\n  margin-bottom: 30px;\n  color: #667eea;\n  text-align: center;\n}\n\n.guide-content {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n  gap: 25px;\n}\n\n.guide-item {\n  padding: 20px;\n  background: #f8f9fa;\n  border-left: 4px solid #667eea;\n  border-radius: 8px;\n}\n\n.guide-item h4 {\n  margin-bottom: 12px;\n  color: #667eea;\n  font-size: 1.1em;\n}\n\n.guide-item code {\n  background: white;\n  padding: 10px;\n  border-radius: 4px;\n  display: block;\n  font-size: 0.85em;\n  line-height: 1.6;\n  overflow-x: auto;\n  border: 1px solid #e0e0e0;\n}\n\n/* 푸터 */\n.footer {\n  text-align: center;\n  color: white;\n  padding: 20px;\n  border-top: 1px solid rgba(255, 255, 255, 0.2);\n}\n\n/* 로딩 오버레이 */\n.loading-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.5);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.spinner {\n  width: 50px;\n  height: 50px;\n  border: 4px solid rgba(255, 255, 255, 0.3);\n  border-top-color: white;\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n}\n\n/* 애니메이션 */\n@keyframes slideDown {\n  from {\n    opacity: 0;\n    transform: translateY(-20px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@keyframes fadeIn {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n\n@keyframes spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n/* 반응형 디자인 */\n@media (max-width: 1024px) {\n  .main {\n    grid-template-columns: 1fr;\n  }\n\n  .features-grid,\n  .guide-content {\n    grid-template-columns: 1fr;\n  }\n\n  .section-header {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n\n  .button-group {\n    width: 100%;\n  }\n\n  .btn {\n    flex: 1;\n  }\n}\n\n@media (max-width: 768px) {\n  .header h1 {\n    font-size: 2em;\n  }\n\n  .features,\n  .syntax-guide {\n    padding: 20px;\n  }\n\n  .examples {\n    grid-template-columns: 1fr;\n  }\n\n  .container {\n    padding: 10px;\n  }\n}\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"ec85cba3-2248-4a5d-830e-f34ec01ecb24"}
