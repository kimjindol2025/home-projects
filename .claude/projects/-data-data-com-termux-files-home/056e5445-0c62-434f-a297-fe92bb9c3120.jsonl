n().line;\n    const column = this.currentToken().column;\n    this.expect(TokenType.IF);\n    this.expect(TokenType.LPAREN);\n    const condition = this.parseExpression();\n    this.expect(TokenType.RPAREN);\n\n    this.expect(TokenType.LBRACE);\n    const thenBranch = this.parseBlockBody();\n    this.expect(TokenType.RBRACE);\n\n    let elseBranch = null;\n    if (this.match(TokenType.ELSE)) {\n      this.expect(TokenType.ELSE);\n      this.expect(TokenType.LBRACE);\n      elseBranch = this.parseBlockBody();\n      this.expect(TokenType.RBRACE);\n    }\n\n    return new IfStatement(condition, thenBranch, elseBranch, line, column);\n  }\n\n  parseWhileStatement() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    this.expect(TokenType.WHILE);\n    this.expect(TokenType.LPAREN);\n    const condition = this.parseExpression();\n    this.expect(TokenType.RPAREN);\n\n    this.expect(TokenType.LBRACE);\n    const body = this.parseBlockBody();\n    this.expect(TokenType.RBRACE);\n\n    return new WhileStatement(condition, body, line, column);\n  }\n\n  parseForStatement() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    this.expect(TokenType.FOR);\n    this.expect(TokenType.LPAREN);\n\n    // 초기화\n    let init = null;\n    if (!this.match(TokenType.SEMICOLON)) {\n      init = this.parseExpression();\n    }\n    this.expect(TokenType.SEMICOLON);\n\n    // 조건\n    let condition = null;\n    if (!this.match(TokenType.SEMICOLON)) {\n      condition = this.parseExpression();\n    }\n    this.expect(TokenType.SEMICOLON);\n\n    // 업데이트\n    let update = null;\n    if (!this.match(TokenType.RPAREN)) {\n      update = this.parseExpression();\n    }\n    this.expect(TokenType.RPAREN);\n\n    this.expect(TokenType.LBRACE);\n    const body = this.parseBlockBody();\n    this.expect(TokenType.RBRACE);\n\n    return new ForStatement(init, condition, update, body, line, column);\n  }\n\n  p