.\"\n            }\n          ]\n        }\n      ]\n    },\n    \"number\": {\n      \"patterns\": [\n        {\n          \"name\": \"constant.numeric.float.fl\",\n          \"match\": \"\\\\b\\\\d+\\\\.\\\\d+\\\\b\"\n        },\n        {\n          \"name\": \"constant.numeric.integer.fl\",\n          \"match\": \"\\\\b\\\\d+\\\\b\"\n        }\n      ]\n    },\n    \"keyword\": {\n      \"patterns\": [\n        {\n          \"name\": \"keyword.control.fl\",\n          \"match\": \"\\\\b(함수|변수|상수|만약|아니면|아니면만약|반복|동안|반환|끝|없음|참|거짓|구조체|배열|모듈|임포트|익스포트)\\\\b\"\n        }\n      ]\n    },\n    \"boolean\": {\n      \"patterns\": [\n        {\n          \"name\": \"constant.language.boolean.true.fl\",\n          \"match\": \"\\\\b참\\\\b\"\n        },\n        {\n          \"name\": \"constant.language.boolean.false.fl\",\n          \"match\": \"\\\\b거짓\\\\b\"\n        }\n      ]\n    },\n    \"identifier\": {\n      \"patterns\": [\n        {\n          \"name\": \"variable.other.fl\",\n          \"match\": \"[가-힣_][가-힣0-9_]*\"\n        },\n        {\n          \"name\": \"variable.other.english.fl\",\n          \"match\": \"[a-zA-Z_][a-zA-Z0-9_]*\"\n        }\n      ]\n    },\n    \"operator\": {\n      \"patterns\": [\n        {\n          \"name\": \"keyword.operator.arithmetic.fl\",\n          \"match\": \"[+\\\\-*/%]\"\n        },\n        {\n          \"name\": \"keyword.operator.comparison.fl\",\n          \"match\": \"(==|!=|<=|>=|<|>)\"\n        },\n        {\n          \"name\": \"keyword.operator.logical.fl\",\n          \"match\": \"\\\\b(그리고|또는|아니)\\\\b\"\n        },\n        {\n          \"name\": \"keyword.operator.assignment.fl\",\n          \"match\": \"=\"\n        },\n        {\n          \"name\": \"punctuation.separator.fl\",\n          \"match\": \"[,;]\"\n        }\n      ]\n    },\n    \"builtin\": {\n      \"patterns\": [\n        {\n          \"name\": \"support.function.builtin.fl\",\n          \"match\": \"\\\\b(길이|포함|시작|끝|찾기|대문자|소문자|연결|자르기|바꾸기|반복|채우기|나누기_앞|나누기_뒷|절대값|제곱|제곱근|올림|내림|반올림|최대값|최소값|거듭제곱|배열길이|배열합계|배열평균|배열최대|배열최소|배열포함|정수인가|실수인가|논리값인가|문자열인가|파일열기|파일닫기|줄읽기|줄쓰기|파일존재|파일삭제|파일크기|파일전체읽기|인쇄|입력)\\\\b\"\n        }\n      ]\n    }\n  }\n}\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"a8419ab7-0214-4f1c-8d14-d10acf91ce70"}
