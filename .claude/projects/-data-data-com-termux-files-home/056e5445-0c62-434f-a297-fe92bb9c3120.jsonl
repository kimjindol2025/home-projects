{"parentUuid":"223b2775-3a14-49b1-9fad-f642ec13f1a1","isSidechain":false,"userType":"external","cwd":"/data/data/com.termux/files/home","sessionId":"056e5445-0c62-434f-a297-fe92bb9c3120","version":"2.1.72","gitBranch":"master","slug":"quizzical-pondering-nova","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RLy3TUDbgVYb6UTxkb8nzD","type":"tool_result","content":"File created successfully at: /tmp/js-minlang-project/interpreter.js"}]},"uuid":"b7f3f4df-d679-4eca-9cd4-90ae62aafb12","timestamp":"2026-03-11T12:08:14.515Z","toolUseResult":{"type":"create","filePath":"/tmp/js-minlang-project/interpreter.js","content":"/**\n * MiniScript Interpreter\n * AST를 실행\n */\n\nclass ReturnValue extends Error {\n  constructor(value) {\n    super();\n    this.value = value;\n  }\n}\n\nclass BreakException extends Error {}\nclass ContinueException extends Error {}\n\nclass Environment {\n  constructor(parent = null) {\n    this.parent = parent;\n    this.variables = {};\n  }\n\n  define(name, value) {\n    this.variables[name] = value;\n  }\n\n  get(name) {\n    if (name in this.variables) {\n      return this.variables[name];\n    }\n    if (this.parent) {\n      return this.parent.get(name);\n    }\n    throw new Error(`Undefined variable: ${name}`);\n  }\n\n  set(name, value) {\n    if (name in this.variables) {\n      this.variables[name] = value;\n      return;\n    }\n    if (this.parent) {\n      this.parent.set(name, value);\n      return;\n    }\n    throw new Error(`Undefined variable: ${name}`);\n  }\n\n  has(name) {\n    if (name in this.variables) {\n      return true;\n    }\n    if (this.parent) {\n      return this.parent.has(name);\n    }\n    return false;\n  }\n}\n\nclass MiniScriptFunction {\n  constructor(name, params, body, closure) {\n    this.name = name;\n    this.params = params;\n    this.body = body;\n    this.closure = closure;\n  }\n}\n\nclass Interpreter {\n  constructor() {\n    this.globalEnv = new Environment();\n    this.currentEnv = this.globalEnv;\n    this.setupBuiltins();\n  }\n\n  setupBuiltins() {\n    // print 함수\n    this.globalEnv.define('print', (...args) => {\n      console.log(...args);\n      return null;\n    });\n\n    // println 함수\n    this.globalEnv.define('println', (...args) => {\n      console.log(...args);\n      return null;\n    });\n\n    // length 함수\n    this.globalEnv.define('length', (value) => {\n      if (typeof value === 'string') return value.length;\n      if (Array.isArray(value)) return value.length;\n      if (value === null) return 0;\n      return 0;\n    });\n\n    // type 함수\n    this.globalEnv.define('type', (value) => {\n      if (value === null) return 'null';\n      if (Array.isArray(value)) return 'array';\n      if (value instanceof MiniScriptFunction) return 'function';\n      return typeof value;\n    });\n\n    // parseInt 함수\n    this.globalEnv.define('parseInt', (value) => {\n      return parseInt(value);\n    });\n\n    // parseFloat 함수\n    this.globalEnv.define('parseFloat', (value) => {\n      return parseFloat(value);\n    });\n\n    // toString 함수\n    this.globalEnv.define('toString', (value) => {\n      if (value === null) return 'null';\n      if (value === true) return 'true';\n      if (value === false) return 'false';\n      return String(value);\n    });\n\n    // push 함수\n    this.globalEnv.define('push', (array, value) => {\n      if (!Array.isArray(array)) {\n        throw new Error('push: first argument must be an array');\n      }\n      array.push(value);\n      return array;\n    });\n\n    // pop 함수\n    this.globalEnv.define('pop', (array) => {\n      if (!Array.isArray(array)) {\n        throw new Error('pop: argument must be an array');\n      }\n      return array.pop();\n    });\n\n    // join 함수\n    this.globalEnv.define('join', (array, separator = ',') => {\n      if (!Array.isArray(array)) {\n        throw new Error('join: first argument must be an array');\n      }\n      return array.join(separator);\n    });\n\n    // range 함수\n    this.globalEnv.define('range', (start, end, step = 1) => {\n      const result = [];\n      if (step > 0) {\n        for (let i = start; i < end; i += step) {\n          result.push(i);\n        }\n      } else if (step < 0) {\n        for (let i = start; i > end; i += step) {\n          result.push(i);\n        }\n      }\n      return result;\n    });\n  }\n\n  interpret(ast) {\n    try {\n      this.execute(ast);\n    } catch (error) {\n      if (error instanceof ReturnValue) {\n        return error.value;\n      }\n      throw error;\n    }\n  }\n\n  execute(node) {\n    if (!node) return null;\n\n    switch (node.type) {\n      case 'Program':\n        return this.executeProgram(node);\n      case 'LetDeclaration':\n        return this.executeLetDeclaration(node);\n      case 'ConstDeclaration':\n        return this.executeConstDeclaration(node);\n      case 'FunctionDeclaration':\n        return this.executeFunctionDeclaration(node);\n      case 'IfStatement':\n        return this.executeIfStatement(node);\n      case 'WhileStatement':\n        return this.executeWhileStatement(node);\n      case 'ForStatement':\n        return this.executeForStatement(node);\n      case 'ReturnStatement':\n        return this.executeReturnStatement(node);\n      case 'BlockStatement':\n        return this.executeBlockStatement(node);\n      case 'ExpressionStatement':\n        return this.execute(node.expression);\n      default:\n        return this.evaluate(node);\n    }\n  }\n\n  executeProgram(node) {\n    let result = null;\n    for (const statement of node.statements) {\n      result = this.execute(statement);\n    }\n    return result;\n  }\n\n  executeLetDeclaration(node) {\n    const value = node.value ? this.evaluate(node.value) : null;\n    this.currentEnv.define(node.name, value);\n    return null;\n  }\n\n  executeConstDeclaration(node) {\n    const value = this.evaluate(node.value);\n    this.currentEnv.define(node.name, value);\n    return null;\n  }\n\n  executeFunctionDeclaration(node) {\n    const func = new MiniScriptFunction(node.name, node.params, node.body, this.currentEnv);\n    this.currentEnv.define(node.name, func);\n    return null;\n  }\n\n  executeIfStatement(node) {\n    const condition = this.evaluate(node.condition);\n    if (this.isTruthy(condition)) {\n      return this.executeBlock(node.thenBranch);\n    } else if (node.elseBranch) {\n      return this.executeBlock(node.elseBranch);\n    }\n    return null;\n  }\n\n  executeWhileStatement(node) {\n    let result = null;\n    while (this.isTruthy(this.evaluate(node.condition))) {\n      try {\n        result = this.executeBlock(node.body);\n      } catch (error) {\n        if (error instanceof BreakException) {\n          break;\n        } else if (error instanceof ContinueException) {\n          continue;\n        } else {\n          throw error;\n        }\n      }\n    }\n    return result;\n  }\n\n  executeForStatement(node) {\n    const loopEnv = new Environment(this.currentEnv);\n    const prevEnv = this.currentEnv;\n    this.currentEnv = loopEnv;\n\n    try {\n      if (node.init) {\n        this.execute(node.init);\n      }\n\n      let result = null;\n      while (!node.condition || this.isTruthy(this.evaluate(node.condition))) {\n        try {\n          result = this.executeBlock(node.body);\n        } catch (error) {\n          if (error instanceof BreakException) {\n            break;\n          } else if (error instanceof ContinueException) {\n            // continue\n          } else {\n            throw error;\n          }\n        }\n\n        if (node.update) {\n          this.evaluate(node.update);\n        }\n      }\n\n      return result;\n    } finally {\n      this.currentEnv = prevEnv;\n    }\n  }\n\n  executeReturnStatement(node) {\n    const value = node.value ? this.evaluate(node.value) : null;\n    throw new ReturnValue(value);\n  }\n\n  executeBlockStatement(node) {\n    return this.executeBlockInNewEnv(node.statements);\n  }\n\n  executeBlock(statements) {\n    let result = null;\n    for (const statement of statements) {\n      result = this.execute(statement);\n    }\n    return result;\n  }\n\n  executeBlockInNewEnv(statements) {\n    const blockEnv = new Environment(this.currentEnv);\n    const prevEnv = this.currentEnv;\n    this.currentEnv = blockEnv;\n\n    try {\n      return this.executeBlock(statements);\n    } finally {\n      this.currentEnv = prevEnv;\n    }\n  }\n\n  evaluate(node) {\n    if (!node) return null;\n\n    switch (node.type) {\n      case 'NumberLiteral':\n        return node.value;\n      case 'StringLiteral':\n        return node.value;\n      case 'BooleanLiteral':\n        return node.value;\n      case 'NullLiteral':\n        return null;\n      case 'Identifier':\n        return this.currentEnv.get(node.name);\n      case 'BinaryOp':\n        return this.evaluateBinaryOp(node);\n      case 'UnaryOp':\n        return this.evaluateUnaryOp(node);\n      case 'Assignment':\n        return this.evaluateAssignment(node);\n      case 'FunctionCall':\n        return this.evaluateFunctionCall(node);\n      case 'ArrayLiteral':\n        return node.elements.map(elem => this.evaluate(elem));\n      case 'IndexAccess':\n        return this.evaluateIndexAccess(node);\n      case 'MemberAccess':\n        return this.evaluateMemberAccess(node);\n      default:\n        throw new Error(`Unknown expression type: ${node.type}`);\n    }\n  }\n\n  evaluateBinaryOp(node) {\n    const left = this.evaluate(node.left);\n    const right = this.evaluate(node.right);\n\n    switch (node.operator) {\n      case '+':\n        if (typeof left === 'string' || typeof right === 'string') {\n          return String(left) + String(right);\n        }\n        return left + right;\n      case '-': return left - right;\n      case '*': return left * right;\n      case '/': return left / right;\n      case '%': return left % right;\n      case '==': return left === right;\n      case '!=': return left !== right;\n      case '<': return left < right;\n      case '<=': return left <= right;\n      case '>': return left > right;\n      case '>=': return left >= right;\n      case '&&': return left && right;\n      case '||': return left || right;\n      default:\n        throw new Error(`Unknown operator: ${node.operator}`);\n    }\n  }\n\n  evaluateUnaryOp(node) {\n    const operand = this.evaluate(node.operand);\n\n    switch (node.operator) {\n      case '!': return !this.isTruthy(operand);\n      case '-': return -operand;\n      default:\n        throw new Error(`Unknown unary operator: ${node.operator}`);\n    }\n  }\n\n  evaluateAssignment(node) {\n    const value = this.evaluate(node.value);\n\n    if (node.target.type === 'Identifier') {\n      if (!this.currentEnv.has(node.target.name)) {\n        throw new Error(`Undefined variable: ${node.target.name}`);\n      }\n      this.currentEnv.set(node.target.name, value);\n    } else if (node.target.type === 'IndexAccess') {\n      const array = this.evaluate(node.target.array);\n      const index = this.evaluate(node.target.index);\n      if (Array.isArray(array)) {\n        array[index] = value;\n      } else {\n        throw new Error('Cannot index non-array');\n      }\n    } else {\n      throw new Error('Invalid assignment target');\n    }\n\n    return value;\n  }\n\n  evaluateFunctionCall(node) {\n    const func = this.currentEnv.get(node.name);\n    const args = node.args.map(arg => this.evaluate(arg));\n\n    if (typeof func === 'function') {\n      // 내장 함수\n      return func(...args);\n    } else if (func instanceof MiniScriptFunction) {\n      // 사용자 정의 함수\n      return this.callUserFunction(func, args);\n    } else {\n      throw new Error(`${node.name} is not a function`);\n    }\n  }\n\n  callUserFunction(func, args) {\n    const funcEnv = new Environment(func.closure);\n\n    // 파라미터 바인딩\n    for (let i = 0; i < func.params.length; i++) {\n      funcEnv.define(func.params[i], args[i] || null);\n    }\n\n    const prevEnv = this.currentEnv;\n    this.currentEnv = funcEnv;\n\n    try {\n      this.executeBlock(func.body);\n      return null; // 명시적 return이 없으면 null 반환\n    } catch (error) {\n      if (error instanceof ReturnValue) {\n        return error.value;\n      }\n      throw error;\n    } finally {\n      this.currentEnv = prevEnv;\n    }\n  }\n\n  evaluateIndexAccess(node) {\n    const array = this.evaluate(node.array);\n    const index = this.evaluate(node.index);\n\n    if (Array.isArray(array)) {\n      return array[index];\n    } else if (typeof array === 'string') {\n      return array[index];\n    } else {\n      throw new Error('Cannot index non-indexable value');\n    }\n  }\n\n  evaluateMemberAccess(node) {\n    const object = this.evaluate(node.object);\n\n    if (object === null || object === undefined) {\n      throw new Error('Cannot access member of null or undefined');\n    }\n\n    return object[node.member];\n  }\n\n  isTruthy(value) {\n    if (value === null || value === false) return false;\n    if (value === 0 || value === '') return false;\n    if (value === undefined) return false;\n    return true;\n  }\n}\n\nmodule.exports = { Interpreter };\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"223b2775-3a14-49b1-9fad-f642ec13f1a1"}
