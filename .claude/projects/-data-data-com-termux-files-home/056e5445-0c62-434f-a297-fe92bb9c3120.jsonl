tokens) == 2 && tokens[1].type == FLOAT && tokens[1].value == \"3.14\")\n\n    tokens = tokenize(\"1.0 2.5\")\n    test_case(\"Multiple floats\",\n        tokens[1].type == FLOAT && tokens[1].value == \"1.0\" &&\n        tokens[2].type == FLOAT && tokens[2].value == \"2.5\"\n    )\n\n    tokens = tokenize(\"1.5e-3\")\n    test_case(\"Scientific notation\", tokens[1].type == FLOAT && tokens[1].value == \"1.5e-3\")\n\n    tokens = tokenize(\"2.0E+10\")\n    test_case(\"Scientific with E+\", tokens[1].type == FLOAT && tokens[1].value == \"2.0E+10\")\nend\n\n# ======================== 테스트 3: 키워드 ========================\n\nfunction test_keywords()\n    println(\"\\n--- Test 3: Keywords ---\")\n    tokens = tokenize(\"function\")\n    test_case(\"function keyword\", tokens[1].type == KW_FUNCTION)\n\n    tokens = tokenize(\"if else end\")\n    test_case(\"if/else/end keywords\",\n        tokens[1].type == KW_IF &&\n        tokens[2].type == KW_ELSE &&\n        tokens[3].type == KW_END\n    )\n\n    tokens = tokenize(\"for while return\")\n    test_case(\"loop keywords\",\n        tokens[1].type == KW_FOR &&\n        tokens[2].type == KW_WHILE &&\n        tokens[3].type == KW_RETURN\n    )\n\n    tokens = tokenize(\"true false nothing\")\n    test_case(\"boolean keywords\",\n        tokens[1].type == KW_TRUE &&\n        tokens[2].type == KW_FALSE &&\n        tokens[3].type == KW_NOTHING\n    )\nend\n\n# ======================== 테스트 4: 식별자 ========================\n\nfunction test_identifiers()\n    println(\"\\n--- Test 4: Identifiers ---\")\n    tokens = tokenize(\"x\")\n    test_case(\"Single character identifier\", tokens[1].type == IDENTIFIER && tokens[1].value == \"x\")\n\n    tokens = tokenize(\"my_var\")\n    test_case(\"Identifier with underscore\", tokens[1].type == IDENTIFIER && tokens[1].value == \"my_var\")\n\n    tokens = tokenize(\"func?\")\n    test_case(\"Identifier with question mark\", tokens[1].type == IDENTIFIER && tokens[1].value == \"func?\")\n\n    tokens = tokenize(\"func!\")\n    test_case(\"Identifier with exclamation\", tokens[1].type == IDENTIFIER && tokens[1].value == \"func!\")\nend\n\n# ======================== 테스트 5: 문자열 ========================\n\nfunction test_strings()\n    println(\"\\n--- Test 5: Strings ---\")\n    tokens = tokenize(\"\\\"hello\\\"\")\n    test_case(\"Simple string\", tokens[1].type == STRING && tokens[1].value == \"hello\")\n\n    tokens = tokenize(\"'world'\")\n    test_case(\"Single quote string\", tokens[1].type == STRING && tokens[1].value == \"world\")\n\n    tokens = tokenize(\"\\\"hello world\\\"\")\n    test_case(\"String with space\", tokens[1].type == STRING && tokens[1].value == \"hello world\")\n\n    # 이스케이프 시퀀스는 복잡하므로 생략\nend\n\n# ======================== 테스트 6: 심볼 ========================\n\nfunction test_symbols()\n    println(\"\\n--- Test 6: Symbols ---\")\n    tokens = tokenize(\":symbol\")\n    test_case(\"Simple symbol\", tokens[1].type == SYMBOL && tokens[1].value == \"symbol\")\n\n    tokens = tokenize(\":my_sym\")\n    test_case(\"Symbol with underscore\", tokens[1].type == SYMBOL && tokens[1].value == \"my_sym\")\nend\n\n# ======================== 테스트 7: 연산자 ========================\n\nfunction test_operators()\n    println(\"\\n--- Test 7: Operators ---\")\n    tokens = tokenize(\"+ - * / %\")\n    test_case(\"Arithmetic operators\",\n        tokens[1].type == PLUS &&\n        tokens[2].type == MINUS &&\n        tokens[3].type == STAR &&\n        tokens[4].type == SLASH &&\n        tokens[5].type == PERCENT\n    )\n\n    tokens = tokenize(\"== != < <= > >=\")\n    test_case(\"Comparison operators\",\n        tokens[1].type == EQ_EQ &&\n        tokens[2].type == NOT_EQ &&\n        tokens[3].type == LT &&\n        tokens[4].type == LE &&\n        tokens[5].type == GT &&\n        tokens[6].type == GE\n    )\n\n    tokens = tokenize(\"&& ||\")\n    test_case(\"Logical operators\",\n        tokens[1].type == AND_AND &&\n        tokens[2].type == OR_OR\n    )\n\n    tokens = tokenize(\"& | ~ << >>\")\n    test_case(\"Bitwise operators\",\n        tokens[1].type == AND &&\n        tokens[2].type == OR &&\n        tokens[3].type == TILDE &&\n        tokens[4].type == LSHIFT &&\n        tokens[5].type == RSHIFT\n    )\nend\n\n# ======================== 테스트 8: 할당 연산자 ========================\n\nfunction test_assignment_operators()\n    println(\"\\n--- Test 8: Assignment Operators ---\")\n    tokens = tokenize(\"= += -= *= /=\")\n    test_case(\"Assignment operators\",\n        tokens[1].type == EQ &&\n        tokens[2].type == PLUS_EQ &&\n        tokens[3].type == MINUS_EQ &&\n        tokens[4].type == STAR_EQ &&\n        tokens[5].type == SLASH_EQ\n    )\nend\n\n# ======================== 테스트 9: 구분자 ========================\n\nfunction test_delimiters()\n    println(\"\\n--- Test 9: Delimiters ---\")\n    tokens = tokenize(\"( ) [ ] { }\")\n    test_case(\"Brackets\",\n        tokens[1].type == LPAREN &&\n        tokens[2].type == RPAREN &&\n        tokens[3].type == LBRACKET &&\n        tokens[4].type == RBRACKET &&\n        tokens[5].type == LBRACE &&\n        tokens[6].type == RBRACE\n    )\n\n    tokens = tokenize(\", ; : ::\")\n    test_case(\"Punctuation\",\n        tokens[1].type == COMMA &&\n        tokens[2].type == SEMICOLON &&\n        tokens[3].type == COLON &&\n        tokens[4].type == DOUBLE_COLON\n    )\n\n    tokens = tokenize(\"-> =>\")\n    test_case(\"Arrow operators\",\n        tokens[1].type == ARROW &&\n        tokens[2].type == DOUBLE_ARROW\n    )\nend\n\n# ======================== 테스트 10: 복잡한 표현식 ========================\n\nfunction test_complex_expression()\n    println(\"\\n--- Test 10: Complex Expression ---\")\n\n    code = \"\"\"\n    x = 10\n    y = 3.14\n    \"\"\"\n    tokens = tokenize(code)\n\n    # x = 10 + NEWLINE + y = 3.14 + NEWLINE + EOF\n    test_case(\"Assignment expression\",\n        tokens[1].type == IDENTIFIER && tokens[1].value == \"x\" &&\n        tokens[2].type == EQ &&\n        tokens[3].type == INTEGER && tokens[3].value == \"10\" &&\n        tokens[4].type == NEWLINE\n    )\nend\n\n# ======================== 테스트 11: 함수 선언 ========================\n\nfunction test_function_declaration()\n    println(\"\\n--- Test 11: Function Declaration ---\")\n\n    code = \"function add(x, y)\\n    return x + y\\nend\"\n    tokens = tokenize(code)\n\n    test_case(\"Function keyword detected\", tokens[1].type == KW_FUNCTION)\n    test_case(\"Parameter parsing\",\n        any(t.type == IDENTIFIER && t.value == \"x\" for t in tokens) &&\n        any(t.type == IDENTIFIER && t.value == \"y\" for t in tokens)\n    )\n    test_case(\"Return keyword detected\", any(t.type == KW_RETURN for t in tokens))\n    test_case(\"End keyword detected\", any(t.type == KW_END for t in tokens))\nend\n\n# ======================== 테스트 12: 덧셈 ========================\n\nfunction test_simple_addition()\n    println(\"\\n--- Test 12: Simple Addition ---\")\n\n    code = \"3 + 4\"\n    tokens = tokenize(code)\n\n    test_case(\"Addition expression tokens\",\n        length(tokens) >= 4 &&\n        tokens[1].type == INTEGER && tokens[1].value == \"3\" &&\n        tokens[2].type == PLUS &&\n        tokens[3].type == INTEGER && tokens[3].value == \"4\"\n    )\nend\n\n# ======================== 테스트 13: 위치 추적 ========================\n\nfunction test_position_tracking()\n    println(\"\\n--- Test 13: Position Tracking ---\")\n\n    tokens = tokenize(\"x = 42\")\n\n    test_case(\"Line tracking\",\n        tokens[1].pos.line == 1 &&\n        tokens[3].pos.line == 1\n    )\n\n    code = \"x\\ny\"\n    tokens = tokenize(code)\n    test_case(\"Multi-line position\",\n        any(t.pos.line == 1 && t.value == \"x\" for t in tokens) &&\n        any(t.pos.line == 2 && t.value == \"y\" for t in tokens)\n    )\nend\n\n# ======================== 테스트 14: 주석 처리 ========================\n\nfunction test_comments()\n    println(\"\\n--- Test 14: Comments ---\")\n\n    code = \"x = 10  # this