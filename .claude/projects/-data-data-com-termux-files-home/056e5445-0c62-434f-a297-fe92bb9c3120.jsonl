n\n  parse() {\n    const statements = [];\n\n    while (this.currentToken().type !== TokenType.EOF) {\n      statements.push(this.parseStatement());\n    }\n\n    return new Program(statements);\n  }\n\n  parseStatement() {\n    const token = this.currentToken();\n\n    // 변수 선언\n    if (token.type === TokenType.LET) {\n      return this.parseLetDeclaration();\n    }\n\n    if (token.type === TokenType.CONST) {\n      return this.parseConstDeclaration();\n    }\n\n    // 함수 선언\n    if (token.type === TokenType.FN) {\n      return this.parseFunctionDeclaration();\n    }\n\n    // 제어 흐름\n    if (token.type === TokenType.IF) {\n      return this.parseIfStatement();\n    }\n\n    if (token.type === TokenType.WHILE) {\n      return this.parseWhileStatement();\n    }\n\n    if (token.type === TokenType.FOR) {\n      return this.parseForStatement();\n    }\n\n    if (token.type === TokenType.RETURN) {\n      return this.parseReturnStatement();\n    }\n\n    // 블록\n    if (token.type === TokenType.LBRACE) {\n      return this.parseBlockStatement();\n    }\n\n    // 표현식 문장\n    return this.parseExpressionStatement();\n  }\n\n  parseLetDeclaration() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    this.expect(TokenType.LET);\n    const name = this.expect(TokenType.IDENTIFIER).value;\n\n    let value = null;\n    if (this.match(TokenType.ASSIGN)) {\n      this.expect(TokenType.ASSIGN);\n      value = this.parseExpression();\n    }\n\n    if (this.match(TokenType.SEMICOLON)) {\n      this.expect(TokenType.SEMICOLON);\n    }\n\n    return new LetDeclaration(name, value, line, column);\n  }\n\n  parseConstDeclaration() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    this.expect(TokenType.CONST);\n    const name = this.expect(TokenType.IDENTIFIER).value;\n    this.expect(TokenType.ASSIGN);\n    const value = this.parseExpression();\n\n    if (this.match(TokenType.SEMICOLON)) {\n      this.expect(TokenType.SEMICOLON);\n    }\n\n    return new ConstDeclaration(name, value, line, column);\n  }\n\n  parseFunctionDeclaration() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    this.expect(TokenType.FN);\n    const name = this.expect(TokenType.IDENTIFIER).value;\n\n    this.expect(TokenType.LPAREN);\n    const params = [];\n    while (!this.match(TokenType.RPAREN)) {\n      params.push(this.expect(TokenType.IDENTIFIER).value);\n      if (this.match(TokenType.COMMA)) {\n        this.expect(TokenType.COMMA);\n      }\n    }\n    this.expect(TokenType.RPAREN);\n\n    this.expect(TokenType.LBRACE);\n    const body = this.parseBlockBody();\n    this.expect(TokenType.RBRACE);\n\n    return new FunctionDeclaration(name, params, body, line, column);\n  }\n\n  parseIfStatement() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    this.expect(TokenType.IF);\n    this.expect(TokenType.LPAREN);\n    const condition = this.parseExpression();\n    this.expect(TokenType.RPAREN);\n\n    this.expect(TokenType.LBRACE);\n    const thenBranch = this.parseBlockBody();\n    this.expect(TokenType.RBRACE);\n\n    let elseBranch = null;\n    if (this.match(TokenType.ELSE)) {\n      this.expect(TokenType.ELSE);\n      this.expect(TokenType.LBRACE);\n      elseBranch = this.parseBlockBody();\n      this.expect(TokenType.RBRACE);\n    }\n\n    return new IfStatement(condition, thenBranch, elseBranch, line, column);\n  }\n\n  parseWhileStatement() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    this.expect(TokenType.WHILE);\n    this.expect(TokenType.LPAREN);\n    const condition = this.parseExpression();\n    this.expect(TokenType.RPAREN);\n\n    this.expect(TokenType.LBRACE);\n    const body = this.parseBlockBody();\n    this.expect(TokenType.RBRACE);\n\n    return new WhileStatement(condition, body, line, column);\n  }\n\n  parseForStatement() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    this.expect(TokenType.FOR);\n    this.expect(TokenType.LPAREN);\n\n    // 초기화\n    let init = null;\n    if (!this.match(TokenType.SEMICOLON)) {\n      init = this.parseExpression();\n    }\n    this.expect(TokenType.SEMICOLON);\n\n    // 조건\n    let condition = null;\n    if (!this.match(TokenType.SEMICOLON)) {\n      condition = this.parseExpression();\n    }\n    this.expect(TokenType.SEMICOLON);\n\n    // 업데이트\n    let update = null;\n    if (!this.match(TokenType.RPAREN)) {\n      update = this.parseExpression();\n    }\n    this.expect(TokenType.RPAREN);\n\n    this.expect(TokenType.LBRACE);\n    const body = this.parseBlockBody();\n    this.expect(TokenType.RBRACE);\n\n    return new ForStatement(init, condition, update, body, line, column);\n  }\n\n  parseReturnStatement() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    this.expect(TokenType.RETURN);\n\n    let value = null;\n    if (!this.match(TokenType.SEMICOLON, TokenType.RBRACE, TokenType.EOF)) {\n      value = this.parseExpression();\n    }\n\n    if (this.match(TokenType.SEMICOLON)) {\n      this.expect(TokenType.SEMICOLON);\n    }\n\n    return new ReturnStatement(value, line, column);\n  }\n\n  parseBlockStatement() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    this.expect(TokenType.LBRACE);\n    const statements = this.parseBlockBody();\n    this.expect(TokenType.RBRACE);\n\n    return new BlockStatement(statements, line, column);\n  }\n\n  parseBlockBody() {\n    const statements = [];\n    while (!this.match(TokenType.RBRACE, TokenType.EOF)) {\n      statements.push(this.parseStatement());\n    }\n    return statements;\n  }\n\n  parseExpressionStatement() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    const expr = this.parseExpression();\n\n    if (this.match(TokenType.SEMICOLON)) {\n      this.expect(TokenType.SEMICOLON);\n    }\n\n    return new ExpressionStatement(expr, line, column);\n  }\n\n  parseExpression() {\n    return this.parseAssignment();\n  }\n\n  parseAssignment() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    let expr = this.parseLogicalOr();\n\n    if (this.match(TokenType.ASSIGN)) {\n      this.expect(TokenType.ASSIGN);\n      const value = this.parseAssignment();\n      return new Assignment(expr, value, line, column);\n    }\n\n    return expr;\n  }\n\n  parseLogicalOr() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    let expr = this.parseLogicalAnd();\n\n    while (this.match(TokenType.OR)) {\n      const operator = this.currentToken().value;\n      this.advance();\n      const right = this.parseLogicalAnd();\n      expr = new BinaryOp(expr, operator, right, line, column);\n    }\n\n    return expr;\n  }\n\n  parseLogicalAnd() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    let expr = this.parseEquality();\n\n    while (this.match(TokenType.AND)) {\n      const operator = this.currentToken().value;\n      this.advance();\n      const right = this.parseEquality();\n      expr = new BinaryOp(expr, operator, right, line, column);\n    }\n\n    return expr;\n  }\n\n  parseEquality() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    let expr = this.parseComparison();\n\n    while (this.match(TokenType.EQUAL, TokenType.NOT_EQUAL)) {\n      const operator = this.currentToken().value;\n      this.advance();\n      const right = this.parseComparison();\n      expr = new BinaryOp(expr, operator, right, line, column);\n    }\n\n    return expr;\n  }\n\n  parseComparison() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    let expr = this.parseAdditive();\n\n    while (this.match(TokenType.LESS, TokenType.LESS_EQUAL, TokenType.GREATER, TokenType.GREATER_EQUAL)) {\n      const operator = this.currentToken().value;\n      this.advance();\n      const right = this.parseAdditive();\n      expr = new BinaryOp(expr, operator, right, line, column);\n    }\n\n    return expr;\n  }\n\n  parseAdditive() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    let expr = this.parseMultiplicative();\n\n    while (this.match(TokenType.PLUS, TokenType.MINUS)) {\n      const operator = this.currentToken().value;\n      this.advance();\n      const right = this.parseMultiplicative();\n      expr = new BinaryOp(expr, operator, right, line, column);\n    }\n\n    return expr;\n  }\n\n  parseMultiplicative() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    let expr = this.parseUnary();\n\n    while (this.match(TokenType.MULTIPLY, TokenType.DIVIDE, TokenType.MODULO)) {\n      const operator = this.currentToken().value;\n      this.advance();\n      const right = this.parseUnary();\n      expr = new BinaryOp(expr, operator, right, line, column);\n    }\n\n    return expr;\n  }\n\n  parseUnary() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n\n    if (this.match(TokenType.NOT, TokenType.MINUS)) {\n      const operator = this.currentToken().value;\n      this.advance();\n      const operand = this.parseUnary();\n      return new UnaryOp(operator, operand, line, column);\n    }\n\n    return this.parsePostfix();\n  }\n\n  parsePostfix() {\n    let expr = this.parsePrimary();\n\n    while (true) {\n      if (this.match(TokenType.LPAREN)) {\n        // 함수 호출\n        const line = this.currentToken().line;\n        const column = this.currentToken().column;\n        this.expect(TokenType.LPAREN);\n\n        const args = [];\n        while (!this.match(TokenType.RPAREN)) {\n          args.push(this.parseExpression());\n          if (this.match(TokenType.COMMA)) {\n            this.expect(TokenType.COMMA);\n          }\n        }\n        this.expect(TokenType.RPAREN);\n\n        if (expr instanceof Identifier) {\n          expr = new FunctionCall(expr.name, args, line, column);\n        } else {\n          throw new Error('Only identifiers can be called as functions');\n        }\n      } else if (this.match(TokenType.LBRACKET)) {\n        // 배열 인덱싱\n        const line = this.currentToken().line;\n        const column = this.currentToken().column;\n        this.expect(TokenType.LBRACKET);\n        const index = this.parseExpression();\n        this.expect(TokenType.RBRACKET);\n        expr = new IndexAccess(expr, index, line, column);\n      } else if (this.match(TokenType.DOT)) {\n        // 멤버 접근\n        const line = this.currentToken().line;\n        const column = this.currentToken().column;\n        this.expect(TokenType.DOT);\n        const member = this.expect(TokenType.IDENTIFIER).value;\n        expr = new MemberAccess(expr, member, line, column);\n      } else {\n        break;\n      }\n    }\n\n    return expr;\n  }\n\n  parsePrimary() {\n    const line = this.currentToken().line;\n    const column = this.currentToken().column;\n    const token = this.currentToken();\n\n    // 숫자\n    if (token.type === TokenType.NUMBER) {\n      this.advance();\n      return new NumberLiteral(token.value, line, column);\n    }\n\n    // 문자열\n    if (token.type === TokenType.STRING) {\n      this.advance();\n      return new StringLiteral(token.value, line, column);\n    }\n\n    // 불린\n    if (token.type === TokenType.TRUE) {\n      this.advance();\n      return new BooleanLiteral(true, line, column);\n    }\n\n    if (token.type === TokenType.FALSE) {\n      this.advance();\n      return new BooleanLiteral(false, line, column);\n    }\n\n    // null\n    if (token.type === TokenType.NULL) {\n      this.advance();\n      return new NullLiteral(line, column);\n    }\n\n    // 식별자\n    if (token.type === TokenType.IDENTIFIER) {\n      this.advance();\n      return new Identifier(token.value, line, column);\n    }\n\n    // 배열\n    if (token.type === TokenType.LBRACKET) {\n      this.expect(TokenType.LBRACKET);\n      const elements = [];\n      while (!this.match(TokenType.RBRACKET)) {\n        elements.push(this.parseExpression());\n        if (this.match(TokenType.COMMA)) {\n          this.expect(TokenType.COMMA);\n        }\n      }\n      this.expect(TokenType.RBRACKET);\n      return new ArrayLiteral(elements, line, column);\n    }\n\n    // 괄호\n    if (token.type === TokenType.LPAREN) {\n      this.expect(TokenType.LPAREN);\n      const expr = this.parseExpression();\n      this.expect(TokenType.RPAREN);\n      return expr;\n    }\n\n    throw new Error(`Unexpected token: ${token.type} at ${line}:${column}`);\n  }\n}\n\nmodule.exports = { Parser };\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"bc597d6e-fb2f-43e7-a4c2-92967bee2ad3"}
