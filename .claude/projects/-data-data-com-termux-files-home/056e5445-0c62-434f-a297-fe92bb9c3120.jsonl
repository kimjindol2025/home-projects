e":"44f52d339e4a6419@v2","version":2,"backupTime":"2026-03-11T07:08:04.656Z"},"/tmp/freelang-project/examples/example3.fl":{"backupFileName":"73ca9dd291cf2eb4@v2","version":2,"backupTime":"2026-03-11T07:08:04.657Z"},"/tmp/freelang-project/compile.jl":{"backupFileName":"36a80bd394e01f71@v2","version":2,"backupTime":"2026-03-11T07:08:04.658Z"},"/tmp/freelang-project/examples/example1.c":{"backupFileName":"3aaed54e33219112@v2","version":2,"backupTime":"2026-03-11T07:08:04.659Z"},"/tmp/freelang-project/examples/example2.c":{"backupFileName":"46bf54cb6557004c@v2","version":2,"backupTime":"2026-03-11T07:08:04.660Z"},"/tmp/freelang-project/examples/example3.c":{"backupFileName":"5936408503c230e5@v2","version":2,"backupTime":"2026-03-11T07:08:04.662Z"},"/tmp/freelang-project/test/integration_test.jl":{"backupFileName":"232ce86ccd32cc95@v2","version":2,"backupTime":"2026-03-11T07:17:41.118Z"},"/tmp/freelang-project/test/selfhosting_bootstrap.sh":{"backupFileName":"f2790d8afd5e29c9@v2","version":2,"backupTime":"2026-03-11T07:17:41.119Z"},"/tmp/freelang-project/SELFHOSTING_BOOTSTRAP_REPORT.md":{"backupFileName":"bfc3cebcdc70a99e@v2","version":2,"backupTime":"2026-03-11T07:17:41.121Z"},"/tmp/freelang-project/src/freeliulia_stdlib.jl":{"backupFileName":"3ba3dfd16b22664d@v2","version":2,"backupTime":"2026-03-11T07:25:05.928Z"},"/tmp/freelang-project/src/freeliulia_stdlib.h":{"backupFileName":"40c08afd2664fa55@v3","version":3,"backupTime":"2026-03-11T08:28:04.195Z"},"/tmp/freelang-project/STDLIB.md":{"backupFileName":"a3f6760b692f354a@v3","version":3,"backupTime":"2026-03-11T08:28:04.198Z"},"/tmp/freelang-project/test/stdlib_test.c":{"backupFileName":"58f932405c3e8149@v2","version":2,"backupTime":"2026-03-11T07:25:05.932Z"},"/tmp/freelang-project/PHASE_4_STDLIB_REPORT.md":{"backupFileName":"ca7ae05f9e4e221a@v2","version":2,"backupTime":"2026-03-11T07:25:05.934Z"},"/tmp/freelang-project/examples/micro_lexer.fl":{"backupFileName":"86a706a030877008@v2","version":2,"backupTime":"2026-