alue;\n    this.line = line;\n    this.column = column;\n  }\n\n  toString() {\n    return `Token(${this.type}, ${this.value}, ${this.line}:${this.column})`;\n  }\n}\n\nclass Tokenizer {\n  constructor(source) {\n    this.source = source;\n    this.position = 0;\n    this.line = 1;\n    this.column = 1;\n    this.tokens = [];\n  }\n\n  keywords = {\n    'let': TokenType.LET,\n    'const': TokenType.CONST,\n    'fn': TokenType.FN,\n    'if': TokenType.IF,\n    'else': TokenType.ELSE,\n    'for': TokenType.FOR,\n    'while': TokenType.WHILE,\n    'return': TokenType.RETURN,\n    'true': TokenType.TRUE,\n    'false': TokenType.FALSE,\n    'null': TokenType.NULL,\n  };\n\n  currentChar() {\n    if (this.position >= this.source.length) return null;\n    return this.source[this.position];\n  }\n\n  peekChar(offset = 1) {\n    const pos = this.position + offset;\n    if (pos >= this.source.length) return null;\n    return this.source[pos];\n  }\n\n  advance() {\n    if (this.currentChar() === '\\n') {\n      this.line++;\n      this.column = 1;\n    } else {\n      this.column++;\n    }\n    this.position++;\n  }\n\n  skipWhitespace() {\n    while (this.currentChar() && /\\s/.test(this.currentChar())) {\n      this.advance();\n    }\n  }\n\n  skipComment() {\n    // 라인 주석\n    if (this.currentChar() === '/' && this.peekChar() === '/') {\n      while (this.currentChar() && this.currentChar() !== '\\n') {\n        this.advance();\n      }\n      this.advance(); // \\n 건너뛰기\n      return true;\n    }\n\n    // 블록 주석\n    if (this.currentChar() === '/' && this.peekChar() === '*') {\n      this.advance(); // /\n      this.advance(); // *\n      while (this.currentChar()) {\n        if (this.currentChar() === '*' && this.peekChar() === '/') {\n          this.advance(); // *\n          this.advance(); // /\n          return true;\n        }\n        this.advance();\n      }\n      return true;\n    }\n\n    return false;\n  }\n\n  readNumber() {\n    const startPos = this.position;\n    const startCol = this.column;\n\n    while (this.currentChar() && /\\d/.test(this.currentChar())) {\n      this.advance();\n    }\n\n    // 부동소수점\n    if (this.currentChar() === '.' && /\\d/.test(this.peekChar())) {\n      this.advance();\n      while (this.currentChar() && /\\d/.test(this.currentChar())) {\n        this.advance();\n      }\n    }\n\n    const value = this.source.substring(startPos, this.position);\n    return new Token(TokenType.NUMBER, parseFloat(value), this.line, startCol);\n  }\n\n  readString(quote) {\n    const startCol = this.column;\n    this.advance(); // 따옴표 건너뛰기\n    let value = '';\n\n    while (this.currentChar() && this.currentChar() !== quote) {\n      if (this.currentChar() === '\\\\') {\n        this.advance();\n        const escaped = this.currentChar();\n        switch (escaped) {\n          case 'n': value += '\\n'; break;\n          case 't': value += '\\t'; break;\n          case '\\\\': value += '\\\\'; break;\n          case quote: value += quote; break;\n          default: value += escaped;\n        }\n        this.advance();\n      } else {\n        value += this.currentChar();\n        this.advance();\n      }\n    }\n\n    if (this.currentChar() === quote) {\n      this.advance();\n    }\n\n    return new Token(TokenType.STRING, value, this.line, startCol);\n  }\n\n  readIdentifier() {\n    const startPos = this.position;\n    const startCol = this.column;\n\n    while (this.currentChar() && /[a-zA-Z0-9_]/.test(this.currentChar())) {\n      this.advance();\n    }\n\n    const value = this.source.substring(startPos, this.position);\n    const type = this.keywords[value] || TokenType.IDENTIFIER;\n\n    return new Token(type, value, this.line, startCol);\n  }\n\n  tokenize() {\n    while (this.position < this.source.length) {\n      this.skipWhitespace();\n\n      if (this.position >= this.source.length) break;\n\n      // 주석\n      if (this.skipComment()) {\n        continue;\n      }\n\n      const char = this.currentChar();\n      const col = this.column;\n\n      // 숫자\n      if (/\\d/.test(char)) {\n        this.tokens.push(this.readNumber());\n        continue;\n      }\n\n      // 문자열\n      if (char === '\"' || char === \"'\") {\n        this.tokens.push(this.readString(char));\n        continue;\n      }\n\n      // 식별자 & 키워드\n      if (/[a-zA-Z_]/.test(char)) {\n        this.tokens.push(this.readIdentifier());\n        continue;\n      }\n\n      // 연산자 & 구분자\n      if (char === '+') {\n        this.tokens.push(new Token(TokenType.PLUS, '+', this.line, col));\n        this.advance();\n      } else if (char === '-') {\n        this.tokens.push(new Token(TokenType.MINUS, '-', this.line, col));\n        this.advance();\n      } else if (char === '*') {\n        this.tokens.push(new Token(TokenType.MULTIPLY, '*', this.line, col));\n        this.advance();\n      } else if (char === '/') {\n        this.tokens.push(new Token(TokenType.DIVIDE, '/', this.line, col));\n        this.advance();\n      } else if (char === '%') {\n        this.tokens.push(new Token(TokenType.MODULO, '%', this.line, col));\n        this.advance();\n      } else if (char === '=') {\n        if (this.peekChar() === '=') {\n          this.tokens.push(new Token(TokenType.EQUAL, '==', this.line, col));\n          this.advance();\n          this.advance();\n        } else {\n          this.tokens.push(new Token(TokenType.ASSIGN, '=', this.line, col));\n          this.advance();\n        }\n      } else if (char === '!') {\n        if (this.peekChar() === '=') {\n          this.tokens.push(new Token(TokenType.NOT_EQUAL, '!=', this.line, col));\n          this.advance();\n          this.advance();\n        } else {\n          this.tokens.push(new Token(TokenType.NOT, '!', this.line, col));\n          this.advance();\n        }\n      } else if (char === '<') {\n        if (this.peekChar() === '=') {\n          this.tokens.push(new Token(TokenType.LESS_EQUAL, '<=', this.line, col));\n          this.advance();\n          this.advance();\n        } else {\n          this.tokens.push(new Token(TokenType.LESS, '<', this.line, col));\n          this.advance();\n        }\n      } else if (char === '>') {\n        if (this.peekChar() === '=') {\n          this.tokens.push(new Token(TokenType.GREATER_EQUAL, '>=', this.line, col));\n          this.advance();\n          this.advance();\n        } else {\n          this.tokens.push(new Token(TokenType.GREATER, '>', this.line, col));\n          this.advance();\n        }\n      } else if (char === '&' && this.peekChar() === '&') {\n        this.tokens.push(new Token(TokenType.AND, '&&', this.line, col));\n        this.advance();\n        this.advance();\n      } else if (char === '|' && this.peekChar() === '|') {\n        this.tokens.push(new Token(TokenType.OR, '||', this.line, col));\n        this.advance();\n        this.advance();\n      } else if (char === '(') {\n        this.tokens.push(new Token(TokenType.LPAREN, '(', this.line, col));\n        this.advance();\n      } else if (char === ')') {\n        this.tokens.push(new Token(TokenType.RPAREN, ')', this.line, col));\n        this.advance();\n      } else if (char === '{') {\n        this.tokens.push(new Token(TokenType.LBRACE, '{', this.line, col));\n        this.advance();\n      } else if (char === '}') {\n        this.tokens.push(new Token(TokenType.RBRACE, '}', this.line, col));\n        this.advance();\n      } else if (char === '[') {\n        this.tokens.push(new Token(TokenType.LBRACKET, '[', this.line, col));\n        this.advance();\n      } else if (char === ']') {\n        this.tokens.push(new Token(TokenType.RBRACKET, ']', this.line, col));\n        this.advance();\n      } else if (char === ';') {\n        this.tokens.push(new Token(TokenType.SEMICOLON, ';', this.line, col));\n        this.advance();\n      } else if (char === ',') {\n        this.tokens.push(new Token(TokenType.COMMA, ',', this.line, col));\n        this.advance();\n      } else if (char === '.') {\n        this.tokens.push(new Token(TokenType.DOT, '.', this.line, col));\n        this.advance();\n      } else if (char === ':') {\n        this.tokens.push(new Token(TokenType.COLON, ':', this.line, col));\n        this.advance();\n      } else {\n        throw new Error(`Unknown character: ${char} at ${this.line}:${col}`);\n      }\n    }\n\n    this.tokens.push(new Token(TokenType.EOF, null, this.line, this.column));\n    return this.tokens;\n  }\n}\n\nmodule.exports = { Tokenizer, Token, TokenType };\n","structuredPatch":[],"originalFile":null},"sourceToolAssistantUUID":"bb0be529-ea1e-4f1b-a4da-2fb4d2635ea3"}
