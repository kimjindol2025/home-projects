{
  "model": "haiku",
  "language": "한글",
  "alwaysThinkingEnabled": true,
  "fastMode": false,
  "effortLevel": "high",

  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(git:*)",
      "Bash(go:*)",
      "Bash(npm:*)",
      "Bash(npm test:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ]
  },

  "env": {
    "DEBUG": "true",
    "GOOS": "linux"
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // .tool_response.filePath'); [[ \"$f\" == *.go ]] && (gofmt -w \"$f\" && echo '✅ gofmt 완료') || true",
            "statusMessage": "🎨 Go 코드 포맷중..."
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // .tool_response.filePath'); [[ \"$f\" == *.fl ]] && echo '📝 FreeLang 파일 저장됨' || true",
            "statusMessage": "💾 파일 저장..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "UserPromptSubmit",
        "hooks": [
          {
            "type": "command",
            "command": "echo '🔍 검증 사이클 시작' && echo \"[$(date '+%Y-%m-%d %H:%M:%S')] 작업 시작\" >> ~/.claude/work-log.txt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // empty'); [[ \"$cmd\" == git* ]] && echo \"[$(date '+%Y-%m-%d %H:%M:%S')] $cmd\" >> ~/.claude/git-log.txt || true"
          }
        ]
      }
    ]
  },

  "spinnerVerbs": {
    "mode": "append",
    "verbs": [
      "검증 중",
      "테스트 실행 중",
      "성능 측정 중",
      "벤치마크 실행 중",
      "감사 중",
      "최적화 중",
      "배포 준비 중",
      "메모리 저장 중"
    ]
  },

  "spinnerTipsOverride": {
    "excludeDefault": false,
    "tips": [
      "💡 Tip: 100% 테스트 커버리지를 목표로 하세요",
      "💡 Tip: 성능 수치는 항상 벤치마크로 입증하세요",
      "💡 Tip: 완료된 작업은 메모리에 기록하세요",
      "💡 Tip: 감사 리포트로 품질을 증명하세요",
      "💡 Tip: 코드 변경 후 자동 테스트를 기다리세요",
      "💡 Tip: 파일 저장 후 자동 포맷팅 완료를 확인하세요"
    ]
  },

  "attribution": {
    "commit": "✅ 검증 완료: 100% 테스트 PASS\n\nCo-Authored-By: Claude Haiku 4.5 <noreply@anthropic.com>"
  },

  "respectGitignore": true,
  "cleanupPeriodDays": 30,
  "spinnerTipsEnabled": true
}
