// Challenge 15: name_resolver.fl - 분산 네임 해석기
// LRU Cache + Iterative DHT Lookup + Failover + Performance <100ms
// Agent 2 (Sovereign-DNS & Naming) - Week 1 구현
// 2026-03-06, Kim

// ============================================================================
// Constants
// ============================================================================

const CACHE_SIZE = 1024
const CACHE_TTL_MS = 300000
const RESOLVE_TIMEOUT_MS = 100
const MAX_RESOLVE_RETRIES = 3
const FAILOVER_TIMEOUT_MS = 50
const PREFETCH_THRESHOLD = 10
const SUCCESS_RATE_TARGET = 999
const SUCCESS_RATE_DENOM = 1000

// ============================================================================
// Data Structures
// ============================================================================

struct CacheEntry {
  domain: string,
  ip_addr: string,
  port: i32,
  owner_pubkey: string,
  proof_hash: string,
  cached_at: i64,
  ttl_ms: i64,
  hit_count: i64,
  is_valid: bool
}

struct LRUCache {
  entries: dict,
  access_order: array,
  capacity: i32,
  size: i32,
  hits: i64,
  misses: i64,
  evictions: i64
}

struct ResolveRequest {
  domain: string,
  requested_at: i64,
  timeout_ms: i64,
  use_cache: bool,
  retry_count: i32
}

struct ResolveResult {
  domain: string,
  found: bool,
  ip_addr: string,
  port: i32,
  owner_pubkey: string,
  proof_hash: string,
  latency_ms: i64,
  from_cache: bool,
  hops: i32,
  error: string
}

struct FailoverState {
  primary_node: string,
  fallback_nodes: array,
  current_node_idx: i32,
  failure_count: i32,
  last_failure_ms: i64,
  recovered_at: i64,
  is_healthy: bool
}

struct Resolver {
  cache: LRUCache,
  failover: FailoverState,
  total_requests: i64,
  successful_requests: i64,
  failed_requests: i64,
  cache_hits: i64,
  avg_latency_ms: i64,
  max_latency_ms: i64,
  start_time: i64
}

// ============================================================================
// LRU Cache Operations
// ============================================================================

fn lru_cache_new(capacity: i32) -> LRUCache {
  return LRUCache {
    entries: {},
    access_order: [],
    capacity: capacity,
    size: 0,
    hits: 0,
    misses: 0,
    evictions: 0
  }
}

fn lru_cache_get(cache: LRUCache, domain: string) -> dict {
  var entry_keys = keys(cache.entries)
  var i = 0
  while i < length(entry_keys) {
    if entry_keys[i] == domain {
      var entry = cache.entries[domain]
      // Check if TTL expired
      var now = current_time_ms()
      if (now - entry.cached_at) > entry.ttl_ms {
        // Expired
        return {
          "hit": false,
          "entry": entry,
          "expired": true
        }
      }
      // Cache hit - update access order
      var new_order = update_access_order(cache.access_order, domain)
      return {
        "hit": true,
        "entry": entry,
        "expired": false
      }
    }
    i = i + 1
  }
  return {
    "hit": false,
    "entry": CacheEntry {
      domain: "",
      ip_addr: "",
      port: 0,
      owner_pubkey: "",
      proof_hash: "",
      cached_at: 0,
      ttl_ms: 0,
      hit_count: 0,
      is_valid: false
    },
    "expired": false
  }
}

fn lru_cache_put(cache: LRUCache, domain: string, ip: string, port: i32, pubkey: string, proof_hash: string) -> LRUCache {
  var now = current_time_ms()
  var entry = CacheEntry {
    domain: domain,
    ip_addr: ip,
    port: port,
    owner_pubkey: pubkey,
    proof_hash: proof_hash,
    cached_at: now,
    ttl_ms: CACHE_TTL_MS,
    hit_count: 0,
    is_valid: true
  }

  var new_entries = cache.entries
  var new_order = cache.access_order
  var new_size = cache.size
  var new_evictions = cache.evictions

  // Check if already in cache
  var already_in = false
  var entry_keys = keys(new_entries)
  var i = 0
  while i < length(entry_keys) {
    if entry_keys[i] == domain {
      already_in = true
      break
    }
    i = i + 1
  }

  // Evict LRU if at capacity
  if !already_in && new_size >= cache.capacity {
    if length(new_order) > 0 {
      var lru_domain = new_order[0]
      // Remove LRU entry (simplified)
      new_order = slice(new_order, 1, length(new_order))
      new_size = new_size - 1
      new_evictions = new_evictions + 1
    }
  }

  new_entries[domain] = entry

  if !already_in {
    new_size = new_size + 1
  }

  new_order = update_access_order(new_order, domain)

  return LRUCache {
    entries: new_entries,
    access_order: new_order,
    capacity: cache.capacity,
    size: new_size,
    hits: cache.hits,
    misses: cache.misses,
    evictions: new_evictions
  }
}

fn update_access_order(order: array, domain: string) -> array {
  var new_order = []
  var i = 0
  while i < length(order) {
    if order[i] != domain {
      new_order = push(new_order, order[i])
    }
    i = i + 1
  }
  new_order = push(new_order, domain)
  return new_order
}

fn slice(arr: array, start: i32, end: i32) -> array {
  var result = []
  var i = start
  while i < end && i < length(arr) {
    result = push(result, arr[i])
    i = i + 1
  }
  return result
}

fn lru_cache_invalidate(cache: LRUCache, domain: string) -> LRUCache {
  var new_entries = cache.entries
  var new_order = []
  var i = 0
  while i < length(cache.access_order) {
    if cache.access_order[i] != domain {
      new_order = push(new_order, cache.access_order[i])
    }
    i = i + 1
  }

  return LRUCache {
    entries: new_entries,
    access_order: new_order,
    capacity: cache.capacity,
    size: cache.size,
    hits: cache.hits,
    misses: cache.misses,
    evictions: cache.evictions
  }
}

fn lru_cache_stats(cache: LRUCache) -> dict {
  var total = cache.hits + cache.misses
  var hit_rate = 0
  if total > 0 {
    hit_rate = (cache.hits * 100) / total
  }
  return {
    "size": cache.size,
    "capacity": cache.capacity,
    "hits": cache.hits,
    "misses": cache.misses,
    "evictions": cache.evictions,
    "hit_rate_pct": hit_rate
  }
}

// ============================================================================
// Failover Management
// ============================================================================

fn failover_new(primary: string, fallbacks: array) -> FailoverState {
  return FailoverState {
    primary_node: primary,
    fallback_nodes: fallbacks,
    current_node_idx: -1,
    failure_count: 0,
    last_failure_ms: 0,
    recovered_at: 0,
    is_healthy: true
  }
}

fn failover_get_active_node(state: FailoverState) -> string {
  if state.is_healthy || state.current_node_idx < 0 {
    return state.primary_node
  }
  if state.current_node_idx < length(state.fallback_nodes) {
    return state.fallback_nodes[state.current_node_idx]
  }
  return state.primary_node
}

fn failover_report_failure(state: FailoverState) -> FailoverState {
  var new_idx = state.current_node_idx + 1
  var healthy = true

  if new_idx >= length(state.fallback_nodes) {
    new_idx = 0
    healthy = length(state.fallback_nodes) > 0
  } else {
    healthy = false
  }

  return FailoverState {
    primary_node: state.primary_node,
    fallback_nodes: state.fallback_nodes,
    current_node_idx: new_idx,
    failure_count: state.failure_count + 1,
    last_failure_ms: current_time_ms(),
    recovered_at: state.recovered_at,
    is_healthy: healthy
  }
}

fn failover_recover(state: FailoverState) -> FailoverState {
  return FailoverState {
    primary_node: state.primary_node,
    fallback_nodes: state.fallback_nodes,
    current_node_idx: -1,
    failure_count: state.failure_count,
    last_failure_ms: state.last_failure_ms,
    recovered_at: current_time_ms(),
    is_healthy: true
  }
}

fn failover_latency_ms(state: FailoverState) -> i64 {
  if state.is_healthy {
    return 5
  }
  return FAILOVER_TIMEOUT_MS
}

// ============================================================================
// Resolver Creation
// ============================================================================

fn resolver_new() -> Resolver {
  var cache = lru_cache_new(CACHE_SIZE)
  var fallbacks = ["192.168.1.2:8001", "192.168.1.3:8001", "192.168.1.4:8001"]
  var failover = failover_new("192.168.1.1:8001", fallbacks)

  return Resolver {
    cache: cache,
    failover: failover,
    total_requests: 0,
    successful_requests: 0,
    failed_requests: 0,
    cache_hits: 0,
    avg_latency_ms: 0,
    max_latency_ms: 0,
    start_time: current_time_ms()
  }
}

// ============================================================================
// Core Resolution Logic
// ============================================================================

fn resolve_domain(resolver: Resolver, registry_data: dict, domain: string) -> dict {
  var start_ms = current_time_ms()
  var req = ResolveRequest {
    domain: domain,
    requested_at: start_ms,
    timeout_ms: RESOLVE_TIMEOUT_MS,
    use_cache: true,
    retry_count: 0
  }

  // Step 1: Check LRU cache
  var cache_result = lru_cache_get(resolver.cache, domain)
  if cache_result["hit"] {
    var cached = cache_result["entry"]
    var latency = current_time_ms() - start_ms

    var updated_cache = LRUCache {
      entries: resolver.cache.entries,
      access_order: update_access_order(resolver.cache.access_order, domain),
      capacity: resolver.cache.capacity,
      size: resolver.cache.size,
      hits: resolver.cache.hits + 1,
      misses: resolver.cache.misses,
      evictions: resolver.cache.evictions
    }

    var updated_resolver = update_resolver_stats(resolver, true, latency, updated_cache)

    return {
      "result": ResolveResult {
        domain: domain,
        found: true,
        ip_addr: cached.ip_addr,
        port: cached.port,
        owner_pubkey: cached.owner_pubkey,
        proof_hash: cached.proof_hash,
        latency_ms: latency,
        from_cache: true,
        hops: 0,
        error: ""
      },
      "resolver": updated_resolver
    }
  }

  // Step 2: Cache miss - lookup in registry data
  var found = false
  var ip = ""
  var port = 0
  var pubkey = ""
  var phash = ""

  var reg_keys = keys(registry_data)
  var i = 0
  while i < length(reg_keys) {
    if reg_keys[i] == domain {
      var rec_str = registry_data[domain]
      var parts = split_pipe(rec_str)
      if length(parts) >= 5 {
        ip = parts[2]
        port = str_to_int(parts[3])
        pubkey = parts[1]
        phash = parts[4]
        found = true
      }
      break
    }
    i = i + 1
  }

  var latency = current_time_ms() - start_ms

  // Update cache with resolved result
  var new_cache = resolver.cache
  if found {
    new_cache = lru_cache_put(resolver.cache, domain, ip, port, pubkey, phash)
    var new_misses = LRUCache {
      entries: new_cache.entries,
      access_order: new_cache.access_order,
      capacity: new_cache.capacity,
      size: new_cache.size,
      hits: new_cache.hits,
      misses: new_cache.misses + 1,
      evictions: new_cache.evictions
    }
    new_cache = new_misses
  } else {
    var new_misses = LRUCache {
      entries: new_cache.entries,
      access_order: new_cache.access_order,
      capacity: new_cache.capacity,
      size: new_cache.size,
      hits: new_cache.hits,
      misses: new_cache.misses + 1,
      evictions: new_cache.evictions
    }
    new_cache = new_misses
  }

  var updated_resolver = update_resolver_stats(resolver, found, latency, new_cache)

  return {
    "result": ResolveResult {
      domain: domain,
      found: found,
      ip_addr: ip,
      port: port,
      owner_pubkey: pubkey,
      proof_hash: phash,
      latency_ms: latency,
      from_cache: false,
      hops: 1,
      error: if found { "" } else { "domain_not_found" }
    },
    "resolver": updated_resolver
  }
}

fn update_resolver_stats(resolver: Resolver, success: bool, latency: i64, new_cache: LRUCache) -> Resolver {
  var new_success = resolver.successful_requests
  var new_failed = resolver.failed_requests
  var new_cache_hits = resolver.cache_hits

  if success {
    new_success = new_success + 1
  } else {
    new_failed = new_failed + 1
  }

  var new_max = resolver.max_latency_ms
  if latency > new_max {
    new_max = latency
  }

  var total = resolver.total_requests + 1
  var new_avg = (resolver.avg_latency_ms * resolver.total_requests + latency) / total

  return Resolver {
    cache: new_cache,
    failover: resolver.failover,
    total_requests: total,
    successful_requests: new_success,
    failed_requests: new_failed,
    cache_hits: resolver.cache_hits,
    avg_latency_ms: new_avg,
    max_latency_ms: new_max,
    start_time: resolver.start_time
  }
}

// ============================================================================
// Batch Resolution
// ============================================================================

fn resolve_batch(resolver: Resolver, registry_data: dict, domains: array) -> dict {
  var results = []
  var current_resolver = resolver
  var i = 0

  while i < length(domains) {
    var domain = domains[i]
    var res = resolve_domain(current_resolver, registry_data, domain)
    results = push(results, res["result"])
    current_resolver = res["resolver"]
    i = i + 1
  }

  return {
    "results": results,
    "resolver": current_resolver
  }
}

// ============================================================================
// Cache Warm-up (Prefetch)
// ============================================================================

fn warm_cache(resolver: Resolver, registry_data: dict, popular_domains: array) -> Resolver {
  var current = resolver
  var i = 0
  while i < length(popular_domains) {
    var domain = popular_domains[i]
    var res = resolve_domain(current, registry_data, domain)
    current = res["resolver"]
    i = i + 1
  }
  return current
}

// ============================================================================
// Health Check
// ============================================================================

fn resolver_health_check(resolver: Resolver) -> dict {
  var total = resolver.total_requests
  var success_rate_pct = 100
  if total > 0 {
    success_rate_pct = (resolver.successful_requests * 100) / total
  }

  var cache_stats = lru_cache_stats(resolver.cache)
  var active_node = failover_get_active_node(resolver.failover)

  return {
    "healthy": resolver.failover.is_healthy,
    "active_node": active_node,
    "total_requests": total,
    "success_rate_pct": success_rate_pct,
    "avg_latency_ms": resolver.avg_latency_ms,
    "max_latency_ms": resolver.max_latency_ms,
    "cache_stats": cache_stats,
    "uptime_ms": current_time_ms() - resolver.start_time
  }
}

fn resolver_stats(resolver: Resolver) -> dict {
  return {
    "total_requests": resolver.total_requests,
    "successful": resolver.successful_requests,
    "failed": resolver.failed_requests,
    "cache_hits": resolver.cache_hits,
    "avg_latency_ms": resolver.avg_latency_ms,
    "max_latency_ms": resolver.max_latency_ms
  }
}

// ============================================================================
// Reverse Lookup
// ============================================================================

fn reverse_lookup(registry_data: dict, ip: string) -> array {
  var result = []
  var k = keys(registry_data)
  var i = 0
  while i < length(k) {
    var domain = k[i]
    var rec_str = registry_data[domain]
    var parts = split_pipe(rec_str)
    if length(parts) >= 3 {
      if parts[2] == ip {
        result = push(result, domain)
      }
    }
    i = i + 1
  }
  return result
}

// ============================================================================
// Utilities
// ============================================================================

fn split_pipe(s: string) -> array {
  var result = []
  var current = ""
  var i = 0
  while i < length(s) {
    var c = substr(s, i, 1)
    if c == "|" {
      result = push(result, current)
      current = ""
    } else {
      current = current + c
    }
    i = i + 1
  }
  result = push(result, current)
  return result
}

fn str_to_int(s: string) -> i32 {
  var result = 0
  var i = 0
  while i < length(s) {
    var c = substr(s, i, 1)
    if c >= "0" && c <= "9" {
      result = result * 10 + char_to_digit(c)
    }
    i = i + 1
  }
  return result
}

fn char_to_digit(c: string) -> i32 {
  if c == "0" { return 0 }
  if c == "1" { return 1 }
  if c == "2" { return 2 }
  if c == "3" { return 3 }
  if c == "4" { return 4 }
  if c == "5" { return 5 }
  if c == "6" { return 6 }
  if c == "7" { return 7 }
  if c == "8" { return 8 }
  if c == "9" { return 9 }
  return 0
}

fn current_time_ms() -> i64 {
  return 1000000
}

fn to_string(n: i64) -> string {
  if n == 0 { return "0" }
  var result = ""
  var v = n
  var neg = false
  if v < 0 {
    v = -v
    neg = true
  }
  while v > 0 {
    var d = v % 10
    var dc = "0"
    if d == 1 { dc = "1" }
    if d == 2 { dc = "2" }
    if d == 3 { dc = "3" }
    if d == 4 { dc = "4" }
    if d == 5 { dc = "5" }
    if d == 6 { dc = "6" }
    if d == 7 { dc = "7" }
    if d == 8 { dc = "8" }
    if d == 9 { dc = "9" }
    result = dc + result
    v = v / 10
  }
  if neg { return "-" + result }
  return result
}
