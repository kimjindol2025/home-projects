// Challenge 15: registry_provider.fl - 도메인 소유권 증명 레지스트리
// Ownership Proof + ZKP-lite + CAS Update + Domain Lifecycle
// Agent 2 (Sovereign-DNS & Naming) - Week 1 구현
// 2026-03-06, Kim

// ============================================================================
// Constants
// ============================================================================

const MAX_DOMAINS_PER_OWNER = 100
const PROOF_EXPIRY_SEC = 3600
const MIN_PROOF_DIFFICULTY = 4
const OWNERSHIP_TIMEOUT_MS = 1000
const UPDATE_VERSION_LIMIT = 1000
const BLACKLIST_THRESHOLD = -50
const REPUTATION_DECAY = 5
const MAX_REGISTRY_SIZE = 50000

// ============================================================================
// Data Structures
// ============================================================================

struct OwnershipProof {
  domain: string,
  owner_pubkey: string,
  challenge: string,
  response: string,
  proof_hash: string,
  created_at: i64,
  expires_at: i64,
  is_valid: bool
}

struct DomainOwnership {
  domain: string,
  owner_pubkey: string,
  registered_at: i64,
  last_updated: i64,
  version: i32,
  proof_chain: array,
  is_revoked: bool,
  transfer_locked: bool
}

struct RegistryEntry {
  domain: string,
  ownership: DomainOwnership,
  ip_addr: string,
  port: i32,
  txt_records: array,
  mx_records: array,
  ttl: i64,
  is_active: bool
}

struct Registry {
  entries: dict,
  entry_count: i32,
  owner_index: dict,
  proof_cache: dict,
  created_at: i64,
  last_update: i64,
  total_registrations: i64,
  total_updates: i64,
  total_revocations: i64
}

struct ProofRequest {
  domain: string,
  owner_pubkey: string,
  challenge: string,
  requested_at: i64
}

struct TransferRequest {
  domain: string,
  from_owner: string,
  to_owner: string,
  proof_hash: string,
  requested_at: i64,
  is_approved: bool
}

// ============================================================================
// Proof Generation
// ============================================================================

fn generate_challenge(domain: string, pubkey: string) -> string {
  // Deterministic challenge based on domain + pubkey + time
  var h = 0
  var raw = domain + pubkey + to_string(current_time_ms())
  var i = 0
  while i < length(raw) {
    h = (h * 31 + char_code(raw, i)) % 1000000007
    i = i + 1
  }
  return "chall_" + to_string(abs_i32(h))
}

fn compute_proof_response(challenge: string, private_seed: string) -> string {
  // Simulate ZKP-lite: hash(challenge || private_seed)
  var raw = challenge + "|" + private_seed
  var h = 0
  var i = 0
  while i < length(raw) {
    h = h * 37 + char_code(raw, i)
    i = i + 1
  }
  return "resp_" + to_string(abs_i64(h))
}

fn verify_proof_response(domain: string, pubkey: string, challenge: string, response: string) -> bool {
  // Verify that response matches expected pattern for this challenge
  // In production: ECDSA/EdDSA signature verification
  // Here: deterministic verification based on pubkey hash
  if length(response) < 5 {
    return false
  }
  if length(challenge) < 6 {
    return false
  }
  // Response must be prefixed correctly
  if substr(response, 0, 5) != "resp_" {
    return false
  }
  // Pubkey must be non-empty
  if length(pubkey) < 8 {
    return false
  }
  return true
}

fn create_ownership_proof(domain: string, pubkey: string, private_seed: string) -> OwnershipProof {
  var start_ms = current_time_ms()
  var challenge = generate_challenge(domain, pubkey)
  var response = compute_proof_response(challenge, private_seed)
  var valid = verify_proof_response(domain, pubkey, challenge, response)

  var proof_hash = hash_proof(domain, pubkey, challenge, response)
  var now = current_time_ms()

  return OwnershipProof {
    domain: domain,
    owner_pubkey: pubkey,
    challenge: challenge,
    response: response,
    proof_hash: proof_hash,
    created_at: now,
    expires_at: now + (PROOF_EXPIRY_SEC * 1000),
    is_valid: valid
  }
}

fn hash_proof(domain: string, pubkey: string, challenge: string, response: string) -> string {
  var raw = domain + pubkey + challenge + response
  var h = 5381
  var i = 0
  while i < length(raw) {
    h = h * 33 + char_code(raw, i)
    i = i + 1
  }
  return "proof_" + to_string(abs_i64(h))
}

fn proof_is_expired(proof: OwnershipProof, now: i64) -> bool {
  return now > proof.expires_at
}

// ============================================================================
// Registry Creation
// ============================================================================

fn registry_new() -> Registry {
  return Registry {
    entries: {},
    entry_count: 0,
    owner_index: {},
    proof_cache: {},
    created_at: current_time_ms(),
    last_update: current_time_ms(),
    total_registrations: 0,
    total_updates: 0,
    total_revocations: 0
  }
}

// ============================================================================
// Domain Registration
// ============================================================================

fn registry_register(reg: Registry, domain: string, pubkey: string, ip: string, port: i32, proof: OwnershipProof) -> dict {
  var start_ms = current_time_ms()

  // Check if domain already registered
  var domain_keys = keys(reg.entries)
  var i = 0
  var already_exists = false
  while i < length(domain_keys) {
    if domain_keys[i] == domain {
      already_exists = true
      break
    }
    i = i + 1
  }

  if already_exists {
    return {
      "success": false,
      "error": "domain_already_registered",
      "latency_ms": current_time_ms() - start_ms,
      "registry": reg
    }
  }

  // Validate proof
  if !proof.is_valid {
    return {
      "success": false,
      "error": "invalid_ownership_proof",
      "latency_ms": current_time_ms() - start_ms,
      "registry": reg
    }
  }

  // Create domain ownership record
  var ownership = DomainOwnership {
    domain: domain,
    owner_pubkey: pubkey,
    registered_at: current_time_ms(),
    last_updated: current_time_ms(),
    version: 1,
    proof_chain: [proof.proof_hash],
    is_revoked: false,
    transfer_locked: false
  }

  // Create registry entry
  var entry = RegistryEntry {
    domain: domain,
    ownership: ownership,
    ip_addr: ip,
    port: port,
    txt_records: [],
    mx_records: [],
    ttl: 86400,
    is_active: true
  }

  // Update registry
  var new_entries = reg.entries
  new_entries[domain] = entry

  // Update owner index
  var new_owner_index = reg.owner_index
  var owner_key = "owner_" + pubkey
  var existing_domains = []
  var owner_idx_keys = keys(new_owner_index)
  var j = 0
  while j < length(owner_idx_keys) {
    if owner_idx_keys[j] == owner_key {
      existing_domains = new_owner_index[owner_key]
      break
    }
    j = j + 1
  }
  existing_domains = push(existing_domains, domain)
  new_owner_index[owner_key] = existing_domains

  var updated_reg = Registry {
    entries: new_entries,
    entry_count: reg.entry_count + 1,
    owner_index: new_owner_index,
    proof_cache: reg.proof_cache,
    created_at: reg.created_at,
    last_update: current_time_ms(),
    total_registrations: reg.total_registrations + 1,
    total_updates: reg.total_updates,
    total_revocations: reg.total_revocations
  }

  return {
    "success": true,
    "error": "",
    "latency_ms": current_time_ms() - start_ms,
    "registry": updated_reg,
    "proof_hash": proof.proof_hash
  }
}

// ============================================================================
// Domain Lookup
// ============================================================================

fn registry_lookup(reg: Registry, domain: string) -> dict {
  var start_ms = current_time_ms()

  var domain_keys = keys(reg.entries)
  var i = 0
  while i < length(domain_keys) {
    if domain_keys[i] == domain {
      var entry = reg.entries[domain]
      if entry.is_active {
        return {
          "found": true,
          "entry": entry,
          "latency_ms": current_time_ms() - start_ms
        }
      }
    }
    i = i + 1
  }

  return {
    "found": false,
    "entry": RegistryEntry {
      domain: "",
      ownership: DomainOwnership {
        domain: "",
        owner_pubkey: "",
        registered_at: 0,
        last_updated: 0,
        version: 0,
        proof_chain: [],
        is_revoked: false,
        transfer_locked: false
      },
      ip_addr: "",
      port: 0,
      txt_records: [],
      mx_records: [],
      ttl: 0,
      is_active: false
    },
    "latency_ms": current_time_ms() - start_ms
  }
}

fn registry_get_by_owner(reg: Registry, pubkey: string) -> array {
  var owner_key = "owner_" + pubkey
  var owner_idx_keys = keys(reg.owner_index)
  var i = 0
  while i < length(owner_idx_keys) {
    if owner_idx_keys[i] == owner_key {
      return reg.owner_index[owner_key]
    }
    i = i + 1
  }
  return []
}

// ============================================================================
// CAS-based Update (Compare And Swap)
// ============================================================================

fn registry_update_cas(reg: Registry, domain: string, expected_version: i32, pubkey: string, new_ip: string, new_port: i32, proof: OwnershipProof) -> dict {
  var start_ms = current_time_ms()

  var lookup = registry_lookup(reg, domain)
  if !lookup["found"] {
    return {
      "success": false,
      "error": "domain_not_found",
      "latency_ms": current_time_ms() - start_ms,
      "registry": reg
    }
  }

  var entry = lookup["entry"]

  // CAS: check version matches
  if entry.ownership.version != expected_version {
    return {
      "success": false,
      "error": "version_mismatch",
      "expected": expected_version,
      "actual": entry.ownership.version,
      "latency_ms": current_time_ms() - start_ms,
      "registry": reg
    }
  }

  // Verify ownership
  if entry.ownership.owner_pubkey != pubkey {
    return {
      "success": false,
      "error": "ownership_mismatch",
      "latency_ms": current_time_ms() - start_ms,
      "registry": reg
    }
  }

  // Verify proof
  if !proof.is_valid {
    return {
      "success": false,
      "error": "invalid_proof",
      "latency_ms": current_time_ms() - start_ms,
      "registry": reg
    }
  }

  // Apply update with new version
  var new_chain = entry.ownership.proof_chain
  new_chain = push(new_chain, proof.proof_hash)

  var updated_ownership = DomainOwnership {
    domain: domain,
    owner_pubkey: pubkey,
    registered_at: entry.ownership.registered_at,
    last_updated: current_time_ms(),
    version: entry.ownership.version + 1,
    proof_chain: new_chain,
    is_revoked: false,
    transfer_locked: false
  }

  var updated_entry = RegistryEntry {
    domain: domain,
    ownership: updated_ownership,
    ip_addr: new_ip,
    port: new_port,
    txt_records: entry.txt_records,
    mx_records: entry.mx_records,
    ttl: entry.ttl,
    is_active: true
  }

  var new_entries = reg.entries
  new_entries[domain] = updated_entry

  var updated_reg = Registry {
    entries: new_entries,
    entry_count: reg.entry_count,
    owner_index: reg.owner_index,
    proof_cache: reg.proof_cache,
    created_at: reg.created_at,
    last_update: current_time_ms(),
    total_registrations: reg.total_registrations,
    total_updates: reg.total_updates + 1,
    total_revocations: reg.total_revocations
  }

  return {
    "success": true,
    "error": "",
    "new_version": updated_ownership.version,
    "latency_ms": current_time_ms() - start_ms,
    "registry": updated_reg
  }
}

// ============================================================================
// Domain Revocation
// ============================================================================

fn registry_revoke(reg: Registry, domain: string, pubkey: string, proof: OwnershipProof) -> dict {
  var start_ms = current_time_ms()

  var lookup = registry_lookup(reg, domain)
  if !lookup["found"] {
    return {
      "success": false,
      "error": "domain_not_found",
      "registry": reg
    }
  }

  var entry = lookup["entry"]

  if entry.ownership.owner_pubkey != pubkey {
    return {
      "success": false,
      "error": "not_owner",
      "registry": reg
    }
  }

  if !proof.is_valid {
    return {
      "success": false,
      "error": "invalid_proof",
      "registry": reg
    }
  }

  var revoked_ownership = DomainOwnership {
    domain: domain,
    owner_pubkey: pubkey,
    registered_at: entry.ownership.registered_at,
    last_updated: current_time_ms(),
    version: entry.ownership.version + 1,
    proof_chain: entry.ownership.proof_chain,
    is_revoked: true,
    transfer_locked: false
  }

  var revoked_entry = RegistryEntry {
    domain: domain,
    ownership: revoked_ownership,
    ip_addr: entry.ip_addr,
    port: entry.port,
    txt_records: entry.txt_records,
    mx_records: entry.mx_records,
    ttl: 0,
    is_active: false
  }

  var new_entries = reg.entries
  new_entries[domain] = revoked_entry

  var updated_reg = Registry {
    entries: new_entries,
    entry_count: reg.entry_count,
    owner_index: reg.owner_index,
    proof_cache: reg.proof_cache,
    created_at: reg.created_at,
    last_update: current_time_ms(),
    total_registrations: reg.total_registrations,
    total_updates: reg.total_updates,
    total_revocations: reg.total_revocations + 1
  }

  return {
    "success": true,
    "error": "",
    "registry": updated_reg
  }
}

// ============================================================================
// Domain Transfer
// ============================================================================

fn registry_transfer(reg: Registry, domain: string, from_pubkey: string, to_pubkey: string, proof: OwnershipProof) -> dict {
  var start_ms = current_time_ms()

  var lookup = registry_lookup(reg, domain)
  if !lookup["found"] {
    return {
      "success": false,
      "error": "domain_not_found",
      "registry": reg
    }
  }

  var entry = lookup["entry"]

  if entry.ownership.owner_pubkey != from_pubkey {
    return {
      "success": false,
      "error": "not_owner",
      "registry": reg
    }
  }

  if entry.ownership.transfer_locked {
    return {
      "success": false,
      "error": "transfer_locked",
      "registry": reg
    }
  }

  if !proof.is_valid {
    return {
      "success": false,
      "error": "invalid_proof",
      "registry": reg
    }
  }

  var new_chain = entry.ownership.proof_chain
  new_chain = push(new_chain, proof.proof_hash)

  var transferred_ownership = DomainOwnership {
    domain: domain,
    owner_pubkey: to_pubkey,
    registered_at: entry.ownership.registered_at,
    last_updated: current_time_ms(),
    version: entry.ownership.version + 1,
    proof_chain: new_chain,
    is_revoked: false,
    transfer_locked: false
  }

  var transferred_entry = RegistryEntry {
    domain: domain,
    ownership: transferred_ownership,
    ip_addr: entry.ip_addr,
    port: entry.port,
    txt_records: entry.txt_records,
    mx_records: entry.mx_records,
    ttl: entry.ttl,
    is_active: true
  }

  var new_entries = reg.entries
  new_entries[domain] = transferred_entry

  var updated_reg = Registry {
    entries: new_entries,
    entry_count: reg.entry_count,
    owner_index: reg.owner_index,
    proof_cache: reg.proof_cache,
    created_at: reg.created_at,
    last_update: current_time_ms(),
    total_registrations: reg.total_registrations,
    total_updates: reg.total_updates + 1,
    total_revocations: reg.total_revocations
  }

  return {
    "success": true,
    "error": "",
    "new_owner": to_pubkey,
    "registry": updated_reg
  }
}

// ============================================================================
// Registry Statistics
// ============================================================================

fn registry_stats(reg: Registry) -> dict {
  return {
    "total_entries": reg.entry_count,
    "total_registrations": reg.total_registrations,
    "total_updates": reg.total_updates,
    "total_revocations": reg.total_revocations,
    "uptime_ms": current_time_ms() - reg.created_at
  }
}

fn registry_verify_ownership(reg: Registry, domain: string, pubkey: string) -> bool {
  var lookup = registry_lookup(reg, domain)
  if !lookup["found"] {
    return false
  }
  var entry = lookup["entry"]
  return entry.ownership.owner_pubkey == pubkey && !entry.ownership.is_revoked && entry.is_active
}

// ============================================================================
// Utilities
// ============================================================================

fn char_code(s: string, i: i32) -> i32 {
  var c = substr(s, i, 1)
  return string_to_char_code(c)
}

fn string_to_char_code(c: string) -> i32 {
  // Simple mapping for common characters
  if c == "0" { return 48 }
  if c == "1" { return 49 }
  if c == "2" { return 50 }
  if c == "3" { return 51 }
  if c == "4" { return 52 }
  if c == "5" { return 53 }
  if c == "6" { return 54 }
  if c == "7" { return 55 }
  if c == "8" { return 56 }
  if c == "9" { return 57 }
  if c == "a" { return 97 }
  if c == "b" { return 98 }
  if c == "c" { return 99 }
  if c == "d" { return 100 }
  if c == "e" { return 101 }
  if c == "f" { return 102 }
  if c == "." { return 46 }
  if c == "_" { return 95 }
  if c == "-" { return 45 }
  if c == "|" { return 124 }
  return 65
}

fn abs_i32(n: i32) -> i32 {
  if n < 0 {
    return -n
  }
  return n
}

fn abs_i64(n: i64) -> i64 {
  if n < 0 {
    return -n
  }
  return n
}

fn current_time_ms() -> i64 {
  return 1000000
}

fn to_string(n: i64) -> string {
  if n == 0 {
    return "0"
  }
  var result = ""
  var v = n
  if v < 0 {
    v = -v
  }
  while v > 0 {
    var digit = v % 10
    var digit_char = "0"
    if digit == 1 { digit_char = "1" }
    if digit == 2 { digit_char = "2" }
    if digit == 3 { digit_char = "3" }
    if digit == 4 { digit_char = "4" }
    if digit == 5 { digit_char = "5" }
    if digit == 6 { digit_char = "6" }
    if digit == 7 { digit_char = "7" }
    if digit == 8 { digit_char = "8" }
    if digit == 9 { digit_char = "9" }
    result = digit_char + result
    v = v / 10
  }
  if n < 0 {
    return "-" + result
  }
  return result
}
