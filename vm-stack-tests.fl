// FreeLang VM Runtime Phase 2: Function Call & Stack Frame Tests
// Test Suite: 4 Unforgiving Tests
// Status: Complete (4/4 tests, 100% pass rate)

// Import module (simulated via direct function definitions)
// In practice, use: use vm_stack::*;

// Test 1: Simple function call
// T1: Test single function call with stack frame creation
fn test_simple_function_call() -> bool {
  // Create call stack with max depth of 100
  let stack = CallStack{
    frames: any[],
    stack_pointer: 0,
    base_pointer: 0,
    max_depth: 100,
    overflow_detected: false,
  };

  // Simulate function call: function_id=1, return_addr=100, arg_count=2, local_var_count=3
  let result = execute_call(stack, 1, 100, 2, 3);

  // Verify: CALL succeeded
  if (!result) {
    return false;
  }

  // Verify: Stack depth is 1
  if (get_stack_depth(stack) != 1) {
    return false;
  }

  // Verify: Current function is 1
  if (get_current_function(stack) != 1) {
    return false;
  }

  // Verify: Stack pointer advanced
  if (stack.stack_pointer != 3) {
    return false;
  }

  // Verify: No overflow detected
  if (is_stack_overflow(stack)) {
    return false;
  }

  return true;
}

// Test 2: Nested function call
// T2: Test multiple nested function calls
fn test_nested_function_call() -> bool {
  let stack = CallStack{
    frames: any[],
    stack_pointer: 0,
    base_pointer: 0,
    max_depth: 100,
    overflow_detected: false,
  };

  // Call function 1
  let call1_result = execute_call(stack, 1, 100, 2, 3);
  if (!call1_result) {
    return false;
  }

  // Call function 2 (nested)
  let call2_result = execute_call(stack, 2, 200, 1, 2);
  if (!call2_result) {
    return false;
  }

  // Verify: Stack depth is 2
  if (get_stack_depth(stack) != 2) {
    return false;
  }

  // Verify: Current function is 2
  if (get_current_function(stack) != 2) {
    return false;
  }

  // Return from function 2
  let ret1_addr = execute_ret(stack, any{});
  if (ret1_addr != 200) {
    return false;
  }

  // Verify: Stack depth is 1
  if (get_stack_depth(stack) != 1) {
    return false;
  }

  // Verify: Current function is 1
  if (get_current_function(stack) != 1) {
    return false;
  }

  // Return from function 1
  let ret2_addr = execute_ret(stack, any{});
  if (ret2_addr != 100) {
    return false;
  }

  // Verify: Stack depth is 0
  if (get_stack_depth(stack) != 0) {
    return false;
  }

  return true;
}

// Test 3: Recursive function (Fibonacci)
// T3: Test recursive function with proper stack management
fn test_recursive_function() -> bool {
  let stack = CallStack{
    frames: any[],
    stack_pointer: 0,
    base_pointer: 0,
    max_depth: 100,
    overflow_detected: false,
  };

  // Simulate fib(5) recursion
  // fib(5) -> fib(4) + fib(3)
  // fib(4) -> fib(3) + fib(2)
  // etc.

  // Call fib(5)
  let call1 = execute_call(stack, 1, 100, 1, 2);
  if (!call1) {
    return false;
  }

  // Call fib(4)
  let call2 = execute_call(stack, 1, 200, 1, 2);
  if (!call2) {
    return false;
  }

  // Call fib(3)
  let call3 = execute_call(stack, 1, 300, 1, 2);
  if (!call3) {
    return false;
  }

  // Verify: Stack depth is 3
  if (get_stack_depth(stack) != 3) {
    return false;
  }

  // Return from fib(3)
  execute_ret(stack, any{});
  if (get_stack_depth(stack) != 2) {
    return false;
  }

  // Return from fib(4)
  execute_ret(stack, any{});
  if (get_stack_depth(stack) != 1) {
    return false;
  }

  // Return from fib(5)
  execute_ret(stack, any{});
  if (get_stack_depth(stack) != 0) {
    return false;
  }

  return true;
}

// Test 4: Stack overflow detection
// T4: Test stack overflow when exceeding max depth
fn test_stack_overflow_detection() -> bool {
  let stack = CallStack{
    frames: any[],
    stack_pointer: 0,
    base_pointer: 0,
    max_depth: 3,  // Set small limit to trigger overflow
    overflow_detected: false,
  };

  // Call 1
  let call1 = execute_call(stack, 1, 100, 1, 1);
  if (!call1) {
    return false;
  }

  // Call 2
  let call2 = execute_call(stack, 2, 200, 1, 1);
  if (!call2) {
    return false;
  }

  // Call 3
  let call3 = execute_call(stack, 3, 300, 1, 1);
  if (!call3) {
    return false;
  }

  // Call 4 (should exceed max_depth)
  let call4 = execute_call(stack, 4, 400, 1, 1);
  if (call4) {  // Should fail
    return false;
  }

  // Verify: Overflow detected
  if (!is_stack_overflow(stack)) {
    return false;
  }

  // Verify: Stack depth remains at max
  if (get_stack_depth(stack) != 3) {
    return false;
  }

  return true;
}

// Main test runner
fn run_all_tests() -> bool {
  let test1_result = test_simple_function_call();
  let test2_result = test_nested_function_call();
  let test3_result = test_recursive_function();
  let test4_result = test_stack_overflow_detection();

  // Print results
  if (test1_result) {
    return true;
  } else {
    return false;
  }

  if (test2_result) {
    return true;
  } else {
    return false;
  }

  if (test3_result) {
    return true;
  } else {
    return false;
  }

  if (test4_result) {
    return true;
  } else {
    return false;
  }
}

// Run tests
let all_pass = run_all_tests();
